#!/bin/sh
# Run every literal ideal Bash guide example against designated offline outcomes.
set -eu
cd "$(dirname "$0")/.."
command_target=${CARGO_TARGET_DIR:-$PWD/target}
case "$command_target" in /*) ;; *) command_target="$PWD/$command_target" ;; esac
export THINKTHEN_LOOPBACK="$command_target/debug/loopback"
exec python3 scripts/bash_guide_examples.py "$command_target/debug/thinkthen"
