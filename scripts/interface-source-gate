#!/bin/sh
# Source landing recipe for the engine/command/C ABI/SQL/Python interface batch.
# Review this explicit slice list against every later batch before reusing it.
# Release native-pair production and whole-release qualification follow the last
# interface landing; this command neither imports nor registers release assets.
set -eu
cd "$(dirname "$0")/.."
case "$*" in
    '') shared_abi=0 ;;
    --shared-abi) shared_abi=1 ;;
    *) echo 'usage: scripts/interface-source-gate [--shared-abi]' >&2; exit 2 ;;
esac
if [ "$shared_abi" = 1 ] && [ "$(uname -s)" != Linux ]; then
    echo 'shared ABI source checks require Linux for the PostgreSQL slice' >&2
    exit 2
fi
. scripts/native-tools-env
# Child checks may run outside this checkout; retain its pinned toolchain.
RUSTUP_TOOLCHAIN=$(python3 - <<'TOOLCHAIN'
from pathlib import Path
import tomllib
print(tomllib.loads(Path('rust-toolchain.toml').read_text())['toolchain']['channel'])
TOOLCHAIN
)
export RUSTUP_TOOLCHAIN
unset CARGO_NET_OFFLINE UV_OFFLINE npm_config_offline
# Preparation fetches dependencies, never native release products.
cargo fetch --locked
# Keep source checker upgrades separate from tools used by release jobs.
for checker in cargo-deny cargo-machete; do
    checker_version=$(python3 - "$checker" <<'PIN'
from pathlib import Path
import sys
import tomllib
print(tomllib.loads(Path('Cargo.toml').read_text())['workspace']['metadata']['supply-chain'][sys.argv[1]])
PIN
    )
    checker_root="$HOME/.local/share/thinkthen-build-tools/source-checkers/$checker/$checker_version"
    if [ ! -x "$checker_root/bin/$checker" ]; then
        cargo install --locked --version "$checker_version" --root "$checker_root" "$checker"
    fi
    PATH="$checker_root/bin:$PATH"
    export PATH
done
scripts/rust-dependencies --prepare
scripts/rust-advisories --prepare
rustup component add rustfmt clippy
python3 - <<'PY'
from pathlib import Path
import shlex
import subprocess

# The Python slice owns its tool versions and optional dependency list.
text = Path('scripts/python-gate').read_text().replace('\\\n', '')
args = shlex.split(text.split('exec uv run ', 1)[1].split("<<'CHECKS'", 1)[0])
args = args[:args.index('--')]
args.remove('--offline')
subprocess.run(['uv', 'run', *args, '--', 'python', '--version'], check=True)
PY
if [ "$shared_abi" = 1 ]; then
    scripts/source-linux-tools
    PATH="$PWD/target/source-tools/bin:$PATH"
    export PATH
    scripts/jvm-prepare
    # A new nuget.org advisory must not stop every lane on code nobody changed.
    scripts/csharp-prepare --advisories-warn
    scripts/ruby-dev-prepare
    npm --prefix sdk/typescript ci --ignore-scripts --no-audit --no-fund
fi
case "$(uname -s)" in
    Linux) python3 scripts/installer-test --prepare-fish ;;
esac
export CARGO_NET_OFFLINE=true UV_OFFLINE=1 npm_config_offline=true
# Every selected slice runs even if another fails. Exit 77 is also a failure.
failed=
report_scope=source
report_label="source gate stage"
report_summary="Failed source gate stages:"
report_filter='source-*'
. scripts/gate-report
trap 'exit_status=$?; trap - EXIT; report_finish; if [ -n "${source_scratch:-}" ]; then rm -rf "$source_scratch" || :; fi; exit "$exit_status"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
stage() {
    name=$1
    shift
    started=$(date +%s)
    printf 'Source gate stage: %s\n' "$name"
    # gate-stage fails a stage that runs past its limit with exit 124 and names it.
    if [ "$stage_timeout" -ne 0 ]; then
        set -- python3 scripts/gate-stage "$stage_timeout" "$name" "$@"
    fi
    report_run "$report_scratch/running.log" "$@"
    elapsed=$(( $(date +%s) - started ))
    if [ "$status" -eq 0 ]; then
        printf 'Passed source gate stage: %s (elapsed %s seconds)\n' "$name" "$elapsed"
    else
        report_save "$report_scratch/running.log"
        printf 'Failed source gate stage: %s (exit %s; elapsed %s seconds)\n' "$name" "$status" "$elapsed" >&2
        failed="$failed $name"
    fi
}
stage rust-format cargo fmt --all --check
stage rust-dependencies scripts/rust-dependencies
stage rust-advisories scripts/rust-advisories
stage core-check scripts/core-check
stage bindings-schema scripts/bindings-schema
stage contract-schema-check scripts/contract-schema-check
stage rust-clippy cargo clippy --workspace --all-targets --features thinkthen/stream --locked --keep-going -- -D warnings
# c-gate builds the current tree's library and external consumers. Workspace
# integration tests execute those consumers and cover the shared SQL engine.
stage c-gate scripts/c-gate
stage rust-tests cargo test --workspace --features thinkthen/stream --locked --no-fail-fast
stage loopback cargo build -p loopback --bin loopback --locked
build_target=${CARGO_TARGET_DIR:-$PWD/target}
case "$build_target" in /*) ;; *) build_target="$PWD/$build_target" ;; esac
# Workspace CLI integration tests build the current command used by the guide.
stage bash-guide scripts/bash-guide
case "$(uname -s)" in
    Linux) THINKTHEN_NATIVE_LIBRARY="$build_target/debug/libthinkthen_ffi.so" ;;
    Darwin) THINKTHEN_NATIVE_LIBRARY="$build_target/debug/libthinkthen_ffi.dylib" ;;
    *) echo 'source gate requires Linux or macOS' >&2; exit 2 ;;
esac
THINKTHEN_LOOPBACK="$build_target/debug/loopback"
export THINKTHEN_NATIVE_LIBRARY THINKTHEN_LOOPBACK
stage sql-bridge-gate scripts/sql-bridge-gate
# Builds a development wheel from this checkout, installs it alone offline in a
# fresh environment, then runs Python conformance, typing, lint and pytest.
stage python-gate scripts/python-gate
stage python-offline sdk/python/check-offline
# The prepared Linux floor supplies R and its dependencies. Its Docker socket
# route also lets the installer helper run the prepared fish shell checks.
case "$(uname -s)" in
    Linux) stage python-release-helpers env THINKTHEN_DOCKER_IN_FLOOR=1 scripts/runtime-floor-build sdk/python/check-release ;;
    *) stage python-release-helpers sdk/python/check-release ;;
esac
if [ "$shared_abi" = 1 ]; then
    source_scratch=$(mktemp -d)
    # Ordinary consumers keep the feature-free library. SQL loopback fixtures
    # compile separately so their test interface never enters ordinary assets.
    fixture_target="$build_target/source-fixtures"
    stage fixture-engine env CARGO_TARGET_DIR="$fixture_target" cargo build --offline --locked \
        -p thinkthen-ffi -p loopback --lib --bin loopback --features thinkthen-ffi/fixture-routing
    THINKTHEN_SQL_ARCHIVE="$build_target/debug/libthinkthen_ffi.a"
    THINKTHEN_SQL_TEST_ARCHIVE="$fixture_target/debug/libthinkthen_ffi.a"
    export THINKTHEN_SQL_ARCHIVE THINKTHEN_SQL_TEST_ARCHIVE
    stage native-fixtures scripts/native-fixtures --engine "$THINKTHEN_NATIVE_LIBRARY" --output "$source_scratch/abi"
    THINKTHEN_NATIVE_FIXTURES="$source_scratch/abi"
    THINKTHEN_MALFORMED_ROW_FIXTURES="$source_scratch/malformed"
    export THINKTHEN_NATIVE_FIXTURES THINKTHEN_MALFORMED_ROW_FIXTURES
    for kind in invalid-json unanswered-answer unknown-function; do
        stage "malformed-$kind" scripts/abi-minor-check --native "$THINKTHEN_NATIVE_LIBRARY" \
            --malformed-row "$kind" --output "$THINKTHEN_MALFORMED_ROW_FIXTURES/$kind"
    done
    printf 'Source native revision: %s\n' "$(git rev-parse HEAD)"
    printf 'Ordinary native: %s\nFixture archive: %s\n' "$THINKTHEN_NATIVE_LIBRARY" "$THINKTHEN_SQL_TEST_ARCHIVE"
    # Explicit reviewed binding list; no release pair or receipt lookup.
    unset THINKTHEN_JVM_NATIVE_ASSETS THINKTHEN_CSHARP_NATIVE_ASSETS THINKTHEN_SWIFT_PACKAGE
    unset THINKTHEN_ZIG_DEBUG_CHECKPOINT THINKTHEN_ZIG_DEBUG_NATIVE
    stage go-gate env THINKTHEN_GO_ENGINE="$THINKTHEN_NATIVE_LIBRARY" scripts/go-gate
    stage jvm-gate scripts/jvm-gate
    stage csharp-gate scripts/csharp-gate --source
    stage ruby-gate env THINKTHEN_RUBY_SOURCE_NATIVE=1 scripts/ruby-gate
    host_rid=$(python3 scripts/native_platform.py rid)
    mkdir -p "$source_scratch/assets/$host_rid"
    cp "$THINKTHEN_NATIVE_LIBRARY" "$source_scratch/assets/$host_rid/"
    stage swift-gate scripts/linux-binding-gate --abi-binding swift --scratch "$source_scratch" -- \
        env THINKTHEN_SWIFT_NATIVE_ASSETS="$source_scratch/assets" THINKTHEN_LOOPBACK="$THINKTHEN_LOOPBACK" \
        THINKTHEN_NATIVE_FIXTURES="$THINKTHEN_NATIVE_FIXTURES" CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}" scripts/swift-gate
    stage r-gate scripts/runtime-floor-build scripts/r-gate --source
    stage typescript-gate scripts/typescript-gate
    stage c-sdk-gate env THINKTHEN_C_SOURCE_NATIVE=1 scripts/c-sdk-gate
    stage cpp-sdk-gate env THINKTHEN_C_SOURCE_NATIVE=1 scripts/cpp-sdk-gate
    stage zig-gate env THINKTHEN_ZIG_NATIVE_FILE="$THINKTHEN_NATIVE_LIBRARY" scripts/zig-sdk-gate
    stage abi-minor-bindings env THINKTHEN_SDK_GATE_RUNNER=scripts/linux-binding-gate \
        scripts/abi-minor-check --native "$THINKTHEN_NATIVE_LIBRARY" --bindings-only
    THINKTHEN_LOOPBACK="$fixture_target/debug/loopback"
    export THINKTHEN_LOOPBACK
    stage sqlite-gate scripts/sqlite-gate
    stage postgres-gate scripts/postgres-gate
    stage duckdb-gate scripts/duckdb-gate
fi
stage words scripts/words
stage secrets scripts/secrets
if [ -n "$failed" ]; then
    exit 1
fi
