#!/bin/sh
# Run every gate stage and report all failures before refusing the candidate.
set -eu
cd "$(dirname "$0")/.."
failed=
stage_timeout=${THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS:-}
if [ -z "$stage_timeout" ]; then
    # M5: whole gate 1014s, SDK stage 615s, Rust tests 217s. Allow 45m per Mac stage.
    case "$(uname -s)" in Darwin) stage_timeout=2700 ;; *) stage_timeout=0 ;; esac
fi
case "$stage_timeout" in *[!0-9]*|'') echo 'gate stage timeout must be whole seconds' >&2; exit 2 ;; esac
diagnostics=${THINKTHEN_GATE_DIAGNOSTICS:-$PWD/target/gate-diagnostics}
mkdir -p "$diagnostics"
gate_scratch=$(mktemp -d)
trap 'status=$?; trap - EXIT; rm -rf "$gate_scratch" || :; exit "$status"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkfifo "$gate_scratch/output"
stage() {
    name=$1
    shift
    started=$(date +%s)
    printf 'Gate stage: %s (start %s)\n' "$name" "$started" | tee -a "$diagnostics/stages.log"
    tee "$diagnostics/running-stage.log" < "$gate_scratch/output" &
    output_pid=$!
    if [ "$stage_timeout" -ne 0 ]; then
        set -- python3 scripts/gate-stage "$stage_timeout" "$name" "$@"
    fi
    if "$@" > "$gate_scratch/output" 2>&1; then
        status=0
    else
        status=$?
    fi
    wait "$output_pid"
    ended=$(date +%s)
    elapsed=$(( ended - started ))
    printf 'Gate stage ended: %s (end %s; exit %s; elapsed %s seconds)\n' "$name" "$ended" "$status" "$elapsed" >> "$diagnostics/stages.log"
    if [ "$status" -eq 0 ]; then
        printf 'Passed gate stage: %s (elapsed %s seconds)\n' "$name" "$elapsed"
    else
        printf 'Failed gate stage: %s (exit %s; elapsed %s seconds)\n' "$name" "$status" "$elapsed" >&2
        tail -n 50 "$diagnostics/running-stage.log" > "$diagnostics/$name.tail"
        failed="$failed $name"
    fi
}
# Missing tools are failures. Later stages still expose independent defects.
if [ "${THINKTHEN_GATE_STRICT:-0}" = 1 ] && [ "$(uname -s)" != Linux ]; then
    printf 'strict candidate gate requires Linux; required platform stages would be omitted\n' >&2
    exit 1
fi
for tool in python3 git cargo rustc cc c++ make cmake pkg-config uv node npm ruby R Rscript staticcheck; do
    stage "tool-$tool" command -v "$tool"
done
if [ "$(uname -s)" = Linux ]; then stage tool-docker command -v docker; fi
stage python-version python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else "gate: python3 requires Python 3.11 or newer")'
stage gate-report-test scripts/gate-report-test
stage stress-dispatch-test scripts/stress-dispatch-test
stage release-metadata python3 scripts/release_metadata.py
for check in release-script-test release-retry-test release-preparation-test release-staging-test release-publish-test release-floor-inputs-test; do
    stage "$check" "scripts/$check"
done
if [ "$(uname -s)" = Linux ]; then
    stage stress-resource-test scripts/stress-resource-test
    stage stress-runner-test scripts/stress-runner-test
fi
for tool in R Rscript; do stage "runtime-$tool" "$tool" --version; done
stage words scripts/words ${THINKTHEN_PRIVATE_PATTERNS:+"$THINKTHEN_PRIVATE_PATTERNS"}
for check in secrets bindings-schema contract-schema-check; do stage "$check" "scripts/$check"; done
stage notices scripts/notices --check
stage supply-chain-check scripts/supply-chain-check
stage rust-advisories scripts/rust-advisories
stage rust-dependencies scripts/rust-dependencies
stage rust-format cargo fmt --all --check
stage core-check scripts/core-check
stage fixture-routing-check scripts/fixture-routing-check
stage rust-clippy cargo clippy --workspace --all-targets --features thinkthen/stream --locked --keep-going -- -D warnings
stage c-gate scripts/c-gate
stage rust-tests cargo test --workspace --features thinkthen/stream --locked --no-fail-fast
stage crate-package-test scripts/crate-package-test
stage bash-guide sh -eu -c '
    guide_root=$PWD
    guide_scratch=$(mktemp -d)
    trap '\''status=$?; trap - EXIT; rm -rf "$guide_scratch" || :; exit "$status"'\'' EXIT
    trap '\''exit 129'\'' HUP
    trap '\''exit 130'\'' INT
    trap '\''exit 143'\'' TERM
    python3 scripts/surface-example prepare bash "$guide_scratch"
    command_target=${CARGO_TARGET_DIR:-$PWD/target}
    case "$command_target" in /*) ;; *) command_target="$PWD/$command_target" ;; esac
    cd "$guide_scratch"
    PATH="$command_target/debug:$PATH" python3 "$guide_root/scripts/surface-example" check bash bash example.sh
'
stage sql-bridge-gate scripts/sql-bridge-gate
stage abi-platform-routing-test scripts/abi-platform-routing-test
stage abi-minor-check sh -eu -c 'scripts/abi-minor-check --native "${THINKTHEN_NATIVE_LIBRARY:?Provide the verified host native library}" --bindings-only'
stage sdk-gates scripts/sdk-gates
if [ -n "$failed" ]; then
    printf 'Failed gate stages:%s\n' "$failed" >&2
    for name in $failed; do
        printf '\nLast 50 lines of failed gate stage: %s\n' "$name" >&2
        cat "$diagnostics/$name.tail" >&2
    done
    exit 1
fi
