#!/usr/bin/env python3
"""Capture a bounded native-driver thread witness for the literal suspend-main example."""
import os
from pathlib import Path
import subprocess
import sys
from guide_examples import ROOT, blocks, check, scenario
from kotlin_compiler import classpath as compiler_classpath

classpath, repository = sys.argv[1:]
java = str(Path(os.environ['JAVA_HOME']) / 'bin/java')
jcmd = str(Path(os.environ['JAVA_HOME']) / 'bin/jcmd')
observers = []
with scenario('yes', observer=observers) as (folder, env):
    literal = blocks(ROOT / 'docs/surfaces/kotlin.md')[0][1]
    source = folder / 'Example.kt'
    source.write_text(literal)
    built = subprocess.run([java, '-cp', compiler_classpath(repository), 'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler', '-no-stdlib', '-no-reflect', '-jvm-target', '22', '-classpath', classpath, '-d', str(folder / 'classes'), str(source)], cwd=folder, env=env, capture_output=True, text=True, timeout=90)
    check('kotlin/driver-witness/compile', built)
    process = subprocess.Popen([java, '-Duser.home=' + str(folder / 'home'), '--enable-native-access=ALL-UNNAMED', '-cp', str(folder / 'classes') + os.pathsep + classpath, 'ExampleKt'], cwd=folder, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    try:
        stdout, stderr = process.communicate(timeout=10)
        print('NO HANG WITNESS', process.returncode, repr(stdout), repr(stderr), flush=True)
    except subprocess.TimeoutExpired:
        dump = subprocess.run([jcmd, str(process.pid), 'Thread.print'], capture_output=True, text=True, timeout=10)
        server = observers[0]
        server.stdin.write('count\n')
        server.stdin.flush()
        print('FIXTURE REQUESTS ' + server.stdout.readline().strip(), flush=True)
        print(dump.stdout + dump.stderr, flush=True)
        process.kill()
        stdout, stderr = process.communicate(timeout=10)
        print('CAPTURED OUTPUT ' + repr(stdout) + ' STDERR ' + repr(stderr), flush=True)
        raise SystemExit('Literal suspend main hung; bounded thread witness captured')
    finally:
        if process.poll() is None:
            process.kill()
            process.wait(timeout=10)
