#!/usr/bin/env python3
"""Check ABI prefix memory safety and the four bindings' future-code adaptation.

The native argument is a previously verified engine. Only binding checks use it;
Cargo compiles the changed FFI memory-safety test in the job's own target.
"""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import shlex
import subprocess
import sys
import tempfile
from native_platform import current

ROOT = Path(__file__).resolve().parent.parent
MESSAGE = 'settings: expected a JSON-representable settings object; received an incompatible host value (contents redacted)'


def run(*args, cwd=ROOT, binding=None, scratch=None, **kwargs):
    runner = os.environ.get('THINKTHEN_SDK_GATE_RUNNER')
    if runner and binding:
        args = (*shlex.split(runner), '--abi-binding', binding, '--scratch', scratch, '--', *args)
    if binding == 'swift':
        environment = dict(kwargs.get('env', os.environ))
        environment.pop('THINKTHEN_LIBRARY', None)
        kwargs['env'] = environment
    subprocess.run([str(arg) for arg in args], cwd=cwd, check=True, **kwargs)


def replace_library(source, destination):
    # macOS validates executable pages by inode. Never overwrite bytes of a
    # library an earlier proof process has mapped.
    with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False) as temporary:
        staged = Path(temporary.name)
    try:
        shutil.copy2(source, staged)
        os.replace(staged, destination)
    finally:
        staged.unlink(missing_ok=True)


def projection_fixture(source, registry, mutation, restore_error=False):
    """Corrupt complete public projections, with fixture-owned output buffers."""
    helper = r'''
#include <jansson.h>
#include <string.h>
static pthread_mutex_t buffers_lock = PTHREAD_MUTEX_INITIALIZER;
struct fixture_buffer { void *data; struct fixture_buffer *next; };
static struct fixture_buffer *buffers;
static void own_buffer(thinkthen_buffer *out, char *text) {
    struct fixture_buffer *owner = malloc(sizeof(*owner)); if (!owner || !text) abort();
    owner->data = text; out->data = (uint8_t*)text; out->len = strlen(text);
    pthread_mutex_lock(&buffers_lock); owner->next = buffers; buffers = owner; pthread_mutex_unlock(&buffers_lock);
}
static int free_buffer(thinkthen_buffer *out) {
    if (!out) return 0;
    pthread_mutex_lock(&buffers_lock);
    struct fixture_buffer **at = &buffers;
    while (*at && (*at)->data != out->data) at = &(*at)->next;
    struct fixture_buffer *owner = *at;
    if (owner) *at = owner->next;
    pthread_mutex_unlock(&buffers_lock);
    if (!owner) return 0;
    free(owner->data); free(owner); out->data = NULL; out->len = 0; return 1;
}
'''
    first = source.index('THINKTHEN_FIXTURE_API ' + registry['exports'][0]['declaration'].rstrip(';'))
    source = source[:first] + helper + source[first:]
    for name in ('thinkthen_row_host_json', 'thinkthen_row_to_json'):
        declaration = next(e['declaration'].rstrip(';') for e in registry['exports'] if e['name'] == name)
        body = ('thinkthen_row copy = *row; ' +
            ('if (copy.error_code == 2147483647) copy.error_code = THINKTHEN_CODE_RECORD_MISSING; ' if restore_error else '') +
            'typedef int32_t (*projection)(const thinkthen_row*, thinkthen_buffer*, thinkthen_error*); '
            'int32_t result = ((projection)resolve("' + name + '"))(&copy, out, error); '
            'if (result != THINKTHEN_OK) return result; '
            'json_t *document = json_loadb((const char*)out->data, out->len, JSON_DECODE_ANY, NULL); '
            '((void (*)(thinkthen_buffer*))resolve("thinkthen_buffer_free"))(out); '
            'if (!document) abort(); ' + mutation +
            'json_decref(document); return THINKTHEN_OK;')
        source, count = re.subn(r'THINKTHEN_FIXTURE_API ' + re.escape(declaration) + r' \{[^\n]*\}',
            lambda _: 'THINKTHEN_FIXTURE_API ' + declaration + ' { ' + body + ' }', source)
        assert count == 1, name
    source = source.replace('fixture_function(buffer);', 'if (!free_buffer(buffer)) fixture_function(buffer);')
    return source


def projection_flags():
    return shlex.split(subprocess.check_output(['pkg-config', '--cflags', '--libs', 'jansson'], text=True))


def fixture(engine, output, rows=False, children=False):
    tools = runpy.run_path(str(ROOT / 'scripts/native-fixtures'))
    registry = json.loads((ROOT / 'schemas/abi.json').read_text())
    source = tools['source']({'version': registry['abi_version'] + 1, 'forward': True}, registry, engine)
    for export in registry['exports']:
        name = export['name']
        if rows or children or name not in ('thinkthen_client_open', 'thinkthen_client_open_json'):
            continue
        declaration = export['declaration'].rstrip(';')
        unused = ' '.join('(void)' + name + ';' for name in tools['parameters'](declaration, name) if name != 'error')
        body = (unused + ' typedef int32_t (*conversion)(thinkthen_error*); '
                'int32_t result = ((conversion)resolve("thinkthen_settings_conversion_error"))(error); '
                'error->code = 2147483647; return result;')
        source, count = re.subn(r'THINKTHEN_FIXTURE_API ' + re.escape(declaration) + r' \{[^\n]*\}',
                               'THINKTHEN_FIXTURE_API ' + declaration + ' { ' + body + ' }', source)
        assert count == 1, name
    if rows:
        source = source.replace('return fixture_function(call, out, error);',
            'int32_t result = fixture_function(call, out, error); '
            'if (result == THINKTHEN_OK && out->status == THINKTHEN_STATUS_FAILED) out->error_code = 2147483647; return result;')
        source = projection_fixture(source, registry,
            'if (row->status == THINKTHEN_STATUS_FAILED) json_object_set_new(document, "error", '
            'json_pack("{s:s,s:s}", "code", "future.code", "message", "the record is missing")); '
            'own_buffer(out, json_dumps(document, JSON_COMPACT | JSON_ENCODE_ANY)); ', restore_error=True)
    if children:
        payload = json.dumps({'future': {'function': 'decide', 'status': 'failed',
            'error': {'code': 'future.problem', 'message': 'future child message'}}})
        source = projection_fixture(source, registry,
            'if (row->function == THINKTHEN_FUNCTION_ANNOTATE) json_object_set_new(document, "answer", '
            'json_loads(' + json.dumps(payload) + ', 0, NULL)); '
            'own_buffer(out, json_dumps(document, JSON_COMPACT | JSON_ENCODE_ANY)); ')
    declaration = next(item['declaration'].rstrip(';') for item in registry['exports'] if item['name'] == 'thinkthen_code_name')
    source = re.sub(r'(THINKTHEN_FIXTURE_API ' + re.escape(declaration) + r' \{[^\n]*?)return fixture_function\(value\);',
                    r'\1if (value == 2147483647) return "future.code"; return fixture_function(value);', source)
    path = output / engine.name
    code = output / 'future.c'
    code.write_text(source)
    flags = ['-dynamiclib', '-pthread'] if sys.platform == 'darwin' else ['-shared', '-fPIC', '-pthread', '-ldl']
    run('cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-I', ROOT / 'crates/thinkthen-ffi/include', code, '-o', path, *flags, *(projection_flags() if rows or children else []))
    return path


def malformed_fixture(engine, output, kind):
    """Forward the current ABI and corrupt only a delivered row's JSON payload."""
    tools = runpy.run_path(str(ROOT / 'scripts/native-fixtures'))
    registry = json.loads((ROOT / 'schemas/abi.json').read_text())
    source = tools['source']({'version': registry['abi_version'], 'forward': True}, registry, engine)
    if kind == 'unknown-family':
        source, changed = re.subn(r'(THINKTHEN_FIXTURE_API const char \*thinkthen_code_family\(int32_t value\)) \{[^\n]*\}',
            r'\1 { (void)value; return "future-family"; }', source)
        assert changed == 1, 'missing canonical family export wrapper'
    elif kind in ('unknown-function', 'wrong-function', 'failed-probability'):
        needle = 'return fixture_function(call, out, error);'
        assert source.count(needle) == 1, 'missing canonical call_next wrapper'
        source = source.replace(needle, 'int32_t result = fixture_function(call, out, error); '
            'if (result == THINKTHEN_OK) ' + (
                'out->probability = 0.5' if kind == 'failed-probability' else
                'out->function = THINKTHEN_FUNCTION_FILTER' if kind == 'wrong-function' else
                'out->function = UINT32_MAX') + '; return result;')
    else:
        field, payload, predicate = {
            'invalid-json': ('answer', '{', '1'),
            'unanswered-answer': ('answer', 'true', 'row->status != THINKTHEN_STATUS_ANSWERED'),
            'source-extra': ('source', '{"question_identity":"fixture","backend":"stub","model":"stub","extra":true}', '1'),
            'source-type': ('source', '{"question_identity":"fixture","backend":"stub","model":1}', '1'),
            'source-missing': ('source', '{"question_identity":"fixture","backend":"stub"}', '1'),
            'source-null': ('source', '{"question_identity":"fixture","backend":"stub","model":null}', '1'),
            'source-name-null': ('source', '{"question_identity":"fixture","backend":"stub","model":"stub","name":null}', '1'),
            'answered-error': ('error', '{"code":"record.missing","message":"inactive error"}', 'row->status == THINKTHEN_STATUS_ANSWERED'),
            'failed-detail': ('detail', '{}', 'row->status == THINKTHEN_STATUS_FAILED'),
        }[kind]
        if kind == 'invalid-json':
            mutation = 'char *invalid = malloc(2); if (!invalid) abort(); memcpy(invalid, "{", 2); own_buffer(out, invalid); '
        else:
            mutation = ('if (' + predicate + ') json_object_set_new(document, ' + json.dumps(field) +
                ', json_loads(' + json.dumps(payload) + ', JSON_DECODE_ANY, NULL)); '
                'own_buffer(out, json_dumps(document, JSON_COMPACT | JSON_ENCODE_ANY)); ')
        source = projection_fixture(source, registry, mutation)
    output.mkdir(parents=True, exist_ok=True)
    code, library = output / 'malformed.c', output / engine.name
    code.write_text('#include <string.h>\n' + source)
    flags = (['-dynamiclib', '-pthread', '-Wl,-install_name,@rpath/' + engine.name]
             if sys.platform == 'darwin' else ['-shared', '-fPIC', '-pthread', '-ldl'])
    run('cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-I', ROOT / 'crates/thinkthen-ffi/include', code, '-o', library, *flags, *(projection_flags() if kind not in ('unknown-family', 'unknown-function', 'wrong-function', 'failed-probability') else []))
    return library


def decoder_fixtures(engine, output, selected=None):
    """Build small row-shape witnesses without changing canonical provider assets."""
    original = output / 'original' / engine.name
    original.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(engine, original)
    kinds = ('source-extra', 'source-type', 'answered-error', 'failed-probability', 'failed-detail', 'wrong-function', 'unknown-family')
    if selected is not None:
        assert selected in kinds, 'unknown optional decoder case'
        kinds = (selected,)
    fixtures = {kind: malformed_fixture(original, output / kind, kind) for kind in kinds}
    cleanup = output / 'row-cleanup'
    flags = [] if sys.platform == 'darwin' else ['-ldl']
    run('cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-I', ROOT / 'crates/thinkthen-ffi/include',
        ROOT / 'scripts/native-row-cleanup.c', '-o', cleanup, *flags)
    for library in fixtures.values():
        run(cleanup, library, timeout=10)
    return fixtures


def bindings(engine, scratch, selected):
    future = fixture(engine, scratch)
    row_folder = scratch / 'rows'
    row_folder.mkdir()
    row_future = fixture(engine, row_folder, rows=True)
    child_folder = scratch / 'children'
    child_folder.mkdir()
    child_future = fixture(engine, child_folder, children=True)
    include = ROOT / 'crates/thinkthen-ffi/include'
    failures = []
    if 'cpp' in selected:
        try:
            run('c++', '-std=c++20', '-Wall', '-Wextra', '-Werror', '-I', include,
                '-I', ROOT / 'sdk/cpp/include', ROOT / 'sdk/cpp/tests/minor_error.cpp', future,
                '-Wl,-rpath,' + str(scratch), '-o', scratch / 'cpp')
            run(scratch / 'cpp', MESSAGE)
        except subprocess.CalledProcessError:
            failures.append("cpp")
    if 'ruby' in selected:
        try:
            ruby = scratch / 'ruby'
            shutil.copytree(ROOT / 'sdk/ruby/lib', ruby)
            shutil.copy2(future, ruby / 'thinkthen' / future.name)
            run('ruby', '-I', ruby, ROOT / 'sdk/ruby/tests/minor_error.rb', MESSAGE, binding='ruby', scratch=scratch)
            replace_library(row_future, ruby / 'thinkthen' / future.name)
            run('ruby', '-I', ruby, ROOT / 'sdk/ruby/tests/minor_error.rb', 'the record is missing', 'row', binding='ruby', scratch=scratch)
            replace_library(child_future, ruby / 'thinkthen' / future.name)
            run('ruby', '-I', ruby, ROOT / 'sdk/ruby/tests/minor_error.rb', 'future child message', 'child', binding='ruby', scratch=scratch)
        except subprocess.CalledProcessError:
            failures.append("ruby")
    if 'swift' in selected:
        try:
            swift = scratch / 'swift'
            shutil.copytree(ROOT / 'sdk/swift', swift)
            shutil.copy2(ROOT / 'sdk/swift/Package.swift', swift / 'Package.swift')
            (swift / 'Sources/CThinkThen/include').mkdir(parents=True, exist_ok=True)
            shutil.copy2(include / 'thinkthen.h', swift / 'Sources/CThinkThen/include/thinkthen.h')
            run(sys.executable, ROOT / 'sdk/swift/generate-codes.py', ROOT / 'schemas/contract.json', swift / 'Sources/ThinkThen/ErrorCode.swift')
            native = swift / 'Sources/ThinkThen/Native' / current()['rid']
            native.mkdir(parents=True, exist_ok=True)
            shutil.copy2(future, native / future.name)
            consumer = scratch / 'consumer'
            consumer.mkdir()
            shutil.copy2(ROOT / 'sdk/swift/tests/minor/Consumer.swift', consumer / 'MinorError.swift')
            (consumer / 'Package.swift').write_text('''// swift-tools-version: 6.3
        import PackageDescription
        let package = Package(name: "MinorError", platforms: [.macOS("15.0")], dependencies: [.package(path: "../swift")], targets: [
        .executableTarget(name: "MinorError", dependencies: [.product(name: "ThinkThen", package: "swift")], path: ".")])
        ''')
            run('swift', 'format', 'lint', '--strict', '--recursive', ROOT / 'sdk/swift', binding='swift', scratch=scratch)
            run('swift', 'build', '--jobs', '2', '--package-path', consumer, '--disable-sandbox', '-Xswiftc', '-warnings-as-errors', binding='swift', scratch=scratch)
            run(consumer / '.build/debug/MinorError', MESSAGE, binding='swift', scratch=scratch)
            for resource in {path.resolve() for path in consumer.rglob(future.name)}:
                replace_library(row_future, resource)
            run(consumer / '.build/debug/MinorError', 'the record is missing', 'row', binding='swift', scratch=scratch)
            for resource in {path.resolve() for path in consumer.rglob(future.name)}:
                replace_library(child_future, resource)
            run(consumer / '.build/debug/MinorError', 'future child message', 'child', binding='swift', scratch=scratch)
        except subprocess.CalledProcessError:
            failures.append("swift")
    if 'zig' in selected:
        try:
            zig = scratch / 'package'
            shutil.copytree(ROOT / 'sdk/zig', zig)
            (zig / 'include').mkdir(exist_ok=True)
            shutil.copy2(include / 'thinkthen.h', zig / 'include/thinkthen.h')
            runpy.run_path(str(ROOT / 'scripts/zig_codes.py'))['generate'](ROOT, zig / 'src/error_codes.zig')
            native = zig / 'native' / current()['rid']
            native.mkdir(parents=True, exist_ok=True)
            shutil.copy2(future, native / future.name)
            consumer = scratch / 'zig-consumer'
            consumer.mkdir()
            shutil.copy2(ROOT / 'sdk/zig/tests/minor_error.zig', consumer / 'consumer.zig')
            shutil.copy2(ROOT / 'sdk/zig/tests/build.zig.zon', consumer / 'build.zig.zon')
            source = (ROOT / 'sdk/zig/tests/build.zig').read_text()
            source = source[:source.index('    const tests =')] + '}\n'
            (consumer / 'build.zig').write_text(source)
            version = re.search(r'minimum_zig_version = "([^"]+)"', (zig / 'build.zig.zon').read_text())[1]
            executable = Path.home() / '.local/share/thinkthen-build-tools/zig' / version / 'zig'
            run(executable, 'fmt', '--check', ROOT / 'sdk/zig/src', ROOT / 'sdk/zig/tests/minor_error.zig')
            run(executable, 'build', '-j2', cwd=consumer)
            run(consumer / 'zig-out/bin/consumer', MESSAGE)
            replace_library(row_future, consumer / 'zig-out/bin' / future.name)
            run(consumer / 'zig-out/bin/consumer', 'the record is missing', 'row')
            replace_library(child_future, consumer / 'zig-out/bin' / future.name)
            run(consumer / 'zig-out/bin/consumer', 'future child message', 'child')
            malformed = malformed_fixture(engine, scratch / 'zig-malformed', 'invalid-json')
            replace_library(malformed, consumer / 'zig-out/bin' / future.name)
            run(consumer / 'zig-out/bin/consumer', 'incompatible projection', 'malformed')
        except subprocess.CalledProcessError:
            failures.append("zig")
    if failures:
        raise SystemExit("ABI binding checks failed: " + ", ".join(failures))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--native', required=True, type=Path)
    parser.add_argument('--bindings-only', action='store_true')
    parser.add_argument('--bindings', nargs='+', choices=['cpp', 'ruby', 'swift', 'zig'], default=['cpp', 'ruby', 'swift', 'zig'])
    parser.add_argument('--malformed-row', choices=['invalid-json', 'unanswered-answer', 'unknown-function', 'source-extra', 'source-type', 'answered-error', 'failed-probability', 'failed-detail', 'wrong-function', 'unknown-family'])
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    if args.malformed_row:
        if args.output is None: parser.error('--malformed-row requires --output')
        print(malformed_fixture(args.native.resolve(strict=True), args.output.resolve(), args.malformed_row))
        return
    if not args.bindings_only:
        run('cargo', 'fmt', '--all', '--check')
        run('cargo', 'test', '--offline', '--locked', '-p', 'thinkthen-ffi', '--lib', 'memory_prefix_tests')
        run('cargo', 'clippy', '--offline', '--locked', '-p', 'thinkthen-ffi', '--lib', '--tests', '--', '-D', 'warnings')
        if 'ruby' in args.bindings:
            run(ROOT / 'sdk/ruby/tests/type-gate', '--dev-gems', Path.home() / '.local/share/thinkthen-build-tools/ruby/dev')
    with tempfile.TemporaryDirectory(prefix='abi-minor-') as folder:
        bindings(args.native.resolve(strict=True), Path(folder), args.bindings)
    print('ABI minor checks pass for selected stages')


if __name__ == '__main__':
    main()
