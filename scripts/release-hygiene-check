#!/bin/sh
# Prove the bounded release integration repairs in the actual compiler floor.
set -eu
cd "$(dirname "$0")/.."
if [ "${1:-}" != --inside ]; then
    [ "$#" -eq 3 ] || { echo 'usage: release-hygiene-check CARGO_HOME TARGET FLOOR_IMAGE' >&2; exit 2; }
    case "$1:$2" in /*:/*) ;; *) echo 'Cargo home and target must be absolute' >&2; exit 2 ;; esac
    CARGO_HOME=$1 CARGO_TARGET_DIR=$2 THINKTHEN_FLOOR_IMAGE=$3
    export CARGO_HOME CARGO_TARGET_DIR THINKTHEN_FLOOR_IMAGE
    . scripts/native-tools-env
    exec scripts/runtime-floor-build scripts/release-hygiene-check --inside
fi
[ "${THINKTHEN_FLOOR_BUILD:-}" = 1 ] || { echo 'release hygiene proof requires the Linux compiler floor' >&2; exit 2; }
. scripts/native-tools-env
scripts/release-package-text-test PackageText.test_cargo_crate
scripts/release-script-test ReleaseScripts.test_release_assets_have_provenance_after_platform_checks
scripts/postgres-installed-prepare-test
scripts/rust-dependencies
cargo test --offline --locked -p thinkthen-ffi -p thinkthen-python -p thinkthen-r -p thinkthen-node --test transport_logging
python3 - <<'PY'
import runpy
import sys
sys.path.insert(0, 'scripts')
print('repaired canonical native key:', runpy.run_path('scripts/native-prepare')['cache_path']().name)
PY
