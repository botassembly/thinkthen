#!/usr/bin/env python3
"""Exercise final artifact identity, target routing and consumer continuation."""
import hashlib
import io
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
import textwrap
import unittest
import urllib.error
from unittest.mock import patch
from types import SimpleNamespace

from release_workflow import ROOT, version


class PlatformRelease(unittest.TestCase):
    def test_live_windows_job_refuses_invalid_or_unpublished_releases(self):
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'],
            input=(ROOT / '.github/workflows/release-live-install.yml').read_bytes()))
        job, = workflow['jobs'].values()
        self.assertEqual(job['runs-on'], 'windows-2022')
        self.assertLessEqual(job['timeout-minutes'], 90)
        self.assertNotIn('if', job)
        checkout, = (step for step in job['steps'] if step.get('uses', '').startswith('actions/checkout@')
                        and 'path' not in step['with'])
        self.assertEqual(checkout['with']['ref'], 'refs/tags/${{ inputs.tag }}')
        admission = next(step for step in job['steps'] if step.get('name') == 'Require a published version tag')
        code = admission['run'].split("<<'PY'\n", 1)[1].rsplit('\nPY', 1)[0]
        published = {'tagName': 'v0.2.0', 'isDraft': False, 'publishedAt': '2026-11-16T00:00:00Z'}
        cases = [('v0.2.0', published, True), ('main', published, False),
                 ('v0.2.0', dict(published, isDraft=True), False),
                 ('v0.2.0', dict(published, publishedAt=None), False),
                 ('v0.2.0', dict(published, tagName='v0.1.2'), False)]
        for tag, release, success in cases:
            with self.subTest(tag=tag, release=release), patch.dict(os.environ,
                    RELEASE_TAG=tag, GITHUB_REPOSITORY='botassembly/thinkthen'), \
                    patch.object(subprocess, 'check_output', return_value=json.dumps(release)):
                if success:
                    exec(compile(code, '<workflow-admission>', 'exec'), {})
                else:
                    with self.assertRaises(ValueError):
                        exec(compile(code, '<workflow-admission>', 'exec'), {})
        with patch.dict(os.environ, RELEASE_TAG='v0.2.0', GITHUB_REPOSITORY='botassembly/thinkthen'), \
                patch.object(subprocess, 'check_output', side_effect=subprocess.CalledProcessError(1, 'gh')):
            with self.assertRaises(subprocess.CalledProcessError):
                exec(compile(code, '<workflow-admission>', 'exec'), {})

    def test_live_windows_job_runs_existing_consumers_and_propagates_failure(self):
        import release_rust, release_windows_r, release_windows_host
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'],
            input=(ROOT / '.github/workflows/release-live-install.yml').read_bytes()))
        job, = workflow['jobs'].values()
        step = job['steps'][-1]
        self.assertNotIn('if', step)
        self.assertFalse(step.get('continue-on-error', False))
        code = step['run'].split("<<'PY'\n", 1)[1].rsplit('\nPY', 1)[0]
        sites = runpy.run_path(str(ROOT / 'scripts/release-live-install-check'))['SITES']
        calls = []
        def install(arguments, *, env, check):
            calls.append(arguments)
            self.assertTrue(env['PATH'].startswith(str(Path('/pinned/cargo').parent)))
            if check:
                raise subprocess.CalledProcessError(23, arguments)
            return subprocess.CompletedProcess(arguments, 23)
        with patch.object(release_rust, 'prepare'), patch.object(release_windows_r, 'runtime'), \
                patch.object(release_windows_host, 'prepare_msys2'), \
                patch.object(release_windows_host, 'environment', return_value={'PATH': 'consumer-tools'}), \
                patch.object(release_windows_host, 'prepare_swift', side_effect=lambda env, folder: env), \
                patch.object(subprocess, 'check_output', return_value='/pinned/cargo\n'), \
                patch.object(subprocess, 'run', side_effect=install):
            with self.assertRaises(subprocess.CalledProcessError):
                exec(compile(code, '<workflow-consumers>', 'exec'), {})
        self.assertEqual(len(calls), 1)
        self.assertEqual(calls[0][1], 'scripts/release-live-install-check')
        self.assertEqual(calls[0][2:], [site for site in sites if site != 'homebrew'])

    def test_swift_retry_uses_corrected_tooling_and_preserves_tag_guard(self):
        import release_rust, release_windows_r, release_windows_host, release_workflow
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'],
            input=(ROOT / '.github/workflows/release-live-install.yml').read_bytes()))
        steps = workflow['jobs']['windows']['steps']
        tooling = next(step for step in steps if step.get('with', {}).get('path') == 'tooling')
        self.assertEqual(tooling['if'], "inputs.scope == 'swift'")
        self.assertEqual(tooling['with']['ref'], '${{ github.sha }}')
        guard = next(step for step in steps if step.get('name') == 'Check the selected release source')
        code = guard['run'].split("<<'PY'\n", 1)[1].split('\nPY', 1)[0]
        with patch.dict(os.environ, RELEASE_TAG='v0.1.2'), patch.object(release_workflow, 'version', return_value='0.2.0'):
            with self.assertRaisesRegex(ValueError, 'tag and package version differ'):
                exec(compile(code, '<published-source-guard>', 'exec'), {})
        code = steps[-1]['run'].split("<<'PY'\n", 1)[1].rsplit('\nPY', 1)[0]
        with patch.dict(os.environ, LIVE_INSTALL_SCOPE='swift'), \
                patch.object(release_rust, 'prepare') as rust, \
                patch.object(release_windows_r, 'runtime') as r, \
                patch.object(release_windows_host, 'prepare_msys2') as gcc, \
                patch.object(release_windows_host, 'environment', return_value={'PATH': 'swift-tools'}), \
                patch.object(release_windows_host, 'prepare_swift', side_effect=lambda env, folder: env), \
                patch.object(subprocess, 'run', side_effect=subprocess.CalledProcessError(17, 'consumer')) as run:
            with self.assertRaises(subprocess.CalledProcessError):
                exec(compile(code, '<swift-retry>', 'exec'), {})
            self.assertEqual(run.call_args.args[0][1:],
                ['tooling/scripts/release-live-install-check', 'swift', '--source', '.'])
            self.assertTrue(run.call_args.kwargs['check'])
            for unused in (rust, r, gcc):
                unused.assert_not_called()

    def test_live_swift_uses_tooling_fixtures_with_published_package(self):
        checker = runpy.run_path(str(ROOT / 'scripts/release-live-install-check'))
        namespace = checker['main'].__globals__
        case = next(case for case in json.loads((ROOT / 'construction/stub.json').read_text())
                    if case['request']['question']['function'] == 'decide'
                    and len(case['request']['records']) == 1 and case['expected'][0]['status'] == 'answered')
        case['request']['records'] = ['published source witness']
        for windows, failure in ((True, None), (False, None), (True, 'child'), (True, 'sources'), (True, 'binary')):
            with self.subTest(windows=windows, failure=failure), tempfile.TemporaryDirectory() as temporary:
                folder = Path(temporary)
                source = folder / 'published'
                tooling = folder / 'tooling'
                shutil.copytree(ROOT / 'sdk/swift/tests', tooling / 'sdk/swift/tests')
                if failure == 'sources':
                    tooling = folder / 'empty-tooling'
                    (tooling / 'sdk/swift/tests').mkdir(parents=True)
                    (tooling / 'sdk/swift/tests/Package.swift').write_text('manifest without consumer files')
                (source / 'sdk/swift').mkdir(parents=True)
                (source / 'conformance').mkdir()
                self.assertFalse((source / 'sdk/swift/tests').exists())
                (source / 'Cargo.toml').write_text('[workspace.package]\nversion="0.2.9"\n')
                (source / 'construction').mkdir()
                (source / 'construction/stub.json').write_text(json.dumps([case]))
                (source / 'scripts/release').mkdir(parents=True)
                for name in ('swift.py', 'filter_contract.py'):
                    shutil.copy2(ROOT / 'scripts/release' / name, source / 'scripts/release' / name)
                tools = folder / 'tools'
                tools.mkdir()
                binary = folder / 'reported output' / ('Consumer.exe' if windows else 'Consumer')
                consumer = ('#!' + sys.executable + '\nimport json,sys\nfrom pathlib import Path\n'
                    'cases=json.loads(Path(sys.argv[1]).read_text())\n'
                    'assert cases[0]["request"]["records"] == ["published source witness"]\n'
                    + ('sys.exit(17)\n' if failure == 'child' else 'for case in cases: print(json.dumps(case["expected"]))\n'))
                swift = tools / 'swift'
                swift.write_text('#!' + sys.executable + '\n' + textwrap.dedent(f"""
                    import sys
                    from pathlib import Path
                    package=Path(sys.argv[sys.argv.index('--package-path')+1])
                    assert 'exact: "0.2.9"' in (package/'Package.swift').read_text()
                    assert (package/'Consumer.swift').read_bytes() == { (ROOT / 'sdk/swift/tests/Consumer.swift').read_bytes()!r}
                    binary=Path({str(binary)!r})
                    if '--show-bin-path' in sys.argv:
                        print(binary.parent)
                    else:
                        print('compiler stdout retained')
                        print('compiler stderr retained', file=sys.stderr)
                        if {failure != 'binary'!r}:
                            binary.parent.mkdir(parents=True, exist_ok=True)
                            binary.write_text({consumer!r})
                            binary.chmod(0o755)
                    """))
                swift.chmod(0o755)
                environment = SimpleNamespace(name='nt' if windows else 'posix', environ=os.environ, pathsep=os.pathsep)
                with patch.dict(namespace, os=environment, ROOT=tooling), \
                        patch.dict(os.environ, PATH=str(tools) + os.pathsep + os.environ['PATH']), \
                        patch.object(sys, 'argv', ['release-live-install-check', 'swift', '--source', str(source)]), \
                        patch.object(sys, 'stdout', new_callable=io.StringIO) as output:
                    if failure:
                        with self.assertRaisesRegex(SystemExit, 'live install failed: swift'):
                            checker['main']()
                    else:
                        checker['main']()
                    text = output.getvalue()
                    if failure == 'sources':
                        self.assertIn('Swift consumer sources are unavailable', text)
                        self.assertNotIn('compiler stdout retained', text)
                    else:
                        self.assertIn('compiler stdout retained', text)
                        self.assertIn('compiler stderr retained', text)
                    if failure == 'binary':
                        self.assertIn('Swift build did not produce the consumer executable', text)

    def test_prepared_image_ids_and_tags_must_exist(self):
        import release_images
        identity = 'sha256:' + 'a' * 64
        for supplied in (False, True):
            env = {'THINKTHEN_FLOOR_IMAGE': identity} if supplied else {}
            with self.subTest(supplied=supplied), patch.dict(os.environ, env, clear=True):
                with patch.object(subprocess, 'check_output', return_value=identity + '\n') as inspect:
                    self.assertEqual(release_images.image('floor'), identity)
                    self.assertEqual(inspect.call_args.args[0][3], identity if supplied else release_images.TAGS['floor'])
                with patch.object(subprocess, 'check_output', side_effect=subprocess.CalledProcessError(1, 'docker')):
                    with self.assertRaisesRegex(RuntimeError, 'prepared image unavailable: floor'):
                        release_images.image('floor')

    def test_foreign_image_metadata_keeps_identity_without_local_lookup(self):
        import release_images
        identity = 'sha256:' + 'a' * 64
        with patch.dict(os.environ, {'THINKTHEN_FLOOR_IMAGE': identity}, clear=True):
            with patch.object(subprocess, 'check_output') as inspect:
                self.assertEqual(release_images.image('floor', require_local=False), identity)
                inspect.assert_not_called()
        with patch.dict(os.environ, {'THINKTHEN_FLOOR_IMAGE': 'unvalidated-tag'}, clear=True):
            with self.assertRaisesRegex(ValueError, 'immutable identity'):
                release_images.image('floor', require_local=False)
        with patch.dict(os.environ, {}, clear=True):
            with patch.object(subprocess, 'check_output', return_value=identity + '\n') as inspect:
                self.assertEqual(release_images.image('floor', require_local=False), identity)
                self.assertEqual(inspect.call_args.args[0][3], release_images.TAGS['floor'])
            os.environ.pop('THINKTHEN_FLOOR_IMAGE')
            with patch.object(subprocess, 'check_output', side_effect=subprocess.CalledProcessError(1, 'docker')):
                with self.assertRaisesRegex(RuntimeError, 'prepared image unavailable'):
                    release_images.image('floor', require_local=False)

    def test_publication_invalid_ref_refuses_before_upload_jobs(self):
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'],
            input=(ROOT / '.github/workflows/release.yml').read_bytes()))
        jobs = workflow['jobs']
        validation = jobs['validate-ref']
        self.assertNotIn('if', validation)
        script = validation['steps'][0]['run']
        for ref, deployment, success in [('refs/heads/main', '', False), ('refs/tags/other', '', False),
                                         ('refs/tags/v0.2.0', '', True), ('refs/tags/v0.2.0', 'recorded-id', False),
                                         ('refs/tags/v0.2.0-registry-recovery.1', 'recorded-id', True)]:
            result = subprocess.run(['bash', '-eu', '-c', script],
                                    env=dict(os.environ, GITHUB_REF=ref, MAVEN_DEPLOYMENT_ID=deployment), capture_output=True, text=True)
            self.assertEqual(result.returncode == 0, success, result.stderr)
        recovery = 'refs/tags/v0.2.0-registry-recovery.1'
        for name in ('upload', 'homebrew'):
            self.assertEqual(jobs[name]['needs'], 'validate-ref')
            self.assertEqual(jobs[name]['if'], f"github.ref != '{recovery}'")
        ruby = jobs['rubygems']
        self.assertEqual(ruby['needs'], 'validate-ref')
        self.assertEqual(ruby['if'], f"github.ref == '{recovery}' && inputs.deployment_id == ''")
        self.assertEqual(ruby['environment'], 'release')
        self.assertNotIn('strategy', ruby)
        checkouts = [step['with'] for step in ruby['steps'] if step.get('uses', '').startswith('actions/checkout@')]
        self.assertEqual(checkouts, [
            {'ref': '${{ github.sha }}', 'persist-credentials': False},
            {'ref': 'v0.2.0', 'path': 'source', 'persist-credentials': False}])
        download, = [step['run'] for step in ruby['steps'] if step.get('name') == 'Download and verify the approved release']
        self.assertIn('download rubygems', download)
        self.assertIn('--source source', download)
        self.assertNotIn('GITHUB_REF=', download)
        maven = jobs['maven']
        self.assertEqual(maven['if'], f"github.ref == '{recovery}'")
        self.assertEqual(maven['environment'], 'release')
        retained, = [step for step in maven['steps'] if step.get('name') == 'Retain Central deployment evidence']
        self.assertEqual(retained['if'], 'always()')
        self.assertEqual(retained['with']['path'], 'maven-recovery/')

    def test_rubygems_platform_absence_and_immutable_bytes(self):
        import release_upload
        payload = b'approved native gem'
        with tempfile.TemporaryDirectory() as temporary:
            registry = Path(temporary)
            (registry / 'rubygems').mkdir()
            package = registry / 'rubygems/thinkthen-0.2.0-x86_64-linux.gem'
            package.write_bytes(payload)
            api = 'https://rubygems.org/api/v2/rubygems/thinkthen/versions/0.2.0.json?platform=x86_64-linux'
            download = 'https://rubygems.org/downloads/' + package.name
            for metadata, served, pushes in [(404, None, 1), (200, payload, 0), (403, None, 0),
                                             (500, None, 0), (200, b'different gem', 0), (200, 403, 0),
                                             (200, 404, 0)]:
                with self.subTest(metadata=metadata, served=served):
                    requests = []
                    def response(request):
                        url = request.full_url
                        requests.append(url)
                        status = metadata if url == api else served if isinstance(served, int) else 200
                        if status != 200:
                            raise urllib.error.HTTPError(url, status, 'fixture response', {}, None)
                        self.assertIn(url, (api, download))
                        return io.BytesIO(b'{}' if url == api else served)
                    with patch('urllib.request.urlopen', side_effect=response), patch.object(release_upload, 'quiet') as push:
                        if metadata in (403, 500) or served in (403, 404) or served == b'different gem':
                            with self.assertRaises((ValueError, urllib.error.HTTPError)):
                                release_upload.upload('rubygems', registry)
                        else:
                            release_upload.upload('rubygems', registry)
                        self.assertEqual(push.call_count, pushes)
                    self.assertEqual(requests[0], api)
                    if metadata != 200:
                        self.assertEqual(requests, [api])
            # A failed push can mean the server accepted it: verify the now-public bytes.
            with patch('urllib.request.urlopen', side_effect=[
                    urllib.error.HTTPError(api, 404, 'absent', {}, None), io.BytesIO(b'{}'), io.BytesIO(payload)]), \
                    patch.object(release_upload, 'quiet', side_effect=ValueError('transport failed')) as push:
                release_upload.upload('rubygems', registry)
                self.assertEqual(push.call_count, 1)

    def test_recovery_requires_exact_ref_target_checksum_and_provenance(self):
        import release_upload
        digest = '102b6539e2e90d74a4c4f862a17067851f82c14236059964c8612f8ada903859'
        target = '24e419497cf89715a88727546e4f3b6661f8303e'
        ref = 'refs/tags/v0.2.0-registry-recovery.1'
        provenance = {'revision': 'fff4022dd247d21bde20d367bc1b738242396865', 'version': '0.2.0'}
        for execution, tag, checksum, checkout, different in [
                (ref, 'v0.2.0', digest, target, False),
                ('refs/heads/main', 'v0.2.0', digest, target, False),
                ('refs/tags/v0.2.0-registry-recovery.2', 'v0.2.0', digest, target, False),
                (ref, 'v0.2.1', digest, target, False), (ref, 'v0.2.0', '0' * 64, target, False),
                (ref, 'v0.2.0', digest, '0' * 40, False), (ref, 'v0.2.0', digest, target, True)]:
            with self.subTest(execution=execution, tag=tag, checksum=checksum, checkout=checkout, different=different), \
                    tempfile.TemporaryDirectory() as temporary:
                root = Path(temporary)
                source, destination = root / 'source', root / 'approved'
                source.mkdir()
                (source / 'release-source.json').write_text(json.dumps(provenance))
                downloaded = dict(provenance, revision='wrong') if different else provenance
                def download(*args):
                    destination.mkdir()
                    with tarfile.open(destination / 'thinkthen-0.2.0-registries.tar.gz', 'w:gz') as archive:
                        data = json.dumps(downloaded).encode()
                        member = tarfile.TarInfo('source.json')
                        member.size = len(data)
                        archive.addfile(member, io.BytesIO(data))
                def output(*args):
                    return checkout if args[0] == 'git' else json.dumps({'tagName': 'v0.2.0'})
                success = (execution, tag, checksum, checkout, different) == (ref, 'v0.2.0', digest, target, False)
                with patch.dict(os.environ, GITHUB_REF=execution), \
                        patch.object(release_upload.subprocess, 'run', return_value=type('Result', (), {'returncode': 1})()), \
                        patch.object(release_upload, 'output', side_effect=output), \
                        patch.object(release_upload, 'quiet', side_effect=download), \
                        patch.object(release_upload, 'verify_download') as verify:
                    if success:
                        self.assertEqual(release_upload.approved(tag, checksum, destination, source), destination / 'registries')
                        verify.assert_called_once_with(destination, digest)
                    else:
                        with self.assertRaises(ValueError):
                            release_upload.approved(tag, checksum, destination, source)

    def test_approved_download_preserves_checksum_and_inventory_refusal(self):
        from release_upload import verify_download
        with tempfile.TemporaryDirectory() as temporary:
            destination = Path(temporary)
            (destination / 'package.gem').write_bytes(b'approved package')
            sums = destination / 'SHA256SUMS'
            sums.write_text(hashlib.sha256(b'approved package').hexdigest() + '  package.gem\n')
            digest = hashlib.sha256(sums.read_bytes()).hexdigest()
            verify_download(destination, digest)
            with self.assertRaisesRegex(ValueError, 'PM-approved checksum'):
                verify_download(destination, '0' * 64)
            (destination / 'package.gem').write_bytes(b'changed package')
            with self.assertRaisesRegex(ValueError, 'checksum differs'):
                verify_download(destination, digest)
            (destination / 'package.gem').write_bytes(b'approved package')
            (destination / 'extra.gem').write_bytes(b'unapproved')
            with self.assertRaisesRegex(ValueError, 'incomplete checksum inventory'):
                verify_download(destination, digest)

    def test_maven_recovery_preserves_payload_and_requires_failed_predecessor(self):
        import release_upload
        original = (b'<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>'
                    b'<parent><groupId>io.github.botassembly</groupId><artifactId>thinkthen-jvm-parent</artifactId>'
                    b'<version>0.2.0</version><relativePath/></parent>'
                    b'<groupId>io.github.botassembly</groupId><artifactId>thinkthen-jvm</artifactId>'
                    b'<version>0.2.0</version><packaging>pom</packaging>'
                    b'<distributionManagement><relocation><groupId>io.github.botassembly</groupId>'
                    b'<artifactId>thinkthen-java</artifactId><version>0.2.0</version>'
                    b'</relocation></distributionManagement></project>\n')
        self.assertEqual(hashlib.sha256(original).hexdigest(), 'b63131f98b802f41e7e8dab7b5e092ee7f09537ec1d0303371146c8cf5a1de57')
        predecessor = '67d06e5b-c5e4-43b5-a357-f7818e726d77'
        deployment = '11111111-2222-3333-4444-555555555555'
        pom_name = 'io/github/botassembly/thinkthen-jvm/0.2.0/thinkthen-jvm-0.2.0.pom'
        for scenario in ('published', 'failed', 'timeout', 'missing', 'nonfailed', 'wrong-pom', 'rerun',
                         'status-only', 'ambiguous'):
            with self.subTest(scenario=scenario), tempfile.TemporaryDirectory() as temporary:
                root = Path(temporary)
                registry = root / 'approved'
                pom = registry / 'maven' / pom_name
                pom.parent.mkdir(parents=True)
                pom.write_bytes(original + (b'changed' if scenario == 'wrong-pom' else b''))
                jar = registry / 'maven/thinkthen-java.jar'
                jar.write_bytes(b'qualified JAR bytes')
                before = {path.relative_to(registry).as_posix(): path.read_bytes() for path in registry.rglob('*') if path.is_file()}
                calls = []
                errors = {'pkg:maven/io.github.botassembly/thinkthen-jvm@0.2.0': ['Project name is missing']}
                def central(path, method='POST'):
                    calls.append((path, method))
                    if path == 'status?id=' + predecessor:
                        if scenario == 'missing':
                            raise urllib.error.HTTPError(path, 404, 'not found', {}, None)
                        state = 'PUBLISHED' if scenario == 'nonfailed' else 'FAILED'
                        return json.dumps({'deploymentId': predecessor, 'deploymentState': state, 'errors': errors}).encode()
                    if path == 'deployment/' + predecessor:
                        self.assertEqual(method, 'DELETE')
                        return b''
                    self.assertEqual(path, 'status?id=' + deployment)
                    state = 'FAILED' if scenario == 'failed' else 'PUBLISHING' if scenario == 'timeout' else 'PUBLISHED'
                    return json.dumps({'deploymentId': deployment, 'deploymentState': state, 'errors': errors if state == 'FAILED' else {}}).encode()
                def quiet(*args, **options):
                    if '--detach-sign' in args:
                        Path(str(args[-1]) + '.asc').write_bytes(b'public fixture signature')
                environment = {'GITHUB_RUN_ATTEMPT': '2' if scenario == 'rerun' else '1',
                               'MAVEN_DEPLOYMENT_ID': deployment if scenario == 'status-only' else '',
                               'MAVEN_CENTRAL_USERNAME': 'fixture', 'MAVEN_CENTRAL_PASSWORD': 'fixture',
                               'MAVEN_CENTRAL_GPG_PRIVATE_KEY': 'fixture', 'MAVEN_CENTRAL_GPG_PASSPHRASE': 'fixture'}
                with patch.dict(os.environ, environment), patch.object(release_upload, 'ROOT', root), \
                        patch.object(release_upload, 'central', side_effect=central), \
                        patch.object(release_upload, 'quiet', side_effect=quiet), \
                        patch.object(release_upload.urllib.request, 'urlopen', return_value=io.BytesIO(b'' if scenario == 'ambiguous' else deployment.encode())) as upload, \
                        patch.object(release_upload.time, 'monotonic', side_effect=[0, 1201]), \
                        patch.object(release_upload.time, 'sleep'):
                    success = scenario in ('published', 'status-only')
                    if success:
                        release_upload.maven_recovery(registry)
                    else:
                        with self.assertRaises((ValueError, TimeoutError, urllib.error.HTTPError)):
                            release_upload.maven_recovery(registry)
                    expected_upload = scenario in ('published', 'failed', 'timeout', 'ambiguous')
                    self.assertEqual(upload.call_count, int(expected_upload))
                    evidence = root / 'maven-recovery'
                    if expected_upload:
                        self.assertIn(('deployment/' + predecessor, 'DELETE'), calls)
                        self.assertEqual(json.loads((evidence / 'predecessor.json').read_text())['errors'], errors)
                        receipt = json.loads((evidence / 'receipt.json').read_text())
                        self.assertTrue(receipt['upload_started'])
                        outbound = evidence / 'outbound'
                        corrected = (outbound / 'maven' / pom_name).read_bytes()
                        self.assertEqual(corrected.replace(b'<name>ThinkThen JVM</name>', b'', 1), original)
                        self.assertEqual((outbound / 'maven/thinkthen-java.jar').read_bytes(), jar.read_bytes())
                        self.assertEqual(receipt['bundle_sha256'], hashlib.sha256((outbound / 'maven-central.zip').read_bytes()).hexdigest())
                        if scenario != 'ambiguous':
                            self.assertEqual(receipt['deployment_id'], deployment)
                            self.assertEqual((evidence / 'deployment-id.txt').read_text().strip(), deployment)
                        # Reentering after even an ambiguous response cannot upload again.
                        with self.assertRaisesRegex(ValueError, 'reruns require'):
                            release_upload.maven_recovery(registry)
                        self.assertEqual(upload.call_count, 1)
                    else:
                        self.assertNotIn(('deployment/' + predecessor, 'DELETE'), calls)
                    self.assertEqual({path.relative_to(registry).as_posix(): path.read_bytes() for path in registry.rglob('*') if path.is_file()}, before)

    def test_required_installer_shell_missing_refuses(self):
        installer = runpy.run_path(str(ROOT / 'scripts/installer-test'))
        with patch('shutil.which', return_value=None):
            with self.assertRaisesRegex(RuntimeError, 'Required installer startup runtime unavailable'):
                installer['require_shells']()
        with patch('shutil.which', side_effect=lambda name: '/bin/' + name):
            installer['require_shells']()

    def test_named_go_consumers_refuse_zero_matches(self):
        import go_guide_examples
        from release_windows_sdks import require_go_test
        with tempfile.TemporaryDirectory() as temporary:
            binary = Path(temporary) / 'consumer'
            binary.write_text('#!' + sys.executable + '\nimport sys\n'
                              'print("TestGuideFixture" if "-test.list=^TestGuide" in sys.argv else "PASS")\n')
            binary.chmod(0o755)
            go_guide_examples.runtime_contract(str(binary), os.environ)
            binary.write_text('#!' + sys.executable + '\nprint("PASS")\n')
            with self.assertRaisesRegex(RuntimeError, 'Required Go tests not found'):
                go_guide_examples.runtime_contract(str(binary), os.environ)
            def execute(*arguments):
                return subprocess.check_output(list(map(str, arguments)), text=True)
            with self.assertRaisesRegex(RuntimeError, 'Required Go test not found'):
                require_go_test(execute, binary, 'TestSharedStub')
            binary.write_text('#!' + sys.executable + '\nprint("TestSharedStub")\n')
            require_go_test(execute, binary, 'TestSharedStub')

    def test_homebrew_trusts_only_rehearsal_formula_before_loading_and_cleans_up(self):
        for failure in ('none', 'cache', 'install', 'test', 'uninstall', 'preexisting'):
            with self.subTest(failure=failure), tempfile.TemporaryDirectory() as temporary:
                work = Path(temporary)
                packages, release, scratch = work / 'packages', work / 'release', work / 'scratch'
                (packages / 'homebrew').mkdir(parents=True)
                release.mkdir()
                scratch.mkdir()
                formula = packages / 'homebrew/thinkthen.rb'
                formula.write_bytes(b'unchanged generated release formula\n')
                archive = release / f'thinkthen-{version()}-macos-arm64.tar.gz'
                archive.write_bytes(b'unchanged qualified command archive')
                global_config = work / 'caller-config/homebrew'
                global_config.mkdir(parents=True)
                sentinel = global_config / 'trust.json'
                sentinel.write_text('unrelated caller trust')
                if failure == 'preexisting':
                    (work / 'installed').mkdir()
                    (work / 'installed/caller-file').write_text('caller installation')
                bin_dir = work / 'bin'
                bin_dir.mkdir()
                executable = bin_dir / 'brew'
                executable.write_text('#!' + sys.executable + '\n' + textwrap.dedent('''
                    import json, os, shutil, sys
                    from pathlib import Path
                    root = Path(os.environ['BREW_FIXTURE'])
                    args = sys.argv[1:]
                    tap, name = 'botassembly/release-check', 'botassembly/release-check/thinkthen'
                    config = Path(os.environ['XDG_CONFIG_HOME']) / 'homebrew/trust.json'
                    with (root / 'calls').open('a') as log:
                        log.write(json.dumps({'args': args, 'config': str(config), 'cache': os.environ['HOMEBREW_CACHE'],
                                              'developer': os.environ.get('HOMEBREW_DEVELOPER')}) + '\\n')
                    assert not os.environ.get('HOMEBREW_NO_REQUIRE_TAP_TRUST')
                    repository = root / 'tap'
                    if args == ['tap-new', '--no-git', tap]:
                        (repository / 'Formula').mkdir(parents=True)
                    elif args == ['--repository', tap]: print(repository)
                    elif args == ['trust', '--formula', name]:
                        config.parent.mkdir(parents=True, exist_ok=True)
                        config.write_text(json.dumps([name]))
                    elif args == ['--cache', '--formula', name]:
                        if not config.is_file() or config.read_text() != json.dumps([name]):
                            print('refuse to load untrusted formula ' + name, file=sys.stderr)
                            sys.exit(41)
                        assert (repository / 'Formula/thinkthen.rb').read_bytes() == b'unchanged generated release formula\\n'
                        if os.environ['BREW_FAILURE'] == 'cache': sys.exit('seeded cache failure')
                        print(Path(os.environ['HOMEBREW_CACHE']) / 'exact-release.tar.gz')
                    elif args == ['install', '--formula', name]:
                        assert (Path(os.environ['HOMEBREW_CACHE']) / 'exact-release.tar.gz').read_bytes() == b'unchanged qualified command archive'
                        (root / 'installed').mkdir()
                        if os.environ['BREW_FAILURE'] == 'install': sys.exit('seeded install failure')
                    elif args == ['--cellar', name]: print(root / 'installed')
                    elif args == ['test', name]:
                        assert (root / 'installed').is_dir()
                        if os.environ['BREW_FAILURE'] == 'test': sys.exit('seeded test failure')
                    elif args == ['uninstall', '--formula', name]:
                        shutil.rmtree(root / 'installed')
                        if os.environ['BREW_FAILURE'] == 'uninstall': sys.exit('seeded uninstall failure')
                    elif args == ['untap', tap]: shutil.rmtree(repository)
                    else: raise AssertionError(args)
                '''))
                executable.chmod(0o755)
                env = dict(os.environ, PATH=str(bin_dir) + os.pathsep + os.environ['PATH'],
                           XDG_CONFIG_HOME=str(global_config.parent), BREW_FIXTURE=str(work), BREW_FAILURE=failure)
                result = subprocess.run([sys.executable, '-c',
                    'import runpy,sys; from pathlib import Path; sys.path.insert(0,str(Path(sys.argv[1]).parent)); '
                    'runpy.run_path(sys.argv[1])["brew"](*map(Path,sys.argv[2:]))',
                    ROOT / 'scripts/release-platform-check', packages, release, scratch],
                    env=env, text=True, capture_output=True)
                self.assertEqual(result.returncode == 0, failure == 'none', result.stderr)
                if failure == 'preexisting':
                    self.assertIn('requires an absent installation', result.stderr)
                    self.assertEqual((work / 'installed/caller-file').read_text(), 'caller installation')
                elif failure != 'none': self.assertIn('seeded ' + failure + ' failure', result.stderr)
                calls = [json.loads(line) for line in (work / 'calls').read_text().splitlines()]
                commands = [call['args'] for call in calls]
                self.assertIn(['trust', '--formula', 'botassembly/release-check/thinkthen'], commands)
                self.assertLess(commands.index(['trust', '--formula', 'botassembly/release-check/thinkthen']),
                                commands.index(['--cache', '--formula', 'botassembly/release-check/thinkthen']))
                self.assertEqual(commands[-1], ['untap', 'botassembly/release-check'])
                self.assertFalse((work / 'tap').exists())
                self.assertEqual((work / 'installed').exists(), failure == 'preexisting')
                self.assertEqual(sentinel.read_text(), 'unrelated caller trust')
                for call in calls:
                    self.assertTrue(Path(call['config']).is_relative_to(scratch))
                    self.assertFalse(Path(call['config']).parent.parent.exists())
                    self.assertEqual(Path(call['cache']), scratch / 'brew-cache')
                    self.assertEqual(call['developer'], '1')
                self.assertEqual(formula.read_bytes(), b'unchanged generated release formula\n')
                self.assertEqual(archive.read_bytes(), b'unchanged qualified command archive')

    def test_rejects_unqualified_artifact_before_any_consumer(self):
        with tempfile.TemporaryDirectory() as temporary:
            work = Path(temporary)
            source = work / 'input'
            source.mkdir()
            metadata = source / 'source.json'
            metadata.write_text(json.dumps({'revision': 'old', 'version': version()}))
            release = work / 'release'
            release.mkdir()
            archive = release / f'thinkthen-{version()}-registries.tar.gz'
            with tarfile.open(archive, 'w:gz') as packed:
                packed.add(metadata, arcname='source.json')
            (release / 'SHA256SUMS').write_text(hashlib.sha256(archive.read_bytes()).hexdigest() + '  ' + archive.name + '\n')
            command = [sys.executable, ROOT / 'scripts/release-platform-check', '--homebrew-only', release, 'current', work / 'scratch']
            result = subprocess.run(list(map(str, command)), text=True, capture_output=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertIn('registry source differs', result.stderr)
            archive.write_bytes(archive.read_bytes() + b'tampered')
            result = subprocess.run(list(map(str, command[:-1] + [work / 'scratch-two'])), text=True, capture_output=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertIn('checksum differs', result.stderr)
            self.assertNotIn('release platform prepare', result.stdout)

    def test_homebrew_only_keeps_artifact_admission_and_skips_other_consumers(self):
        entry = runpy.run_path(str(ROOT / 'scripts/release-platform-check'))
        seen = []
        def admit(*_):
            seen.append('admit')
            return Path('admitted packages')
        with tempfile.TemporaryDirectory() as temporary, patch.dict(entry['main'].__globals__,
                admit=admit, brew=lambda *_: seen.append('brew')), patch('platform.system', return_value='Darwin'), \
                patch.object(sys, 'argv', ['release-platform-check', '--homebrew-only', 'release', 'sha', temporary + '/scratch']):
            entry['main']()
        self.assertEqual(seen, ['admit', 'brew'])

    def test_every_registry_consumer_runs_after_a_failed_npm_install(self):
        import release_registry_check as check
        seen = []
        def failed(*_):
            seen.append('npm')
            raise RuntimeError('seeded selector failure')
        with patch.object(check, 'install_node', failed), \
                patch.object(check, 'install_dotnet', lambda *_: seen.append('nuget')), \
                patch.object(check, 'install_jvm', lambda *_: seen.append('maven')):
            with self.assertRaisesRegex(RuntimeError, 'npm'):
                check.install(Path('packages'), Path('scratch'))
        self.assertEqual(seen, ['npm', 'nuget', 'maven'])

    def test_maven_feed_requires_this_checks_completed_preparation(self):
        from release_registry_check import maven_feed
        with tempfile.TemporaryDirectory() as temporary:
            work = Path(temporary)
            packages, scratch, home = work / 'packages', work / 'scratch', work / 'home'
            (packages / 'maven').mkdir(parents=True)
            scratch.mkdir()
            global_cache = home / '.local/share/thinkthen-build-tools/jvm/m2'
            global_cache.mkdir(parents=True)
            (global_cache / 'unrelated-user-artifact.jar').write_bytes(b'not prepared for this check')
            with patch.object(Path, 'home', return_value=home):
                for state in ('missing', 'incomplete'):
                    with self.subTest(preparation=state):
                        if state == 'incomplete':
                            (scratch / 'm2').mkdir()
                        with self.assertRaisesRegex(ValueError, 'not prepared for this registry check'):
                            maven_feed(packages, scratch)
                        self.assertFalse((scratch / 'maven-feed').exists())

    def test_python_and_brew_run_after_registry_failure(self):
        entry = runpy.run_path(str(ROOT / 'scripts/release-platform-check'))
        seen = []
        with tempfile.TemporaryDirectory() as temporary:
            scratch = Path(temporary) / 'scratch'
            def failed(*_):
                raise RuntimeError('seeded registry failure')
            with patch.dict(entry['main'].__globals__, {
                    'admit': lambda *_: Path('packages'), 'install': failed,
                    'install_python': lambda *_: seen.append('python'),
                    'brew': lambda *_: seen.append('brew')}), \
                    patch('release_installed_prepare.dotnet', lambda *_: None), \
                    patch('release_installed_prepare.jvm', lambda *_: None), \
                    patch('platform.system', return_value='Darwin'), \
                    patch.object(sys, 'argv', ['release-platform-check', 'release', 'sha', str(scratch)]):
                with self.assertRaisesRegex(SystemExit, 'npm-nuget-maven'):
                    entry['main']()
            self.assertEqual(seen, ['python', 'brew'])
            results = json.loads((scratch / 'results.json').read_text())
            self.assertEqual(results['python']['outcome'], 'success')
            self.assertEqual(results['npm-nuget-maven']['outcome'], 'failure')

    def test_aggregate_node_selector_refuses_a_wrong_target(self):
        from release_registry import node, NODE_TARGETS
        from release_notices import bundle
        actual = subprocess.check_output(['node', '-p', 'process.platform + "-" + process.arch'], text=True).strip()
        target, = [key for key, value in NODE_TARGETS.items() if value == actual]
        with tempfile.TemporaryDirectory() as temporary:
            work = Path(temporary)
            packages = {}
            for platform in NODE_TARGETS:
                source = work / platform
                package = source / 'package'
                package.mkdir(parents=True)
                (package / 'package.json').write_text(json.dumps({'name': 'thinkthen', 'version': version(),
                    'main': 'index.cjs', 'files': ['index.cjs', 'thinkthen.node']}))
                (package / 'index.cjs').write_text('module.exports = require("./thinkthen.node");\n')
                # A JS payload with the .node extension isolates loader selection;
                # actual native execution belongs to the installed release jobs.
                (package / 'thinkthen.node').write_text('module.exports = ' + json.dumps(platform) + ';\n')
                for name, data in bundle(platform, 'typescript').items():
                    path = package / name
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_bytes(data)
                destination = source / 'typescript'
                destination.mkdir()
                with tarfile.open(destination / 'binding.tgz', 'w:gz') as archive:
                    archive.add(package, arcname='package')
                packages[platform] = source
            for name, mapping, expected in [('wrong', dict(NODE_TARGETS, **{target: 'invalid-target'}), False),
                                             ('correct', NODE_TARGETS, True)]:
                scratch = work / name
                scratch.mkdir()
                output = scratch / 'packed'
                output.mkdir()
                def execute(*args, **options):
                    return subprocess.run(list(map(str, args)), check=True, capture_output=True, **options)
                with patch.dict(node.__globals__, NODE_TARGETS=mapping, run=execute):
                    node(packages, output, scratch)
                expanded = scratch / 'installed'
                with tarfile.open(next(output.glob('*.tgz'))) as archive:
                    archive.extractall(expanded, filter='data')
                result = subprocess.run(['node', '-e',
                    'require.extensions[".node"] = require.extensions[".js"]; console.log(require(process.argv[1]));',
                    str(expanded / 'package')], text=True, capture_output=True)
                self.assertEqual(result.returncode == 0, expected, result.stderr)
                if expected:
                    self.assertEqual(result.stdout.strip(), target)

    def test_windows_frame_closure_refuses_changed_cached_inputs(self):
        import release_windows_frames as frames
        import release_python_dependencies as runtime
        import zipfile
        with tempfile.TemporaryDirectory() as temporary:
            work = Path(temporary)
            catalog = work / 'pins.json'
            with patch.object(runtime, 'inputs', return_value={}), \
                    patch.object(frames, 'TOOLS', work), patch.object(frames, 'HASHES', catalog), \
                    patch.object(frames, 'PINS', {'windows_python_frames': {'example': 'https://example.invalid/example-1.0-py3-none-any.whl'}}):
                # This fixture wheel has no executable payload; it tests the
                # offline closure's cache admission before any package build.
                wheel = work / 'fixture.whl'
                with zipfile.ZipFile(wheel, 'w') as archive:
                    archive.writestr('example-1.0.dist-info/METADATA', 'Name: example\nVersion: 1.0\n')
                catalog.write_text(json.dumps({'example': {'example-1.0-py3-none-any.whl':
                    hashlib.sha256(wheel.read_bytes()).hexdigest()}}))
                cached = frames.location() / 'wheels/example-1.0-py3-none-any.whl'
                cached.parent.mkdir(parents=True)
                cached.write_bytes(wheel.read_bytes())
                frames.prepare()
                output = work / 'candidate'
                frames.stage(output)
                self.assertEqual((output / 'prerequisites/python-frames-windows/wheels' / cached.name).read_bytes(), wheel.read_bytes())
                requirements = cached.parent.parent / 'requirements.txt'
                original = requirements.read_text()
                requirements.write_text(original.replace('example==1.0', 'example==2.0'))
                with self.assertRaisesRegex(ValueError, 'requirements differ'):
                    frames.stage(work / 'wrong-requirements')
                requirements.write_text(original)
                cached.write_bytes(b'tampered wheel')
                with self.assertRaisesRegex(ValueError, 'checksum differs'):
                    frames.stage(work / 'wrong-wheel')

    def test_draft_depends_on_all_target_registry_installs(self):
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'],
            input=(ROOT / '.github/workflows/release-prepare.yml').read_bytes()))
        job = workflow['jobs']['registry-installed']
        self.assertFalse(job['strategy']['fail-fast'])
        self.assertEqual(set(job['strategy']['matrix']['runner']), {'macos-15', 'ubuntu-24.04-arm', 'windows-2022'})
        self.assertIn('registry-installed', workflow['jobs']['draft']['needs'])
        self.assertNotIn('always()', workflow['jobs']['draft'].get('if', ''))

    def test_valid_artifact_continues_after_independent_bundle_failure(self):
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'],
            input=(ROOT / '.github/workflows/release-prepare.yml').read_bytes()))
        jobs = workflow['jobs']
        bundle = jobs['bundle']
        steps = {step.get('id'): step for step in bundle['steps']}
        self.assertEqual(bundle.get('outputs', {}).get('artifact-ready'),
                         "${{ steps.upload-release.outcome == 'success' }}")
        admission = steps['admit-release']
        self.assertEqual(admission['if'], "always() && steps.attach-registries.outcome == 'success' && steps.tag-source-install.outcome == 'success'")
        self.assertIn('scripts/release-workflow draft release', admission['run'])
        self.assertIn('--dry-run', admission['run'])
        self.assertEqual(steps['upload-release']['if'],
                         "always() && steps.admit-release.outcome == 'success'")
        self.assertEqual(jobs['registry-installed']['if'],
                         "always() && needs.bundle.outputs.artifact-ready == 'true'")
        self.assertEqual(jobs['draft']['needs'], ['source', 'bundle', 'registry-installed'])
        self.assertNotIn('if', jobs['draft'])
        self.assertEqual(steps['no-release-artifact']['if'],
                         "always() && steps.admit-release.outcome != 'success'")
        self.assertIn('skipped', steps['no-release-artifact']['run'])


if __name__ == '__main__':
    unittest.main()
