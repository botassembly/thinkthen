#!/usr/bin/env python3
"""Exercise qualification preparation boundaries without native builds or downloads."""
import io
import os
from pathlib import Path, PureWindowsPath
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
import textwrap
from types import SimpleNamespace
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))


class QualificationRecipes(unittest.TestCase):
    def test_native_clean_guard_ignores_only_prepared_artifacts_without_global_policy(self):
        entry = runpy.run_path(str(ROOT / 'scripts/native-prepare'))
        def compiler_boundary(_):
            raise RuntimeError('clean source reached compiler boundary')
        with tempfile.TemporaryDirectory(prefix='native-source-policy-') as temporary:
            source = Path(temporary)
            (source / '.gitignore').write_bytes((ROOT / '.gitignore').read_bytes())
            (source / 'tracked.py').write_text('original\n')
            env = dict(os.environ, GIT_CONFIG_GLOBAL=os.devnull, PM_JOB='fixture receipt',
                       GIT_AUTHOR_NAME='Example', GIT_AUTHOR_EMAIL='example@example.com',
                       GIT_COMMITTER_NAME='Example', GIT_COMMITTER_EMAIL='example@example.com')
            for command in (['init', '--quiet'], ['add', '.'], ['commit', '--quiet', '-m', 'Source']):
                subprocess.run(['git', *command], cwd=source, env=env, check=True)
            for path in ('scripts/__pycache__/old.cpython-312.pyc', 'sdk/python/__pycache__/old.cpython-313.pyc',
                         'sdk/typescript/node_modules/prepared-package/index.js',
                         'sdk/typescript/node_modules/.package-lock.json'):
                cached = source / path
                cached.parent.mkdir(parents=True, exist_ok=True)
                cached.write_bytes(b'historical bytecode')
            with patch.dict(os.environ, env, clear=True), patch.dict(entry['main'].__globals__, ROOT=source), patch.dict(sys.modules, header_contract=SimpleNamespace(check=compiler_boundary)), patch.object(sys, 'argv', ['native-prepare', '--receipt', str(source / 'receipt.json')]):
                with self.assertRaisesRegex(RuntimeError, 'clean source reached compiler boundary'):
                    entry['main']()
                for path in ('tracked.py', 'scripts/__pycache__/unrecorded.py', 'package/unrecorded.py',
                             'sdk/typescript/unrecorded.js', 'sdk/other/node_modules/unrecorded.js'):
                    dirty = source / path
                    dirty.parent.mkdir(parents=True, exist_ok=True)
                    dirty.write_text('unrecorded source\n')
                    with self.assertRaisesRegex(SystemExit, 'clean committed checkout'):
                        entry['main']()
                    if path == 'tracked.py': dirty.write_text('original\n')
                    else: dirty.unlink()

    def test_go_and_zig_select_prepared_manifest_compiler_before_home_isolation(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / 'scripts').mkdir()
            (root / 'prepared-fixtures').mkdir()
            (root / 'sdk/zig').mkdir(parents=True)
            shutil.copy2(ROOT / 'sdk/zig/build.zig.zon', root / 'sdk/zig/build.zig.zon')
            (root / 'scripts/native-tools-env').touch()
            if (ROOT / 'scripts/zig-env').exists():
                shutil.copy2(ROOT / 'scripts/zig-env', root / 'scripts/zig-env')
            import re
            version = re.search(r'minimum_zig_version = "([^"]+)"', (root / 'sdk/zig/build.zig.zon').read_text())[1]
            home = root / 'prepared'
            compiler = home / '.local/share/thinkthen-build-tools/zig' / version / 'zig'
            compiler.parent.mkdir(parents=True)
            compiler.write_text('#!/bin/sh\nprintf "%s\\n" ' + version + '\n')
            compiler.chmod(0o755)
            for name, end in [('go-api-check', 'root=$PWD'), ('zig-sdk-gate', 'scratch=')]:
                text = (ROOT / 'scripts' / name).read_text()
                prefix = text[:text.index(end)].split('cd "$(dirname "$0")/.."', 1)[1]
                result = subprocess.check_output(['sh', '-eu', '-c', prefix + '\nHOME="$1"; export HOME; command -v zig; zig version', 'check', str(root / 'isolated')], cwd=root, env=dict(os.environ, HOME=str(home), THINKTHEN_NATIVE_FIXTURES=str(root / 'prepared-fixtures')), text=True)
                self.assertEqual(result.splitlines(), [str(compiler), version])

    def test_windows_jvm_stages_generated_contracts_before_maven(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['jvm']
        class ReachedMaven(Exception):
            pass
        def build(*arguments, **options):
            if arguments[0] == 'mvn':
                base = Path(options['cwd']) / 'source/sdk/java/library/target/generated-sources/contracts/io/thinkthen'
                self.assertTrue((base / 'ErrorCode.java').is_file())
                for name in ('DriverCode', 'NativeLayouts', 'NativeSignatures'):
                    self.assertTrue((base / 'internal' / (name + '.java')).is_file(), name)
                self.assertTrue((base.parents[6] / 'kotlin/target/generated-sources/contracts/io/thinkthen/kotlin/ErrorCode.kt').is_file())
                raise ReachedMaven()
            subprocess.run(list(map(str, arguments)), **options, check=True)
        with tempfile.TemporaryDirectory() as directory, patch.dict(action.__globals__, build=build):
            scratch = Path(directory)
            native = scratch / 'engine.dll'
            native.write_bytes(b'native fixture')
            with self.assertRaises(ReachedMaven):
                action(scratch, native, {'PATH': os.environ['PATH']}, {})

    def test_csharp_uses_caller_owned_launcher_before_cache_creation(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['main']
        with tempfile.TemporaryDirectory() as directory:
            with patch.dict(action.__globals__, os=SimpleNamespace(name='nt', environ=os.environ)), patch.object(sys, 'argv', ['windows-native-proof', 'csharp', directory]), patch('windows_caller_process.launch') as launch:
                action()
            self.assertEqual(launch.call_args.args[0][-3:], ['--caller-owned', 'csharp', directory])

    def test_direct_go_executable_has_bounded_test_timeout(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['go']
        captured = []
        def cache(command, root, environment, filename):
            self.assertEqual(Path(environment['THINKTHEN_CASES']) / '../schemas/row.schema.json', ROOT / 'conformance/../schemas/row.schema.json')
            captured.append(command)
        with tempfile.TemporaryDirectory() as directory, patch.dict(action.__globals__, build=lambda *args, **options: None, check_cache=cache):
            scratch = Path(directory)
            native = scratch / 'engine.dll'
            native.write_bytes(b'native fixture')
            action(scratch, native, {}, {})
        self.assertIn('-test.timeout=30m', captured[0])

    def test_source_and_registry_go_launchers_expose_canonical_fixtures(self):
        source = (ROOT / 'scripts/source-install-check').read_text()
        source = textwrap.dedent(source[source.index('        go_env ='):source.index('        if args.readmes:')])
        registry = (ROOT / 'scripts/registry-site-check').read_text()
        registry = textwrap.dedent(registry[registry.index('    environment ='):registry.index("    consumer = scratch / 'swift-consumer'")])
        with tempfile.TemporaryDirectory() as directory:
            for platform, recipe in [('linux', source), ('darwin', source), ('linux', registry)]:
                with self.subTest(platform=platform, recipe='source' if recipe == source else 'registry'):
                    calls = []
                    scope = dict(ROOT=ROOT, scratch=Path(directory), go=Path(directory), consumer=Path(directory),
                                 env={'HOME': directory, 'GOSUMDB': 'off', 'GOTOOLCHAIN': 'local',
                                      'GOWORK': 'off', 'CGO_ENABLED': '1'}, os=os,
                                 sys=SimpleNamespace(platform=platform, executable=sys.executable),
                                 go_command=('go',), run=lambda *args, **options: calls.append((args, options)))
                    exec(compile(recipe, 'installed-go-recipe', 'exec'), scope)
                    arguments, options = calls[0]
                    environment = dict(value.split('=', 1) for value in arguments[2:] if isinstance(value, str) and '=' in value) if 'runtime-floor-build' in str(arguments[0]) else options['env']
                    self.assertEqual(Path(environment['THINKTHEN_CASES']).parent / 'schemas/row.schema.json', ROOT / 'schemas/row.schema.json')
                    self.assertEqual(Path(environment['THINKTHEN_STUB_CASES']), ROOT / 'construction/stub.json')

    def test_loader_failures_keep_canonical_identity_through_a_temporary_alias(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            physical = (root / 'installed').resolve()
            physical.mkdir()
            alias = root / 'temporary'
            alias.symlink_to(physical, target_is_directory=True)
            engine = physical / 'engine.so'
            original = b'controlled installed engine'
            engine.write_bytes(original)
            witness = root / 'failures'
            probe = root / 'probe.py'
            probe.write_text('import ctypes,pathlib,sys\n'
                'engine=pathlib.Path(sys.argv[1])\n'
                'failure="broken" if engine.exists() else "missing"\n'
                'if engine.exists(): assert engine.read_bytes()==b"not a shared library\\n"\n'
                'with pathlib.Path(sys.argv[2]).open("a") as stream: stream.write(failure+"\\n")\n'
                'try: ctypes.CDLL(sys.argv[3])\n'
                'except OSError as error: print("cannot load native engine:", error); sys.exit(23)\n'
                'sys.exit(0)\n')
            for attempted, reported, accepted in (
                    (None, str(engine), True),
                    (None, str(root / 'unrelated/engine.so'), False),
                    (str(engine), str(engine), True),
                    ('@loader_path/engine.so', str(engine), False)):
                with self.subTest(attempted=attempted, reported=reported):
                    witness.unlink(missing_ok=True)
                    command = [sys.executable, str(ROOT / 'scripts/loader-failure-check'),
                               str(alias / engine.name)]
                    if attempted is not None:
                        command += ['--attempted', attempted]
                    result = subprocess.run([*command, '--', sys.executable, str(probe),
                        str(engine), str(witness), reported], capture_output=True, text=True,
                        env=dict(os.environ, TMPDIR=str(alias)))
                    self.assertEqual(result.returncode == 0, accepted, result.stderr)
                    self.assertEqual(witness.read_text().splitlines(),
                                     ['missing', 'broken'] if accepted else ['missing'])
                    self.assertEqual(engine.read_bytes(), original)
                    self.assertFalse(engine.with_name(engine.name + '.load-check-original').exists())
                    if not accepted:
                        self.assertIn('attempted path absent', result.stderr)

    def test_noexec_go_consumer_receives_staged_schema(self):
        with tempfile.TemporaryDirectory() as directory:
            scratch = Path(directory)
            candidate = scratch / 'candidate'
            (candidate / 'go').mkdir(parents=True)
            with tarfile.open(candidate / 'go/module.tar.gz', 'w:gz'):
                pass
            (candidate / 'java').mkdir()
            (candidate / 'checks/jvm').mkdir(parents=True)
            (candidate / 'checks/jvm/consumer.jar').touch()

            def run(arguments, **options):
                if arguments[0] != 'docker':
                    (Path(arguments[2]) / 'library/target/generated-sources/contracts').mkdir(parents=True)
                    return
                work = Path(next(value[:-6] for value in arguments if str(value).endswith(':/work')))
                self.assertEqual((work / 'schemas/row.schema.json').read_bytes(), (ROOT / 'schemas/row.schema.json').read_bytes())
                consumer = work / 'go-consumer'
                consumer.write_text('#!/bin/sh\ntest -f "$THINKTHEN_STUB_CASES"\ntest -f "$THINKTHEN_CASES/../schemas/row.schema.json"\n')
                consumer.chmod(0o755)
                command = next(line for line in arguments[-1].splitlines() if line.startswith('go_case()'))
                subprocess.check_call(['sh', '-eu', '-c', command.replace('/work', str(work)) + '\ngo_case'])

            with patch.object(sys, 'argv', ['loader-noexec-check', str(candidate), str(scratch)]), patch('subprocess.run', side_effect=run):
                runpy.run_path(str(ROOT / 'scripts/loader-noexec-check'), run_name='__main__')

    def test_installed_go_consumers_share_timeout_and_stream_output(self):
        import release_windows_sdks as sdks
        calls = []
        cached = []
        def cache(command, *arguments):
            cached.append(command)
        with tempfile.TemporaryDirectory() as directory:
            folder = Path(directory)
            (folder / 'checks/go').mkdir(parents=True)
            (folder / 'checks/stub.json').write_text('[]')
            (folder / 'checks/node.mjs').touch()
            with patch.object(sdks, 'os', SimpleNamespace(name='nt', environ=os.environ)), patch.object(sdks, 'environment', return_value={'PATH': os.environ['PATH']}), patch.object(sdks, 'runtime_environment', return_value={}), patch.object(sdks, 'unpack'), patch.object(sdks, 'run', side_effect=lambda *args, **options: calls.append((args, options))), patch('release_windows_cache.check_cache', cache):
                with self.assertRaisesRegex(RuntimeError, 'Windows installed SDK checks failed:'):
                    sdks.full(folder, {'packages': {name: name for name in ('python', 'typescript', 'go')}}, caller_owned=True)

        direct, options = next((args, options) for args, options in calls if str(args[0]).endswith('consumer.exe'))
        self.assertTrue(options['stream_output'])
        self.assertIn('-test.timeout=10m', direct)
        self.assertEqual(list(direct), cached[0])

    def test_child_output_is_forwarded_before_child_exit_and_final_bytes_are_drained(self):
        from windows_caller_process import stream
        with tempfile.TemporaryDirectory() as directory:
            log = Path(directory) / 'child.log'
            output = SimpleNamespace(buffer=io.BytesIO())
            consumer = 'import os,sys; sys.path.insert(0,sys.argv[1]); from release_windows_sdks import run\ntry: run(*sys.argv[2:],cwd=os.getcwd(),env=os.environ,stream_output=True)\nexcept RuntimeError as error: assert "Go finished" in str(error) and "exited 7" in str(error)\nelse: raise AssertionError("nonzero child accepted")'
            command = [sys.executable, str(ROOT / 'scripts/windows_caller_process.py'), '--child', str(log), '10',
                       sys.executable, '-u', '-c', consumer, str(ROOT / 'scripts'),
                       sys.executable, '-u', '-c', 'import sys; print("Go started", flush=True); input(); print("Go finished", file=sys.stderr, flush=True); sys.exit(7)']
            child = subprocess.Popen(command, stdin=subprocess.PIPE, text=True)
            signalled = False
            def wait():
                nonlocal signalled
                if output.buffer.getvalue().replace(b'\r\n', b'\n') == b'Go started\n' and not signalled:
                    self.assertIsNone(child.poll(), 'child exited before its output was forwarded')
                    child.stdin.write('continue\n')
                    child.stdin.flush()
                    signalled = True
                try:
                    child.wait(timeout=0.1)
                    return 0
                except subprocess.TimeoutExpired:
                    return 0x102
            try:
                with patch('sys.stdout', output):
                    stream(log, wait)
            finally:
                if child.poll() is None:
                    child.kill()
                child.wait()
                child.stdin.close()
            self.assertTrue(signalled, 'child output was buffered until exit')
            self.assertEqual(output.buffer.getvalue().replace(b'\r\n', b'\n'), b'Go started\nGo finished\n')

    def test_host_preparation_installs_manifest_pins_and_gate_accepts_prepared_state(self):
        module = runpy.run_path(str(ROOT / 'scripts/rust-advisories'))
        action = module['main']
        import tomllib
        pins = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['metadata']['supply-chain']
        for override in (False, True):
            with self.subTest(override=override), tempfile.TemporaryDirectory() as directory:
                home = Path(directory) / 'home'
                root = Path(directory) / 'explicit' if override else home / '.local/share/thinkthen-build-tools/advisory-dbs' / pins['advisory-revision']
                database = root / 'advisory-db-fixture'
                (database / '.git').mkdir(parents=True)
                commands = []
                state = {}
                def run(command, **options):
                    commands.append(command)
                    if command[:2] == ['cargo', 'deny']:
                        self.assertEqual(options['env']['THINKTHEN_ADVISORY_DB_ROOT'], str(root))
                    if command[0] == 'git':
                        self.assertEqual(options['cwd'], database)
                    if command[:2] == ['cargo', 'install']:
                        state['version'] = command[command.index('--version') + 1]
                    if command[:2] == ['git', 'checkout']:
                        state['revision'] = command[-1]
                    return subprocess.CompletedProcess(command, 0, stdout='')
                def output(*command, **options):
                    if command == ('cargo', 'deny', '--version'):
                        return 'cargo-deny ' + state['version']
                    self.assertEqual(options['cwd'], database)
                    if command[1] == 'remote':
                        return 'https://github.com/RustSec/advisory-db'
                    if command[1] == 'rev-parse':
                        return state['revision']
                    return ''
                environment = dict(os.environ, CARGO_HOME=str(Path(directory) / 'unrelated-cargo'))
                environment.pop('THINKTHEN_ADVISORY_DB_ROOT', None)
                environment.pop('THINKTHEN_FLOOR_BUILD', None)
                if override: environment['THINKTHEN_ADVISORY_DB_ROOT'] = str(root)
                selected = lambda name: '/prepared/' + name if 'version' in state else None
                with patch.dict(os.environ, environment, clear=True), patch.object(Path, 'home', return_value=home), patch.dict(action.__globals__, output=output), patch('subprocess.run', run), patch('shutil.which', selected):
                    with patch.object(sys, 'argv', ['rust-advisories', '--prepare']):
                        action()
                        action()  # A copied, pinned executable needs no install metadata.
                    with patch.object(sys, 'argv', ['rust-advisories']):
                        action()
                self.assertEqual(state, {'version': pins['cargo-deny'], 'revision': pins['advisory-revision']})
                self.assertIn(['cargo', 'deny', 'fetch'], commands)
                self.assertEqual(sum(command[:2] == ['cargo', 'install'] for command in commands), 1)
                self.assertIn('--offline', commands[-1])
        self.assertIn('scripts/rust-advisories --prepare', (ROOT / 'scripts/qualification-gate-prepare').read_text())

    @patch.dict(os.environ, {'THINKTHEN_FLOOR_BUILD': '0'})
    def test_pinned_scanner_preparation_reuses_existing_binary_and_refuses_wrong_versions(self):
        import tomllib
        pins = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['metadata']['supply-chain']
        action = runpy.run_path(str(ROOT / 'scripts/rust-dependencies'))['main']
        state, installs = {}, []
        def install(command, **options):
            installs.append(command)
            state['version'] = command[command.index('--version') + 1]
        selected = lambda name: '/prepared/' + name if state else None
        with patch('subprocess.run', install), patch('subprocess.check_output', side_effect=lambda *a, **kw: state['version']), patch('shutil.which', selected), patch.object(sys, 'argv', ['rust-dependencies', '--prepare']):
            action()
            action()
        self.assertEqual(state['version'], pins['cargo-machete'])
        self.assertEqual(len(installs), 1)
        for name in ('rust-advisories', 'rust-dependencies'):
            with self.subTest(tool=name):
                action = runpy.run_path(str(ROOT / 'scripts' / name))['main']
                with patch('shutil.which', return_value='/prepared/wrong-version'), patch('subprocess.check_output', return_value='wrong version'), patch('subprocess.run', side_effect=AssertionError('must not overwrite or fetch with a wrong tool')), patch.object(sys, 'argv', [name, '--prepare']):
                    with self.assertRaisesRegex(SystemExit, 'found wrong version'):
                        action()

    def test_windows_preparation_modules_import_without_unix_locking(self):
        subprocess.run([sys.executable, '-c', 'import sys; sys.path.insert(0,"scripts"); sys.modules["fcntl"]=None; import release_workflow_prepare, header_contract'], cwd=ROOT, check=True)

    def test_windows_header_check_retains_lock_and_offline_generator(self):
        module = runpy.run_path(str(ROOT / 'scripts/header_contract.py'))
        check = module['check']
        calls = []
        def output(arguments, **options):
            if arguments[0] == 'rustc': return 'rustc pinned\nhost: x86_64-pc-windows-msvc\n'
            return ' M source' if 'status' in arguments else 'a' * 40
        locking = SimpleNamespace(LK_LOCK=1, locking=lambda *args: calls.append(args))
        with tempfile.TemporaryDirectory() as directory:
            home = Path(directory)
            environment = {}
            targets = []
            with patch.dict(check.__globals__, os=SimpleNamespace(name='nt', environ=environment, fsencode=os.fsencode)), patch.dict(sys.modules, fcntl=None, msvcrt=locking), patch.object(Path, 'home', return_value=home), patch('subprocess.check_output', output), patch('subprocess.run') as run:
                for root in (home / 'first', home / 'second'):
                    for floor in ('0', '1'):
                        environment['THINKTHEN_FLOOR_BUILD'] = floor
                        check(root)
                        target = Path(run.call_args.kwargs['env']['CARGO_TARGET_DIR'])
                        targets.append(target)
                        self.assertIn('--offline', run.call_args.args[0])
                        self.assertIn('--locked', run.call_args.args[0])
                        self.assertIn('x86_64-pc-windows-msvc', run.call_args.args[0])
                        # Reuse the generator without sharing one root or floor's binary.
                        check(root)
                        self.assertEqual(target, Path(run.call_args.kwargs['env']['CARGO_TARGET_DIR']))
                        hosted = PureWindowsPath('C:/Users/runneradmin') / target.relative_to(home)
                        object_file = hosted / 'x86_64-pc-windows-msvc/debug/build/ring-ccf3a60b43fa418a/out/73090ba2100ad232-curve25519.o'
                        self.assertLess(len(str(object_file)), 260)
                self.assertEqual(len(set(targets)), 4)
                self.assertEqual(run.call_count, 8)
                self.assertFalse(list(home.rglob('*.passed')))
                self.assertEqual(calls[0][1:], (locking.LK_LOCK, 1))

    def test_jvm_selection_overrides_hosted_default_for_each_prepared_platform(self):
        for system, java in [('Linux x86_64', 'jdk-22.0.2+9'), ('Darwin arm64', 'jdk-22.0.2+9/Contents/Home')]:
            with self.subTest(system=system), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                binary = root / 'bin'
                binary.mkdir()
                (binary / 'uname').write_text('#!/bin/sh\nprintf "%s\\n" "' + system + '"\n')
                (binary / 'uname').chmod(0o755)
                environment = dict(os.environ, PATH=str(binary) + os.pathsep + os.environ['PATH'], JAVA_HOME='/runner/default-jdk', THINKTHEN_JVM_CACHE=str(root / 'jvm'))
                result = subprocess.check_output(['sh', '-eu', '-c', '. "$1"; printf "%s\\n" "$JAVA_HOME" "$PATH"', 'check', ROOT / 'scripts/jvm-env'], env=environment, text=True).splitlines()
                self.assertEqual(result[0], str(root / 'jvm' / java))
                self.assertTrue(result[1].startswith(result[0] + '/bin:'))

    def test_gate_preparation_reuses_the_full_preparation_sdk_tools(self):
        module = runpy.run_path(str(ROOT / 'scripts/release_workflow_prepare.py'))
        action = module['sdk_tools']
        with tempfile.TemporaryDirectory() as directory:
            tools = Path(directory)
            version = __import__('re').search(r'minimum_zig_version = "([^"]+)"', (ROOT / 'sdk/zig/build.zig.zon').read_text())[1]
            compiler = tools / 'zig' / version / 'zig'
            compiler.parent.mkdir(parents=True)
            compiler.write_text('#!/bin/sh\nprintf "%s\\n" "' + version + '"\n')
            compiler.chmod(0o755)
            with patch.dict(action.__globals__, TOOLS=tools, current=lambda: {'ruby': 'x86_64-linux'}), patch.dict(action.__globals__, fetch=lambda url, path: path) as state:
                fetched = []
                state['fetch'] = lambda url, path: fetched.append((url, path))
                action()
                self.assertEqual(fetched[0][1], tools / 'ruby/packages/ffi-1.17.4-x86_64-linux-gnu.gem')
        self.assertIn('sdk_tools()', (ROOT / 'scripts/qualification-gate-prepare').read_text())

    def test_linux_go_gate_uses_preparation_home_and_manifest_version(self):
        module = runpy.run_path(str(ROOT / 'scripts/release_go.py'))
        with tempfile.TemporaryDirectory() as directory, patch.dict(module['home'].__globals__, TOOLS=Path(directory), sys=SimpleNamespace(platform='linux')):
            selected = module['home']()
            self.assertEqual(selected, Path(directory) / 'gate-go' / ('go' + module['version']()))
        source = (ROOT / 'scripts/go-api-check').read_text()
        self.assertIn('from release_go import home; print(home())', source)
        self.assertIn('from release_go import version; print(version())', source)


if __name__ == '__main__':
    unittest.main()
