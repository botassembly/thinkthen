#!/usr/bin/env python3
"""Exercise qualification preparation boundaries without native builds or downloads."""
import ast
from contextlib import redirect_stdout
import io
import os
from pathlib import Path, PureWindowsPath
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
import textwrap
from types import SimpleNamespace
import unittest
import zipfile
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))


class QualificationRecipes(unittest.TestCase):
    def test_installed_cli_forwards_the_existing_uploaded_diagnostic_directory(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            package = root / 'candidate/0.2.0/windows-x86_64'
            package.mkdir(parents=True)
            with zipfile.ZipFile(package / 'thinkthen-0.2.0-windows-x86_64.zip', 'w') as archive:
                archive.writestr('thinkthen.exe', b'fixture')
            calls = []
            workflow = SimpleNamespace(ROOT=root, version=lambda: '0.2.0', validate=lambda *args: None,
                                       run=lambda *args: calls.append(args))
            with patch.dict(sys.modules, release_workflow=workflow), patch.object(sys, 'argv',
                    ['release-installer-check', 'windows-x86_64', str(root / 'candidate'), 'fixture-sha', '--cli']):
                runpy.run_path(str(ROOT / 'scripts/release-installer-check'))
            self.assertEqual(len(calls), 1)
            command = calls[0]
            self.assertEqual(command[:3], (sys.executable, root / 'scripts/windows-cli-check', '--binary'))
            self.assertEqual(command[4:], ('--diagnostics', root / 'target/windows-cli-diagnostics'))

    def test_windows_universe_uses_binary_repository_for_both_clean_installs(self):
        action = runpy.run_path(str(ROOT / 'scripts/release_windows_r.py'))['universe']
        with tempfile.TemporaryDirectory(prefix='windows-r-repository-') as directory:
            root = Path(directory)
            tools = root / 'tools'
            (tools / 'windows').mkdir(parents=True)
            selected = {'R-4.6.1-win.exe': ('fixture', 'fixture')}
            for name in ('jsonlite', 'vctrs', 'rlang', 'cli', 'tibble', 'withr'):
                archive = name + '_1.0.zip'
                selected[archive] = ('fixture', 'fixture')
                (tools / 'windows' / archive).write_bytes(b'pinned binary fixture')
            destination = root / 'rehearsal'
            contrib = destination / 'repository/bin/windows/contrib/4.6'
            installs = []
            def invoke(*arguments, **options):
                if len(arguments) > 3 and arguments[2] == '-e':
                    expression = arguments[3]
                    if expression.startswith('tools::write_PACKAGES'):
                        self.assertIn('type="win.binary"', expression)
                        (Path(arguments[4]) / 'PACKAGES').write_text('binary index fixture')
                    elif 'install.packages(' in expression:
                        library, repository, *names = arguments[4:]
                        self.assertEqual(repository, (destination / 'repository').as_uri())
                        self.assertTrue((contrib / 'PACKAGES').is_file())
                        self.assertFalse((destination / 'repository/src/contrib').exists())
                        self.assertEqual(list(Path(library).iterdir()), [])
                        if 'type="win.binary"' not in expression:
                            raise FileNotFoundError(destination / 'repository/src/contrib/PACKAGES')
                        for name in names:
                            self.assertTrue(list(contrib.glob(name + '_*.zip')), name)
                        installs.append((Path(library).name, names))
                        (Path(library) / 'installed').write_text('binary packages')
                elif Path(arguments[0]).name == 'R.exe':
                    (Path(options['cwd']) / 'thinkthen_0.2.0.zip').write_bytes(b'built binary fixture')
                return subprocess.CompletedProcess(arguments, 0)
            with patch.dict(action.__globals__, TOOLS=tools, inputs=lambda: selected, run=invoke,
                            fetch=lambda url, path, digest: path,
                            environment=lambda r: dict(PATH='', RUSTFLAGS='static'),
                            os=SimpleNamespace(name='nt', pathsep=os.pathsep)), patch('release_rust.prepare'):
                action(destination)
            self.assertEqual([name for name, _ in installs], ['build-library', 'library'])
            self.assertEqual(installs[0][1], ['jsonlite', 'vctrs', 'rlang', 'cli', 'tibble', 'withr'])
            self.assertEqual(installs[1][1], ['thinkthen'])

    def test_cold_windows_gnu_preparation_resolves_pinned_archives_before_install(self):
        import tomllib
        from release_downloads import sources
        prepare = runpy.run_path(str(ROOT / 'scripts/release_rust.py'))['prepare']
        config = tomllib.loads((ROOT / 'rust-toolchain.toml').read_text())['toolchain']
        channel, host, target = config['channel'], 'x86_64-pc-windows-msvc', 'x86_64-pc-windows-gnu'
        prefix = 'https://static.rust-lang.org/dist/2026-04-16/'
        packages = ('cargo', 'rustc', 'rust-std', 'clippy-preview', 'rustfmt-preview', 'llvm-tools-preview')
        manifest = ''.join('[pkg.' + name + '.target.' + selected + ']\nxz_url="' + prefix
                           + name.removesuffix('-preview') + '-' + channel + '-' + selected + '.tar.xz"\n'
                           for name in packages for selected in ([host, target] if name == 'rust-std' else [host]))
        requested, calls = {}, []
        with tempfile.TemporaryDirectory(prefix='cold-windows-gnu-') as directory:
            root = Path(directory)
            shutil.copy2(ROOT / 'rust-toolchain.toml', root / 'rust-toolchain.toml')
            def fetch(url, path):
                # Keep the real pin-selection boundary; replace only archive transport.
                requested[url] = sources(url)[0]
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(manifest.encode() if url.endswith('.toml') else b'fixture archive transport')
                return path
            def execute(*arguments, **options):
                calls.append(arguments)
                if arguments[1:3] == ('toolchain', 'list'):
                    return subprocess.CompletedProcess(arguments, 0, stdout='')
                if arguments[1:3] == ('toolchain', 'install'):
                    self.assertEqual(arguments[-2:], ('--target', target))
                    mirror = root / 'tools/rust-dist/dist/2026-04-16'
                    self.assertEqual(len(list(mirror.glob('*.xz'))), 7)
                    return subprocess.CompletedProcess(arguments, 0)
                self.assertEqual(arguments[1:3], ('component', 'list'))
                components = ['cargo-' + host, 'rustc-' + host, 'rust-std-' + host]
                components += [name.removesuffix('-preview') + '-' + host for name in config['components']]
                return subprocess.CompletedProcess(arguments, 0, stdout='\n'.join([*components, 'rust-std-' + target]))
            with patch.dict(prepare.__globals__, ROOT=root, TOOLS=root / 'tools', fetch=fetch, run=execute,
                            platform=SimpleNamespace(system=lambda: 'Windows')):
                prepare(target)
            archive = prefix + 'rust-std-' + channel + '-' + target + '.tar.xz'
            self.assertEqual(requested[archive], 'sha256:f57e045016a04130125fb43295d95f9ad2bebc296150eadb031dbf5167ad12bd')
            self.assertEqual(sum(args[1:3] == ('toolchain', 'install') for args in calls), 1)

    def test_rust_preparation_repairs_only_the_unhealthy_pin_and_keeps_query_errors(self):
        import json
        import tomllib
        config = tomllib.loads((ROOT / 'rust-toolchain.toml').read_text())['toolchain']
        channel, host, target = config['channel'], 'aarch64-unknown-linux-gnu', 'wasm32-unknown-unknown'
        components = [name + '-' + host for name in ('cargo', 'rustc', 'rust-std', 'clippy', 'rustfmt', 'llvm-tools')]
        components.append('rust-std-' + target)
        for scenario in ('healthy', 'absent', 'missing-clippy', 'query-error', 'stale-proxy',
                         'persistent-query-error', 'incomplete-install', 'install-error'):
            with self.subTest(scenario=scenario), tempfile.TemporaryDirectory(prefix='rust-preparation-') as directory:
                scratch = Path(directory)
                source, bin_dir = scratch / 'source', scratch / 'bin'
                (source / 'scripts').mkdir(parents=True)
                shutil.copy2(ROOT / 'rust-toolchain.toml', source / 'rust-toolchain.toml')
                (source / 'scripts/native-tools-env').write_text('# isolated prepared tools\n')
                bin_dir.mkdir()
                selected = scratch / 'toolchains' / (channel + '-' + host)
                other = scratch / 'toolchains/other/bin/cargo-clippy'
                other.parent.mkdir(parents=True)
                other.write_text('unrelated toolchain')
                if scenario != 'absent':
                    (selected / 'bin').mkdir(parents=True)
                    installed = components if scenario == 'healthy' else [name for name in components if not name.startswith('clippy-')]
                    (selected / 'components').write_text('\n'.join(installed))
                    if scenario == 'stale-proxy':
                        (selected / 'bin/cargo-clippy').write_text('conflicting partial file')
                rustup = bin_dir / 'rustup'
                rustup.write_text('#!' + sys.executable + '\n' + textwrap.dedent('''
                    import json, os, shutil, sys
                    from pathlib import Path
                    root = Path(os.environ['RUST_FIXTURE'])
                    args = sys.argv[1:]
                    channel, host, target = json.loads(os.environ['RUST_SELECTION'])
                    selected = root / 'toolchains' / (channel + '-' + host)
                    scenario = os.environ['RUST_SCENARIO']
                    with (root / 'calls').open('a') as log: log.write(json.dumps(args) + '\\n')
                    if args == ['toolchain', 'list']:
                        print(selected.name + '-other')
                        if selected.exists(): print(selected.name)
                    elif args == ['component', 'list', '--installed', '--toolchain', channel]:
                        if scenario == 'persistent-query-error' or (scenario == 'query-error' and not (root / 'installed').exists()):
                            print('x' * 20000, file=sys.stderr)
                            print('rustup: component metadata unreadable', file=sys.stderr)
                            sys.exit(17)
                        print((selected / 'components').read_text())
                    elif args == ['toolchain', 'uninstall', channel]:
                        shutil.rmtree(selected)
                    elif args[:3] == ['toolchain', 'install', channel]:
                        assert args[3:6] == ['--profile', 'minimal', '--no-self-update']
                        assert args[-2:] == ['--target', target]
                        assert args[6:-2] == ['--component', 'clippy', '--component', 'rustfmt', '--component', 'llvm-tools-preview']
                        mirror = Path(os.environ['RUSTUP_DIST_SERVER'].removeprefix('file://'))
                        assert (mirror / ('dist/channel-rust-' + channel + '.toml.sha256')).is_file()
                        assert len(list((mirror / 'dist').glob('*.xz'))) == 7
                        if scenario == 'install-error':
                            print('rustup: pinned archive installation failed', file=sys.stderr)
                            sys.exit(29)
                        if (selected / 'bin/cargo-clippy').exists():
                            print('rustup: conflicting bin/cargo-clippy', file=sys.stderr)
                            sys.exit(23)
                        selected.mkdir(parents=True, exist_ok=True)
                        components = json.loads(os.environ['RUST_COMPONENTS'])
                        if scenario == 'incomplete-install': components.remove('clippy-' + host)
                        (selected / 'components').write_text('\\n'.join(components))
                        (root / 'installed').touch()
                    else:
                        raise AssertionError(args)
                '''))
                rustup.chmod(0o755)
                entry = '''
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
import release_rust as rust
import release_prepare_common as common
root = Path(sys.argv[2])
rust.ROOT = common.ROOT = root / 'source'
rust.TOOLS = root / 'tools'
rust.current = lambda: {'rust': 'aarch64-unknown-linux-gnu'}
def fetch(url, path):
    path.parent.mkdir(parents=True, exist_ok=True)
    if url.endswith('.toml'):
        packages = ('cargo', 'rustc', 'rust-std', 'clippy-preview', 'rustfmt-preview', 'llvm-tools-preview')
        path.write_text(''.join('[pkg.' + name + '.target.' + target + ']\\nxz_url="https://static.rust-lang.org/dist/' + name + '-' + target + '.xz"\\n'
                               for name in packages for target in (['aarch64-unknown-linux-gnu', 'wasm32-unknown-unknown'] if name == 'rust-std' else ['aarch64-unknown-linux-gnu'])))
    else: path.write_bytes(b'controlled pinned archive boundary')
    return path
rust.fetch = fetch
rust.prepare('wasm32-unknown-unknown')
'''
                env = dict(os.environ, PATH=str(bin_dir) + os.pathsep + os.environ['PATH'],
                           RUST_FIXTURE=str(scratch), RUST_SELECTION=json.dumps([channel, host, target]),
                           RUST_COMPONENTS=json.dumps(components), RUST_SCENARIO=scenario)
                result = subprocess.run([sys.executable, '-c', entry, str(ROOT / 'scripts'), str(scratch)],
                                        env=env, capture_output=True, text=True)
                calls = [json.loads(line) for line in (scratch / 'calls').read_text().splitlines()]
                self.assertEqual(other.read_text(), 'unrelated toolchain')
                if scenario in ('query-error', 'persistent-query-error'):
                    self.assertIn('rustup: component metadata unreadable', result.stderr)
                    self.assertIn('17', result.stderr)
                    self.assertNotIn('x' * 17000, result.stderr)
                if scenario in ('persistent-query-error', 'incomplete-install', 'install-error'):
                    self.assertNotEqual(result.returncode, 0)
                    if scenario == 'incomplete-install': self.assertIn('clippy-' + host, result.stderr)
                    if scenario == 'install-error': self.assertIn('rustup: pinned archive installation failed', result.stderr)
                else:
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual((selected / 'components').read_text().splitlines(), components)
                installs = [call for call in calls if call[:2] == ['toolchain', 'install']]
                removals = [call for call in calls if call[:2] == ['toolchain', 'uninstall']]
                self.assertEqual(len(installs), 0 if scenario == 'healthy' else 1)
                self.assertEqual(removals, [] if scenario in ('healthy', 'absent') else [['toolchain', 'uninstall', channel]])
                self.assertEqual(sum(call[:2] == ['component', 'list'] for call in calls),
                                 1 if scenario in ('healthy', 'absent', 'install-error') else 2)

    def test_native_clean_guard_ignores_only_prepared_artifacts_without_global_policy(self):
        entry = runpy.run_path(str(ROOT / 'scripts/native-prepare'))
        def compiler_boundary(_):
            raise RuntimeError('clean source reached compiler boundary')
        with tempfile.TemporaryDirectory(prefix='native-source-policy-') as temporary:
            source = Path(temporary)
            (source / '.gitignore').write_bytes((ROOT / '.gitignore').read_bytes())
            (source / 'tracked.py').write_text('original\n')
            env = dict(os.environ, GIT_CONFIG_GLOBAL=os.devnull, PM_JOB='fixture receipt',
                       GIT_AUTHOR_NAME='Example', GIT_AUTHOR_EMAIL='example@example.com',
                       GIT_COMMITTER_NAME='Example', GIT_COMMITTER_EMAIL='example@example.com')
            for command in (['init', '--quiet'], ['add', '.'], ['commit', '--quiet', '-m', 'Source']):
                subprocess.run(['git', *command], cwd=source, env=env, check=True)
            for path in ('scripts/__pycache__/old.cpython-312.pyc', 'sdk/python/__pycache__/old.cpython-313.pyc',
                         'sdk/typescript/node_modules/prepared-package/index.js',
                         'sdk/typescript/node_modules/.package-lock.json'):
                cached = source / path
                cached.parent.mkdir(parents=True, exist_ok=True)
                cached.write_bytes(b'historical bytecode')
            with patch.dict(os.environ, env, clear=True), patch.dict(entry['main'].__globals__, ROOT=source), patch.dict(sys.modules, header_contract=SimpleNamespace(check=compiler_boundary)), patch.object(sys, 'argv', ['native-prepare', '--receipt', str(source / 'receipt.json')]):
                with self.assertRaisesRegex(RuntimeError, 'clean source reached compiler boundary'):
                    entry['main']()
                for path in ('tracked.py', 'scripts/__pycache__/unrecorded.py', 'package/unrecorded.py',
                             'sdk/typescript/unrecorded.js', 'sdk/other/node_modules/unrecorded.js'):
                    dirty = source / path
                    dirty.parent.mkdir(parents=True, exist_ok=True)
                    dirty.write_text('unrecorded source\n')
                    with self.assertRaisesRegex(SystemExit, 'clean committed checkout'):
                        entry['main']()
                    if path == 'tracked.py': dirty.write_text('original\n')
                    else: dirty.unlink()

    def test_go_and_zig_select_prepared_manifest_compiler_before_home_isolation(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / 'scripts').mkdir()
            (root / 'prepared-fixtures').mkdir()
            (root / 'sdk/zig').mkdir(parents=True)
            shutil.copy2(ROOT / 'sdk/zig/build.zig.zon', root / 'sdk/zig/build.zig.zon')
            (root / 'scripts/native-tools-env').touch()
            if (ROOT / 'scripts/zig-env').exists():
                shutil.copy2(ROOT / 'scripts/zig-env', root / 'scripts/zig-env')
            import re
            version = re.search(r'minimum_zig_version = "([^"]+)"', (root / 'sdk/zig/build.zig.zon').read_text())[1]
            home = root / 'prepared'
            compiler = home / '.local/share/thinkthen-build-tools/zig' / version / 'zig'
            compiler.parent.mkdir(parents=True)
            compiler.write_text('#!/bin/sh\nprintf "%s\\n" ' + version + '\n')
            compiler.chmod(0o755)
            for name, end in [('go-api-check', 'root=$PWD'), ('zig-sdk-gate', 'scratch=')]:
                text = (ROOT / 'scripts' / name).read_text()
                prefix = text[:text.index(end)].split('cd "$(dirname "$0")/.."', 1)[1]
                result = subprocess.check_output(['sh', '-eu', '-c', prefix + '\nHOME="$1"; export HOME; command -v zig; zig version', 'check', str(root / 'isolated')], cwd=root, env=dict(os.environ, HOME=str(home), THINKTHEN_NATIVE_FIXTURES=str(root / 'prepared-fixtures')), text=True)
                self.assertEqual(result.splitlines(), [str(compiler), version])

    def test_windows_jvm_stages_generated_contracts_before_maven(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['jvm']
        class ReachedMaven(Exception):
            pass
        def build(*arguments, **options):
            if arguments[0] == 'mvn':
                base = Path(options['cwd']) / 'source/sdk/java/library/target/generated-sources/contracts/dev/thinkthen'
                self.assertTrue((base / 'ErrorCode.java').is_file())
                for name in ('DriverCode', 'NativeLayouts', 'NativeSignatures'):
                    self.assertTrue((base / 'internal' / (name + '.java')).is_file(), name)
                self.assertTrue((base.parents[6] / 'kotlin/target/generated-sources/contracts/dev/thinkthen/kotlin/ErrorCode.kt').is_file())
                self.assertTrue((base.parents[6] / 'java/consumer/kotlin-tests/ConformanceCases.kt').is_file())
                raise ReachedMaven()
            subprocess.run(list(map(str, arguments)), **options, check=True)
        with tempfile.TemporaryDirectory() as directory, patch.dict(action.__globals__, build=build):
            scratch = Path(directory)
            native = scratch / 'engine.dll'
            native.write_bytes(b'native fixture')
            with self.assertRaises(ReachedMaven):
                action(scratch, native, {'PATH': os.environ['PATH']}, {})

    def test_csharp_uses_caller_owned_launcher_before_cache_creation(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['main']
        with tempfile.TemporaryDirectory() as directory:
            with patch.dict(action.__globals__, os=SimpleNamespace(name='nt', environ=os.environ)), patch.object(sys, 'argv', ['windows-native-proof', 'csharp', directory]), patch('windows_caller_process.launch') as launch:
                action()
            self.assertEqual(launch.call_args.args[0][-3:], ['--caller-owned', 'csharp', directory])

    def test_elevated_runs_consumers_from_the_parent_after_the_caller_owned_build(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['main']
        calls = []
        with tempfile.TemporaryDirectory() as directory:
            def built(command, **_options):
                calls.append(command[-3:])
                (Path(directory) / 'elevated').mkdir()
                (Path(directory) / 'elevated/consumers.json').write_text('[{"root": "cache"}]')
            with patch.dict(action.__globals__, os=SimpleNamespace(name='nt', environ=os.environ),
                            normal_probe=lambda scratch: calls.append(scratch.name),
                            check_elevated=calls.append), \
                    patch.object(sys, 'argv', ['windows-native-proof', 'elevated', directory]), \
                    patch('windows_caller_process.launch', built):
                action()
        self.assertEqual(calls, ['elevated', ['--caller-owned', 'elevated', directory], [{'root': 'cache'}]])

    def test_direct_go_executable_has_bounded_test_timeout(self):
        module = runpy.run_path(str(ROOT / 'scripts/windows-native-proof'))
        action = module['go']
        captured = []
        def cache(command, root, environment, filename):
            self.assertEqual(Path(environment['THINKTHEN_CASES']) / '../schemas/row.schema.json', ROOT / 'conformance/../schemas/row.schema.json')
            captured.append(command)
        temporary_cache = []
        load_failure = []
        with tempfile.TemporaryDirectory() as directory, patch.dict(action.__globals__, build=lambda *args, **options: None, check_cache=cache,
                                                                    go_temporary_cache=lambda execute, binary: temporary_cache.append(binary),
                                                                    go_load_failure=lambda execute, binary: load_failure.append(binary)):
            scratch = Path(directory)
            native = scratch / 'engine.dll'
            native.write_bytes(b'native fixture')
            action(scratch, native, {'PATH': ''}, {})
        self.assertIn('-test.timeout=30m', captured[0])
        self.assertEqual(temporary_cache, [captured[0][0]])
        self.assertEqual(load_failure, [captured[0][0]])

    def test_source_and_registry_go_launchers_expose_canonical_fixtures(self):
        source = (ROOT / 'scripts/source-install-check').read_text()
        source = textwrap.dedent(source[source.index('            go_env ='):source.index('            if args.readmes:')])
        with tempfile.TemporaryDirectory() as directory:
            for platform, recipe in [('linux', source), ('darwin', source)]:
                with self.subTest(platform=platform, recipe='source'):
                    calls = []
                    scope = dict(ROOT=ROOT, scratch=Path(directory), go=Path(directory), consumer=Path(directory),
                                 args=SimpleNamespace(tag_source=False),
                                 env={'THINKTHEN_BACKEND': 'stub', 'HOME': directory, 'GOSUMDB': 'off', 'GOTOOLCHAIN': 'local',
                                      'GOWORK': 'off', 'CGO_ENABLED': '1'}, os=os,
                                 sys=SimpleNamespace(platform=platform, executable=sys.executable),
                                 go_command=('go',), run=lambda *args, **options: calls.append((args, options)))
                    exec(compile(recipe, 'installed-go-recipe', 'exec'), scope)
                    arguments, options = calls[0]
                    environment = dict(value.split('=', 1) for value in arguments[2:] if isinstance(value, str) and '=' in value) if 'runtime-floor-build' in str(arguments[0]) else options['env']
                    self.assertEqual(Path(environment['THINKTHEN_CASES']).parent / 'schemas/row.schema.json', ROOT / 'schemas/row.schema.json')
                    self.assertEqual(Path(environment['THINKTHEN_STUB_CASES']), ROOT / 'construction/stub.json')

    def test_qualification_callers_select_stub_in_the_child_environment(self):
        from release_registry_check import environment
        def recipe(name, node_type, selected):
            tree = ast.parse((ROOT / 'scripts' / name).read_text())
            node, = [node for node in ast.walk(tree) if isinstance(node, node_type) and selected(node)]
            return compile(ast.Module(body=[node], type_ignores=[]), name, 'exec')
        with tempfile.TemporaryDirectory() as directory, patch.dict(os.environ,
                THINKTHEN_BACKEND='openai', THINKTHEN_API_KEY='unused', OPENAI_API_KEY='unused'):
            scratch = Path(directory)
            for name in ('source-install-check', 'qualification-readmes'):
                scope = dict(environment=environment, scratch=scratch)
                exec(recipe(name, ast.Assign, lambda node: any(isinstance(target, ast.Name) and target.id == 'env' for target in node.targets)), scope)
                env = scope['env']
                self.assertEqual(env['THINKTHEN_BACKEND'], 'stub')
                self.assertNotIn('THINKTHEN_API_KEY', env)
                self.assertNotIn('OPENAI_API_KEY', env)
                calls = []
                if name == 'qualification-readmes':
                    for windows in (False, True):
                        scope.update(WINDOWS=windows, subprocess=SimpleNamespace(run=lambda *a, **kw: calls.append(kw['env'])))
                        with patch.dict(sys.modules, release_windows_sdks=SimpleNamespace(run=lambda *a, **kw: calls.append(kw['env']) or '')):
                            exec(recipe(name, ast.FunctionDef, lambda node: node.name == 'run'), scope)
                            scope['run']('readme', extra={'LOCAL_OPTION': 'kept'})
                        self.assertEqual(calls[-1]['THINKTHEN_BACKEND'], 'stub')
                        self.assertEqual(calls[-1]['LOCAL_OPTION'], 'kept')
                else:
                    scope.update(ROOT=ROOT, Path=Path, os=os, args=SimpleNamespace(tag_source=False),
                        sys=SimpleNamespace(platform='linux'),
                        run=lambda *a, **kw: calls.append((a, kw)))
                    exec(recipe(name, ast.Assign, lambda node: any(isinstance(target, ast.Name) and target.id == 'go_env' for target in node.targets)), scope)
                    exec(recipe(name, ast.FunctionDef, lambda node: node.name == 'go_run'), scope)
                    scope['go_run']('run', '.', cwd=scratch)
                    self.assertIn('THINKTHEN_BACKEND=stub', calls[-1][0])
                    with patch.dict(sys.modules, release_images=SimpleNamespace(image=lambda _: 'prepared-swift')), patch.dict(os.environ, PM_JOB='0508 fixture'):
                        exec(recipe(name, ast.FunctionDef, lambda node: node.name == 'swift_run'), scope)
                        scope['swift_run']('Readme')
                    args = calls[-1][0]
                    self.assertIn(('-e', 'THINKTHEN_BACKEND=stub'), list(zip(args, args[1:])))

    def test_loader_failures_keep_canonical_identity_through_a_temporary_alias(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            physical = (root / 'installed').resolve()
            physical.mkdir()
            alias = root / 'temporary'
            alias.symlink_to(physical, target_is_directory=True)
            engine = physical / 'engine.so'
            original = b'controlled installed engine'
            engine.write_bytes(original)
            witness = root / 'failures'
            probe = root / 'probe.py'
            probe.write_text('import ctypes,pathlib,sys\n'
                'engine=pathlib.Path(sys.argv[1])\n'
                'failure="broken" if engine.exists() else "missing"\n'
                'if engine.exists(): assert engine.read_bytes()==b"not a shared library\\n"\n'
                'with pathlib.Path(sys.argv[2]).open("a") as stream: stream.write(failure+"\\n")\n'
                'try: ctypes.CDLL(sys.argv[3])\n'
                'except OSError as error: print("cannot load native engine:", error); sys.exit(23)\n'
                'sys.exit(0)\n')
            for attempted, reported, accepted in (
                    (None, str(engine), True),
                    (None, str(root / 'unrelated/engine.so'), False),
                    (str(engine), str(engine), True),
                    ('@loader_path/engine.so', str(engine), False)):
                with self.subTest(attempted=attempted, reported=reported):
                    witness.unlink(missing_ok=True)
                    command = [sys.executable, str(ROOT / 'scripts/loader-failure-check'),
                               str(alias / engine.name)]
                    if attempted is not None:
                        command += ['--attempted', attempted]
                    result = subprocess.run([*command, '--', sys.executable, str(probe),
                        str(engine), str(witness), reported], capture_output=True, text=True,
                        env=dict(os.environ, TMPDIR=str(alias)))
                    self.assertEqual(result.returncode == 0, accepted, result.stderr)
                    self.assertEqual(witness.read_text().splitlines(),
                                     ['missing', 'broken'] if accepted else ['missing'])
                    self.assertEqual(engine.read_bytes(), original)
                    self.assertFalse(engine.with_name(engine.name + '.load-check-original').exists())
                    if not accepted:
                        self.assertIn('attempted path absent', result.stderr)

    def test_noexec_go_consumer_receives_staged_schema(self):
        with tempfile.TemporaryDirectory() as directory:
            scratch = Path(directory)
            candidate = scratch / 'candidate'
            (candidate / 'go').mkdir(parents=True)
            with tarfile.open(candidate / 'go/module.tar.gz', 'w:gz'):
                pass
            (candidate / 'java').mkdir()
            (candidate / 'checks/jvm').mkdir(parents=True)
            (candidate / 'checks/jvm/consumer.jar').touch()

            def run(arguments, **options):
                if arguments[0] != 'docker':
                    (Path(arguments[2]) / 'library/target/generated-sources/contracts').mkdir(parents=True)
                    return
                work = Path(next(value[:-6] for value in arguments if str(value).endswith(':/work')))
                self.assertEqual((work / 'schemas/row.schema.json').read_bytes(), (ROOT / 'schemas/row.schema.json').read_bytes())
                consumer = work / 'go-consumer'
                consumer.write_text('#!/bin/sh\ntest -f "$THINKTHEN_STUB_CASES"\ntest -f "$THINKTHEN_CASES/../schemas/row.schema.json"\n')
                consumer.chmod(0o755)
                command = next(line for line in arguments[-1].splitlines() if line.startswith('go_case()'))
                subprocess.check_call(['sh', '-eu', '-c', command.replace('/work', str(work)) + '\ngo_case'])

            with patch.object(sys, 'argv', ['loader-noexec-check', str(candidate), str(scratch)]), patch('subprocess.run', side_effect=run):
                runpy.run_path(str(ROOT / 'scripts/loader-noexec-check'), run_name='__main__')

    def test_installed_go_consumers_share_timeout_and_stream_output(self):
        import release_windows_sdks as sdks
        calls = []
        cached = []
        def cache(command, *arguments):
            cached.append(command)
        with tempfile.TemporaryDirectory() as directory:
            folder = Path(directory)
            (folder / 'checks/go').mkdir(parents=True)
            (folder / 'checks/stub.json').write_text('[]')
            (folder / 'checks/node.mjs').touch()
            with patch.object(sdks, 'os', SimpleNamespace(name='nt', environ=os.environ)), patch.object(sdks, 'environment', return_value={'PATH': os.environ['PATH']}), patch.object(sdks, 'runtime_environment', return_value={}), patch.object(sdks, 'unpack'), patch.object(sdks, 'run', side_effect=lambda *args, **options: calls.append((args, options))), patch('release_windows_cache.check_cache', cache):
                with self.assertRaisesRegex(RuntimeError, 'Windows installed SDK checks failed:'):
                    sdks.full(folder, {'packages': {name: name for name in ('python', 'typescript', 'go')}}, caller_owned=True)

        direct, options = next((args, options) for args, options in calls if str(args[0]).endswith('consumer.exe'))
        self.assertTrue(options['stream_output'])
        self.assertIn('-test.timeout=10m', direct)
        self.assertEqual(list(direct), cached[0])

    def test_normal_token_probe_reports_named_programs_and_only_refuses_an_administrator(self):
        import windows_caller_process
        with tempfile.TemporaryDirectory() as directory:
            launched = []
            def launch(command, **options):
                launched.append((Path(command[-1]).read_text(encoding='utf-8'), options))
            with patch.object(windows_caller_process, 'launch', launch):
                windows_caller_process.probe(directory, {'SYSTEMROOT': directory}, normal=Path(directory))
        (script, options), = launched
        self.assertEqual(options['env']['TT_NORMAL_PROBE'], '1')
        self.assertEqual(options['normal_log'], Path(directory) / 'child.log')
        self.assertNotIn('whoami /groups', script, 'a bare name lets PATH choose the program')
        for text in ("Start-Probe (Join-Path $system 'whoami.exe') @('/groups')",
                     "Start-Probe (Join-Path $system 'cmd.exe')",
                     "'Normal token PATH finds whoami.exe at: '",
                     "$found=@(Find-Programs 'whoami.exe')",  # One result would otherwise index as a string.
                     "'Normal token could not start ' + $program",
                     "': exit ' + $LASTEXITCODE + ': ' + ($output -join ' | ')",
                     "throw 'Normal token is an administrator'"):
            self.assertIn(text, script)
        start = script.index('function Start-Probe')
        self.assertNotIn('throw', script[start:script.index("$directory=Join-Path")],
                         'a failed start only reports; the consumer runs from Python decide')

    def normal_token_calls(self, integrity):
        import ctypes
        from windows_caller_process import normal_token
        user, label, sids, restricted, classes, aces, sizes = 0x1234, 0x5678, {}, [], [], [], []
        def string_sid(text, value):
            value._obj.value = sids.setdefault(text, 0x1000 + len(sids))
            return 1
        def token_info(_token, kind, buffer, _length, size):
            size._obj.value = 16
            if buffer is None:
                return 0
            ctypes.cast(buffer, ctypes.POINTER(ctypes.c_void_p))[0] = {1: user, 25: label}[kind]
            return 1
        def sid_text(pointer, value):
            self.assertEqual(pointer, label)
            value._obj.value = integrity
            return 1
        def restrict(_source, flags, count, disabled, *_rest):
            restricted.append((flags, count, disabled._obj.sid))
            return 1
        def acl(_acl, size, revision):
            sizes.append((size, revision))
            return 1
        functions = dict(GetCurrentProcess=lambda: 1, OpenProcessToken=lambda *_: 1, CloseHandle=lambda _: 1,
                         LocalFree=lambda _: None, ConvertStringSidToSidW=string_sid, GetTokenInformation=token_info,
                         ConvertSidToStringSidW=sid_text,
                         CreateRestrictedToken=restrict, GetLengthSid=lambda _: 12, InitializeAcl=acl,
                         AddAccessAllowedAce=lambda _acl, _revision, mask, sid: aces.append((mask, getattr(sid, 'value', sid))) or 1,
                         SetTokenInformation=lambda _token, kind, *_: classes.append(kind) or 1)
        with redirect_stdout(io.StringIO()):
            normal_token(functions)
        return sids, restricted, classes, aces, sizes, user

    def test_normal_token_keeps_administrators_deny_only_and_grants_new_objects_to_the_user(self):
        sids, restricted, classes, aces, sizes, user = self.normal_token_calls('S-1-16-8192')
        self.assertEqual(restricted, [(1, 1, sids['S-1-5-32-544'])])
        self.assertEqual(classes, [25, 6], 'medium integrity, then the default DACL')
        self.assertEqual(aces, [(0x10000000, user), (0x10000000, sids['S-1-5-18'])])
        self.assertEqual(sizes, [(8 + 2 * (8 + 12), 2)])

    def test_normal_token_refuses_any_integrity_but_medium_without_a_child_program(self):
        with self.assertRaisesRegex(RuntimeError, 'not medium integrity: S-1-16-12288'):
            self.normal_token_calls('S-1-16-12288')

    def test_child_output_is_forwarded_before_child_exit_and_final_bytes_are_drained(self):
        from windows_caller_process import stream
        with tempfile.TemporaryDirectory() as directory:
            log = Path(directory) / 'child.log'
            output = SimpleNamespace(buffer=io.BytesIO())
            consumer = 'import os,sys; sys.path.insert(0,sys.argv[1]); from release_windows_sdks import run\ntry: run(*sys.argv[2:],cwd=os.getcwd(),env=os.environ,stream_output=True)\nexcept RuntimeError as error: assert "Go finished" in str(error) and "exited 7" in str(error)\nelse: raise AssertionError("nonzero child accepted")'
            command = [sys.executable, str(ROOT / 'scripts/windows_caller_process.py'), '--child', str(log), '10',
                       sys.executable, '-u', '-c', consumer, str(ROOT / 'scripts'),
                       sys.executable, '-u', '-c', 'import sys; print("Go started", flush=True); input(); print("Go finished", file=sys.stderr, flush=True); sys.exit(7)']
            child = subprocess.Popen(command, stdin=subprocess.PIPE, text=True)
            signalled = False
            def wait():
                nonlocal signalled
                if output.buffer.getvalue().replace(b'\r\n', b'\n') == b'Go started\n' and not signalled:
                    self.assertIsNone(child.poll(), 'child exited before its output was forwarded')
                    child.stdin.write('continue\n')
                    child.stdin.flush()
                    signalled = True
                try:
                    child.wait(timeout=0.1)
                    return 0
                except subprocess.TimeoutExpired:
                    return 0x102
            try:
                with patch('sys.stdout', output):
                    stream(log, wait)
            finally:
                if child.poll() is None:
                    child.kill()
                child.wait()
                child.stdin.close()
            self.assertTrue(signalled, 'child output was buffered until exit')
            self.assertEqual(output.buffer.getvalue().replace(b'\r\n', b'\n'), b'Go started\nGo finished\n')

    def test_host_preparation_installs_manifest_pins_and_gate_accepts_prepared_state(self):
        module = runpy.run_path(str(ROOT / 'scripts/rust-advisories'))
        action = module['main']
        import tomllib
        pins = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['metadata']['supply-chain']
        for override in (False, True):
            with self.subTest(override=override), tempfile.TemporaryDirectory() as directory:
                home = Path(directory) / 'home'
                root = Path(directory) / 'explicit' if override else home / '.local/share/thinkthen-build-tools/advisory-dbs' / pins['advisory-revision']
                database = root / 'advisory-db-fixture'
                (database / '.git').mkdir(parents=True)
                commands = []
                state = {}
                def run(command, **options):
                    commands.append(command)
                    if command[:2] == ['cargo', 'deny']:
                        self.assertEqual(options['env']['THINKTHEN_ADVISORY_DB_ROOT'], str(root))
                    if command[0] == 'git':
                        self.assertEqual(options['cwd'], database)
                    if command[:2] == ['cargo', 'install']:
                        state['version'] = command[command.index('--version') + 1]
                    if command[:2] == ['git', 'checkout']:
                        state['revision'] = command[-1]
                    return subprocess.CompletedProcess(command, 0, stdout='')
                def output(*command, **options):
                    if command == ('cargo', 'deny', '--version'):
                        return 'cargo-deny ' + state['version']
                    self.assertEqual(options['cwd'], database)
                    if command[1] == 'remote':
                        return 'https://github.com/RustSec/advisory-db'
                    if command[1] == 'rev-parse':
                        return state['revision']
                    return ''
                environment = dict(os.environ, CARGO_HOME=str(Path(directory) / 'unrelated-cargo'))
                environment.pop('THINKTHEN_ADVISORY_DB_ROOT', None)
                environment.pop('THINKTHEN_FLOOR_BUILD', None)
                if override: environment['THINKTHEN_ADVISORY_DB_ROOT'] = str(root)
                selected = lambda name: '/prepared/' + name if 'version' in state else None
                with patch.dict(os.environ, environment, clear=True), patch.object(Path, 'home', return_value=home), patch.dict(action.__globals__, output=output), patch('subprocess.run', run), patch('shutil.which', selected):
                    with patch.object(sys, 'argv', ['rust-advisories', '--prepare']):
                        action()
                        action()  # A copied, pinned executable needs no install metadata.
                    with patch.object(sys, 'argv', ['rust-advisories']):
                        action()
                self.assertEqual(state, {'version': pins['cargo-deny'], 'revision': pins['advisory-revision']})
                self.assertIn(['cargo', 'deny', 'fetch'], commands)
                self.assertEqual(sum(command[:2] == ['cargo', 'install'] for command in commands), 1)
                self.assertIn('--offline', commands[-1])
        self.assertIn('scripts/rust-advisories --prepare', (ROOT / 'scripts/qualification-gate-prepare').read_text())

    @patch.dict(os.environ, {'THINKTHEN_FLOOR_BUILD': '0'})
    def test_pinned_scanner_preparation_reuses_existing_binary_and_refuses_wrong_versions(self):
        import tomllib
        pins = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['metadata']['supply-chain']
        action = runpy.run_path(str(ROOT / 'scripts/rust-dependencies'))['main']
        state, installs = {}, []
        def install(command, **options):
            installs.append(command)
            state['version'] = command[command.index('--version') + 1]
        selected = lambda name: '/prepared/' + name if state else None
        with patch('subprocess.run', install), patch('subprocess.check_output', side_effect=lambda *a, **kw: state['version']), patch('shutil.which', selected), patch.object(sys, 'argv', ['rust-dependencies', '--prepare']):
            action()
            action()
        self.assertEqual(state['version'], pins['cargo-machete'])
        self.assertEqual(len(installs), 1)
        for name in ('rust-advisories', 'rust-dependencies'):
            with self.subTest(tool=name):
                action = runpy.run_path(str(ROOT / 'scripts' / name))['main']
                with patch('shutil.which', return_value='/prepared/wrong-version'), patch('subprocess.check_output', return_value='wrong version'), patch('subprocess.run', side_effect=AssertionError('must not overwrite or fetch with a wrong tool')), patch.object(sys, 'argv', [name, '--prepare']):
                    with self.assertRaisesRegex(SystemExit, 'found wrong version'):
                        action()

