#!/usr/bin/env python3
"""Generate JVM error types from the shared engine contract."""
import json
import shutil
from pathlib import Path
import sys

root = Path(__file__).resolve().parent.parent
codes = json.loads((root / 'schemas/contract.json').read_text())['codes']
base = Path(sys.argv[1]) if len(sys.argv) > 1 else root / 'sdk/java'
generated = base / 'library/target/generated-sources/contracts'
shutil.rmtree(generated, ignore_errors=True)
output = generated / 'dev/thinkthen'
output.mkdir(parents=True, exist_ok=True)
entries = []
for code in codes:
    name = code['name'].upper().replace('.', '_').replace('-', '_')
    entries.append(f'    /** The shared engine code {code["name"]}. */\n    {name}({code["value"]}, "{code["name"]}", Family.{code["family"].upper()})')
(output / 'ErrorCode.java').write_text('''package dev.thinkthen;

/** Stable shared engine codes. Include a default branch when switching over this enum, because codes can grow. */
public enum ErrorCode {
''' + ',\n'.join(entries) + ''';
    /** The shared error families. */
    public enum Family {
        /** Invalid caller usage. */ USAGE,
        /** A record could not be processed. */ RECORD,
        /** A backend call failed. */ BACKEND,
        /** A local operation failed. */ LOCAL,
        /** An internal operation failed. */ INTERNAL
    }
    private final int value;
    private final String wireName;
    private final Family family;
    ErrorCode(int value, String wireName, Family family) { this.value = value; this.wireName = wireName; this.family = family; }
    /** Return the ABI numeric code.
     * @return the numeric code */
    public int value() { return value; }
    /** Return the stable wire name.
     * @return the wire name */
    public String wireName() { return wireName; }
    /** Return the error family.
     * @return the family */
    public Family family() { return family; }
    /** Look up a wire code.
     * @param name the stable wire name
     * @return the matching code */
    public static ErrorCode fromWire(String name) {
        for (var code : values()) if (code.wireName.equals(name)) return code;
        throw new IllegalArgumentException("Unknown native error code");
    }
}
''')
(output / 'internal').mkdir(exist_ok=True)
(output / 'internal/DriverCode.java').write_text('''package dev.thinkthen.internal;

public record DriverCode(int value, String name, String family) {
    public static java.util.List<DriverCode> values() { return java.util.List.of(
''' + ',\n'.join(f'        new DriverCode({code["value"]}, "{code["name"]}", "{code["family"]}")' for code in codes) + '); }\n}\n')

# FFM layouts and signatures follow the generated C header, including padding.
import re
header = (root / 'crates/thinkthen-ffi/include/thinkthen.h').read_text()
header = re.sub(r'/\*.*?\*/', '', header, flags=re.S)
primitive = {
    'uint8_t': ('ValueLayout.JAVA_BYTE', 1, 1),
    'uint16_t': ('ValueLayout.JAVA_SHORT', 2, 2),
    'uint32_t': ('ValueLayout.JAVA_INT', 4, 4),
    'int32_t': ('ValueLayout.JAVA_INT', 4, 4),
    'uint64_t': ('ValueLayout.JAVA_LONG', 8, 8),
    'int64_t': ('ValueLayout.JAVA_LONG', 8, 8),
    'size_t': ('ValueLayout.JAVA_LONG', 8, 8),
    'double': ('ValueLayout.JAVA_DOUBLE', 8, 8),
}
# Public C enum discriminators retain the uint32_t ABI representation.
for enum in re.findall(r'typedef enum (thinkthen_\w+)\s*\{', header):
    primitive[enum] = primitive['uint32_t']
layouts = dict(primitive)
declarations = []
for name in ('buffer', 'error', 'row', 'record_input', 'record_view'):
    body = re.search(r'typedef struct thinkthen_' + name + r'\s*\{(.*?)\}', header, re.S).group(1)
    offset, alignment, fields = 0, 1, []
    for declaration in body.split(';'):
        declaration = declaration.strip()
        if not declaration:
            continue
        ctype, field = declaration.rsplit(None, 1)
        if '*' in ctype or field.startswith('*'):
            layout, size, align = 'ValueLayout.ADDRESS', 8, 8
            field = field.lstrip('*')
        else:
            layout, size, align = layouts[ctype]
        padding = (-offset) % align
        if padding:
            fields.append(f'MemoryLayout.paddingLayout({padding})')
        fields.append(f'{layout}.withName("{field}")')
        offset += padding + size
        alignment = max(alignment, align)
    padding = (-offset) % alignment
    if padding:
        fields.append(f'MemoryLayout.paddingLayout({padding})')
    symbol = name.upper()
    layouts['struct thinkthen_' + name] = (symbol, offset + padding, alignment)
    declarations.append('    static final MemoryLayout ' + symbol + ' = MemoryLayout.structLayout(\n        ' + ',\n        '.join(fields) + ');')
(output / 'internal/NativeLayouts.java').write_text('''package dev.thinkthen.internal;

import java.lang.foreign.MemoryLayout;
import java.lang.foreign.ValueLayout;

final class NativeLayouts {
    private NativeLayouts() {}
''' + '\n'.join(declarations) + '\n}\n')
abi = json.loads((root / 'schemas/abi.json').read_text())
functions = []
for export in abi['exports']:
    match = re.fullmatch(r'(.+?)(thinkthen_\w+)\((.*)\);', export['declaration'])
    if not match:
        continue
    result, name, arguments = match.groups()
    result = result.strip().removeprefix('THINKTHEN_NODISCARD ')
    def layout(ctype):
        return 'ValueLayout.ADDRESS' if '*' in ctype else primitive[ctype.strip()][0]
    try:
        args = [] if arguments == 'void' else [layout(argument.rsplit(None, 1)[0] if '*' not in argument else argument) for argument in arguments.split(',')]
        signature = ('FunctionDescriptor.ofVoid(' if result == 'void' else 'FunctionDescriptor.of(' + layout(result) + (', ' if args else '')) + ', '.join(args) + ')'
    except KeyError:
        continue
    functions.append(f'            case "{name.removeprefix("thinkthen_")}" -> {signature};')
(output / 'internal/NativeSignatures.java').write_text('''package dev.thinkthen.internal;

import java.lang.foreign.FunctionDescriptor;
import java.lang.foreign.ValueLayout;

final class NativeSignatures {
    private NativeSignatures() {}
    static FunctionDescriptor descriptor(String name) {
        return switch (name) {
''' + '\n'.join(functions) + '''
            default -> throw new IllegalArgumentException("No generated native signature: " + name);
        };
    }
}
''')

# Kotlin declarations use the same registry and remain build output.
kotlin_generated = base.parent / 'kotlin/target/generated-sources/contracts'
shutil.rmtree(kotlin_generated, ignore_errors=True)
kotlin = kotlin_generated / 'dev/thinkthen/kotlin'
kotlin.mkdir(parents=True, exist_ok=True)
# Java's Family order, so both enums share ordinals.
families = ['usage', 'record', 'backend', 'local', 'internal']
assert set(families) == {code['family'] for code in codes}, 'update both JVM family enums'
family_entries = ',\n'.join(f'    /** The {family} family. */\n    @SerialName("{family}") {family.upper()}("{family}")' for family in families)
code_entries = ',\n'.join(f'    /** The shared engine code {code["name"]}. */\n    @SerialName("{code["name"]}") {code["name"].upper().replace(".","_").replace("-","_")}({code["value"]}, "{code["name"]}", ErrorFamily.{code["family"].upper()})' for code in codes)
(kotlin / 'ErrorCode.kt').write_text('''package dev.thinkthen.kotlin

import kotlinx.serialization.Serializable
import kotlinx.serialization.SerialName

/** The shared error families. */
@Serializable public enum class ErrorFamily(
    /** The stable wire name. */
    public val wireName: String,
) {
''' + family_entries + '''
}

/** Stable shared engine codes. Include an `else` branch when matching on this enum, because codes can grow. */
@Serializable public enum class ErrorCode(
    /** The ABI numeric code. */
    public val value: Int,
    /** The stable wire name. */
    public val wireName: String,
    /** The error family. */
    public val family: ErrorFamily,
) {
''' + code_entries + ''';

    /** Looks up codes by wire name. */
    public companion object {
        /** The code with this wire name. Throws [ThinkThenException] with `usage.abi` for a name this library does not know. */
        public fun fromWire(name: String): ErrorCode = entries.singleOrNull { it.wireName == name }
            ?: throw ThinkThenException(USAGE_ABI, "Unknown native error code $name")
    }
}
''')
