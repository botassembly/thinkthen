#!/usr/bin/env python3
"""Prepare or verify one canonical ABI fixture directory before isolating consumers."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
from native_platform import current

ROOT = Path(__file__).resolve().parent.parent
STORE = Path.home() / '.local/share/thinkthen-build-tools/native-abi'
CONTENT_CASES = ('invalid-json', 'unanswered-answer', 'unknown-function')


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def identity():
    cache = Path(subprocess.check_output([str(ROOT / 'scripts/native-prepare'), '--path'], text=True).strip())
    host = current()
    engine = cache / host['rid'] / ('libthinkthen_ffi.' + host['suffix'])
    manifest = ROOT / 'conformance/native/manifest.json'
    definition = json.loads(manifest.read_text())
    inputs = {
        'native_key': cache.name, 'engine': str(engine), 'engine_sha256': digest(engine),
        'producer': digest(ROOT / 'scripts/native-fixtures'),
        'header': digest(ROOT / 'crates/thinkthen-ffi/include/thinkthen.h'),
        'manifest': digest(manifest), 'registry': digest(manifest.parent / definition['abi']),
        'compiler': subprocess.check_output([os.environ.get('CC', 'cc'), '--version'], text=True),
    }
    key = hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest()
    return STORE / host['rust'] / key, inputs, definition


def verify(folder, inputs, definition, published=None):
    identity = json.loads((folder / 'identity.json').read_text())
    if identity['inputs'] != inputs:
        raise ValueError('ABI fixture inputs differ from this checkout')
    manifest = json.loads((folder / 'manifest.json').read_text())
    expected = dict(definition)
    actual = dict(manifest)
    expected.pop('cases')
    actual.pop('cases')
    if actual != expected or len(manifest['cases']) != len(definition['cases']):
        raise ValueError('ABI fixture manifest differs from the canonical definition')
    files = {'manifest.json'}
    for case, expected in zip(manifest['cases'], definition['cases']):
        library = Path(case['library'])
        if library.parent != (published or folder) or {key: value for key, value in case.items() if key != 'library'} != expected:
            raise ValueError('ABI fixture case differs from the canonical definition')
        files.add(library.name)
    if set(identity['files']) != files:
        raise ValueError('ABI fixture file inventory differs')
    for name, checksum in identity['files'].items():
        path = folder / name
        if path.is_symlink() or digest(path) != checksum:
            raise ValueError('ABI fixture checksum differs: ' + name)


def prepare(folder, inputs, definition):
    folder.parent.mkdir(parents=True, exist_ok=True)
    with folder.with_suffix('.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if folder.exists():
            verify(folder, inputs, definition)
            return
        with tempfile.TemporaryDirectory(prefix='publish-', dir=folder.parent) as temporary:
            stage = Path(temporary) / 'assets'
            subprocess.run([str(ROOT / 'scripts/native-fixtures'), '--engine', inputs['engine'],
                            '--output', str(stage)], cwd=ROOT, check=True)
            manifest = json.loads((stage / 'manifest.json').read_text())
            for case in manifest['cases']:
                case['library'] = str(folder / Path(case['library']).name)
            (stage / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
            files = {'manifest.json', *(Path(case['library']).name for case in manifest['cases'])}
            (stage / 'identity.json').write_text(json.dumps({
                'inputs': inputs, 'files': {name: digest(stage / name) for name in files},
            }, sort_keys=True, indent=2) + '\n')
            verify(stage, inputs, definition, published=folder)
            stage.rename(folder)


def content_identity(inputs):
    # Content corruption is independent of the loader's ABI-version cases.
    names = ('native_key', 'engine', 'engine_sha256', 'header', 'compiler')
    content = {name: inputs[name] for name in names}
    content['producer'] = digest(ROOT / 'scripts/abi-minor-check')
    content['forwarder'] = inputs['producer']
    content['registry'] = inputs['registry']
    # abi-minor-check invokes cc directly, independent of the version fixture CC.
    content['compiler'] = subprocess.check_output(['cc', '--version'], text=True)
    key = hashlib.sha256(json.dumps(content, sort_keys=True).encode()).hexdigest()
    return STORE / 'content' / current()['rust'] / key, content


def verify_content(folder, inputs):
    identity = json.loads((folder / 'identity.json').read_text())
    if set(identity) != {'inputs', 'files'} or identity['inputs'] != inputs:
        raise ValueError('Content fixture inputs differ from this checkout')
    library = Path(inputs['engine']).name
    expected = {case + '/' + name for case in CONTENT_CASES for name in ('malformed.c', library)}
    if set(identity['files']) != expected:
        raise ValueError('Content fixture file inventory differs')
    for name, checksum in identity['files'].items():
        path = folder / name
        if path.is_symlink() or digest(path) != checksum:
            raise ValueError('Content fixture checksum differs: ' + name)


def prepare_content(folder, inputs):
    folder.parent.mkdir(parents=True, exist_ok=True)
    with folder.with_suffix('.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if folder.exists():
            verify_content(folder, inputs)
            return
        with tempfile.TemporaryDirectory(prefix='publish-', dir=folder.parent) as temporary:
            stage = Path(temporary) / 'assets'
            for case in CONTENT_CASES:
                subprocess.run([str(ROOT / 'scripts/abi-minor-check'), '--native', inputs['engine'],
                                '--malformed-row', case, '--output', str(stage / case)], cwd=ROOT, check=True)
            files = {str(path.relative_to(stage)): digest(path) for path in stage.rglob('*') if path.is_file()}
            (stage / 'identity.json').write_text(json.dumps({'inputs': inputs, 'files': files},
                                                          sort_keys=True, indent=2) + '\n')
            verify_content(stage, inputs)
            stage.rename(folder)


def main():
    if sys.argv[1:] not in (['prepare'], ['env']):
        raise SystemExit('usage: scripts/native-abi-assets prepare|env')
    folder, inputs, definition = identity()
    content_folder, content_inputs = content_identity(inputs)
    if sys.argv[1] == 'prepare':
        prepare(folder, inputs, definition)
        prepare_content(content_folder, content_inputs)
        print(folder)
    else:
        verify(folder, inputs, definition)
        verify_content(content_folder, content_inputs)
        print('THINKTHEN_NATIVE_FIXTURES=' + shlex.quote(str(folder)))
        print('THINKTHEN_MALFORMED_ROW_FIXTURES=' + shlex.quote(str(content_folder)))
        print('export THINKTHEN_NATIVE_FIXTURES THINKTHEN_MALFORMED_ROW_FIXTURES')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        raise SystemExit('ABI fixtures: ' + str(error))
