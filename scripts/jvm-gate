#!/bin/sh
# Build native output once; test the installed Java and Kotlin artifacts offline.
set -eu
java_host_only=0
kotlin_host_only=0
jvm_tail=0
jvm_after_kotlin_abi=0
case "${1:-}" in
    '') ;;
    --java-host-only) java_host_only=1 ;;
    --guides-checked) java_host_only=1; kotlin_host_only=1 ;;
    --continue-after-conformance) jvm_tail=1 ;;
    --continue-after-kotlin-abi) jvm_after_kotlin_abi=1 ;;
    *) echo 'usage: scripts/jvm-gate [--java-host-only|--guides-checked|--continue-after-conformance|--continue-after-kotlin-abi]' >&2; exit 2 ;;
esac
jvm_python=$(python3 -c 'import sys; print(sys.executable)')
version=$("$jvm_python" "$(dirname "$0")/release_metadata.py" --version)
cd "$(dirname "$0")/.."
root=$PWD
: "${THINKTHEN_NATIVE_FIXTURES:?prepare native ABI fixtures before running jvm-gate}"
. scripts/jvm-env
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH THINKTHEN_LIBRARY CLASSPATH JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS
"$JAVA_HOME/bin/java" -version
"$JAVA_HOME/bin/javac" -version
if [ -n "${THINKTHEN_JVM_NATIVE_ASSETS:-}" ]; then
  cargo build --offline --locked -p loopback --bin loopback
else
  cargo build --offline --locked -p thinkthen-ffi -p loopback --bin loopback --lib
fi
"$jvm_python" scripts/jvm-generated
rm -rf sdk/java/library/target/classes sdk/kotlin/target/classes
native_target=${CARGO_TARGET_DIR:-target}
resource="sdk/java/library/target/classes/io/thinkthen/native/$jvm_platform"
mkdir -p "$resource"
if [ -z "${THINKTHEN_JVM_NATIVE_ASSETS:-}" ]; then cp "$native_target/debug/$jvm_library" "$resource/"; fi
if [ -n "${THINKTHEN_JVM_NATIVE_ASSETS:-}" ]; then
  test -f "$THINKTHEN_JVM_NATIVE_ASSETS/linux-amd64/libthinkthen_ffi.so"
  test -f "$THINKTHEN_JVM_NATIVE_ASSETS/macos-arm64/libthinkthen_ffi.dylib"
  cp -RL "$THINKTHEN_JVM_NATIVE_ASSETS"/. sdk/java/library/target/classes/io/thinkthen/native/
fi
# The shared pair is release output. Coverage must execute this tree's
# instrumented host library while retaining the opposite platform in the jar.
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
  cargo build --offline --locked -p thinkthen-ffi
  cp "$native_target/debug/$jvm_library" "$resource/"
fi
scratch=$(mktemp -d)
trap 'gate_status=$?; trap - EXIT; set +e; rm -rf "$scratch"; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
"$jvm_python" scripts/jvm_repository.py seed "$cache/m2" "$scratch/m2"
mvn -o -B -q -f sdk/java/pom.xml -Dmaven.repo.local="$scratch/m2" install -DskipTests
"$jvm_python" sdk/kotlin/tests/api_dump.py "$JAVA_HOME/bin/javap" "$(ls sdk/kotlin/target/thinkthen-kotlin-*.jar)" sdk/kotlin/api/thinkthen-kotlin.api
mvn -o -B -q -f sdk/java/pom.xml -Dmaven.repo.local="$scratch/m2" -Pdokka -pl ../kotlin package -DskipTests
test -s sdk/kotlin/target/dokka/index.html
echo 'Kotlin reference builds'
"$jvm_python" scripts/jvm_repository.py consumer "$root" "$scratch"
case "$native_target" in /*) ;; *) native_target="$root/$native_target" ;; esac
native_input="$native_target/debug/$jvm_library"
if [ -n "${THINKTHEN_JVM_NATIVE_ASSETS:-}" ] && [ -z "${LLVM_PROFILE_FILE:-}" ]; then
  native_input="$THINKTHEN_JVM_NATIVE_ASSETS/$jvm_platform/$jvm_library"
fi
export THINKTHEN_LOOPBACK="$native_target/debug/loopback"
export THINKTHEN_API_KEY=sk-test-0123456789
PATH="$JAVA_HOME/bin:$cache/apache-maven-3.9.11/bin:/usr/bin:/bin"
export PATH
cd "$scratch"
mvn -o -B -q -Dmaven.repo.local="$scratch/m2" package dependency:build-classpath -Dmdep.outputFile="$scratch/classpath"
"$jvm_python" - "$root" "$scratch/classpath" <<'PYTHON'
from pathlib import Path
import sys
root, classpath = map(Path, sys.argv[1:])
sys.path.insert(0, str(root / 'scripts'))
from release_jvm_notices import terms
terms([Path(path) for path in classpath.read_text().strip().split(':')], root)
print('JVM runtime dependency pins and terms pass')
PYTHON
"$jvm_python" "$root/scripts/jvm_repository.py" verify "$root" "$scratch/classpath" "$root/sdk/java/library/target/classes/io/thinkthen/native" "$jvm_platform" "$native_input"
classpath="target/classes:$(cat "$scratch/classpath")"
mkdir -p "$scratch/home"
XDG_CACHE_HOME="$scratch/home/.cache"
export XDG_CACHE_HOME
java() { command "$JAVA_HOME/bin/java" "-Duser.home=$scratch/home" "$@"; }
if [ "$jvm_tail" = 0 ] && [ "$jvm_after_kotlin_abi" = 0 ]; then
"$jvm_python" "$root/scripts/sdk-readme-examples" jvm "$classpath" "$scratch/m2" "$scratch/home"
if [ "$java_host_only" = 1 ]; then
    "$jvm_python" "$root/scripts/java-example-check" "$classpath" "$scratch/target/classes" --host-only
else
    "$jvm_python" "$root/scripts/java-example-check" "$classpath" "$scratch/target/classes"
fi
if [ "$kotlin_host_only" = 1 ]; then
    "$jvm_python" "$root/scripts/kotlin-example-check" "$classpath" "$scratch/m2" "$scratch/home" --host-only
else
    "$jvm_python" "$root/scripts/kotlin-example-check" "$classpath" "$scratch/m2" "$scratch/home"
fi
"$jvm_python" "$root/scripts/kotlin-dispatch-check" "$classpath" "$scratch/m2"
java --enable-native-access=ALL-UNNAMED -cp "$classpath" ConsumerCases "$root/construction/stub.json"
"$jvm_python" "$root/scripts/native-lookup-check" --embedded "$native_input" -- "$JAVA_HOME/bin/java" "-Duser.home=$scratch/home" \
  --enable-native-access=ALL-UNNAMED -cp "$scratch/$classpath" ConsumerCases "$root/construction/stub.json"
case "$(uname -s)" in
    Darwin) loader_cache="$scratch/home/Library/Caches" ;;
    *) loader_cache="$XDG_CACHE_HOME" ;;
esac
"$jvm_python" "$root/scripts/loader-cache-check" "$loader_cache" "$JAVA_HOME/bin/java" "-Duser.home=$scratch/home" --enable-native-access=ALL-UNNAMED -cp "$classpath" ConsumerCases "$root/construction/stub.json" --stub-only
java --enable-native-access=ALL-UNNAMED -cp "$classpath" KotlinCasesKt "$root/construction/stub.json"
java --enable-native-access=ALL-UNNAMED -cp "$classpath" OptionCases "$root/construction/options.json"

java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaApiCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaAnswerCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaAnnotationCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaClosedClientCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaInterfaceCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaStreamReachabilityCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaDescriptionCases
java --enable-native-access=ALL-UNNAMED -Dos.arch=unsupported -cp "$classpath" JavaLoaderFailureCases "No packaged ThinkThen native engine"
printf 'not a shared library\n' > "$scratch/broken-engine"
for unloadable in "$scratch/missing-engine" "$scratch/broken-engine"; do
  (export THINKTHEN_LIBRARY="$unloadable"; java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaLoaderFailureCases "$unloadable")
done
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaSettingsCases "$root/schemas/contract.json"
java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.SdkConventionCasesKt
"$jvm_python" "$root/sdk/java/check-packaging"
java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.AbiAndCodesKt registry "$root/schemas/contract.json"
java --enable-native-access=dev.thinkthen --module-path "$(cat "$scratch/classpath")" --add-modules ALL-MODULE-PATH -cp target/classes consumer.AbiAndCodesKt abi true
"$jvm_python" "$root/sdk/kotlin/tests/abi.py" "$THINKTHEN_NATIVE_FIXTURES/manifest.json" "$classpath" "$JAVA_HOME/bin/java" "$jvm_platform" "$jvm_library" "$scratch"


fi
if [ "$jvm_tail" = 0 ]; then
"$jvm_python" - "$root/sdk/kotlin/tests/compile-fail" <<'PYTHON'
from pathlib import Path
import sys
for case in Path(sys.argv[1]).glob('*.kt.fail'):
    Path('src/main/kotlin', case.name.removesuffix('.fail')).write_text(case.read_text())
PYTHON
if mvn -o -B -q -Dmaven.repo.local="$scratch/m2" process-classes > "$scratch/refusals.log" 2>&1; then
  echo 'Kotlin accepted invalid public API expressions' >&2
  exit 1
fi
"$jvm_python" - "$root/sdk/kotlin/tests/compile-fail" "$scratch/refusals.log" <<'PYTHON'
from pathlib import Path
import sys
text = Path(sys.argv[2]).read_text()
for case in Path(sys.argv[1]).glob('*.kt.fail'):
    name = case.name.removesuffix('.fail')
    assert name + ':' in text, name + ": missing compiler refusal\n" + "\n".join(text.splitlines()[-20:])
    for message in [line.removeprefix('// Expect: ') for line in case.read_text().splitlines() if line.startswith('// Expect: ')]:
        own = [line for line in text.splitlines() if name + ":" in line]
        assert any(message in line for line in own), name + ": expected " + message + "\n" + "\n".join(own[:3])
    Path('src/main/kotlin', name).unlink()
print("Kotlin public API compile refusals passed")
PYTHON

java --enable-native-access=ALL-UNNAMED -cp "$classpath" ConformanceCases "$root/conformance/typed"
java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.ConformanceCasesKt "$root/conformance/typed"
fi
if [ "$jvm_tail" = 1 ]; then
    "$jvm_python" "$root/scripts/guide-examples" --surface java --inventory > "$scratch/java-inventory"
    grep -F 'ENABLED java:' "$scratch/java-inventory"
    if [ ! -f "$root/scripts/python_guide_examples.py" ]; then grep -F 'PENDING python:' "$scratch/java-inventory"; fi
    if "$jvm_python" "$root/scripts/guide-examples" --surface java --java-classpath "$classpath" --negative-control output > "$scratch/java-dispatch" 2>&1; then
        echo 'Java dispatcher accepted deliberately wrong output' >&2; exit 1
    fi
    grep -Fx 'JAVA DISPATCH java/0/yes requests=1 branch=refund queue' "$scratch/java-dispatch"
    grep -F 'FAIL java/0/yes: output: expected' "$scratch/java-dispatch"
    grep -F "expected 'deliberately wrong output" "$scratch/java-dispatch" > /dev/null
    grep -F "got 'refund queue" "$scratch/java-dispatch" > /dev/null
    "$jvm_python" "$root/scripts/kotlin-example-check" "$classpath" "$scratch/m2" "$scratch/home" --host-only
    "$jvm_python" "$root/scripts/kotlin-dispatch-check" "$classpath" "$scratch/m2"
fi
java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.SurfaceCasesKt "$root/conformance"
THINKTHEN_BACKEND=stub java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.EnvironmentCasesKt
(export THINKTHEN_BACKEND=; java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.EnvironmentCasesKt)
java --enable-native-access=ALL-UNNAMED -cp "$classpath" consumer.FlowCasesKt "$root/conformance/typed"
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaCacheCases
java --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaConcurrencyCases
java -Xmx64m -XX:+ExitOnOutOfMemoryError --enable-native-access=ALL-UNNAMED -cp "$classpath" JavaRankMemoryCases
java --enable-native-access=ALL-UNNAMED -Djdk.virtualThreadScheduler.parallelism=1 -Djdk.virtualThreadScheduler.maxPoolSize=1 -cp "$classpath" JavaOwnershipCases "$root/conformance"
# A refused ABI fixture is the other engine: its public outcome differs from this tree's.
"$jvm_python" "$root/scripts/jvm-isolation-test" "$native_input" "$THINKTHEN_NATIVE_FIXTURES/wrong-major.${jvm_library##*.}" "$jvm_platform" "$jvm_library"
