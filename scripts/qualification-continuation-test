#!/usr/bin/env python3
"""Exercise gate continuation and workflow publication refusal with fake stages."""
import hashlib
import json
import os
import runpy
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

# Fixture gates own their reports independently of the invoking gate.
BASE_ENV = dict(os.environ)
BASE_ENV.pop('THINKTHEN_GATE_FAILURE_TAILS', None)

ROOT = Path(__file__).resolve().parent.parent


def workflow(name):
    document = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
        'puts JSON.generate(YAML.safe_load_file(ARGV[0], aliases: true))',
        ROOT / '.github/workflows' / name], text=True))
    # Psych's YAML 1.1 loader reads GitHub's unquoted on key as boolean true.
    if 'true' in document:
        document['on'] = document.pop('true')
    return document



class QualificationContinuation(unittest.TestCase):
    def test_gate_asset_setup_repeats_without_changing_or_uploading_caller_data(self):
        steps = workflow('native-qualification.yml')['jobs']['native-gate-inputs']['steps']
        setup = next(step for step in steps if step.get('id') == 'native')
        upload = next(step for step in steps if step.get('id') == 'upload-artifact-gate-linux-x86-64')
        for state in ('absent', 'empty', 'prepared', 'file', 'link', 'dangling-link',
                      'manifest-link', 'assets-link', 'asset-link', 'conflicting-asset'):
            with self.subTest(state=state), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                scripts, binary, source = root / 'scripts', root / 'bin', root / 'source'
                scripts.mkdir()
                binary.mkdir()
                source.mkdir()
                assets = {'linux-x64/libthinkthen_ffi.so': b'shared engine',
                          'linux-x64/libthinkthen_ffi.a': b'static engine', 'thinkthen.h': b'header'}
                manifest = {'revision': 'a' * 40, 'floor_image': 'sha256:' + 'b' * 64,
                            'native_key': 'c' * 64,
                            'assets': {name: hashlib.sha256(data).hexdigest() for name, data in assets.items()}}
                for name, data in assets.items():
                    path = source / name
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_bytes(data)
                (root / 'manifest').write_text(json.dumps(manifest, sort_keys=True) + '\n')
                fakes = {'release-workflow': '#!/bin/sh\nexit 0\n',
                         'native-prepare': '#!/bin/sh\nprintf "%s\\n" "$SOURCE"\n',
                         'native-pair': '#!/bin/sh\ncp "$MANIFEST" "$2"\n'}
                (scripts / 'native-tools-env').touch()
                for name, body in fakes.items():
                    (scripts / name).write_text(body)
                    (scripts / name).chmod(0o755)
                (binary / 'docker').write_text('#!/bin/sh\nprintf "%s\\n" "sha256:' + 'b' * 64 + '"\n')
                (binary / 'docker').chmod(0o755)
                gate, outside = root / 'gate-assets', root / 'outside'
                outside.mkdir()
                (outside / 'sentinel').write_bytes(b'outside data')
                valid = state in ('absent', 'empty', 'prepared')
                if state == 'file':
                    gate.write_bytes(b'caller file')
                elif state in ('link', 'dangling-link'):
                    gate.symlink_to(outside if state == 'link' else root / 'missing', target_is_directory=True)
                elif state != 'absent':
                    gate.mkdir()
                    (gate / 'sentinel').write_bytes(b'caller data')
                    if state == 'manifest-link':
                        (gate / 'pair.json').symlink_to(outside / 'sentinel')
                    elif state == 'assets-link':
                        (gate / 'assets').symlink_to(outside, target_is_directory=True)
                    elif state in ('prepared', 'asset-link', 'conflicting-asset'):
                        shutil.copytree(source, gate / 'assets')
                        shutil.copy2(root / 'manifest', gate / 'pair.json')
                        (gate / 'assets' / 'unrelated').write_bytes(b'private caller data')
                        if state == 'asset-link':
                            target = gate / 'assets' / 'thinkthen.h'
                            target.unlink()
                            target.symlink_to(outside / 'sentinel')
                        elif state == 'conflicting-asset':
                            (gate / 'assets' / 'thinkthen.h').write_bytes(b'other header')
                environment = {'PATH': str(binary) + os.pathsep + os.environ['PATH'], 'HOME': directory,
                               'SOURCE': str(source), 'MANIFEST': str(root / 'manifest'),
                               'GITHUB_OUTPUT': str(root / 'output'), 'GITHUB_ENV': str(root / 'environment'),
                               'RELEASE_TARGET': 'linux-x86_64', 'TMPDIR': directory}
                for attempt in range(2 if valid else 1):
                    result = subprocess.run(['bash', '-eo', 'pipefail', '-c', setup['run']], cwd=root,
                                            env=environment, capture_output=True, text=True)
                    if not valid:
                        self.assertNotEqual(result.returncode, 0, result.stdout)
                        break
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual(json.loads((gate / 'pair.json').read_text()), manifest)
                    for name, data in assets.items():
                        self.assertEqual((gate / 'assets' / name).read_bytes(), data)
                    if state != 'absent':
                        self.assertEqual((gate / 'sentinel').read_bytes(), b'caller data')
                    if state == 'prepared':
                        self.assertEqual((gate / 'assets' / 'unrelated').read_bytes(), b'private caller data')
                    self.assertEqual(upload['with']['path'], '${{ steps.native.outputs.asset_paths }}')
                    output = (root / 'output').read_text().split('asset_paths<<ASSET_PATHS\n')[-1].split('\nASSET_PATHS')[0]
                    self.assertEqual(set(output.splitlines()), {'gate-assets/pair.json',
                        *(str(Path('gate-assets/assets') / name) for name in assets)})
                self.assertEqual((outside / 'sentinel').read_bytes(), b'outside data')
                if state == 'file':
                    self.assertEqual(gate.read_bytes(), b'caller file')

    def test_floor_image_survives_failed_native_preparation(self):
        steps = workflow('native-qualification.yml')['jobs']['native-gate-inputs']['steps']
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            scripts, binary = root / 'scripts', root / 'bin'
            scripts.mkdir()
            binary.mkdir()
            (scripts / 'native-tools-env').touch()
            shutil.copy2(ROOT / 'scripts/release_images.py', scripts / 'release_images.py')
            for name, body in {
                'release-workflow': 'exit 0',
                'native-prepare': 'echo "original native failure" >&2; exit 37',
            }.items():
                path = scripts / name
                path.write_text('#!/bin/sh\n' + body + '\n')
                path.chmod(0o755)
            docker = binary / 'docker'
            docker.write_text('#!/bin/sh\nprintf "%s\\n" "sha256:' + 'b' * 64 + '"\n')
            docker.chmod(0o755)
            environment = dict(BASE_ENV, PATH=str(binary) + os.pathsep + os.environ['PATH'],
                RELEASE_TARGET='linux-x86_64', GITHUB_OUTPUT=str(root / 'output'),
                GITHUB_ENV=str(root / 'environment'))
            environment.pop('THINKTHEN_FLOOR_IMAGE', None)
            outcomes = {}
            for step in steps:
                if step.get('id') not in ('floor', 'native'):
                    continue
                result = subprocess.run(['/bin/bash', '-eo', 'pipefail', '-c', step['run']],
                    cwd=root, env=environment, capture_output=True, text=True)
                outcomes[step['id']] = {'outcome': 'failure' if result.returncode else 'success'}
                if result.returncode:
                    break
                if (root / 'environment').exists():
                    environment.update(line.split('=', 1) for line in (root / 'environment').read_text().splitlines())
            self.assertEqual(result.returncode, 37, result.stderr)
            self.assertIn('original native failure', result.stderr)
            self.assertEqual((root / 'output').read_text(), 'floor_image=sha256:' + 'b' * 64 + '\n')
            summary = subprocess.run([sys.executable, ROOT / 'scripts/qualification-summary'],
                env=dict(BASE_ENV, QUALIFICATION_STEPS=json.dumps(outcomes)), capture_output=True, text=True)
            self.assertNotEqual(summary.returncode, 0, summary.stdout)
            self.assertIn('native', summary.stderr)

    def test_hosted_gate_uploads_persistent_output_with_time_to_finish(self):
        job = workflow('native-qualification.yml')['jobs']['gate']
        gate = next(step for step in job['steps'] if step.get('id') == 'run-the-full-declared-gate')
        upload = next(step for step in job['steps']
                      if step.get('name') == 'Preserve gate stage times and running output')
        self.assertEqual(gate['run'], 'scripts/hosted-gate')
        self.assertLess(gate['timeout-minutes'], job['timeout-minutes'] - 23)
        self.assertEqual(upload['if'], 'always()')
        self.assertEqual(upload['with']['path'].rstrip('/'), gate['env']['THINKTHEN_GATE_DIAGNOSTICS'])

    def test_pair_image_validation_failure_fails_workflow_import_step(self):
        steps = workflow('native-qualification.yml')['jobs']['gate']['steps']
        step = next(step for step in steps if step.get('id') == 'import-the-linux-native-pair')
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            scripts = root / 'scripts'
            scripts.mkdir()
            (scripts / 'native-tools-env').touch()
            pair = scripts / 'native-pair'
            pair.write_text('#!/bin/sh\ncase "$1" in import) exit 0;; image) echo invalid-pair >&2; exit 7;; esac\n')
            pair.chmod(0o755)
            environment = root / 'environment'
            result = subprocess.run(['bash', '-eo', 'pipefail', '-c', step['run']], cwd=root,
                env=dict(BASE_ENV, RUNNER_TEMP=directory, GITHUB_ENV=str(environment)), capture_output=True, text=True)
            self.assertEqual(result.returncode, 7, result.stderr)
            self.assertIn('invalid-pair', result.stderr)
            self.assertFalse(environment.exists())

    def test_gate_reaches_later_sdk_after_two_failures_and_missing_tool(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            scripts, binary = root / 'scripts', root / 'bin'
            scripts.mkdir()
            binary.mkdir()
            log = root / 'commands'
            fake = '#!/bin/sh\nname=$(basename "$0")\nprintf "%s %s\\n" "$name" "$*" >> "$TEST_LOG"\ncase "$name" in release-staging-test) exit 7;; rust-advisories) exit 9;; esac\n'
            for path in (ROOT / 'scripts').iterdir():
                if path.is_file():
                    target = scripts / path.name
                    target.write_text(fake)
                    target.chmod(0o755)
            for name in ('gate', 'sdk-gates', 'gate-report'):
                shutil.copy2(ROOT / 'scripts' / name, scripts / name)
            for name in ('sh', 'dirname', 'basename', 'mktemp', 'rm', 'mkfifo', 'date', 'tee', 'tail', 'cat', 'mkdir', 'cp'):
                (binary / name).symlink_to(shutil.which(name))
            for name in ('python3', 'git', 'cargo', 'rustc', 'cc', 'c++', 'make', 'cmake', 'pkg-config', 'uv', 'node', 'npm', 'ruby', 'R', 'Rscript', 'docker'):
                (binary / name).write_text(fake)
                (binary / name).chmod(0o755)
            (binary / 'uname').write_text('#!/bin/sh\necho Linux\n')
            (binary / 'uname').chmod(0o755)
            result = subprocess.run([scripts / 'gate'], cwd=root, capture_output=True, text=True,
                env={'PATH': str(binary), 'HOME': directory, 'TEST_LOG': str(log),
                     'PYTHONDONTWRITEBYTECODE': '1', 'PM_JOB_CORES': '1', 'CARGO_BUILD_JOBS': '1', 'RUST_TEST_THREADS': '1',
                     'THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS': '0'})
            self.assertNotEqual(result.returncode, 0)
            self.assertIn('Failed gate stages: tool-staticcheck release-staging-test rust-advisories', result.stderr)
            self.assertRegex(result.stderr, r'release-staging-test \(exit 7; elapsed [0-9]+ seconds\)')
            self.assertRegex(result.stderr, r'rust-advisories \(exit 9; elapsed [0-9]+ seconds\)')
            calls = log.read_text().splitlines()
            self.assertGreater(next(i for i, line in enumerate(calls) if line.startswith('postgres-gate ')),
                               next(i for i, line in enumerate(calls) if line.startswith('rust-advisories ')))

    def test_workflows_attempt_later_stages_and_report_both_failures(self):
        for name in ('windows.yml', 'native-qualification.yml'):
            for job_name, job in workflow(name)['jobs'].items():
                with self.subTest(workflow=name, job=job_name):
                    if job.get('needs'):
                        self.assertIn(job.get('if'), ('always()',))
                    steps = job['steps']
                    summary = steps[-1]
                    self.assertEqual(summary['if'], 'always()')
                    self.assertEqual(summary['env']['QUALIFICATION_STEPS'], '${{ toJSON(steps) }}')
                    self.assertIn('scripts/qualification-summary', summary['run'])
                    diagnostics = []
                    for step in steps[:-1]:
                        self.assertFalse(step.get('continue-on-error', False))
                        if 'actions/upload-artifact@' in step.get('uses', ''):
                            self.assertIn(step.get('if'), (None, 'always()'))
                        else:
                            self.assertTrue(step.get('if', 'always()' if step['id'] == 'checkout' else '').startswith('always()'), step)
                            self.assertNotIn('steps.native.outcome', step.get('if', ''))
                            diagnostics.append(step)
                    failures = {diagnostics[0]['id'], diagnostics[1]['id']}
                    outcomes = {}
                    for step in diagnostics:
                        result = subprocess.run(['sh', '-c', 'echo "$1"; exit "$2"', 'fake-stage', step['id'], '7' if step['id'] in failures else '0'], capture_output=True, text=True)
                        outcomes[step['id']] = {'outcome': 'failure' if result.returncode else 'success'}
                    self.assertEqual(outcomes[diagnostics[-1]['id']]['outcome'], 'success')
                    result = subprocess.run([sys.executable, ROOT / summary['run'].split()[-1]],
                        env=dict(BASE_ENV, QUALIFICATION_STEPS=json.dumps(outcomes)), capture_output=True, text=True)
                    self.assertNotEqual(result.returncode, 0)
                    for failed in failures:
                        self.assertIn(failed, result.stderr)
                    self.assertIn(diagnostics[-1]['id'] + ': success', result.stdout)

    def test_qualification_uses_only_current_run_products(self):
        prepare = workflow('release-prepare.yml')
        native = workflow('native-qualification.yml')
        text = json.dumps([prepare, native])
        for obsolete in ('prior_run_id', 'windows_retry', 'qualified-reuse', 'THINKTHEN_RELEASE_REUSE'):
            self.assertNotIn(obsolete, text)
        self.assertNotIn('retry', prepare['jobs']['source']['outputs'])
        self.assertEqual(native['jobs']['build-windows']['needs'], ['native-gate-inputs', 'windows-r'])
        attest = [step for step in prepare['jobs']['draft']['steps'] if 'actions/attest@' in step.get('uses', '')]
        self.assertEqual(len(attest), 1)
        self.assertNotIn('if', attest[0])
        self.assertEqual(attest[0]['with']['subject-path'], 'release/*')
        self.assertEqual(prepare['jobs']['draft']['needs'], ['source', 'bundle', 'registry-installed'])
        draft = next(step for step in prepare['jobs']['draft']['steps'] if step.get('name') == 'Create a draft for review')
        self.assertEqual(draft['env']['DRY_RUN'], '${{ inputs.dry_run }}')
        self.assertIn('--dry-run', draft['run'])

    def test_cli_mode_skips_unrelated_windows_surfaces_and_keeps_failure_evidence(self):
        document = workflow('windows.yml')
        inputs = document['on']['workflow_dispatch']['inputs']
        self.assertIn('cli', inputs['surface']['options'])
        self.assertEqual(inputs['cli_case']['default'], 'forced-exit')
        self.assertEqual(inputs['cli_case']['options'], ['forced-exit', 'all'])
        steps = {step.get('id'): step for step in document['jobs']['windows']['steps']}
        for name in ('setup-go', 'setup-java', 'go', 'jvm', 'elevated'):
            self.assertEqual(steps[name]['if'], "always() && (inputs.surface == 'all' || inputs.surface == 'cache')")
        for name in ('setup-dotnet', 'csharp'):
            self.assertEqual(steps[name]['if'], "always() && (inputs.surface == 'all' || inputs.surface == 'csharp')")
        for name in ('setup-node', 'setup-ruby', 'spreadsheets', 'clippy'):
            self.assertEqual(steps[name]['if'], "always() && inputs.surface == 'all'")
        self.assertIn("inputs.surface == 'cli' && 'cli' || 'native'", steps['native']['env']['NATIVE_PHASE'])
        self.assertEqual(steps['cli']['if'], "always() && inputs.surface == 'cli'")
        final_shell = workflow('native-qualification.yml')['jobs']['windows-check']['defaults']['run']['shell']
        self.assertEqual(steps['cli']['shell'], final_shell)
        self.assertIn('"$RUNNER_TEMP/windows-native-proof" --case "$CLI_CASE"', steps['cli']['run'])
        upload, = [step for step in document['jobs']['windows']['steps'] if 'actions/upload-artifact@' in step.get('uses', '')]
        self.assertEqual(upload['if'], 'always()')
        self.assertIn('/cli/identity.json', upload['with']['path'])
        self.assertIn('/cli-proof/', upload['with']['path'])

    def test_cli_proof_preserves_child_failure_logs_and_binary_identity(self):
        action = runpy.run_path(str(ROOT / 'scripts/windows-cli-proof'))['proof']
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            scripts = root / 'scripts'
            scripts.mkdir()
            (scripts / 'windows-cli-check').write_text('import json,sys; print(json.dumps(sys.argv[1:])); print("fixture failed",file=sys.stderr); sys.exit(7)')
            folder = root / 'build'
            (folder / 'cli').mkdir(parents=True)
            (folder / 'cli/thinkthen.exe').write_bytes(b'fixture native binary')
            (folder / 'cli/identity.json').write_text('{"source":"fixture"}')
            action.__globals__['ROOT'] = root
            for case in ('forced-exit', 'all'):
                self.assertEqual(action(folder, case), 7)
                evidence = folder / 'cli-proof'
                result = json.loads((evidence / 'result.json').read_text())
                self.assertEqual(result, dict(case=case, exit=7, binary_sha256=hashlib.sha256(b'fixture native binary').hexdigest()))
                self.assertEqual((evidence / 'identity.json').read_text(), '{"source":"fixture"}')
                arguments = json.loads((evidence / 'stdout.log').read_text())
                self.assertEqual(arguments[:2], ['--binary', str(folder / 'cli/thinkthen.exe')])
                self.assertEqual(arguments[2:4], ['--diagnostics', str(evidence)])
                self.assertEqual(arguments[4:], ['--case', 'forced-exit'] if case == 'forced-exit' else [])
                self.assertEqual((evidence / 'stderr.log').read_text().strip(), 'fixture failed')

    def test_windows_checker_selects_the_same_pinned_host_runtimes(self):
        reference = workflow('windows.yml')['jobs']['windows']['steps']
        actual = workflow('native-qualification.yml')['jobs']['windows-check']['steps']
        for runtime in ('go', 'java', 'dotnet', 'node', 'ruby'):
            with self.subTest(runtime=runtime):
                source = next(step for step in reference if step.get('id') == 'setup-' + runtime)
                selected = next(step for step in actual if step.get('id') == 'setup-' + runtime)
                self.assertEqual(selected['uses'], source['uses'])
                self.assertEqual(selected['with'], source['with'])
        rust = next(step for step in actual if step.get('id') == 'prepare-rust')
        self.assertIn('from release_rust import prepare; prepare()', rust['run'])
        self.assertIn('cargo fetch --locked --target x86_64-pc-windows-msvc', rust['run'])

    def test_failed_qualification_blocks_bundle_draft_and_publication(self):
        prepare = workflow('release-prepare.yml')['jobs']
        self.assertEqual(prepare['bundle']['needs'], ['source', 'qualification'])
        self.assertEqual(prepare['draft']['needs'], ['source', 'bundle', 'registry-installed'])
        for name in ('qualification', 'bundle', 'draft'):
            self.assertFalse(prepare[name].get('continue-on-error', False))
        for name in ('bundle', 'draft'):
            self.assertNotIn('if', prepare[name])
            for step in prepare[name]['steps']:
                if 'if' in step:
                    self.assertIn(step['if'], ('always()', "needs.source.outputs.retry == 'true'", "needs.source.outputs.retry != 'true'",
                                               "always() && steps.attach-registries.outcome == 'success' && steps.tag-source-install.outcome == 'success'",
                                               "always() && steps.registry-packages.outcome == 'success'",
                                               "always() && steps.admit-release.outcome == 'success'",
                                               "always() && steps.admit-release.outcome != 'success'"))
                self.assertFalse(step.get('continue-on-error', False))
        for job in workflow('release.yml')['jobs'].values():
            self.assertNotIn('always()', str(job.get('if', '')))
            self.assertFalse(job.get('continue-on-error', False))


if __name__ == '__main__':
    unittest.main()
