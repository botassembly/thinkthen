#!/usr/bin/env python3
"""Feature: candidate gates refuse skipped checks and absent platform stages."""
import contextlib
import io
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import tempfile
import unittest
import sys
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent


class StrictGate(unittest.TestCase):
    def test_candidate_requires_private_patterns_and_checks_only_product_text(self):
        with tempfile.TemporaryDirectory(prefix='gate-words-') as temporary:
            root = Path(temporary)
            source = root / 'source'
            (source / 'scripts').mkdir(parents=True)
            shutil.copy2(ROOT / 'scripts/words', source / 'scripts/words')
            (source / 'README.md').write_text('Public product text\nCodeUsageThreshold Code = C.THINKTHEN_CODE_USAGE_THRESHOLD\n')
            (source / 'sdlc').mkdir()
            (source / 'sdlc/private').write_text('ExampleConfidential\n')
            (source / 'AGENTS.md').write_text('ExampleConfidential\n')
            subprocess.run(['git', 'init', '--quiet'], cwd=source, check=True)
            subprocess.run(['git', 'add', '.'], cwd=source, check=True)
            env = dict(os.environ, THINKTHEN_GATE_STRICT='1')
            missing = subprocess.run([source / 'scripts/words'], env=env, capture_output=True, text=True)
            self.assertNotEqual(missing.returncode, 0, 'candidate accepted absent private patterns')
            patterns = root / 'patterns'
            patterns.write_text('ExampleConfidential')
            clean = subprocess.run([source / 'scripts/words', patterns], env=env, capture_output=True, text=True)
            self.assertEqual(clean.returncode, 0, clean.stderr)
            (source / 'README.md').write_text('This came from old ' 'code.\n')
            history = subprocess.run([source / 'scripts/words', patterns], env=env, capture_output=True, text=True)
            self.assertNotEqual(history.returncode, 0, 'candidate accepted implementation history')
            self.assertIn('README.md:1:', history.stderr)
            (source / 'README.md').write_text('ExampleConfidential\n')
            exposed = subprocess.run([source / 'scripts/words', patterns], env=env, capture_output=True, text=True)
            self.assertNotEqual(exposed.returncode, 0)
            self.assertIn('README.md:1:', exposed.stderr)

            maker = 'Genom' + 'Oncology'
            patterns.write_text(maker + '|ExampleConfidential')
            (source / 'README.md').write_text('Public product text\n')
            credits = ('site/src/components/Footer.astro',
                       'site/src/content/docs/about.mdx',
                       'site/src/content/docs/blog/introducing-thinkthen.mdx')
            for name in credits:
                path = source / name
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text('Made by ' + maker + '\nhttps://www.' + maker.lower()
                                + '.com/\n/brand/' + maker.lower() + '-logo-light.png\n'
                                + '/brand/' + maker.lower() + '-logo-dark.png\n')
            subprocess.run(['git', 'add', '.'], cwd=source, check=True)
            approved = subprocess.run([source / 'scripts/words', patterns], env=env, capture_output=True, text=True)
            self.assertEqual(approved.returncode, 0, approved.stderr)
            for spelling in (maker, maker.lower()):
                (source / 'README.md').write_text(spelling + '\n')
                elsewhere = subprocess.run([source / 'scripts/words', patterns], env=env, capture_output=True, text=True)
                self.assertNotEqual(elsewhere.returncode, 0)
                self.assertIn('README.md:1:', elsewhere.stderr)
            (source / 'README.md').write_text('Public product text\n')
            footer = source / credits[0]
            for forbidden_text in ('ExampleConfidential', 'old ' + 'code'):
                footer.write_text('Made by ' + maker + '; ' + forbidden_text + '\n')
                rejected = subprocess.run([source / 'scripts/words', patterns], env=env, capture_output=True, text=True)
                self.assertNotEqual(rejected.returncode, 0)
                self.assertIn(credits[0] + ':1:', rejected.stderr)

    def test_candidate_refuses_a_platform_that_omits_required_linux_stages(self):
        with tempfile.TemporaryDirectory(prefix='gate-platform-') as temporary:
            root = Path(temporary)
            scripts = root / 'scripts'
            scripts.mkdir()
            for path in (ROOT / 'scripts').iterdir():
                if path.is_file():
                    stub = scripts / path.name
                    stub.write_text('#!/bin/sh\nexit 0\n')
                    stub.chmod(0o755)
            shutil.copy2(ROOT / 'scripts/gate', scripts / 'gate')
            tools = root / 'tools'
            tools.mkdir()
            for name in ('python3', 'git', 'cargo', 'rustc', 'cc', 'c++', 'make', 'cmake',
                         'pkg-config', 'uv', 'node', 'npm', 'ruby', 'R', 'Rscript', 'staticcheck', 'docker'):
                path = tools / name
                path.write_text('#!/bin/sh\nexit 0\n')
                path.chmod(0o755)
            uname = tools / 'uname'
            uname.write_text('#!/bin/sh\nprintf "Darwin\\n"\n')
            uname.chmod(0o755)
            patterns = root / 'patterns'
            patterns.write_text('ExampleConfidential')
            env = dict(os.environ, PATH=str(tools) + os.pathsep + os.environ['PATH'],
                       THINKTHEN_PRIVATE_PATTERNS=str(patterns), THINKTHEN_NATIVE_LIBRARY='fixture',
                       THINKTHEN_GATE_DIAGNOSTICS=str(root / 'diagnostics'))
            ordinary = subprocess.run([scripts / 'gate'], env=dict(env, THINKTHEN_GATE_STRICT='0'),
                                      capture_output=True, text=True)
            self.assertEqual(ordinary.returncode, 0, ordinary.stderr)
            strict = subprocess.run([scripts / 'gate'], env=dict(env, THINKTHEN_GATE_STRICT='1'),
                                    capture_output=True, text=True)
            self.assertNotEqual(strict.returncode, 0, 'candidate silently omitted Linux stages')
            self.assertIn('strict candidate gate requires Linux', strict.stderr)

    def test_candidate_fails_a_completed_but_unmeasured_resource_report(self):
        sys.path.insert(0, str(ROOT / 'scripts'))
        try:
            main = runpy.run_path(str(ROOT / 'scripts/stress-adapters.py'))['main']
        finally:
            sys.path.pop(0)

        def completed(command, table, wire, scenario, count, concurrency, rounds, cancel, **options):
            options['result'].update(calls=rounds, rows=count * rounds, failed=0)

        output, errors = io.StringIO(), io.StringIO()
        with patch.dict(main.__globals__, run=completed), \
                patch.dict(os.environ, THINKTHEN_GATE_STRICT='1'), \
                patch.object(sys, 'argv', ['stress-adapters.py', '--surface', 'fixture',
                                          '--sanitizer', 'address', '--', 'installed-adapter']), \
                contextlib.redirect_stdout(output), contextlib.redirect_stderr(errors):
            status = main()
        report = json.loads(output.getvalue())
        self.assertIn('not measured', report['resource_growth'])
        self.assertNotEqual(status, 0, 'candidate accepted an unmeasured resource check')

    def test_required_sdk_cannot_skip_in_candidate_mode(self):
        with tempfile.TemporaryDirectory(prefix='gate-strict-') as temporary:
            root = Path(temporary)
            scripts = root / 'scripts'
            scripts.mkdir()
            dispatcher = (ROOT / 'scripts/sdk-gates').read_text()
            for name in set(re.findall(r'\b[\w-]+-gate\b', dispatcher)):
                path = scripts / name
                path.write_text('#!/bin/sh\nexit ' + ('77' if name == 'python-gate' else '0') + '\n')
                path.chmod(0o755)
            shutil.copy2(ROOT / 'scripts/sdk-gates', scripts / 'sdk-gates')
            env = dict(os.environ)
            env.pop('THINKTHEN_SDK_GATE_RUNNER', None)
            ordinary = subprocess.run([scripts / 'sdk-gates'], env=dict(env, THINKTHEN_GATE_STRICT='0'),
                                      capture_output=True, text=True)
            self.assertEqual(ordinary.returncode, 0, ordinary.stderr)
            strict = subprocess.run([scripts / 'sdk-gates'], env=dict(env, THINKTHEN_GATE_STRICT='1'),
                                    capture_output=True, text=True)
            self.assertNotEqual(strict.returncode, 0, strict.stdout)
            self.assertIn('python-gate', strict.stderr)


if __name__ == '__main__':
    unittest.main()
