#!/bin/sh
# Select prepared tools before both sides of the immutable floor boundary.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
case "${1:-}" in
    --inside|--inside-day-one|--inside-soaks|--inside-soaks-2|--inside-soaks-3)
        inside_mode=$1
        shift
        python3 scripts/public_export_gate.py verify "$@"
        . scripts/native-env
        THINKTHEN_POSTGRES_TEST_IMAGE=$6
        THINKTHEN_PRIVATE_PATTERNS=$7
        export THINKTHEN_POSTGRES_TEST_IMAGE THINKTHEN_PRIVATE_PATTERNS THINKTHEN_GATE_STRICT=1
        PATH="$HOME/.local/share/thinkthen-build-tools/cargo-deny/0.20.2-glibc2.28-rust1.95.0/installed/bin:$CARGO_HOME/bin:$PATH"
        export PATH
        export THINKTHEN_SWIFT_LOOPBACK="$THINKTHEN_LOOPBACK"
        if [ "$inside_mode" = --inside-day-one ]; then
            exec scripts/hosted-candidate-check --day-one-sdk-checks-inside
        fi
        if [ "$inside_mode" = --inside-soaks ]; then
            exec scripts/hosted-candidate-check --extended-soaks-inside
        fi
        if [ "$inside_mode" = --inside-soaks-2 ]; then
            exec scripts/hosted-candidate-check --extended-soaks-2-inside
        fi
        if [ "$inside_mode" = --inside-soaks-3 ]; then
            exec scripts/hosted-candidate-check --extended-soaks-3-inside
        fi
        exec scripts/gate
        ;;
    *) exec python3 scripts/public_export_gate.py host "$@" ;;
esac
