#!/usr/bin/env python3
"""Run every literal ideal Python guide example on the named fixture scenarios."""
import sys

from python_guide_examples import run_python_ideal
from pandas_guide_examples import run_pandas
from polars_guide_examples import run_polars

if __name__ == '__main__':
    if len(sys.argv) != 2:
        raise SystemExit('usage: scripts/python-guide-examples PYTHON')
    failures = []
    for name, runner in [('python', run_python_ideal), ('pandas', run_pandas), ('polars', run_polars)]:
        try:
            runner(sys.argv[1])
        except (AssertionError, RuntimeError, OSError) as error:
            failures.append(name + ': ' + str(error))
    if failures:
        raise SystemExit('FAIL ' + '\n'.join(failures))
