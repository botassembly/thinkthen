#!/bin/sh
# Run focused hosted-boundary proofs with the repository's prepared tools.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
if [ "${1:-}" = --native-inputs ]; then
    shift
    exec python3 scripts/hosted-candidate-inputs "$@"
fi
if [ "${1:-}" = --scan ]; then
    exec ruff check --select F401,F841,ERA,BLE,E722,S110 scripts/runtime-floor-build scripts/release_workflow.py scripts/postgres-installed-prepare-test scripts/hosted-candidate-inputs scripts/release-replay-test scripts/release-staging-test scripts/qualification-continuation-test scripts/public-export-test scripts/public_export_gate.py scripts/native-producer-test scripts/stress-dispatch-test scripts/loader-failure-check scripts/release-floor-inputs-test scripts/qualification-recipe-test
fi
if [ "${1:-}" = --loader-checks ]; then
    [ "$#" -eq 5 ] || { echo 'usage: hosted-candidate-check --loader-checks CARGO_HOME TARGET FLOOR_IMAGE SWIFT_IMAGE' >&2; exit 2; }
    export CARGO_HOME="$2" CARGO_TARGET_DIR="$3" THINKTHEN_FLOOR_IMAGE="$4" THINKTHEN_SWIFT_IMAGE="$5"
    export THINKTHEN_DOCKER_IN_FLOOR=1
    scratch=$(mktemp -d)
    trap 'status=$?; trap - EXIT; rm -rf "$scratch"; exit "$status"' EXIT
    ln -s "$scratch" "$scratch/temporary"
    export TMPDIR="$scratch/temporary"
    scripts/runtime-floor-build scripts/hosted-candidate-check --loader-checks-inside
    exit
fi
if [ "${1:-}" = --loader-checks-inside ]; then
    pair=$(mktemp)
    scripts/native-pair export "$pair"
    scripts/native-pair import "$pair" "$(scripts/native-prepare --path)"
    rm -f "$pair"
    . scripts/native-env
    export THINKTHEN_GATE_STRICT=1 THINKTHEN_SDK_GATE_RUNNER=scripts/linux-binding-gate
    export THINKTHEN_SWIFT_LOOPBACK="$CARGO_TARGET_DIR/debug/loopback"
    status=0
    for gate in ruby-gate csharp-gate swift-gate; do
        if scripts/linux-binding-gate "scripts/$gate"; then :; else status=1; fi
    done
    exit "$status"
fi
if [ "${1:-}" = --baseline ]; then
    [ "$#" -eq 3 ] || { echo 'usage: hosted-candidate-check --baseline REVISION TEST' >&2; exit 2; }
    current=$PWD
    scratch=$(mktemp -d)
    trap 'status=$?; trap - EXIT; rm -rf "$scratch"; exit "$status"' EXIT
    git archive "$2" | tar -x -C "$scratch"
    git -C "$scratch" init --quiet
    git -C "$scratch" add -f .
    for test in stress-dispatch-test release-staging-test qualification-continuation-test public-export-test; do
        cp "$current/scripts/$test" "$scratch/scripts/$test"
    done
    cd "$scratch"
    if [ "$3" = release-staging-test ]; then /bin/bash --version; fi
    python3 "scripts/$3"
    exit
fi
if [ "$#" -gt 0 ]; then
    test_script=$1
    shift
    exec python3 "scripts/$test_script" "$@"
fi
python3 scripts/stress-dispatch-test
python3 scripts/release-staging-test
python3 scripts/release-script-test
python3 scripts/postgres-installed-prepare-test
ruby scripts/release-workflow-check --self-test
git diff --check
