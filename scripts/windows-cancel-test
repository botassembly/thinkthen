#!/usr/bin/env python3
"""Feature: the cancel stage fails a call that ignores cancel, keeps its socket, or leaves a process."""
import json
import os
from pathlib import Path
import runpy
import shutil
import stat
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent

LOOPBACK = r'''#!/usr/bin/env python3
import json, os, sys
if sys.argv[1:] == ['--limits']:
    print(json.dumps({'workers': 4}))
    sys.exit()
print(9, flush=True)
counts = [1, int(os.environ.get('FAKE_LATER_COUNT', '1'))]
for line in sys.stdin:
    command = line.strip()
    if command == 'shutdown':
        break
    if command == 'count':
        print(counts.pop(0) if len(counts) > 1 else counts[0], flush=True)
    elif command == 'closed':
        print(os.environ.get('FAKE_CLOSED', 'closed'), flush=True)
    else:
        print('arrived', flush=True)
'''

ADAPTER = r'''import json, os, subprocess, sys
kind = sys.argv[1]
case = json.load(open(os.environ['THINKTHEN_STRESS_CASE']))
assert case['cancel'] and case['client']['url'].endswith(':9/v1')
if kind == 'dies':
    sys.stdin.readline()
    sys.exit(3)
if kind == 'ignores':
    sys.stdin.readline()
    import threading
    threading.Event().wait()
assert sys.stdin.readline() == 'cancel\n'
if kind == 'orphan':
    subprocess.Popen([sys.executable, '-c', 'import threading;threading.Event().wait()'],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
print(json.dumps({'calls': 1, 'rows': 7 if kind == 'rows' else 0, 'failed': 0, 'cancelled': True}))
'''


def main():
    with tempfile.TemporaryDirectory(prefix='windows-cancel-test-') as temporary:
        folder = Path(temporary)
        shutil.copy2(ROOT / 'scripts/release/cancel.py', folder / 'cancel.py')
        shutil.copy2(ROOT / 'conformance/stress.json', folder / 'stress.json')
        loopback = folder / 'loopback'
        loopback.write_text(LOOPBACK.replace('#!/usr/bin/env python3', '#!' + sys.executable, 1))
        loopback.chmod(loopback.stat().st_mode | stat.S_IEXEC)
        adapter = folder / 'adapter.py'
        adapter.write_text(ADAPTER)
        os.environ['THINKTHEN_LOOPBACK'] = str(loopback)
        sys.path.insert(0, str(ROOT / 'scripts'))
        prove = runpy.run_path(str(folder / 'cancel.py'))['prove']
        ordinary = prove.__globals__['LIMIT_SECONDS']

        def attempt(kind, *, later=None, closed=None):
            os.environ.pop('FAKE_LATER_COUNT', None)
            os.environ.pop('FAKE_CLOSED', None)
            if later:
                os.environ['FAKE_LATER_COUNT'] = later
            if closed:
                os.environ['FAKE_CLOSED'] = closed
            # Only a case that must run out the limit shortens it; the rest must not fail on a slow machine.
            prove.__globals__['LIMIT_SECONDS'] = 2 if kind in ('ignores', 'orphan') else ordinary
            prove('fixture', [sys.executable, str(adapter), kind], native=False, interrupt=False)

        attempt('good')
        for kind, options, expected in [
                ('dies', {}, 'adapter exited 3'),
                ('ignores', {}, 'timed out'),
                ('rows', {}, 'lost its cancellation'),
                ('orphan', {}, 'left a process'),
                ('good', {'closed': 'open'}, 'remained open'),
                ('good', {'later': '2'}, 'requests continued')]:
            try:
                attempt(kind, **options)
            except RuntimeError as error:
                assert expected in str(error), (kind, options, str(error))
            else:
                raise AssertionError(f'cancel stage accepted {kind} {json.dumps(options)}')
    print('Windows cancel stage rejects each unfinished call')


if __name__ == '__main__':
    main()
