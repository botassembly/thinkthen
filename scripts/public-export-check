#!/bin/sh
# Check future public planning contents with the caller-owned private patterns.
set -eu
case "$#:${1:-}" in
    2:--planning) ;;
    *) echo "usage: scripts/public-export-check --planning PRIVATE_PATTERN_FILE" >&2; exit 2 ;;
esac
cd "$(dirname "$0")/.."
. scripts/native-tools-env
# Planning is deliberately excluded from the current strict product export.
export THINKTHEN_GATE_STRICT=0
exec python3 scripts/words "$2"
