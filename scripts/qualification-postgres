#!/usr/bin/env python3
"""Run the delivered PostgreSQL README quickstart in an isolated local server."""
import os
import csv
import io
from pathlib import Path
import re
import subprocess
import sys
import tempfile

package = Path(sys.argv[1])
blocks = re.findall(r'```sql\n(.*?)\n```', (package / 'postgres/README.md').read_text(), re.S)
with tempfile.TemporaryDirectory(prefix='thinkthen-readme-pg-') as temporary:
    home = Path(temporary)
    data = home / 'data'
    subprocess.run(['initdb', '-D', data, '-A', 'trust', '-U', 'thinkthen', '--no-locale', '-E', 'UTF8'], check=True)
    subprocess.run(['pg_ctl', '-D', data, '-l', home / 'server.log', '-o', '-k ' + temporary + ' -c listen_addresses=', '-w', 'start'], check=True)
    try:
        env = dict(os.environ, PGHOST=temporary, PGUSER='thinkthen', PGDATABASE='postgres',
                   PGOPTIONS='-c thinkthen.backend=stub -c thinkthen.allowed_backends=stub:*')
        sql = '\n'.join(blocks[:3])
        result = subprocess.run(['psql', '-X', '-q', '--csv', '-v', 'ON_ERROR_STOP=1'], input=sql, text=True,
                                stdout=subprocess.PIPE, env=env, check=True)
        rows = list(csv.reader(io.StringIO(result.stdout)))
        assert rows and rows[0] == ['msg_id', 'body', 'is_refund', 'status'], result.stdout
        assert len(rows) == 6 and all(len(row) == 4 for row in rows[1:]), result.stdout
        assert {row[0] for row in rows[1:]} == {'1', '2', '3', '4', '5'}, result.stdout
        assert all(row[1] and (row[2], row[3]) in {
            ('t', 'answered'), ('f', 'answered'), ('', 'unsure')
        } for row in rows[1:]), result.stdout
    finally:
        subprocess.run(['pg_ctl', '-D', data, '-m', 'fast', '-w', 'stop'], check=True)
print('README: PostgreSQL passes')
