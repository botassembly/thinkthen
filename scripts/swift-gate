#!/bin/sh
# Build an external Swift 6 consumer with packaged native resources, offline.
set -eu
cd "$(dirname "$0")/.."
root=$PWD
unset THINKTHEN_LIBRARY
python3 scripts/swift-consumer-staging-test
ruff check --select F401,F841,ERA,BLE,E722,S110 scripts/swift_guide_examples.py sdk/swift/tests/*.py scripts/swift-consumer-stage scripts/swift-consumer-staging-test scripts/release/swift.py sdk/c/tests/admission.py
swift format lint --strict --recursive sdk/swift
export CARGO_NET_OFFLINE=true
if [ -z "${THINKTHEN_LOOPBACK:-}" ]; then cargo build --locked -p loopback; fi
build_target=${CARGO_TARGET_DIR:-$root/target}
case "$build_target" in /*) ;; *) build_target="$root/$build_target" ;; esac
scratch=$(mktemp -d)
trap 'gate_status=$?; trap - EXIT; set +e; rm -rf "$scratch"; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
if [ -n "${THINKTHEN_SWIFT_PACKAGE:-}" ]; then
    cp -R "$THINKTHEN_SWIFT_PACKAGE" "$scratch/ThinkThen"
else
    scripts/swift-package "$scratch/ThinkThen"
fi
mkdir "$scratch/home" "$scratch/tmp" "$scratch/module-cache"
export CLANG_MODULE_CACHE_PATH="$scratch/module-cache"
python3 scripts/swift-consumer-stage "$scratch/consumer"
# SwiftPM has no remote dependencies to resolve. The separate consumer checks
# normal dependency eligibility rather than only building the library itself.
swift build --package-path "$scratch/consumer" --disable-sandbox --jobs "${CARGO_BUILD_JOBS:-2}" -Xswiftc -warnings-as-errors -Xswiftc -module-cache-path -Xswiftc "$CLANG_MODULE_CACHE_PATH" -Xcc "-fmodules-cache-path=$CLANG_MODULE_CACHE_PATH"
(
    unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_URL THINKTHEN_BATCH
    export THINKTHEN_BACKEND=stub HOME="$scratch/home" TMPDIR="$scratch/tmp"
    cd "$scratch/consumer/Examples"
    "$scratch/consumer/.build/debug/Examples"
)
python3 scripts/swift-dispatch-check "$scratch/consumer"
mkdir "$scratch/installed"
cp "$scratch/consumer/.build/debug/Consumer" "$scratch/consumer/.build/debug/Readme" "$scratch/installed/"
for resources in "$scratch/consumer/.build/debug/"*.resources "$scratch/consumer/.build/debug/"*.bundle; do
    test ! -d "$resources" || cp -R "$resources" "$scratch/installed/"
done
swift_engine=$(find "$scratch/installed" -type f -name "libthinkthen_ffi.$([ "$(uname -s)" = Darwin ] && echo dylib || echo so)" -print)
HOME="$scratch/home" TMPDIR="$scratch/tmp" python3 sdk/swift/tests/run.py --readme-only "$scratch/installed/Readme"
python3 scripts/loader-failure-check "$swift_engine" --attempted "$swift_engine" -- "$scratch/installed/Readme"
python3 scripts/native-lookup-check "$swift_engine" -- "$scratch/installed/Readme"
python3 sdk/swift/tests/options.py "$scratch/consumer" construction/options.json
rm -rf "$scratch/ThinkThen" "$scratch/consumer"
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH THINKTHEN_BACKEND
export HOME="$scratch/home" TMPDIR="$scratch/tmp"
if [ -n "${THINKTHEN_SWIFT_OUTPUT:-}" ]; then
    mkdir -p "$THINKTHEN_SWIFT_OUTPUT"
    cp -R "$scratch/installed/." "$THINKTHEN_SWIFT_OUTPUT/"
fi

python3 sdk/swift/tests/run.py "$scratch/installed/Consumer" "$root" "${THINKTHEN_LOOPBACK:-$build_target/debug/loopback}"

THINKTHEN_LOOPBACK="${THINKTHEN_LOOPBACK:-$build_target/debug/loopback}" python3 sdk/swift/tests/review_probes.py "$scratch/installed/Consumer"
