from test_control import read_line

ROOT = Path(__file__).resolve().parent.parent
CASE_SECONDS = 240  # Bound each named case as well as its individual child commands.
TEXT = '漢字 café evidence 5'


def utf8_setting():
    """The one line the install and command pages tell PowerShell users to run."""
    return json.loads((ROOT / 'site/src/data/site.json').read_text(encoding='utf-8'))['install']['windowsUtf8']


def stopped(pid):
    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
    kernel.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
    kernel.OpenProcess.restype = wintypes.HANDLE
    kernel.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
    kernel.WaitForSingleObject.restype = wintypes.DWORD
    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
    handle = kernel.OpenProcess(0x00100000, False, pid)
    if not handle:
        if ctypes.get_last_error() == 87:
            return
        raise ctypes.WinError(ctypes.get_last_error())
    try:
        assert kernel.WaitForSingleObject(handle, 2000) == 0, 'saved run left child process ' + str(pid)
    finally:
        kernel.CloseHandle(handle)


def reap(pids):
    """Stop only this fixture's recorded children after a failed cleanup assertion."""
    for pid in pids:
        try:
            stopped(pid)
        except AssertionError:
            subprocess.run(['taskkill.exe', '/PID', str(pid), '/T', '/F'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)


def workbook(path):
    ns = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'
    files = {
        '[Content_Types].xml': '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/></Types>',
        '_rels/.rels': '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>',
        'xl/workbook.xml': '<workbook xmlns="' + ns + '" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="Intake" sheetId="1" r:id="rId1"/></sheets></workbook>',
        'xl/_rels/workbook.xml.rels': '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>',
        'xl/worksheets/sheet1.xml': '<worksheet xmlns="' + ns + '"><dimension ref="A1:A2"/><sheetData><row r="1"><c r="A1" t="inlineStr"><is><t>Body</t></is></c></row><row r="2"><c r="A2" t="inlineStr"><is><t>漢字 evidence 5</t></is></c></row></sheetData></worksheet>',
    }
    with zipfile.ZipFile(path, 'w') as archive:
        for name, body in files.items():
            archive.writestr(name, body.encode('utf-8'))


def run_case(binary, folder, environment, *arguments, payload=None, code=0):
    result = subprocess.run([str(binary), *map(str, arguments)], input=payload, cwd=folder,
        env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    assert result.returncode == code, (arguments, result.returncode, result.stdout, result.stderr)
    return result


@contextmanager
def answer_backend(probability=None):
    """Serve measured local asks; neither installed case needs a paid provider."""
    requests = []
    class Backend(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
            requests.append(body)
            answers = {name: {'type': 'noul', 'noul': 0.9 if probability is None else probability(question)}
                       for name, question in body['questions'].items()}
            reply = json.dumps({'answers': answers, 'usage': {'input_tokens': 7, 'output_tokens': 1}}).encode()
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(reply)))
            self.end_headers()
            self.wfile.write(reply)
        def log_message(self, *_):
            pass
    with http.server.ThreadingHTTPServer(('127.0.0.1', 0), Backend) as server:
        worker = threading.Thread(target=server.serve_forever)
        worker.start()
        try:
            yield SimpleNamespace(url=f'http://127.0.0.1:{server.server_address[1]}/v1', requests=requests)
        finally:
            server.shutdown()
            worker.join()


def private_response_state(path, environment):
    """Inspect the actual journal; DLL cache privacy is a different claim."""
    from release_windows_cache import _control, STATE_FUNCTION
    measured = json.loads(_control(environment, STATE_FUNCTION + """$a = Get-Acl -LiteralPath $env:TT_CACHE_PATH;
$caller = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value;
$other = @($a.Access | Where-Object {
  $_.AccessControlType -ne 'Allow' -or
  $_.IdentityReference.Translate([System.Security.Principal.SecurityIdentifier]).Value -ne $caller
});
[pscustomobject]@{state=(Get-CacheState); caller=$caller;
  private=($a.Access.Count -gt 0 -and $other.Count -eq 0)} | ConvertTo-Json -Depth 3 -Compress""", path))
    assert measured['state']['owner'] == measured['caller'], (path, measured)
    assert measured['private'], (path, measured)
    return measured['state']


def access_environment(folder, environment):
    """PowerShell's private profile lives outside the checked operation folder."""
    from release_windows_cache import cache_environment
    profile = folder.with_name(folder.name + '-profile')
    (profile / 'roaming').mkdir(parents=True)
    return cache_environment(profile / 'local', dict(environment, HOME=str(profile),
        USERPROFILE=str(profile), APPDATA=str(profile / 'roaming')))


def recovery_probability(question):
    """Discriminate the actual quoted record text, never the shared wire state."""
    return {'The text is "first". Ready?': 0.9,
            'The text is "second". Ready?': 0.1}[question['instructions']]


def recovery(binary, folder, environment):
    """Interrupt blocked publication, then export the installed command's typed answers."""
    environment = access_environment(folder, environment)
    source = folder / 'records.jsonl'
    original = (json.dumps({'id': 7, 'text': 'first', 'padding': 'x' * (4 * 1024 * 1024)}) + '\n'
                + json.dumps({'id': 7, 'text': 'second'}) + '\n').encode()
    source.write_bytes(original)
    journal = folder / 'completed.recovery'
    with answer_backend(recovery_probability) as backend:
        child = subprocess.Popen([str(binary), 'decide', 'Ready?', '--backend', 'systemone',
            '--url', backend.url, '--from', 'jsonl', str(source), '--field', '/text', '--into', 'ready',
            '--batch', '1', '--recovery', str(journal)], cwd=folder,
            env=dict(environment, THINKTHEN_API_KEY='synthetic-loopback-key'),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
        try:
            # The first enriched row exceeds the pipe buffer. Publication has begun,
            # both final rows are journaled, and stopping reads holds completion.
            assert read_line(SimpleNamespace(readline=lambda: child.stdout.read(1)), timeout=30) == b'{'
            assert child.poll() is None, 'large output did not hold publication'
            child.send_signal(signal.CTRL_BREAK_EVENT)
            notice = read_line(child.stderr, timeout=30)
            assert b'cancelling' in notice, notice
            stdout, stderr = child.communicate(timeout=30)
            assert child.returncode == 130, (child.returncode, stdout[:200], notice + stderr)
            assert len(backend.requests) == 2
            assert source.read_bytes() == original, 'interrupted enrichment changed the source'
            private_response_state(journal, environment)
            offline = {key: value for key, value in environment.items()
                       if key.upper() not in {'THINKTHEN_API_KEY', 'OPENAI_API_KEY'}}
            offline.update(THINKTHEN_BACKEND='invalid-offline-trap', THINKTHEN_MAX_REQUESTS='invalid-offline-trap')
            exported = run_case(binary, folder, offline, 'recover', journal)
            rows = [json.loads(line) for line in exported.stdout.splitlines()]
            assert len(rows) == 2 and [row['position'] for row in rows] == [1, 2], rows
            assert [row['id'] for row in rows] == [7, 7], rows
            assert all(row['status'] == 'answered' for row in rows), rows
            assert [row['answer'] for row in rows] == [True, False], rows
            report = json.loads(exported.stderr)
            assert report['type'] == 'recovery' and report['admitted'] == report['committed'] == 2, report
            assert report['complete'] is False and report['operation_status'] == 'incomplete', report
            assert report['missing_ranges'] == [], report
            assert len(backend.requests) == 2, 'offline recovery made a backend request'
            assert source.read_bytes() == original
            assert {path.name for path in folder.iterdir()} == {'records.jsonl', 'completed.recovery'}
        finally:
            if child.poll() is None:
                child.kill()
                child.wait()


def pipeline(binary, folder, environment):
    pids = folder / 'children.json'
    first = 'import json,os,subprocess,sys,threading; child=subprocess.Popen([sys.executable,"-c","import threading;threading.Event().wait()"]);open(sys.argv[1],"w").write(json.dumps([os.getpid(),child.pid]));print(json.dumps("record"),flush=True);threading.Event().wait()'
    second = 'import sys;sys.stdin.readline();sys.exit(27)'
    entry = folder / 'run.json'
    entry.write_text(json.dumps({'run': [{'shell': [sys.executable, '-c', first, str(pids)]},
                                        {'shell': [sys.executable, '-c', second]}]}), encoding='utf-8')
    try:
        run_case(binary, folder, environment, 'run', '--allow-shell', entry, '--backend', 'stub', code=27)
        for pid in json.loads(pids.read_text(encoding='utf-8')):
            stopped(pid)
        assert {p.name for p in folder.iterdir()} == {'run.json', 'children.json'}
    finally:
        if pids.exists():
            reap(json.loads(pids.read_text(encoding='utf-8')))


def spreadsheet(binary, folder, environment):
    source = folder / 'book.xlsx'
    workbook(source)
    run_case(binary, folder, environment, 'decide', 'Ready?', '--backend', 'stub', '--from',
             'xlsx', source, '--sheet', 'Intake', '--column', 'Body', '--into', 'ready')
    destination = folder / 'book.thinkthen.xlsx'
    with zipfile.ZipFile(destination) as archive:
        sheet = ET.fromstring(archive.read('xl/worksheets/sheet1.xml'))
        cells = {cell.attrib['r']: cell for cell in sheet.iter() if cell.tag.endswith('}c')}
        assert ''.join(cells['A2'].itertext()) == '漢字 evidence 5'
        assert cells['B2'].attrib.get('t') == 'b' and ''.join(cells['B2'].itertext()) == '1'
    assert {p.name for p in folder.iterdir()} == {'book.xlsx', 'book.thinkthen.xlsx'}


def powershell(binary, folder, environment, *, shell='powershell.exe', diagnostics=None, console=None):
    diagnostics = diagnostics or ROOT / 'target/windows-cli-diagnostics'
    diagnostics.mkdir(parents=True, exist_ok=True)
    saved = Path(tempfile.mkdtemp(prefix='powershell-unicode-', dir=diagnostics))
    (saved / 'console.json').write_text(json.dumps(console), encoding='utf-8')
    from release_windows_cache import cache_environment
    profile = saved / 'profile'
    for name in ('home', 'roaming'):
        (profile / name).mkdir(parents=True)
    environment = cache_environment(profile / 'local', dict(environment,
        HOME=str(profile / 'home'), USERPROFILE=str(profile / 'home'), APPDATA=str(profile / 'roaming')))
    metadata = str(saved / 'environment.json').replace("'", "''")
    script = folder / 'unicode.ps1'
    script.write_text('$ErrorActionPreference="Stop"\n'
        + '$observed=[ordered]@{shell_version=$PSVersionTable.PSVersion.ToString(); '
        + 'initial_input_code_page=[Console]::InputEncoding.CodePage; '
        + 'initial_output_code_page=[Console]::OutputEncoding.CodePage; '
        + 'initial_pipeline_code_page=$OutputEncoding.CodePage}\n'
        + utf8_setting() + '\n'
        + '$observed.input_code_page=[Console]::InputEncoding.CodePage\n'
        + '$observed.output_code_page=[Console]::OutputEncoding.CodePage\n'
        + '$observed.pipeline_code_page=$OutputEncoding.CodePage\n'
        + "[IO.File]::WriteAllText('" + metadata + "', ($observed | ConvertTo-Json), [Text.UTF8Encoding]::new($false))\n"
        + "'Body', '" + TEXT + "' | & '" + str(binary).replace("'", "''")
        + "' decide 'Ready?' --backend stub --from csv - --column Body --into ready\nexit $LASTEXITCODE\n",
        encoding='utf-8-sig')
    stdout, stderr, rows = b'', b'', None
    try:
        result = subprocess.run([shell, '-NoProfile', '-NonInteractive', '-File', str(script)],
            cwd=folder, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
        stdout, stderr = result.stdout, result.stderr
        assert result.returncode == 0, f'PowerShell exit: expected 0, actual {result.returncode!r}'
        try:
            rows = list(csv.DictReader(io.StringIO(stdout.decode('utf-8-sig'))))
        except UnicodeDecodeError as error:
            raise AssertionError(f'PowerShell stdout encoding: expected UTF-8, actual {stdout!r}') from error
        assert len(rows) == 1, f'PowerShell row count: expected 1, actual {len(rows)!r}'
        actual = rows[0].get('Body')
        assert actual == TEXT, f'PowerShell Body: expected {TEXT!r}, actual {actual!r}'
        actual = rows[0].get('ready')
        assert actual == 'TRUE', f'PowerShell ready: expected {"TRUE"!r}, actual {actual!r}'
        files = sorted(p.name for p in folder.iterdir())
        assert files == ['unicode.ps1'], f'PowerShell files: expected {["unicode.ps1"]!r}, actual {files!r}'
    except Exception as error:
        if isinstance(error, subprocess.TimeoutExpired):
            stdout, stderr = error.stdout or b'', error.stderr or b''
        if rows is None:
            try:
                rows = list(csv.DictReader(io.StringIO(stdout.decode('utf-8-sig'))))
            except UnicodeDecodeError:
                rows = None  # The raw bytes and original failure are retained below.
        files = sorted(p.name for p in folder.iterdir())
        detail = dict(error=str(error), shell=str(shell), stdout_hex=stdout.hex(),
                      stderr_hex=stderr.hex(), rows=rows, files=files, evidence=str(saved),
                      tree=sorted(p.relative_to(folder).as_posix() for p in folder.rglob('*')))
        (saved / 'failure.json').write_text(json.dumps(detail, ensure_ascii=True), encoding='utf-8')
        raise AssertionError(json.dumps(detail, ensure_ascii=True)) from error
    finally:
        (saved / 'stdout.bin').write_bytes(stdout)
        (saved / 'stderr.bin').write_bytes(stderr)
        (saved / 'rows.json').write_text(json.dumps(rows, ensure_ascii=True), encoding='utf-8')
        (saved / 'files.json').write_text(json.dumps(sorted(p.name for p in folder.iterdir())), encoding='utf-8')
        (saved / 'tree.json').write_text(json.dumps(sorted(p.relative_to(folder).as_posix()
            for p in folder.rglob('*'))), encoding='utf-8')
        print('PowerShell evidence: ' + str(saved), flush=True)
        if (saved / 'environment.json').exists():
            try:
                observed = (saved / 'environment.json').read_text(encoding='utf-8')
            except (OSError, UnicodeError) as error:
                observed = 'retained metadata could not be decoded: ' + str(error)
            print('PowerShell environment: ' + observed, flush=True)


def default_pipes(binary, folder, environment):
    """Measure what the backend receives and PowerShell reads back with and without the setting."""
    received = []
    class Backend(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            body = self.rfile.read(int(self.headers['Content-Length']))
            received.append(body)
            answers = {name: {'type': 'noul', 'noul': 0.9} for name in json.loads(body)['questions']}
            reply = json.dumps({'answers': answers}).encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(reply)))
            self.end_headers()
            self.wfile.write(reply)
        def log_message(self, *_):
            pass
    modes = {'default': '', 'input-only': '$OutputEncoding=[Text.UTF8Encoding]::new($false)', 'documented': utf8_setting()}
    results = {}
    environment = dict(environment, THINKTHEN_API_KEY='synthetic-loopback-key')
    with http.server.ThreadingHTTPServer(('127.0.0.1', 0), Backend) as server:
        worker = threading.Thread(target=server.serve_forever)
        worker.start()
        try:
            for mode, setting in modes.items():
                metadata = folder / (mode + '.json')
                script = folder / (mode + '.ps1')
                script.write_text('$ErrorActionPreference="Stop"\n' + setting + '\n'
                    + '$observed=[ordered]@{shell_version=$PSVersionTable.PSVersion.ToString(); '
                    + 'output_code_page=[Console]::OutputEncoding.CodePage; pipeline_code_page=$OutputEncoding.CodePage}\n'
                    + "$answer='Body', '" + TEXT + "' | & '" + str(binary).replace("'", "''")
                    + f"' decide 'Ready?' --url http://127.0.0.1:{server.server_address[1]}/v1 --from csv - --column Body --into ready\n"
                    + '$observed.exit=$LASTEXITCODE\n$observed.read_back=$answer -join "`n"\n'
                    + "[IO.File]::WriteAllText('" + str(metadata).replace("'", "''")
                    + "', ($observed | ConvertTo-Json), [Text.UTF8Encoding]::new($false))\n", encoding='utf-8-sig')
                received.clear()
                result = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', str(script)],
                    cwd=folder, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
                assert result.returncode == 0 and metadata.exists(), (mode, result.returncode, result.stdout, result.stderr)
                observed = json.loads(metadata.read_text(encoding='utf-8'))
                assert len(received) == 1, f'{mode} backend requests: expected 1, actual {len(received)}'
                sent = re.search(rb'[^"]*evidence 5', received[0])
                assert sent, f'{mode} backend body holds no message: {received[0]!r}'
                results[mode] = dict(observed, backend_bytes=sent.group().hex())
                print('PowerShell pipes: ' + json.dumps(dict(mode=mode, backend_text=sent.group().decode('utf-8', 'replace'),
                    **results[mode]), ensure_ascii=True), flush=True)
        finally:
            server.shutdown()
            worker.join()
    for mode, measured in results.items():
        assert measured['shell_version'].startswith('5.1.'), f'{mode} shell: expected 5.1, actual {measured["shell_version"]}'
        assert measured['exit'] == 0, f'{mode} exit: expected 0, actual {measured["exit"]}'
    def backend(mode, text):
        actual = bytes.fromhex(results[mode]['backend_bytes'])
        assert actual.endswith(text.encode('utf-8')), f'{mode} backend: expected {text!r}, actual {actual!r}'
    backend('default', '?? caf? evidence 5')
    backend('input-only', TEXT)
    backend('documented', TEXT)
    table = f'Body,ready\n{TEXT},TRUE'
    actual = results['documented']['read_back']
    assert actual == table, f'documented read back: expected {table!r}, actual {actual!r}'
    actual = results['input-only']
    if actual['output_code_page'] != 65001:
        assert actual['read_back'] != table, 'the setting\'s output half changed nothing: read back already matched'


def private_console(kernel):
    """Ctrl-C reaches a whole console, so give it one that holds only this check."""
    kernel.FreeConsole()
    if not kernel.AllocConsole():
        raise ctypes.WinError(ctypes.get_last_error())
    # A parent that started this process in a new group left Ctrl-C ignored, and children inherit that.
    if not kernel.SetConsoleCtrlHandler(None, False):
        raise ctypes.WinError(ctypes.get_last_error())


def ctrl_c(binary, folder, environment):
    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
    kernel.SetConsoleCtrlHandler.argtypes = [ctypes.c_void_p, wintypes.BOOL]
    private_console(kernel)
    # A new console drops this process's earlier handlers, and Ctrl-C would end the check itself.
    survive = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.DWORD)(lambda _event: True)
    if not kernel.SetConsoleCtrlHandler(survive, True):
        raise ctypes.WinError(ctypes.get_last_error())
    def send(_child):
        if not kernel.GenerateConsoleCtrlEvent(signal.CTRL_C_EVENT, 0):
            raise ctypes.WinError(ctypes.get_last_error())
    try:
        interrupt(binary, folder, environment, creationflags=0, send=send)
    finally:
        kernel.SetConsoleCtrlHandler(survive, False)
        kernel.FreeConsole()
        # The cases after this one need a console as well.
        if not kernel.AttachConsole(ctypes.c_ulong(-1).value) and not kernel.AllocConsole():
            raise ctypes.WinError(ctypes.get_last_error())


def stream(binary, folder, environment):
    """Rows reach a pipe while input stays open, and an interrupt then ends the call."""
    child = subprocess.Popen([str(binary), 'decide', 'Ready?', '--backend', 'stub', '--from', 'lines', '--json',
        '--batch', '1'], cwd=folder, env=environment, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
    try:
        child.stdin.write(b'one\n')
        child.stdin.flush()
        row = json.loads(read_line(child.stdout, timeout=30))
        assert row['position'] == 1 and row['status'] == 'answered', row
        child.send_signal(signal.CTRL_BREAK_EVENT)
        assert child.wait(timeout=30) == 130, child.returncode
        stdout, stderr = child.communicate(timeout=30)
        assert not stdout and not list(folder.iterdir()), (stdout, list(folder.iterdir()))
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()


def forced_exit(binary, folder, environment, *, diagnostics=None):
    """A first interrupt asks and a second forces: exit 130 with every owned process gone."""
    held = 'import signal,threading;signal.signal(signal.SIGBREAK,signal.SIG_IGN);threading.Event().wait()'
    # The console interrupt reaches these steps too. Ignoring it leaves only the command to stop them.
    step = ('import os,signal,subprocess,sys,threading;signal.signal(signal.SIGBREAK,signal.SIG_IGN);'
            'child=subprocess.Popen([sys.executable,"-c",sys.argv[2]]);'
            'print(os.getpid(),child.pid,file=sys.stderr,flush=True);'
            'sys.stdout.buffer.write(open(sys.argv[1],"rb").read());sys.stdout.buffer.flush();threading.Event().wait()')
    payload = folder / 'payload.jsonl'
    # One row larger than a pipe holds the command in its output write while this check stops reading.
    payload.write_text(json.dumps('a' * (4 * 1024 * 1024)) + '\n', encoding='utf-8')
    entry = folder / 'run.json'
    shell = {'shell': [sys.executable, '-c', step, str(payload), held]}
    entry.write_text(json.dumps({'run': [shell, shell]}), encoding='utf-8')
    child = subprocess.Popen([str(binary), 'run', '--allow-shell', str(entry), '--backend', 'stub'], cwd=folder,
        env=environment, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
    pids = []
    try:
        for _ in range(2):
            pids.extend(map(int, read_line(child.stderr, timeout=60).split()))
        assert read_line(SimpleNamespace(readline=lambda: child.stdout.read(1)), timeout=60) == b'"'
        child.send_signal(signal.CTRL_BREAK_EVENT)
        notice = read_line(child.stderr, timeout=30).strip()
        assert notice == b'thinkthen: cancelling; press Ctrl-C again to exit', notice
        assert child.poll() is None, 'the first interrupt ended the command'
        child.send_signal(signal.CTRL_BREAK_EVENT)
        try:
            assert child.wait(timeout=30) == 130, child.returncode
        except subprocess.TimeoutExpired:
            if diagnostics is not None:
                forced_exit_snapshot(child.pid, pids, diagnostics)
            raise
        for pid in pids:
            stopped(pid)
        assert {p.name for p in folder.iterdir()} == {'run.json', 'payload.jsonl'}
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
        reap(pids)



def forced_exit_snapshot(pid, owned, folder):
    """Capture only this fixture's processes before failure cleanup kills them."""
    folder.mkdir(parents=True, exist_ok=True)
    (folder / 'forced-exit-pids.json').write_text(json.dumps(dict(cli=pid, owned=owned)) + '\n')
    script = "Get-Process -Id " + ','.join(map(str, [pid, *owned])) + " -ErrorAction SilentlyContinue | ForEach-Object { @{pid=$_.Id; name=$_.ProcessName; threads=@($_.Threads | ForEach-Object { @{id=$_.Id; state=[string]$_.ThreadState; wait=$(if($_.ThreadState -eq 'Wait'){[string]$_.WaitReason}else{$null})} })} } | ConvertTo-Json -Depth 5"
    try:
        snapshot = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-Command', script],
                                  capture_output=True, timeout=15)
        (folder / 'forced-exit-processes.json').write_bytes(snapshot.stdout)
        (folder / 'forced-exit-snapshot.stderr').write_bytes(snapshot.stderr)
    except (OSError, subprocess.SubprocessError) as error:
        (folder / 'forced-exit-snapshot.stderr').write_text(str(error) + '\n')
    faulthandler.dump_traceback(file=sys.stderr)


def interrupt(binary, folder, environment, *, creationflags=None,
              send=lambda child: child.send_signal(signal.CTRL_BREAK_EVENT)):
    if creationflags is None:
        creationflags = subprocess.CREATE_NEW_PROCESS_GROUP
    arrived, closed = threading.Event(), threading.Event()
    requests = []
    class Held(socketserver.BaseRequestHandler):
        def handle(self):
            try:
                stream = self.request.makefile('rb')
                first = stream.readline()
                if not first:
                    return
                length = 0
                while line := stream.readline():
                    if line in (b'\r\n', b'\n'):
                        break
                    if line.lower().startswith(b'content-length:'):
                        length = int(line.split(b':', 1)[1])
                stream.read(length)
                requests.append(first)
                arrived.set()
                assert self.request.recv(1) == b'', 'cancelled request received another byte'
                closed.set()
            except ConnectionResetError:
                closed.set()
    class Server(socketserver.ThreadingTCPServer):
        daemon_threads = True
    with Server(('127.0.0.1', 0), Held) as server:
        worker = threading.Thread(target=server.serve_forever)
        worker.start()
        child = subprocess.Popen([str(binary), 'decide', 'Ready?', '--from', 'lines', '--json',
            '--batch', '1', '--url', f'http://127.0.0.1:{server.server_address[1]}/v1'], cwd=folder,
            env=dict(environment, THINKTHEN_API_KEY='synthetic-loopback-key'), stdin=subprocess.PIPE,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=creationflags)
        try:
            child.stdin.write(b'one\n')
            child.stdin.close()
            child.stdin = None
            assert arrived.wait(30), 'CLI did not send its request'
            started = time.monotonic()
            send(child)
            assert closed.wait(2), 'the interrupt did not close the held socket within two seconds'
            stdout, stderr = child.communicate(timeout=30)
            assert child.returncode == 130, (child.returncode, stdout, stderr)
            assert time.monotonic() - started < 30 and not stdout
            assert len(requests) == 1, 'request count grew after cancel'
            assert not list(folder.iterdir()), 'cancel left temporary files'
        finally:
            if child.poll() is None:
                child.kill()
                child.wait()
            server.shutdown()
            worker.join()


def watchdog(name, *, child=False, deadline=None):
    """End a hung case by name, with its stacks, and stop the processes it started."""
    def expired():
        try:
            print(f'Windows CLI: {name}: FAIL: no result within {CASE_SECONDS} seconds', flush=True)
            faulthandler.dump_traceback()
            subprocess.run(['taskkill', '/T', '/F', '/PID', str(os.getpid())], capture_output=True, timeout=30)
        finally:
            os._exit(1)
    # The outer owner still kills at CASE_SECONDS. Its caller-owned child
    # writes its stack first, while its persistent log remains available.
    diagnostic = threading.Timer(max(0, deadline - time.monotonic() - 10), faulthandler.dump_traceback) if child else None
    if diagnostic:
        diagnostic.daemon = True
        diagnostic.start()
    timer = None if child else threading.Timer(CASE_SECONDS, expired)
    if timer:
        timer.daemon = True
        timer.start()
    return timer, diagnostic


CASES = [('saved-run', pipeline, False), ('xlsx', spreadsheet, False),
         ('powershell-unicode', powershell, False), ('powershell-default', default_pipes, False),
         ('ctrl-break', interrupt, False), ('ctrl-c', ctrl_c, False), ('stream', stream, False),
         ('forced-exit', forced_exit, False), ('recovery', recovery, True)]
CALLER_CASES = tuple(name for name, _case, caller_owned in CASES if caller_owned)



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path, required=True)
    parser.add_argument('--case', choices=[name for name, _case, _caller in CASES])
    parser.add_argument('--deadline', type=float, help=argparse.SUPPRESS)
    parser.add_argument('--caller-owned', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--diagnostics', type=Path, help='retain forced-exit process state before failure cleanup')
    parser.add_argument('--powershell', default='powershell.exe', help='PowerShell executable for the Unicode case')
    parser.add_argument('--code-page', type=int, help='Select a console code page for an explicitly labelled probe')
    args = parser.parse_args()
    if os.name != 'nt':
        parser.error('Windows CLI checks require native Windows')
    if args.caller_owned and args.deadline is None:
        parser.error('caller-owned cases require the outer deadline')
    binary = args.binary.resolve(strict=True)
    print('Windows CLI binary: ' + str(binary) + ' sha256=' + hashlib.sha256(binary.read_bytes()).hexdigest(), flush=True)
    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
    allocated = not kernel.GetConsoleCP()
    if allocated and not kernel.AllocConsole():
        raise ctypes.WinError(ctypes.get_last_error())
    console = dict(initial_input_code_page=kernel.GetConsoleCP(),
                   initial_output_code_page=kernel.GetConsoleOutputCP(), selected_code_page=args.code_page)
    failures = []
    try:
        if args.code_page is not None:
            if not kernel.SetConsoleCP(args.code_page) or not kernel.SetConsoleOutputCP(args.code_page):
                raise ctypes.WinError(ctypes.get_last_error())
        print('Windows CLI console: ' + json.dumps(console), flush=True)
        with tempfile.TemporaryDirectory(prefix='thinkthen-windows-cli-') as temporary:
            for name, case, caller_owned in CASES:
                if args.case and name != args.case:
                    continue
                # A console event can end this process, so the log names the case first.
                print('Windows CLI: ' + name + ': START', flush=True)
                folder = Path(temporary) / name
                folder.mkdir()
                environment = {key: value for key, value in os.environ.items() if not key.startswith('THINKTHEN_')}
                environment.update(HOME=str(folder), USERPROFILE=str(folder), TMP=str(folder), TEMP=str(folder), PYTHONUTF8='1')
                deadline = args.deadline if args.caller_owned else time.monotonic() + CASE_SECONDS
                timers = watchdog(name, child=args.caller_owned, deadline=deadline)
                try:
                    if caller_owned and not args.caller_owned:
                        # Preserve elevated privileges for hostile owner controls, but
                        # create store/journal objects with an ordinary caller owner.
                        from windows_caller_process import launch
                        try:
                            launch([sys.executable, str(Path(__file__).resolve()), '--caller-owned',
                                    '--binary', str(binary), '--case', name, '--deadline', str(deadline),
                                    *(['--diagnostics', str(args.diagnostics.resolve())] if args.diagnostics else [])], cwd=ROOT,
                                   env=environment, timeout=None,
                                   log_path=args.diagnostics / (name + '-child.log') if args.diagnostics else None)
                        except SystemExit as error:
                            raise RuntimeError(f'caller-owned {name} failed with exit {error.code}') from error
                    elif name == 'forced-exit':
                        forced_exit(binary, folder, environment, diagnostics=args.diagnostics)
                    elif name == 'powershell-unicode':
                        powershell(binary, folder, environment, shell=args.powershell, console=console)
                    else:
                        case(binary, folder, environment)
                    print('Windows CLI: ' + name + ': PASS', flush=True)
                except Exception as error:
                    failures.append(name)
                    print('Windows CLI: ' + name + ': FAIL: ' + str(error), flush=True)
                    logging.exception('Windows CLI case %s failed', name)
                finally:
                    for timer in timers:
                        if timer:
                            timer.cancel()
        if failures:
            sys.exit('Windows CLI failures: ' + ', '.join(failures))
    finally:
        kernel.SetConsoleCP(console['initial_input_code_page'])
        kernel.SetConsoleOutputCP(console['initial_output_code_page'])
        if allocated:
            kernel.FreeConsole()


if __name__ == '__main__':
    main()
