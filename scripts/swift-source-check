#!/bin/sh
# Build one development engine from this source and run the installed Swift consumer.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
scripts/swift-interface-check
cargo build --locked -p thinkthen-ffi -p loopback --lib --bin loopback
build_target=${CARGO_TARGET_DIR:-$PWD/target}
case "$build_target" in /*) ;; *) build_target="$PWD/$build_target" ;; esac
if [ "${1:-}" = --interface-only ]; then
    export THINKTHEN_NATIVE_LIBRARY="$build_target/debug/$([ "$(uname -s)" = Darwin ] && echo libthinkthen_ffi.dylib || echo libthinkthen_ffi.so)"
    if [ -n "${2:-}" ]; then
        scripts/swift-interface-check --against "$2" --native
    else
        scripts/swift-interface-check --native
    fi
    exit
fi
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
host=$(python3 scripts/native_platform.py rid)
mkdir -p "$scratch/$host"
case "$(uname -s)" in
    Darwin) library=libthinkthen_ffi.dylib ;;
    Linux) library=libthinkthen_ffi.so ;;
esac
cp "$build_target/debug/$library" "$scratch/$host/"
if [ -z "${THINKTHEN_NATIVE_FIXTURES:-}" ]; then
    scripts/native-fixtures --engine "$build_target/debug/$library" --output "$scratch/abi"
    THINKTHEN_NATIVE_FIXTURES="$scratch/abi"
    export THINKTHEN_NATIVE_FIXTURES
fi
export THINKTHEN_SWIFT_NATIVE_ASSETS="$scratch"
export THINKTHEN_LOOPBACK="$build_target/debug/loopback"
# Exercise the installed package's own loader, not the source library override.
unset THINKTHEN_NATIVE_LIBRARY
scripts/swift-gate
