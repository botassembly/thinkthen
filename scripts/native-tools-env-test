#!/usr/bin/env python3
"""Check the sourced and command interfaces without compiling an SDK."""
import os
from pathlib import Path
import shutil
import subprocess

os.chdir(Path(__file__).resolve().parent.parent)
environment = dict(os.environ, PM_JOB_CORES='3.5', RUSTC_WRAPPER='unused',
                   RUSTC_WORKSPACE_WRAPPER='unused')


def run(arguments):
    try:
        return subprocess.run(arguments, env=environment, text=True, capture_output=True)
    except PermissionError:
        return subprocess.CompletedProcess(arguments, 126, '', 'permission denied')


def sourced_exports():
    result = run(['sh', '-eu', '-c', '. scripts/native-tools-env; '
                  'test "$PYTHONDONTWRITEBYTECODE" = 1; '
                  'test "$CARGO_BUILD_JOBS:$RUST_TEST_THREADS" = 3:3; '
                  'test -z "$RUSTC_WRAPPER$RUSTC_WORKSPACE_WRAPPER"; '
                  'test -n "$JAVA_HOME"; test -n "$THINKTHEN_RUNTIME_PREFIX"; '
                  'test "$1" = retained; printf sourced', 'caller', 'retained'])
    assert result.returncode == 0 and result.stdout == 'sourced', result
    caller = run(['scripts/command-check', 'sh', '-c', 'printf "%s" "$PYTHONDONTWRITEBYTECODE"'])
    assert caller.returncode == 0 and caller.stdout == '1', caller
    if shutil.which('zsh'):
        result = run(['zsh', '-c', 'setopt nonomatch; . scripts/native-tools-env; print -rn -- kept'])
        assert result.stdout == 'kept', result


def command_execution():
    for prefix in ([], ['sh']):
        result = run([*prefix, 'scripts/native-tools-env', 'sh', '-eu', '-c',
                      'printf "%s:%s" "$PYTHONDONTWRITEBYTECODE" "$1"',
                      'child', 'argument with spaces'])
        assert result.returncode == 0 and result.stdout == '1:argument with spaces', result
        empty = run([*prefix, 'scripts/native-tools-env'])
        assert empty.returncode != 0 and 'usage:' in empty.stderr.lower(), empty


def failing_command_status():
    for prefix in ([], ['sh']):
        result = run([*prefix, 'scripts/native-tools-env', 'sh', '-c', 'exit 37'])
        assert result.returncode == 37, result


failures = []
for check in (sourced_exports, command_execution, failing_command_status):
    try:
        check()
        print(f'PASS {check.__name__}', flush=True)
    except AssertionError as error:
        failures.append(check.__name__)
        print(f'FAIL {check.__name__}: {error}', flush=True)
raise SystemExit(bool(failures))
