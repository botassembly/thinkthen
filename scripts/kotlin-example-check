#!/usr/bin/env python3
"""Run the ideal Kotlin guide using the JVM gate’s prepared runtime and compiler."""
import os
import sys
from guide_kotlin import run_kotlin

classpath, repository, home = sys.argv[1:4]
os.environ['THINKTHEN_KOTLIN_REPOSITORY'] = repository
run_kotlin(classpath, host_only=sys.argv[4:] == ['--host-only'])
