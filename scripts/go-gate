#!/bin/sh
# Compile and test an external consumer of a locally staged native Go module.
set -eu
cd "$(dirname "$0")/.."
export GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=1
test -z "$(gofmt -l sdk/go/*.go sdk/go/tests/*.go)"
profile=release
if [ -n "${THINKTHEN_COVERAGE_ROOT:-}" ]; then
  # Keep this host asset in the debug object set read by cargo-llvm-cov.
  profile=debug
  cargo build --locked -p thinkthen-ffi
else
  cargo build --locked --release -p thinkthen-ffi
fi
cargo build --locked -p loopback
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
mkdir -p "$scratch/home" "$scratch/tmp"
export HOME="$scratch/home" TMPDIR="$scratch/tmp"
root=$PWD
build_target=${CARGO_TARGET_DIR:-$root/target}
case "$build_target" in /*) ;; *) build_target="$root/$build_target" ;; esac
export THINKTHEN_LOOPBACK="$build_target/debug/loopback" THINKTHEN_CASES="$root/conformance" THINKTHEN_STUB_CASES="$root/construction/stub.json"
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH
export THINKTHEN_API_KEY=construction-only-key
scripts/go-package "$scratch/module" "$profile"
mkdir "$scratch/consumer"
cp sdk/go/tests/* "$scratch/consumer/"
cd "$scratch/consumer"
go mod edit -replace="github.com/botassembly/thinkthen/sdk/go=$scratch/module"
go test -race -count=1 -coverpkg=github.com/botassembly/thinkthen/sdk/go -coverprofile="$build_target/go-coverage.out" ./...

go test -c -o "$scratch/loader-consumer"
case "$(uname -s)" in
    Darwin) loader_cache="$HOME/Library/Caches" ;;
    *) loader_cache="$HOME/.cache" ;;
esac
python3 "$root/scripts/loader-cache-check" "$loader_cache" "$scratch/loader-consumer" -test.run='^TestSharedStub$'

# Compile and run the delivered README's entry example against this installed module.
mkdir "$scratch/consumer/readme"
python3 - "$scratch/module/README.md" "$scratch/consumer/readme/main.go" <<'PYTHON'
from pathlib import Path
import sys
Path(sys.argv[2]).write_text(Path(sys.argv[1]).read_text().split("```go\n", 1)[1].split("```", 1)[0])
PYTHON
go run ./readme
