#!/usr/bin/env python3
"""Prove the retained-artifact and bounded-process diagnostic without Wine or builds."""
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile
from unittest.mock import patch
import zipfile

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('wine_diagnostic', str(ROOT / 'scripts/wine-crash-diagnostic'))
spec = importlib.util.spec_from_loader(loader.name, loader)
diagnostic = importlib.util.module_from_spec(spec)
loader.exec_module(diagnostic)


def archive_fixture(path):
    case = {'client': {'backend': 'stub'}, 'requests': 0,
            'request': {'question': {'function': 'find', 'question': 'Which line?'}, 'records': ['é🦀']},
            'expected': [{'source': {'question_identity': 'a94cfeac612903a89e6f02f9bc714ab88dcb7a87a354731b3240058a07087609'}}]}
    contents = {'c-consumer.exe': b'retained consumer fixture', 'thinkthen_ffi.dll': b'retained DLL fixture',
                'stub.json': json.dumps([case]).encode(), 'native_cases.py': b'# retained comparison fixture',
                'contract.json': b'{}'}
    native = io.BytesIO()
    with zipfile.ZipFile(native, 'w') as package:
        package.writestr('bin/thinkthen_ffi.dll', contents['thinkthen_ffi.dll'])
    members = {'checks/' + name: value for name, value in contents.items() if name != 'thinkthen_ffi.dll'}
    members['c/thinkthen-c-0.2.0-windows-x86_64.zip'] = native.getvalue()
    compressed = io.BytesIO()
    with tarfile.open(fileobj=compressed, mode='w:gz') as package:
        for name, data in members.items():
            member = tarfile.TarInfo('0.2.0/windows-x86_64/' + name)
            member.size = len(data)
            package.addfile(member, io.BytesIO(data))
    with zipfile.ZipFile(path, 'w') as outer:
        outer.writestr('thinkthen-0.2.0-windows-x86_64-packages.tar.gz', compressed.getvalue())
    return case, {name: hashlib.sha256(data).hexdigest() for name, data in contents.items()}


with tempfile.TemporaryDirectory(prefix='wine-diagnostic-proof-') as temporary:
    scratch = Path(temporary)
    bad = scratch / 'wrong.zip'
    bad.write_bytes(b'not the retained artifact')
    result = subprocess.run([sys.executable, str(ROOT / 'scripts/wine-crash-diagnostic'),
                             str(bad), str(scratch / 'rejected')], capture_output=True, text=True)
    assert result.returncode == 1, result
    receipt = json.loads((scratch / 'rejected/result.json').read_text())
    assert receipt['disposition'] == 'capture-unavailable' and not receipt['release_cleared'], receipt
    assert 'checksum differs' in receipt['error'], receipt
    assert not (scratch / 'rejected/runtime.json').exists(), 'wrong artifact reached runtime'

    archive = scratch / 'fixture.zip'
    case, hashes = archive_fixture(archive)
    unpacked = scratch / 'inputs'
    unpacked.mkdir()
    # Synthetic identities exercise the same nested archive route; no production bypass exists.
    with patch.object(diagnostic, 'ZIP_SHA', diagnostic.digest(archive)), patch.object(diagnostic, 'INPUTS', hashes):
        assert diagnostic.inputs(archive, unpacked) == case
        assert diagnostic.digest(unpacked / 'thinkthen_ffi.dll') == hashes['thinkthen_ffi.dll']
        (unpacked / 'c-consumer.exe').write_bytes(b'changed')
        wrong = dict(hashes, **{'c-consumer.exe': '0' * 64})
        with patch.object(diagnostic, 'INPUTS', wrong):
            try:
                diagnostic.inputs(archive, unpacked)
            except ValueError as error:
                assert 'checksum differs' in str(error)
            else:
                raise AssertionError('wrong nested identity accepted')

    prefix_result = {'timed_out': False, 'returncode': 0,
                     'streams': {'stdout': {'truncated': True}, 'stderr': {'truncated': False}}}
    with patch.object(diagnostic, 'ZIP_SHA', diagnostic.digest(archive)), \
            patch.object(diagnostic, 'INPUTS', hashes), \
            patch.object(diagnostic.shutil, 'which', return_value='/fixture/wine'), \
            patch.object(diagnostic, 'runtime', return_value={}), \
            patch.object(diagnostic, 'capture', return_value=prefix_result) as captured:
        destination = scratch / 'prefix-truncated'
        assert diagnostic.main(archive, destination) == 1
        receipt = json.loads((destination / 'result.json').read_text())
        assert receipt['disposition'] == 'trace-truncated-unlocated', receipt
        assert not receipt['release_cleared'], receipt
        assert captured.call_count == 1, 'consumer ran after truncated prefix trace'
        assert captured.call_args.args[0][1:] == ['wineboot', '-u'], captured.call_args
        assert not (destination / 'find.stdout').exists()

    command = [sys.executable, '-c', 'import sys; sys.stdout.write("x"*131072); sys.stderr.write("y"*131072); sys.exit(7)']
    result = diagnostic.capture(command, dict(os.environ), scratch, scratch, 'bounded', seconds=10, limit=1024)
    assert result['returncode'] == 7 and not result['timed_out'], result
    for label in ('stdout', 'stderr'):
        assert result['streams'][label]['bytes'] == 131072, result
        assert result['streams'][label]['truncated'], result
        assert (scratch / ('bounded.' + label)).stat().st_size == 1024
    result = diagnostic.capture([sys.executable, '-c', 'import signal; signal.pause()'],
                                dict(os.environ), scratch, scratch, 'deadline', seconds=0.2, limit=1024)
    assert result['timed_out'] and result['group_cleanup_required'], result
    assert result['returncode'] != 0, result

parsed = subprocess.run(['ruby', '-ryaml', '-rjson', '-e',
                         'puts JSON.generate(YAML.load_file(ARGV.fetch(0)))',
                         str(ROOT / '.github/workflows/wine-crash-diagnostic.yml')],
                        capture_output=True, text=True, check=True)
workflow = json.loads(parsed.stdout)
assert workflow['true'] == {'workflow_dispatch': None}, workflow
assert workflow['permissions'] == {'contents': 'read', 'actions': 'read'}, workflow
assert workflow['defaults']['run']['shell'] == 'bash', workflow
job, = workflow['jobs'].values()
assert job['runs-on'] == 'ubuntu-24.04' and job['timeout-minutes'] == 10, job
assert job['if'] == "github.repository == 'botassembly/thinkthen'", job
steps = job['steps']
assert sum('GH_TOKEN' in step.get('env', {}) for step in steps) == 1
assert '13729574040/zip' in steps[1]['run'], steps[1]
assert not any('cargo' in step.get('run', '') for step in steps)
assert steps[-1]['if'] == 'always()'
assert 'wine-diagnostic/*.stderr' in steps[-1]['with']['path']
print('Wine diagnostic: wrong artifact refused, nested identities verified, both streams bounded, deadline kills owned group, manual read-only workflow verified')
