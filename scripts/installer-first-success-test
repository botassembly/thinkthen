#!/usr/bin/env python3
"""Refuse unverified first-success inputs before installing anything."""
import hashlib
import json
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix='installer-input-control-') as temporary:
    work = Path(temporary)
    binary = work / 'thinkthen'
    binary.write_text('#!/bin/sh\necho thinkthen 0.2.0\n')
    binary.chmod(0o755)
    cache = work / 'cache.json'
    cache.write_text('{}\n')
    provenance = work / 'inputs.json'
    output = work / 'output'
    command = ['python3', str(ROOT / 'scripts/installer-test'), '--first-success', str(output)]
    result = subprocess.run(command, capture_output=True, timeout=10)
    assert result.returncode == 2 and b'requires Linux' in result.stderr
    for invalid in ('binary', 'cache'):
        provenance.write_text(json.dumps({
            'linux_cli': {'source': '1' * 40, 'sha256': hashlib.sha256(binary.read_bytes()).hexdigest()
                          if invalid != 'binary' else '0' * 64},
            'cache': {'sha256': hashlib.sha256(cache.read_bytes()).hexdigest()
                      if invalid != 'cache' else '0' * 64},
        }))
        result = subprocess.run(command + ['--binary', str(binary), '--cache', str(cache),
                                          '--provenance', str(provenance)],
                                capture_output=True, timeout=10)
        assert result.returncode != 0 and b'hash differs' in result.stderr, result.stderr
        assert not output.exists(), 'unverified input produced installation/output side effects'
subprocess.run(['node', '--check', str(ROOT / 'scripts/installer-first-success.mjs')], check=True)
print('PASS: missing inputs and mismatched binary/cache refused before installation; recorder syntax valid')
