#!/bin/sh
# Share the system libraries required by static engine consumers.
set -eu
case "${1:-}" in
    '') separator=' ' ;;
    --cmake) separator=';' ;;
    *) echo 'usage: native-frameworks [--cmake]' >&2; exit 2 ;;
esac
prefix=
case "$(uname -s)" in
    Darwin)
        for framework in CoreFoundation Security SystemConfiguration; do
            printf '%s-framework %s' "$prefix" "$framework"
            prefix=$separator
        done
        ;;
    MINGW*|MSYS*)
        for library in ws2_32 advapi32 userenv bcrypt ntdll; do
            printf '%s-l%s' "$prefix" "$library"
            prefix=$separator
        done
        ;;
esac
printf '\n'
