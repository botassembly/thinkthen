#!/bin/sh
# Separate offline volume and soak run. Default output: test summary and resource peaks.
# Usage: scripts/stress [SAMPLES.jsonl]; run through pm job after landing.
#        scripts/stress --extended FOLDER: the Rust library's 60-round soak on each backend,
#        judged over rounds 41 to 60, with checkpoints in FOLDER/rust-BACKEND.jsonl.
# The 20-round soak reports memory and judges counts, as the 2026-11-08 amendment to
# sdlc/decisions/2026-10-26-soak-growth-needs-a-per-record-floor.md sets.
set -eu
cd "$(dirname "$0")/.."
export CARGO_NET_OFFLINE=true
cargo build --locked -p loopback --bin loopback
cargo test --locked -p thinkthen --test stress --no-run
if [ "${1:-}" = --extended ]; then
    folder=${2:?usage: scripts/stress --extended FOLDER}
    THINKTHEN_SOAK_ROUNDS=$(python3 -c 'import sys; sys.path.insert(0, "scripts"); from stress_resources import extended_size; print(extended_size()[0])')
    export THINKTHEN_SOAK_ROUNDS
    failed=
    for backend in systemone openai; do
        python3 scripts/stress-sample.py --extended --groups "rust/$backend" --output "$folder/rust-$backend.jsonl" -- \
            cargo test --locked -p thinkthen --test stress "rust_extended_soak_$backend" -- --ignored --exact --test-threads=1 \
            || failed="$failed $backend"
    done
    [ -z "$failed" ] || { echo "rust 60-round soak failed on:$failed" >&2; exit 1; }
    exit 0
fi
rounds=$(python3 -c 'import json; print(json.load(open("conformance/stress.json"))["records"]["soak_rounds"])')
exec python3 scripts/stress-sample.py --rounds "$rounds" --memory-report-only --groups rust/systemone,command/systemone,rust/openai,command/openai ${1:+--output "$1"} -- \
    cargo test --locked -p thinkthen --test stress loopback_stress_full_volume_and_soak -- --ignored --exact --test-threads=1
