#!/usr/bin/env python3
"""Check that a script importing tomllib reaches a new Python or stops on one clear line."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
UV_PYTHONS = Path.home() / '.local/share/uv/python'
PROBE = """import json, os, sys
with open(os.environ['PROBE_RUNS'], 'a') as runs:
    runs.write('run\\n')
import tomllib
print(json.dumps({'python': sys.version_info[:2], 'executable': sys.executable,
                  'arguments': sys.argv[1:], 'folder': os.getcwd(),
                  'tomllib': tomllib.__file__, 'parsed': tomllib.loads('a = 1'),
                  'java': os.environ.get('JAVA_HOME')}))
"""
ENVIRONMENT = dict(os.environ)
for name in ('PYTHONPATH', 'PYTHONHOME', 'THINKTHEN_RUNTIME_PREFIX', 'THINKTHEN_TOMLLIB_RESTARTED'):
    ENVIRONMENT.pop(name, None)


def is_old(python):
    answer = subprocess.run([python, '-c', 'import sys; print(sys.version_info < (3, 11))'],
                            capture_output=True, text=True)
    return answer.stdout.strip() == 'True'


def first_python(minor):
    found = sorted(UV_PYTHONS.glob(f'cpython-3.{minor}*/bin/python3'))
    return str(found[0]) if found else None


class Scratch:
    """A probe beside a link to the real file, so the real restart runs from the real root."""

    def __init__(self, folder):
        self.folder = Path(folder).resolve()
        self.probe = self.folder / 'probe'
        self.runs = self.folder / 'runs'
        self.working = self.folder / 'working folder'
        self.home = self.folder / 'home'
        self.working.mkdir()
        self.home.mkdir()
        self.probe.write_text(PROBE)
        (self.folder / 'tomllib.py').symlink_to(ROOT / 'scripts/tomllib.py')

    def run(self, *arguments, stdin=None, **environment):
        return subprocess.run(arguments, cwd=self.working, input=stdin, capture_output=True, text=True,
                              env={**ENVIRONMENT, 'PROBE_RUNS': str(self.runs), **environment}, timeout=300)

    def count(self):
        return len(self.runs.read_text().splitlines()) if self.runs.exists() else 0


def stopped_on_one_line(result):
    assert result.returncode != 0 and result.stdout == '', result
    lines = result.stderr.splitlines()
    assert len(lines) == 1, result
    assert 'has no tomllib' in lines[0] and 'scripts/native-tools-env' in lines[0], result


def new_python_gets_the_standard_library(scratch):
    python = sys.executable if not is_old(sys.executable) else first_python(13)
    if python is None:
        return 'no Python 3.11 or newer'
    expected = subprocess.run([python, '-I', '-c', 'import tomllib; print(tomllib.__file__)'],
                              capture_output=True, text=True, check=True).stdout.strip()
    result = scratch.run(python, scratch.probe)
    assert result.returncode == 0, result
    answer = json.loads(result.stdout)
    assert answer['tomllib'] == expected and answer['parsed'] == {'a': 1}, answer
    assert scratch.count() == 1, result
    return None


def old_python_restarts_with_arguments_and_folder(scratch, python):
    if first_python(13) is None:
        return 'no uv CPython 3.13'
    arguments = ['two words', '--flag', '']
    result = scratch.run(python, scratch.probe, *arguments)
    assert result.returncode == 0 and result.stderr == '', result
    answer = json.loads(result.stdout)
    assert answer['python'] == [3, 13], answer
    assert answer['executable'].startswith(str(UV_PYTHONS)), answer
    assert answer['arguments'] == arguments and answer['folder'] == str(scratch.working), answer
    assert answer['parsed'] == {'a': 1} and answer['java'], answer
    assert scratch.count() == 2, result
    return None


def old_python_stops_when_the_restart_finds_no_new_python(scratch, python):
    # The prepared prefix leads PATH, so the restart meets old Python on any machine.
    prefix = str(Path(python).parent.parent)
    result = scratch.run(python, scratch.probe, HOME=str(scratch.home), THINKTHEN_RUNTIME_PREFIX=prefix)
    stopped_on_one_line(result)
    assert scratch.count() == 2, result
    return None


def old_python_without_a_script_file_stops(scratch, python):
    load = f'import sys; sys.path.insert(0, {str(scratch.folder)!r}); import tomllib'
    stopped_on_one_line(scratch.run(python, '-c', load))
    stopped_on_one_line(scratch.run(python, '-', stdin=load))
    return None


def old_python_stops_when_the_helper_cannot_be_sourced(scratch, python):
    # A copy outside the repository has no scripts/native-tools-env to source.
    copy = scratch.folder / 'copy/scripts'
    copy.mkdir(parents=True)
    shutil.copy(ROOT / 'scripts/tomllib.py', copy)
    shutil.copy(scratch.probe, copy)
    result = scratch.run(python, copy / 'probe')
    stopped_on_one_line(result)
    assert scratch.count() == 1, result
    return None


def check(name, *arguments):
    with tempfile.TemporaryDirectory(prefix='tomllib-test-') as folder:
        try:
            skipped = name(Scratch(folder), *arguments)
        except AssertionError as error:
            print(f'FAIL {name.__name__} {arguments}: {error}', flush=True)
            return False
    print(f'SKIP {name.__name__}: {skipped}' if skipped else f'PASS {name.__name__} {arguments}', flush=True)
    return True


print(f'Started on Python {sys.version.split()[0]}: {sys.executable}', flush=True)
results = [check(new_python_gets_the_standard_library)]
olds = [str(python) for python in (first_python(10), '/usr/bin/python3')
        if python and Path(python).exists() and is_old(python)]
if not olds:
    print('SKIP old Python checks: no uv CPython 3.10 or older system Python', flush=True)
for python in olds:
    results += [check(step, python) for step in (old_python_restarts_with_arguments_and_folder,
                                                 old_python_stops_when_the_restart_finds_no_new_python,
                                                 old_python_without_a_script_file_stops,
                                                 old_python_stops_when_the_helper_cannot_be_sourced)]
raise SystemExit(not all(results))
