#!/bin/sh
# Compare one successful existing query before and after the invocation fix.
set -eu
cd "$(dirname "$0")/.."
case "${1:-}" in
    --consume)
        consumers=${2:?Provide the staged consumers}
        printf 'DuckDB ordered comparator host=%s load=%s cache=one-warmup-per-consumer\n' "$(hostname)" "$(cat /proc/loadavg)"
        for label in baseline candidate; do
            printf 'DuckDB benchmark %s\n' "$label"
            file "$consumers/$label/sql" "$consumers/$label/libduckdb.so"
            python3 databases/duckdb/tests/run.py "$consumers/$label" "$THINKTHEN_LOOPBACK" --union-benchmark
        done
        exit 0
        ;;
    --stage) ;;
    *) echo 'usage: duckdb-union-benchmark --stage BASELINE OUTPUT | --consume INPUT' >&2; exit 2 ;;
esac
baseline=${2:?Provide the pre-fix revision}
consumers=${3:?Provide the staging directory}
source=databases/duckdb/src/extension.cpp
saved=$(mktemp)
cp "$source" "$saved"
trap 'status=$?; trap - EXIT; cp "$saved" "$source"; rm -f "$saved"; exit "$status"' EXIT
trap 'exit 1' HUP INT TERM
printf 'DuckDB stage baseline %s\n' "$baseline"
git show "$baseline:$source" > "$source"
THINKTHEN_DUCKDB_ARTIFACT_DIR="$consumers/baseline" scripts/duckdb-union-check --stage-only
cp "$saved" "$source"
printf 'DuckDB stage candidate %s\n' "$(git rev-parse HEAD)"
THINKTHEN_DUCKDB_ARTIFACT_DIR="$consumers/candidate" scripts/duckdb-union-check --stage-only
