#!/bin/sh
# Install the C++ headers with the shared release native asset.
set -eu
cd "$(dirname "$0")/.."
scripts/header-contract-check
. scripts/native-build-env
if [ "$#" -ne 1 ]; then echo 'usage: scripts/cpp-package OUTPUT_DIRECTORY' >&2; exit 2; fi
mkdir -p "$1"
output=$(cd "$1" && pwd)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
scripts/c-package "$scratch/c-package"
mkdir "$scratch/c-prefix"
tar -xzf "$scratch/c-package"/*.tar.gz -C "$scratch/c-prefix"
cmake -S sdk/cpp -B "$scratch/build" -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_PREFIX_PATH="$scratch/c-prefix" -DCMAKE_INSTALL_PREFIX="$output/prefix"
cmake --install "$scratch/build"
rid=$(python3 scripts/native_platform.py rid)
tar -czf "$output/thinkthen-cpp-$rid.tar.gz" -C "$output/prefix" .
