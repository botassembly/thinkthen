#!/bin/sh
# Load the archive in a fresh PostgreSQL installation inside an offline container.
set -eu
cd "$(dirname "$0")/.."
case "${1:-all}" in all|native|ownership|conformance) ;; *) echo 'usage: scripts/postgres-gate [all|native|ownership|conformance]' >&2; exit 2 ;; esac
if [ "$(uname -s)" != Linux ]; then
    echo 'Skipped PostgreSQL: package targets Linux; installed gate runs on the Linux builder'
    exit 77
fi
scope=${1:-all}
job=${PM_JOB:-local}
root=$PWD
fixture_archive=${THINKTHEN_SQL_TEST_ARCHIVE:?Provide the shared explicit fixture-routing archive}
scratch=$(mktemp -d)
cleanup() {
    if [ "$gate_status" = 0 ]; then rm -rf "$scratch";
    else printf 'PostgreSQL failed files: %s\n' "$scratch" >&2; fi
}
trap 'gate_status=$?; trap - EXIT; set +e; cleanup; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
THINKTHEN_SQL_TEST_ARCHIVE= scripts/postgres-package "$scratch/production"
python3 databases/duckdb/tests/package-safety.py "$scratch/production/package/lib/thinkthen_postgres.so"
THINKTHEN_SQL_TEST_ARCHIVE=$fixture_archive scripts/postgres-package "$scratch/built"
if [ -z "${THINKTHEN_LOOPBACK:-}" ]; then cargo build --offline --locked -p loopback --bin loopback; fi
target=${CARGO_TARGET_DIR:-target}
case "$target" in /*) ;; *) target="$root/$target" ;; esac
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
    LLVM_PROFILE_FILE="$target/postgres-%p-%m.profraw"
fi
test_image=$(docker image inspect "${THINKTHEN_POSTGRES_TEST_IMAGE:-thinkthen-postgres-build:18.6}" --format '{{.Id}}')
set --
if [ -n "${JOB_LABEL_FILE:-}" ]; then
    set -- "$@" --label-file "$JOB_LABEL_FILE"
else
    set -- "$@" --label "$(python3 scripts/build_targets.py)" --label "pm.ticket=${job%% *}"
fi
docker run "$@" --pull=never --rm --network none \
    -v "$root:/src:ro" -v "$scratch:/work" -v "${THINKTHEN_LOOPBACK:-$target/debug/loopback}:/loopback:ro" \
    -v "$scratch/built/build:/work/build" -v "$target:$target" \
    "$test_image" sh -eu -c '
        sh /src/scripts/postgres-install-runtime /src /work "$1" "$2"
        if ! getent passwd "$1" >/dev/null; then
            printf 'thinkthen-%s:x:%s:%s::/work/built/home:/bin/sh\n' "$1" "$1" "$2" >> /etc/passwd
        fi
        exec setpriv --reuid "$1" --regid "$2" --clear-groups env -i HOME=/work/built/home \
            PATH=/opt/thinkthen-pg18/bin:/usr/bin:/bin LANG=C.UTF-8 LLVM_PROFILE_FILE="$3" \
            THINKTHEN_LOOPBACK=/loopback THINKTHEN_GATE_STRICT="$5" sh -eu -c '\''
                # Each step runs even after an earlier one fails, so one run reports every failure.
                status=0
                python3 /src/extensions/postgres/tests/typed_api.py /loopback \
                    --abi-mismatch-extension /work/built/build/thinkthen_postgres_mismatch.so \
                    --systemone-url-env THINKTHEN_TEST_LOOPBACK_URL --openai-url-env THINKTHEN_TEST_LOOPBACK_URL --group "$1" || status=1
                exit "$status"
            '\'' sh "$4"
    ' sh "$(id -u)" "$(id -g)" "${LLVM_PROFILE_FILE:-}" "$scope" "${THINKTHEN_GATE_STRICT:-0}"
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
    cp "$scratch/installed/lib/thinkthen_postgres.so" "$target/debug/thinkthen-sql-postgres.so"
fi
if [ -n "${THINKTHEN_POSTGRES_ARTIFACT_DIR:-}" ]; then
    mkdir -p "$THINKTHEN_POSTGRES_ARTIFACT_DIR"
    cp "$scratch/production"/*.tar.gz "$THINKTHEN_POSTGRES_ARTIFACT_DIR/"
    cp -R "$scratch/built/build" "$THINKTHEN_POSTGRES_ARTIFACT_DIR/"
    cp -R "$scratch/bundle" "$THINKTHEN_POSTGRES_ARTIFACT_DIR/"
fi
