#!/usr/bin/env python3
"""Reject private infrastructure and implementation history in tracked text."""

import json
import os
import pathlib
import re
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parent.parent
paths = subprocess.check_output(["git", "ls-files", "--stage", "-z"], cwd=root).split(b"\0")
forbidden = re.compile(
    r"\b(?:legacy|rebuild|rearchitect|old repo|old code|earlier repo|earlier code|old project|earlier project|pm\.ticket=[0-9]+)\b",
    re.IGNORECASE,
)
if len(sys.argv) > 2:
    sys.exit('usage: scripts/words [PRIVATE_PATTERN_FILE]')
strict = os.environ.get('THINKTHEN_GATE_STRICT') == '1'
if strict and len(sys.argv) != 2:
    sys.exit('strict candidate gate requires a private pattern file')
private = None
if len(sys.argv) == 2:
    pattern = pathlib.Path(sys.argv[1]).read_text().strip()
    if not pattern:
        sys.exit('private pattern file must not be empty')
    private = re.compile(pattern, re.IGNORECASE)
failed = False
for entry in paths:
    if not entry:
        continue
    metadata, name = entry.split(b"\t", 1)
    if metadata.split()[0] == b"160000":
        continue
    path = pathlib.Path(name.decode())
    if strict and (path.as_posix() == 'AGENTS.md' or path.parts[0] == 'sdlc'):
        continue
    if path.as_posix() in {"scripts/words"}:
        continue
    data = (root / path).read_bytes()
    if path.as_posix() == "sdlc/pm.json":
        settings = json.loads(data)
        settings.pop("mailroom", None)
        data = json.dumps(settings).encode()
    if b"\0" in data:
        continue
    for number, line in enumerate(data.decode("utf-8", errors="replace").splitlines(), 1):
        # Microsoft names this CRT library and its stem in linker inputs.
        # npm package identities are fixed upstream, not project history.
        if path.as_posix() == "site/package-lock.json":
            line = line.replace("character-entities-legacy", "character-entities")
        checked = re.sub(r"\blegacy_stdio_definitions(?:\.lib)?\b", "", line)
        private_checked = checked
        # The maker credit is approved only in these three public documents.
        if path.as_posix() in {
            'site/src/components/Footer.astro',
            'site/src/content/docs/about.mdx',
            'site/src/content/docs/blog/introducing-thinkthen.mdx',
        }:
            private_checked = re.sub('GenomOncology', '', private_checked, flags=re.IGNORECASE)
        if forbidden.search(checked) or (private is not None and private.search(private_checked)):
            print(f"{path}:{number}: forbidden private or implementation reference", file=sys.stderr)
            failed = True
sys.exit(1 if failed else 0)
