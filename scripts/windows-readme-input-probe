#!/usr/bin/env python3
"""Capture literal PowerShell input and replay it against an existing candidate."""
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

from release_readme_candidate import blocks
from release_registry_check import runtime_environment

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--binary', required=True, type=Path)
parser.add_argument('--expect-decoded', action='store_true', help='require one transport marker to be decoded by the fixed command')
args = parser.parse_args()
binary = args.binary.resolve()
if os.name != 'nt':
    parser.error('requires native Windows')
question = blocks((ROOT / 'README.md').read_text(encoding='utf-8'), True)[1]
shell = ['powershell.exe', '-NoProfile', '-NonInteractive', '-Command']
with tempfile.TemporaryDirectory(prefix='readme-input-probe-') as temporary:
    work = Path(temporary)
    env = runtime_environment(work) | {'THINKTHEN_BACKEND': 'stub'}
    (work / 'home').mkdir()
    capture = work / 'thinkthen.exe'
    program = r'''using System;
using System.IO;
using System.Text;
public class Capture {
 public static void Main(string[] args) {
  using (var data = new MemoryStream()) {
   Console.OpenStandardInput().CopyTo(data);
   Console.WriteLine("stdin=" + BitConverter.ToString(data.ToArray()).Replace("-", ""));
  }
  foreach (var arg in args) Console.WriteLine("argv=" + Convert.ToBase64String(Encoding.UTF8.GetBytes(arg)));
 }
}'''
    compile_script = "Add-Type -TypeDefinition @'\n" + program + "\n'@ -OutputAssembly '" + str(capture).replace("'", "''") + "' -OutputType ConsoleApplication"
    subprocess.run(shell + ["$ErrorActionPreference='Stop'; " + compile_script], check=True, env=env, capture_output=True, timeout=60)
    capture_env = env | {'PATH': str(work) + os.pathsep + env['PATH']}
    modes = {
        'default': '',
        'console-utf8': '[Console]::InputEncoding=[Text.Encoding]::GetEncoding(65001); [Console]::OutputEncoding=[Text.Encoding]::GetEncoding(65001);\n',
        'utf8-pipeline-preamble': '$OutputEncoding=[Text.UTF8Encoding]::new($true);\n',
        'utf8-pipeline-no-preamble': '$OutputEncoding=[Text.UTF8Encoding]::new($false);\n',
    }
    print('candidate_sha256=' + hashlib.sha256(binary.read_bytes()).hexdigest(), flush=True)
    for name, setup in modes.items():
        metadata = '[pscustomobject]@{version=$PSVersionTable.PSVersion.ToString();input=[Console]::InputEncoding.CodePage;output=[Console]::OutputEncoding.CodePage;pipeline=$OutputEncoding.CodePage;preamble=[BitConverter]::ToString($OutputEncoding.GetPreamble())}|ConvertTo-Json -Compress\n'
        result = subprocess.run(shell + ["$ErrorActionPreference='Stop'; " + setup + metadata + question], env=capture_env, capture_output=True, check=True, timeout=30)
        lines = result.stdout.decode('utf-8-sig').splitlines()
        data = bytes.fromhex(next(line[6:] for line in lines if line.startswith('stdin=')))
        argv = [base64.b64decode(line[5:]).decode('utf-8') for line in lines if line.startswith('argv=')]
        answer = subprocess.run([str(binary), *argv], input=data, env=env, capture_output=True, timeout=30)
        print(json.dumps({'mode': name, 'powershell': json.loads(lines[0]), 'stdin_hex': data.hex(), 'argv': argv,
                          'exit': answer.returncode, 'stdout': answer.stdout.decode(errors='replace'),
                          'stderr': answer.stderr.decode(errors='replace')}), flush=True)
        if args.expect_decoded:
            expected = b'false\n' if name == 'utf8-pipeline-preamble' else b'true\n'
            assert answer.returncode == 0 and answer.stdout.replace(b'\r\n', b'\n') == expected and not answer.stderr
