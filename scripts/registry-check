#!/usr/bin/env python3
"""Check project metadata and universal registry packages without compiling engines."""
import argparse
import json
from pathlib import Path
import shutil
import sys
import tarfile
import tempfile
import xml.etree.ElementTree as ET
import zipfile

from release_metadata import check
from release_registry import node, native_libraries, nuget, jvm, one
from release_notice_check import package_notices, verify
from release_workflow import ROOT, run, version

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('inputs', type=Path)
args = parser.parse_args()
with tempfile.TemporaryDirectory(prefix='thinkthen-registry-check-') as temporary:
    scratch = Path(temporary)
    source = scratch / 'source'
    shutil.copytree(ROOT, source, ignore=shutil.ignore_patterns('.git', 'target'))
    check(source)
    inputs = scratch / 'inputs'
    with tarfile.open(args.inputs) as archive:
        archive.extractall(inputs, filter='data')
    packages = {target: next(inputs.glob('**/' + target)) for target in (
        'linux-x86_64', 'linux-arm64', 'macos-arm64', 'windows-x86_64')}
    destination = scratch / 'packages'
    destination.mkdir()
    for name in ('npm', 'nuget', 'maven'):
        (destination / name).mkdir()
    node(packages, destination / 'npm', scratch)
    libraries = native_libraries(packages, scratch)
    notices = {target: package_notices(one(package / 'csharp', '*.nupkg')) for target, package in packages.items()}
    nuget(libraries, destination / 'nuget', scratch, notices)
    jvm(libraries, destination / 'maven', scratch, notices)
    from release_source import stage
    stage(libraries, scratch / 'tag-source', notices)
    assert (scratch / 'tag-source/Package.swift').is_file()
    assert len(list((scratch / 'tag-source/sdk/go/thinkthen').glob('library_*.go'))) == 4
    with tarfile.open(next((destination / 'npm').glob('*.tgz'))) as archive:
        assert len([n for n in archive.getnames() if n.endswith('.node')]) == 4
    with zipfile.ZipFile(next((destination / 'nuget').glob('*.nupkg'))) as archive:
        assert len([n for n in archive.namelist() if '/native/' in n]) == 4
    for package in destination.rglob('*-java-*.jar'):
        if package.name.endswith(('-sources.jar', '-javadoc.jar')):
            continue
        with zipfile.ZipFile(package) as archive:
            assert len([n for n in archive.namelist() if '/native/' in n and n.endswith(('.so', '.dll', '.dylib'))]) == 4
    for pattern in ('npm/*.tgz', 'nuget/*.nupkg', 'maven/**/thinkthen-java-[0-9]*.jar'):
        for path in destination.glob(pattern):
            if not path.name.endswith(('-sources.jar', '-javadoc.jar')): verify(path)
    from release_registry_check import install
    install(destination, scratch)
    print('registry: version isolation and universal native package inventories pass')
