#!/bin/sh
# Build an installed NuGet consumer with prepared native artifacts and no network.
set -eu
version=$(python3 "$(dirname "$0")/release_metadata.py" --version)
cd "$(dirname "$0")/.."
root=$PWD
case "${1:-}" in
  '') source_native=0; assets=${THINKTHEN_CSHARP_NATIVE_ASSETS:?provide the prepared matching release asset directory} ;;
  --source) source_native=1 ;;
  *) echo 'usage: scripts/csharp-gate [--source]' >&2; exit 2 ;;
esac
: "${THINKTHEN_MALFORMED_ROW_FIXTURES:?prepare shared malformed row fixtures}"
stage=$(mktemp -d)
trap 'gate_status=$?; trap - EXIT; set +e; rm -rf "$stage"; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
export PATH="${THINKTHEN_DOTNET_HOME:-$HOME/.local/share/thinkthen-build-tools/dotnet10}:$PATH"
export DOTNET_CLI_HOME="$stage/home" NUGET_PACKAGES="$stage/packages"
export DOTNET_ROOT="${THINKTHEN_DOTNET_HOME:-$HOME/.local/share/thinkthen-build-tools/dotnet10}"
export DOTNET_CLI_USE_MSBUILD_SERVER=0 UseSharedCompilation=false
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_GENERATE_ASPNET_CERTIFICATE=false
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BACKEND THINKTHEN_BASE_URL THINKTHEN_BATCH THINKTHEN_LIBRARY
export CARGO_NET_OFFLINE=true
cargo build -p loopback --bin loopback --locked
native=${CARGO_TARGET_DIR:-$root/target}/debug
case "$native" in /*) ;; *) native="$root/$native" ;; esac
if [ "$source_native" = 1 ]; then
  cargo build -p thinkthen-ffi --locked
  linux= mac=
  case $(uname -s) in
    Darwin) mac="$native/libthinkthen_ffi.dylib" ;;
    Linux) linux="$native/libthinkthen_ffi.so" ;;
    *) echo 'unsupported source C# host' >&2; exit 2 ;;
  esac
else
  linux="$assets/linux-x64/libthinkthen_ffi.so"
  mac="$assets/osx-arm64/libthinkthen_ffi.dylib"
fi
# Coverage uses the instrumented current-host library from this tree. The other
# asset remains packaged but cannot load on this host.
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
  cargo build -p thinkthen-ffi --locked
  case $(uname -s) in
    Darwin) mac="$native/libthinkthen_ffi.dylib" ;;
    Linux) linux="$native/libthinkthen_ffi.so" ;;
  esac
fi
export THINKTHEN_LOOPBACK="$native/loopback"
printf '<configuration><packageSources><clear /><add key="prepared" value="%s/singlefile-packages" /></packageSources></configuration>\n' "${THINKTHEN_DOTNET_HOME:-$HOME/.local/share/thinkthen-build-tools/dotnet10}" > "$stage/NuGet.Config"
dotnet pack sdk/csharp/ThinkThen.csproj --configfile "$stage/NuGet.Config" --artifacts-path "$stage/artifacts" -o "$stage/feed" -p:LinuxNative="$linux" -p:MacNative="$mac"
dotnet build sdk/csharp/tests/symbols/Symbols.csproj --configfile "$stage/NuGet.Config" --artifacts-path "$stage/symbol-artifacts" -o "$stage/symbol-check"
dotnet "$stage/symbol-check/Symbols.dll" "$stage/feed"
python3 "$root/scripts/csharp_consumers.py" examples "$stage"
mkdir "$stage/consumer"
cp sdk/csharp/tests/Consumer.csproj sdk/csharp/tests/*.cs "$stage/consumer/"
printf '<configuration><packageSources><clear /><add key="local" value="%s" /><add key="prepared" value="%s/singlefile-packages" /></packageSources></configuration>\n' "$stage/feed" "${THINKTHEN_DOTNET_HOME:-$HOME/.local/share/thinkthen-build-tools/dotnet10}" > "$stage/consumer/NuGet.Config"
dotnet build "$stage/consumer/Consumer.csproj" --configfile "$stage/consumer/NuGet.Config" --artifacts-path "$stage/consumer-artifacts" -o "$stage/bin"
engine=$(find "$stage/bin/runtimes" -type f -name "$(basename "$mac")" -print)
case $(uname -s) in Linux) engine=$(find "$stage/bin/runtimes" -type f -name "$(basename "$linux")" -print) ;; esac
python3 scripts/loader-failure-check "$engine" -- dotnet "$stage/bin/Consumer.dll" "$root/construction/stub.json" --stub-only
printf 'not a shared library\n' > "$stage/broken-engine"
for unloadable in "$stage/missing-engine" "$stage/broken-engine"; do
  THINKTHEN_LIBRARY="$unloadable" dotnet "$stage/bin/Consumer.dll" --load-failure "$unloadable"
done
python3 scripts/native-lookup-check "$engine" -- dotnet "$stage/bin/Consumer.dll" "$root/construction/stub.json" --stub-only
python3 "$root/sdk/csharp/tests/malformed.py" "$stage/bin" "$THINKTHEN_MALFORMED_ROW_FIXTURES"
python3 "$root/scripts/csharp_consumers.py" interface "$stage"
python3 "$root/scripts/csharp_consumers.py" abi "$stage"
dotnet "$stage/bin/Consumer.dll" --interface-only
THINKTHEN_LOOPBACK="$native/loopback" THINKTHEN_BACKEND= dotnet "$stage/bin/Consumer.dll" --backend-empty
THINKTHEN_LOOPBACK="$native/loopback" dotnet "$stage/bin/Consumer.dll" --surface-interface
# macOS: count live native owners through a shim that re-exports the packaged engine.
if [ "$(uname -s)" = Darwin ]; then
  cp "$engine" "$stage/real-engine.dylib"
  cc -Wl,-headerpad_max_install_names -std=c11 -Wall -Wextra -Werror -dynamiclib sdk/csharp/tests/handle-counts.c \
    -I crates/thinkthen-ffi/include -Wl,-reexport_library,"$stage/real-engine.dylib" -o "$stage/counts.dylib"
  install_name_tool -change "$(otool -D "$stage/real-engine.dylib" | tail -n 1)" "$stage/real-engine.dylib" "$stage/counts.dylib"
  # Replace by rename, never in place, so macOS does not reuse a cached signature.
  cp "$stage/counts.dylib" "$engine.counts" && mv "$engine.counts" "$engine"
  THINKTHEN_TEST_ENGINE="$stage/real-engine.dylib" dotnet "$stage/bin/Consumer.dll" --handle-counts
  cp "$stage/real-engine.dylib" "$engine.real" && mv "$engine.real" "$engine"
fi
cd "$stage"
export THINKTHEN_API_KEY=construction-only THINKTHEN_LOOPBACK="$native/loopback"
dotnet "$stage/bin/Consumer.dll" "$root/construction/stub.json" "$root/conformance" "$native/loopback"
dotnet publish "$stage/consumer/Consumer.csproj" --configfile "$stage/consumer/NuGet.Config" --artifacts-path "$stage/consumer-artifacts" -o "$stage/single" -p:PublishSingleFile=true -p:SelfContained=false
"$stage/single/Consumer" "$root/construction/stub.json" --stub-only
python3 "$root/scripts/csharp_consumers.py" metadata "$stage"
if [ -n "${THINKTHEN_CSHARP_OUTPUT:-}" ]; then
  mkdir -p "$THINKTHEN_CSHARP_OUTPUT"
  cp "$stage/feed/Botassembly.ThinkThen.$version.nupkg" "$THINKTHEN_CSHARP_OUTPUT/"
  mkdir -p "$THINKTHEN_CSHARP_OUTPUT/consumer"
  cp -R "$stage/bin/." "$THINKTHEN_CSHARP_OUTPUT/consumer/"
fi
