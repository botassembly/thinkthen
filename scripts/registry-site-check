#!/usr/bin/env python3
"""Install the shipped all-platform tag source through local Go and Swift mirrors."""
import sys

from release_workflow import ROOT, run

if len(sys.argv) != 2:
    raise SystemExit('usage: registry-site-check REGISTRIES/tag-source.tar.gz')
run(sys.executable, ROOT / 'scripts/source-install-check', sys.argv[1], '--tag-source')
