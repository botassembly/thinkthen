#!/bin/sh
# Prove installed C++ headers against the separately installed C dependency.
set -eu
cd "$(dirname "$0")/.."
root=$PWD
case "${1:-}" in
    --abi-only) THINKTHEN_CPP_ABI_ONLY=1; THINKTHEN_C_SOURCE_NATIVE=1; export THINKTHEN_CPP_ABI_ONLY THINKTHEN_C_SOURCE_NATIVE ;;
    --interface-only) THINKTHEN_CPP_INTERFACE_ONLY=1; THINKTHEN_C_SOURCE_NATIVE=1; export THINKTHEN_CPP_INTERFACE_ONLY THINKTHEN_C_SOURCE_NATIVE ;;
    --corrections-only) THINKTHEN_CPP_CORRECTIONS_ONLY=1; THINKTHEN_C_SOURCE_NATIVE=1; export THINKTHEN_CPP_CORRECTIONS_ONLY THINKTHEN_C_SOURCE_NATIVE ;;
    "") ;;
    *) echo 'usage: scripts/cpp-sdk-gate [--abi-only|--interface-only|--corrections-only]' >&2; exit 2 ;;
esac
if [ "${THINKTHEN_CPP_CORRECTIONS_ONLY:-0}" = 1 ]; then
    cargo fmt --all --check
    cargo clippy --locked -p thinkthen-ffi --example headers -- -D warnings
    cargo run --quiet --locked -p thinkthen-ffi --example headers -- --check
fi
scratch=$(mktemp -d)
trap 'gate_status=$?; trap - EXIT; set +e; rm -rf "$scratch"; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
scripts/c-package "$scratch/c-package"
scripts/cpp-package "$scratch/cpp-package"
mkdir "$scratch/relocated"
tar -xzf "$scratch/c-package"/*.tar.gz -C "$scratch/relocated"
tar -xzf "$scratch/cpp-package"/*.tar.gz -C "$scratch/relocated"
if [ -n "${THINKTHEN_LOOPBACK:-}" ]; then
    test -x "$THINKTHEN_LOOPBACK"
else
    cargo build --locked --offline -p loopback --bin loopback
    THINKTHEN_LOOPBACK="${CARGO_TARGET_DIR:-target}/debug/loopback"
    case "$THINKTHEN_LOOPBACK" in /*) ;; *) THINKTHEN_LOOPBACK="$root/$THINKTHEN_LOOPBACK" ;; esac
fi
export THINKTHEN_LOOPBACK
build_target=${CARGO_TARGET_DIR:-target}
case "$build_target" in /*) ;; *) build_target="$root/$build_target" ;; esac
library=$(find "$scratch/relocated/lib" -maxdepth 1 -type f -name 'libthinkthen*' -print)
sdk/cpp/tests/check-installed "$scratch/relocated" "$THINKTHEN_LOOPBACK" "$library"
if [ "${THINKTHEN_CPP_ABI_ONLY:-0}" = 1 ]; then exit 0; fi
THINKTHEN_CPP_GUIDE_FLAGS="-I$scratch/relocated/include -L$scratch/relocated/lib -lthinkthen -Wl,-rpath,$scratch/relocated/lib"
export THINKTHEN_CPP_GUIDE_FLAGS
python3 scripts/cpp-guide-examples
if [ -n "${THINKTHEN_CPP_ARTIFACT_DIR:-}" ]; then
    mkdir -p "$THINKTHEN_CPP_ARTIFACT_DIR"
    cp "$scratch/cpp-package"/*.tar.gz "$THINKTHEN_CPP_ARTIFACT_DIR/"
fi
