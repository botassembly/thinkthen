#!/bin/sh
# Prove a relocated CMake package through its installed C++ consumer.
set -eu
cd "$(dirname "$0")/.."
root=$PWD
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
scripts/cpp-package "$scratch/package"
mv "$scratch/package/prefix" "$scratch/relocated"
mkdir "$scratch/readme"
python3 - "$scratch/relocated/share/thinkthen-cpp/README.md" "$scratch/readme" <<'PYTHON'
from pathlib import Path
import re, sys
text = Path(sys.argv[1]).read_text()
for language, name in (("cpp", "main.cpp"), ("cmake", "CMakeLists.txt")):
    (Path(sys.argv[2]) / name).write_text(re.search(r"```" + language + r"\n(.*?)\n```", text, re.S)[1])
PYTHON
cmake -S "$scratch/readme" -B "$scratch/readme-build" \
    -DCMAKE_PREFIX_PATH="$scratch/relocated;$HOME/.local/share/thinkthen-build-tools/nlohmann-json/3.11.3"
cmake --build "$scratch/readme-build" --parallel 2
"$scratch/readme-build/example"
mkdir "$scratch/source"
cp sdk/cpp/tests/consumer.cpp sdk/cpp/tests/CMakeLists.txt "$scratch/source/"
cmake -S "$scratch/source" -B "$scratch/build" -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$scratch/application" \
    -DCMAKE_PREFIX_PATH="$scratch/relocated;$HOME/.local/share/thinkthen-build-tools/nlohmann-json/3.11.3"
cmake --build "$scratch/build" --parallel 2
cmake --install "$scratch/build"
rm -rf "$scratch/source" "$scratch/build"
# The installed binary runs outside the source tree with no loader overrides.
cargo build --locked --offline -p loopback --bin loopback
build_target=${CARGO_TARGET_DIR:-target}
case "$build_target" in /*) ;; *) build_target="$root/$build_target" ;; esac
mkdir "$scratch/home"
unset LD_LIBRARY_PATH DYLD_LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH
cd "$scratch"
HOME="$scratch/home" python3 "$root/sdk/cpp/tests/run.py" "$scratch/application/bin/consumer" \
    "$root/construction/stub.json" "$build_target/debug/loopback" "$root/conformance"
if [ -n "${THINKTHEN_CPP_ARTIFACT_DIR:-}" ]; then
    mkdir -p "$THINKTHEN_CPP_ARTIFACT_DIR"
    cp "$scratch/package"/*.tar.gz "$THINKTHEN_CPP_ARTIFACT_DIR/"
fi
