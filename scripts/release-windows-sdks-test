#!/usr/bin/env python3
"""Feature: Windows installed checks report every language before failing."""
import json
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from types import SimpleNamespace
from unittest.mock import patch
import zipfile

import release_windows_sdks as sdks

LANGUAGES = ('Python', 'Python frames', 'TypeScript', 'Go', 'java', 'kotlin', 'C#', 'Ruby', 'R',
             'C', 'C++', 'Swift', 'Zig', 'sqlite', 'duckdb')


def candidate_imports():
    """Feature: installed Windows consumers preserve the candidate inventory."""
    from release_workflow import ROOT, checksums
    with tempfile.TemporaryDirectory(prefix='thinkthen-candidate-imports-') as temporary:
        scratch = Path(temporary)
        candidate = scratch / 'candidate'
        checks = candidate / 'checks'
        checks.mkdir(parents=True)
        for source in (ROOT / 'sdk/python/tests/conformance.py', ROOT / 'scripts/test_control.py'):
            shutil.copy2(source, checks / source.name)

        def inventory():
            return {path.relative_to(candidate).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
                    for path in candidate.rglob('*') if path.is_file()}

        (candidate / 'SHA256SUMS').write_text(''.join(
            digest + '  ' + name + '\n' for name, digest in sorted(inventory().items())))
        before = inventory()
        checksums(candidate)
        # ACL setup needs Windows; Python's real import and runtime environment do not.
        with patch('release_windows_cache.prepare_cache'):
            prepared = sdks.environment(scratch)
        prepared['SYSTEMROOT'] = str(scratch / 'system')
        runtime = sdks.runtime_environment(scratch, prepared)
        # Native engine loading is unrelated to the delivered helper imports.
        output = sdks.run(sys.executable, '-c',
            'import io,sys,types; sys.modules["thinkthen"] = types.ModuleType("thinkthen"); '
            'sys.path.insert(0,sys.argv[1]); import conformance,test_control; '
            'assert conformance.read_line is test_control.read_line; '
            'assert conformance.read_line(io.StringIO("import executed\\n")) == "import executed\\n"; '
            'print(conformance.plain(["delivered imports executed"]))', checks,
            cwd=scratch, env=runtime, resolve_path=prepared['PATH'])
        assert 'delivered imports executed' in output, output
        after = inventory()
        extra = sorted(after.keys() - before.keys())
        changed = sorted(name for name in before if before[name] != after.get(name))
        print('Windows delivered Python imports: ' + json.dumps({'extra': extra, 'changed': changed}), flush=True)
        checksums(candidate)
        assert after == before, (extra, changed)


def fixture(failure):
    selected = [failure.removeprefix('only-')] if failure.startswith('only-') else None
    with tempfile.TemporaryDirectory() as directory:
        folder = Path(directory)
        checks = folder / 'checks'
        for name in ('go', 'zig', 'csharp-source'):
            (checks / name).mkdir(parents=True)
        (checks / 'stub.json').write_text('[]')
        (checks / 'native_cases.py').write_text('')
        (checks / 'loopback.exe').touch()
        (checks / 'contract.json').write_text('{}')
        (checks / 'node.mjs').touch()
        (checks / 'csharp-source/Consumer.csproj').write_text('<Project/>')
        (checks / 'swift').mkdir()
        (folder / 'ruby/dependencies').mkdir(parents=True)
        (folder / 'ruby/dependencies/ffi.gem').touch()
        (folder / 'prerequisites/python-frames-windows/wheels').mkdir(parents=True)
        (folder / 'prerequisites/r').mkdir(parents=True)
        (folder / 'prerequisites/r/inventory.json').write_text(
            json.dumps({'install_order': [], 'packages': {}, 'r': 'fixture'}))
        packages = {name: name + '.zip' for name in (
            'python', 'typescript', 'go', 'csharp', 'ruby', 'r', 'c', 'cpp', 'swift',
            'zig', 'sqlite', 'duckdb')}
        for filename in packages.values():
            with zipfile.ZipFile(folder / filename, 'w') as archive:
                archive.writestr('fixture', b'')
                if filename == 'c.zip':
                    archive.writestr('bin/thinkthen_ffi.dll', b'fixture engine')
                if filename == 'go.zip':
                    archive.writestr('native/library', b'embedded engine')
        calls = []
        original_run = sdks.run
        original_rmtree = shutil.rmtree
        cleanup_attempts = []

        def remove_tree(path, *args, **kwargs):
            path = Path(path)
            if path.name.startswith('thinkthen-windows-sdks-') and failure == 'cleanup':
                cleanup_attempts.append(path)
                leftover = path / 'local/npm-cache/held'
                leftover.parent.mkdir(parents=True, exist_ok=True)
                leftover.write_text('named leftover')
                raise OSError(39, 'injected directory not empty', str(leftover.parent))
            return original_rmtree(path, *args, **kwargs)

        def run(*args, **options):
            args = list(map(str, args))
            calls.append(args)
            if any('native-lookup-check' in value for value in args):
                position = next(i for i, value in enumerate(args) if value.endswith('native-lookup-check')) + 1
                engine = Path(args[position + (args[position] == '--embedded')])
                if engine.name == 'library':
                    assert engine.is_file(), 'lookup prerequisite absent: ' + str(engine)
            if failure == 'Swift' and args[0] == 'swift':
                with patch.object(sdks.subprocess, 'run', return_value=subprocess.CompletedProcess(
                        args, 19, stdout='', stderr='injected Swift compiler stderr')):
                    return original_run(*args, **options)
            if failure == 'C' and args[0] == 'clang-cl' and '/TC' in args:
                raise RuntimeError('injected C compiler failure')
            if failure == 'Python' and args[1:4] == ['-I', '-m', 'venv']:
                raise RuntimeError('injected Python installation failure')
            if args[0] == 'clang-cl':
                for argument in args:
                    if argument.startswith('/Fe:'):
                        Path(argument[4:]).write_bytes(b'compiled fixture consumer')
            if args[0] == 'dotnet':
                single = Path(args[args.index('-o') + 1])
                single.mkdir()
                (single / 'thinkthen_ffi.dll').touch()
            if args[0] == 'swift':
                return str(folder / 'bin')
            return ''

        def environment(scratch):
            if failure == 'setup':
                raise RuntimeError('injected shared setup failure')
            return {'PATH': os.environ['PATH']}

        # Replace external runtimes and Windows setup only. The real full runner,
        # extraction, staging, language boundaries and final exit run unchanged.
        with patch.object(sdks, 'os', SimpleNamespace(name='nt', environ={
                'THINKTHEN_WINDOWS_SINGLEFILE_FEED': str(folder),
                'THINKTHEN_LOOPBACK': str(checks / 'loopback.exe')}, pathsep=os.pathsep)), \
             patch.object(sdks, 'environment', environment), \
             patch.object(sdks, 'runtime_environment', return_value={'PATH': ''}), \
             patch.object(sdks, 'run', run), \
             patch.object(sdks.shutil, 'rmtree', remove_tree), \
             patch('release_windows_cache.check_cache'), \
             patch.object(sdks.shutil, 'which', side_effect=lambda name, **kwargs: name):
            try:
                sdks.full(folder, {'version': '0.0.0', 'packages': packages}, caller_owned=True, families=selected)
            finally:
                print('fixture commands: ' + json.dumps(calls), flush=True)
                if cleanup_attempts:
                    print('fixture cleanup attempts: ' + str(len(cleanup_attempts)), flush=True)
                    retained = cleanup_attempts[0]
                    assert (retained / 'local/npm-cache/held').is_file(), 'cleanup failure lost its evidence'
                    print('fixture retained scratch: ' + str(retained), flush=True)
                    if retained.exists():
                        original_rmtree(retained)


def deep_cache_paths():
    """Deep cache roots pass 260 characters under short and long temp roots, within 255 per name."""
    from pathlib import PureWindowsPath
    from release_windows_cache import deep_name
    for parent_length in (3, 20, 85, 120, 160):
        parent = PureWindowsPath('C:\\' + 'p' * (parent_length - 3))
        assert len(str(parent)) == parent_length
        for revision in ('a' * 16, 'a' * 64):
            library = PureWindowsPath('thinkthen', 'native', revision, 'library.dll')
            for prefix, suffix in (('d', library), ('ps', PureWindowsPath('thinkthen-x') / library)):
                name = deep_name(prefix, parent, suffix)
                assert name.startswith(prefix) and len(name) <= 255, (parent_length, name)
                path = parent / name / suffix
                assert len(str(path)) > 260, (parent_length, prefix, len(str(path)))
    print('Windows deep cache roots: library paths pass 260 characters for 3 to 160 character temp roots')


if len(sys.argv) == 2:
    fixture(sys.argv[1])
else:
    deep_cache_paths()
    candidate_imports()
    for failure in ('Swift', 'C', 'Python', 'setup', 'none', 'cleanup'):
        result = subprocess.run([sys.executable, __file__, failure], capture_output=True, text=True)
        print('\n'.join(line for line in result.stdout.splitlines()
                        if not line.startswith('fixture commands: ')), flush=True)
        success = failure == 'none'
        assert (result.returncode == 0) == success, result.stderr
        for language in LANGUAGES:
            prefix = 'candidate Windows ' + language + ':'
            assert result.stdout.count(prefix) == 1, (failure, language, result.stdout, result.stderr)
            status = next(line for line in result.stdout.splitlines() if line.startswith(prefix))
            expected = ('NOT RUN' if failure == 'setup' else 'FAIL' if failure == language or
                        (failure == 'Python' and language == 'Python frames') else 'installed shared stub cases pass')
            assert expected in status, (failure, status)
        commands = json.loads(result.stdout.split('fixture commands: ')[1].splitlines()[0])
        if failure != 'setup':
            assert any(command[0] == 'zig' for command in commands), failure
            assert any(any('sql.py' in argument for argument in command) and 'duckdb' in command for command in commands), failure
        if failure == 'Swift':
            assert 'swift exited 19:' in result.stdout and 'injected Swift compiler stderr' in result.stdout
        if failure == 'C':
            assert any('/EHsc' in command for command in commands), 'C++ was hidden by C failure'
        if failure == 'cleanup':
            assert 'fixture cleanup attempts: 1' in result.stdout, result.stdout
            assert 'Windows SDK scratch cleanup failed; retained' in result.stderr, result.stderr
            assert 'npm-cache' in result.stderr, result.stderr
        assert ('every installed SDK passed' in result.stdout) == success
    print('Windows installed SDK runner: all results reported; failures remain nonzero')
    for family in ('python-frames', 'java', 'kotlin', 'csharp', 'cpp', 'duckdb'):
        result = subprocess.run([sys.executable, __file__, 'only-' + family], capture_output=True, text=True)
        assert result.returncode == 0, result.stdout + result.stderr
        markers = [line for line in result.stdout.splitlines() if line.startswith('candidate Windows ')]
        assert markers == ['candidate Windows ' + sdks.SDK_FAMILIES[family] + ': installed shared stub cases pass'], markers
        assert 'every installed SDK passed' not in result.stdout
        if family == 'python-frames':
            commands = json.loads(result.stdout.split('fixture commands: ')[1].splitlines()[0])
            assert any(command[1:4] == ['-I', '-m', 'venv'] for command in commands), commands
            assert any(command[-1].endswith('python.zip') for command in commands), commands
        print('Windows selected family with prerequisites: ' + family)
