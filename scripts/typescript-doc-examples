#!/usr/bin/env python3
"""Run the TypeScript guide through the shared dispatcher after gate preparation."""
import os
from pathlib import Path
import sys

if __name__ == '__main__':
    if len(sys.argv) != 2:
        raise SystemExit('usage: scripts/typescript-doc-examples INSTALLED_CONSUMER')
    dispatcher = Path(__file__).resolve().with_name('guide-examples')
    os.execv(sys.executable, [sys.executable, str(dispatcher), '--surface', 'typescript',
                             '--typescript-consumer', sys.argv[1]])
