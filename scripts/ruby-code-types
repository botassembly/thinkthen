#!/usr/bin/env python3
"""Generate Ruby error literals from the native contract registry."""
import json
from pathlib import Path
import sys
root = Path(__file__).resolve().parent.parent
codes = json.loads((root / 'schemas/contract.json').read_text())['codes']
output = Path(sys.argv[1])
output.mkdir(parents=True, exist_ok=True)
(output / 'error_codes.rbs').write_text('module ThinkThen\n  type error_code = ' + ' | '.join(':"' + code['name'] + '"' for code in codes) + ' | :unknown\nend\n')
