#!/usr/bin/env python3
"""Check actual consumer IDs across a bounded warm-up and measured split.

Pass the existing installed stress adapter command after -- and name its --surface. Ten records per
round put the unshifted record ordinal and call prefix at a decimal boundary in
the first measured round. Each adapter still checks every returned row's truth.
"""
import argparse
import json
from pathlib import Path
import runpy
import sys

ROOT = Path(__file__).resolve().parent.parent
runner = runpy.run_path(str(ROOT / 'scripts/stress-adapters.py'))
table = json.loads((ROOT / 'conformance/stress.json').read_text())
backends = json.loads((ROOT / 'conformance/typed/manifest.json').read_text())['backends']
healthy = next(case for case in table['scenarios'] if case['name'] == 'healthy')
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--surface', required=True, type=runner['surface_label'])
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command[:1] == ['--'] else args.command
if not command:
    raise SystemExit('pass an installed stress adapter command')
reports = []
for backend in backends:
    result = runner['run'](command, table, backend, healthy, 10,
                           rounds=table['records']['soak_rounds'], surface=args.surface)
    assert result['rows'] == 10 * table['records']['soak_rounds']
    assert not result['identifiers']['width_changed']
    reports.append(result)
print(json.dumps(dict(cases=reports)))
