#!/usr/bin/env python3
"""Compile genuine Windows Swift candidate sources with the current bridge fix."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import zipfile

from release_windows_host import environment, native_run
from release_windows_sdks import environment as consumer_environment, runtime_environment

ROOT = Path(__file__).resolve().parent.parent


def main():
    assert os.name == 'nt', 'the consumer proof requires native Windows'
    arguments = sys.argv[1:]
    if arguments[:1] != ['--caller-owned']:
        from windows_caller_process import launch
        launch([sys.executable, str(Path(__file__).resolve()), '--caller-owned', *arguments],
               cwd=Path.cwd(), env=dict(os.environ))
        return
    inputs, scratch = (Path(value).resolve() for value in arguments[1:])
    sums = dict(line.split(maxsplit=1)[::-1]
                for line in (inputs / 'SHA256SUMS').read_text().splitlines())
    for path in inputs.rglob('*'):
        if path.is_file() and path.name != 'SHA256SUMS':
            assert hashlib.sha256(path.read_bytes()).hexdigest() == sums[path.relative_to(inputs).as_posix()]
    print('Genuine candidate revision: ' + json.loads((inputs / 'build.json').read_text())['revision'], flush=True)
    archive, = (inputs / 'swift').glob('*.zip')
    print('Genuine Swift archive sha256 ' + hashlib.sha256(archive.read_bytes()).hexdigest(), flush=True)
    scratch.mkdir()
    sdk, consumer = scratch / 'ThinkThen', scratch / 'Consumer'
    with zipfile.ZipFile(archive) as package:
        package.extractall(sdk)
    bridge = sdk / 'Sources/ThinkThen/Native.swift'
    original = hashlib.sha256(bridge.read_bytes()).hexdigest()
    shutil.copy2(ROOT / 'sdk/swift/Sources/ThinkThen/Native.swift', bridge)
    print('Native.swift source overlay: ' + json.dumps(dict(
        original=original, current=hashlib.sha256(bridge.read_bytes()).hexdigest())), flush=True)
    shutil.copytree(inputs / 'checks/swift', consumer)
    os.environ.update(environment())
    env = consumer_environment(scratch)
    runtime = runtime_environment(scratch, env)
    compiler = native_run('swift', '--version', env=env, capture_output=True, text=True).stdout
    print(compiler, end='', flush=True)
    assert '6.3.2' in compiler, 'the installed Swift compiler is not pinned 6.3.2'
    native_run('swift', 'build', '--package-path', consumer, '-c', 'release', '--jobs', '2',
               '--disable-sandbox', '-Xswiftc', '-warnings-as-errors', env=env)
    binary = native_run('swift', 'build', '--package-path', consumer, '-c', 'release',
                        '--show-bin-path', env=env, capture_output=True, text=True).stdout.strip()
    executable = Path(binary) / 'Consumer.exe'
    subprocess.run([sys.executable, inputs / 'checks/swift.py', executable,
                    inputs / 'checks/stub.json'], check=True, env=runtime)
    subprocess.run([executable, 'surface'], check=True, env=runtime)
    print('Actual Windows release Swift consumer: ten stub cases and surface pass', flush=True)


if __name__ == '__main__':
    main()
