#!/bin/sh
# Scan the current tree with pinned upstream rules.
set -eu
cd "$(dirname "$0")/.."
scanner="$HOME/.local/share/thinkthen-build-tools/gitleaks/8.24.3/gitleaks"
if [ ! -x "$scanner" ]; then scanner=$(command -v gitleaks || true); fi
if [ -z "$scanner" ] || [ "$("$scanner" version)" != 8.24.3 ]; then
    echo 'Prepare Gitleaks 8.24.3 before running the offline gate' >&2
    exit 1
fi
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
# Exclude repository pointers only while the index identifies them as gitlinks.
python3 - "$scratch/config.toml" <<'PYTHON'
import json
from pathlib import Path
import re
import subprocess
import sys

paths = []
for entry in subprocess.check_output(['git', 'ls-files', '--stage', '-z']).split(b'\0'):
    if not entry:
        continue
    metadata, name = entry.split(b'\t', 1)
    if metadata.split()[0] == b'160000':
        paths.append('^' + re.escape(name.decode()) + '(?:/|$)')
config = Path('.gitleaks.toml').read_text()
config = config.replace('[allowlist]\n', '[allowlist]\npaths = ' + json.dumps(paths) + '\n', 1)
Path(sys.argv[1]).write_text(config)
PYTHON
"$scanner" dir --config="$scratch/config.toml" --gitleaks-ignore-path=/dev/null \
    --redact=100 --no-banner --ignore-gitleaks-allow .
