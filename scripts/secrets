#!/bin/sh
# Scan source files, never ignored build output, with pinned upstream rules.
set -eu
cd "$(dirname "$0")/.."
scanner="$HOME/.local/share/thinkthen-build-tools/gitleaks/8.24.3/gitleaks"
if [ ! -x "$scanner" ]; then scanner=$(command -v gitleaks || true); fi
if [ -z "$scanner" ] || [ "$("$scanner" version)" != 8.24.3 ]; then
    echo 'Prepare Gitleaks 8.24.3 before running the offline gate' >&2
    exit 1
fi
root=$PWD
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
# Scan tracked and untracked files as they stand in this checkout, but not
# git-ignored ones: build output left in a reused job folder is not source.
# Gitlinks point at other repositories.
python3 - "$scratch/tree" <<'PYTHON'
import os
from pathlib import Path
import shutil
import subprocess
import sys

tree = Path(sys.argv[1])
names = []
for entry in subprocess.check_output(['git', 'ls-files', '--stage', '-z']).split(b'\0'):
    if entry:
        metadata, name = entry.split(b'\t', 1)
        if metadata.split()[0] != b'160000':
            names.append(name)
names += subprocess.check_output(['git', 'ls-files', '-z', '--others', '--exclude-standard']).split(b'\0')
for name in names:
    source = Path(os.fsdecode(name))
    if not name or not os.path.lexists(source):
        continue
    target = tree / source
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, target, follow_symlinks=False)
PYTHON
cd "$scratch/tree"
"$scanner" dir --config="$root/.gitleaks.toml" --gitleaks-ignore-path=/dev/null \
    --redact=100 --no-banner --ignore-gitleaks-allow .
