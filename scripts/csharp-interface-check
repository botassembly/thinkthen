#!/bin/sh
# Check answer values through a public consumer without loading the engine.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT HUP INT TERM
export DOTNET_ROOT="${THINKTHEN_DOTNET_HOME:-$HOME/.local/share/thinkthen-build-tools/dotnet10}"
export DOTNET_CLI_HOME="$stage/home" NUGET_PACKAGES="$stage/packages"
export DOTNET_CLI_USE_MSBUILD_SERVER=0 UseSharedCompilation=false
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_GENERATE_ASPNET_CERTIFICATE=false
printf '<configuration><packageSources><clear /><add key="prepared" value="%s/singlefile-packages" /></packageSources></configuration>\n' "$DOTNET_ROOT" > "$stage/NuGet.Config"
if [ "${1:-}" != --rank-example ]; then
    dotnet build sdk/csharp/tests/SourceConsumer.csproj --configfile "$stage/NuGet.Config" --artifacts-path "$stage/artifacts" -o "$stage/bin"
    dotnet "$stage/bin/SourceConsumer.dll" --interface-only
fi

if [ "${1:-}" = --rank ] || [ "${1:-}" = --backend-env ] || [ "${1:-}" = --rank-example ] || [ "${1:-}" = --descriptions ]; then
    cargo build -p thinkthen-ffi -p loopback --lib --bin loopback --locked
    cargo run --quiet -p thinkthen-ffi --example headers --locked -- --check
    native=${CARGO_TARGET_DIR:-$PWD/target}/debug
    case "$native" in /*) ;; *) native="$PWD/$native" ;; esac
    linux= mac=
    case $(uname -s) in
        Darwin) mac="$native/libthinkthen_ffi.dylib"; engine="$mac" ;;
        Linux) linux="$native/libthinkthen_ffi.so"; engine="$linux" ;;
        *) echo 'rank check requires Linux or macOS' >&2; exit 2 ;;
    esac
    export THINKTHEN_LOOPBACK="$native/loopback"
    if [ "${1:-}" = --rank-example ]; then
        dotnet pack sdk/csharp/ThinkThen.csproj --configfile "$stage/NuGet.Config" --artifacts-path "$stage/artifacts" -o "$stage/feed" -p:LinuxNative="$linux" -p:MacNative="$mac"
        python3 scripts/csharp_consumers.py guide-rank "$stage"
        exit
    fi
    cp "$engine" "$stage/bin/"
    if [ "${1:-}" = --descriptions ]; then
        dotnet "$stage/bin/SourceConsumer.dll" --description-admission
        exit
    fi
    if [ "${1:-}" = --backend-env ]; then
        THINKTHEN_BACKEND= dotnet "$stage/bin/SourceConsumer.dll" --backend-empty
        exit
    fi
    THINKTHEN_BACKEND= dotnet "$stage/bin/SourceConsumer.dll" --backend-empty
    dotnet "$stage/bin/SourceConsumer.dll" --surface-interface
    dotnet pack sdk/csharp/ThinkThen.csproj --configfile "$stage/NuGet.Config" --artifacts-path "$stage/artifacts" -o "$stage/feed" -p:LinuxNative="$linux" -p:MacNative="$mac"
    python3 scripts/csharp_consumers.py metadata "$stage"
fi
