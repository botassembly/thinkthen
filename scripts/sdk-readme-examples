#!/usr/bin/env python3
"""Run the Kotlin README quickstart and the Ruby guide with the SDK gate's installed dependencies."""
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from kotlin_compiler import classpath as compiler_classpath

ROOT = Path(__file__).resolve().parent.parent


def block(path, language, index=0):
    return re.findall(r'```' + language + r'\n(.*?)\n```', path.read_text(), re.S)[index] + '\n'


def run(*command, cwd, env=None):
    subprocess.run(list(map(str, command)), cwd=cwd, env=env, check=True)


with tempfile.TemporaryDirectory(prefix='thinkthen-quickstarts-') as folder:
    scratch = Path(folder)
    if sys.argv[1] == 'jvm':
        environment = dict(os.environ)
        for name in ('THINKTHEN_API_KEY', 'OPENAI_API_KEY', 'THINKTHEN_BASE_URL', 'THINKTHEN_URL', 'THINKTHEN_BATCH', 'JAVA_TOOL_OPTIONS', 'JDK_JAVA_OPTIONS'):
            environment.pop(name, None)
        environment['THINKTHEN_BACKEND'] = 'stub'
        classpath, repository, home = sys.argv[2:]
        classpath = os.pathsep.join(str(Path(p).resolve()) for p in classpath.split(os.pathsep))
        source = scratch / 'Quickstart.kt'
        source.write_text(block(ROOT / 'sdk/kotlin/README.md', 'kotlin'))
        compiler = compiler_classpath(repository)
        run('java', '-Duser.home=' + home, '-cp', compiler, 'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler',
            '-no-stdlib', '-no-reflect', '-jvm-target', '22', '-classpath', classpath,
            '-d', scratch / 'kotlin', source, cwd=scratch, env=environment)
        run('java', '-Duser.home=' + home, '--enable-native-access=ALL-UNNAMED', '-cp', str(scratch / 'kotlin') + os.pathsep + classpath, 'QuickstartKt', cwd=scratch, env=environment)
    elif sys.argv[1] == 'ruby':
        from ruby_guide_examples import run_ruby
        run_ruby()
    else:
        raise SystemExit('usage: sdk-readme-examples jvm CLASSPATH MAVEN_REPOSITORY HOME | ruby')
print('Literal README quickstarts: PASS')
