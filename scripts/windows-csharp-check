#!/usr/bin/env python3
"""Install the pinned Windows .NET SDK, then check its restore and a Native AOT consumer."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import zipfile

from csharp_consumers import metadata
from csharp_dependencies import prepare_project
from release_downloads import PINS, fetch

TOOLS = Path('C:/tt0106/tools')


def install():
    """Keep each SDK in a folder named for its version, so a replay selects it exactly."""
    url, = [url for url in json.loads(PINS.read_text()) if '/Sdk/' in url and url.endswith('-win-x64.zip')]
    version = url.split('/Sdk/')[1].split('/')[0]
    home = TOOLS / ('dotnet' + version)
    if not home.is_dir():
        with tempfile.TemporaryDirectory(prefix='.dotnet-', dir=TOOLS) as temporary:
            with zipfile.ZipFile(fetch(url, Path(temporary) / 'sdk.zip')) as archive:
                archive.extractall(Path(temporary) / 'sdk')
            (Path(temporary) / 'sdk').rename(home)
    return home


def main():
    assert os.name == 'nt', 'the check requires native Windows'
    package, stage = Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()
    home = install()
    feed = stage / 'prepared'
    (stage / 'feed').mkdir(parents=True)
    (stage / 'restore').mkdir()
    shutil.copy2(package, stage / 'feed')
    os.environ.update(PATH=str(home) + os.pathsep + os.environ['PATH'], DOTNET_ROOT=str(home),
                      DOTNET_CLI_HOME=str(stage / 'home'), NUGET_PACKAGES=str(stage / 'packages'),
                      DOTNET_CLI_TELEMETRY_OPTOUT='1', DOTNET_SKIP_FIRST_TIME_EXPERIENCE='1',
                      DOTNET_GENERATE_ASPNET_CERTIFICATE='false', THINKTHEN_WINDOWS_SINGLEFILE_FEED=str(feed))
    dotnet = str(home / 'dotnet.exe')
    subprocess.run([dotnet, '--list-sdks'], check=True)
    project = stage / 'restore/Consumer.csproj'
    project.write_text(prepare_project(aot=True))
    subprocess.run([dotnet, 'restore', str(project), '--runtime', 'win-x64', '--packages', str(feed),
                    '--source', 'https://api.nuget.org/v3/index.json'], check=True)
    print(*sorted(path.name for path in (feed / 'microsoft.dotnet.ilcompiler').iterdir()), flush=True)
    metadata(stage)


if __name__ == '__main__':
    main()
