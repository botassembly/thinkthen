#!/usr/bin/env python3
"""Check owned floor producer scheduling against isolated cold and warm caches."""
import os
import hashlib
import io
import json
import multiprocessing
import subprocess
from pathlib import Path
import platform
import runpy
import shutil
import sys
import tempfile
import tarfile
import zipfile
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
from duckdb_release import VERSION
sys.path.insert(0, str(ROOT / 'scripts'))
import release_images


def exercise(scratch, system, runtime=None):
    module = runpy.run_path(str(ROOT / 'scripts/release_workflow_prepare.py'))
    action = module['floor_inputs']
    state = action.__globals__
    tools = scratch / system / 'tools'
    source = scratch / system / 'source'
    for name in ('release-downloads.json', 'release-tools.json', 'duckdb_release.py', 'duckdb-prepare', 'floors/prepare-r',
                 'floors/prepare-macos', 'floors/prepare-linux', 'floors/prepare-duckdb'):
        target = source / 'scripts' / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / 'scripts' / name, target)
    state['TOOLS'], state['ROOT'] = tools, source
    if runtime is None:
        state['PINS'] = {'r_sources': {'cli_3.6.6.tar.gz': 'a' * 64, 'dplyr_1.2.1.tar.gz': 'b' * 64}}
    from runtime_floors import FLOORS
    macos = system == 'Darwin'
    prefix = tools / ('floors/macos' + FLOORS['macos'] if macos else 'floors/linux-glibc' + FLOORS['linux']['glibc'])
    marker = tools / f'duckdb/{VERSION}/python-wheel'
    marker.parent.mkdir(parents=True)
    wheel = next((runtime / 'duckdb').glob('*.whl')).name if runtime else 'duckdb-test.whl'
    marker.write_text(wheel + '\n')
    calls = []
    failing = False
    counter = None
    protected = {'sqlite-3.41.0/bin/sqlite3': b'selected SQLite floor',
                 'jansson-2.14.1/provenance': b'independent Jansson producer'}
    for name, data in protected.items():
        path = prefix / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)

    def write(name):
        path = prefix / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text('prepared ' + name)

    # Compiler/download processes stand at the existing prepared() boundary.
    # The real scheduler and hash validator see independently specified outputs.
    def prepared(*args, **kwargs):
        nonlocal prefix
        original_prefix = prefix
        prefix = Path(kwargs.get("env", {}).get("THINKTHEN_RUNTIME_PREFIX", prefix))
        command = args[-2] if args[-1:] == ('--prepare-fish',) else args[-1]
        calls.append(command)
        if counter is not None:
            with counter.get_lock():
                counter.value += 1
        if command.endswith(('prepare-swift', 'prepare-image', 'installer-test')):
            prefix = original_prefix
            return
        if runtime is not None:
            roots = ['Frameworks/R.framework', 'bin/R', 'bin/Rscript', 'include/libintl.h', 'jansson', 'sources'] if command.endswith('prepare-macos') else ['duckdb'] if command.endswith('prepare-duckdb') else ['r-frames']
            for name in roots:
                source_path, target_path = runtime / name, prefix / name
                target_path.parent.mkdir(parents=True, exist_ok=True)
                if source_path.is_dir():
                    shutil.copytree(source_path, target_path, symlinks=True)
                else:
                    shutil.copy2(source_path, target_path)
            if command.endswith('prepare-macos'):
                for name in ('bin/R', 'bin/Rscript', 'Frameworks/R.framework/Resources/bin/R',
                             'Frameworks/R.framework/Resources/etc/Makeconf',
                             'Frameworks/R.framework/Resources/etc/Renviron'):
                    path = prefix / name
                    path.write_text(path.read_text().replace(str(runtime), str(prefix)))
            prefix = original_prefix
            return
        if command.endswith(('prepare-macos', 'prepare-linux')):
            names = ['jansson/lib/libjansson.a', 'jansson/include/jansson.h', 'sources/jsonlite_2.0.0.tar.gz']
            names += ['Frameworks/R.framework/Resources/bin/Rscript', 'bin/R', 'bin/Rscript',
                      'include/libintl.h', 'sources/R.pkg', 'Frameworks/R.framework/Resources/bin/R',
                      'Frameworks/R.framework/Resources/etc/Makeconf',
                      'Frameworks/R.framework/Resources/etc/Renviron'] if macos else ['bin/sqlite3', 'sources/sqlite.zip']
        elif command.endswith('prepare-duckdb'):
            names = ['duckdb/static/libduckdb_static.a',
                     'duckdb/cli/duckdb', f'duckdb/duckdb-{VERSION}/src/include/duckdb.hpp', 'duckdb/duckdb-test.whl']
        else:
            names = ['r-frames/library/jsonlite/DESCRIPTION', 'r-frames/library/cli/DESCRIPTION',
                     'r-frames/library/dplyr/DESCRIPTION', 'r-frames/packages/cli_3.6.6.tgz',
                     'r-frames/packages/dplyr_1.2.1_R_x86_64-pc-linux-gnu.tar.gz']
        for name in names:
            write(name)
        prefix = original_prefix
        if failing:
            raise RuntimeError("producer failed after partial output")

    state['prepared'] = prepared
    previous_system, previous_image = platform.system, release_images.image
    try:
        platform.system = lambda: system
        release_images.image = lambda name: 'sha256:' + 'a' * 64
        action()
        expected = ['scripts/floors/prepare-macos', 'scripts/floors/prepare-duckdb', 'scripts/floors/prepare-r'] if macos else ['scripts/floors/prepare-linux', 'scripts/floors/prepare-r']
        assert calls == expected, calls
        assert all((prefix / name).read_bytes() == data for name, data in protected.items())
        calls.clear()
        action()
        assert calls == [], 'complete current groups did not reuse'
        if runtime is not None:
            code = 'library(jsonlite); library(cli); stopifnot(packageVersion("jsonlite") == "2.0.0", packageVersion("cli") == "3.6.6"); stopifnot(startsWith(find.package("jsonlite"), Sys.getenv("R_LIBS_USER")), startsWith(find.package("cli"), Sys.getenv("R_LIBS_USER"))); cat("Published R runtime loads published jsonlite and cli\\n")'
            subprocess.run([prefix / 'bin/Rscript', '--vanilla', '-e', code], check=True,
                           env=dict(os.environ, R_LIBS_USER=str(prefix / 'r-frames/library'), R_LIBS_SITE=''))
            return
        state['host_tools'] = lambda: None
        state['language_inputs'] = lambda: None
        target = 'macos-arm64' if macos else 'linux-x86_64'
        with patch.object(platform, 'machine', return_value='arm64' if macos else 'x86_64'), patch.dict(os.environ, PM_JOB='floor-inputs-test'):
            module['prepare'](target)
        assert calls == ([] if macos else ['scripts/floors/prepare-image', 'scripts/installer-test', 'scripts/floors/prepare-swift']), calls
        calls.clear()
        missing = [('jansson/include/jansson.h', expected[0]),
                   ('sources/jsonlite_2.0.0.tar.gz', expected[0]),
                   ('r-frames/library/cli/DESCRIPTION', 'scripts/floors/prepare-r'),
                   ('r-frames/packages/cli_3.6.6.tgz', 'scripts/floors/prepare-r')]
        if macos:
            missing += [('duckdb/static/libduckdb_static.a', 'scripts/floors/prepare-duckdb'),
                        ('duckdb/cli/duckdb', 'scripts/floors/prepare-duckdb'),
                        ('duckdb/duckdb-test.whl', 'scripts/floors/prepare-duckdb')]
        for name, owner in missing:
            (prefix / name).unlink()
            action()
            assert calls == [owner], (name, calls)
            calls.clear()
        (prefix / 'r-frames/library/dplyr/DESCRIPTION').write_text('changed output')
        action()
        assert calls == ['scripts/floors/prepare-r'], calls
        calls.clear()
        recipe = source / 'scripts/floors/prepare-r'
        recipe.write_text(recipe.read_text() + '\n# Changed producer input\n')
        action()
        assert calls == ['scripts/floors/prepare-r'], calls
        calls.clear()
        before = {str(path.relative_to(prefix)): path.read_bytes() for path in prefix.rglob('*') if path.is_file()}
        recipe.write_text(recipe.read_text() + '\n# Failed refresh input\n')
        failing = True
        try:
            action()
        except RuntimeError as error:
            assert 'partial output' in str(error)
        else:
            raise AssertionError('failed producer was accepted')
        failing = False
        after = {str(path.relative_to(prefix)): path.read_bytes() for path in prefix.rglob('*')
                 if path.is_file() and not any(part.startswith('.r-frames.prepare-') for part in path.relative_to(prefix).parts)}
        assert before == after, 'failed refresh changed the previous group'
        assert list(prefix.glob('.r-frames.prepare-*')), 'failed staging witness was removed'
        calls.clear()
        action()
        calls.clear()
        recipe.write_text(recipe.read_text() + '\n# Concurrent refresh input\n')
        context = multiprocessing.get_context('fork')
        counter = context.Value('i', 0)
        start = context.Event()

        def refresh():
            start.wait()
            action()

        workers = [context.Process(target=refresh) for _ in range(2)]
        for worker in workers:
            worker.start()
        start.set()
        for worker in workers:
            worker.join()
            assert worker.exitcode == 0, 'concurrent producer did not finish successfully'
        assert counter.value == 1, 'competing refreshes did not share one completed group'
        counter = None
        if not macos:
            release_images.image = lambda name: 'sha256:' + 'b' * 64
            action()
            assert calls == expected, calls
        assert all((prefix / name).read_bytes() == data for name, data in protected.items())
        print(system + ' floor groups: cold creation, warm reuse, missing/changed outputs and changed inputs pass')
    finally:
        platform.system, release_images.image = previous_system, previous_image


def linux_scratch(scratch):
    source = scratch / 'linux-entrypoint'
    scripts = source / 'scripts'
    (scripts / 'floors').mkdir(parents=True)
    for name in ('floors/prepare-linux', 'native-build-env', 'runtime-floor-build',
                 'release_images.py', 'native_platform.py', 'build_targets.py'):
        shutil.copy2(ROOT / 'scripts' / name, scripts / name)
    shutil.copy2(ROOT / 'rust-toolchain.toml', source)
    subprocess.run(['git', 'init', '-q', source], check=True)
    assets = scripts / 'archives'
    assets.mkdir()
    with tarfile.open(assets / 'jansson.tar.gz', 'w:gz') as archive:
        member = tarfile.TarInfo('jansson-2.14/CMakeLists.txt')
        member.size = 5
        archive.addfile(member, io.BytesIO(b'local'))
    (assets / 'jsonlite_2.0.0.tar.gz').write_bytes(b'pinned local jsonlite')
    with zipfile.ZipFile(assets / 'sqlite.zip', 'w') as archive:
        for name in ('shell.c', 'sqlite3.c'):
            archive.writestr('sqlite-amalgamation-3410000/' + name, 'local')
    (scripts / 'release_downloads.py').write_text('''import pathlib, shutil, sys
shutil.copy2(pathlib.Path(__file__).parent / 'archives' / pathlib.Path(sys.argv[2]).name, sys.argv[2])
''')
    boundary = scripts / 'docker'
    boundary.write_text('''#!/usr/bin/env python3
import os, pathlib, sys
command = sys.argv[1:]
assert command[0] == 'run'
mounts = [pathlib.Path(command[i + 1].split(':')[0]).resolve() for i, arg in enumerate(command) if arg == '-v']
forwarded = dict(command[i + 1].split('=', 1) for i, arg in enumerate(command) if arg == '-e')
args = command[command.index('floor-build') + 1:]
prefix = pathlib.Path(os.environ['THINKTHEN_RUNTIME_PREFIX']).resolve()
raw_work = pathlib.Path(args[2]).parent if args[:2] == ['cmake', '-S'] else pathlib.Path(forwarded['TMPDIR'])
assert forwarded['TMPDIR'] == str(raw_work), 'owned scratch was not forwarded to Docker'
work = raw_work.resolve()
assert work in mounts, 'owned scratch lacks its exact Docker mount'
assert any(prefix.is_relative_to(path) for path in mounts), 'download/output prefix is invisible to Docker'
for arg in args[1:]:
    if arg.startswith('/'):
        assert any(pathlib.Path(arg).resolve().is_relative_to(path) for path in mounts), 'build input is invisible to Docker: ' + arg
if args[:2] == ['cmake', '-S']:
    assert (work / 'jansson-2.14/CMakeLists.txt').is_file()
    assert (work / 'sqlite-amalgamation-3410000/sqlite3.c').is_file()
    with pathlib.Path(os.environ['SCRATCH_LOG']).open('a') as log:
        log.write(str(work) + '\\n')
elif args[:2] == ['cmake', '--build'] and os.environ['FAIL_BUILD'] == '1':
    sys.exit(37)
elif args[0] == 'cc':
    pathlib.Path(args[-1]).write_text('built sqlite')
''')
    boundary.chmod(0o755)
    caller = source / '.floor-dependencies'
    caller.mkdir()
    sentinel = caller / 'sentinel'
    sentinel.write_bytes(b'caller owns this directory')
    log = source / 'scratch.log'
    prefix = source / 'runtime'
    temporary_root = source / 'temporary'
    temporary_root.symlink_to(scratch.resolve(), target_is_directory=True)
    env = dict(os.environ, TMPDIR=str(temporary_root), PM_JOB='floor-inputs-test', THINKTHEN_RUNTIME_PREFIX=str(prefix),
               MACOSX_DEPLOYMENT_TARGET='13.0', SCRATCH_LOG=str(log),
               HOME=str(source / 'home'), CARGO_HOME=str(source / 'home/.cargo'),
               GOCACHE=str(source / 'go-cache'), CARGO_TARGET_DIR=str(source / 'target'),
               THINKTHEN_FLOOR_IMAGE='sha256:' + 'a' * 64,
               PATH=str(scripts) + os.pathsep + os.environ['PATH'])
    env.pop('THINKTHEN_FLOOR_BUILD', None)
    allocations = []
    for mode, fail in (('job', '0'), ('job', '1'), ('hosted', '0'), ('hosted', '1')):
        invocation = dict(env, FAIL_BUILD=fail)
        if mode == 'hosted':
            invocation.pop('TMPDIR', None)
        result = subprocess.run(['sh', scripts / 'floors/prepare-linux'], cwd=source,
                                env=invocation, capture_output=True, text=True)
        assert result.returncode == (0 if fail == '0' else 37), result.stderr
        assert fail == '0' or '37' in result.stderr, result.stderr
        work = Path(log.read_text().splitlines()[-1])
        allocations.append(work)
        assert not work.exists(), 'preparation left its scratch behind'
        assert work.parent == Path(invocation.get('TMPDIR', '/tmp')).resolve()
        assert sentinel.read_bytes() == b'caller owns this directory'
        assert list(caller.iterdir()) == [sentinel]
    assert len(set(allocations)) == 4, 'preparation reused a scratch allocation'
    assert (prefix / 'bin/sqlite3').read_text() == 'built sqlite'
    checksums = (prefix / 'sources/SHA256SUMS').read_text().splitlines()
    assert {line.split()[0] for line in checksums} == {
        hashlib.sha256(path.read_bytes()).hexdigest() for path in assets.iterdir()}
    print('Linux preparation preserves caller scratch and removes only its own allocation on success and failure')


def job_labels(scratch):
    from build_targets import container_labels, repository_label
    folder = scratch / 'job labels'
    folder.mkdir()
    alias = scratch / 'job labels alias'
    alias.symlink_to(folder.resolve(), target_is_directory=True)
    labels = alias / 'labels'
    labels.write_text('# canonical ownership\npm.repo=owned-repo\npm.ticket=fixture-ticket\npm.job=j-test\n')
    canonical_labels = labels.resolve(strict=True)
    assert labels != canonical_labels, 'fixture must supply a real ancestor alias'
    with patch.dict(os.environ, JOB_LABEL_FILE=str(labels), PM_JOB='wrong-ticket'):
        assert container_labels(ROOT) == ['--label-file', str(canonical_labels)]
        assert container_labels(ROOT, image_build=True) == [
            '--label', 'pm.repo=owned-repo', '--label', 'pm.ticket=fixture-ticket', '--label', 'pm.job=j-test']
        cli = subprocess.check_output([sys.executable, ROOT / 'scripts/build_targets.py'], text=True).strip()
        assert cli == repository_label(ROOT) and cli.startswith('pm.repo=')
    with patch.dict(os.environ, PM_JOB='standalone source', JOB_LABEL_FILE=''):
        assert container_labels(ROOT) == ['--label', repository_label(ROOT), '--label', 'pm.ticket=standalone']
    docker = folder / 'docker'
    docker.write_text('''#!/usr/bin/env python3
import json, os, pathlib, sys
pathlib.Path(os.environ['CAPTURE_ARGS']).write_text(json.dumps(sys.argv[1:]))
sys.exit(int(os.environ['CHILD_STATUS']))
''')
    docker.chmod(0o755)
    env = dict(os.environ, PATH=str(folder) + os.pathsep + os.environ['PATH'],
               JOB_LABEL_FILE=str(labels), PM_JOB='wrong-ticket',
               THINKTHEN_FLOOR_IMAGE='sha256:' + 'a' * 64, CHILD_STATUS='37',
               CAPTURE_ARGS=str(folder / 'argv.json'), HOME=str(folder / 'home'),
               CARGO_HOME=str(folder / 'cargo'), CARGO_TARGET_DIR=str(folder / 'target'))
    env.pop('THINKTHEN_FLOOR_BUILD', None)
    # Exercise the real launcher even when this fixture runs on a Mac builder.
    bootstrap = "import sys,runpy; sys.platform='linux'; sys.path.insert(0,'scripts'); sys.argv=['scripts/runtime-floor-build','sh','-c','exit 37']; runpy.run_path(sys.argv[0],run_name='__main__')"
    result = subprocess.run([sys.executable, '-c', bootstrap], cwd=ROOT, env=env, capture_output=True, text=True)
    assert result.returncode == 37, result.stderr
    args = json.loads((folder / 'argv.json').read_text())
    assert '--rm' in args and args[args.index('--label-file') + 1] == str(canonical_labels)
    assert '--label' not in args, 'fallback labels overwrite job ownership'
    assert str(canonical_labels) + ':' + str(canonical_labels) + ':ro' in args
    assert 'JOB_LABEL_FILE=' + str(canonical_labels) in args
    assert labels.read_text().endswith('pm.job=j-test\n')
    # The real installer image-build caller must use supported individual flags.
    build = "import sys,runpy,platform; platform.system=lambda:'Linux'; sys.path.insert(0,'scripts'); sys.argv=['scripts/installer-test','--prepare-fish']; runpy.run_path(sys.argv[0],run_name='__main__')"
    env['CHILD_STATUS'] = '0'
    result = subprocess.run([sys.executable, '-c', build], cwd=ROOT, env=env, capture_output=True, text=True)
    assert result.returncode == 0, result.stderr
    args = json.loads((folder / 'argv.json').read_text())
    assert args[0] == 'build' and '--label-file' not in args
    assert [args[i + 1] for i, arg in enumerate(args) if arg == '--label'] == [
        'pm.repo=owned-repo', 'pm.ticket=fixture-ticket', 'pm.job=j-test']
    print('Job labels preserve canonical run ownership, nested read-only access, image-build flags and child status')


with tempfile.TemporaryDirectory(prefix='thinkthen-floor-inputs-') as temporary:
    if sys.argv[1:] == ['--macos-runtime']:
        assert platform.system() == 'Darwin'
        from runtime_floors import FLOORS
        exercise(Path(temporary), 'Darwin', Path.home() / ('.local/share/thinkthen-build-tools/floors/macos' + FLOORS['macos']))
    else:
        assert not sys.argv[1:]
        job_labels(Path(temporary))
        if platform.system() == 'Linux':
            linux_scratch(Path(temporary))
        for system in ('Darwin', 'Linux'):
            exercise(Path(temporary), system)
