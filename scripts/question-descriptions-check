#!/bin/sh
# Exercise shared question admission, meanings, native snapshots and schema.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
if [ "${1:-}" = generate ]; then
    cargo run --quiet --locked -p thinkthen --example schema
    exit
fi
cargo fmt --all --check
if [ "${1:-}" = rust-docs ]; then
    cargo test --locked -p thinkthen --doc --features stream
    cargo test --locked -p thinkthen --test cli_run saved_questions_use_explicit_files_folders_and_local_lookup
    exit
fi
cargo test --locked -p thinkthen --test question_descriptions
if [ "${1:-}" = focused ]; then
    cargo clippy --locked -p thinkthen --test question_descriptions --test answers --features stream -- -D warnings
    cargo test --locked -p thinkthen --test answers
    exit
fi
if [ "${1:-}" = affected ]; then
    scripts/rust-dependencies
    scripts/core-check
    cargo clippy --workspace --all-targets --features thinkthen/stream --locked --keep-going -- -D warnings
    scripts/contract-schema-check
    scripts/c-gate
    cargo test --locked -p thinkthen --test canonical_cli --test typed_conformance --test request_contract
    cargo test --locked -p thinkthen-ffi --test typed_projection
    cargo test --locked -p thinkthen-sql --test host
    scripts/words
    scripts/secrets
fi
if [ "${1:-}" = routine ]; then
    scripts/rust-dependencies
    scripts/core-check
    cargo clippy --workspace --all-targets --features thinkthen/stream --locked --keep-going -- -D warnings
    scripts/contract-schema-check
    scripts/c-gate
    cargo test --workspace --features thinkthen/stream --locked --no-fail-fast
    scripts/words
    scripts/secrets
fi
