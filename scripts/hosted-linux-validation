#!/usr/bin/env python3
"""Check frozen Linux source or one final installed SDK backend, without publishing."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile
import time

ARCHIVE_SHA = '1d1ad293b3dff7e7e90e816ee82c53b4d42d83db729516e85cf3782022bd68c0'
LIBRARY_SHA = '83b2090b21b68aa17cc41eb0b0d8fc96086ffb384a0657c7d45738c939ab059b'
RAW_LIBRARY_SHA = '9f1641a0b2d7530227b2d7cc4d7d858e329678572949379bec9ab392a2bd9435'
CONSUMERS = {
    'c': ('checks/c-consumer', '1e2bd934abea51cb2f8c8663f93013dcd7f9a34b67548bee379e63d3a2568852'),
    'cpp': ('checks/cpp-consumer', '2b1a69c353b98e3e3d24fd81e580c828be6bbda223f5fb829300436ae1b225ad'),
    'go': ('checks/go-consumer', '16fc612785ee3ba8d57d78a7a5f59e6e3aa7f8b7ea95466b1f5423b4a495693b'),
    'swift': ('checks/swift/Consumer', '6d9c68c342df2c96a3d4cd85bc382fe10b987d29159a59ed34690a02469f5bc6'),
    'zig': ('checks/zig/consumer', 'db7c4aa923fc57fa82b325e1bc3392508a66a7a9bff4e79b39d7e30771631d45'),
}


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def revision(root):
    return subprocess.check_output(['git', '-C', root, 'rev-parse', 'HEAD'], text=True).strip()


def run(command, source, output, name, env=None):
    with (output / (name + '.log')).open('w') as log:
        result = subprocess.run(command, cwd=source, env=env, stdout=log, stderr=subprocess.STDOUT)
    (output / (name + '-exit-code.txt')).write_text(str(result.returncode) + '\n')
    if result.returncode:
        print((output / (name + '.log')).read_text()[-16384:], file=sys.stderr)
        result.check_returncode()


def stage(archive, output, family):
    if digest(archive) != ARCHIVE_SHA:
        raise ValueError('final platform archive hash differs')
    candidate = Path(tempfile.mkdtemp(prefix='linux-validation-installed-')).resolve()
    prefix = '0.2.0/linux-x86_64/'
    consumer_name, consumer_sha = CONSUMERS[family]
    names = [consumer_name, 'build.json']
    if family in ('c', 'cpp'):
        names.append('c/thinkthen-c-0.2.0-linux-x86_64.tar.gz')
    if family == 'zig':
        names.append('zig/thinkthen-zig-0.2.0-linux-x86_64.tar.gz')
    with tarfile.open(archive) as package:
        if family == 'swift':
            names += [m.name.removeprefix(prefix) for m in package.getmembers() if m.isfile()
                      and m.name.startswith((prefix + 'checks/swift/ThinkThen_ThinkThen.resources/',
                                             prefix + 'prerequisites/swift-runtime/'))]
        for name in names:
            member = package.getmember(prefix + name)
            destination = candidate / name
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(package.extractfile(member).read())
    (output / 'original-platform-build.json').write_bytes((candidate / 'build.json').read_bytes())
    if family in ('c', 'cpp'):
        with tarfile.open(candidate / 'c/thinkthen-c-0.2.0-linux-x86_64.tar.gz') as package:
            package.extractall(candidate / 'c', filter='data')
    if family == 'zig':
        with tarfile.open(candidate / 'zig/thinkthen-zig-0.2.0-linux-x86_64.tar.gz') as package:
            (candidate / 'checks/zig/libthinkthen_ffi.so').write_bytes(
                package.extractfile('thinkthen/native/linux-x64/libthinkthen_ffi.so').read())
    consumer = candidate / consumer_name
    consumer.chmod(0o755)
    library_sha = LIBRARY_SHA if family in ('c', 'cpp') else RAW_LIBRARY_SHA
    if digest(consumer) != consumer_sha:
        raise ValueError('actual final SDK consumer hash differs')
    return candidate, consumer, library_sha


def mapped_runtime(parent, consumer, library_sha, output):
    """Retain the actual consumer's loaded library and runtime, before it exits."""
    deadline = time.monotonic() + 60
    while parent.poll() is None and time.monotonic() < deadline:
        children = Path(f'/proc/{parent.pid}/task/{parent.pid}/children').read_text().split()
        for child in children:
            proc = Path('/proc') / child
            try:
                if (proc / 'exe').resolve() != consumer:
                    continue
                maps = (proc / 'maps').read_text()
            except (FileNotFoundError, ProcessLookupError):
                continue
            paths = {Path(row.split(None, 5)[5]) for row in maps.splitlines()
                     if len(row.split(None, 5)) == 6 and row.split(None, 5)[5].startswith('/')}
            native = [path for path in paths if ('libthinkthen' in path.name or path.name == 'library')
                      and path.is_file() and digest(path) == library_sha]
            if not native:
                continue
            hashes = {str(path): digest(path) for path in sorted(paths) if path.is_file()}
            (output / 'consumer.maps').write_text(maps)
            (output / 'loaded-sha256.json').write_text(json.dumps(dict(pid=int(child), files=hashes), indent=2) + '\n')
            return native[0]
        time.sleep(0.02)
    raise RuntimeError('actual final SDK consumer/library mapping was not captured')


def native_workload(source, output, family, backend, consumer, library_sha, env):
    adapter = ([str(consumer), '-test.run=^TestSharedStress$'] if family == 'go' else
               [sys.executable, 'sdk/c/tests/stress.py', family, str(consumer)])
    command = [sys.executable, 'scripts/stress-adapters.py', '--surface', family, '--full', '--rounds', '60',
               '--backend', backend, '--evidence-path', str(output / f'{family}-{backend}.jsonl'), '--', *adapter]
    consumer_sha = digest(consumer)
    with (output / 'soak.log').open('w') as log:
        with subprocess.Popen(command, cwd=source, env=env, stdout=log, stderr=subprocess.STDOUT) as process:
            try:
                library = mapped_runtime(process, consumer, library_sha, output)
            except (RuntimeError, ValueError, OSError):
                process.terminate()
                raise
            status = process.wait()
    (output / 'soak-exit-code.txt').write_text(str(status) + '\n')
    if digest(consumer) != consumer_sha or digest(library) != library_sha:
        raise ValueError('final SDK bytes changed during the workload')
    return status


def rust_workload(source, output, backend, env):
    # This is the existing source-library entry point, including its embedded fixture.
    run([sys.executable, 'scripts/stress-sample.py', '--extended', '--groups', f'rust/{backend}',
         '--output', str(output / f'rust-{backend}.jsonl'), '--',
         'cargo', 'test', '--locked', '-p', 'thinkthen', '--test', 'stress', f'rust_extended_soak_{backend}',
         '--', '--ignored', '--exact', '--test-threads=1'], source, output, 'soak', env=env)
    return 0


def rust_inputs(source, output, compiler_env, identity):
    run(['cargo', 'test', '--locked', '-p', 'thinkthen', '--test', 'stress', '--no-run', '--message-format=json'],
        source, output, 'rust-build', env=compiler_env)
    artifacts = [json.loads(line) for line in (output / 'rust-build.log').read_text().splitlines()
                 if line.startswith('{')]
    binary, = [Path(row['executable']) for row in artifacts if row.get('reason') == 'compiler-artifact'
               and row['target']['name'] == 'stress' and row.get('executable')]
    fixtures = [*source.glob('crates/loopback/src/*.rs'),
                *source.glob('crates/thinkthen/test-support/server/**/*.rs'), source / 'conformance/stress.json']
    identity.update(claim='source-based Rust library evidence; not an installed-crate execution',
                    test_binary=str(binary), test_binary_sha256=digest(binary),
                    fixture_and_config_sha256={str(path.relative_to(source)): digest(path) for path in sorted(fixtures)},
                    compiler_environment={key: compiler_env[key] for key in
                        ('RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS', 'RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER',
                         'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER')})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('task', choices=['packing', *[f'{family}-{backend}' for family in (*CONSUMERS, 'rust')
                                                    for backend in ('systemone', 'openai')]])
    parser.add_argument('--source', type=Path, required=True)
    parser.add_argument('--archive', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--size', choices=('true', 'false'), default='false', help='true is wiring smoke only')
    args = parser.parse_args()
    source, output = args.source.resolve(), args.output.resolve()
    output.mkdir(parents=True, exist_ok=False)
    compiler_env = dict(os.environ, RUSTFLAGS='', CARGO_ENCODED_RUSTFLAGS='',
                        RUSTC_WRAPPER='', RUSTC_WORKSPACE_WRAPPER='',
                        CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER='cc')
    identity = dict(source_revision=revision(source), harness_revision=revision(Path(__file__).resolve().parents[1]),
                    task=args.task, size='smoke' if args.size == 'true' else 'full',
                    environment='actual Ubuntu host; no local floor-image equivalence is claimed')
    (output / 'identity.json').write_text(json.dumps(identity, indent=2) + '\n')
    run(['uname', '-a'], source, output, 'kernel')
    run(['getconf', 'GNU_LIBC_VERSION'], source, output, 'glibc')
    run(['rustc', '-Vv'], source, output, 'rustc')
    run(['cargo', '--version'], source, output, 'cargo')
    run(['cc', '--version'], source, output, 'cc')
    run([sys.executable, '--version'], source, output, 'python')
    if args.task == 'packing':
        run(['cargo', 'test', '--locked', '-p', 'thinkthen', '--test', 'cli_packing_reports', '--no-fail-fast'],
            source, output, 'cli-packing-reports', env=compiler_env)
        run([sys.executable, 'scripts/stress-runner-test'], source, output, 'stress-runner-test')
        return 0
    family, backend = args.task.split('-')
    env = dict(compiler_env)
    for name in ('LD_LIBRARY_PATH', 'LD_PRELOAD', 'THINKTHEN_LIBRARY', 'THINKTHEN_NATIVE_LIBRARY',
                 'THINKTHEN_FLOOR_BUILD', 'THINKTHEN_SOAK_ROUNDS', 'THINKTHEN_SOAK_RECORDS'):
        env.pop(name, None)
    env.update(PYTHONDONTWRITEBYTECODE='1')
    if family == 'rust':
        rust_inputs(source, output, compiler_env, identity)
        env['THINKTHEN_SOAK_ROUNDS'] = '60'
        workload = lambda folder, settings: rust_workload(source, folder, backend, settings)
    else:
        candidate, consumer, library_sha = stage(args.archive.resolve(), output, family)
        identity.update(archive_sha256=ARCHIVE_SHA, consumer_sha256=digest(consumer), library_sha256=library_sha)
        if family == 'swift':
            runtime = candidate / 'prerequisites/swift-runtime/linux'
            env['LD_LIBRARY_PATH'] = str(runtime)
            identity['packaged_runtime_sha256'] = {path.name: digest(path) for path in sorted(runtime.iterdir())}
        if family == 'go':
            cache = candidate / 'runtime-cache'
            cache.mkdir(mode=0o700)
            env['XDG_CACHE_HOME'] = str(cache)
        run(['ldd', str(consumer)], source, output, 'consumer-loader', env=env)
        workload = lambda folder, settings: native_workload(source, folder, family, backend,
                                                           consumer, library_sha, settings)
    run(['cargo', 'build', '--locked', '-p', 'loopback', '--bin', 'loopback'],
        source, output, 'loopback-build', env=compiler_env)
    target = Path(os.environ.get('CARGO_TARGET_DIR', source / 'target')).resolve()
    loopback = target / 'debug/loopback'
    identity.update(loopback_sha256=digest(loopback), external_loopback_used=family != 'rust',
                    fixture_source_revision=revision(source))
    (output / 'identity.json').write_text(json.dumps(identity, indent=2) + '\n')
    env['THINKTHEN_LOOPBACK'] = str(loopback)
    if args.size == 'true':
        env.update(THINKTHEN_SOAK_ROUNDS='8', THINKTHEN_SOAK_RECORDS='100')
    elif family != 'c':
        preflight = output / 'preflight'
        preflight.mkdir()
        status = workload(preflight, dict(env, THINKTHEN_SOAK_ROUNDS='8', THINKTHEN_SOAK_RECORDS='100'))
        if status:
            return status
    status = workload(output, env)
    if family == 'rust' and digest(Path(identity['test_binary'])) != identity['test_binary_sha256']:
        raise ValueError('Rust test binary changed during the workload')
    print(f'{args.task} {identity["size"]} exit={status}; evidence={output}', flush=True)
    return status


if __name__ == '__main__':
    raise SystemExit(main())
