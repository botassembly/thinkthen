#!/usr/bin/env python3
"""Feature: the extended-soak CLI selects one existing healthy case and keeps failures.

Controlled children exercise failure reporting and argument dispatch. No SDK or
resource workload runs. The ordinary runner tests own live resource accounting.
"""
import contextlib
import io
import json
import os
import shutil
import subprocess
import tempfile
from pathlib import Path
import runpy
import sys
from unittest.mock import patch

entry = runpy.run_path(str(Path(__file__).with_name('stress-adapters.py')))
main = entry['main']
base = ['stress-adapters.py', '--surface', 'csharp', '--rounds', '60',
        '--backend', 'openai', '--evidence-path', '/unused/extended.jsonl']
for fail in (False, True):
    calls = []

    def run(command, table, wire, scenario, count, concurrency, rounds, cancel, **options):
        calls.append((command, wire, scenario['name'], count, concurrency, rounds, cancel, options))
        options['result'].update(calls=rounds, rows=count * rounds, failed=0,
                                 backend=wire, scenario=scenario['name'])
        if fail:
            raise RuntimeError('controlled adapter failure') from ValueError('inner reader failure')

    output, errors = io.StringIO(), io.StringIO()
    with patch.dict(os.environ, THINKTHEN_GATE_STRICT='0'), patch.dict(main.__globals__, run=run), patch.object(sys, 'argv', base + ['--', 'installed-adapter', 'argument']), \
            patch.object(Path, 'exists', return_value=True), contextlib.redirect_stdout(output), contextlib.redirect_stderr(errors):
        assert main() == int(fail)
    assert len(calls) == 1, calls
    command, wire, scenario, count, concurrency, rounds, cancel, options = calls[0]
    assert (command, wire, scenario, count, concurrency, rounds, cancel) == (
        ['installed-adapter', 'argument'], 'openai', 'healthy', 100000, 1, 60, False), calls
    assert options['resources'] is True and options['short_gate'] is False, options
    assert options['memory_window'] == (41, 60), options
    assert str(options['evidence_path']) == '/unused/extended.jsonl', options
    report = json.loads(output.getvalue())
    assert report['full'] is True and len(report['cases']) == 1, report
    assert ('error' in report['cases'][0]) is fail, report
    if fail:
        assert report['cases'][0]['cause'] == 'ValueError: inner reader failure', report
    assert json.loads(errors.getvalue()) == report['cases'][0], errors.getvalue()
# Invalid selectors must fail before attempting any adapter.
for flags in (
        ['--rounds', '59', '--backend', 'openai', '--evidence-path', 'unused'],
        ['--rounds', '60', '--backend', 'openai'],
        ['--rounds', '60', '--evidence-path', 'unused'],
        ['--rounds', '60', '--backend', 'openai', '--evidence-path', 'unused', '--sanitizer', 'address'],
        ['--backend', 'openai'], ['--evidence-path', 'unused']):
    with patch.object(sys, 'argv', ['stress-adapters.py', '--surface', 'fixture', *flags, '--', 'adapter']), \
            contextlib.redirect_stderr(io.StringIO()):
        try:
            main()
        except SystemExit as error:
            assert error.code == 2, error
        else:
            raise AssertionError(f'invalid selectors accepted: {flags}')
print('extended soak CLI: one healthy full case, original window/evidence and failure output pass')

# Feature: failed installed adapters keep their final inner diagnostic.
with tempfile.TemporaryDirectory(prefix='stress-diagnostics-') as temporary:
    root = Path(temporary)
    fixture = root / 'loopback'
    fixture.write_text('#!' + sys.executable + "\nimport sys\nprint(1, flush=True)\nfor line in sys.stdin:\n    if line.strip() == 'shutdown': break\n")
    fixture.chmod(0o755)
    adapter = root / 'adapter.py'
    adapter.write_text("import sys\nfor i in range(400): print(f'diagnostic-line-{i:03d}', file=sys.stderr)\nprint('inner adapter cause: invalid fixture payload', file=sys.stderr)\nsys.exit(23)\n")
    result = subprocess.run([sys.executable, str(Path(__file__).with_name('stress-adapters.py')),
        '--surface', 'fixture', '--', sys.executable, str(adapter)],
        env=dict(os.environ, THINKTHEN_LOOPBACK=str(fixture), THINKTHEN_GATE_STRICT='0'), capture_output=True, text=True)
    assert result.returncode == 1, result
    case = json.loads(result.stdout)['cases'][-1]
    assert case['exit_code'] == 23, case
    assert 'inner adapter cause: invalid fixture payload' in case['error'], case
    assert 'diagnostic-line-000' not in case['error'], case
    assert 'RuntimeError' in case['error'], case
    assert json.loads(result.stderr) == case, result.stderr
print('stress diagnostic tail: inner adapter exit and final error retained')

# Feature: the Linux build boundary streams output and preserves its failure.
from test_control import read_line
with tempfile.TemporaryDirectory(prefix='floor-diagnostics-') as temporary:
    root = Path(temporary)
    scripts = root / 'scripts'
    scripts.mkdir()
    source = Path(__file__).resolve().parent
    for name in ('runtime-floor-build', 'release_images.py', 'build_targets.py'):
        shutil.copy2(source / name, scripts / name)
    (scripts / 'native_platform.py').write_text("def current(): return {'rust': 'x86_64-unknown-linux-gnu'}\n")
    (root / 'rust-toolchain.toml').write_text('[toolchain]\nchannel = "stable"\n')
    subprocess.run(['git', 'init', '-q', root], check=True)
    docker = scripts / 'docker'
    docker.write_text('#!' + sys.executable + "\nimport sys\nassert sys.argv[-2:] == ['inner-build', '--example']\nassert 'THINKTHEN_STRESS_FULL=1' in sys.argv\nassert 'THINKTHEN_GATE_STRICT=1' in sys.argv\nassert 'THINKTHEN_PRIVATE_PATTERNS=/patterns-fixture' in sys.argv\nassert not any('synthetic-secret' in argument for argument in sys.argv)\nprint('inner command started', flush=True)\nassert sys.stdin.readline().strip() == 'continue'\nfor i in range(150): print(f'inner-output-{i:03d}')\nsys.stdout.flush()\nprint('inner compiler cause: unsupported symbol', file=sys.stderr, flush=True)\nsys.exit(37)\n")
    docker.chmod(0o755)
    launcher = ("import runpy,sys; sys.platform='linux'; "
                + f"sys.path.insert(0,{str(scripts)!r}); "
                + "sys.argv=['runtime-floor-build','inner-build','--example']; "
                + f"runpy.run_path({str(scripts / 'runtime-floor-build')!r},run_name='__main__')")
    environment = dict(os.environ, HOME=str(root / 'home'), TMPDIR=str(root),
        CARGO_HOME=str(root / 'cargo'), CARGO_TARGET_DIR=str(root / 'target'),
        GOCACHE=str(root / 'go-cache'), THINKTHEN_STRESS_FULL='1',
        THINKTHEN_GATE_STRICT='1', THINKTHEN_PRIVATE_PATTERNS='/patterns-fixture',
        THINKTHEN_API_KEY='synthetic-secret', OPENAI_API_KEY='synthetic-secret',
        THINKTHEN_FLOOR_IMAGE='sha256:' + 'a' * 64,
        PATH=str(scripts) + os.pathsep + os.environ['PATH'])
    environment.pop('THINKTHEN_FLOOR_BUILD', None)
    environment.pop('THINKTHEN_DOCKER_IN_FLOOR', None)
    with subprocess.Popen([sys.executable, '-c', launcher], env=environment,
            cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            stdin=subprocess.PIPE, text=True) as process:
        try:
            assert read_line(process.stdout, timeout=10) == 'inner command started\n'
            output, errors = process.communicate('continue\n', timeout=10)
        except BaseException:
            process.kill()
            process.communicate()
            raise
    assert process.returncode == 37, (process.returncode, output, errors)
    assert 'runtime-floor-build:' in errors and 'inner-build --example' in errors, errors
    assert 'inner compiler cause: unsupported symbol' in errors, errors
    assert 'inner-output-149' in errors and 'inner-output-000' not in errors, errors
    assert 'CalledProcessError' not in errors, errors
print('floor diagnostics: live output, inner cause, bounded tail and child exit37 retained')
