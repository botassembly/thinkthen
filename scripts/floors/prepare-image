#!/usr/bin/env python3
"""Prepare the same baseline recipe for the current machine's architecture."""
import os
from pathlib import Path
import platform
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(root / 'scripts'))
from native_platform import ARM_BASE

if not os.environ.get('PM_JOB'):
    sys.exit('Run image preparation through pm job')
recipe = (root / 'scripts/floors/Dockerfile').read_text()
if platform.machine() in ('aarch64', 'arm64'):
    recipe = '\n'.join('FROM ' + ARM_BASE if line.startswith('FROM ') else line for line in recipe.splitlines()) + '\n'
    recipe = recipe.replace('-linux-x64.tar.xz', '-linux-arm64.tar.xz').replace('.linux-amd64.tar.gz', '.linux-arm64.tar.gz')
print('release prepare: baseline image for ' + platform.machine(), flush=True)
with tempfile.TemporaryFile(mode='w+') as log:
    result = subprocess.run(['docker', 'build', '--label', 'pm.repo=thinkthen',
                             '--label', 'pm.ticket=' + os.environ['PM_JOB'].split()[0],
                             '-t', 'thinkthen-floor-build:glibc2.28', '-f', '-',
                             str(root)], input=recipe, text=True,
                            stdout=log, stderr=subprocess.STDOUT)
    if result.returncode:
        log.seek(0)
        print('\n'.join(log.read().splitlines()[-30:]), file=sys.stderr)
        result.check_returncode()
print('release prepare: baseline image ready')
