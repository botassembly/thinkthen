#!/bin/sh
# Compile the pinned database archives for the approved Mac deployment target.
set -eu
cd "$(dirname "$0")/../.."
duckdb_version=$(python3 scripts/duckdb_release.py --version)
: "${PM_JOB:?Run preparation through pm job}"
. scripts/native-build-env
[ "$(uname -s)" = Darwin ]
source="$HOME/.local/share/thinkthen-build-tools/duckdb/$duckdb_version"
prefix="$THINKTHEN_RUNTIME_PREFIX/duckdb"
mkdir -p "$prefix/static" "$prefix/cli"
rm -rf "$prefix/duckdb-$duckdb_version"
cp -R "$source/duckdb-$duckdb_version" "$prefix/"
cp "$source/cli/duckdb" "$prefix/cli/"
cp "$source"/duckdb-*.whl "$prefix/"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
cmake -S "$prefix/duckdb-$duckdb_version" -B "$work/build" -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_OSX_DEPLOYMENT_TARGET="$MACOSX_DEPLOYMENT_TARGET" \
    -DBUILD_UNITTESTS=OFF -DBUILD_SHELL=OFF -DDISABLE_BUILTIN_EXTENSIONS=ON \
    -DOVERRIDE_GIT_DESCRIBE=v$duckdb_version
cmake --build "$work/build" --target duckdb_static --parallel 2 > "$work/build.log" 2>&1 || { tail -80 "$work/build.log"; exit 1; }
find "$work/build" -name '*.a' -exec cp {} "$prefix/static/" \;
printf '%s\n' "$prefix"
