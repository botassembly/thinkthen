#!/bin/sh
# Check engine edge behavior through its public API and command surfaces.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
cargo fmt --all --check
cargo clippy -p thinkthen --all-targets --features stream --locked -- -D warnings
# Rank producer faults and retry settings have no command controls. Their
# regressions use the existing public Rust API without adding test hooks.
exec cargo test -p thinkthen --features stream --locked \
    --test cli_engine_edges --test retry_cap --test rank_call_failure \
    --test cli_rank --test cli_decide --test cli_usage_diagnostics \
    --test transport --no-fail-fast
