    def test_go_selection_preserves_explicit_home_under_isolated_home(self):
        with tempfile.TemporaryDirectory(prefix='thinkthen-go-home-') as temporary:
            environment = dict(os.environ, HOME=temporary, PYTHONDONTWRITEBYTECODE='1')
            environment.pop('THINKTHEN_GO_HOME', None)
            subprocess.run([sys.executable, '-c', '''
import os
from pathlib import Path
import sys
sys.path.insert(0, 'scripts')
from release_go import command, version
tools = Path.home() / '.local/share/thinkthen-build-tools'
provided = Path.home() / 'prepared-go'
for platform, fallback in (
    ('linux', str(tools / 'gate-go' / ('go' + version()) / 'bin/go')),
    ('darwin', str(tools / ('go' + version()) / 'bin/go')),
    ('win32', 'go'),
):
    sys.platform = platform
    os.environ.pop('THINKTHEN_GO_HOME', None)
    assert command() == fallback, (platform, command(), fallback)
    os.environ['THINKTHEN_GO_HOME'] = str(provided)
    assert command() == str(provided / 'bin/go'), (platform, command())
'''], cwd=ROOT, env=environment, check=True)

