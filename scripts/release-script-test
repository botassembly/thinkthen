    def test_package_and_runtime_versions_refuse_inconsistent_manifests(self):
        with tempfile.TemporaryDirectory(prefix='thinkthen-release-version-') as temporary:
            source = Path(temporary)
            # Copy only tracked manifests, never warm build trees or home config.
            tracked = subprocess.check_output(['git', 'ls-files'], cwd=ROOT, text=True).splitlines()
            names = {'Cargo.toml', 'pyproject.toml', 'package.json', 'package-lock.json',
                     'pom.xml', 'DESCRIPTION', 'build.zig.zon', 'version.rb', 'thinkthen-c.pc.in',
                     'Package.swift', 'go.mod', 'CMakeLists.txt', 'community-versions.json'}
            inputs = {'scripts/release_metadata.py', 'scripts/runtime_floors.py', 'scripts/runtime-floors.json',
                      'scripts/sqlite-package', 'scripts/sqlite-prepare', 'sdk/ruby/thinkthen.gemspec',
                      'extensions/postgres/Makefile', 'extensions/postgres/package.sh', 'databases/duckdb/build.sh'}
            for name in tracked:
                path = Path(name)
                if name in inputs or path.name in names or path.suffix in ('.csproj', '.control', '.sql'):
                    destination = source / path
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(ROOT / path, destination)
            subprocess.run(['git', 'init', '--quiet', source], check=True)
            gitlinks = subprocess.check_output(['git', 'ls-files', '--stage', 'duckdb', 'extension-ci-tools'], cwd=ROOT)
            subprocess.run(['git', 'update-index', '--index-info'], cwd=source, input=gitlinks, check=True)
            command = [sys.executable, source / 'scripts/release_metadata.py']
            result = subprocess.run(command, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            mutations = {
                'sdk/ruby/lib/thinkthen/version.rb': ('0.2.0', '0.0.0'),
                'sdk/swift/Package.swift': ('swift-tools-version: 6.3', 'swift-tools-version: 5.0'),
                'sdk/go/thinkthen/go.mod': ('go 1.23', 'go 1.22'),
                'sdk/c/CMakeLists.txt': ('VERSION "${package_version}"', 'VERSION "0.0.0"'),
                'sdk/cpp/CMakeLists.txt': ('VERSION "${package_version}"', 'VERSION "0.0.0"'),
                'databases/duckdb/CMakeLists.txt': ('LANGUAGES C CXX)', 'VERSION 0.0.0 LANGUAGES C CXX)'),
                'databases/duckdb/community-versions.json': ('d1dc88f950d456d72493df452dabdcd13aa413dd', '0' * 40),
                'scripts/sqlite-package': ('sqlite-3.41.0', 'sqlite-3.54.1'),
                'extensions/postgres/Makefile': ('thinkthen--0.2.0.sql', 'thinkthen--0.0.0.sql'),
                'extensions/postgres/package.sh': ('thinkthen--0.2.0.sql', 'thinkthen--0.0.0.sql'),
            }
            for name, (old, new) in mutations.items():
                with self.subTest(manifest=name):
                    path = source / name
                    original = path.read_text()
                    self.assertIn(old, original)
                    path.write_text(original.replace(old, new))
                    result = subprocess.run(command, capture_output=True, text=True)
                    self.assertNotEqual(result.returncode, 0, 'release gate accepted a wrong version: ' + name)
                    path.write_text(original)

    def test_command_archive_requires_every_indexed_dependency_notice(self):
        from package_inventory import check
        terms = b'the dependency license'
        files = {'LICENSE': b'project license', 'README.md': b'install the command',
                 'thinkthen.1': b'command manual', 'thinkthen': b'command image',
                 'THIRD-PARTY-NOTICES/index.json': json.dumps({'crates': {
                     'dependency-1.0': {'files': {'LICENSE': hashlib.sha256(terms).hexdigest()}}}}).encode(),
                 'THIRD-PARTY-NOTICES/dependency-1.0/LICENSE': terms}
        with tempfile.TemporaryDirectory(prefix='thinkthen-notice-inventory-') as temporary:
            artifact = Path(temporary) / 'command.zip'
            for missing in (None, 'THIRD-PARTY-NOTICES/dependency-1.0/LICENSE', 'THIRD-PARTY-NOTICES/index.json'):
                with self.subTest(missing=missing):
                    with zipfile.ZipFile(artifact, 'w') as archive:
                        for name, data in files.items():
                            if name != missing: archive.writestr(name, data)
                    if missing is None: check('command', artifact, {'thinkthen'})
                    else:
                        with self.assertRaises((AssertionError, ValueError)):
                            check('command', artifact, {'thinkthen'})

    def test_candidate_checker_preserves_the_final_checksum_inventory(self):
        from release_install import checksums
        candidate = runpy.run_path(str(ROOT / 'scripts/release-candidate'))
        with tempfile.TemporaryDirectory(prefix='thinkthen-candidate-check-') as temporary:
            out = Path(temporary)
            (out / 'local_check.py').write_text('message = "verified"\n')
            check = out / 'check'
            check.write_text('import local_check\nprint(local_check.message)\n')
            checksums(out)
            result = candidate['check_candidate'](out, os.environ)
            self.assertEqual(result.stdout.strip(), 'verified')
            self.assertFalse((out / '__pycache__').exists())
            check.write_text('from pathlib import Path\nPath("late-file").write_text("unlisted")\n')
            checksums(out)
            with self.assertRaisesRegex(ValueError, 'incomplete checksum inventory'):
                candidate['check_candidate'](out, os.environ)

    def test_sqlite_notices_identify_each_platforms_built_jansson(self):
        from release_notice_packages import native_notices
        from release_notice_check import declared_notices
        for target, version in (('macos-arm64', '2.14'), ('linux-x86_64', '2.14.1'), ('windows-x86_64', '2.14.1')):
            with self.subTest(target=target):
                files = native_notices('sqlite', target)
                name = 'THIRD-PARTY-NOTICES/native/jansson-' + version + '/LICENSE'
                self.assertEqual(files[name], (ROOT / 'licenses/native' / ('jansson-' + version) / 'LICENSE').read_bytes())
                self.assertEqual(set(files), declared_notices(files))

    def test_windows_smoke_preserves_construction_list_record(self):
        self.windows_smoke('thinkthen ' + version() + ' (backends stub)\n')

    def test_windows_smoke_reads_utf8_fixtures_with_a_windows_text_encoding(self):
        read_text = Path.read_text

        def windows_read_text(path, *args, **kwargs):
            kwargs.setdefault('encoding', 'cp1252')
            return read_text(path, *args, **kwargs)

        with patch.object(Path, 'read_text', windows_read_text):
            self.windows_smoke('thinkthen ' + version() + ' (backends stub)\n')

    def test_windows_smoke_reports_wrong_banner_and_binary(self):
        for banner, status in [('thinkthen 9.0.0 (backends stub)\n', 0),
                               ('thinkthen ' + version() + '1 (backends stub)\n', 0),
                               ('thinkthen ' + version() + ' (contract 0)\n', 0),
                               ('other ' + version() + ' (backends stub)\n', 0),
                               ('thinkthen ' + version() + ' (backends stub)\n', 7)]:
            with self.subTest(banner=banner, status=status), self.assertRaises(AssertionError) as failure:
                self.windows_smoke(banner, status)
            self.assertIn(banner.rstrip(), str(failure.exception))
            self.assertIn('thinkthen.exe', str(failure.exception))
            self.assertIn(hashlib.sha256(b'fixture image').hexdigest(), str(failure.exception))

    def windows_smoke(self, banner, status=0):
        cases = json.loads((ROOT / 'construction/stub.json').read_bytes())
        first = next(case for case in cases if case['request']['question']['function'] == 'decide')
        self.assertEqual(first['request']['records'], [[]])
        with tempfile.TemporaryDirectory(prefix='thinkthen-windows-smoke-') as temporary:
            package = Path(temporary)
            checks = package / 'checks'
            checks.mkdir()
            shutil.copy2(ROOT / 'construction/stub.json', checks / 'stub.json')
            shutil.copy2(ROOT / 'schemas/contract.json', checks / 'contract.json')
            shutil.copy2(ROOT / 'scripts/release/native_cases.py', checks / 'native_cases.py')
            (checks / 'c-consumer.exe').write_bytes(b'fixture consumer')
            for family, files in {'command': ['thinkthen.exe'], 'c': ['bin/thinkthen_ffi.dll']}.items():
                with zipfile.ZipFile(package / (family + '.zip'), 'w') as archive:
                    for name in files:
                        archive.writestr(name, b'fixture image')
            calls = []

            def run(args, **options):
                calls.append((args, options.get('input')))
                if args[-1] == '--version':
                    return subprocess.CompletedProcess(args, status, banner.encode(), b'')
                elif Path(args[-3]).name == 'c-consumer.exe':
                    case = next(case for case in cases if json.loads(args[-2]) == case['request'])
                    output = json.dumps({'rows': case['expected']})
                else:
                    self.assertIn('jsonl', args)
                    self.assertEqual(options['input'], b'[]\n')
                    self.assertEqual(json.loads(options['input']), first['request']['records'][0])
                    output = json.dumps(first['expected'][0])
                return subprocess.CompletedProcess(args, 0, output.encode(), b'')

            build = {'version': version(), 'packages': {'command': 'command.zip', 'c': 'c.zip'}}
            with patch.object(release_windows_check, 'inventory', return_value=build), \
                 patch.object(release_windows_check, 'pe'), \
                 patch.object(release_windows_check, 'wine_executable', return_value='fixture-wine'), \
                 patch.object(release_windows_check.subprocess, 'run', side_effect=run):
                release_windows_check.smoke(package)
            self.assertEqual(len(calls), len(cases) + 2)

    def test_release_assets_have_provenance_after_platform_checks(self):
        workflow = (ROOT / '.github/workflows/release-prepare.yml').read_text()
        bundle = workflow.split('\n  bundle:\n', 1)[1].split('\n  registry-installed:\n', 1)[0]
        draft = workflow.split('\n  draft:\n', 1)[1]
        self.assertNotIn('actions/attest@', bundle)
        self.assertNotIn('id-token: write', bundle)
        self.assertNotIn('attestations: write', bundle)
        self.assertIn('needs: [source, bundle, registry-installed]', draft)
        self.assertIn('id-token: write', draft)
        self.assertIn('attestations: write', draft)
        attest = re.search(r'uses: actions/attest@[0-9a-f]{40}\b', draft)
        self.assertIsNotNone(attest, 'release provenance action must be pinned')
        self.assertIn("subject-path: 'release/*'", draft)
        self.assertIn("if: needs.source.outputs.retry != 'true'", draft)
        self.assertIn("if: needs.source.outputs.retry == 'true'", draft)
        self.assertIn('predicate-path: release/reuse.json', draft)
        self.assertLess(draft.index('uses: actions/download-artifact'), attest.start())
        self.assertLess(attest.start(), draft.index('name: Create a draft for review'))



if __name__ == '__main__':
    unittest.main()
