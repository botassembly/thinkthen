#!/usr/bin/env python3
"""Check release versions, CLI record framing and build attestation contracts."""
import json
import hashlib
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest
from contextlib import contextmanager, nullcontext
from types import SimpleNamespace
from unittest.mock import patch
import zipfile

from release_workflow import ROOT, version
import release_windows_check
import release_windows
import release_windows_sdks


class ReleaseScripts(unittest.TestCase):
    def test_windows_consumer_preserves_os_architecture_while_isolating_user_state(self):
        import release_windows_sdks as sdks
        with tempfile.TemporaryDirectory(prefix='thinkthen-windows-environment-') as temporary:
            scratch = Path(temporary)
            inherited = dict(os.environ, PROCESSOR_ARCHITECTURE='AMD64',
                             HOME='host-home', USERPROFILE='host-profile',
                             THINKTHEN_API_KEY='host-secret')
            with patch.dict(os.environ, inherited, clear=True), patch('release_windows_cache.prepare_cache'):
                environment = sdks.environment(scratch)
            child = subprocess.run([sys.executable, '-c',
                'import json,os; print(json.dumps({key: os.getenv(key) for key in '
                '["PROCESSOR_ARCHITECTURE", "HOME", "USERPROFILE", "THINKTHEN_API_KEY"]}))'],
                env=environment, capture_output=True, text=True, check=True)
            values = json.loads(child.stdout)
            self.assertEqual(values['PROCESSOR_ARCHITECTURE'], inherited['PROCESSOR_ARCHITECTURE'])
            self.assertEqual(values['HOME'], str(scratch / 'home'))
            self.assertEqual(values['USERPROFILE'], str(scratch / 'home'))
            self.assertIsNone(values['THINKTHEN_API_KEY'])

    def test_installed_r_rejects_child_failure_after_valid_rows(self):
        with tempfile.TemporaryDirectory(prefix='thinkthen-r-child-exit-') as temporary:
            scratch = Path(temporary)
            shutil.copy2(ROOT / 'sdk/r/tests/release-cases.R', scratch / 'r-cases.R')
            case = json.loads((ROOT / 'construction/stub.json').read_text())[0]
            fixtures = scratch / 'cases.json'
            fixtures.write_text(json.dumps([case]))
            # A child can print valid rows and still fail during process cleanup.
            (scratch / 'run.R').write_text(
                'a <- commandArgs(TRUE)\n'
                'case <- jsonlite::fromJSON(a[[1]], simplifyVector=FALSE)\n'
                'cat(jsonlite::toJSON(list(rows=case$expected), auto_unbox=TRUE, null="null"))\n'
                'quit(status=7L)\n')
            result = subprocess.run(['Rscript', '--vanilla', scratch / 'r-cases.R', fixtures],
                                    cwd=scratch, capture_output=True, text=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertIn('R child consumer failed with status 7', result.stderr)
            self.assertNotIn('preserves every shared stub row', result.stdout)

    def test_generated_go_smoke_command_exposes_delivered_fixtures(self):
        from release_install import install_note
        with tempfile.TemporaryDirectory(prefix='thinkthen-install-go-') as temporary:
            out = Path(temporary)
            (out / 'build.json').write_text(json.dumps(dict(version=version(), platform='linux-x86_64',
                revision='fixture', node='node', java='java', r='R')))
            (out / 'requirements.json').write_text(json.dumps({'go': {'runtime': 'Go', 'supported_glibc': '2.28'}}))
            release_windows.check_tools(out)
            consumer = out / 'checks/go-consumer'
            consumer.write_text('#!/bin/sh\ntest -f "$THINKTHEN_STUB_CASES"\ntest -f "$THINKTHEN_CASES/../schemas/row.schema.json"\n')
            consumer.chmod(0o755)
            install_note(out)
            command = (out / 'INSTALL.md').read_text().split('```sh\n', 1)[1].split('```', 1)[0]
            environment = {key: value for key, value in os.environ.items() if key not in {'THINKTHEN_CASES', 'THINKTHEN_STUB_CASES'}}
            subprocess.run(['sh', '-eu', '-c', command], cwd=out, env=environment, check=True)

    def test_windows_go_consumer_uses_delivered_canonical_schema(self):
        class GoFinished(BaseException):
            pass
        with tempfile.TemporaryDirectory(prefix='thinkthen-windows-go-schema-') as temporary:
            scratch = Path(temporary).resolve()
            delivered = scratch / 'candidate'
            release_windows.check_tools(delivered)
            checks = delivered / 'checks'
            (checks / 'go').mkdir()
            archive = delivered / 'go.zip'
            with zipfile.ZipFile(archive, 'w') as package:
                package.writestr('go.mod', 'module fixture\n')
            environments = []

            def consumer(*args, **options):
                if args[0] == 'java':
                    raise GoFinished()
                if Path(args[0]).name == 'consumer.exe':
                    fixture = Path(options['env'].get('THINKTHEN_CASES', ''))
                    schema = fixture / '../schemas/row.schema.json'
                    self.assertEqual(schema.read_bytes(), (ROOT / 'schemas/row.schema.json').read_bytes())
                    self.assertEqual(Path(options['env']['THINKTHEN_STUB_CASES']), checks / 'stub.json')
                    self.assertEqual(options['cwd'], scratch)
                    environments.append(options['env'])
                return ''

            def cache(command, root, env, filename):
                self.assertEqual(filename, 'library.dll')
                consumer(*command, env=env, cwd=scratch)

            # Run the delivered Windows entry point through its Go boundary.
            with patch.object(release_windows_sdks, 'os', SimpleNamespace(name='nt', environ={}, pathsep=';')), patch.object(
                    release_windows_sdks, 'environment', return_value={'PATH': ''}), patch.object(
                    release_windows_sdks, 'runtime_environment', return_value={'PATH': ''}), patch.object(
                    release_windows_sdks.tempfile, 'TemporaryDirectory', return_value=nullcontext(str(scratch))), patch.object(
                    release_windows_sdks, 'run', side_effect=consumer), patch('release_windows_cache.check_cache', side_effect=cache):
                with self.assertRaises(GoFinished):
                    release_windows_sdks.full(delivered, {'packages': {'go': 'go.zip'}}, caller_owned=True)
            self.assertEqual(len(environments), 2, 'normal and cache consumers must both run')

    def test_installed_zig_filter_kept_preserves_strict_rows(self):
        with tempfile.TemporaryDirectory(prefix='thinkthen-zig-kept-') as temporary:
            scratch = Path(temporary)
            fixtures = scratch / 'cases.json'
            expected = [{'function': 'filter', 'status': 'answered', 'answer': answer}
                        for answer in [True, False]]
            expected += [{'function': 'filter', 'status': status} for status in ['unsure', 'failed']]
            fixtures.write_text(json.dumps([{'client': {}, 'request': {
                'question': {'function': 'filter'}}, 'expected': expected}]))
            consumer = scratch / 'consumer'
            consumer.write_text('#!' + sys.executable + '\nfrom pathlib import Path\n'
                                'print(Path(__file__).with_name("rows.json").read_text())\n')
            consumer.chmod(0o755)
            rows = [dict(row, kept=row.get('answer') is True) for row in expected]
            for change in ['valid', 'wrong', 'missing', 'numeric', 'extra']:
                with self.subTest(change=change):
                    actual = json.loads(json.dumps(rows))
                    if change == 'wrong':
                        actual[1]['kept'] = True
                    elif change == 'missing':
                        del actual[0]['kept']
                    elif change == 'numeric':
                        actual[0]['kept'] = 1
                    elif change == 'extra':
                        actual[0]['unexpected'] = True
                    (scratch / 'rows.json').write_text(json.dumps(actual))
                    result = subprocess.run([sys.executable, ROOT / 'scripts/release/zig.py',
                                             consumer, fixtures], cwd=scratch, capture_output=True, text=True)
                    if change == 'valid':
                        self.assertEqual(result.returncode, 0, result.stderr)
                    else:
                        self.assertNotEqual(result.returncode, 0, change)

    def test_contract_docs_check_public_tree_and_available_planning(self):
        with tempfile.TemporaryDirectory(prefix='thinkthen-public-docs-') as temporary:
            root = Path(temporary)
            for name in ['scripts/contract-doc-check', 'schemas/contract.json', 'schemas/README.md']:
                target = root / name
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(ROOT / name, target)
            command = [sys.executable, root / 'scripts/contract-doc-check']
            result = subprocess.run(command, cwd=root, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            for name in ['schemas/README.md', 'sdlc/planning/public-contract.md']:
                document = root / name
                original = document.read_text() if document.exists() else ''
                document.parent.mkdir(parents=True, exist_ok=True)
                document.write_text(original + '\n`usage.removed-code`\n')
                result = subprocess.run(command, cwd=root, capture_output=True, text=True)
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(name + ': usage.removed-code', result.stderr)
                document.write_text(original)
            (root / 'schemas/README.md').unlink()
            result = subprocess.run(command, cwd=root, capture_output=True, text=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertIn('schemas/README.md', result.stderr)

    def test_candidate_stages_authoritative_row_schema(self):
        packages = runpy.run_path(str(ROOT / 'scripts/release-candidate'))['language_packages']
        with tempfile.TemporaryDirectory(prefix='thinkthen-candidate-schema-') as temporary:
            out = Path(temporary) / 'candidate'
            out.mkdir()
            source_root = Path(temporary) / 'source'
            shutil.copytree(ROOT / 'schemas', source_root / 'schemas')
            shutil.copytree(ROOT / 'construction', source_root / 'construction')
            shutil.copytree(ROOT / 'scripts', source_root / 'scripts')
            class StopBeforePackages(Exception):
                pass
            def copy(source, target):
                if source == out / 'rust/thinkthen':
                    raise StopBeforePackages()
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target)
            with patch.dict(packages.__globals__, copy=copy, ROOT=source_root), patch.dict(
                    packages.__globals__, host_info=lambda: ('linux-x86_64', 'linux-x64', 'linux-x86-64', 'so')):
                with self.assertRaises(StopBeforePackages):
                    packages(out, version(), out / 'cache', out / 'rust')
            self.assertEqual((out / 'schemas/row.schema.json').read_bytes(),
                             (ROOT / 'schemas/row.schema.json').read_bytes())

    def test_zig_uses_the_compiled_inventory_producer(self):
        build = runpy.run_path(str(ROOT / 'scripts/release-candidate'))['build']
        with tempfile.TemporaryDirectory(prefix='thinkthen-zig-producer-') as temporary:
            scratch = Path(temporary)
            (scratch / 'LICENSE').write_text('fixture project license\n')
            rust = scratch / 'producer/artifacts'
            rust.mkdir(parents=True)
            native = rust / 'libthinkthen_ffi.so'
            native.write_bytes(b'shared release producer library')
            messages = rust.parent / 'artifacts.json'
            messages.write_text('compiled artifact fixture\n')
            out = scratch / 'candidate'
            out.mkdir()

            @contextmanager
            def prepare(*args):
                yield scratch / 'different-routine-cache', rust

            def compiled(target, path, root):
                self.assertEqual(target, 'linux-x86_64')
                self.assertEqual(path, messages)
                return ['compiled-fixture-1.0']

            def run(*args, env):
                self.assertEqual(args[0], 'scripts/zig-package')
                self.assertEqual(Path(env['THINKTHEN_ZIG_NATIVE_FILE']), native)
                args[1].mkdir()
                (args[1] / 'fixture.tar.gz').write_bytes(native.read_bytes())

            noop = lambda *args: None
            replacements = dict(ROOT=scratch, prepare_native=prepare, run=run,
                platform=SimpleNamespace(system=lambda: 'Darwin'),
                host_info=lambda: ('linux-x86_64', 'linux-x64', 'linux-x86-64', 'so'),
                language_packages=lambda *args: ('linux-x86_64', 'linux-x64', scratch / 'cache', None, None),
                cpp_package=noop, ruby_package=noop, swift_package=noop, zig_consumer=noop,
                frame_dependencies=noop, database_packages=noop, finalize=lambda out, *args: out)
            with patch.dict(build.__globals__, replacements), patch('release_sites.crates'), patch(
                    'release_notices.compiled_names', side_effect=compiled):
                build(out, version())
            artifact = out / f'zig/thinkthen-zig-{version()}-linux-x86_64.tar.gz'
            self.assertEqual(artifact.read_bytes(), native.read_bytes())
            self.assertEqual(json.loads((out / 'compiled-crates.json').read_text()),
                             {'target': 'linux-x86_64', 'crates': ['compiled-fixture-1.0']})
            print('Zig producer selection: fixture producer/artifacts/libthinkthen_ffi.so '
                  + hashlib.sha256(native.read_bytes()).hexdigest()
                  + '; compiled input producer/artifacts.json '
                  + hashlib.sha256(messages.read_bytes()).hexdigest())

    def test_jvm_build_payload_precedes_final_notice_checks(self):
        from jvm_repository import verify
        from package_inventory import check

        with tempfile.TemporaryDirectory(prefix='thinkthen-jvm-inventory-') as temporary:
            source = Path(temporary)
            resources = source / 'resources'
            native = resources / 'fixture/libthinkthen_ffi.so'
            native.parent.mkdir(parents=True)
            native.write_bytes(b'engine fixture')
            repository = source / 'repository'
            repository.mkdir()
            jars = []
            for family, folder in [('java', 'sdk/java/library'), ('kotlin', 'sdk/kotlin')]:
                target = source / folder / 'target'
                target.mkdir(parents=True)
                built = target / f'thinkthen-{family}-{version()}.jar'
                with zipfile.ZipFile(built, 'w') as archive:
                    archive.writestr('META-INF/MANIFEST.MF', 'Manifest-Version: 1.0\n')
                    archive.writestr('io/thinkthen/Fixture.class', b'class fixture')
                    if family == 'java':
                        archive.writestr('io/thinkthen/native/fixture/' + native.name, native.read_bytes())
                selected = repository / built.name
                shutil.copy2(built, selected)
                jars.append(selected)
                with self.assertRaisesRegex(ValueError, 'dependency notice inventory'):
                    check(family, selected, set())
            verify(source, jars, resources, 'fixture', native)
            with zipfile.ZipFile(jars[0], 'a') as archive:
                archive.writestr('undeclared.bin', b'undeclared payload')
            with self.assertRaisesRegex(AssertionError, 'undeclared or missing files'):
                verify(source, jars, resources, 'fixture', native)

