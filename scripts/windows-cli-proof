#!/usr/bin/env python3
"""Capture one existing Windows CLI diagnostic and its genuine producer identity."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def proof(folder, case):
    binary = folder / 'cli/thinkthen.exe'
    evidence = folder / 'cli-proof'
    evidence.mkdir(parents=True, exist_ok=True)
    identity = folder / 'cli/identity.json'
    if identity.is_file():
        shutil.copy2(identity, evidence / 'identity.json')
    record = dict(case=case, binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest() if binary.is_file() else None,
                  exit=None)
    command = [sys.executable, str(ROOT / 'scripts/windows-cli-check'), '--binary', str(binary),
               '--diagnostics', str(evidence)]
    if case != 'all':
        command.extend(('--case', case))
    try:
        with (evidence / 'stdout.log').open('wb') as stdout, (evidence / 'stderr.log').open('wb') as stderr:
            result = subprocess.run(command, stdout=stdout, stderr=stderr)
        record['exit'] = result.returncode
        return result.returncode
    finally:
        (evidence / 'result.json').write_text(json.dumps(record, indent=2) + '\n')
        for name in ('stdout.log', 'stderr.log'):
            path = evidence / name
            if path.is_file():
                print(path.read_text(encoding='utf-8', errors='replace'), end='', flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('folder', type=Path)
    parser.add_argument('--case', choices=('forced-exit', 'all'), default='forced-exit')
    args = parser.parse_args()
    sys.exit(proof(args.folder.resolve(), args.case))
