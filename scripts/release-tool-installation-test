#!/usr/bin/env python3
"""Exercise pinned compiler preparation with local archives and real executables."""
from contextlib import ExitStack
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import tempfile
import unittest
from unittest.mock import patch
import zipfile

sys.path.insert(0, str(Path(__file__).resolve().parent))
import release_go as go
import release_workflow_prepare as unix
import release_windows_host as windows
import release_windows_r


class PreparedWindows(Exception):
    pass


class ToolInstallation(unittest.TestCase):
    def test_native_windows_preparation_uses_canonical_sqlite_and_r_pins(self):
        selected = windows.selections()['INPUTS']
        sqlite_url, sqlite_digest = selected['sqlite-amalgamation-3410000.zip']
        r_version = next(name.removeprefix('R-').removesuffix('-win.exe')
                         for name in selected if name.startswith('R-'))
        requirements = json.loads((windows.ROOT / 'scripts/runtime-floors.json').read_text())['runtimes']
        versions = {name: re.search(r'[0-9]+(?:\.[0-9]+)*', requirements[key])[0]
                    for name, key in [('node', 'typescript'), ('ruby', 'ruby'), ('java', 'java'),
                                      ('go', 'go'), ('swift', 'swift'), ('zig', 'zig')]}
        versions['dotnet'] = 'Microsoft.NETCore.App ' + re.search(r'[0-9]+', requirements['csharp'])[0] + '.0'
        for warm in (False, True):
            with self.subTest(warm=warm), tempfile.TemporaryDirectory() as temporary, ExitStack() as stack:
                root = Path(temporary)
                sqlite = root / 'windows-check/bin/sqlite3.exe'
                if warm:
                    sqlite.parent.mkdir(parents=True)
                    sqlite.write_text('already prepared')
                duck = root / 'duck.tar.gz'
                with tarfile.open(duck, 'w:gz'):
                    pass
                archive = root / 'sqlite.zip'
                with zipfile.ZipFile(archive, 'w') as bundle:
                    for name in ('shell.c', 'sqlite3.c'):
                        bundle.writestr('sqlite-amalgamation-3410000/' + name, name)
                fetched, compiled, checked_r = [], [], []
                wrong_r = False

                def fetch(url, destination, digest=None):
                    if url == sqlite_url:
                        self.assertEqual(digest, sqlite_digest)
                        self.assertEqual(Path(destination), root / 'windows-check/sqlite.zip')
                        fetched.append(url)
                        return archive
                    self.assertTrue(url.endswith('/duckdb-cli-windows-amd64.tar.gz'), url)
                    return duck

                def native_run(command, *arguments, **options):
                    if command == 'clang-cl':
                        compiled.append(arguments)
                        self.assertEqual(Path(arguments[3]).read_text(), 'shell.c')
                        self.assertEqual(Path(arguments[4]).read_text(), 'sqlite3.c')
                        self.assertIn('/Fe:' + str(sqlite), arguments)
                        self.assertEqual(arguments[-3:], ('/link', 'advapi32.lib', 'user32.lib'))
                        sqlite.write_text('compiled from pinned sources')
                        return subprocess.CompletedProcess(arguments, 0)
                    if command == 'Rscript':
                        checked_r.append(arguments)
                        return subprocess.CompletedProcess(arguments, 0, 'R ' + ('0.0' if wrong_r else r_version), '')
                    return subprocess.CompletedProcess(arguments, 0, versions[command], '')

                stack.enter_context(patch.object(windows, 'TOOLS', root))
                stack.enter_context(patch.object(release_windows_r, 'runtime'))
                stack.enter_context(patch.object(windows, 'fetch', side_effect=fetch))
                stack.enter_context(patch.object(windows, 'prepare_tool', return_value=root / 'zig.exe'))
                stack.enter_context(patch.object(windows, 'run', return_value=subprocess.CompletedProcess([], 0, windows.zig_version(), '')))
                stack.enter_context(patch.object(windows, 'prepare_msys2'))
                stack.enter_context(patch.object(windows, 'environment', return_value={'PATH': 'controlled'}))
                stack.enter_context(patch.object(windows, 'prepare_swift', side_effect=lambda env, _: env))
                stack.enter_context(patch.object(windows.shutil, 'which', side_effect=lambda command, **_: command))
                stack.enter_context(patch.object(windows, 'native_run', side_effect=native_run))
                windows.native()
                self.assertEqual(fetched, [] if warm else [sqlite_url])
                self.assertEqual(len(compiled), 0 if warm else 1)
                self.assertEqual(checked_r, [('--version',)])
                wrong_r = True
                with self.assertRaisesRegex(ValueError, 'R runtime does not match'):
                    windows.native()
                self.assertEqual(len(compiled), 0 if warm else 1)

    def fixture(self, stack, root, surface):
        tools = root / 'tools'
        version = go.version() if surface == 'go' else windows.zig_version()
        relative = 'bin/go' if surface == 'go' else 'zig.exe' if surface == 'windows' else 'zig'
        output = 'go' + version if surface == 'go' else version
        source = root / 'archive-root'
        compiler = source / relative
        compiler.parent.mkdir(parents=True)
        compiler.write_text('#!/bin/sh\nprintf "%s\\n" "' + output + '"\n')
        compiler.chmod(0o755)
        archive = root / ('tool.zip' if surface == 'windows' else 'tool.tar.xz')
        if surface == 'windows':
            with zipfile.ZipFile(archive, 'w') as zipped:
                zipped.write(compiler, 'archive-root/' + relative)
            duck = root / 'duck.tar.gz'
            with tarfile.open(duck, 'w:gz'):
                pass
        else:
            with tarfile.open(archive, 'w:xz') as tar:
                tar.add(source, arcname='go' if surface == 'go' else 'archive-root')
        module = {'go': go, 'unix': unix, 'windows': windows}[surface]
        stack.enter_context(patch.object(module, 'TOOLS', tools))
        fetched = []

        def fetch(url, destination, *digest):
            fetched.append(url)
            return duck if surface == 'windows' and 'duck' in url else archive

        stack.enter_context(patch.object(module, 'fetch', fetch))
        if surface == 'go':
            destination = go.home()
            action = go.prepare
            stack.enter_context(patch.dict(os.environ))
        else:
            destination = tools / 'zig' / version
            if surface == 'unix':
                stack.enter_context(patch.object(unix, 'current', lambda: {'ruby': 'x86_64-linux'}))
                action = unix.sdk_tools
            else:
                stack.enter_context(patch.object(release_windows_r, 'runtime', lambda: None))
                original_run = windows.run
                stack.enter_context(patch.object(windows, 'run', lambda command, *args, **options: original_run(*(['sh', command] if str(command).endswith('.exe') else [command]), *args, **options)))
                stack.enter_context(patch.object(windows, 'selections', lambda: {'INPUTS': {'duckdb-cli.zip': ('duck', 'digest')}}))
                stack.enter_context(patch.object(windows, 'prepare_msys2', side_effect=PreparedWindows))

                def action():
                    try:
                        windows.native()
                    except PreparedWindows:
                        pass

        return destination, relative, output, action, fetched

    def test_prepare_installs_at_expected_level_and_reuses_the_pinned_compiler(self):
        for surface in ('go', 'unix', 'windows'):
            for state in ('absent', 'empty', 'installed'):
                with self.subTest(surface=surface, state=state), tempfile.TemporaryDirectory() as temporary, ExitStack() as stack:
                    root = Path(temporary)
                    destination, relative, output, action, fetched = self.fixture(stack, root, surface)
                    if state != 'absent':
                        destination.mkdir(parents=True)
                    if state == 'installed':
                        installed = destination / relative
                        installed.parent.mkdir(parents=True, exist_ok=True)
                        installed.write_text('#!/bin/sh\nprintf "%s\\n" "' + output + '"\n')
                        installed.chmod(0o755)
                    for _ in range(2):
                        action()
                        self.assertEqual(subprocess.check_output((*(['sh'] if surface == 'windows' else []), destination / relative, 'version'), text=True).strip(), output)
                    self.assertEqual(sum('ziglang' in url or 'go.dev' in url for url in fetched), 0 if state == 'installed' else 1)

    def test_prepare_rejects_unsafe_or_incorrect_installations_without_removing_contents(self):
        for surface in ('go', 'unix', 'windows'):
            for state in ('file', 'directory-link', 'dangling-directory-link', 'compiler-link', 'compiler-directory', 'conflict', 'wrong-version'):
                with self.subTest(surface=surface, state=state), tempfile.TemporaryDirectory() as temporary, ExitStack() as stack:
                    root = Path(temporary)
                    destination, relative, _, action, _ = self.fixture(stack, root, surface)
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    sentinel = root / 'sentinel'
                    sentinel.write_text('keep')
                    if state == 'file':
                        destination.write_text('keep')
                    elif state in ('directory-link', 'dangling-directory-link'):
                        destination.symlink_to(root / ('archive-root' if state == 'directory-link' else 'missing'), target_is_directory=True)
                    else:
                        destination.mkdir()
                        compiler = destination / relative
                        if state == 'conflict':
                            (destination / 'unknown').write_text('keep')
                        else:
                            compiler.parent.mkdir(parents=True, exist_ok=True)
                            if state == 'compiler-directory':
                                compiler.mkdir()
                            elif state == 'compiler-link':
                                compiler.symlink_to(sentinel)
                            else:
                                compiler.write_text('#!/bin/sh\nprintf "0.0.0\\n"\n')
                                compiler.chmod(0o755)
                    before = sorted((str(path.relative_to(root)), path.lstat().st_mode, path.read_bytes() if path.is_file() else None)
                                    for path in (destination, *destination.rglob('*')))
                    with self.assertRaises((ValueError, OSError)):
                        action()
                    after = sorted((str(path.relative_to(root)), path.lstat().st_mode, path.read_bytes() if path.is_file() else None)
                                   for path in (destination, *destination.rglob('*')))
                    self.assertEqual(after, [row for row in before if not row[0].endswith('.lock')])
                    self.assertEqual(sentinel.read_text(), 'keep')


if __name__ == '__main__':
    unittest.main()
