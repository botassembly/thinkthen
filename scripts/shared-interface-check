#!/bin/sh
# Exercise the shared engine and native caller contract.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
if [ "${1:-}" = generate ] || [ "${1:-}" = affected ] || [ "${1:-}" = c ]; then
    cargo fmt --all
    cargo run --quiet --locked -p thinkthen --example schema
    cargo run --quiet --locked -p thinkthen-ffi --example headers
    python3 sdk/python/relation_type.py
    git add -N sdk/go/thinkthen/codes_generated.go
    git diff --check
    printf 'BEGIN_GENERATED_PATCH\n'
    git diff --binary
    printf 'END_GENERATED_PATCH\n'
    if [ "${1:-}" = generate ]; then exit; fi
    if [ "${1:-}" = c ]; then
        scripts/c-gate
        c++ -std=c++20 -Wall -Wextra -Werror -fsyntax-only -I crates/thinkthen-ffi/include -I sdk/cpp/include sdk/cpp/tests/typed_consumer.cpp
        cargo test --locked -p thinkthen-ffi --lib --test shared_interface --test typed_projection --test consumer --test interface
        exit
    fi
    failed=0
    cargo clippy --workspace --all-targets --features thinkthen/stream --locked --keep-going -- -D warnings || failed=1
    scripts/c-gate || failed=1
    cargo test --workspace --features thinkthen/stream --locked --no-fail-fast || failed=1
    exit "$failed"
fi
failed=0
cargo test --locked -p thinkthen --test shared_interface || failed=1
cargo test --locked -p thinkthen-ffi --test shared_interface || failed=1
exit "$failed"
