#!/usr/bin/env python3
"""Exercise consumer staging without rebuilding the engine or other SDKs."""
import argparse
import ast
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
# swift-gate comes first: every other caller must stage what it builds.
CALLERS = ('swift-gate', 'release-candidate', 'release_windows.py', 'source-install-check',
           'toolbox-native-development')
GENERATED = {'Readme': 'readme.py', 'Examples': 'docs.py', 'Guide': 'surface-example'}


def run(*arguments, **options):
    subprocess.run(list(map(str, arguments)), check=True, **options)


def source(name, revision):
    if revision:
        return subprocess.check_output(['git', 'show', revision + ':scripts/' + name],
                                       cwd=ROOT, text=True)
    return (ROOT / 'scripts' / name).read_text()


def statements(text, start, end):
    """Execute the real staging statements, stopping before compiler invocation."""
    first, last = text.index(start), text.index(end, text.index(start))
    # Preserve compound statements and relative indentation from the recipe.
    import textwrap
    return textwrap.dedent(text[first:last])


def check_consumer(consumer):
    assert not (consumer / 'minor').exists(), 'ABI fixture leaked into ordinary consumer'
    manifest = (consumer / 'Package.swift').read_text()
    for folder in re.findall(r'path: "([^"]+)"', manifest.split('targets: [', 1)[1]):
        if folder != '.':
            path = consumer / folder
            assert path.is_dir(), f'manifest target directory absent: {folder}'
            assert list(path.glob('*.swift')), f'no Swift sources: {folder}'
    assert 'import ThinkThen' in (consumer / 'Examples/Examples.swift').read_text()
    assert 'entries' in json.loads((consumer / 'Examples/toolbox.json').read_text())


def stage(name, revision, root, scratch, package=None):
    """Run one caller's real staging statements and return the folder they staged."""
    scratch.mkdir(parents=True)
    consumer = scratch / 'Consumer'
    environment = dict(ROOT=root, Path=Path, shutil=shutil, sys=sys, run=run,
                       scratch=scratch, consumer=consumer, swift=scratch / 'ThinkThen')
    def copy(original, destination):
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(original, destination)
    environment['copy'] = copy
    text = source(name, revision)
    if name == 'release-candidate':
        body = statements(text, "    consumer = swift.parent / 'Consumer'", '    destination =')
    elif name == 'release_windows.py':
        # Run the complete portable-source staging function, including its real copy loop.
        function = next(node for node in ast.parse(text).body
                        if isinstance(node, ast.FunctionDef) and node.name == 'check_sources')
        body = ast.unparse(function) + '\ncheck_sources(scratch)\n'
        consumer = scratch / 'checks/swift'
    elif name == 'source-install-check':
        body = statements(text, "        swift = scratch / 'swift-consumer'", '        manifest =')
        environment.update(args=argparse.Namespace(readmes=package is not None), package=package)
        consumer = scratch / 'swift-consumer'
    else:
        body = statements(text, 'python3 scripts/swift-consumer-stage', 'swift build ')
        run('sh', '-eu', '-c', body, cwd=root, env=dict(os.environ, scratch=str(scratch)))
        consumer = scratch / 'consumer'
        body = ''
    exec(compile(body, str(ROOT / 'scripts' / name), 'exec'), environment)
    return consumer


def contents(consumer):
    return {path.relative_to(consumer).as_posix(): path.read_bytes()
            for path in consumer.rglob('*') if path.is_file()}


def without(line, root):
    """Overlay the checkout with a shared step that lost one generating line."""
    (root / 'scripts').mkdir(parents=True)
    for parent in (ROOT, ROOT / 'scripts'):
        for path in parent.iterdir():
            link = root / path.relative_to(ROOT)
            if not link.exists():
                link.symlink_to(path)
    step = root / 'scripts/swift-consumer-stage'
    lines = step.read_text().splitlines(keepends=True)
    step.unlink()
    kept = [text for text in lines if line not in text]
    assert len(kept) == len(lines) - 1, 'the shared step must generate each part on one line: ' + line
    step.write_text(''.join(kept))


def staging(revision):
    failures = []
    with tempfile.TemporaryDirectory(prefix='thinkthen-swift-staging-') as temporary:
        folder = Path(temporary)
        expected = None
        for name in CALLERS:
            try:
                consumer = stage(name, revision, ROOT, folder / name)
                check_consumer(consumer)
                files = contents(consumer)
                expected = expected or files
                changed = sorted(path for path in expected.keys() | files.keys()
                                 if expected.get(path) != files.get(path))
                assert not changed, 'differs from swift-gate: ' + ', '.join(changed)
                print(name + ': staged consumer matches swift-gate byte for byte', flush=True)
            except AssertionError as error:
                failures.append(name + ': ' + str(error))
        for part, line in GENERATED.items():
            without(line, folder / part)
            for name in CALLERS:
                try:
                    check_consumer(stage(name, revision, folder / part, folder / (part + '-stage') / name))
                    failures.append(name + ': passed after the shared step lost ' + part)
                except AssertionError as error:
                    if part not in str(error):
                        failures.append(name + ': failed without ' + part + ' for another reason: ' + str(error))
        if not failures:
            print('Removing any generated part from the shared step fails every caller', flush=True)
        package = folder / 'package'
        (package / 'swift').mkdir(parents=True)
        (package / 'swift/README.md').write_text('```swift\nlet client = "installed README"\n```\n')
        consumer = stage('source-install-check', revision, ROOT, folder / 'readmes', package)
        if 'installed README' not in (consumer / 'Readme/Readme.swift').read_text():
            failures.append('source-install-check: --readmes did not stage the installed README')
    if failures:
        raise SystemExit('\n'.join(failures))


def prepared_engine(assets, receipt_path):
    assert sys.platform in ('darwin', 'linux')
    receipt = json.loads(receipt_path.read_text())
    relative = ('osx-arm64/libthinkthen_ffi.dylib' if sys.platform == 'darwin'
                else 'linux-x64/libthinkthen_ffi.so')
    engine = assets / relative
    digest = hashlib.sha256(engine.read_bytes()).hexdigest()
    expected = 'aarch64-apple-darwin' if sys.platform == 'darwin' else 'x86_64-unknown-linux-gnu'
    assert receipt['host'] == expected
    assert receipt['native_production_executed'] is True
    assert digest == receipt['assets'][relative]
    print('Prepared engine provenance: ' + json.dumps(dict(source=receipt['source_revision'],
          native_key=receipt['native_key'], engine_sha256=digest)), flush=True)
    print('Consumer source: ' + subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(), flush=True)
    for name in ('scripts/swift-package', 'scripts/header_contract.py', 'sdk/swift/Package.swift',
                 'sdk/swift/tests/Package.swift', 'sdk/swift/tests/docs.py', 'docs/surfaces/swift.md'):
        print(name + ' sha256 ' + hashlib.sha256((ROOT / name).read_bytes()).hexdigest(), flush=True)
    return engine


def mac_package(assets, receipt_path, revision):
    assert sys.platform == 'darwin', 'the actual package proof requires macOS'
    prepared_engine(assets, receipt_path)
    with tempfile.TemporaryDirectory(prefix='thinkthen-swift-package-') as temporary:
        scratch = Path(temporary)
        candidate = scratch / 'release-candidate'
        candidate.write_text(source('release-candidate', revision))
        namespace = runpy.run_path(str(candidate))
        function = namespace['swift_package']
        function.__globals__['ROOT'] = ROOT
        out = scratch / 'candidate'
        out.mkdir()
        (out / 'checks').mkdir()
        assert not (ROOT / '.swift-installed').exists(), 'proof needs its own clean job checkout'
        try:
            # The real function packages, archives, extracts and compiles the release consumer.
            try:
                function(out, '0.2.0', 'macos-arm64', 'osx-arm64', assets)
            except subprocess.CalledProcessError as error:
                # The production runner tails output; retain the primary compiler diagnostic here.
                print((error.stdout or '') + (error.stderr or ''), file=sys.stderr)
                raise
            installed = scratch / 'relocated'
            shutil.move(out / 'checks/swift', installed)
            shutil.rmtree(ROOT / '.swift-installed')
            environment = dict(os.environ)
            environment.pop('THINKTHEN_LIBRARY', None)
            run(sys.executable, ROOT / 'scripts/release/swift.py', installed / 'Consumer',
                ROOT / 'construction/stub.json', cwd=scratch, env=environment)
            run(installed / 'Consumer', 'surface', cwd=scratch, env=environment)
            print('Actual Mac archive round-trip, release build and relocated consumer surface pass', flush=True)
        finally:
            shutil.rmtree(ROOT / '.swift-installed', ignore_errors=True)


def source_install(assets, receipt_path, revision, resolve_only=False):
    """Run the real source-install Swift recipe against a local version-tag mirror."""
    from contextlib import contextmanager
    from release_metadata import version
    from release_source import stage

    assert sys.platform == ('linux' if resolve_only else 'darwin')
    engine = prepared_engine(assets, receipt_path)
    recipe = source('source-install-check', revision)
    setup = next(node for node in ast.parse(recipe).body
                 if isinstance(node, ast.With))
    swift = next(node for node in setup.body if isinstance(node, ast.With)
                 and ast.unparse(node.items[0].context_expr) == "check('Swift')")
    if resolve_only:
        from release_images import image
        print('Offline source-resolution image: ' + image('swift'), flush=True)
        build = next(i for i, node in enumerate(swift.body)
                     if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call)
                     and isinstance(node.value.func, ast.Name) and node.value.func.id == 'swift_run'
                     and any(isinstance(arg, ast.Constant) and arg.value == 'build'
                             for arg in node.value.args))
        resolve = ast.parse("swift_run('swift', 'package', '--package-path', swift, 'resolve')").body[0]
        swift.body = swift.body[:build] + [resolve]
        ast.fix_missing_locations(swift)
    with tempfile.TemporaryDirectory(prefix='thinkthen-swift-source-install-') as temporary:
        scratch = Path(temporary)
        tag = scratch / 'tag'
        # Use the real release source staging with a previously verified engine.
        # This proof tests source installation, not package notice assembly.
        host = 'linux-x86_64' if resolve_only else 'macos-arm64'
        stage({host: engine}, tag, {})
        run('git', 'init', '--quiet', tag)
        run('git', '-C', tag, 'add', '.')
        run('git', '-C', tag, '-c', 'user.name=Release rehearsal',
            '-c', 'user.email=release@example.invalid', 'commit', '--quiet',
            '-m', 'Stage local Swift source installation')
        run('git', '-C', tag, 'tag', 'v' + version())

        @contextmanager
        def check(name):
            yield
            print('source install ' + name + ': PASS', flush=True)

        environment = dict(os.environ, THINKTHEN_BACKEND='stub')
        environment.pop('THINKTHEN_LIBRARY', None)
        def source_run(*arguments, **options):
            print('Source-install command: ' + json.dumps(list(map(str, arguments))), flush=True)
            run(*arguments, **options)

        namespace = dict(ROOT=ROOT, scratch=scratch, tag=tag, args=argparse.Namespace(readmes=False),
                         run=source_run, check=check, shutil=shutil, sys=sys, os=os, Path=Path,
                         version=version, env=environment)
        print('Source-install recipe: ' + (revision or 'HEAD'), flush=True)
        exec(compile(ast.Module(body=[swift], type_ignores=[]),
                     str(ROOT / 'scripts/source-install-check'), 'exec'), namespace)
        if resolve_only:
            print('Actual offline SwiftPM local version-tag mirror resolution passes', flush=True)
        else:
            run(namespace['binary'], 'surface', cwd=scratch, env=environment)
            print('Actual mirrored source-installed Swift debug consumer and surface pass', flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source-revision', help='exercise the actual recipes at an earlier revision')
    parser.add_argument('--mac-native-assets', '--native-assets', type=Path)
    parser.add_argument('--native-receipt', type=Path)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--mac-source-install', action='store_true',
                        help='run the actual Swift source-install recipe with a local tag mirror')
    modes.add_argument('--linux-source-resolve', action='store_true',
                       help='resolve the actual Swift source mirror in its offline Linux image')
    args = parser.parse_args()
    if (args.mac_source_install or args.linux_source_resolve) and not args.mac_native_assets:
        parser.error('source installation proof requires --native-assets')
    if args.mac_native_assets:
        if not args.native_receipt:
            parser.error('--mac-native-assets requires --native-receipt')
        if args.mac_source_install or args.linux_source_resolve:
            source_install(args.mac_native_assets, args.native_receipt, args.source_revision,
                           resolve_only=args.linux_source_resolve)
        else:
            mac_package(args.mac_native_assets, args.native_receipt, args.source_revision)
    else:
        staging(args.source_revision)
