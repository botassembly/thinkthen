#!/bin/sh
# An external installed-header consumer proves the shared SQL boundary.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-build-env
cargo build --offline --locked -p thinkthen-ffi -p loopback --bin loopback --lib
build_target=${CARGO_TARGET_DIR:-target}
case "$build_target" in /*) ;; *) build_target="$PWD/$build_target" ;; esac
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
mkdir "$scratch/include"
cp crates/thinkthen-ffi/include/thinkthen.h "$scratch/include/"
cc -std=c11 -Wall -Wextra -Werror -pthread -I "$scratch/include" \
  crates/thinkthen-ffi/tests/sql-consumer.c -L "$build_target/debug" -lthinkthen_ffi \
  -Wl,-rpath,"$build_target/debug" -o "$scratch/consumer"
python3 databases/duckdb/tests/bridge.py "$scratch/consumer" "$build_target/debug/loopback"
