#!/bin/sh
# An external installed-header consumer proves the shared SQL boundary.
set -eu
cd "$(dirname "$0")/.."
scripts/header-contract-check
python3 databases/comparison-check.py
. scripts/native-build-env
: "${THINKTHEN_NATIVE_LIBRARY:?Provide the shared current-host native library}"
: "${THINKTHEN_LOOPBACK:?Provide its matching loopback}"
library_directory=$(dirname "$THINKTHEN_NATIVE_LIBRARY")
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
mkdir "$scratch/include"
cp crates/thinkthen-ffi/include/thinkthen.h crates/thinkthen-ffi/include/thinkthen_sql.h "$scratch/include/"
cc -std=c11 -Wall -Wextra -Werror -UNDEBUG -pthread -I "$scratch/include" \
  crates/thinkthen-ffi/tests/sql-consumer.c "$THINKTHEN_NATIVE_LIBRARY" \
  -Wl,-rpath,"$library_directory" -o "$scratch/consumer"
if [ "$(uname -s)" = Darwin ]; then
    engine_id=$(otool -D "$THINKTHEN_NATIVE_LIBRARY" | tail -n 1)
    install_name_tool -change "$engine_id" "$THINKTHEN_NATIVE_LIBRARY" "$scratch/consumer"
fi
python3 databases/duckdb/tests/bridge.py "$scratch/consumer" "$THINKTHEN_LOOPBACK"
