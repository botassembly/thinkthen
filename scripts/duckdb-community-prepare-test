#!/usr/bin/env python3
"""Network preparation regression; run separately from the offline gate."""
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tempfile
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
from duckdb_release import VERSION
sys.path.insert(0, str(ROOT / 'scripts'))
sys.path.insert(0, str(ROOT / 'databases'))
from testing import child_environment


def exercise(home):
    module = runpy.run_path(str(ROOT / 'scripts/release_workflow_prepare.py'))
    action = module['language_inputs']
    state = action.__globals__
    tools = home / '.local/share/thinkthen-build-tools'
    state['TOOLS'] = tools
    original = state['prepared']
    calls = []

    def prepared(*args, **kwargs):
        # Other language downloads are unrelated; keep the real hosted
        # scheduler and community preparation subprocess intact.
        if args[:2] == ('scripts/duckdb-prepare', '--community'):
            calls.append(args)
            return original(*args, **kwargs)
        if args == ('scripts/duckdb-prepare',):
            marker = tools / f'duckdb/{VERSION}/python-wheel'
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.write_text(f'duckdb-{VERSION}-cp313-fixture.whl\n')

    state['prepared'] = prepared
    for name in ('sdk_tools', 'python_frames', 'r_sources'):
        state[name] = lambda: None
    pins = json.loads((ROOT / 'databases/duckdb/community-versions.json').read_text())[VERSION]
    community = tools / f'duckdb-community/{VERSION}'
    env = dict(child_environment(), HOME=str(home))
    # Preserve the selected prepared compiler/interpreter PATH while isolating
    # homes and credentials, just as other database subprocess tests do.
    with patch.dict(os.environ, env, clear=True):
        for temperature in ('cold', 'warm'):
            action()
            assert calls[-1:] == [('scripts/duckdb-prepare', '--community', VERSION)], calls
            for project, pin in pins.items():
                checkout = community / project
                assert checkout.is_dir(), 'hosted preparation omitted ' + project
                actual = subprocess.check_output(['git', '-C', checkout, 'rev-parse', 'HEAD'], text=True).strip()
                assert actual == pin, (project, actual, pin)
            print(temperature + ' hosted preparation creates both pinned community checkouts', flush=True)
        assert len(calls) == 2, calls
        subprocess.run([sys.executable, ROOT / 'databases/duckdb/community-prepare.py', '--check', VERSION],
                       cwd=ROOT, env=env, check=True)
        recipe_env = dict(env, THINKTHEN_DUCKDB_SOURCE=str(community / 'duckdb'),
                          EXTENSION_CI_TOOLS=str(community / 'extension-ci-tools'))
        subprocess.run([sys.executable, ROOT / 'databases/duckdb/tests/community-recipe.py'],
                       cwd=ROOT, env=recipe_env, check=True)
        for project in pins:
            checkout = community / project
            checkout.rename(checkout.with_name(project + '-saved'))
            for defect in ('missing', 'wrong revision'):
                if defect == 'wrong revision':
                    subprocess.run(['git', 'init', '-q', checkout], check=True)
                    subprocess.run(['git', '-C', checkout, '-c', 'user.name=Fixture',
                                    '-c', 'user.email=fixture@example.invalid',
                                    'commit', '-q', '--allow-empty', '-m', 'Unpinned fixture'], check=True)
                result = subprocess.run(['sh', ROOT / 'scripts/duckdb-gate'],
                                        cwd=ROOT, env=env, capture_output=True, text=True)
                assert result.returncode != 0, (project, defect)
                assert str(checkout) in result.stderr, result.stderr
                assert f'run scripts/duckdb-prepare --community {VERSION}' in result.stderr, result.stderr
                assert 'fixture-routing archive' not in result.stderr, result.stderr
                assert not result.stdout.strip(), result.stdout
            shutil.rmtree(checkout)
            checkout.with_name(project + '-saved').rename(checkout)
        print('Missing and wrong-pin source/tools checkouts stop the offline gate before native inputs', flush=True)


with tempfile.TemporaryDirectory(prefix='thinkthen-community-preparation-') as temporary:
    exercise(Path(temporary))
