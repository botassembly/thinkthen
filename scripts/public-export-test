#!/usr/bin/env python3
"""Feature: public exports retain exact product trees and approved ancestry."""
import json
import os
import runpy
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent


class Export(unittest.TestCase):
    def test_planning_scan_checks_tracked_plans_and_agent_instructions(self):
        with tempfile.TemporaryDirectory(prefix='public-planning-') as temporary:
            root = Path(temporary)
            source = root / 'source'
            scripts = source / 'scripts'
            scripts.mkdir(parents=True)
            for name in ('public-export-check', 'words'):
                shutil.copy2(ROOT / 'scripts' / name, scripts / name)
            (scripts / 'native-tools-env').write_text(':\n')
            (source / 'sdlc/planning').mkdir(parents=True)
            paths = (source / 'AGENTS.md', source / 'sdlc/planning/current.md')
            clean = 'Use the build host. The coordinator assigns a reviewer.\n'
            for path in paths:
                path.write_text(clean)
            (source / 'asset.bin').write_bytes(b'\0ExampleAgent\n')
            subprocess.run(['git', 'init', '--quiet'], cwd=source, check=True)
            subprocess.run(['git', 'add', '.'], cwd=source, check=True)
            patterns = root / 'patterns'
            patterns.write_text(r'/home/\S+|/Users/\S+|192\.0\.2\.7|preview\.example\.test'
                                r'|\bExample(?:Agent|Machine|Project|Customer)\b|sk-[A-Za-z0-9]{32}')
            command = [scripts / 'public-export-check', '--planning', patterns]
            env = dict(os.environ, THINKTHEN_GATE_STRICT='1')
            result = subprocess.run(command, env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            for sample in ('/home/example/work', '/Users/example/work', '192.0.2.7',
                           'https://preview.example.test', 'ExampleAgent', 'ExampleMachine',
                           'ExampleProject', 'ExampleCustomer', 'sk-' + 'A' * 32):
                for path in paths:
                    with self.subTest(sample=sample, path=path.name):
                        path.write_text(sample + '\n')
                        result = subprocess.run(command, env=env, capture_output=True, text=True)
                        self.assertNotEqual(result.returncode, 0)
                        self.assertIn(str(path.relative_to(source)) + ':1:', result.stderr)
                        self.assertNotIn(sample, result.stderr, 'scan exposed private contents')
                        path.write_text(clean)
            for path in paths:
                path.write_bytes(b'\0ExampleAgent\n')
                result = subprocess.run(command, env=env, capture_output=True, text=True)
                self.assertNotEqual(result.returncode, 0, 'scan skipped NUL-containing planning text')
                self.assertIn(str(path.relative_to(source)) + ':1:', result.stderr)
                self.assertNotIn('ExampleAgent', result.stderr, 'scan exposed private contents')
                path.write_text(clean)
            routing = source / 'sdlc/pm.json'
            routing.write_text(json.dumps({'mailroom': {'name': 'ExampleAgent'}}))
            subprocess.run(['git', 'add', '.'], cwd=source, check=True)
            result = subprocess.run(command, env=env, capture_output=True, text=True)
            self.assertNotEqual(result.returncode, 0, 'scan skipped internal routing names')
            self.assertIn('sdlc/pm.json:1:', result.stderr)
            patterns.write_text('')
            result = subprocess.run(command, env=env, capture_output=True, text=True)
            self.assertNotEqual(result.returncode, 0, 'scan accepted empty private patterns')

    def test_focused_sdks_require_strict_verification_and_never_run_full_gate(self):
        with tempfile.TemporaryDirectory(prefix='focused-sdk-dispatch-') as temporary:
            root = Path(temporary)
            scripts, binary = root / 'scripts', root / 'bin'
            scripts.mkdir()
            binary.mkdir()
            shutil.copy2(ROOT / 'scripts/public-export-gate', scripts / 'public-export-gate')
            (scripts / 'native-tools-env').write_text(':\n')
            (scripts / 'native-env').write_text('printf "native-env\\n" >> "$EVENTS"\n')
            for path, body in (
                    (binary / 'python3', '[ "$1" = scripts/public_export_gate.py ] && [ "$2" = verify ] || exit 97; printf "verify\\n" >> "$EVENTS"; exit "${VERIFY_STATUS:-0}"'),
                    (scripts / 'hosted-candidate-check', 'printf "sdk %s\\n" "$1" >> "$EVENTS"'),
                    (scripts / 'gate', 'printf "full-gate\\n" >> "$EVENTS"; exit 99')):
                path.write_text('#!/bin/sh\n' + body + '\n')
                path.chmod(0o755)
            events = root / 'events'
            env = dict(os.environ, PATH=str(binary) + os.pathsep + os.environ['PATH'],
                       EVENTS=str(events), CARGO_HOME=str(root), THINKTHEN_LOOPBACK='controlled-loopback')
            command = ['sh', str(scripts / 'public-export-gate'), '--inside-day-one',
                       'evidence', 'registration', 'assets', 'cargo', 'swift', 'postgres', 'patterns']
            result = subprocess.run(command, env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(events.read_text().splitlines(),
                             ['verify', 'native-env', 'sdk --day-one-sdk-checks-inside'])
            events.unlink()
            result = subprocess.run(command, env=env | {'VERIFY_STATUS': '23'},
                                    capture_output=True, text=True)
            self.assertEqual(result.returncode, 23, result.stderr)
            self.assertEqual(events.read_text().splitlines(), ['verify'])
            events.unlink()
            result = subprocess.run([*command[:2], '--inside-soaks', *command[3:]], env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(events.read_text().splitlines(),
                             ['verify', 'native-env', 'sdk --extended-soaks-inside'])
            events.unlink()
            result = subprocess.run([*command[:2], '--inside-soaks-2', *command[3:]], env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(events.read_text().splitlines(),
                             ['verify', 'native-env', 'sdk --extended-soaks-2-inside'])
            events.unlink()
            result = subprocess.run([*command[:2], '--inside-soaks-3', *command[3:]], env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(events.read_text().splitlines(),
                             ['verify', 'native-env', 'sdk --extended-soaks-3-inside'])

    def test_candidate_gate_uses_a_symlinked_temporary_root(self):
        entry = runpy.run_path(str(ROOT / 'scripts/public_export_gate.py'))
        with tempfile.TemporaryDirectory(prefix='candidate-temp-alias-') as temporary:
            root = Path(temporary)
            binary = root / 'bin'
            binary.mkdir()
            docker = binary / 'docker'
            docker.write_text('#!' + sys.executable + '\nimport json,os,sys\nfrom pathlib import Path\n'
                'alias=Path(os.environ["TMPDIR"])\n'
                'assert alias.is_symlink(), str(alias)\n'
                'physical=alias.resolve(strict=True)\nassert physical.is_dir() and alias != physical\n'
                'Path(sys.argv[-7]).joinpath("temporary.json").write_text(json.dumps(dict(alias=str(alias), physical=str(physical))))\n')
            docker.chmod(0o755)
            registration = root / 'registration.json'
            image = 'sha256:' + 'a' * 64
            registration.write_text(json.dumps({'production_receipts': {'linux': {'floor_image': image}}}))
            patterns = root / 'patterns'
            patterns.write_text('controlled private pattern')
            assets = root / 'assets'
            assets.mkdir()
            evidence = root / 'evidence'

            def output(*args):
                if args[:2] == ('git', 'status'):
                    return ''
                self.assertEqual(args[:3], ('docker', 'image', 'inspect'))
                return args[3]

            def run(*args, env):
                self.assertEqual(args[:3], ('scripts/runtime-floor-build', 'scripts/public-export-gate', '--inside'))
                # The controlled child does not launch nested Docker. The real
                # wrapper still owns mounts, stream handling and TMPDIR forwarding.
                environment = dict(env)
                environment.pop('THINKTHEN_DOCKER_IN_FLOOR')
                launcher = ('import runpy,sys; sys.platform="linux"; '
                    + 'sys.path.insert(0,' + repr(str(ROOT / 'scripts')) + '); '
                    + 'sys.argv=' + repr(list(args)) + '; '
                    + 'runpy.run_path(' + repr(str(ROOT / 'scripts/runtime-floor-build')) + ',run_name="__main__")')
                result = subprocess.run([sys.executable, '-c', launcher], cwd=ROOT, env=environment,
                                        capture_output=True, text=True)
                self.assertEqual(result.returncode, 0, result.stderr + result.stdout)
                return result

            arguments = ['public-export-gate', 'host', str(evidence), str(registration),
                str(assets), str(root / 'cargo'), image, image, str(patterns)]
            with patch.dict(entry['main'].__globals__, output=output, run=run, go_home=lambda: root / 'go'), \
                    patch.object(sys, 'argv', arguments), patch.object(sys, 'platform', 'linux'), \
                    patch.object(Path, 'home', return_value=root / 'home'), \
                    patch.dict(os.environ, HOME=str(root / 'home'), PATH=str(binary) + os.pathsep + os.environ['PATH']):
                try:
                    entry['main']()
                finally:
                    retained = evidence / 'failed-scratch.txt'
                    if retained.exists():
                        shutil.rmtree(Path(retained.read_text().strip()))
            observed = json.loads((evidence / 'temporary.json').read_text())
            self.assertNotEqual(observed['alias'], observed['physical'])
            self.assertFalse(Path(observed['physical']).exists(), 'successful candidate scratch survived')

    def test_a_skipped_or_short_soak_refuses_the_receipt(self):
        from stress_resources import METRICS
        entry = runpy.run_path(str(ROOT / 'scripts/public_export_gate.py'))
        rows = [dict(dict.fromkeys(METRICS, 0), completed_round=index) for index in range(1, 61)]

        def text(chosen):
            return ''.join(json.dumps(row) + '\n' for row in [{'completed_round': None}, *chosen])

        # Feature: the two soak halves cover each surface once.
        halves = entry['SOAKS']
        self.assertEqual(set(halves), {'soaks', 'soaks-2', 'soaks-3'})
        self.assertEqual(halves['soaks-3'], ('java-systemone', 'java-openai', 'r-systemone', 'r-openai',
                                             'swift-systemone', 'swift-openai', 'zig-systemone', 'zig-openai'))
        named = [name for part in halves.values() for name in part]
        self.assertEqual(len(named), len(set(named)))
        self.assertEqual(halves['soaks-2'], ('python-systemone', 'python-openai', 'typescript-systemone', 'typescript-openai',
                                             'c-systemone', 'c-openai', 'cpp-systemone', 'cpp-openai', 'go-systemone', 'go-openai'))
        with tempfile.TemporaryDirectory(prefix='soak-receipt-2-') as temporary:
            evidence = Path(temporary)
            for name in halves['soaks-2']:
                (evidence / (name + '.jsonl')).write_text(text(rows))
            entry['soak_receipt'](evidence, 'a' * 40, 'j2', 'soaks-2')
            receipt = json.loads((evidence / 'receipt.json').read_text())
            self.assertEqual(sorted(receipt['soaks']), sorted(halves['soaks-2']))
            # The first half's receipt still needs its own eight soaks.
            with self.assertRaisesRegex(ValueError, 'soak evidence is missing: ruby-systemone.jsonl'):
                entry['soak_receipt'](evidence, 'a' * 40, 'j2')
        with tempfile.TemporaryDirectory(prefix='soak-receipt-') as temporary:
            evidence = Path(temporary)
            for name in halves['soaks']:
                (evidence / (name + '.jsonl')).write_text(text(rows))
            entry['soak_receipt'](evidence, 'a' * 40, 'j1')
            receipt = json.loads((evidence / 'receipt.json').read_text())
            self.assertEqual((receipt['job'], receipt['public'], receipt['verdict']), ('j1', 'a' * 40, 'passed'))
            self.assertEqual(len(receipt['soaks']), 8)
            self.assertEqual(receipt['soaks']['postgres-openai']['measurement_start_round'], 41)
            (evidence / 'receipt.json').unlink()
            (evidence / 'sqlite-openai.jsonl').unlink()
            with self.assertRaisesRegex(ValueError, 'soak evidence is missing: sqlite-openai.jsonl'):
                entry['soak_receipt'](evidence, 'a' * 40, 'j1')
            (evidence / 'sqlite-openai.jsonl').write_text(text(rows[:59]))
            with self.assertRaisesRegex(ValueError, 'soak did not complete 60 rounds: sqlite-openai'):
                entry['soak_receipt'](evidence, 'a' * 40, 'j1')
            self.assertFalse((evidence / 'receipt.json').exists())
        # Feature: a smoke-size soak proves wiring and never writes a passing receipt.
        with tempfile.TemporaryDirectory(prefix='soak-receipt-smoke-') as temporary, \
                patch.dict(os.environ, THINKTHEN_SOAK_ROUNDS='8', THINKTHEN_SOAK_RECORDS='100'):
            evidence = Path(temporary)
            # Memory far above the floor at this size is reported, not judged.
            growing = [dict(row, memory_bytes=row['completed_round'] * 250 * 1024) for row in rows[:8]]
            for name in halves['soaks-3']:
                (evidence / (name + '.jsonl')).write_text(text(growing))
            entry['soak_receipt'](evidence, 'a' * 40, 'j3', 'soaks-3')
            receipt = json.loads((evidence / 'receipt.json').read_text())
            self.assertEqual((receipt['verdict'], receipt['soak_rounds'], receipt['records_per_round']), ('smoke', 8, 100))
            figures = receipt['soaks']['zig-openai']
            self.assertEqual((figures['measurement_start_round'], figures['measurement_end_round']), (5, 8))
            self.assertGreaterEqual(figures['bytes_per_verified_record'], 1)
            self.assertIsNone(figures['floor_bytes_per_verified_record'])

    def test_an_attributed_soak_passes_only_on_its_own_in_use_series(self):
        from stress_resources import METRICS, SOAK_WINDOW, growth
        entry = runpy.run_path(str(ROOT / 'scripts/public_export_gate.py'))
        flat = [dict(dict.fromkeys(METRICS, 0), completed_round=index) for index in range(1, 61)]
        # RSS grows 200,000 bytes a round from round 41, past the 1 byte per record floor.
        grown = [dict(row, memory_bytes=max(0, row['completed_round'] - 40) * 200_000) for row in flat]

        def write(evidence, name, rows):
            (evidence / (name + '.jsonl')).write_text(''.join(json.dumps(row) + '\n' for row in rows))

        with tempfile.TemporaryDirectory(prefix='soak-attribution-') as temporary:
            evidence = Path(temporary)
            for name in entry['SOAKS']['soaks']:
                write(evidence, name, flat)
            # The RSS growth is matched by storage glibc has mapped while its bytes in use and
            # Ruby's heap stay flat: allocator retention.
            held = [dict(row, allocator_in_use_bytes=6_400_000, runtime_heap_bytes=1_000_000,
                         allocator_mapped_bytes=8_000_000 + row['memory_bytes']) for row in grown]
            write(evidence, 'ruby-openai', held)
            entry['soak_receipt'](evidence, 'a' * 40, 'j1')
            receipt = json.loads((evidence / 'receipt.json').read_text())
            self.assertEqual((receipt['verdict'], receipt['attributed']), ('attributed', ['ruby-openai']))
            ruby = receipt['soaks']['ruby-openai']
            # The attributed soak reports the same RSS measure the plain path uses.
            expected = growth(grown, [100_000] * 60, memory_window=SOAK_WINDOW)['metrics']['memory_bytes']
            self.assertFalse(expected['passed'])
            self.assertEqual((ruby['verdict'], ruby['allocator'], ruby['bytes_per_verified_record']),
                             ('attributed', 'glibc', expected['bytes_per_verified_record']))
            self.assertEqual([ruby[key]['late_half_growth_bytes'] for key in ('allocator_in_use', 'runtime_heap', 'outside_allocator')], [0, 0, 0])
            self.assertEqual(receipt['soaks']['ruby-systemone']['verdict'], 'passed')
            (evidence / 'receipt.json').unlink()
            for rows, message in (
                    ([dict(row, allocator_in_use_bytes=row['memory_bytes']) for row in held], 'grew allocator memory in use: ruby-openai'),
                    # Ruby's object heap is mapped outside malloc, so objects retained with flat
                    # allocator memory still fail.
                    ([dict(row, runtime_heap_bytes=row['memory_bytes']) for row in held], 'grew runtime heap: ruby-openai'),
                    (grown, 'lacks allocator memory in use samples: ruby-openai'),
                    ([dict(row, runtime_heap_bytes=None) for row in held], 'lacks runtime heap samples: ruby-openai'),
                    # RSS that grows while glibc's mapped storage stays flat is not memory glibc keeps:
                    # native mappings, another process, or a process not on glibc's allocator.
                    ([dict(row, allocator_mapped_bytes=8_000_000) for row in held], 'grew RSS outside allocator storage: ruby-openai'),
                    ([dict(row, allocator_mapped_bytes=None) for row in held], 'lacks allocator mapped storage samples: ruby-openai'),
                    ([dict(row, descriptors=row['completed_round']) for row in held], 'failed its growth criterion: ruby-openai')):
                write(evidence, 'ruby-openai', rows)
                with self.assertRaisesRegex(ValueError, message):
                    entry['soak_receipt'](evidence, 'a' * 40, 'j1')
            write(evidence, 'ruby-openai', flat)
            write(evidence, 'ruby-systemone', [dict(row, allocator_in_use_bytes=0, runtime_heap_bytes=0, allocator_mapped_bytes=row['memory_bytes']) for row in grown])
            with self.assertRaisesRegex(ValueError, 'failed its growth criterion: ruby-systemone'):
                entry['soak_receipt'](evidence, 'a' * 40, 'j1')
            self.assertFalse((evidence / 'receipt.json').exists())

    def test_private_publication_changes_only_records(self):
        with tempfile.TemporaryDirectory(prefix='landing-equivalence-') as temporary:
            root = Path(temporary)
            env = dict(os.environ, GIT_AUTHOR_NAME='Example', GIT_AUTHOR_EMAIL='example@example.com',
                       GIT_COMMITTER_NAME='Example', GIT_COMMITTER_EMAIL='example@example.com')
            def git(*args):
                return subprocess.check_output(['git', *args], cwd=root, env=env).decode().strip()
            def commit():
                git('add', '.')
                git('commit', '--quiet', '-m', 'Fixture')
                return git('rev-parse', 'HEAD')
            git('init', '--quiet')
            (root / 'sdlc').mkdir()
            (root / 'sdlc/ticket.md').write_text('OPEN\n')
            (root / 'product').write_text('original\n')
            (root / 'unchanged').mkdir()
            (root / 'unchanged/kept').write_text('kept\n')
            gated = commit()
            (root / 'sdlc/ticket.md').write_text('COMPLETE\n')
            pushed = commit()
            command = [sys.executable, ROOT / 'scripts/landing-equivalence', gated,
                       '--repo', root, '--gate-job', 'j123']
            result = subprocess.run([*command, pushed], env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            receipt = json.loads(result.stdout)
            self.assertEqual((receipt['gated_revision'], receipt['pushed_revision'], receipt['gate_job']),
                             (gated, pushed, 'j123'))
            for mutation in ('bytes', 'mode', 'instructions'):
                git('reset', '--hard', pushed)
                if mutation == 'bytes': (root / 'product').write_text('changed\n')
                elif mutation == 'mode': (root / 'product').chmod(0o755)
                else: (root / 'AGENTS.md').write_text('Changed instructions\n')
                changed = commit()
                result = subprocess.run([*command, changed], env=env, capture_output=True, text=True)
                self.assertNotEqual(result.returncode, 0, mutation)
                nested = subprocess.run([*command, changed, '--repo', root / 'unchanged'],
                                        env=env, capture_output=True, text=True)
                self.assertNotEqual(nested.returncode, 0, mutation + ' from nested directory')

    def test_exact_product_tree_parent_and_private_pattern_boundary(self):
        with tempfile.TemporaryDirectory(prefix='public-export-') as temporary:
            root = Path(temporary)
            source = root / 'source'
            source.mkdir()
            env = dict(os.environ, GIT_AUTHOR_NAME='Example', GIT_AUTHOR_EMAIL='example@example.com',
                       GIT_COMMITTER_NAME='Example', GIT_COMMITTER_EMAIL='example@example.com')

            def git(*args, cwd=source):
                return subprocess.check_output(['git', *args], cwd=cwd, env=env).strip()

            public_history = root / 'public-history'
            public_history.mkdir()
            git('init', '--quiet', cwd=public_history)
            (public_history / 'README.md').write_text('Product\n')
            git('add', '.', cwd=public_history)
            git('commit', '--quiet', '-m', 'Public parent', cwd=public_history)
            parent = git('rev-parse', 'HEAD', cwd=public_history).decode()
            git('init', '--quiet')
            (source / 'README.md').write_text('Product\n')
            (source / 'scripts').mkdir()
            for name in ('public-export', 'words'):
                shutil.copy2(ROOT / 'scripts' / name, source / 'scripts' / name)
            gate = source / 'scripts/public-export-gate'
            gate.write_text('#!/bin/sh\nprintf "controlled candidate gate failed\\n"\nexit 23\n')
            gate.chmod(0o755)
            executable = source / 'command'
            executable.write_text('#!/bin/sh\nexit 0\n')
            executable.chmod(0o755)
            (source / 'command-link').symlink_to('command')
            (source / 'AGENTS.md').write_text('ExampleConfidential\n')
            (source / 'sdlc').mkdir()
            (source / 'sdlc/private').write_text('ExampleConfidential\n')
            git('add', '.')
            git('update-index', '--add', '--cacheinfo', '160000,' + parent + ',dependency')
            git('commit', '--quiet', '-m', 'Private source')
            revision = git('rev-parse', 'HEAD').decode()
            absent = subprocess.run(['git', 'cat-file', '-e', parent], cwd=source, capture_output=True)
            self.assertNotEqual(absent.returncode, 0, 'fixture must model a cold private object store')
            patterns = root / 'patterns'
            patterns.write_text('ExampleConfidential')
            command = [sys.executable, str(source / 'scripts/public-export'), '--source', revision,
                       '--project-only', '--parent', parent, '--parent-repository', str(public_history),
                       '--private-patterns', str(patterns)]
            output = root / 'public'
            result = subprocess.run([*command, '--output', str(output)], env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            receipt = json.loads(result.stdout.splitlines()[-1])
            self.assertEqual(receipt['rewrites'], 0)
            self.assertEqual(receipt['source'], revision)
            self.assertFalse((output / 'AGENTS.md').exists())
            self.assertFalse((output / 'sdlc').exists())
            self.assertTrue((output / 'command-link').is_symlink())
            expected = git('ls-tree', '-rz', revision, '--', 'README.md', 'command', 'command-link', 'dependency', 'scripts')
            actual = subprocess.check_output(['git', 'ls-tree', '-rz', 'HEAD'], cwd=output).strip()
            self.assertEqual(actual, expected)
            ancestors = subprocess.check_output(['git', 'rev-list', 'HEAD'], cwd=output).decode().splitlines()
            self.assertEqual(ancestors, [receipt['revision'], parent])
            objects = subprocess.run(['git', 'cat-file', '-e', revision], cwd=output, capture_output=True)
            self.assertNotEqual(objects.returncode, 0, 'private source commit copied')
            # The real export entry point must preserve a gate boundary's failure.
            registration = root / 'registration.json'
            registration.write_text('{}')
            gated = [argument for argument in command if argument != '--project-only']
            evidence = root / 'evidence'
            failed_gate = subprocess.run([*gated, '--output', str(root / 'candidate'),
                '--evidence', str(evidence), '--native-registration', str(registration),
                '--native-assets', str(root), '--cargo-home', str(root),
                '--swift-image', 'fixture-swift', '--postgres-image', 'fixture-postgres'],
                env=env, capture_output=True, text=True)
            self.assertEqual(failed_gate.returncode, 23, failed_gate.stderr)
            gate_receipt = json.loads((evidence / 'export.json').read_text())
            self.assertEqual((gate_receipt['gate'], gate_receipt['gate_exit']), ('FAIL', 23))
            self.assertIn('controlled candidate gate failed', (evidence / 'gate.log').read_text())
            (source / 'README.md').write_text('ExampleConfidential\n')
            git('add', 'README.md')
            git('commit', '--quiet', '-m', 'Expose forbidden fixture')
            bad = command.copy()
            bad[bad.index('--source') + 1] = git('rev-parse', 'HEAD').decode()
            rejected = subprocess.run([*bad, '--output', str(root / 'rejected')], env=env, capture_output=True, text=True)
            self.assertNotEqual(rejected.returncode, 0)
            self.assertIn('forbidden private', rejected.stderr)


if __name__ == '__main__':
    unittest.main()
