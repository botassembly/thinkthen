#!/bin/sh
# Load the staged native extension and drive the shared cases through SQL.
set -eu
cd "$(dirname "$0")/.."
if [ "${1:-}" = --development ]; then exec sh databases/duckdb/tests/development.sh; fi
. scripts/native-build-env
root=$PWD
# The central gate owns the shared SQL ABI consumer.
fixture_archive=${THINKTHEN_SQL_TEST_ARCHIVE:?Provide the shared explicit fixture-routing archive}
build_target=${CARGO_TARGET_DIR:-target}
case "$build_target" in /*) ;; *) build_target="$root/$build_target" ;; esac
export THINKTHEN_DUCKDB_DEPS="$HOME/.local/share/thinkthen-build-tools/duckdb/1.4.3"
if [ -z "${THINKTHEN_SQL_ARCHIVE:-}" ]; then
    cache=$(scripts/native-prepare --path)
    case $(uname -s) in Darwin) platform=osx-arm64 ;; Linux) platform=linux-x64 ;; esac
    THINKTHEN_SQL_ARCHIVE="$cache/$platform/libthinkthen_ffi.a"
fi
export THINKTHEN_SQL_ARCHIVE
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
THINKTHEN_SQL_TEST_BUILD=OFF THINKTHEN_DUCKDB_OUTPUT="$scratch/package" scripts/duckdb-build
python3 databases/duckdb/tests/package-safety.py "$scratch/package/thinkthen.duckdb_extension"
# Round-trip the delivered package before testing the official hosts.
mkdir "$scratch/installed"
tar -czf "$scratch/duckdb.tar.gz" -C "$scratch/package" .
tar -xzf "$scratch/duckdb.tar.gz" -C "$scratch/installed"
python3 databases/duckdb/tests/official-hosts.py "$scratch/installed" "$THINKTHEN_DUCKDB_DEPS"
# The native lifecycle runner and runtime are test fixtures, outside the package.
source=$THINKTHEN_DUCKDB_DEPS/duckdb-1.4.3
case $(uname -s) in
    Darwin) library=$THINKTHEN_DUCKDB_DEPS/lib/libduckdb.dylib; rpath='@loader_path' ;;
    Linux) library=$THINKTHEN_DUCKDB_DEPS/lib/libduckdb.so; rpath='$ORIGIN' ;;
esac
mkdir "$scratch/consumer"
THINKTHEN_SQL_ARCHIVE=$fixture_archive THINKTHEN_SQL_TEST_BUILD=ON THINKTHEN_DUCKDB_OUTPUT="$scratch/fixture" scripts/duckdb-build
cp "$scratch/fixture/thinkthen.duckdb_extension" "$library" "$scratch/consumer/"
c++ -std=c++17 -pthread -Wall -Wextra -Werror -Wno-unused-parameter \
    -I "$source/src/include" -I "$source/third_party/yyjson/include" \
    databases/duckdb/tests/runner.cpp "$THINKTHEN_DUCKDB_DEPS/static/libduckdb_yyjson.a" \
    "$library" -Wl,-rpath,"$rpath" -o "$scratch/consumer/sql"
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
    # Keep per-consumer attribution inside the one merged instrumentation target.
    export LLVM_PROFILE_FILE="$build_target/duckdb-%p-%m.profraw"
fi
python3 databases/duckdb/tests/run.py "$scratch/consumer" "${THINKTHEN_LOOPBACK:-$build_target/debug/loopback}"
python3 databases/duckdb/tests/run.py "$scratch/consumer" "${THINKTHEN_LOOPBACK:-$build_target/debug/loopback}" --limit-only
"$scratch/consumer/sql" "$scratch/consumer/thinkthen.duckdb_extension" --parallel \
    "SELECT count(*) AS total FROM thinkthen_decide((SELECT record_thread(i)::VARCHAR AS record FROM evidence ORDER BY record), 'Ready?')"
community="$HOME/.local/share/thinkthen-build-tools/duckdb-community/1.4.3"
THINKTHEN_DUCKDB_SOURCE="$community/duckdb" EXTENSION_CI_TOOLS="$community/extension-ci-tools" \
    python3 databases/duckdb/tests/community-recipe.py
python3 databases/duckdb/tests/community_cases.py "$scratch/consumer"
python3 - "$root" "$scratch/stale-contract.h" <<'PYTHON'
import json
from pathlib import Path
import sys
root, output = map(Path, sys.argv[1:])
version = json.loads((root / 'schemas/abi.json').read_text())['abi_version']
output.write_text('#include "thinkthen.h"\n#undef THINKTHEN_ABI_VERSION\n#define THINKTHEN_ABI_VERSION ' + str(version + (1 << 16)) + 'u\n')
PYTHON
THINKTHEN_SQL_ARCHIVE=$fixture_archive THINKTHEN_SQL_TEST_BUILD=ON \
    THINKTHEN_DUCKDB_ABI_HEADER="$scratch/stale-contract.h" \
    THINKTHEN_DUCKDB_OUTPUT="$scratch/incompatible" scripts/duckdb-build
python3 databases/duckdb/tests/typed_api.py "$scratch/consumer" \
    --abi-mismatch-extension "$scratch/incompatible/thinkthen.duckdb_extension"
# A compatible future engine may return a code this consumer cannot name.
printf '%s\n' '#include "thinkthen.h"' '#define thinkthen_code_name(value) ((const char *)0)' > "$scratch/unknown-code.h"
THINKTHEN_SQL_ARCHIVE=$fixture_archive THINKTHEN_SQL_TEST_BUILD=ON \
    THINKTHEN_DUCKDB_ABI_HEADER="$scratch/unknown-code.h" \
    THINKTHEN_DUCKDB_OUTPUT="$scratch/unknown-code" scripts/duckdb-build
python3 databases/unknown-code-check.py duckdb "$scratch/consumer/sql" \
    "$scratch/unknown-code/thinkthen.duckdb_extension"
python3 databases/duckdb/tests/scan-gitlinks.py

THINKTHEN_LOOPBACK="${THINKTHEN_LOOPBACK:-$build_target/debug/loopback}" \
    python3 scripts/stress-adapters.py --surface duckdb -- python3 databases/duckdb/tests/stress.py "$scratch/consumer"
python3 scripts/sql-stress-lifetime-test "$root" duckdb "${THINKTHEN_LOOPBACK:-$build_target/debug/loopback}" "$scratch/consumer"
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
    # Retain the actual static consumer for cargo-llvm-cov object discovery.
    cp "$scratch/installed/thinkthen.duckdb_extension" "$build_target/debug/thinkthen-sql.so"
fi
if [ -n "${THINKTHEN_DUCKDB_ARTIFACT_DIR:-}" ]; then
    mkdir -p "$THINKTHEN_DUCKDB_ARTIFACT_DIR"
    cp "$scratch/installed/"* "$THINKTHEN_DUCKDB_ARTIFACT_DIR/"
    cp "$scratch/package/"*-LICENSE "$THINKTHEN_DUCKDB_ARTIFACT_DIR/"
fi
