#!/bin/sh
# Stage a local Go module with the native asset from this build.
set -eu
cd "$(dirname "$0")/.."
scripts/header-contract-check
output=$1
profile=${2:-release}
if [ -e "$output" ]; then echo "package output already exists" >&2; exit 1; fi
build_target=${CARGO_TARGET_DIR:-target}
if [ "$profile" = release ]; then
    cache=$(scripts/native-prepare --path)
    platform=$(python3 scripts/native_platform.py rid)
    case "$(uname -s)" in Darwin) suffix=dylib ;; Linux) suffix=so ;; *) exit 1 ;; esac
    library="$cache/$platform/libthinkthen_ffi.$suffix"
else
    case "$(uname -sm)" in
      'Linux x86_64'|'Linux aarch64') library="$build_target/$profile/libthinkthen_ffi.so" ;;
      'Darwin arm64') library="$build_target/$profile/libthinkthen_ffi.dylib" ;;
      *) echo 'unsupported Go package target' >&2; exit 1 ;;
    esac
fi
mkdir -p "$output/native"
python3 scripts/package_inventory.py stage go "$output"
cp "$library" "$output/native/library"
case "$(uname -s)" in
 Linux) ldd "$library" > "$output/$(python3 scripts/package_inventory.py generated go)" ;;
 Darwin) otool -L "$library" | tail -n +2 > "$output/$(python3 scripts/package_inventory.py generated go)" ;;
esac
