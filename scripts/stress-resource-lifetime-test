#!/usr/bin/env python3
"""Keep checkpoints alive across vanished processes and reject lost observations."""
import errno
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import threading
import unittest
from unittest.mock import patch

from stress_monitor import Monitor
from stress_resources import AccessLost, sample


class Lifetime(unittest.TestCase):
    def test_disappearance_after_discovery(self):
        pid = os.getpid()
        process = Path('/proc') / str(pid)
        for method, location in (('read_bytes', process / 'cmdline'),
                                 ('read_text', process / 'status')):
            original = getattr(Path, method)
            def vanished(path, *args, **kwargs):
                if path == location:
                    raise ProcessLookupError(errno.ESRCH, 'No such process', str(path))
                return original(path, *args, **kwargs)
            with self.subTest(location=location), patch.object(Path, method, vanished):
                sample([pid], backend_port=1)
                if location == process / 'status':
                    with self.assertRaisesRegex(ValueError, 'required live workload PID'):
                        sample([pid], required_pid=pid)

    def test_process_disappears_during_descriptor_read(self):
        pid = os.getpid()
        original = os.readlink
        with socket.socket() as descriptor:
            location = Path('/proc') / str(pid) / 'fd' / str(descriptor.fileno())
            def vanished(path, *args, **kwargs):
                if path == location:
                    raise ProcessLookupError(errno.ESRCH, 'No such process', str(path))
                return original(path, *args, **kwargs)
            with patch('os.readlink', vanished):
                self.assertEqual(sample([pid])['processes'], 0)
                with self.assertRaisesRegex(ValueError, 'required live workload PID'):
                    sample([pid], required_pid=pid)

    def test_network_table_loss_with_observed_socket_is_unverifiable(self):
        pid = os.getpid()
        location = Path('/proc/self/net/tcp')
        original = Path.read_text
        with socket.socket():
            for kind in (ProcessLookupError, FileNotFoundError, PermissionError):
                error = kind(errno.ESRCH if kind is ProcessLookupError else errno.ENOENT
                             if kind is FileNotFoundError else errno.EACCES, 'read failed', str(location))
                def lost(path, *args, **kwargs):
                    if path == location:
                        raise error
                    return original(path, *args, **kwargs)
                with self.subTest(error=kind.__name__), patch.object(Path, 'read_text', lost):
                    with self.assertRaises(AccessLost if kind is PermissionError else kind):
                        sample([pid], backend_port=1, required_pid=pid)

    def test_permission_and_other_errors_remain_failures(self):
        pid = os.getpid()
        location = Path('/proc') / str(pid) / 'cmdline'
        original = Path.read_bytes
        for error in (PermissionError(errno.EACCES, 'denied', str(location)),
                      OSError(errno.EIO, 'read failed', str(location))):
            def denied(path, *args, **kwargs):
                if path == location:
                    raise error
                return original(path, *args, **kwargs)
            with self.subTest(error=type(error).__name__), patch.object(Path, 'read_bytes', denied):
                if isinstance(error, PermissionError):
                    with self.assertRaises(AccessLost) as caught:
                        sample([pid], required_pid=pid)
                    self.assertFalse(caught.exception.exited)
                    self.assertEqual(caught.exception.failure['access'], str(location))
                else:
                    with self.assertRaises(OSError) as caught:
                        sample([pid], required_pid=pid)
                    self.assertIs(caught.exception, error)

    def test_checkpoint_survives_disappearing_child_read(self):
        child = subprocess.Popen([sys.executable, '-c', 'import sys; sys.stdin.read()'], stdin=subprocess.PIPE)
        monitor = None
        try:
            location = Path('/proc') / str(child.pid) / 'cmdline'
            original = Path.read_bytes
            disappeared = threading.Event()
            def vanished_once(path, *args, **kwargs):
                if path == location and not disappeared.is_set():
                    disappeared.set()
                    raise ProcessLookupError(errno.ESRCH, 'No such process', str(path))
                return original(path, *args, **kwargs)
            with patch.object(Path, 'read_bytes', vanished_once):
                monitor = Monitor(lambda: [child.pid])
                disappeared.wait()
                with socket.socket(socket.AF_UNIX) as connection:
                    connection.connect(monitor.path)
                    connection.sendall(json.dumps(dict(pid=os.getpid(), required_pid=child.pid)).encode() + b'\n')
                    self.assertEqual(connection.recv(64), b'sampled\n')
                report = monitor.finish()
                monitor = None
            self.assertNotIn('monitor_error', report)
            self.assertEqual(report['groups']['workload']['required_live_pids'], [child.pid])
            self.assertEqual(len(report['groups']['workload']['round_samples']), 1)
        finally:
            if monitor is not None:
                monitor.finish()
            child.stdin.close()
            child.wait()

    def test_monitor_retains_failure_location(self):
        location = '/proc/123/status'
        error = OSError(errno.EIO, 'read failed', location)
        attempted = threading.Event()
        def failed(*args, **kwargs):
            attempted.set()
            raise error
        with patch('stress_monitor.sample', failed):
            monitor = Monitor(lambda: [])
            attempted.wait()
            report = monitor.finish()
        self.assertIs(monitor.error, error)
        self.assertEqual(report['monitor_error'], str(error))
        self.assertEqual(report['growth']['verdict'], 'unverifiable')
        detail = report['monitor_error_detail']
        self.assertEqual(detail['type'], 'OSError')
        self.assertEqual(detail['errno'], errno.EIO)
        self.assertEqual(detail['filename'], location)
        self.assertIn('in failed', detail['traceback'])


if __name__ == '__main__':
    unittest.main()
