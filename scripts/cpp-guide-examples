#!/usr/bin/env python3
import os
import sys
from pathlib import Path
from cpp_guide_examples import run_cpp
root=Path(__file__).resolve().parent.parent
target=Path(os.environ.get('CARGO_TARGET_DIR',root/'target')).resolve()
os.environ.setdefault('THINKTHEN_LOOPBACK',str(target/'debug/loopback'))
if sys.argv[1:] not in ([],["--contract-only"]):
    raise SystemExit("usage: cpp-guide-examples [--contract-only]")
run_cpp(contract_only=sys.argv[1:]==["--contract-only"])
