#!/usr/bin/env python3
"""Require one clear refusal when a consumer builds the Go SDK with cgo off."""
import os
from pathlib import Path
import subprocess
import tempfile

from release_go import command
from release_source import GO, stage_go_libraries

ROOT = Path(__file__).resolve().parent.parent
REFUSAL = 'undefined: thinkthen_needs_cgo_set_CGO_ENABLED_1_and_install_a_C_compiler'
CONSUMER = '''package main

import tt "github.com/botassembly/thinkthen/sdk/go/thinkthen"

func main() { _, _ = tt.New(tt.Config{}) }
'''

if REFUSAL.removeprefix('undefined: ') not in (ROOT / 'site/src/content/docs/sdks/go.mdx').read_text():
    raise SystemExit('The Go page does not name the cgo refusal')
with tempfile.TemporaryDirectory(prefix='go-no-cgo-') as directory:
    scratch = Path(directory)
    module, consumer = scratch / 'module', scratch / 'consumer'
    subprocess.check_call(['python3', 'scripts/package_inventory.py', 'stage', 'go', module], cwd=ROOT)
    # A refused build never reads the engine, so a placeholder stands in for each one.
    placeholder = scratch / 'engine'
    placeholder.touch()
    (module / 'native').mkdir()
    stage_go_libraries(dict.fromkeys(GO, placeholder), module)
    consumer.mkdir()
    (consumer / 'main.go').write_text(CONSUMER)
    (consumer / 'go.mod').write_text(
        'module consumer\n\ngo 1.23\n\nrequire github.com/botassembly/thinkthen/sdk/go/thinkthen v0.0.0\n\n'
        f'replace github.com/botassembly/thinkthen/sdk/go/thinkthen => {module}\n')
    environment = dict(os.environ, CGO_ENABLED='0', GOPROXY='off', GOSUMDB='off', GOTOOLCHAIN='local', GOWORK='off')
    # darwin/amd64 has no bundled engine but stays a public target.
    for system, arch in {*GO.values(), ('darwin', 'amd64')}:
        target = {'GOOS': system, 'GOARCH': arch}
        for tags in ('', 'thinkthen_system'):
            result = subprocess.run([command(), 'build', '-tags', tags, '-o', os.devnull, '.'], cwd=consumer,
                                    env=environment | target, capture_output=True, text=True)
            output = result.stdout + result.stderr
            print(f'{system}/{arch} tags={tags!r}: exit {result.returncode}\n{output}', flush=True)
            errors = [line for line in output.splitlines() if not line.startswith('#')]
            if result.returncode == 0 or len(errors) != 1 or REFUSAL not in errors[0]:
                raise SystemExit('Go build with cgo off did not give the one clear refusal')
print('Go builds with cgo off give the one clear refusal', flush=True)
