#!/usr/bin/env python3
"""Bounded manual checks: live BINARY BACKEND; live --preflight BACKEND [SURFACE].

Import with runpy.run_path for preflight(backend, surface) and validate_rows(rows,
backend, surface). SURFACE is ordinary or spreadsheets (one CSV, TSV and XLSX).
No import or preflight reads credentials or starts a process.
"""

import copy
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
TEXT_CAP = 25_000
CALL_CAP = 100
TOKEN_CAP = 10_000


def require(condition, message):
    if not condition:
        raise ValueError(message)


def compact(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def source_string(path, pattern):
    matches = re.findall(pattern, (ROOT / path).read_text())
    require(len(matches) == 1, "live contract changed; review the preflight")
    return matches[0]


def fixture():
    """Return only the shared choose request, without its stub answer."""
    cases = json.loads((ROOT / "construction/stub.json").read_text())
    requests = [case["request"] for case in cases
                if case["request"]["question"]["function"] == "choose"]
    require(len(requests) == 1, "expected one shared choose fixture")
    request = requests[0]
    require(request == {"question": {"function": "choose", "question": "Which?",
                                    "choices": ["z", "a"]},
                        "records": ["evidence"]}, "shared live fixture changed")
    return request


def budget(body, text_bytes, runs, retries):
    """One indivisible choose ask per run, with the engine's retry allowance."""
    attempts = runs * (retries + 1)
    totals = {"max_calls": attempts, "text_bytes": text_bytes * attempts,
              # Count the entire wire body at one byte per input token.
              "input_token_bound": len(compact(body).encode("utf-8")) * attempts}
    require(totals["max_calls"] < CALL_CAP, "live call cap exceeded")
    require(totals["text_bytes"] <= TEXT_CAP, "live text cap exceeded")
    require(totals["input_token_bound"] < TOKEN_CAP, "live input token cap exceeded")
    return totals


def preflight(backend, surface="ordinary"):
    """Return the fixed request/settings, exact wire body and conservative budget.

    Consumers must use these settings without overrides and run each request once.
    spreadsheets covers three separate single-record file checks. All other
    surfaces cover one. A choose ask has no dependent round and cannot split.
    """
    require(backend in ("systemone", "openai"), "select systemone or openai")
    require(surface in ("ordinary", "spreadsheets"), "unknown live surface")
    request = fixture()
    # Defaults come from the engine, without consulting environment settings.
    models = re.findall(r'"(?:THINKTHEN_API_KEY|OPENAI_API_KEY)",\s*"([^"]+)"',
                        (ROOT / "crates/thinkthen/src/backend.rs").read_text())
    require(len(models) == 2, "backend defaults changed; review the preflight")
    model = models[("systemone", "openai").index(backend)]
    retry = int(source_string("crates/thinkthen/src/retry.rs",
                             r"const DEFAULT_RETRIES: u32 = (\d+);"))
    state = source_string("crates/thinkthen/src/core/ask.rs",
                          r'const DEFAULT_STATE: &str = "([^"]*)";')
    question = request["question"]
    record = request["records"][0]
    # core/function.rs::quoted and adapter/{systemone,openai}.rs::encode.
    instructions = f'The text is {compact(record)}. {question["question"]}'
    ask = {"type": "choice", "instructions": instructions}
    if backend == "systemone":
        ask["criteria"] = dict.fromkeys(question["choices"])
        body = {"state": state, "model": model, "questions": {"q1": ask}}
    else:
        ask["choices"] = [{"value": choice} for choice in question["choices"]]
        body = {"input": state, "model": model, "questions": [ask]}
    # Include raw evidence again as a conservative allowance for record text.
    text_bytes = sum(len(text.encode("utf-8")) for text in
                     [state, instructions, record, *question["choices"]])
    runs = 3 if surface == "spreadsheets" else 1
    return {"request": request,
            "client": {"backend": backend, "model": model, "batch": 1},
            "max_retries": retry, "runs": runs, "wire_body": body,
            "body_bytes_per_attempt": len(compact(body).encode("utf-8")),
            "text_bytes_per_attempt": text_bytes,
            **budget(body, text_bytes, runs, retry)}


def probability(value):
    return type(value) in (int, float) and math.isfinite(value) and 0 <= value <= 1


def validate_rows(rows, backend, surface="ordinary"):
    """Check choose rows without judging a model's semantic choice."""
    plan = preflight(backend, surface)
    require(isinstance(rows, list) and len(rows) == plan["runs"], "wrong live row count")
    for row in rows:
        require(isinstance(row, dict), "expected a typed row")
        require(row.get("function") == "choose", "expected a choose row")
        require(type(row.get("position")) is int and row["position"] == 1,
                "expected the single input position")
        require(row.get("status") in ("answered", "unsure"), "live row failed")
        require("error" not in row, "successful live row must omit error")
        require(probability(row.get("probability")), "invalid choice probability")
        if row["status"] == "answered":
            require(row.get("answer") in plan["request"]["question"]["choices"],
                    "answer is not an offered choice")
        else:
            require("answer" not in row, "unsure row must omit answer")
        source = row.get("source")
        require(isinstance(source, dict), "missing row source")
        require(source.get("backend") == backend, "wrong source backend")
        require(source.get("model") == plan["client"]["model"], "wrong source model")
        require(isinstance(source.get("question_identity"), str)
                and re.fullmatch(r"[0-9a-f]{64}", source["question_identity"]),
                "invalid question identity")
        if "detail" in row:
            detail = row["detail"]
            require(isinstance(detail, dict) and isinstance(detail.get("labels"), dict),
                    "expected choice probability detail")
            labels = detail["labels"]
            require(set(labels) == set(plan["request"]["question"]["choices"])
                    and all(probability(p) for p in labels.values()), "invalid label probabilities")


def self_test():
    """Offline contract and refusal checks, without credentials or child processes."""
    def refused(call):
        try:
            call()
        except ValueError:
            return
        raise ValueError("expected refusal")

    for backend in ("systemone", "openai"):
        plan = preflight(backend)
        require(plan["max_calls"] == 4, "unexpected retry contract")
        require(preflight(backend, "spreadsheets")["max_calls"] == 12,
                "unexpected spreadsheet budget")
        row = {"function": "choose", "position": 1, "status": "answered", "answer": "z",
               "probability": 0.7, "source": {**plan["client"], "question_identity": "a" * 64},
               "detail": {"labels": {"z": 0.7, "a": 0.3}}}
        validate_rows([row], backend)
        unsure = {key: value for key, value in row.items() if key != "answer"}
        unsure["status"] = "unsure"
        validate_rows([unsure], backend)
        refused(lambda: validate_rows([{**unsure, "answer": None}], backend))
        refused(lambda: validate_rows([{**unsure, "answer": "z"}], backend))
        for result in (row, unsure):
            refused(lambda: validate_rows([{**result, "error": None}], backend))
        for key, value in [("probability", float("nan")), ("answer", "other"),
                           ("status", "failed"), ("position", True), ("function", "tag")]:
            refused(lambda: validate_rows([{**row, key: value}], backend))
        wrong = copy.deepcopy(row)
        wrong["source"]["model"] = "wrong"
        refused(lambda: validate_rows([wrong], backend))
        refused(lambda: validate_rows([], backend))
    refused(lambda: preflight("stub"))
    refused(lambda: preflight("openai", "all"))
    for body, text, runs, retries in [({}, TEXT_CAP + 1, 1, 0), ({}, 0, CALL_CAP, 0),
                                      ({"input": "x" * TOKEN_CAP}, 0, 1, 0)]:
        refused(lambda: budget(body, text, runs, retries))
    print("PASS live preflight, caps and choose rows (offline)")


def main():
    if sys.argv[1:] == ["--self-test"]:
        self_test()
        return 0
    if len(sys.argv) in (3, 4) and sys.argv[1] == "--preflight":
        print(compact(preflight(*sys.argv[2:])))
        return 0
    require(len(sys.argv) == 3, "usage: scripts/live BINARY systemone|openai")
    binary, backend = str(Path(sys.argv[1]).resolve()), sys.argv[2]
    plan = preflight(backend)
    # Presence only; keys remain inherited and unread. Clear all other settings.
    require(all(key in os.environ for key in ("THINKTHEN_API_KEY", "OPENAI_API_KEY")),
            "both standard backend key variables must be present")
    for key in list(os.environ):
        if key.startswith("THINKTHEN_") and key != "THINKTHEN_API_KEY":
            os.environ.pop(key)
    print(compact(plan), flush=True)
    question = plan["request"]["question"]
    command = [binary, "choose", question["question"], "--backend", backend,
               "--model", plan["client"]["model"], "--batch", "1", "--from", "text", "--json"]
    for choice in question["choices"]:
        command += ["--choice", choice]
    result = subprocess.run(command, input=plan["request"]["records"][0], text=True,
                            capture_output=True, check=False)
    # Do not echo arbitrary command diagnostics, which may contain request headers.
    require(result.returncode == 0, "live command failed; inspect diagnostics privately")
    rows = [json.loads(line) for line in result.stdout.splitlines()]
    validate_rows(rows, backend)
    print(compact(rows))
    print(f"PASS choose {backend}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, TypeError, KeyError) as error:
        print(f"FAIL live: {error}", file=sys.stderr)
        sys.exit(1)
