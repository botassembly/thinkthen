#!/usr/bin/env python3
"""Regression checks for release continuation and Windows diagnostic transport."""
import io
from contextlib import redirect_stderr, redirect_stdout
import json
import os
from pathlib import Path
import runpy
import subprocess
import sys
import tarfile
import tempfile
from types import SimpleNamespace
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))


def installed_checks(scripts):
    main = runpy.run_path(str(scripts / 'release-check'))['main']
    groups = ('command', 'python_node', 'native_languages', 'managed', 'extra_languages', 'r_package', 'databases')
    all_pass = 'candidate: all installed packages pass shared stub cases'
    for name, errors, expected in (
        ('all-pass', {}, groups),
        ('early-failure', {'command': ValueError('first consumer failed')}, groups),
        ('multiple-failures', {'python_node': RuntimeError('frame consumer failed'), 'r_package': ValueError('R consumer failed')}, groups),
        ('admission', {'inventory': ValueError('inventory rejected')}, ()),
        ('interrupt', {'python_node': KeyboardInterrupt('stop now')}, groups[:2]),
        ('exit', {'python_node': SystemExit(7)}, groups[:2]),
    ):
        calls, scratches = [], []
        def check(label):
            def call():
                if label != 'inventory':
                    calls.append(label)
                    scratches.append(main.__globals__['SCRATCH'])
                if label in errors:
                    raise errors[label]
            call.__name__ = label
            return call
        with tempfile.TemporaryDirectory() as temporary:
            package = Path(temporary)
            (package / 'build.json').write_text(json.dumps({'platform': 'linux-x86_64', 'version': '0.2.0'}), encoding='utf-8')
            (package / 'checks').mkdir()
            (package / 'checks/stub.json').write_text(json.dumps([{}] * 10), encoding='utf-8')
            output = io.StringIO()
            caught = None
            with patch.dict(main.__globals__, {label: check(label) for label in ('inventory', *groups)}), \
                    patch.object(sys, 'argv', ['release-check', str(package)]), \
                    redirect_stdout(output), redirect_stderr(output):
                try:
                    main()
                except BaseException as error:  # noqa: BLE001 - assert propagation, including interruptions
                    caught = error
            text = output.getvalue()
            assert calls == list(expected), (name, calls, text)
            assert all(not scratch.exists() for scratch in scratches), name
            assert (all_pass in text) == (not errors), (name, text)
            if not errors:
                assert caught is None, caught
            elif name in ('admission', 'interrupt', 'exit'):
                assert caught is next(iter(errors.values())), (name, caught)
                assert ': FAIL' not in text, text
            else:
                assert isinstance(caught, SystemExit) and caught.code, (name, caught)
                for label, error in errors.items():
                    assert f'candidate group {label}: FAIL' in text, text
                    assert f'{type(error).__name__}: {error}' in text, text
                    assert label in str(caught), caught
                assert 'Traceback (most recent call last)' in text, text
            for label in expected:
                if label not in errors:
                    assert text.count(f'candidate group {label}: PASS') == 1, text
        print('installed-check ' + name + ': orchestration verified')


def probe(name, scripts):
    if name == 'installed-checks':
        installed_checks(scripts)
        return
    if name in ('windows', 'windows-loop'):
        sys.path.insert(0, str(scripts))
        import release_windows_sdks
        with patch.object(release_windows_sdks, 'os', SimpleNamespace(name='nt')), \
                patch.object(Path, 'read_text', return_value='[]'), \
                patch.object(release_windows_sdks, 'environment', return_value={'PATH': ''},
                    side_effect=RuntimeError('setup \u2192 \u6f22') if name == 'windows' else None), \
                patch.object(release_windows_sdks, 'runtime_environment', return_value={}), \
                patch.object(release_windows_sdks, 'run', side_effect=RuntimeError('consumer \u2192 \u6f22')):
            try:
                release_windows_sdks.full(ROOT, {'packages': {key: 'missing-\u2192' for key in ('python', 'typescript', 'go', 'java', 'kotlin', 'csharp', 'ruby', 'r', 'c', 'cpp', 'swift', 'zig', 'sqlite', 'duckdb')}}, caller_owned=True)
            except RuntimeError:
                return
        raise AssertionError('setup failed without reporting failure')
    import release_workflow
    import release_registry
    import release_registry_check
    import release_notice_check
    import release_source
    with tempfile.TemporaryDirectory() as temporary:
        package = Path(temporary)
        (package / 'build.json').write_text(json.dumps({'platform': 'linux-x86_64'}), encoding='utf-8')
        calls = []
        def run(*args, **kwargs):
            command = list(map(str, args[0] if len(args) == 1 and isinstance(args[0], list) else args))
            calls.append(command)
            if command[:2] == ['git', 'archive']:
                with tarfile.open(command[command.index('--output') + 1], 'w') as archive:
                    entry = tarfile.TarInfo('sdk/go/thinkthen/go.mod')
                    body = b'module github.com/botassembly/thinkthen/sdk/go/thinkthen\n'
                    entry.size = len(body)
                    archive.addfile(entry, io.BytesIO(body))
                return
            if command[0] == 'git':
                return
            raise RuntimeError('seeded failure: \u2192 \u6f22')
        def stage(libraries, additions, notices):
            if name == 'setup':
                raise RuntimeError('setup \u2192')
            additions.mkdir()
        def environment(scratch):
            if name == 'readmes-existing-home':
                (scratch / 'home').mkdir()
            elif name == 'readmes-file-home':
                (scratch / 'home').write_text('conflicting file', encoding='utf-8')
            return dict(os.environ, HOME=str(scratch / 'home'))
        with patch('platform.system', return_value='Linux'), patch.object(release_workflow, 'validate'), patch.object(release_workflow, 'prepared', run), \
                patch.object(release_workflow, 'run', run), patch.object(subprocess, 'run', run), \
                patch.object(release_registry_check, 'environment', environment), \
                patch.object(release_registry, 'native_libraries', return_value={}), \
                patch.object(release_registry, 'one', return_value=package / 'fake'), \
                patch.object(release_notice_check, 'package_notices', return_value={}), \
                patch.object(release_source, 'stage', stage):
            script = 'qualification-candidate' if name == 'candidate' else 'qualification-readmes' if name.startswith('readmes') else 'source-install-check'
            sys.argv = [script, 'linux-x86_64', str(package), 'revision'] if name == 'candidate' else [script, str(package)]
            try:
                runpy.run_path(str(scripts / script), run_name='__main__')
            except FileExistsError:
                if name != 'readmes-file-home':
                    raise
                print('README: conflicting home file rejected')
                return
            except SystemExit as error:
                if error.code == 0:
                    raise AssertionError('failed stages returned success')
                return
            raise AssertionError('failed stages returned success')


if len(sys.argv) > 1:
    probe(sys.argv[1], Path(sys.argv[2]))
else:
    for name, expected in [
        ('installed-checks', ['installed-check ' + name + ': orchestration verified' for name in ('all-pass', 'early-failure', 'multiple-failures', 'admission', 'interrupt', 'exit')]),
        ('windows', ['candidate Windows ' + language + ': NOT RUN:' for language in ('Python', 'TypeScript', 'Go', 'java', 'kotlin', 'C#', 'Ruby', 'R', 'C', 'C++', 'Swift', 'Zig', 'sqlite', 'duckdb')]),
        ('windows-loop', ['candidate Windows ' + language + ': FAIL:' for language in ('Python', 'TypeScript', 'Go', 'java', 'kotlin', 'C#', 'Ruby', 'R', 'C', 'C++', 'Swift', 'Zig', 'sqlite', 'duckdb')]),
        ('candidate', ['qualification release-check: FAIL', 'qualification source-install-check: FAIL', 'qualification qualification-readmes: FAIL']),
        ('source', ['source install ' + language + ': FAIL' for language in ('Go', 'Swift', 'Zig', 'Ruby')]),
        ('setup', ['source install ' + language + ': NOT RUN: shared setup failed:' for language in ('Go', 'Swift', 'Zig', 'Ruby')]),
        ('readmes', ['README: ' + language + ': FAIL' for language in ('command', 'Python', 'TypeScript', 'c', 'cpp', 'Java', 'Kotlin', 'C#', 'R', 'sqlite', 'duckdb')]),
        ('readmes-existing-home', ['README: ' + language + ': FAIL' for language in ('command', 'Python', 'TypeScript', 'c', 'cpp', 'Java', 'Kotlin', 'C#', 'R', 'sqlite', 'duckdb')]),
        ('readmes-file-home', ['README: conflicting home file rejected']),
    ]:
        result = subprocess.run([sys.executable, __file__, name, os.environ.get('REPORT_ALL_SCRIPTS', str(ROOT / 'scripts'))],
            capture_output=True, env=dict(os.environ, PYTHONIOENCODING='cp1252:strict', PYTHONDONTWRITEBYTECODE='1'))
        output = (result.stdout + result.stderr).decode('cp1252')
        assert result.returncode == 0, output
        for marker in expected:
            assert marker in output, (name, marker, output)
        assert 'UnicodeEncodeError' not in output, output
        print(name + ': all stages reported and final failure retained')
