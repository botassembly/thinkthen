#!/bin/sh
# Check Kotlin's public interface, KDoc and stub-backed cases against the packaged JVM libraries.
# Usage: scripts/kotlin-interface-check [--update-api]
# --update-api rewrites sdk/kotlin/api/thinkthen-kotlin.api and prints it.
set -eu
cd "$(dirname "$0")/.."
root=$PWD
. scripts/native-tools-env
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BACKEND THINKTHEN_BASE_URL THINKTHEN_BATCH CLASSPATH JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS
cargo build --offline --locked -p thinkthen-ffi -p loopback --lib --bin loopback
native_target=${CARGO_TARGET_DIR:-target}
case "$native_target" in /*) ;; *) native_target="$root/$native_target" ;; esac
python3 scripts/jvm-generated
rm -rf sdk/java/library/target/classes sdk/kotlin/target/classes
resource="sdk/java/library/target/classes/io/thinkthen/native/$jvm_platform"
mkdir -p "$resource"
cp "$native_target/debug/$jvm_library" "$resource/"
scratch=$(mktemp -d)
trap 'status=$?; trap - EXIT; set +e; rm -rf "$scratch"; exit "$status"' EXIT
trap 'exit 1' HUP INT TERM
python3 scripts/jvm_repository.py seed "$cache/m2" "$scratch/m2"
mvn -o -B -q -f sdk/java/pom.xml -Dmaven.repo.local="$scratch/m2" install -DskipTests
python3 sdk/kotlin/tests/api_dump.py "$JAVA_HOME/bin/javap" "$(ls sdk/kotlin/target/thinkthen-kotlin-*.jar)" sdk/kotlin/api/thinkthen-kotlin.api "$@"
python3 sdk/kotlin/tests/kdoc_check.py sdk/kotlin/src/main/kotlin
python3 scripts/jvm_repository.py consumer "$root" "$scratch/consumer"
cd "$scratch/consumer"
if ! mvn -o -B -Dmaven.repo.local="$scratch/m2" package dependency:build-classpath -Dmdep.outputFile="$scratch/classpath" > "$scratch/consumer.log" 2>&1; then
    grep -E '^\[(WARNING|ERROR)\]' "$scratch/consumer.log" >&2
    exit 1
fi
classpath="target/classes:$(cat "$scratch/classpath")"
mkdir -p "$scratch/home"
XDG_CACHE_HOME="$scratch/home/.cache"
THINKTHEN_LOOPBACK="$native_target/debug/loopback"
THINKTHEN_API_KEY=sk-test-0123456789
export XDG_CACHE_HOME THINKTHEN_LOOPBACK THINKTHEN_API_KEY
run() { "$JAVA_HOME/bin/java" "-Duser.home=$scratch/home" --enable-native-access=ALL-UNNAMED -cp "$classpath" "$@"; }
run KotlinCasesKt "$root/construction/stub.json"
run consumer.SdkConventionCasesKt
run consumer.SurfaceCasesKt "$root/conformance"
run consumer.ConformanceCasesKt "$root/conformance/typed"
run consumer.FlowCasesKt "$root/conformance/typed"
run consumer.AbiAndCodesKt registry "$root/schemas/contract.json"
THINKTHEN_BACKEND=stub run consumer.EnvironmentCasesKt

python3 - "$root/sdk/kotlin/tests/compile-fail" <<'PYTHON'
from pathlib import Path
import sys
for case in Path(sys.argv[1]).glob('*.kt.fail'):
    Path('src/main/kotlin', case.name.removesuffix('.fail')).write_text(case.read_text())
PYTHON
if mvn -o -B -q -Dmaven.repo.local="$scratch/m2" process-classes > "$scratch/refusals.log" 2>&1; then
    echo 'Kotlin accepted invalid public API expressions' >&2
    exit 1
fi
python3 - "$root/sdk/kotlin/tests/compile-fail" "$scratch/refusals.log" <<'PYTHON'
from pathlib import Path
import sys
text = Path(sys.argv[2]).read_text()
for case in sorted(Path(sys.argv[1]).glob('*.kt.fail')):
    name = case.name.removesuffix('.fail')
    assert name + ':' in text, (name, text)
    expected = [line.removeprefix('// Expect: ') for line in case.read_text().splitlines() if line.startswith('// Expect: ')]
    for message in expected:
        assert any(name + ':' in line and message in line for line in text.splitlines()), (name, message, text)
    print('Kotlin compile refusal: ' + name)
PYTHON
echo 'Kotlin interface checks pass'
