#!/bin/sh
# Exercise the typed Go API with one isolated debug engine and a staged consumer.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
examples_only=0
cache_only=0
if [ "${1:-}" = --cache-only ]; then cache_only=1; shift; fi
if [ "${1:-}" = --examples-only ]; then examples_only=1; set -- --readme-only; fi
if [ "${1:-}" != --readme-only ]; then . scripts/zig-env; fi
root=$PWD
# Development can check code while separately authored examples are changing.
# The default routine and source gate always execute both docs examples.
code_only=0
if [ "${1:-}" = --code-only ]; then code_only=1; shift; fi
if [ -n "${THINKTHEN_GO_ENGINE:-}" ] && [ "${1:-}" != --readme-only ] && [ "$cache_only" = 0 ]; then
    : "${THINKTHEN_LOOPBACK:?Provide the matching loopback for the prepared engine}"
fi
go() { "$root/scripts/go-build" "$@"; }
# The prepared floor compiler keeps this check compatible with the declared module floor.
THINKTHEN_GO_HOME=${THINKTHEN_GO_HOME:-$(python3 -c 'import sys; sys.path.insert(0,"scripts"); from release_go import home; print(home())')}
test -x "$THINKTHEN_GO_HOME/bin/go"
PATH="$THINKTHEN_GO_HOME/bin:$PATH"
export PATH THINKTHEN_GO_HOME GOTOOLCHAIN=local
test "$(go env GOVERSION)" = "go$(python3 -c 'import sys; sys.path.insert(0,"scripts"); from release_go import version; print(version())')"
test -z "$(gofmt -l sdk/go/thinkthen/*.go sdk/go/tests/*.go)"
export GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=1
export CARGO_TARGET_DIR="${THINKTHEN_GO_TARGET:-$PWD/target-go-api}"
scratch=$(mktemp -d)
trap 'gate_status=$?; trap - EXIT; set +e; rm -rf "$scratch"; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
case "$(uname -s)" in Darwin) suffix=dylib ;; *) suffix=so ;; esac
if [ -n "${THINKTHEN_GO_ENGINE:-}" ]; then
    # The caller owns preparation and validates unchanged native inputs.
    test -f "$THINKTHEN_GO_ENGINE"
    if [ "${1:-}" != --readme-only ] && [ "$cache_only" = 0 ]; then test -x "$THINKTHEN_LOOPBACK"; fi
    python3 scripts/package_inventory.py stage go "$scratch/module"
    mkdir -p "$scratch/module/native"
    cp "$THINKTHEN_GO_ENGINE" "$scratch/module/native/library"
else
    cargo build --locked -p thinkthen-ffi -p loopback
    scripts/go-package "$scratch/module" debug
    THINKTHEN_GO_ENGINE="$CARGO_TARGET_DIR/debug/libthinkthen_ffi.$suffix"
    THINKTHEN_LOOPBACK="$CARGO_TARGET_DIR/debug/loopback"
fi
python3 - "$scratch/module" "$THINKTHEN_GO_ENGINE" <<'PYTHON'
from pathlib import Path
import sys
sys.path.insert(0, 'scripts')
from native_platform import current
from release_source import stage_go_libraries
stage_go_libraries({current()['platform']: Path(sys.argv[2])}, Path(sys.argv[1]))
PYTHON
if [ "${1:-}" != --readme-only ] && [ "$cache_only" = 0 ]; then
    if [ -n "${THINKTHEN_NATIVE_FIXTURES:-}" ]; then
        test -d "$THINKTHEN_NATIVE_FIXTURES"
    else
        scripts/native-fixtures --engine "$THINKTHEN_GO_ENGINE" --output "$scratch/native"
        THINKTHEN_NATIVE_FIXTURES="$scratch/native"
    fi
fi
if [ "${1:-}" != --readme-only ] && [ "$cache_only" = 0 ] && [ -z "${THINKTHEN_MALFORMED_ROW_FIXTURES:-}" ]; then
    THINKTHEN_MALFORMED_ROW_FIXTURES="$scratch/malformed"
    for kind in invalid-json unanswered-answer unknown-function; do
        scripts/abi-minor-check --native "$THINKTHEN_GO_ENGINE" --malformed-row "$kind" \
            --output "$THINKTHEN_MALFORMED_ROW_FIXTURES/$kind"
    done
    export THINKTHEN_MALFORMED_ROW_FIXTURES
fi
mkdir -p "$scratch/consumer" "$scratch/home" "$scratch/tmp"
cp sdk/go/tests/*.go sdk/go/tests/go.mod "$scratch/consumer/"
export THINKTHEN_CONTRACT="$root/schemas/contract.json" THINKTHEN_BOUNDARY_SOURCE="$root/crates/thinkthen/src/core/function/recognize.rs"
export THINKTHEN_LOOPBACK THINKTHEN_CASES="$root/conformance" THINKTHEN_NATIVE_FIXTURES THINKTHEN_HEADER="$scratch/module/thinkthen.h" THINKTHEN_GO_CODES="$scratch/module/codes_generated.go"
unset THINKTHEN_BACKEND THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH THINKTHEN_LIBRARY
export HOME="$scratch/home" TMPDIR="$scratch/tmp"
# os.UserCacheDir uses XDG_CACHE_HOME on Linux. Own the actual cache root,
# including its permissions, instead of inheriting a runner's cache or umask.
case "$(uname -s)" in Darwin) loader_cache="$HOME/Library/Caches" ;; *) loader_cache="$HOME/.cache" ;; esac
mkdir -p "$loader_cache"
chmod 700 "$loader_cache"
export XDG_CACHE_HOME="$loader_cache"
cd "$scratch/consumer"
go mod edit -replace="github.com/botassembly/thinkthen/sdk/go/thinkthen=$scratch/module"
# Run the documented system-library commands against the installed C package.
system_readme() {
    cmake -S "$root/sdk/c" -B "$scratch/system-build" \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_PREFIX="$scratch/system-readme/thinkthen" \
        -DTHINKTHEN_FFI_LIBRARY="$THINKTHEN_GO_ENGINE" \
        -DTHINKTHEN_FFI_INCLUDE_DIR="$scratch/module"
    cmake --install "$scratch/system-build"
    cp "$scratch/consumer/go.mod" "$scratch/system-readme/go.mod"
    (unset LD_LIBRARY_PATH DYLD_LIBRARY_PATH CGO_LDFLAGS
        python3 "$root/scripts/readme-example" "$scratch/module/README.md" go "$scratch/system-readme/main.go")
}
if [ "$code_only" = 0 ] && [ "$cache_only" = 0 ]; then (export THINKTHEN_BACKEND=stub; system_readme); fi

if [ "${1:-}" = --readme-only ]; then
    if [ "$examples_only" = 1 ]; then python3 "$root/sdk/go/check-examples"; fi
    exit 0
fi
loader_cache_check() {
    go test -c -o "$scratch/loader-consumer"
    # Start cold even when earlier API/examples have already loaded the engine.
    rm -rf "$loader_cache/thinkthen"
    python3 "$root/scripts/loader-cache-check" --checksum "$loader_cache" "$scratch/loader-consumer" -test.run='^TestSharedStub$'
}
if [ "$cache_only" = 1 ]; then
    go test -count=1 -v -run='^TestNativeTemporaryCache$' .
    loader_cache_check
    exit 0
fi
# check-examples runs every complete program; surface-example owns the collection example.
if [ "$code_only" = 0 ]; then
python3 "$root/sdk/go/check-examples"
go test -c -o "$scratch/guide-contract"
THINKTHEN_GO_GUIDE_TEST_COMMAND="$scratch/guide-contract" THINKTHEN_GO_GUIDE_MODULE="$scratch/module" python3 "$root/scripts/guide-examples" --surface go
fi
go version
staticcheck -version
staticcheck_pin=$(python3 - "$root/scripts/release-tools.json" <<'PYTHON'
import json
import sys
print(json.load(open(sys.argv[1]))['staticcheck'])
PYTHON
)
python3 - "$root/scripts" "$(command -v staticcheck)" <<'PYTHON'
from pathlib import Path
import sys
sys.path.insert(0, sys.argv[1])
from release_host_tools import verify_source_checker
verify_source_checker(Path(sys.argv[2]))
PYTHON
go vet github.com/botassembly/thinkthen/sdk/go/thinkthen ./...
# The pinned entry variant omits SA4023 at registration because -checks only
# filters diagnostics after execution. Every other inherited analyzer runs.
staticcheck github.com/botassembly/thinkthen/sdk/go/thinkthen ./...
mkdir -p "$CARGO_TARGET_DIR"
go test -race -count=1 github.com/botassembly/thinkthen/sdk/go/thinkthen
go test -race -count=1 -coverpkg=github.com/botassembly/thinkthen/sdk/go/thinkthen -coverprofile="$CARGO_TARGET_DIR/go-coverage.out" "$@" ./...
loader_cache_check
python3 "$root/scripts/native-lookup-check" --embedded "$THINKTHEN_GO_ENGINE" -- "$scratch/loader-consumer" -test.run='^TestSharedStub$'
# darwin/amd64 has no bundled engine, but remains a compilable public module.
if [ "$(uname -s)" = Darwin ]; then
    mkdir unsupported
    cat > unsupported/main.go <<'GO'
package main
import (
    "fmt"
    "strings"
    tt "github.com/botassembly/thinkthen/sdk/go/thinkthen"
)
func main() {
    _, err := tt.New(tt.Config{Backend: tt.Stub})
    if err == nil || !strings.Contains(err.Error(), "no bundled ThinkThen native engine for darwin/amd64") { panic(fmt.Sprint(err)) }
    fmt.Println(err)
}
GO
    (GOARCH=amd64 go build -o "$scratch/unsupported-consumer" ./unsupported)
    "$scratch/unsupported-consumer"
fi
# Cross-compile the public system mode and require its explicit Windows refusal.
if command -v zig >/dev/null 2>&1; then
    if GOOS=windows GOARCH=amd64 CC='zig cc -target x86_64-windows-gnu' ZIG_GLOBAL_CACHE_DIR="$scratch/zig-cache" "$THINKTHEN_GO_HOME/bin/go" build -tags thinkthen_system github.com/botassembly/thinkthen/sdk/go/thinkthen > "$scratch/windows-system.log" 2>&1; then
        echo 'Windows system mode unexpectedly built' >&2
        exit 1
    fi
    if ! grep 'thinkthen_system_is_not_supported_on_windows' "$scratch/windows-system.log"; then
        tail -n 40 "$scratch/windows-system.log" >&2
        exit 1
    fi
else
    echo 'Windows system refusal needs a Windows or Zig compiler' >&2
    exit 1
fi
python3 "$root/scripts/go-no-cgo-check"
