#!/bin/sh
# Fetch the exact native database prerequisite separately from offline gates.
set -eu
if [ "${1:-}" = --community ]; then
    shift
    exec python3 "$(dirname "$0")/../databases/duckdb/community-prepare.py" "$@"
fi
if [ "$#" -ne 0 ]; then echo 'usage: scripts/duckdb-prepare [--community VERSION]' >&2; exit 2; fi
python3 scripts/duckdb_release.py
deps=$HOME/.local/share/thinkthen-build-tools/duckdb/$(python3 scripts/duckdb_release.py --version)
if [ "$(uname -sm)" = 'Linux x86_64' ]; then
    # Portable CMake runs inside the prepared runtime floor.
    python3 - "$deps/cmake.tar.gz" <<'PY'
import sys
sys.path.insert(0, 'scripts')
from release_downloads import fetch
fetch('https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-linux-x86_64.tar.gz',
      sys.argv[1], '5a1133ff103c71eb5120e2cc3de922733e7d8a26a98ae716397e8676adb367bf')
PY
    if [ ! -d "$deps/cmake-3.31.6-linux-x86_64" ]; then tar -xzf "$deps/cmake.tar.gz" -C "$deps"; fi
fi
