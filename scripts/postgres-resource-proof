#!/usr/bin/env python3
"""Run only the existing PostgreSQL resource cases from retained package inputs.

Usage: postgres-resource-proof ARCHIVE LOOPBACK IMAGE EVIDENCE ARCHIVE_SHA LOOPBACK_SHA
No package or engine is built. Print the evidence directory and exit status;
child output and completed-round samples remain there, including on failure.
"""
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys

from build_targets import container_labels

ROOT = Path(__file__).resolve().parents[1]


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def inside():
    runner = runpy.run_path(str(ROOT / 'scripts/stress-adapters.py'))['run']
    table = json.loads((ROOT / 'conformance/stress.json').read_text())
    wires = json.loads((ROOT / 'conformance/typed/manifest.json').read_text())['backends']
    healthy = next(case for case in table['scenarios'] if case['name'] == 'healthy')
    for wire in wires:
        result = {}
        try:
            runner([sys.executable, str(ROOT / 'extensions/postgres/tests/stress.py')],
                   table, wire, healthy, table['records']['smoke'],
                   concurrency=1, rounds=table['records']['soak_rounds'], resources=True,
                   short_gate=True, result=result, surface='postgres',
                   evidence_path=Path('/work') / (wire + '-rounds.jsonl'))
        finally:
            print(json.dumps(result), flush=True)


def main():
    if sys.argv[1:] == ['--inside']:
        inside()
        return 0
    if len(sys.argv) != 7:
        sys.exit(__doc__)
    archive, loopback, image, destination, archive_sha, loopback_sha = sys.argv[1:]
    archive, loopback = Path(archive).resolve(), Path(loopback).resolve()
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', image):
        sys.exit('PostgreSQL image must be an immutable digest')
    for path, expected in ((archive, archive_sha), (loopback, loopback_sha)):
        if digest(path) != expected:
            sys.exit('Input checksum differs: ' + str(path))
    evidence = Path(destination).absolute()
    evidence.mkdir(parents=True, exist_ok=False)
    (evidence / 'built/home').mkdir(parents=True)
    shutil.copyfile(archive, evidence / 'built/thinkthen-postgres-18-linux-x86_64.tar.gz')
    receipt = dict(source=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
                   archive_sha256=archive_sha, loopback_sha256=loopback_sha, image=image)
    (evidence / 'inputs.json').write_text(json.dumps(receipt, indent=2) + '\n')
    labels = (['--label-file', os.environ['JOB_LABEL_FILE']] if os.environ.get('JOB_LABEL_FILE')
              else container_labels(ROOT))
    command = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', *labels,
               '-v', f'{ROOT}:/src:ro', '-v', f'{evidence}:/work', '-v', f'{loopback}:/loopback:ro',
               image, 'sh', '-eu', '-c', '''
        sh /src/scripts/postgres-install-runtime /src /work "$1" "$2"
        if ! getent passwd "$1" >/dev/null; then
            printf 'thinkthen:x:%s:%s::/work/built/home:/bin/sh\n' "$1" "$2" >> /etc/passwd
        fi
        exec setpriv --reuid "$1" --regid "$2" --clear-groups env -i HOME=/work/built/home \
            PATH=/opt/thinkthen-pg18/bin:/usr/bin:/bin LANG=C.UTF-8 \
            THINKTHEN_LOOPBACK=/loopback THINKTHEN_GATE_STRICT=1 \
            python3 /src/scripts/postgres-resource-proof --inside
        ''', 'postgres-resource-proof', str(os.getuid()), str(os.getgid())]
    with (evidence / 'stdout.log').open('w') as stdout, (evidence / 'stderr.log').open('w') as stderr:
        status = subprocess.run(command, stdout=stdout, stderr=stderr).returncode
    (evidence / 'execution.json').write_text(json.dumps(dict(receipt, exit_code=status), indent=2) + '\n')
    print(json.dumps(dict(evidence=str(evidence), exit_code=status)))
    return status


if __name__ == '__main__':
    sys.exit(main())
