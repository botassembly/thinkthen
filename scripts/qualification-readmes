#!/usr/bin/env python3
"""Install delivered packages and run their first complete README examples.

Example changes select the stub, supply language entry points and choose the
delivered platform archive as the command README instructs.
"""
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile

from release_registry_check import environment, java_arguments
from release_workflow import ROOT, version

if os.name == 'nt':
    sys.stdout.reconfigure(encoding='utf-8')

PACKAGE = Path(sys.argv[1]).resolve()
WINDOWS = os.name == 'nt'
SUFFIX = 'dll' if WINDOWS else 'dylib' if sys.platform == 'darwin' else 'so'


def one(folder, pattern):
    item, = (PACKAGE / folder).glob(pattern)
    return item


def unpack(folder, destination):
    item = one(folder, '*.zip' if WINDOWS and folder not in ('ruby', 'r') else '*.tar.gz')
    destination.mkdir(parents=True)
    if zipfile.is_zipfile(item):
        with zipfile.ZipFile(item) as archive: archive.extractall(destination)
    else:
        with tarfile.open(item) as archive: archive.extractall(destination, filter='data')
    return destination


def example(name, language, match=None):
    blocks = re.findall(r'```' + language + r'\n(.*?)\n```', (PACKAGE / name / 'README.md').read_text(), re.S)
    return next(block for block in blocks if match is None or match in block)


with tempfile.TemporaryDirectory(prefix='thinkthen-readme-install-') as temporary:
    scratch = Path(temporary)
    env = environment(scratch)
    (scratch / 'home').mkdir()

    def run(*args, cwd=scratch, extra=None, **options):
        if WINDOWS:
            from release_windows_sdks import run as native_run
            output = native_run(*args, cwd=cwd, env=env | (extra or {}))
            print(output, end='')
            return output
        return subprocess.run(list(map(str, args)), cwd=cwd, env=env | (extra or {}), check=True, **options)

    def write(name, body):
        path = scratch / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)
        return path

    artifact = one('', '*.zip' if WINDOWS else '*.tar.gz')
    command = unpack('', scratch / 'command')
    readme = (command / 'README.md').read_text()
    language = 'powershell' if WINDOWS else 'sh'
    shell = re.search(r'```' + language + r'\n(.*?)\n```', readme, re.S)[1]
    shutil.copy2(artifact, scratch / artifact.name)
    if WINDOWS:
        output = run('powershell', '-NoProfile', '-NonInteractive', '-Command',
            "$ErrorActionPreference = 'Stop'\n" + shell +
            '\nif ($LASTEXITCODE -notin @(0,1,3)) { exit $LASTEXITCODE }; exit 0')
    else:
        # The README explicitly directs arm64 Linux and Mac users to the matching archive.
        shell, replacements = re.subn(r'(?<=tar -xzf )[^\s]+', shlex.quote(artifact.name), shell)
        if replacements != 1:
            raise ValueError('command README must extract its delivered archive once')
        output = run('sh', '-eu', '-c', 'status=0; ' + shell + ' || status=$?; case $status in 0|1|3) ;; *) exit "$status";; esac', capture_output=True, text=True).stdout
    rows = [json.loads(line) for line in output.splitlines() if line.strip()]
    if len(rows) != 1 or rows[0].get('status') not in ('answered', 'unsure') or not {'answer', 'p'} <= rows[0].keys():
        raise ValueError('command README must produce one successful decision row')
    print('README: command passes', flush=True)

    python_home = scratch / 'python'
    run(sys.executable, '-m', 'venv', python_home)
    python = python_home / ('Scripts/python.exe' if WINDOWS else 'bin/python')
    run(python, '-m', 'pip', 'install', '--no-index', '--no-cache-dir', one('python', '*.whl'))
    body = example('python', 'python').replace('import thinkthen', 'import thinkthen\nthinkthen = thinkthen.Client(adapter="stub")', 1)
    run(python, write('first.py', body))
    print('README: Python passes', flush=True)

    node = scratch / 'node'
    run('npm.cmd' if WINDOWS else 'npm', 'install', '--offline', '--ignore-scripts', '--no-audit', '--no-fund',
        '--cache', scratch / 'npm-cache', '--prefix', node, one('typescript', '*.tgz'))
    body = example('typescript', 'ts').replace('import { decide } from "thinkthen";',
        'import { ThinkThen } from "thinkthen";\nconst client = new ThinkThen({ adapter: "stub" });\nconst decide = client.decide.bind(client);')
    script = node / 'first.mjs'
    script.write_text(body)
    run('node', script)
    print('README: TypeScript passes', flush=True)

    for name in ('c', 'cpp'):
        installed = unpack(name, scratch / name)
        extension = 'c' if name == 'c' else 'cpp'
        source = write('first.' + extension, example(name, extension))
        binary = scratch / ('first-' + name + ('.exe' if WINDOWS else ''))
        if WINDOWS:
            jansson = Path(os.environ['JANSSON_ROOT']) if name == 'c' else None
            libraries = [installed / 'lib/thinkthen_c.lib', jansson / 'lib/jansson.lib'] if name == 'c' else [installed / 'native/win-x64/thinkthen_ffi.lib']
            dependency = ['/I' + str(jansson / 'include')] if jansson else []
            run('clang-cl', '/nologo', '/std:c11' if name == 'c' else '/std:c++17', '/EHsc', '/MD',
                '/I' + str(installed / 'include'), *dependency, source, '/Fe:' + str(binary), '/link', *libraries)
            native = installed / ('bin' if name == 'c' else 'native/win-x64')
            search = [str(native)] + ([str(jansson / 'bin')] if jansson else [])
            run(binary, extra={'PATH': os.pathsep.join(search) + os.pathsep + env['PATH']})
        else:
            if name == 'c':
                flags = {'PKG_CONFIG_PATH': str(installed / 'lib/pkgconfig') + os.pathsep + env.get('PKG_CONFIG_PATH', '')}
                result = run('pkg-config', '--cflags', '--libs', 'thinkthen-c', extra=flags, capture_output=True, text=True)
                run('cc', '-std=c11', source, *shlex.split(result.stdout), '-o', binary)
            else:
                run('c++', '-std=c++17', '-I' + str(installed / 'include'),
                    '-I' + str(PACKAGE / 'cpp/dependencies/nlohmann-json/include'), source,
                    '-L' + str(installed / 'lib'), '-lthinkthen_ffi', '-Wl,-rpath,' + str(installed / 'lib'), '-o', binary)
            run(binary)
        print('README: ' + name + ' passes', flush=True)

    java = example('java', 'java')
    split = java.index('try (')
    source = write('First.java', java[:split] + '\nclass First { public static void main(String[] args) throws Exception {\n' + java[split:] + '\n}}\n')
    jars = [*sorted((PACKAGE / 'java').glob('*.jar')), *sorted((PACKAGE / 'java/dependencies').glob('*.jar'))]
    classpath = os.pathsep.join(map(str, jars))
    run('javac', '-cp', classpath, source)
    run('java', '--enable-native-access=ALL-UNNAMED', '-cp', str(scratch) + os.pathsep + classpath, 'First')
    print('README: Java passes', flush=True)

    kotlin = example('kotlin', 'kotlin')
    source = write('First.kt', 'import kotlinx.coroutines.runBlocking\n' + kotlin + '\nfun main() = runBlocking { routeMessage() }\n')
    jars = [*sorted((PACKAGE / 'kotlin').glob('*.jar')), *sorted((PACKAGE / 'kotlin/dependencies').glob('*.jar'))]
    classpath = os.pathsep.join(map(str, jars))
    tools = Path.home() / '.local/share/thinkthen-build-tools/jvm/m2'
    compiler = os.pathsep.join(str(path) for path in tools.rglob('*.jar'))
    run('java', java_arguments(scratch / 'kotlin-compiler.args', '-cp', compiler,
        'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler', '-no-stdlib', '-no-reflect',
        '-jvm-target', '22', '-classpath', classpath, '-d', scratch / 'kotlin-classes', source))
    run('java', '--enable-native-access=ALL-UNNAMED', '-cp', str(scratch / 'kotlin-classes') + os.pathsep + classpath, 'FirstKt')
    print('README: Kotlin passes', flush=True)

    write('dotnet/Program.cs', example('csharp', 'csharp').replace('new ThinkThenClient()', 'new ThinkThenClient(new ClientSettings { Adapter = "stub" })'))
    project = write('dotnet/Example.csproj', '<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup><ItemGroup><PackageReference Include="Botassembly.ThinkThen" Version="' + version() + '" /></ItemGroup></Project>')
    write('dotnet/NuGet.Config', '<configuration><packageSources><clear/><add key="candidate" value="' + str(PACKAGE / 'csharp') + '"/></packageSources></configuration>')
    run('dotnet', 'run', '--project', project)
    print('README: C# passes', flush=True)

    library = scratch / 'r-library'
    library.mkdir()
    archives = [*sorted((PACKAGE / ('prerequisites/r' if WINDOWS else 'r')).glob('jsonlite*')),
                *sorted((PACKAGE / 'r').glob('thinkthen_*'))]
    r_env = {'R_LIBS_USER': str(library), 'R_LIBS_SITE': ''}
    expression = 'a <- commandArgs(TRUE); install.packages(a[-1], lib=a[[1]], repos=NULL, type="' + ('win.binary' if WINDOWS else 'source') + '")'
    run('Rscript', '--vanilla', '-e', expression, library, *archives, extra=r_env)
    body = example('r', 'r').replace('  threshold=', '  client=tt_client(adapter="stub"), threshold=')
    # README uses spaced named arguments.
    body = body.replace('  threshold =', '  client = tt_client(adapter="stub"), threshold =')
    run('Rscript', '--vanilla', write('first.R', body), extra=r_env)
    print('README: R passes', flush=True)


    for name in ('sqlite', 'duckdb'):
        installed = unpack(name, scratch / name)
        blocks = re.findall(r'```sql\n(.*?)\n```', (PACKAGE / name / 'README.md').read_text(), re.S)
        if name == 'sqlite':
            extension = installed / ('thinkthen_sqlite.' + SUFFIX)
            sql = blocks[0].replace('./thinkthen_sqlite', extension.as_posix()) + '\n' + blocks[1]
            script = write('first-sqlite.sql', sql)
            run('sqlite3', '-bail', ':memory:', '.read ' + script.as_posix())
        else:
            extension = installed / 'thinkthen.duckdb_extension'
            sql = blocks[0].replace('/absolute/path/to/thinkthen.duckdb_extension', extension.as_posix())
            executable = PACKAGE / 'prerequisites/duckdb/duckdb'
            if WINDOWS: executable = Path(shutil.which('duckdb'))
            run(executable, '-unsigned', ':memory:', '-c', sql)
        print('README: ' + name + ' passes', flush=True)
