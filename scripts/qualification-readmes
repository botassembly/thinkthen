#!/usr/bin/env python3
"""Install delivered packages and run their first complete README examples.

Examples use their documented entry points. The command installs the delivered
candidate through a private installer mirror before its literal first question.
"""
from kotlin_compiler import classpath as compiler_classpath
from contextlib import contextmanager
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import zipfile

from long_path_scratch import long_path_scratch
from release_python_dependencies import wheelhouse
from release_readme import windows_steps
from csharp_consumers import package_config
from release_registry_check import environment, java_arguments
from release_workflow import ROOT, version

WINDOWS = os.name == 'nt'
SUFFIX = 'dll' if WINDOWS else 'dylib' if sys.platform == 'darwin' else 'so'
CHECKS = ('command', 'Python', 'TypeScript', 'c', 'cpp', 'Java', 'Kotlin', 'C#', 'R', 'sqlite', 'duckdb')


def one(folder, pattern):
    item, = (PACKAGE / folder).glob(pattern)
    return item


def unpack(folder, destination):
    item = one(folder, '*.zip' if WINDOWS and folder not in ('ruby', 'r') else '*.tar.gz')
    destination.mkdir(parents=True, exist_ok=True)
    if zipfile.is_zipfile(item):
        with zipfile.ZipFile(item) as archive: archive.extractall(destination)
    else:
        with tarfile.open(item) as archive: archive.extractall(destination, filter='data')
    return destination


def example(name, language, match=None):
    blocks = re.findall(r'```' + language + r'\n(.*?)\n```', (PACKAGE / name / 'README.md').read_text(encoding='utf-8'), re.S)
    return next(block for block in blocks if match is None or match in block)


def kotlin_readme(package, scratch, run):
    literal = (package / 'kotlin/README.md').read_text(encoding='utf-8')
    kotlin = re.findall(r'```kotlin\n(.*?)\n```', literal, re.S)[0]
    source = scratch / 'First.kt'
    source.write_text(kotlin + '\n', encoding='utf-8')
    jars = [*sorted((package / 'kotlin').glob('*.jar')), *sorted((package / 'kotlin/dependencies').glob('*.jar'))]
    classpath = os.pathsep.join(map(str, jars))
    run('java', java_arguments(scratch / 'kotlin-compiler.args', '-cp', compiler_classpath(),
        'org.jetbrains.kotlin.cli.jvm.K2JVMCompiler', '-no-stdlib', '-no-reflect',
        '-jvm-target', '22', '-classpath', classpath, '-d', scratch / 'kotlin-classes', source))
    run('java', '--enable-native-access=ALL-UNNAMED', '-cp', str(scratch / 'kotlin-classes') + os.pathsep + classpath, 'FirstKt')
    print('README: Kotlin passes', flush=True)


failures = []

@contextmanager
def check(name):
    try:
        yield
    except Exception as error:
        failures.append(name)
        print(f'README: {name}: FAIL: {error}', flush=True)


def selected(name):
    return ONLY in (None, name)


if __name__ == '__main__':
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(errors='backslashreplace')

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('package', type=Path)
    parser.add_argument('--only', choices=CHECKS, help='run this one check instead of every check')
    options = parser.parse_args()
    PACKAGE, ONLY = options.package.resolve(), options.only

    with long_path_scratch('thinkthen-readme-install-', 'README') as scratch:
        env = environment(scratch) | {'THINKTHEN_BACKEND': 'stub'}
        (scratch / 'home').mkdir(exist_ok=True)

        def run(*args, cwd=scratch, extra=None, **options):
            if WINDOWS:
                from release_windows_sdks import run as native_run
                output = native_run(*args, cwd=cwd, env=env | (extra or {}))
                print(output, end='')
                return output
            return subprocess.run(list(map(str, args)), cwd=cwd, env=env | (extra or {}), check=True, **options)

        def write(name, body):
            path = scratch / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(body, encoding='utf-8')
            return path

        if selected('command'):
            with check('command'):
                command = unpack('', scratch / 'command')
                run(sys.executable, ROOT / 'scripts/installer-test', '--binary',
                    command / ('thinkthen.exe' if WINDOWS else 'thinkthen'),
                    '--readme', command / 'README.md')
                print('README: command passes', flush=True)

        if selected('Python'):
            with check('Python'):
                python_home = scratch / 'python'
                run(sys.executable, '-m', 'venv', python_home)
                python = python_home / ('Scripts/python.exe' if WINDOWS else 'bin/python')
                run(python, '-m', 'pip', 'install', '--no-index', '--no-cache-dir', '--find-links', wheelhouse(PACKAGE), one('python', '*.whl'))
                body = example('python', 'python')
                run(python, write('first.py', body))
                print('README: Python passes', flush=True)

        if selected('TypeScript'):
            with check('TypeScript'):
                node = scratch / 'node'
                run('npm.cmd' if WINDOWS else 'npm', 'install', '--offline', '--ignore-scripts', '--no-audit', '--no-fund',
                    '--cache', scratch / 'npm-cache', '--prefix', node, one('typescript', '*.tgz'))
                body = example('typescript', 'js')
                script = node / 'first.mjs'
                script.write_text(body, encoding='utf-8')
                run('node', script)
                print('README: TypeScript passes', flush=True)

        for name in ('c', 'cpp'):
            if selected(name):
                with check(name):
                    extension = 'c' if name == 'c' else 'cpp'
                    if WINDOWS:
                        folder = scratch / ('windows-' + name)
                        for part in ('c',) if name == 'c' else ('c', 'cpp'):
                            unpack(part, folder / 'thinkthen')
                        (folder / ('example.' + extension)).write_text(example(name, extension), encoding='utf-8')
                        run(*windows_steps(PACKAGE / name / 'README.md', folder), cwd=folder)
                    else:
                        installed = unpack(name, scratch / name)
                        native_package = installed if name == 'c' else unpack('c', scratch / 'cpp-native')
                        source = write('first.' + extension, example(name, extension))
                        binary = scratch / ('first-' + name)
                        if name == 'c':
                            flags = {'PKG_CONFIG_PATH': str(installed / 'lib/pkgconfig') + os.pathsep + env.get('PKG_CONFIG_PATH', '')}
                            result = run('pkg-config', '--cflags', '--libs', 'thinkthen-c', extra=flags, capture_output=True, text=True, encoding='utf-8')
                            run('cc', '-std=c11', source, *shlex.split(result.stdout), '-o', binary)
                        else:
                            run('c++', '-std=c++17', '-I' + str(installed / 'include'),
                                '-I' + str(native_package / 'include'), source,
                                '-L' + str(native_package / 'lib'), '-lthinkthen', '-Wl,-rpath,' + str(native_package / 'lib'), '-o', binary)
                        loader = 'DYLD_LIBRARY_PATH' if sys.platform == 'darwin' else 'LD_LIBRARY_PATH'
                        run(binary, extra={loader: str(native_package / 'lib')
                            + (os.pathsep + env[loader] if env.get(loader) else '')} if name == 'c' else None)
                    print('README: ' + name + ' passes', flush=True)

        if selected('Java'):
            with check('Java'):
                java = example('java', 'java')
                source = write('Example.java', java + '\n')
                jars = [*sorted((PACKAGE / 'java').glob('*.jar')), *sorted((PACKAGE / 'java/dependencies').glob('*.jar'))]
                classpath = os.pathsep.join(map(str, jars))
                run('javac', '-cp', classpath, source)
                run('java', '--enable-native-access=ALL-UNNAMED', '-cp', str(scratch) + os.pathsep + classpath, 'Example')
                print('README: Java passes', flush=True)

        if selected('Kotlin'):
            with check('Kotlin'):
                kotlin_readme(PACKAGE, scratch, run)

        if selected('C#'):
            with check('C#'):
                write('dotnet/Program.cs', example('csharp', 'csharp'))
                project = write('dotnet/Example.csproj', '<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup><ItemGroup><PackageReference Include="Botassembly.ThinkThen" Version="' + version() + '" /></ItemGroup></Project>')
                package_config(PACKAGE / 'csharp', scratch / 'dotnet')
                run('dotnet', 'run', '--project', project)
                print('README: C# passes', flush=True)

        if selected('R'):
            with check('R'):
                library = scratch / 'r-library'
                library.mkdir()
                directory = PACKAGE / ('prerequisites/r' if WINDOWS else 'prerequisites/r-frames')
                inventory = json.loads((directory / 'inventory.json').read_text(encoding='utf-8'))
                archives = [directory / name for name in inventory['install_order']]
                archives.extend(sorted((PACKAGE / 'r').glob('thinkthen_*')))
                r_env = {'R_LIBS_USER': str(library), 'R_LIBS_SITE': ''}
                expression = 'a <- commandArgs(TRUE); stopifnot(as.character(getRversion()) == a[[2]]); .libPaths(c(a[[1]], .Library)); install.packages(a[-c(1,2)], lib=a[[1]], repos=NULL, type="' + ('win.binary' if WINDOWS else 'source') + '")'
                run('Rscript', '--vanilla', '-e', expression, library, inventory['r'], *archives, extra=r_env)
                body = example('r', 'r')
                run('Rscript', '--vanilla', write('first.R', body), extra=r_env)
                print('README: R passes', flush=True)


        for name in ('sqlite', 'duckdb'):
            if selected(name):
                with check(name):
                    installed = unpack(name, scratch / name)
                    blocks = re.findall(r'```sql\n(.*?)\n```', (PACKAGE / name / 'README.md').read_text(encoding='utf-8'), re.S)
                    if name == 'sqlite':
                        extension = installed / ('thinkthen_sqlite.' + SUFFIX)
                        sql = blocks[0].replace('./thinkthen_sqlite', extension.as_posix())
                        script = write('first-sqlite.sql', sql)
                        run('sqlite3', '-bail', ':memory:', '.read ' + script.as_posix())
                    else:
                        extension = installed / 'thinkthen.duckdb_extension'
                        sql = blocks[0].replace('/absolute/path/to/thinkthen.duckdb_extension', extension.as_posix())
                        executable = PACKAGE / 'prerequisites/duckdb/duckdb'
                        if WINDOWS: executable = Path(shutil.which('duckdb'))
                        run(executable, '-unsigned', ':memory:', '-c', sql)
                    print('README: ' + name + ' passes', flush=True)

    if failures:
        sys.exit('README checks failed: ' + ', '.join(failures))
