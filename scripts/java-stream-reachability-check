#!/bin/sh
# Check iterator lifetime against a retained packaged JAR or this tree's Java JAR.
# Usage: scripts/java-stream-reachability-check PACKAGED_INPUT_DIRECTORY [--source [NATIVE_ASSETS [--routine LOOPBACK]]]
set -eu
cd "$(dirname "$0")/.."
root=$PWD
. scripts/jvm-env
inputs=$1
mode=${2:-}
native_assets=${3:-${THINKTHEN_JVM_NATIVE_ASSETS:-}}
scratch=$(mktemp -d)
trap 'status=$?; trap - EXIT; rm -rf "$scratch"; exit "$status"' EXIT
trap 'exit 1' HUP INT TERM
python3 - "$inputs" "$scratch/dependencies" <<'PY'
from pathlib import Path
import shutil, sys
repository, output = map(Path, sys.argv[1:])
output.mkdir()
for jar in sorted(repository.glob('*.jar')):
    if jar.name.startswith(('jackson-', 'jspecify-')):
        shutil.copy2(jar, output / jar.name)
PY
jar="$inputs/thinkthen-java-0.2.0.jar"
if [ "$mode" = --source ]; then
    python3 scripts/jvm-generated
    mkdir "$scratch/library"
    python3 - "$root" "$scratch/sources" <<'PY'
from pathlib import Path
import sys
root, output = map(Path, sys.argv[1:])
sources = sorted((root / 'sdk/java/library/src/main/java').rglob('*.java'))
sources += sorted((root / 'sdk/java/library/target/generated-sources/contracts').rglob('*.java'))
output.write_text('\n'.join(str(path) for path in sources) + '\n')
PY
    "$JAVA_HOME/bin/javac" -Xlint:all -Werror --release 22 --module-path "$scratch/dependencies" -d "$scratch/library" @"$scratch/sources"
    if [ -n "$native_assets" ]; then
        resource="$scratch/library/io/thinkthen/native/$jvm_platform"
        mkdir -p "$resource"
        cp "$native_assets/$jvm_platform/$jvm_library" "$resource/"
    else
        (cd "$scratch/library"; "$JAVA_HOME/bin/jar" xf "$jar" io/thinkthen/native)
    fi
    jar="$scratch/thinkthen-java-source.jar"
    "$JAVA_HOME/bin/jar" --create --file "$jar" -C "$scratch/library" .
elif [ -n "$mode" ]; then
    echo 'Expected --source or no mode' >&2
    exit 2
fi
mkdir "$scratch/consumer" "$scratch/home"
classpath="$jar:$scratch/dependencies/*"
"$JAVA_HOME/bin/javac" -Xlint:all -Werror --release 22 -cp "$classpath" -d "$scratch/consumer" sdk/java/consumer/src/main/java/JavaStreamReachabilityCases.java
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BACKEND THINKTHEN_BASE_URL THINKTHEN_BATCH CLASSPATH JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS
XDG_CACHE_HOME="$scratch/home/.cache"
export XDG_CACHE_HOME
if [ "${4:-}" = --routine ]; then
    THINKTHEN_LOOPBACK=${5:?provide the prepared loopback executable}
    export THINKTHEN_LOOPBACK
    "$JAVA_HOME/bin/javac" -Xlint:all -Werror --release 22 -cp "$classpath" -d "$scratch/consumer" $(find sdk/java/consumer/src/main/java -name '*.java')
    for case in JavaAnswerCases JavaApiCases JavaAnnotationCases JavaCacheCases JavaConcurrencyCases JavaClosedClientCases; do
        "$JAVA_HOME/bin/java" -Duser.home="$scratch/home" --enable-native-access=ALL-UNNAMED -cp "$scratch/consumer:$classpath" "$case"
    done
    "$JAVA_HOME/bin/java" -Duser.home="$scratch/home" --enable-native-access=ALL-UNNAMED -cp "$scratch/consumer:$classpath" JavaOwnershipCases conformance
    "$JAVA_HOME/bin/java" -Duser.home="$scratch/home" --enable-native-access=ALL-UNNAMED -cp "$scratch/consumer:$classpath" ConformanceCases conformance/typed
    "$JAVA_HOME/bin/javadoc" -quiet -Xdoclint:all -Werror -classpath "$classpath" -d "$scratch/javadoc" sdk/java/library/src/main/java/dev/thinkthen/*.java sdk/java/library/target/generated-sources/contracts/dev/thinkthen/ErrorCode.java
    scripts/words
else
    "$JAVA_HOME/bin/java" -Duser.home="$scratch/home" --enable-native-access=ALL-UNNAMED -cp "$scratch/consumer:$classpath" JavaStreamReachabilityCases
fi
