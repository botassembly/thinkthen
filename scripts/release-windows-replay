#!/usr/bin/env python3
"""Replay windows-check's own run blocks; print one failure list and save full logs."""
import argparse
import ctypes
import hashlib
import json
import locale
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
WORKFLOW = '.github/workflows/native-qualification.yml'


def workflow(repository, revision):
    data = subprocess.check_output(['git', 'show', revision + ':' + WORKFLOW], cwd=repository)
    parsed = subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
        'puts JSON.generate(YAML.safe_load(STDIN.read, aliases: true))'], input=data)
    source = json.loads(parsed)
    return source, hashlib.sha256(data).hexdigest()


def resolve(value, revision, temporary, outcomes):
    replacements = {'inputs.revision': revision, 'runner.temp': str(temporary),
                    'toJSON(steps)': json.dumps(outcomes)}
    def replacement(match):
        key = match[1].strip()
        if key not in replacements:
            raise ValueError('unsupported windows-check expression: ' + key)
        return replacements[key]
    return re.sub(r'\$\{\{(.*?)\}\}', replacement, str(value))



def setup_equivalent(step, receipt, environment):
    identifier = step.get('id', step.get('uses', 'unnamed step'))
    expected = {'uses': step.get('uses'), 'with': step.get('with', {})}
    if not receipt or {key: receipt.get(key) for key in expected} != expected or not receipt.get('evidence'):
        raise ValueError('missing exact setup action equivalent and evidence: ' + identifier)
    selected = receipt.get('environment', {})
    allowed = {'PATH', 'JAVA_HOME', 'JAVA_HOME_22_X64', 'GOROOT', 'DOTNET_ROOT', 'RUBY_ROOT', 'PYTHONLOCATION'}
    if set(selected) - allowed:
        raise ValueError('unsupported setup environment override')
    environment.update(selected)
    pins = expected['with']
    if not isinstance(pins, dict):
        raise ValueError('unsupported Windows setup inputs')
    probes = {
        'setup-python': ('python3', ['--version'], pins.get('python-version')),
        'setup-go': ('go', ['version'], pins.get('go-version')),
        'setup-java': ('java', ['--version'], pins.get('java-version')),
        'setup-dotnet': ('dotnet', ['--version'], pins.get('dotnet-version')),
        'setup-node': ('node', ['--version'], pins.get('node-version')),
        'setup-ruby': ('ruby', ['--version'], pins.get('ruby-version')),
    }
    family = ('ruby/' if identifier == 'setup-ruby' else 'actions/') + identifier + '@'
    if identifier not in probes or not str(step.get('uses', '')).startswith(family):
        raise ValueError('unknown Windows setup action: ' + identifier)
    command, arguments, version = probes[identifier]
    executable = shutil.which(command, path=environment['PATH'])
    if not executable:
        raise ValueError('missing prepared runtime: ' + command)
    measured = subprocess.run([executable, *arguments], env=environment, capture_output=True,
                              text=True, encoding='utf-8', errors='replace', check=True)
    banner = measured.stdout + measured.stderr
    # Python's action selector pins a minor series; every other action names
    # an exact release. Java's build suffix must also occur in its full banner.
    pattern = r'(?<![0-9.])' + re.escape(str(version)) + (r'(?:[.]|\b)' if command == 'python3' else r'(?![0-9.])')
    installed = None
    if command == 'dotnet':
        # setup-dotnet installs the requested SDK beside hosted SDKs. Without
        # global.json, execution may legitimately select a newer installed SDK.
        installed = subprocess.run([executable, '--list-sdks'], env=environment, capture_output=True,
            text=True, encoding='utf-8', errors='replace', check=True).stdout
        if not re.search(r'(?m)^' + re.escape(str(version)) + r'\s+\[', installed):
            raise ValueError('requested dotnet SDK is not installed: ' + str(version))
        if receipt.get('selected_version', banner.strip()) != banner.strip():
            raise ValueError('claimed dotnet default differs from measured selection')
    elif not re.search(pattern, banner):
        raise ValueError('prepared ' + command + ' version differs from ' + str(version) + ': ' + banner)
    return {'action': expected, 'executable': executable,
            'sha256': hashlib.sha256(Path(executable).read_bytes()).hexdigest(), 'version_output': banner,
            'installed_sdks': installed, 'preparation_evidence': receipt['evidence']}


def preserve_artifact(step, workspace, destination):
    settings = step.get('with', {})
    if not isinstance(settings, dict) or set(settings) - {'name', 'path', 'if-no-files-found', 'retention-days'}:
        raise ValueError('unsupported Windows artifact setting')
    declared = settings.get('path', '')
    policy = settings.get('if-no-files-found', 'warn')
    if not isinstance(declared, str) or not declared or any(character in declared for character in '*?[') or policy not in ('warn', 'error', 'ignore'):
        raise ValueError('unsupported Windows artifact path or missing-file setting')
    source = workspace / declared
    if source.is_symlink() or (os.name == 'nt' and source.is_junction()) or not source.resolve().is_relative_to(workspace.resolve()):
        raise ValueError('Windows artifact path must stay inside its workspace')
    source = source.resolve()
    files = []
    for path in sorted(source.rglob('*')) if source.is_dir() else [source]:
        relative = path.relative_to(source) if source.is_dir() else Path(path.name)
        if any(part.startswith('.') for part in path.relative_to(workspace).parts):
            continue  # upload-artifact excludes hidden files by default.
        if path.is_symlink() or (os.name == 'nt' and path.is_junction()) or not path.resolve().is_relative_to(workspace.resolve()):
            raise ValueError('Windows artifact links are unsupported')
        if path.is_file():
            files.append((path, relative))
    result = {'action': {'uses': step['uses'], 'with': settings}, 'files': {}, 'directory': destination.name}
    if not files:
        message = 'No files found for Windows artifact: ' + declared
        if policy == 'error':
            raise ValueError(message)
        result['warning' if policy == 'warn' else 'notice'] = message
        return result
    destination.mkdir()
    for path, relative in files:
        retained = destination / relative
        retained.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, retained)
        result['files'][relative.as_posix()] = {
            'sha256': hashlib.sha256(retained.read_bytes()).hexdigest(), 'bytes': retained.stat().st_size}
    return result


def execute(source, revision, workspace, temporary, candidate, receipts, output, repository):
    job = source['jobs']['windows-check']
    environment = dict({key.upper(): value for key, value in os.environ.items()}, GITHUB_WORKSPACE=str(workspace), RUNNER_TEMP=str(temporary),
                       TMPDIR=str(temporary), TMP=str(temporary), TEMP=str(temporary),
                       GITHUB_ACTIONS='true', CI='true', RUNNER_OS='Windows', GITHUB_SHA=revision)
    environment.update(source.get('env', {}))
    environment.update(job.get('env', {}))
    environment['GITHUB_ENV'] = str(temporary / 'github-env')
    environment['GITHUB_OUTPUT'] = str(temporary / 'github-output')
    environment['GITHUB_PATH'] = str(temporary / 'github-path')
    outcomes, results = {}, []
    for index, step in enumerate(job['steps']):
        identifier = step.get('id', f'step-{index}')
        started = time.monotonic()
        log = output / f'{index:02d}-{identifier}.log'
        status = 0
        try:
            condition = step.get('if', 'success()')
            if condition not in ('always()', 'success()'):
                raise ValueError('unsupported windows-check condition: ' + condition)
            if condition == 'success()' and any(s['outcome'] == 'failure' for s in outcomes.values()):
                outcomes[identifier] = {'outcome': 'skipped'}
                results.append({'id': identifier, 'outcome': 'skipped', 'exit': None, 'seconds': 0,
                                'run_sha256': hashlib.sha256(step.get('run', '').encode()).hexdigest(),
                                'log': None})
                continue
            if 'run' in step:
                current = dict(environment)
                current.update({key: resolve(value, revision, temporary, outcomes)
                                for key, value in step.get('env', {}).items()})
                shell = step.get('shell', job.get('defaults', {}).get('run', {}).get('shell', 'bash'))
                if shell not in ('bash', 'pwsh'):
                    raise ValueError('unsupported windows-check shell: ' + str(shell))
                command = output / f'{index:02d}-{identifier}'
                if shell == 'bash':
                    command = Path(str(command) + '.sh')
                    script = step['run']
                    arguments = ['bash', '--noprofile', '--norc', '-e', '-o', 'pipefail', command.as_posix()]
                else:
                    command = Path(str(command) + '.ps1')
                    script = ("$ErrorActionPreference = 'stop'\n" + step['run']
                              + "\nif ((Test-Path -LiteralPath variable:\\LASTEXITCODE)) { exit $LASTEXITCODE }\n")
                    arguments = ['pwsh', '-command', ". '" + str(command).replace("'", "''") + "'"]
                command.write_text(script, encoding='utf-8', newline='\n')
                with log.open('wb') as stream:
                    status = subprocess.run(arguments, cwd=workspace, env=current,
                                            stdout=stream, stderr=subprocess.STDOUT).returncode
                updates = Path(environment['GITHUB_ENV'])
                if updates.exists():
                    for line in updates.read_text(encoding='utf-8-sig').splitlines():
                        key, value = line.split('=', 1)
                        environment[key] = value
                    updates.unlink()
                paths = Path(environment['GITHUB_PATH'])
                if paths.exists():
                    environment['PATH'] = os.pathsep.join(paths.read_text(encoding='utf-8-sig').splitlines()) + os.pathsep + environment['PATH']
                    paths.unlink()
            elif step.get('uses', '').startswith('actions/checkout@'):
                subprocess.run(['git', 'init', str(workspace)], check=True, stdout=subprocess.PIPE)
                subprocess.run(['git', '-C', str(workspace), 'fetch', '--no-tags', str(repository), revision], check=True)
                subprocess.run(['git', '-C', str(workspace), 'checkout', '--detach', 'FETCH_HEAD'], check=True)
                actual = subprocess.check_output(['git', '-C', str(workspace), 'rev-parse', 'HEAD'], text=True).strip()
                if actual != revision:
                    raise ValueError('checkout source revision differs')
                # A finalizer must not silently alter source bytes after checkout.
                if subprocess.check_output(['git', '-C', str(workspace), 'config', '--get', 'core.autocrlf'], text=True).strip() != 'false':
                    raise ValueError('production checkout did not disable autocrlf')
            elif step.get('uses', '').startswith('actions/download-artifact@'):
                if step['with'] != {'name': 'platform-windows-x86_64', 'path': 'windows-candidate'}:
                    raise ValueError('Windows artifact action changed; update its local equivalent')
                destination = workspace / 'windows-candidate'
                destination.mkdir()
                shutil.copy2(candidate, destination / candidate.name)
            else:
                measured = (preserve_artifact(step, workspace, output / f'{index:02d}-{identifier}-artifact')
                            if step.get('uses', '').startswith('actions/upload-artifact@') else
                            setup_equivalent(step, receipts.get(identifier), environment))
                log.write_text(json.dumps(measured, indent=2) + '\n', encoding='utf-8')
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            status = 1
            log.write_text(str(error) + '\n', encoding='utf-8', errors='backslashreplace')
        outcomes[identifier] = {'outcome': 'failure' if status else 'success'}
        results.append({'id': identifier, 'outcome': outcomes[identifier]['outcome'], 'exit': status, 'seconds': time.monotonic() - started,
                        'run_sha256': hashlib.sha256(step.get('run', '').encode()).hexdigest(),
                        'log': log.name})
        print(f'Windows replay: {identifier}: {outcomes[identifier]["outcome"]}', flush=True)
    return results, [name for name, result in outcomes.items() if result['outcome'] == 'failure']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repository', type=Path, default=ROOT)
    parser.add_argument('--revision', required=True)
    parser.add_argument('--workspace', type=Path, required=True)
    parser.add_argument('--temporary', type=Path, required=True)
    parser.add_argument('--candidate', type=Path, required=True)
    parser.add_argument('--setup-receipts', type=Path, required=True,
                        help='JSON keyed by workflow setup step id: exact uses/with and measured evidence')
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    if os.name != 'nt' or not ctypes.windll.shell32.IsUserAnAdmin():
        parser.error('replay requires the Windows administrator account')
    if not re.fullmatch('[0-9a-f]{40}', args.revision):
        parser.error('revision must be a full source commit')
    workspace, temporary = args.workspace.resolve(), args.temporary.resolve()
    if workspace.drive.lower() != 'd:' or len(workspace.parts) < 5 or workspace.parts[1].lower() != 'a':
        parser.error('workspace must be a deep D:\\a\\... directory')
    if temporary.drive.lower() == workspace.drive.lower():
        parser.error('temporary files must use a separate drive')
    if workspace.exists() or temporary.exists() or args.output.exists():
        parser.error('workspace, temporary and output must be fresh directories')
    workspace.mkdir(parents=True)
    temporary.mkdir(parents=True)
    args.output.mkdir(parents=True)
    # Reproduce the hosted global stress setting, then execute the workflow's
    # own pre-checkout correction before materializing any source bytes.
    source, digest = workflow(args.repository, args.revision)
    old = subprocess.run(['git', 'config', '--global', '--get', 'core.autocrlf'], capture_output=True, text=True)
    subprocess.run(['git', 'config', '--global', 'core.autocrlf', 'true'], check=True)
    try:
        results, failures = execute(source, args.revision, workspace, temporary,
            args.candidate.resolve(), json.loads(args.setup_receipts.read_text(encoding='utf-8')),
            args.output.resolve(), args.repository.resolve())
        report = {'revision': args.revision, 'workflow_sha256': digest,
                  'controller_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), 'workspace': str(workspace),
                  'temporary': str(temporary), 'administrator': True, 'default_encoding': locale.getencoding(),
                  'console_codepage': ctypes.windll.kernel32.GetConsoleOutputCP(),
                  'candidate_sha256': hashlib.sha256(args.candidate.read_bytes()).hexdigest(),
                  'stages': results, 'failures': failures}
        (args.output / 'result.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
        if failures:
            sys.exit('Failed Windows replay stages: ' + ', '.join(failures))
    finally:
        if old.returncode == 0:
            subprocess.run(['git', 'config', '--global', 'core.autocrlf', old.stdout.strip()], check=True)
        else:
            subprocess.run(['git', 'config', '--global', '--unset', 'core.autocrlf'], check=True)


if __name__ == '__main__':
    main()
