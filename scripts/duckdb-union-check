#!/bin/sh
# Reuse verified native inputs; only compile the DuckDB extension and SQL host.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
if [ -z "${THINKTHEN_SQL_ARCHIVE:-}" ]; then
    assets=$(scripts/native-test-assets env)
    eval "$assets"
    export THINKTHEN_SQL_ARCHIVE="$THINKTHEN_SQL_TEST_ARCHIVE"
fi
: "${THINKTHEN_LOOPBACK:?Provide the matching fixture loopback}"
if [ "${1:-}" = --routine ]; then
    cargo fmt --all --check
    scripts/words
    scripts/secrets
    scripts/bindings-schema
    scripts/header-contract-check
    exec scripts/duckdb-gate --development
fi
exec scripts/duckdb-gate --development "${1:---union-only}"
