#!/bin/sh
# Use prepared build tools offline; install the wheel alone before adding pytest.
set -eu
cd "$(dirname "$0")/.."
case "${1:-}" in
  --guide-framework) export THINKTHEN_GUIDE_FRAMEWORK_ONLY=1 ;;
  "") ;;
  *) echo 'usage: scripts/python-gate [--guide-framework]' >&2; exit 2 ;;
esac
exec uv run --offline --no-project --python 3.10 \
  --with 'maturin>=1.5,<2' --with 'pytest>=8,<9' \
  --with 'ruff>=0.11,<1' --with 'mypy>=1.19,<2' \
  --with 'pandas>=2.2' --with pandas-stubs --with 'polars>=1.0' -- sh -eu <<'CHECKS'
root=$PWD
scratch=$(mktemp -d)
trap 'gate_status=$?; trap - EXIT; set +e; rm -rf "$scratch"; exit "$gate_status"' EXIT
trap 'exit 1' HUP INT TERM
python sdk/python/relation_type.py
python_checks=0
ruff check sdk/python --exclude _codes.py --exclude _contract.py || python_checks=1
ruff format --check sdk/python --exclude _codes.py --exclude _contract.py || python_checks=1
mypy --enable-incomplete-feature=TypeForm --strict --no-incremental sdk/python/thinkthen/*.py sdk/python/tests || python_checks=1
python scripts/python-docs-check --ideal || python_checks=1
python scripts/day-one-docs-test --surface python --surface pandas --surface polars || python_checks=1
ruff check --select F401,F841,ERA,BLE,E722,S110 scripts/python_guide_examples.py scripts/pandas_guide_examples.py scripts/polars_guide_examples.py scripts/python-guide-examples || python_checks=1
[ "$python_checks" = 0 ]
cargo build -p loopback -p thinkthen --bins --locked
mkdir "$scratch/wheels"
(cd sdk/python && python -c 'import build_backend, sys; build_backend.build_wheel(sys.argv[1], {"build-args": "--locked --profile dev"})' "$scratch/wheels")
python -m venv "$scratch/venv"
uv pip install --offline --python "$scratch/venv/bin/python" "$scratch"/wheels/*.whl
installed_package=$("$scratch/venv/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"] + "/thinkthen")')
export THINKTHEN_LOOPBACK="${CARGO_TARGET_DIR:-$root/target}/debug/loopback"
export THINKTHEN_CASES="$root/conformance"
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH THINKTHEN_BACKEND PYTHONPATH
guide_controls() {
    for surface in python pandas polars; do
        for control in output branch exit refusal; do
            if "$scratch/venv/bin/python" "$root/scripts/guide-examples" --surface "$surface" --python "$scratch/venv/bin/python" --negative-control "$control" > "$scratch/control.log" 2>&1; then
                echo "Guide runner accepted wrong $surface $control" >&2
                return 1
            fi
            case "$control" in
                output) witness='deliberately wrong output' ;;
                branch) witness='deliberately wrong branch' ;;
                exit) witness='expected 99' ;;
                refusal) witness='refusal/' ;;
            esac
            if ! grep -q "$witness" "$scratch/control.log"; then
                cat "$scratch/control.log"
                return 1
            fi
            echo "PASS $surface runner rejects wrong $control"
        done
    done
}
if [ "${THINKTHEN_GUIDE_FRAMEWORK_ONLY:-0}" = 1 ]; then
    uv pip install --offline --python "$scratch/venv/bin/python" 'pandas>=2.2' 'polars>=1.0' pandas-stubs
    guide_status=0
    for surface in python pandas polars; do
        "$scratch/venv/bin/python" "$root/scripts/guide-examples" --surface "$surface" --python "$scratch/venv/bin/python" || guide_status=1
    done
    guide_controls || guide_status=1
    "$scratch/venv/bin/python" "$root/scripts/guide-examples" --inventory --require-all || guide_status=1
    exit "$guide_status"
fi
cd "$scratch"
# Run independent installed-package checks even when another finds a regression.
runtime_checks=0
runtime_check() {
    "$@" || runtime_checks=1
}
# The installed wheel runs the literal ideal guide after optional table dependencies.
uv pip install --offline --python "$scratch/venv/bin/python" 'pytest>=8,<9'
runtime_check "$scratch/venv/bin/python" -m pytest "$root/sdk/python/tests/test_readme.py" -q --tb=short
runtime_check "$scratch/venv/bin/python" "$root/scripts/module-abi-fixtures" python "$installed_package" --runtime "$scratch/venv/bin/python"
runtime_check "$scratch/venv/bin/python" "$root/scripts/release/python.py" "$root/construction/stub.json"
runtime_check "$scratch/venv/bin/python" "$root/sdk/python/tests/conformance.py" --cases "$root/conformance" --scratch "$scratch"
runtime_check "$scratch/venv/bin/python" - <<'BASE'
import asyncio
import sys
import thinkthen as tt
assert "pandas" not in sys.modules and "polars" not in sys.modules
with tt.Client(backend="stub") as client:
    for method in ("to_pandas", "to_polars"):
        rows = client.decide_stream("Ready?", ["body"])
        try:
            getattr(rows, method)()
        except ModuleNotFoundError:
            pass
        else:
            raise AssertionError("optional dependency unexpectedly installed")
        assert rows.to_list() == []
async def check_async():
    async with tt.AsyncClient(backend="stub") as client:
        for method in ("to_pandas", "to_polars"):
            rows = client.decide_stream("Ready?", ["body"])
            try:
                await getattr(rows, method)()
            except ModuleNotFoundError:
                pass
            else:
                raise AssertionError("optional dependency unexpectedly installed")
            assert await rows.to_list() == []
asyncio.run(check_async())
BASE
uv pip install --offline --python "$scratch/venv/bin/python" 'pandas>=2.2' 'polars>=1.0' pandas-stubs
runtime_check mypy --enable-incomplete-feature=TypeForm --strict --no-incremental --python-executable "$scratch/venv/bin/python" "$root/sdk/python/tests/typing_examples.py"
runtime_check "$scratch/venv/bin/python" "$root/scripts/python-guide-examples" "$scratch/venv/bin/python"
runtime_check guide_controls
runtime_check "$scratch/venv/bin/python" -m pytest "$root/sdk/python/tests" --ignore="$root/sdk/python/tests/test_readme.py" -q --tb=short
[ "$runtime_checks" = 0 ]
CHECKS
