#!/usr/bin/env python3
"""Plant each named-answer fault in a docs example and expect python-docs-check to catch it."""
from pathlib import Path
import subprocess
import sys
import tempfile

CHECK = Path(__file__).resolve().parent / "python-docs-check"
HEAD = 'import thinkthen as tt\n\nwith tt.Client() as client:\n'
CASES = {
    "nested direct": HEAD + '    print(str(client.decide("Refund?", "message")))\n',
    "assigned generic": HEAD + '    is_refund = client.decide("Refund?", "message")\n    result = is_refund\n',
    "iterated generic": HEAD + '    refund_checks = client.decide_stream("Refund?", ["message"])\n    for row in refund_checks:\n        print(row)\n',
    "aliased generic": 'import thinkthen as semantic\nwith semantic.Client() as judge:\n    rows = judge.decide("Refund?", "message")\n',
    "loop unnamed": HEAD + '    for message in ["message"]:\n        client.decide("Refund?", message)\n',
    "direct": HEAD + '    print(client.decide("Refund?", "Please refund my order."))\n',
    "unnamed": HEAD + '    client.decide("Refund?", "Please refund my order.")\n',
    "generic": HEAD + '    result = client.decide("Refund?", "Please refund my order.")\n',
    "is-true": HEAD + '    is_refund = client.decide("Refund?", "Please refund my order.")\n'
                      '    print(is_refund.answer is True)\n',
    "ceremony": HEAD + '    is_refund = client.decide("Refund?", "Please refund my order.")\n'
                       '    is_refund.raise_for_error()\n',
}
CLEAN = HEAD + (
    '    is_refund = client.decide("Refund?", "Please refund my order.")\n'
    '    refund_requests = list(client.filter("Refund?", ["a", "b"]))\n'
    '    for is_late in client.decide_stream("Late?", ["a"]):\n'
    '        print(is_late)\n'
    '    with client.decide_stream("Late?", ["a"]) as late_checks:\n'
    '        late = late_checks.to_list()\n'
    'print(is_refund, refund_requests, late)\n')
CLEAN_ASYNC = (
    'import thinkthen as tt\n\n\nasync def main() -> None:\n'
    '    async with tt.AsyncClient() as client:\n'
    '        is_refund = await client.decide(\n'
    '            "Refund?",\n'
    '            "Please refund my order.",\n'
    '        )\n'
    '    print(is_refund)\n')
CLEAN_TEXT = 'print("is True and raise_for_error()")\n# result = client.decide("Refund?", "message")\n'


def run(code, names_only=True):
    with tempfile.TemporaryDirectory(prefix="python-docs-check-test-") as folder:
        path = Path(folder) / "example.py"
        path.write_text(code, encoding="utf-8")
        options = ["--names-only"] if names_only else []
        return subprocess.run([sys.executable, str(CHECK), *options, str(path)],
                              text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)


failures = 0
for rule, code in CASES.items():
    rule = {"nested direct": "direct", "assigned generic": "generic",
            "iterated generic": "generic", "aliased generic": "generic",
            "loop unnamed": "unnamed"}.get(rule, rule)
    result = run(code)
    if result.returncode != 1 or (": %s: " % rule) not in result.stdout:
        failures += 1
        print("missed %s:\n%s" % (rule, result.stdout))
    else:
        print("catches %s" % rule)
for clean in (CLEAN, CLEAN_ASYNC, CLEAN_TEXT):
    result = run(clean)
    if result.returncode != 0:
        failures += 1
        print("refused a clean example:\n%s" % result.stdout)
    else:
        print("passes a clean example")
result = run(HEAD + '    is_refund = client.decide("Refund?", "message", threshold="wrong")\n',
             names_only=False)
if (result.returncode != 1 or "mypy line" not in result.stdout
        or '"decide"' not in result.stdout or "[call-overload]" not in result.stdout):
    failures += 1
    print("missed an SDK argument type error:\n%s" % result.stdout)
else:
    print("catches an SDK argument type error")
sys.exit(1 if failures else 0)
