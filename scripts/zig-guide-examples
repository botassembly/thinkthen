#!/usr/bin/env python3
"""Run the literal Zig ideal guide against an unpacked package.

Usage: zig-guide-examples PACKAGE SCRATCH
THINKTHEN_LOOPBACK names the prepared scripted backend. Each literal builds once,
then runs its documented branches, outputs and compiler refusals.
"""
from pathlib import Path
import shutil
import sys
from zig_guide_examples import compile_examples, installed_readme, run_examples, run_host_contract, compile_refusals

if len(sys.argv) != 3:
    raise SystemExit(__doc__)
package, stage = (Path(value).resolve() for value in sys.argv[1:])
stage.mkdir(parents=True, exist_ok=True)
libraries = [path for path in (package / 'native').rglob('*') if path.is_file()]
if len(libraries) != 1:
    raise SystemExit('the installed Zig package must contain one host engine')
shutil.copy2(libraries[0], stage / libraries[0].name)
compile_examples(stage, package)
installed_readme(stage, package)
run_examples(stage)
run_host_contract(stage)
compile_refusals(stage, package)
