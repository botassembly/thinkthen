#!/usr/bin/env python3
"""Compile and run every literal Java README and guide example against a built JAR."""
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
classpath = os.pathsep.join(str(Path(part).resolve()) for part in sys.argv[1].split(os.pathsep))

def blocks(path, language):
    return re.findall(r'```' + language + r'\n(.*?)\n```', path.read_text(), re.S)

with tempfile.TemporaryDirectory(prefix='java-authored-examples-') as folder:
    scratch = Path(folder)
    environment = dict(os.environ)
    for name in ('THINKTHEN_API_KEY', 'OPENAI_API_KEY', 'THINKTHEN_BACKEND', 'THINKTHEN_BASE_URL', 'THINKTHEN_URL', 'THINKTHEN_BATCH', 'JAVA_TOOL_OPTIONS', 'JDK_JAVA_OPTIONS'):
        environment.pop(name, None)
    environment['THINKTHEN_BACKEND'] = 'stub'
    java = str(Path(os.environ['JAVA_HOME']) / 'bin/java')
    javac = str(Path(os.environ['JAVA_HOME']) / 'bin/javac')
    guide = root / 'docs/surfaces/java.md'
    examples = [(root / 'sdk/java/README.md', block) for block in blocks(root / 'sdk/java/README.md', 'java')]
    examples += [(guide, block) for block in blocks(guide, 'java')]
    setup, = [block for block in blocks(guide, 'java') if 'List<Map<String, String>> messages = List.of(' in block]
    toolbox, = blocks(guide, 'json')
    for index, (path, literal) in enumerate(examples):
        destination = scratch / str(index)
        destination.mkdir()
        (destination / 'toolbox.json').write_text(toolbox + '\n')
        classes = re.findall(r'\bpublic\s+(?:(?:final|abstract)\s+)?class\s+([A-Za-z_$][\w$]*)', literal)
        if len(classes) > 1:
            raise ValueError(f'{path}: expected one public class per complete program')
        full = bool(classes)
        classname = classes[0] if full else 'Example'
        source = literal if full else ('import dev.thinkthen.*;\nimport java.util.*;\nimport java.util.stream.Stream;\nimport java.nio.file.*;\n'
            'public class Example { public static void main(String[] args) throws Exception {\n'
            + ('' if literal == setup else 'try (var client = ThinkThen.builder().backend(Backend.STUB).build()) {\n')
            + ('' if literal == setup else setup + '\n') + literal + ('\n} }\n' if literal == setup else '\n} } }\n'))
        (destination / f'{classname}.java').write_text(source)
        subprocess.run([javac, '--release', '22', '-Xlint:all', '-Werror', '-cp', classpath, f'{classname}.java'], cwd=destination, env=environment, check=True)
        subprocess.run([java, '-Duser.home=' + str(destination / 'home'), '--enable-native-access=ALL-UNNAMED', '-cp', str(destination) + os.pathsep + classpath, classname], cwd=destination, env=environment, check=True)
        print(f'{path.relative_to(root)} Java block {index}: PASS')
    for mode, backend in [('default', 'stub'), ('explicit', 'invalid'), ('invalid', 'invalid')]:
        environment['THINKTHEN_BACKEND'] = backend
        subprocess.run([java, '-Duser.home=' + str(scratch / 'environment-home'), '--enable-native-access=ALL-UNNAMED', '-cp', sys.argv[2] + os.pathsep + classpath, 'JavaEnvironmentCases', mode], env=environment, check=True)
print('Literal Java examples and backend environment selection pass')
