#!/usr/bin/env python3
"""Run Java guide/host cases against the supplied installed package."""
import argparse
import os
from pathlib import Path
import subprocess
from guide_examples import check, scenario
from guide_java import run_java

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('classpath')
parser.add_argument('classes',nargs='?')
parser.add_argument('--host-only',action='store_true')
parser.add_argument('--consumers',action='store_true',help='Run the focused Java consumer cases')
args=parser.parse_args()
run_java(args.classpath,host_only=args.host_only)
# Existing JVM consumers also prove backend environment precedence in fresh VMs.
if args.classes:
    java=str(Path(os.environ['JAVA_HOME']) / 'bin/java')
    classpath=os.path.abspath(args.classes)+os.pathsep+args.classpath
    for mode,backend in [('default','stub'),('explicit','invalid'),('invalid','invalid')]:
        with scenario('yes') as (folder,env):
            env['THINKTHEN_BACKEND']=backend
            result=subprocess.run([java,'-Duser.home='+str(folder / 'home'),'--enable-native-access=ALL-UNNAMED','-cp',classpath,'JavaEnvironmentCases',mode],cwd=folder,env=env,capture_output=True,text=True,timeout=60)
            check('java/environment/'+mode,result,output='')

    if args.consumers:
        # Run affected public consumers from the same installed JAR, with the same
        # isolated scenario/home preparation as the literal examples.
        root=Path(__file__).resolve().parent.parent
        for classname,arguments in (
            ('JavaApiCases',[]), ('JavaAnswerCases',[]), ('JavaAnnotationCases',[]),
            ('JavaInterfaceCases',[]), ('JavaSettingsCases',[root/'schemas/contract.json']),
            ('JavaOwnershipCases',[root/'conformance']),
            ('ConformanceCases',[root/'conformance/typed']),
        ):
            with scenario('yes') as (folder,env):
                env['THINKTHEN_LOOPBACK']=os.environ['THINKTHEN_LOOPBACK']
                ran=subprocess.run([java,'-Duser.home='+str(folder/'home'),'--enable-native-access=ALL-UNNAMED',
                                    '-cp',classpath,classname,*map(str,arguments)],
                                   cwd=folder,env=env,capture_output=True,text=True,timeout=180)
                check('java/consumer/'+classname,ran)
