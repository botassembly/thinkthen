#!/usr/bin/env python3
"""Run the public installer against the exact qualified candidate command."""
import argparse
from pathlib import Path
import sys
import tarfile
import tempfile
import zipfile

from release_workflow import ROOT, run, validate, version

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('target')
parser.add_argument('candidate', type=Path)
parser.add_argument('revision')
parser.add_argument('--cli', action='store_true')
args = parser.parse_args()
package = args.candidate.resolve() / version() / args.target
validate(package, args.target, args.revision)
windows = args.target == 'windows-x86_64'
suffix = 'zip' if windows else 'tar.gz'
archive = package / f'thinkthen-{version()}-{args.target}.{suffix}'
with tempfile.TemporaryDirectory(prefix='thinkthen-real-installer-') as temporary:
    scratch = Path(temporary)
    if windows:
        with zipfile.ZipFile(archive) as packed:
            packed.extractall(scratch)
    else:
        with tarfile.open(archive) as packed:
            packed.extractall(scratch, filter='data')
    binary = scratch / ('thinkthen.exe' if windows else 'thinkthen')
    helper = 'windows-cli-check' if args.cli else 'installer-test'
    run(sys.executable, ROOT / 'scripts' / helper, '--binary', binary)
