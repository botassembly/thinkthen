#!/usr/bin/env python3
"""Check candidate Swift assembly or selected Linux Go without a full candidate."""
import ast
import json
import os
from pathlib import Path
import runpy
import shutil
import shlex
import subprocess
from types import SimpleNamespace
import sys
import tempfile
import tomllib
import re
import tarfile

from release_go import command, version as go_version

ROOT = Path(__file__).resolve().parent.parent


def c_readmes(library=None):
    """Run the qualification recipe against real CMake-installed C/C++ packages."""
    from native_platform import current
    from release_registry_check import environment
    from release_prepare_common import run as prepared_run
    host = current()
    if library is None:
        cache = Path(subprocess.check_output([ROOT / 'scripts/native-prepare', '--path'], text=True).strip())
        library = cache / host['rid'] / ('libthinkthen_ffi.' + host['suffix'])
    assert library.is_file(), library
    with tempfile.TemporaryDirectory(prefix='thinkthen-c-readmes-') as temporary:
        scratch = Path(temporary)
        prefixes = {}
        for name in ('c', 'cpp'):
            prefix = scratch / ('installed-' + name)
            command = ['cmake', '-S', ROOT / 'sdk' / name, '-B', scratch / ('build-' + name),
                       '-DCMAKE_INSTALL_LIBDIR=lib', '-DCMAKE_INSTALL_PREFIX=' + str(prefix)]
            command += (['-DTHINKTHEN_FFI_LIBRARY=' + str(library),
                         '-DTHINKTHEN_FFI_INCLUDE_DIR=' + str(ROOT / 'crates/thinkthen-ffi/include')]
                        if name == 'c' else ['-DCMAKE_PREFIX_PATH=' + str(prefixes['c'])])
            prepared_run(*command)
            prepared_run('cmake', '--install', scratch / ('build-' + name))
            prefixes[name] = prefix
            with tarfile.open(scratch / (name + '.tar.gz'), 'w:gz') as archive:
                archive.add(prefix, arcname='.')
        env = environment(scratch)
        for key in ('LD_LIBRARY_PATH', 'DYLD_LIBRARY_PATH'):
            env.pop(key, None)

        def run(*args, cwd=scratch, extra=None, **options):
            return subprocess.run(list(map(str, args)), cwd=cwd, env=env | (extra or {}), check=True, **options)

        def unpack(name, destination):
            destination.mkdir()
            with tarfile.open(scratch / (name + '.tar.gz')) as archive:
                archive.extractall(destination, filter='data')
            return destination

        def example(name, language):
            return re.search(r'```' + language + r'\n(.*?)\n```',
                             (prefixes[name] / 'share' / ('thinkthen-' + name) / 'README.md').read_text(), re.S)[1]

        def write(name, body):
            path = scratch / name
            path.write_text(body)
            return path

        recipe = ast.parse((ROOT / 'scripts/qualification-readmes').read_text())
        loop = next(node for node in ast.walk(recipe) if isinstance(node, ast.For)
                    and isinstance(node.iter, ast.Tuple) and ast.literal_eval(node.iter) == ('c', 'cpp'))
        scope = dict(scratch=scratch, env=env, run=run, unpack=unpack, example=example,
                     write=write, WINDOWS=False, os=os, sys=sys, shlex=shlex)
        exec(compile(ast.Module(body=[loop], type_ignores=[]), 'qualification-readmes', 'exec'), scope)


def swift_staging():
    """Discover the real consumer preparation commands rather than repeat their list."""
    marker = 'sdk/swift/tests/' + 'readme.py'
    found = []
    for recipe in sorted((ROOT / 'scripts').iterdir()):
        if not recipe.is_file() or recipe == Path(__file__).resolve():
            continue
        source = recipe.read_text()
        if marker not in source:
            continue
        with tempfile.TemporaryDirectory(prefix='thinkthen-swift-staging-') as temporary:
            scratch = Path(temporary)
            consumer = scratch / 'Consumer'
            windows = scratch / 'checks/swift'
            for folder in (consumer, windows):
                shutil.copytree(ROOT / 'sdk/swift/tests', folder,
                                ignore=shutil.ignore_patterns('*.py'))
                shutil.copytree(ROOT / 'sdk/swift', folder.parent / 'ThinkThen',
                                ignore=shutil.ignore_patterns('tests', '.build'))
            if source.startswith('#!/bin/sh'):
                for line in source.splitlines():
                    if marker in line or 'scripts/surface-example prepare swift' in line:
                        command = line.replace('$scratch/consumer', str(consumer))
                        subprocess.run(shlex.split(command), cwd=ROOT, check=True)
            else:
                scope = dict(ROOT=ROOT, sys=sys, swift=consumer, consumer=consumer,
                             out=scratch, package=scratch, args=SimpleNamespace(readmes=False))
                calls = sorted((node for node in ast.walk(ast.parse(source)) if isinstance(node, ast.Call)),
                               key=lambda node: node.lineno)
                for call in calls:
                    expression = ast.get_source_segment(source, call)
                    if (marker in expression or ('scripts/surface-example' in expression
                            and "'swift'" in expression and "'prepare'" in expression)):
                        arguments = [eval(compile(ast.Expression(arg), str(recipe), 'eval'), scope)
                                     for arg in call.args]
                        subprocess.run(list(map(str, arguments)), cwd=ROOT, check=True)
            staged = windows if (windows / 'Readme').exists() else consumer
            assert (staged / 'Guide/main.swift').is_file(), recipe.name + ' omitted Guide'
            assert (staged / 'Guide/records.jsonl').is_file(), recipe.name + ' omitted Guide inputs'
            package = json.loads(subprocess.check_output(
                ['swift', 'package', '--package-path', str(staged), 'describe', '--type', 'json'], text=True))
            guide = next(target for target in package['targets'] if target['name'] == 'Guide')
            assert guide['sources'] == ['main.swift'], (recipe.name, guide)
            target = next(target for target in package['targets'] if target['name'] == 'Consumer')
            assert set(target['sources']) == {
                path.name for path in (ROOT / 'sdk/swift/tests').glob('*.swift')
                if path.name != 'Package.swift'
            }, (recipe.name, target['sources'])
            found.append(recipe.name)
            print('Swift consumer staging: ' + recipe.name + ' resolves Guide and its inputs', flush=True)
    assert found, 'no Swift consumer preparation paths discovered'


def main():
    c_readme = sys.argv[1:2] == ['c-readmes'] and len(sys.argv) in (2, 3)
    if not c_readme and sys.argv[1:] not in (['swift'], ['swift-windows'], ['swift-staging'], ['go']):
        sys.exit('usage: release-consumer-test swift|swift-windows|swift-staging|go|c-readmes [ENGINE]')
    if not os.environ.get('PM_JOB'):
        sys.exit('run candidate consumer checks through pm job')
    if c_readme:
        c_readmes(Path(sys.argv[2]) if len(sys.argv) == 3 else None)
        return
    if sys.argv[1] == 'swift-staging':
        swift_staging()
        return
    candidate = runpy.run_path(str(ROOT / 'scripts/release-candidate'))
    if sys.argv[1] == 'swift-windows':
        from release_windows import check_sources, source_package
        from release_windows_sdks import unpack
        with tempfile.TemporaryDirectory(prefix='thinkthen-windows-swift-') as temporary:
            scratch = Path(temporary)
            out = scratch / 'candidate'
            check_sources(out)
            # Package description needs the installed layout, but executes no native code.
            native = scratch / 'thinkthen_ffi.dll'
            native.touch()
            version = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['package']['version']
            archive = source_package(scratch / 'stage', out, 'swift', version, native, native)
            unpack(archive, scratch / 'swift/ThinkThen')
            consumer = scratch / 'swift/Consumer'
            shutil.copytree(out / 'checks/swift', consumer)
            package = json.loads(candidate['text']('swift', 'package', '--package-path', consumer, 'describe', '--type', 'json'))
            guide = next(target for target in package['targets'] if target['name'] == 'Guide')
            assert guide['sources'] == ['main.swift'], guide
            assert (consumer / 'Guide/records.jsonl').is_file(), 'candidate omitted the guide inputs'
            assert (consumer / 'Guide/main.swift').read_text() in (ROOT / 'docs/surfaces/swift.md').read_text()
            print('candidate Windows Swift: extracted package resolves its staged Guide target and inputs')
        return
    if sys.argv[1] == 'go':
        assert sys.platform == 'linux', 'Go selection check needs the Linux floor'
        expected = 'go' + go_version()
        built = candidate['native_text'](ROOT / 'scripts/go-build', 'version')
        recorded = candidate['native_text'](command(), 'version')
        assert built == recorded and built.split()[2] == expected, (built, recorded, expected)
        print('candidate Go: consumer and receipt use ' + built)
        return
    with tempfile.TemporaryDirectory(prefix='thinkthen-candidate-swift-') as temporary:
        scratch = Path(temporary)
        # The actual candidate assembles, archives, extracts and builds this package.
        # Keep its generated directories in an isolated source checkout.
        candidate['run']('git', 'clone', '--quiet', '--local', '--no-hardlinks', ROOT, scratch / 'source')
        build = candidate['swift_package']
        build.__globals__['ROOT'] = scratch / 'source'
        out = scratch / 'candidate'
        (out / 'checks').mkdir(parents=True)
        host, rid, _, _ = candidate['host_info']()
        assets = Path(os.environ.get('THINKTHEN_SWIFT_NATIVE_ASSETS') or os.environ['THINKTHEN_CSHARP_NATIVE_ASSETS'])
        version = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['package']['version']
        build(out, version, host, rid, assets)
        consumer = scratch / 'source/.swift-installed/Consumer'
        assert (consumer / 'Guide').is_dir(), 'candidate omitted its Swift Guide target'
        package = json.loads(candidate['text']('swift', 'package', '--package-path', consumer, 'describe', '--type', 'json'))
        guide = next(target for target in package['targets'] if target['name'] == 'Guide')
        assert guide['sources'], 'candidate Guide has no generated source'
        assert (out / 'checks/swift/Consumer').is_file()
        print('candidate Swift: extracted package builds with the generated Guide target')


if __name__ == '__main__':
    main()
