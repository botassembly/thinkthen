#!/usr/bin/env python3
"""Check extracted Windows source consumers, delivered checker imports and draft archives."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import zipfile

from release_registry import github_packages, attach
from release_windows import source_package, check_tools
from release_workflow import ROOT, TARGETS, version


def checker(scratch):
    delivered = scratch / 'delivered'
    check_tools(delivered)
    env = {key: value for key, value in os.environ.items() if key != 'PYTHONPATH'}
    output = subprocess.check_output([sys.executable, '-E', '-s', delivered / 'check', '--help'],
                                     cwd=scratch, env=env, text=True)
    assert 'check PLATFORM_DIRECTORY' in output
    print('Delivered Windows checker starts outside the source tree with its actual shipped imports', flush=True)


def attachments(scratch):
    packages = {}
    expected = {}
    for target in TARGETS:
        package = scratch / target
        family = package / 'sqlite'
        family.mkdir(parents=True)
        archive = family / ('thinkthen-sqlite-' + version() + '-' + target + ('.zip' if target.startswith('windows') else '.tar.gz'))
        archive.write_bytes(('SQLite archive for ' + target).encode())
        expected[archive.name] = archive.read_bytes()
        packages[target] = package
    registry = scratch / 'registry'
    (registry / 'github').mkdir(parents=True)
    github_packages(packages, registry / 'github')
    (registry / 'source.json').write_text(json.dumps({'revision': 'rehearsal', 'version': version()}))
    release = scratch / 'draft'
    release.mkdir()
    attach(registry, release, 'rehearsal')
    for name, data in expected.items():
        assert (release / name).read_bytes() == data, name
    assert len(expected) == len(TARGETS)
    print('Draft attachments preserve the independent SQLite archive from every platform', flush=True)


def missing_gate(scratch):
    source = scratch / 'missing-gate/scripts'
    source.mkdir(parents=True)
    shutil.copy2(ROOT / 'scripts/sdk-gates', source / 'sdk-gates')
    result = subprocess.run([source / 'sdk-gates'], capture_output=True, text=True)
    assert result.returncode != 0, 'SDK dispatcher accepted missing gate scripts'
    assert 'Missing SDK gate: scripts/python-gate' in result.stderr, result.stderr
    print('SDK dispatcher rejects an incomplete checkout', flush=True)
    gates = ('python-gate', 'typescript-gate', 'r-gate', 'c-sdk-gate', 'cpp-sdk-gate',
             'ruby-gate', 'zig-sdk-gate', 'swift-gate', 'go-gate', 'jvm-gate',
             'csharp-gate', 'duckdb-gate', 'sqlite-gate', 'postgres-gate')
    for name in gates:
        path = source / name
        path.write_text('#!/bin/sh\nexit ' + ('77' if name == 'postgres-gate' else '0') + '\n')
        path.chmod(0o755)
    result = subprocess.run([source / 'sdk-gates'], capture_output=True, text=True)
    assert result.returncode == 0, result
    assert 'Skipped SDK gate: postgres-gate' in result.stdout, result.stdout
    assert 'Passed SDK gate: postgres-gate' not in result.stdout, result.stdout
    (source / 'python-gate').write_text('#!/bin/sh\nexit 19\n')
    result = subprocess.run([source / 'sdk-gates'], capture_output=True, text=True)
    assert result.returncode != 0, result
    assert 'Failed SDK gate: python-gate (exit 19)' in result.stderr, result.stderr
    assert 'Passed SDK gate: sqlite-gate' in result.stdout, result.stdout
    assert 'Skipped SDK gate: postgres-gate' in result.stdout, result.stdout
    print('SDK dispatcher retains failures, runs later gates, and distinguishes host skips', flush=True)


def zig(scratch, native):
    archive = source_package(scratch / 'stage', scratch / 'packages', 'zig', version(), native, native)
    package = scratch / 'package'
    with zipfile.ZipFile(archive) as source:
        source.extractall(package)
    assert (package / 'src/error_codes.zig').is_file(), 'Windows archive omitted generated error codes'
    consumer = scratch / 'consumer'
    consumer.mkdir()
    shutil.copy2(ROOT / 'sdk/zig/tests/build.zig.zon', consumer / 'build.zig.zon')
    (consumer / 'consumer.zig').write_text('const t = @import("thinkthen"); export fn errorCode() i32 { return @intFromEnum(t.ErrorCode.usage_abi); }\n')
    (consumer / 'build.zig').write_text('''const std = @import("std");
pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const dependency = b.dependency("thinkthen", .{ .target = target });
    const object = b.addObject(.{ .name = "consumer", .root_module = b.createModule(.{
        .root_source_file = b.path("consumer.zig"), .target = target, .link_libc = true,
    }) });
    object.root_module.addImport("thinkthen", dependency.module("thinkthen"));
    b.getInstallStep().dependOn(&object.step);
}
''')
    tool = Path.home() / '.local/share/thinkthen-build-tools/zig/0.17.0/zig'
    subprocess.run([tool, 'build', '-j2', '-Dtarget=x86_64-windows-msvc'], cwd=consumer, check=True)
    print('Extracted Windows Zig archive compiles a real consumer against its generated ErrorCode; no engine link', flush=True)


with tempfile.TemporaryDirectory(prefix='thinkthen-release-staging-') as temporary:
    scratch = Path(temporary)
    checker(scratch)
    attachments(scratch)
    missing_gate(scratch)
    subprocess.run([sys.executable, ROOT / 'scripts/release-windows-contents-test'], check=True)
    if len(sys.argv) == 2:
        zig(scratch, Path(sys.argv[1]).resolve())
