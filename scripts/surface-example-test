#!/usr/bin/env python3
"""Exercise guide extraction through the delivered command."""
from pathlib import Path
import os
import shutil
import subprocess
import sys
import tempfile
import unittest


class CollectionExample(unittest.TestCase):
    def prepare(self, guide):
        with tempfile.TemporaryDirectory(prefix='thinkthen-surface-example-') as temporary:
            root = Path(temporary)
            (root / 'scripts').mkdir()
            (root / 'docs/surfaces').mkdir(parents=True)
            script = root / 'scripts/surface-example'
            shutil.copyfile(Path(__file__).with_name('surface-example'), script)
            (root / 'docs/surfaces/python.md').write_text(guide)
            output = root / 'example'
            result = subprocess.run([sys.executable, str(script), 'prepare', 'python', str(output)],
                                    text=True, capture_output=True, check=False)
            source = output / 'example.py'
            return result, source.read_text() if source.exists() else None

    def test_collection_can_follow_one_record_and_other_languages(self):
        result, source = self.prepare('```python\nprint("one record")\n```\n'
                                      '```sql\nSELECT \'records.jsonl\';\n```\n'
                                      '```python\nprint("records.jsonl")\n```\n')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(source, 'print("records.jsonl")\n')

    def test_default_client_uses_stub_without_credentials(self):
        program = ("import os; "
                   "assert os.environ['THINKTHEN_BACKEND'] == 'stub'; "
                   "assert 'THINKTHEN_API_KEY' not in os.environ; "
                   "assert 'OPENAI_API_KEY' not in os.environ; "
                   "print('1 answered true\\n2 answered false\\n3 failed\\n4 failed\\n5 failed\\n6 failed'); "
                   "print('array of 2 values; stream form of the call')")
        environment = dict(os.environ, THINKTHEN_BACKEND='invalid',
                           THINKTHEN_API_KEY='fixture', OPENAI_API_KEY='fixture')
        result = subprocess.run([sys.executable, str(Path(__file__).with_name('surface-example')),
                                 'check', 'go', sys.executable, '-c', program],
                                env=environment, text=True, capture_output=True, check=False)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)

    def test_missing_collection_is_refused(self):
        result, source = self.prepare('```python\nprint("one record")\n```\n')
        self.assertNotEqual(result.returncode, 0)
        self.assertIn('JSON Lines collection example', result.stderr)
        self.assertIsNone(source)

    def test_collection_that_drops_records_is_refused(self):
        result, source = self.prepare('```python\nread("records.jsonl"); print(records[0])\n```\n')
        self.assertNotEqual(result.returncode, 0)
        self.assertIn('pass every record', result.stderr)
        self.assertIsNone(source)


if __name__ == '__main__':
    unittest.main()
