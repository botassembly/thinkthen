#!/bin/sh
# Verify the delivered JVM artifacts without rebuilding the SDK or native library.
set -eu
cd "$(dirname "$0")/.."
. scripts/jvm-env
ruff check --select F401,F841,ERA,BLE,E722,S110 scripts/kotlin_compiler.py scripts/kotlin_compiler_test.py scripts/sdk-readme-examples scripts/kotlin-example-check
# The existing README failure aggregator deliberately catches each SDK failure.
ruff check --select F401,F841,ERA,E722,S110 scripts/qualification-readmes
git diff --check
python3 scripts/kotlin_compiler.py --offline
exec python3 scripts/kotlin_compiler_test.py "$@"
