#!/usr/bin/env python3
"""Run the real temporary Go invocations without compiling or invoking Go."""
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
if len(sys.argv) == 3 and sys.argv[1] == '--baseline':
    source = subprocess.check_output(['git', 'show', sys.argv[2] + ':scripts/go-api-check'],
                                     cwd=ROOT, text=True)
elif len(sys.argv) == 1:
    source = (ROOT / 'scripts/go-api-check').read_text()
else:
    sys.exit('usage: go-env-scope-test [--baseline REV]')
readme, = [line for line in source.splitlines() if 'THINKTHEN_BACKEND=stub go run ./readme' in line]
negative, = [line for line in source.splitlines()
            if 'THINKTHEN_CONTRACT="$scratch/changed-contract.json" go test' in line]
architecture, = [line for line in source.splitlines() if 'GOARCH=amd64 go build' in line]
# Prefix assignments to functions follow one local convention: an immediately
# enclosing subshell. Enumerate declared functions rather than one variable.
functions = re.findall(r'^([A-Za-z_]\w*)\(\) \{', source, re.MULTILINE)
assignment = r'''[A-Za-z_]\w*=(?:"[^"]*"|'[^']*'|[^ \t;()]+)'''
assigned_function = re.compile(
    rf'\b(?:{assignment}[ \t]+)+(?P<function>{"|".join(functions)})\b')
unscoped = []
for number, line in enumerate(source.splitlines(), 1):
    for call in assigned_function.finditer(line):
        if not line[:call.start()].rstrip().endswith('('):
            unscoped.append(f'{number}: {line.strip()}')
if unscoped:
    print('Prefix-assigned function calls need subshell scope:\n' + '\n'.join(unscoped), file=sys.stderr)
setup = '''set -eu
scratch=$1
unset THINKTHEN_BACKEND
GOARCH=arm64
export GOARCH
THINKTHEN_CONTRACT=canonical-contract
export THINKTHEN_CONTRACT
go() {
    if [ "$1" = run ]; then
        test "$THINKTHEN_BACKEND" = stub
        test "$THINKTHEN_CONTRACT" = canonical-contract
        printf 'README used stub\\n'
    elif [ "$1" = build ]; then
        test "$GOARCH" = amd64
        printf 'unsupported consumer used amd64\\n'
    else
        test "${THINKTHEN_BACKEND-UNSET}" = UNSET
        test "$THINKTHEN_CONTRACT" = "$scratch/changed-contract.json"
        printf 'backends(99): expected negative\\n'
        return 1
    fi
}
'''
verify = '''
printf 'after: backend=%s contract=%s\\n' "${THINKTHEN_BACKEND-UNSET}" "$THINKTHEN_CONTRACT"
test "${THINKTHEN_BACKEND-UNSET}" = UNSET
test "$THINKTHEN_CONTRACT" = canonical-contract
printf 'architecture after: %s\\n' "$GOARCH"
test "$GOARCH" = arm64
'''
failed = bool(unscoped)
with tempfile.TemporaryDirectory(prefix='go-env-scope-') as temporary:
    for name, invocation in (('README', readme), ('architecture', architecture),
                             ('enum negative', negative + '\nexit 99\nfi')):
        result = subprocess.run(['sh', '-eu', '-c', setup + invocation + verify, 'go-env-scope', temporary],
                                capture_output=True, text=True)
        print(name + ': ' + result.stdout, end='')
        if result.returncode:
            print(result.stderr, file=sys.stderr, end='')
            failed = True
sys.exit(1 if failed else 0)
