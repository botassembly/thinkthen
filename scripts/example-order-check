#!/usr/bin/env python3
"""Check runner syntax and exercise broken literals without native builds."""
import ast
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
os.chdir(root)
with tempfile.TemporaryDirectory(prefix='swift-readme-env-') as temporary:
    child = Path(temporary) / 'readme'
    child.write_text('#!' + sys.executable + '\nimport os\n'
                     'assert os.environ["THINKTHEN_BACKEND"] == "stub"\n'
                     'assert os.environ["THINKTHEN_SWIFT_AUDIT_LIBRARY"] == "preserved"\n')
    child.chmod(0o755)
    subprocess.run([sys.executable, 'sdk/swift/tests/run.py', '--readme-only', str(child)],
                   env=dict(os.environ, THINKTHEN_BACKEND='invalid',
                            THINKTHEN_SWIFT_AUDIT_LIBRARY='preserved'), check=True)
print('Swift README retains the consumer environment isolation: PASS', flush=True)
for path in [*Path('scripts').iterdir(), Path('sdk/cpp/tests/check-installed'),
             Path('sdk/r/tests/driver.py'), Path('sdk/swift/tests/run.py'),
             Path('extensions/postgres/tests/typed_api.py')]:
    if not path.is_file():
        continue
    source = path.read_bytes()
    first = source.split(b'\n', 1)[0]
    if first == b'#!/bin/sh':
        subprocess.run(['sh', '-n', str(path)], check=True)
    elif path.suffix == '.py' or b'python3' in first:
        ast.parse(source, filename=str(path))
print('Surface runner shell and Python syntax: PASS', flush=True)
helper = root / 'scripts/surface-example'
languages = runpy.run_path(str(helper))['LANGUAGES']
with tempfile.TemporaryDirectory(prefix='example-order-') as temporary:
    for surface, (language, _) in languages.items():
        if surface in ('java', 'kotlin', 'ruby', 'sqlite'):
            continue
        page = root / 'docs/surfaces' / (surface + '.md')
        original = page.read_bytes()
        try:
            text = original.decode()
            block = next(block for block in re.finditer(r'```' + language + r'\n(.*?)\n```', text, re.S)
                         if 'records.jsonl' in block[1])
            page.write_text(text[:block.start(1)] + block[1].replace('records.jsonl', 'records[0]-records.jsonl') + text[block.end(1):])
            result = subprocess.run([sys.executable, str(helper), 'prepare', surface, temporary], capture_output=True, text=True)
            assert result.returncode and 'guide must pass every record: ' + surface in result.stderr, result
            print(surface + ' broken collection setup refused before runtime', flush=True)
        finally:
            page.write_bytes(original)
    for name, language, command, diagnostic in [
        ('ruby', 'ruby', [sys.executable, 'scripts/sdk-readme-examples', 'ruby'], 'syntax error'),
        ('r', 'r', ['Rscript', '--vanilla', 'sdk/r/tests/readme.R', 'sdk/r/README.md'], 'unexpected')]:
        page = root / 'sdk' / name / 'README.md'
        original = page.read_bytes()
        try:
            page.write_bytes(original.replace(('```' + language + '\n').encode(), ('```' + language + '\n(\n').encode(), 1))
            result = subprocess.run(command, capture_output=True, text=True)
            assert result.returncode and diagnostic in result.stdout + result.stderr, result
            print(name + ' existing literal caller refused intentional syntax error before native import', flush=True)
        finally:
            page.write_bytes(original)
subprocess.run(['git', 'diff', '--exit-code', '--', 'docs/surfaces', 'sdk/r/README.md', 'sdk/ruby/README.md'], check=True)
print('All deliberately changed docs restored: PASS', flush=True)
