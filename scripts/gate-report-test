#!/usr/bin/env python3
"""Feature: gate stages report duration and preserve failed output at log end."""
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

# Fixture gates own their reports and staged SDK commands independently of the invoking gate.
BASE_ENV = dict(os.environ)
BASE_ENV.pop('THINKTHEN_GATE_FAILURE_TAILS', None)
BASE_ENV.pop('THINKTHEN_SDK_GATE_RUNNER', None)

ROOT = Path(__file__).resolve().parent
with tempfile.TemporaryDirectory(prefix='gate-report-') as temporary:
    root = Path(temporary)
    scripts = root / 'scripts'
    scripts.mkdir()
    shutil.copy2(ROOT / 'gate', scripts / 'gate')
    # Exercise the real gate entry point with controlled stage executables.
    for source in ROOT.iterdir():
        if source.is_file() and source.name != 'gate':
            target = scripts / source.name
            target.write_text('#!/bin/sh\nexit 0\n')
            target.chmod(0o755)
    shutil.copy2(ROOT / 'bash-guide', scripts / 'bash-guide')
    if (ROOT / 'gate-report').exists():
        shutil.copy2(ROOT / 'gate-report', scripts / 'gate-report')
    if (ROOT / 'gate-stage').exists():
        shutil.copy2(ROOT / 'gate-stage', scripts / 'gate-stage')
    tools = root / 'tools'
    tools.mkdir()
    for tool in ('git', 'cargo', 'rustc', 'cc', 'c++', 'make', 'cmake', 'pkg-config',
                 'uv', 'node', 'npm', 'ruby', 'R', 'Rscript', 'staticcheck', 'docker', 'uname', 'python3', 'rm'):
        target = tools / tool
        target.write_text('''#!/bin/sh
case "${0##*/} $*" in
  "rm "*) exit 7 ;;
  *gate-stage*) exec "$GATE_REPORT_PYTHON" "$@" ;;
  *surface-example*prepare*)
    if [ "${GATE_REPORT_MODE:-fail}" = guide ]; then exit 19; fi ;;
  *uname*) echo Darwin ;;
  *release_metadata.py*)
    if [ "${GATE_REPORT_MODE:-fail}" != fail ]; then exit 0; fi
    i=1
    while [ "$i" -le 70 ]; do echo "failed-stage-line-$i"; i=$((i+1)); done
    exit 37 ;;
  *"cargo test"*)
    if [ "${GATE_REPORT_MODE:-fail}" != fail ]; then exit 0; fi
    i=1
    while [ "$i" -le 18000 ]; do echo "later-stage-padding-$i-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"; i=$((i+1)); done
    echo second-failure >&2
    exit 42 ;;
esac
''')
        target.chmod(0o755)
    run = subprocess.run(['sh', str(scripts / 'gate')], cwd=root,
        env=dict(BASE_ENV, PATH=f'{tools}:/usr/bin:/bin', TMPDIR=str(root), THINKTHEN_NATIVE_LIBRARY='fixture', THINKTHEN_GATE_STRICT='0', THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='0', THINKTHEN_GATE_DIAGNOSTICS=str(root / 'fixture-diagnostics')),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False)
    assert run.returncode == 1, run.stdout
    # Simulate a runner keeping only the end of a noisy log.
    assert len(run.stdout.encode()) > 1024 * 1024
    truncated = run.stdout.encode()[-1024 * 1024:].decode()
    summary = truncated.split('Failed gate stages:', 1)[1]
    assert 'release-metadata rust-tests' in summary, summary
    for name in ('release-metadata', 'rust-tests'):
        assert f'Last 50 lines of failed gate stage: {name}' in summary, summary
    for index in range(21, 71):
        assert f'failed-stage-line-{index}\n' in summary + '\n', summary
    assert 'failed-stage-line-20\n' not in summary, summary
    assert 'second-failure' in summary, summary
    assert (root / 'fixture-diagnostics/rust-tests.tail').stat().st_size <= 4096
    finished = [line for line in run.stdout.splitlines()
                if line.startswith(('Passed gate stage:', 'Failed gate stage:'))]
    assert finished and all(re.search(r'elapsed [0-9]+ seconds', line) for line in finished), finished
    assert 'Passed gate stage: sdk-gates' in run.stdout, run.stdout
    for mode, expected in (('success', 0), ('guide', 1)):
        followup = subprocess.run(['sh', str(scripts / 'gate')], cwd=root,
            env=dict(BASE_ENV, PATH=f'{tools}:/usr/bin:/bin', TMPDIR=str(root), THINKTHEN_NATIVE_LIBRARY='fixture', THINKTHEN_GATE_STRICT='0',
                     GATE_REPORT_MODE=mode, THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='0', THINKTHEN_GATE_DIAGNOSTICS=str(root / 'fixture-diagnostics')), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, check=False)
        assert followup.returncode == expected, followup.stdout
        if mode == 'guide':
            assert 'Failed gate stage: bash-guide (exit 19;' in followup.stdout, followup.stdout
            assert 'Failed gate stages: bash-guide' in followup.stdout, followup.stdout
            assert 'Last 50 lines of failed gate stage: bash-guide' in followup.stdout, followup.stdout
            assert 'Gate stage: rust-tests ' not in followup.stdout, followup.stdout
            assert 'Gate stage: sdk-gates ' not in followup.stdout, followup.stdout
    # Nested SDK failures must survive both the SDK and outer stage tail bounds.
    shutil.copy2(ROOT / 'sdk-gates', scripts / 'sdk-gates')
    (scripts / 'python-gate').write_text('#!/bin/sh\necho nested-sdk-stderr >&2\nexit 23\n')
    (scripts / 'postgres-gate').write_text('#!' + sys.executable + '\nprint("x" * (1024 * 1024 + 4096))\n')
    nested = subprocess.run(['sh', str(scripts / 'gate')], cwd=root,
        env=dict(BASE_ENV, PATH=f'{tools}:/usr/bin:/bin', TMPDIR=str(root),
                 THINKTHEN_NATIVE_LIBRARY='fixture', THINKTHEN_GATE_STRICT='0',
                 GATE_REPORT_MODE='success', THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='0',
                 THINKTHEN_GATE_DIAGNOSTICS=str(root / 'nested-diagnostics')),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    assert nested.returncode == 1, nested.stdout[-4096:]
    assert len(nested.stdout.encode()) > 1024 * 1024
    final = nested.stdout.encode()[-1024 * 1024:].decode().split('Failed gate stages:', 1)[1]
    assert 'nested-sdk-stderr' in final, final[-4096:]
    assert 'Last 50 lines of failed SDK gate: python-gate (exit 23;' in final, final[-4096:]
    assert 'Passed SDK gate: postgres-gate' in nested.stdout
    for name in ('sdk-gates', 'python-gate', 'postgres-gate'):
        (scripts / name).write_text('#!/bin/sh\nexit 0\n')
    # A runner may kill the whole process group without allowing EXIT traps.
    # Wait for a stage's output event, then kill it while it blocks on a FIFO.
    block = root / 'block'
    os.mkfifo(block)
    metadata = tools / 'python3'
    metadata.write_text(metadata.read_text().replace(
        '  *release_metadata.py*)',
        '\n'.join(('  *release_metadata.py*)',
                   '    if [ "${GATE_REPORT_MODE:-fail}" = cutoff ]; then',
                   '      echo running-stage-before-cutoff',
                   '      read blocked < "$GATE_REPORT_BLOCK"',
                   '    fi'))))
    shutil.copy2(ROOT / 'hosted-gate', scripts / 'hosted-gate')
    for name in ('native-tools-env', 'native-env'):
        (scripts / name).write_text(':\n')
    diagnostics = root / 'cutoff-diagnostics'
    process = subprocess.Popen(['sh', str(scripts / 'hosted-gate')], cwd=root,
        env=dict(BASE_ENV, PATH=f'{tools}:/usr/bin:/bin', TMPDIR=str(root),
                 THINKTHEN_NATIVE_LIBRARY='fixture', THINKTHEN_GATE_STRICT='0',
                 THINKTHEN_GATE_DIAGNOSTICS=str(diagnostics),
                 GATE_REPORT_MODE='cutoff', GATE_REPORT_BLOCK=str(block), THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='0'),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        start_new_session=True)
    try:
        for line in process.stdout:
            if line.strip() == 'running-stage-before-cutoff':
                # stdout and the log are separate tee sinks. Cut off only after
                # the persistent output event, not a race with its file write.
                deadline = time.monotonic() + 10
                while (observed_at_event := (diagnostics / 'running-stage.log').read_bytes()) != b'running-stage-before-cutoff\n':
                    if process.poll() is not None or time.monotonic() >= deadline:
                        raise AssertionError(('cutoff diagnostic event absent', observed_at_event))
                    os.sched_yield()
                break
        else:
            raise AssertionError('gate exited before the cutoff event')
    finally:
        os.killpg(process.pid, signal.SIGKILL)
        process.communicate(timeout=10)
    # These are the same persistent files transported by the workflow upload.
    uploaded = root / 'uploaded'
    shutil.copytree(diagnostics, uploaded)
    records = (uploaded / 'stages.log').read_text()
    assert 'Gate environment: native-tools-env (start ' in records, records
    assert 'Gate environment ended: native-env ' in records, records
    assert 'Gate stage ended: stress-dispatch-test ' in records, records
    assert 'Gate stage: release-metadata (start ' in records, records
    assert 'Gate stage ended: release-metadata ' not in records, records
    captured = (uploaded / 'running-stage.log').read_bytes()
    assert captured == b'running-stage-before-cutoff\n', (
        'cutoff fixture bytes at stdout event', observed_at_event, 'after kill', captured)
    # A fatal sourced prerequisite reports its own failure before stopping.
    (scripts / 'native-env').write_text('echo hosted-environment-stderr >&2\nexit 17\n')
    hosted = subprocess.run([scripts / 'hosted-gate'], cwd=root,
        env=dict(BASE_ENV, PATH=f'{tools}:/usr/bin:/bin', TMPDIR=str(root),
                 THINKTHEN_NATIVE_LIBRARY='fixture', THINKTHEN_GATE_STRICT='0',
                 GATE_REPORT_MODE='success', THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='0',
                 THINKTHEN_GATE_DIAGNOSTICS=str(root / 'hosted-diagnostics')),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    assert hosted.returncode == 17, hosted.stdout[-4096:]
    assert 'hosted-environment-stderr' in hosted.stdout.split('Failed hosted gate stages:', 1)[1]
    assert 'Last 50 lines of failed gate environment: native-env (exit 17;' in hosted.stdout
    (scripts / 'native-env').write_text(':\n')
    # An expired stage must close descendant writers so tee can finish and the
    # gate can reach later stages. The child blocks on an event, never a sleep.
    metadata.write_text(metadata.read_text().replace(
        '  *release_metadata.py*)',
        '\n'.join(('  *release_metadata.py*)',
                   '    if [ "${GATE_REPORT_MODE:-fail}" = timeout ]; then',
                   '      "$GATE_REPORT_PYTHON" -c \'import os; print("watchdog-child-running", flush=True); os.open(os.environ["GATE_REPORT_BLOCK"], os.O_RDONLY)\'',
                   '      exit 0',
                   '    fi'))))
    watchdog = subprocess.Popen(['sh', str(scripts / 'gate')], cwd=root,
        env=dict(BASE_ENV, PATH=f'{tools}:/usr/bin:/bin', TMPDIR=str(root),
                 THINKTHEN_NATIVE_LIBRARY='fixture', THINKTHEN_GATE_STRICT='0',
                 THINKTHEN_GATE_DIAGNOSTICS=str(root / 'watchdog-diagnostics'),
                 THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='1', GATE_REPORT_MODE='timeout',
                 GATE_REPORT_BLOCK=str(block), GATE_REPORT_PYTHON=sys.executable),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
    output, _ = watchdog.communicate()
    assert watchdog.returncode == 1, output
    assert 'Timed out gate stage: release-metadata' in output, output
    assert 'Failed gate stage: release-metadata (exit 124;' in output, output
    assert 'Passed gate stage: sdk-gates' in output, output
    summary = output.split('Last 50 lines of failed gate stage: release-metadata', 1)[1]
    assert 'watchdog-child-running' in summary, summary
    assert 'watchdog-child-running' in (root / 'watchdog-diagnostics/release-metadata.tail').read_text()
    records = (root / 'watchdog-diagnostics/stages.log').read_text()
    assert re.search(r'Gate stage ended: release-metadata .*exit 124;', records), records
    for line in truncated.splitlines()[-110:]:
        print('gate-report fixture: ' + line)
    print('gate reporting: durations, failure tails and live cutoff diagnostics pass')

# Source and SDK loops must retain stderr after a later child floods the log.
with tempfile.TemporaryDirectory(prefix='gate-child-report-') as temporary:
    root = Path(temporary)
    scripts = root / 'scripts'
    scripts.mkdir()
    for source in ROOT.iterdir():
        if source.is_file():
            target = scripts / source.name
            target.write_text('#!/bin/sh\nexit 0\n')
            target.chmod(0o755)
    for name in ('interface-source-gate', 'sdk-gates', 'gate-report'):
        if (ROOT / name).exists():
            shutil.copy2(ROOT / name, scripts / name)
    (scripts / 'native-tools-env').write_text(':\n')
    tools = root / 'tools'
    tools.mkdir()
    for name in ('cargo', 'rustup', 'uv', 'python3'):
        (tools / name).write_text('#!/bin/sh\nexit 0\n')
        (tools / name).chmod(0o755)
    fail = '#!/bin/sh\necho early-child-stderr >&2\nexit 37\n'
    flood = ('#!' + sys.executable + '\n'
             + 'print("later-child-padding-" + "x" * (1024 * 1024 + 4096))\n')
    env = dict(BASE_ENV, PATH=str(tools) + ':/usr/bin:/bin', HOME=str(root),
               THINKTHEN_GATE_STRICT='1', THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='0')
    (root / 'rust-toolchain.toml').write_text('[toolchain]\nchannel = "fixture"\n')
    for entry, first, later, summary in (
        ('interface-source-gate', 'core-check', 'python-gate', 'Failed source gate stages:'),
        ('sdk-gates', 'python-gate', 'postgres-gate', 'Failed SDK gates:'),
    ):
        (scripts / first).write_text(fail)
        (scripts / later).write_text(flood)
        result = subprocess.run([scripts / entry], cwd=root, env=env,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        assert result.returncode == 1, result.stdout[-4096:]
        assert len(result.stdout.encode()) > 1024 * 1024
        final = result.stdout.encode()[-1024 * 1024:].decode()
        assert summary in final, final[-4096:]
        assert 'early-child-stderr' in final.split(summary, 1)[1], final[-4096:]
        assert 'exit 37' in result.stdout, result.stdout[-4096:]
        (scripts / first).write_text('#!/bin/sh\nexit 0\n')
        (scripts / later).write_text('#!/bin/sh\nexit 0\n')
    # A hung source stage fails within its limit, names itself, and later stages still run.
    shutil.copy2(ROOT / 'gate-stage', scripts / 'gate-stage')
    # The Python SDK stages run checkout files outside scripts/; pass them too.
    for name in ('check-offline', 'check-release'):
        stub = root / 'sdk/python' / name
        stub.parent.mkdir(parents=True, exist_ok=True)
        stub.write_text('#!/bin/sh\nexit 0\n')
        stub.chmod(0o755)
    (tools / 'python3').write_text('#!/bin/sh\ncase "$*" in *gate-stage*) exec "$GATE_REPORT_PYTHON" "$@" ;; esac\nexit 0\n')
    block = root / 'block'
    os.mkfifo(block)
    (scripts / 'core-check').write_text('#!' + sys.executable + '\nimport os\nprint("hung-stage-running", flush=True)\n'
                                        'os.open(os.environ["GATE_REPORT_BLOCK"], os.O_RDONLY)\n')
    started = time.monotonic()
    hung = subprocess.run([scripts / 'interface-source-gate'], cwd=root,
                          env=dict(env, THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS='2', GATE_REPORT_BLOCK=str(block),
                                   GATE_REPORT_PYTHON=sys.executable),
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=120)
    assert time.monotonic() - started < 60, 'the hung source stage outlived its limit'
    assert hung.returncode == 1, hung.stdout[-4096:]
    assert 'Timed out gate stage: core-check (limit 2 seconds)' in hung.stdout, hung.stdout[-4096:]
    assert 'Failed source gate stage: core-check (exit 124;' in hung.stdout, hung.stdout[-4096:]
    assert 'Passed source gate stage: secrets' in hung.stdout, hung.stdout[-4096:]
    final = hung.stdout.split('Failed source gate stages:', 1)[1]
    assert final.split('\n', 1)[0].split() == ['core-check'], final[-4096:]
    assert 'hung-stage-running' in final, final[-4096:]
    # Without an override every stage still runs under the default limit.
    (scripts / 'core-check').write_text('#!/bin/sh\nexit 0\n')
    calls = root / 'stage-calls'
    (tools / 'python3').write_text('#!/bin/sh\ncase "$*" in *gate-stage*) echo "$2" >> "' + str(calls) + '"; '
                                   'exec "$GATE_REPORT_PYTHON" "$@" ;; esac\nexit 0\n')
    unset = {key: value for key, value in env.items() if key != 'THINKTHEN_GATE_STAGE_TIMEOUT_SECONDS'}
    bounded = subprocess.run([scripts / 'interface-source-gate'], cwd=root,
                             env=dict(unset, GATE_REPORT_PYTHON=sys.executable),
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=120)
    assert bounded.returncode == 0, bounded.stdout[-4096:]
    limits = set(calls.read_text().split())
    assert limits == {'3600'}, limits
    print('source gate: a hung stage fails within its limit and names itself; every stage has the default limit')

# Prepared rehearsal must preserve shared binaries and reject cache conflicts.
with tempfile.TemporaryDirectory(prefix='gate-prepared-') as temporary:
    root = Path(temporary)
    scripts = root / 'scripts'
    scripts.mkdir()
    for name in ('hosted-gate', 'gate-report', 'native-pair', 'native_platform.py', 'release_images.py'):
        shutil.copy2(ROOT / name, scripts / name)
    for name in ('native-tools-env', 'native-env', 'native-producer',
                 'native-test-assets', 'native-abi-assets', 'gate'):
        (scripts / name).write_text('#!/bin/sh\nexit 0\n' if name not in ('native-tools-env', 'native-env') else ':\n')
        (scripts / name).chmod(0o755)
    cache = root / '.local/share/thinkthen-build-tools/native' / ('a' * 64)
    (scripts / 'native-prepare').write_text(
        '#!' + sys.executable + '\nfrom pathlib import Path\n'
        + 'def cache_path(): return Path(' + repr(str(cache)) + ')\n'
        + 'if __name__ == "__main__": print(cache_path())\n')
    (scripts / 'native-prepare').chmod(0o755)
    tools = root / 'tools'
    tools.mkdir()
    (tools / 'git').write_text('#!/bin/sh\necho ' + '1' * 40 + '\n')
    (tools / 'git').chmod(0o755)
    names = ('linux-x64/libthinkthen_ffi.so', 'linux-x64/libthinkthen_ffi.a',
             'osx-arm64/libthinkthen_ffi.dylib', 'osx-arm64/libthinkthen_ffi.a', 'thinkthen.h')
    hashes = {}
    for name in names:
        target = cache / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(name.encode())
        hashes[name] = hashlib.sha256(target.read_bytes()).hexdigest()
    env = dict(BASE_ENV, HOME=str(root), PATH=str(tools) + os.pathsep + os.environ['PATH'])
    for mode in ('matching', 'conflicting'):
        evidence = root / mode
        registration = evidence / 'registration'
        for name in names:
            asset = registration / 'assets' / name
            asset.parent.mkdir(parents=True, exist_ok=True)
            asset.write_bytes(name.encode())
        (registration / 'registration.json').write_text(json.dumps({'five_assets': hashes}))
        tracked = cache / names[0]
        if mode == 'conflicting': tracked.write_bytes(b'other producer')
        before = tracked.stat().st_mtime_ns
        result = subprocess.run([scripts / 'hosted-gate', '--prepared', str(root),
            'sha256:' + 'b' * 64, str(root), str(root), str(evidence)],
            cwd=root, env=env, capture_output=True, text=True)
        if mode == 'matching':
            assert result.returncode == 0, result.stdout + result.stderr
        else:
            assert result.returncode != 0, result.stdout + result.stderr
            assert 'conflicts with a cached asset' in result.stderr, result.stderr
            assert tracked.read_bytes() == b'other producer'
        assert tracked.stat().st_mtime_ns == before, 'prepared gate rewrote a shared native binary'
