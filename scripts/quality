#!/usr/bin/env python3
"""Measure a built command on the bundled public benchmark cases; run live by hand."""

import argparse
from collections import Counter
import json
from pathlib import Path
import subprocess
import sys


def identity(function, answer):
    if function == "find":
        return [] if answer is None else [(answer["start"], answer["end"])]
    if function == "recognize":
        return [(item["kind"], item["start"], item["end"]) for item in answer]
    return [(item["relation"], item["source"]["text"], item["target"]["text"])
            for item in answer]


def match_key(function, item, text):
    if function == "recognize":
        kind, start, end = item
        while end > start and text[end - 1] in ".!?,:;":
            end -= 1
        return kind, start, end
    if function == "relate":
        relation, source, target = item
        return relation, source.rstrip(".!?,:;"), target.rstrip(".!?,:;")
    return tuple(item)


def metrics(tp, fp, fn, count):
    return {"cases": count, "tp": tp, "fp": fp, "fn": fn,
            "precision": tp / (tp + fp) if tp + fp else 0.0,
            "recall": tp / (tp + fn) if tp + fn else 0.0,
            "f1": 2 * tp / (2 * tp + fp + fn) if 2 * tp + fp + fn else 0.0}


def measure(binary, adapter, directory, url):
    totals = {}
    for line in (directory / "cases.jsonl").read_text().splitlines():
        case = json.loads(line)
        function = case["function"]
        command = [binary, function, *case["args"], "--backend", adapter, "--json"]
        if url:
            command.extend(["--url", url])
        result = subprocess.run(command, input=case["text"], text=True,
                                capture_output=True, check=False)
        if result.returncode not in (0, 1, 3):
            raise ValueError(f'{case["id"]}: command exited {result.returncode}: {result.stderr.strip()}')
        rows = [json.loads(row) for row in result.stdout.splitlines()]
        if len(rows) != 1 or rows[0].get("status") not in ("answered", "unsure"):
            raise ValueError(f'{case["id"]}: expected one successful result row')
        answer = rows[0].get("answer")
        predicted = Counter({match_key(function, item, case["text"])
                             for item in identity(function, answer)}) if answer is not None else Counter()
        expected = Counter({match_key(function, item, case["text"]) for item in case["expected"]})
        scopes = [(function, predicted, expected)]
        if function == "recognize":
            for kind in case["args"][1::2]:
                scopes.append((f"recognize:{kind}",
                               Counter({key: n for key, n in predicted.items() if key[0] == kind}),
                               Counter({key: n for key, n in expected.items() if key[0] == kind})))
        for scope, said, truth in scopes:
            correct = sum((said & truth).values())
            counts = totals.setdefault(scope, [0, 0, 0, 0])
            for index, value in enumerate((correct, sum(said.values()) - correct,
                                           sum(truth.values()) - correct, 1)):
                counts[index] += value
    if not totals:
        raise ValueError("benchmark has no cases")
    print("function\tbackend\tcases\ttp\tfp\tfn\tprecision\trecall\tf1")
    scores = {name: metrics(*counts) for name, counts in totals.items()}
    for function, score in sorted(scores.items()):
        print(f"{function}\t{adapter}\t{score['cases']}\t{score['tp']}\t{score['fp']}\t{score['fn']}"
              f"\t{score['precision']:.6f}\t{score['recall']:.6f}\t{score['f1']:.6f}")
    print("\nRecorded comparison (public sets may occur in model training):")
    for row in json.loads((directory / "comparison.json").read_text()):
        row["measured_backend"] = adapter
        row["measured"] = scores.get(row.get("scope", row["function"]))
        print(json.dumps(row, ensure_ascii=False, sort_keys=True))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("binary", help="path to the built thinkthen command")
    parser.add_argument("adapter", choices=("systemone", "openai"))
    parser.add_argument("--url", help="pass the command's backend address override")
    parser.add_argument("--data", type=Path, default=Path(__file__).resolve().parent.parent / "quality",
                        help="directory containing cases.jsonl and comparison.json")
    args = parser.parse_args()
    try:
        measure(str(Path(args.binary).resolve()), args.adapter, args.data, args.url)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"quality: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
