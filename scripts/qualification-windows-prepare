#!/usr/bin/env python3
"""Prepare the caller's pinned dynamic Jansson dependency for Windows checks."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

from release_prepare_common import TOOLS, fetch, run
from release_windows_host import selections

# vcpkg 2025.10.17 retains the reviewed Jansson port and its source SHA512.
# https://github.com/microsoft/vcpkg/tree/74e6536215718009aae747d86d84b78376bf9e09/ports/jansson
REVISION = '74e6536215718009aae747d86d84b78376bf9e09'
# Official vcpkg-tool release asset digest, independent of the runner's tools.
# https://github.com/microsoft/vcpkg-tool/releases/tag/2025-10-16
TOOL_SHA256 = '30430c3d3f58f9710c4e0671db5cf4ebe8445760fe8452ac8f9365ac990beae0'

if os.name != 'nt':
    sys.exit('Windows dependency preparation requires native Windows')
folder = TOOLS / 'qualification-vcpkg' / REVISION
folder.mkdir(parents=True, exist_ok=True)
if not (folder / '.git').exists():
    run('git', 'init', '--quiet', folder)
head = subprocess.run(['git', '-C', str(folder), 'rev-parse', 'HEAD'], capture_output=True, text=True)
if head.returncode or head.stdout.strip() != REVISION:
    run('git', '-C', folder, 'fetch', '--depth=1', 'https://github.com/microsoft/vcpkg.git', REVISION)
    run('git', '-C', folder, 'checkout', '--quiet', '--detach', REVISION)
port = json.loads((folder / 'ports/jansson/vcpkg.json').read_text())
selected = next(name for name in selections()['INPUTS'] if name.startswith('jansson-'))
if port['version'] != selected.removeprefix('jansson-').removesuffix('.tar.gz'):
    raise ValueError('vcpkg Jansson differs from the reviewed Windows dependency')
metadata = dict(line.split('=', 1) for line in (folder / 'scripts/vcpkg-tool-metadata.txt').read_text().splitlines() if '=' in line)
tag = metadata['VCPKG_TOOL_RELEASE_TAG']
executable = fetch(f'https://github.com/microsoft/vcpkg-tool/releases/download/{tag}/vcpkg.exe',
                   folder / 'vcpkg.exe', TOOL_SHA256)
run(executable, 'install', 'jansson:x64-windows', '--disable-metrics', cwd=folder,
    env=dict(os.environ, VCPKG_DISABLE_METRICS='1'))
prefix = folder / 'installed/x64-windows'
if not prefix.is_dir():
    raise ValueError('vcpkg did not install the caller dependency')
if os.environ.get('GITHUB_ENV'):
    with Path(os.environ['GITHUB_ENV']).open('a', encoding='utf-8') as output:
        output.write(f'VCPKG_ROOT={folder}\nJANSSON_ROOT={prefix}\n')
print('Windows caller dependency prepared at ' + str(prefix))

# The native single-file consumer restores only from this prepared RID/task feed.
feed = TOOLS / 'windows-singlefile-packages'
with tempfile.TemporaryDirectory(prefix='thinkthen-singlefile-prepare-') as temporary:
    scratch = Path(temporary)
    project = scratch / 'Consumer.csproj'
    project.write_text('<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><PublishSingleFile>true</PublishSingleFile><SelfContained>false</SelfContained></PropertyGroup></Project>')
    run('dotnet', 'restore', project, '--runtime', 'win-x64', '--packages', feed,
        '--source', 'https://api.nuget.org/v3/index.json',
        env=dict(os.environ, DOTNET_CLI_HOME=str(scratch), DOTNET_CLI_TELEMETRY_OPTOUT='1',
                 DOTNET_SKIP_FIRST_TIME_EXPERIENCE='1', DOTNET_GENERATE_ASPNET_CERTIFICATE='false'))
if os.environ.get('GITHUB_ENV'):
    with Path(os.environ['GITHUB_ENV']).open('a', encoding='utf-8') as output:
        output.write(f'THINKTHEN_WINDOWS_SINGLEFILE_FEED={feed}\n')
print('Windows single-file consumer dependencies prepared at ' + str(feed))
