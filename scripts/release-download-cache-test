#!/usr/bin/env python3
"""Exercise pinned input preparation through stale, warm and refused downloads."""
import hashlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
from threading import Barrier, Thread
from concurrent.futures import ThreadPoolExecutor
import unittest
from unittest.mock import patch
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))
from release_downloads import fetch
import release_installed_prepare
import release_windows_r


class DownloadCache(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.root = Path(self.directory.name)
        self.bodies, self.requests = {}, []
        self.barrier = None
        owner = self
        class Handler(BaseHTTPRequestHandler):
            def do_GET(self):
                owner.requests.append(self.path)
                if owner.barrier is not None:
                    owner.barrier.wait()
                if self.path not in owner.bodies:
                    self.send_error(404)
                    return
                self.send_response(200)
                self.end_headers()
                self.wfile.write(owner.bodies[self.path])
            def log_message(self, *arguments):
                pass
        self.server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
        self.worker = Thread(target=self.server.serve_forever)
        self.worker.start()
        self.base = 'http://127.0.0.1:' + str(self.server.server_port)

    def tearDown(self):
        self.server.shutdown()
        self.server.server_close()
        self.worker.join()
        self.directory.cleanup()

    def test_windows_r_prepare_refreshes_same_name_and_reuses_verified_bytes(self):
        names = list(release_windows_r.pins())
        selected = {}
        for name in names:
            body = ('dated snapshot ' + name).encode()
            self.bodies['/' + name] = body
            selected[name] = (self.base + '/' + name, hashlib.sha256(body).hexdigest())
            path = self.root / 'windows' / name
            path.parent.mkdir(exist_ok=True)
            path.write_bytes(b'old snapshot with the same package version')
        with patch.object(release_windows_r, 'TOOLS', self.root), patch.object(release_windows_r, 'pins', return_value=selected):
            self.assertEqual(release_windows_r.inputs(), selected)
            self.assertCountEqual(self.requests, ['/' + name for name in names])
            release_windows_r.inputs()
            self.assertEqual(len(self.requests), len(names))
            for name in names:
                self.assertEqual((self.root / 'windows' / name).read_bytes(), self.bodies['/' + name])
            for name in names:
                (self.root / 'windows' / name).unlink()
            release_windows_r.inputs()
            self.assertEqual(len(self.requests), 2 * len(names))

    def test_invalid_replacement_or_network_failure_never_promotes_bytes(self):
        path = self.root / 'tool.zip'
        expected = hashlib.sha512(b'correct pinned tool').hexdigest()
        self.bodies['/tool'] = b'wrong network payload'
        url = self.base + '/tool'
        for old in (None, b'old cached tool'):
            if old is not None:
                path.write_bytes(old)
            with self.assertRaisesRegex(ValueError, 'checksum differs'):
                fetch(url, path, 'sha512:' + expected)
            self.assertEqual(path.read_bytes() if path.exists() else None, old)
            self.assertFalse(list(self.root.glob('*.partial')))
        with patch('release_downloads.subprocess.run', side_effect=subprocess.CalledProcessError(7, ['curl'])):
            with self.assertRaises(subprocess.CalledProcessError):
                fetch(url, path, expected)
        self.assertEqual(path.read_bytes(), b'old cached tool')
        self.assertFalse(list(self.root.glob('*.partial')))
        self.bodies['/tool'] = b'correct pinned tool'
        self.assertEqual(fetch(url, path, 'sha512:' + expected).read_bytes(), b'correct pinned tool')

    def test_urls_pinned_to_one_digest_back_each_other_up(self):
        pinned, wrong = b'pinned release input', b'wrong network payload'
        first, second, unrelated = (self.base + name for name in ('/first', '/second', '/unrelated'))
        digest = 'sha256:' + hashlib.sha256(pinned).hexdigest()
        registry = self.root / 'pins.json'
        registry.write_text(json.dumps({first: digest, unrelated: 'sha256:' + '0' * 64, second: digest}))
        path = self.root / 'input.tar.gz'

        def attempt(bodies):
            self.bodies, self.requests[:] = bodies, []
            path.unlink(missing_ok=True)
            return fetch(first, path)

        with patch('release_downloads.PINS', registry):
            for bodies in ({'/second': pinned}, {'/first': wrong, '/second': pinned}):
                self.assertEqual(attempt(bodies).read_bytes(), pinned)
                self.assertEqual(self.requests, ['/first', '/second'])
            self.assertEqual(attempt({'/first': pinned, '/second': wrong}).read_bytes(), pinned)
            self.assertEqual(self.requests, ['/first'])
            with self.assertRaisesRegex(ValueError, 'checksum differs: input.tar.gz from ' + second):
                attempt({'/second': wrong})
            self.assertFalse(path.exists())
            with self.assertRaises(subprocess.CalledProcessError) as refused:
                attempt({})
            self.assertFalse(path.exists())
        self.assertIn(first + ' ' + second, str(refused.exception))
        self.assertEqual(self.requests, ['/first', '/second'])
        self.assertFalse(list(self.root.glob('*.partial')))

    def test_jvm_prepare_gets_maven_while_either_apache_host_is_down(self):
        launcher = self.root / 'mvn'
        launcher.write_text('#!/bin/sh\n')
        launcher.chmod(0o755)
        archive = self.root / 'maven.tar.gz'
        with tarfile.open(archive, 'w:gz') as packed:
            packed.add(launcher, 'apache-maven-3.9.11/bin/mvn')
        digest = hashlib.sha256(archive.read_bytes()).hexdigest()
        pins = json.loads((ROOT / 'scripts/release-downloads.json').read_text())
        checkout = self.root / 'checkout'
        for name in ('scripts/jvm-prepare', 'scripts/release_downloads.py', 'sdk/java/pom.xml', 'sdk/kotlin/pom.xml'):
            (checkout / name).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(ROOT / name, checkout / name)
        for name in ('scripts/jvm-generated', 'scripts/kotlin_compiler.py'):
            (checkout / name).touch()
        (checkout / 'scripts/release-downloads.json').write_text(json.dumps(
            {url: digest for url in pins if url.endswith('/apache-maven-3.9.11-bin.tar.gz')}))
        tools = self.root / 'bin'
        tools.mkdir()
        (tools / 'curl').write_text('#!' + sys.executable + """
import os, shutil, sys
url, target = sys.argv[-3], sys.argv[-1]
with open(os.environ['CURL_LOG'], 'a') as log: print(url, file=log)
if os.environ['DOWN_HOST'] in url: sys.exit(7)
shutil.copy(os.environ['MAVEN_ARCHIVE'], target)
""")
        (tools / 'curl').chmod(0o755)
        for down, reached in (('archive.apache.org', ['repo.maven.apache.org']),
                              ('repo.maven.apache.org', ['repo.maven.apache.org', 'archive.apache.org'])):
            with self.subTest(down=down):
                cache = self.root / ('cache-' + down)
                for folder in ('jdk-22.0.2+9', 'jdk-22.0.2+9/Contents/Home'):
                    java = cache / folder / 'bin/java'
                    java.parent.mkdir(parents=True)
                    shutil.copy2(launcher, java)
                log = self.root / (down + '.log')
                subprocess.run([checkout / 'scripts/jvm-prepare'], check=True, capture_output=True, env=dict(
                    os.environ, PATH=str(tools) + os.pathsep + os.environ['PATH'], THINKTHEN_JVM_CACHE=str(cache),
                    CURL_LOG=str(log), DOWN_HOST=down, MAVEN_ARCHIVE=str(archive)))
                self.assertTrue((cache / 'apache-maven-3.9.11/bin/mvn').is_file())
                self.assertEqual([urlparse(url).hostname for url in log.read_text().split()], reached)

    def test_installed_consumers_try_maven_central_then_the_apache_archive(self):
        down = subprocess.CalledProcessError(7, ['curl'])
        with patch('release_downloads.subprocess.run', side_effect=down) as curl:
            with self.assertRaises(subprocess.CalledProcessError):
                release_installed_prepare.jvm(self.root, self.root)
        self.assertEqual([urlparse(call.args[0][-3]).hostname for call in curl.call_args_list],
                         ['repo.maven.apache.org', 'archive.apache.org'])

    def test_two_callers_refresh_one_stale_destination_atomically(self):
        path = self.root / 'shared.zip'
        path.write_bytes(b'old cached archive')
        self.bodies['/shared'] = b'new pinned shared archive'
        digest = hashlib.sha256(self.bodies['/shared']).hexdigest()
        self.barrier = Barrier(2)
        with ThreadPoolExecutor(max_workers=2) as workers:
            futures = [workers.submit(fetch, self.base + '/shared', path, digest) for _ in range(2)]
            for future in futures:
                self.assertEqual(future.result().read_bytes(), self.bodies['/shared'])
        self.assertEqual(len(self.requests), 2)
        self.assertEqual(path.read_bytes(), self.bodies['/shared'])
        self.assertFalse(list(self.root.glob('*.partial')))

    def test_every_restorable_tool_cache_prefix_includes_the_pin_table(self):
        source = ROOT / '.github/workflows/native-qualification.yml'
        workflow = json.loads(subprocess.check_output(['ruby', '-ryaml', '-rjson', '-e',
            'puts JSON.generate(YAML.safe_load_file(ARGV[0], aliases: true))', source], text=True))
        for job in workflow['jobs'].values():
            for step in job.get('steps', []):
                if 'actions/cache@' not in step.get('uses', ''):
                    continue
                options = step['with']
                prefix = options.get('restore-keys')
                if prefix is None:
                    continue
                self.assertIn("hashFiles('scripts/release-downloads.json', 'scripts/release-tools.json', 'scripts/release-windows-prepare')", prefix)
                self.assertTrue(options['key'].startswith(prefix))
                self.assertNotIn('\n', prefix)


if __name__ == '__main__':
    unittest.main()
