#!/usr/bin/env python3
"""Distinguish historical/negative metadata from retired active public names."""
import json
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
check = [str(ROOT / 'scripts/bindings-schema')]
source = ROOT / 'sdk/python/thinkthen/_types.py'
original = source.read_bytes()
metadata = {name: ROOT / "site/src/data" / name
            for name in ('old-addresses.txt', 'redirects.json', 'words.json')}
historical = '/answers/evidence-piped/'
assert historical in metadata['old-addresses.txt'].read_text().splitlines()
assert json.loads(metadata['redirects.json'].read_text())[historical] == '/command-line/json-lines/'
assert {'word': 'evidence', 'use': 'Say text or field.'} in json.loads(metadata['words.json'].read_text())['banned']
probes = [ROOT / 'sdk/python' / name / '0481-retirement-probe'
          for name in ('.pytest_cache', '.ruff_cache', '__pycache__')]
assert all(not path.exists() for path in probes), 'retirement probe already exists'
try:
    for path in probes:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text('private test evidence\n')
    warm = subprocess.run(check, text=True, capture_output=True)
    assert warm.returncode == 0, warm.stdout + warm.stderr
    probes_by_file = {
        source: original + b'\n# evidence retirement test\n',
        ROOT / 'README.md': (ROOT / 'README.md').read_bytes() + b'\nUse --evidence.\n',
        ROOT / 'schemas/request.schema.json': None,
        ROOT / 'crates/thinkthen/src/cli/help.rs': None,
        metadata['old-addresses.txt']: metadata['old-addresses.txt'].read_bytes() + b'Use evidence here.\n',
        metadata['redirects.json']: None,
        metadata['words.json']: None,
    }
    for path, replacement in probes_by_file.items():
        saved = path.read_bytes()
        try:
            if path == ROOT / 'schemas/request.schema.json':
                schema = json.loads(saved)
                schema['description'] = 'Use --evidence.'
                replacement = json.dumps(schema).encode()
            elif path == ROOT / 'crates/thinkthen/src/cli/help.rs':
                assert b'--choice billing' in saved, 'public help example moved'
                replacement = saved.replace(b'--choice billing', b'--evidence billing', 1)
            elif path == metadata['redirects.json']:
                redirects = json.loads(saved)
                redirects[historical] = '/evidence/'
                replacement = json.dumps(redirects).encode()
            elif path == metadata['words.json']:
                vocabulary = json.loads(saved)
                vocabulary['banned'][0]['use'] = 'Say evidence.'
                replacement = json.dumps(vocabulary).encode()
            path.write_bytes(replacement)
            public = subprocess.run(check, text=True, capture_output=True)
            assert public.returncode != 0, f'retired public spelling admitted: {path}'
            assert str(path.relative_to(ROOT)) in public.stdout + public.stderr, public
        finally:
            path.write_bytes(saved)
finally:
    source.write_bytes(original)
    for path in probes:
        path.unlink(missing_ok=True)
subprocess.run(['git', 'diff', '--exit-code'], cwd=ROOT, capture_output=True, check=True)
print('Historical paths and banned matchers pass; active source/schema/help/targets/descriptions are rejected.')
