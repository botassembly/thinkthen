#!/usr/bin/env python3
"""Reject unused Rust dependencies with the prepared, pinned scanner."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import tomllib
from runtime_floors import FLOORS

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prepare', action='store_true', help='install the pinned scanner with network access')
    parser.add_argument('--self-test', action='store_true', help='prove an unused dependency refuses a fixture')
    args = parser.parse_args()
    version = tomllib.loads((ROOT / 'Cargo.toml').read_text())['workspace']['metadata']['supply-chain']['cargo-machete']
    command, install = ['cargo', 'machete'], ['cargo', 'install', '--locked', '--version', version, 'cargo-machete']
    available = shutil.which('cargo-machete') is not None
    if os.environ.get('THINKTHEN_FLOOR_BUILD') == '1':
        channel = tomllib.loads((ROOT / 'rust-toolchain.toml').read_text())['toolchain']['channel']
        prefix = Path.home() / '.local/share/thinkthen-build-tools/cargo-machete' / f'{version}-glibc{FLOORS["linux"]["glibc"]}-rust{channel}' / 'installed'
        tool = prefix / 'bin/cargo-machete'
        command, available = [str(tool)], tool.is_file()
        install += ['--root', str(prefix)]
        if not available and not args.prepare:
            raise SystemExit('rust dependencies: prepare the pinned floor tool at ' + str(tool))
    if args.prepare and not available:
        subprocess.run(install, check=True)
    actual = subprocess.check_output([*command, '--version'], text=True).strip()
    if actual != version:
        raise SystemExit('rust dependencies: prepare cargo-machete ' + version + '; found ' + actual)
    if args.prepare:
        return
    if args.self_test:
        with tempfile.TemporaryDirectory(prefix='thinkthen-dependencies-') as temporary:
            root = Path(temporary)
            (root / 'src').mkdir()
            (root / 'src/main.rs').write_text('fn main() {}\n')
            (root / 'Cargo.toml').write_text('[package]\nname="unused-fixture"\nversion="0.0.0"\n[dependencies]\nserde="1"\n')
            result = subprocess.run([*command, str(root)], capture_output=True, text=True)
            if result.returncode != 1 or 'serde' not in result.stdout:
                raise SystemExit('rust dependencies: unused fixture was not refused\n' + result.stdout + result.stderr)
            print('rust dependencies: unused serde fixture refused')
    else:
        raise SystemExit(subprocess.run([*command, str(ROOT)]).returncode)


if __name__ == '__main__':
    main()
