#!/usr/bin/env python3
"""Check day-one public documentation offline; optionally check a private baseline."""
import argparse
import io
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--baseline')
parser.add_argument('--root', type=Path)
parser.add_argument('--surface', action='append', default=[], help='limit guide and SDK mirrors; common release checks still run')
options = parser.parse_args()
selected = set(options.surface)
ROOT = Path(__file__).resolve().parent.parent
if options.baseline:
    with tempfile.TemporaryDirectory(prefix='thinkthen-docs-baseline-') as folder:
        archive = subprocess.check_output(['git', 'archive', options.baseline], cwd=ROOT)
        tarfile.open(fileobj=io.BytesIO(archive)).extractall(folder, filter='data')
        subprocess.run([sys.executable, __file__, '--root', folder, *[part for name in options.surface for part in ('--surface', name)]], check=True)
    sys.exit(0)
if options.root:
    ROOT = options.root
sys.path.insert(0, str(ROOT / 'scripts'))
from release_install import release_note

unknown = selected - {path.stem for path in (ROOT / 'docs/surfaces').glob('*.md')}
if unknown:
    parser.error('unknown surfaces: ' + ', '.join(sorted(unknown)))
errors = []
readme = (ROOT / 'README.md').read_text()
for guide in sorted((ROOT / 'docs/surfaces').glob('*.md')):
    if selected and guide.stem not in selected:
        continue
    if f'docs/surfaces/{guide.name}' not in readme:
        errors.append(f'guide missing from README: {guide.name}')
    text = guide.read_text()
    for pattern in (r'\bsupplied\s+(?:(?:release[- ]candidate|matching|native|C\+\+|C|SDK)\s+)*(?:archive|package|wheel|library|module|installer|binary|binaries)\b', r'go mod edit -replace', r'\.package\(path:', r'pip install /', r'npm install /', r'gem install --local'):
        if re.search(pattern, text, re.I):
            errors.append(f'{guide.name}: outdated local-package instruction: {pattern}')
# The site and mirrored SDK guides publish exactly the code exercised by runners.
for guide in sorted((ROOT / 'docs/surfaces').glob('*.md')):
    if selected and guide.stem not in selected:
        continue
    if guide.stem == 'c-cpp':
        continue
    route = {'bash': 'command-line/guide', 'service': 'reference/json-output'}.get(guide.stem, 'sdks/' + guide.stem)
    page = ROOT / 'site/src/content/docs' / (route + '.mdx')
    fences = lambda text: re.findall(r'^```([^\n]*)\n(.*?)^```\s*$', text, re.M | re.S)
    if not page.exists() or fences(page.read_text()) != fences(guide.read_text()):
        errors.append(f'{guide.name}: site code differs from the tested public guide')
    readme = ROOT / 'sdk' / guide.stem / 'README.md'
    if guide.stem in {'python', 'typescript', 'go', 'r', 'ruby', 'swift', 'c', 'cpp'} and not readme.read_text().startswith(guide.read_text()):
        errors.append(f'{guide.name}: mirrored SDK guide differs')
if (not selected or 'rust' in selected) and not (ROOT / 'crates/thinkthen/README.md').read_text().startswith((ROOT / 'docs/surfaces/rust.md').read_text()):
    errors.append('Rust package README differs from its tested public guide')
for name, directory in (('duckdb', 'databases/duckdb'), ('sqlite', 'extensions/sqlite'), ('postgresql', 'extensions/postgres')):
    if selected and name not in selected:
        continue
    if not (ROOT / directory / 'README.md').read_text().startswith((ROOT / 'docs/surfaces' / (name + '.md')).read_text()):
        errors.append(f'{name}: database README differs from its tested guide')
for path in ('sdk/java/PACKAGING.md', 'sdk/csharp/PACKAGING.md', 'crates/thinkthen-proxy/README.md'):
    if (ROOT / path).exists():
        errors.append(f'internal design/packaging note remains public: {path}')
ffi = (ROOT / 'crates/thinkthen-ffi/README.md').read_text()
if 'sdk/c/README.md' not in ffi or re.search(r'\bthinkthen_(?:client_open|call_open|send_text|next)\b', ffi):
    errors.append('C ABI README must link to the real C interface')
for language, entry in (('java', r'public\s+static\s+void\s+main\s*\('),
                        ('kotlin', r'(?:suspend\s+fun\s+main\s*\(|fun\s+main\s*\(\)\s*=\s*runBlocking)')):
    text = (ROOT / f'sdk/{language}/README.md').read_text()
    if re.search(entry, text) is None:

        errors.append(f'{language}: quickstart has no runnable entry point')
for folder in (ROOT / 'sdk').iterdir():
    path = folder / 'README.md'
    if path.exists() and (not selected or folder.name in selected) and 'docs/surfaces/' not in path.read_text():
        errors.append(f'{folder.name}: SDK README has no surface-guide link')
note = release_note('0.2.0', {})
headings = re.findall(r'^## (.+)$', note, re.M)
if headings[:3] != ['Install', 'For 0.1 users', 'Known limits']:
    errors.append(f'release section order: {headings[:3]}')
for command in ('--yes-means', '--no-means'):
    if command not in (ROOT / 'docs/surfaces/bash.md').read_text():
        errors.append(f'CLI meaning option missing: {command}')
if errors:
    raise SystemExit('\n'.join(errors))
print('Day-one public documentation: PASS')
