#!/bin/sh
# Prepare the pinned SDK before running offline C# gates.
set -eu
cd "$(dirname "$0")/.."
export THINKTHEN_DOTNET_HOME="${THINKTHEN_DOTNET_HOME:-$HOME/.local/share/thinkthen-build-tools/dotnet10}"
python3 - <<'PY'
import json, os, platform, tarfile
from pathlib import Path
import sys
sys.path.insert(0, 'scripts')
from release_downloads import PINS, fetch
tools = Path(os.environ['THINKTHEN_DOTNET_HOME'])
system = 'osx' if platform.system() == 'Darwin' else 'linux'
arch = 'arm64' if platform.machine() in ('arm64', 'aarch64') else 'x64'
urls = [url for url in json.loads(PINS.read_text()) if '/Sdk/' in url and url.endswith(f'-{system}-{arch}.tar.gz')]
url, = urls
archive = fetch(url, tools.parent / 'sources' / url.rsplit('/', 1)[-1])
if not (tools / 'sdk/10.0.402').is_dir():
    tools.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive) as source: source.extractall(tools, filter='data')
PY
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
cargo fetch --locked

# Single-file publishing needs SDK tasks and host runtime packs even when the
# resulting consumer uses its installed framework. Prepare them before gates.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
export DOTNET_CLI_HOME="$scratch/home"
python3 - "$scratch/Consumer.csproj" <<'PYTHON'
from pathlib import Path
import sys
sys.path.insert(0, 'scripts')
from csharp_dependencies import prepare_project
Path(sys.argv[1]).write_text(prepare_project(aot=True))
PYTHON
printf '<configuration><packageSources><clear /></packageSources></configuration>\n' > "$scratch/NuGet.Config"
"$THINKTHEN_DOTNET_HOME/dotnet" restore "$scratch/Consumer.csproj" --configfile "$scratch/NuGet.Config" --packages "$THINKTHEN_DOTNET_HOME/singlefile-packages" --source https://api.nuget.org/v3/index.json
