#!/bin/sh
# Load one installed extension in the minimum and current SQLite native hosts.
set -eu
cd "$(dirname "$0")/.."
root=$PWD
. scripts/native-build-env
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
fixture_archive=${THINKTHEN_SQL_TEST_ARCHIVE:?Provide the shared explicit fixture-routing archive}
THINKTHEN_SQL_TEST_ARCHIVE= scripts/sqlite-package "$scratch/production"
case "$(uname -s)" in Darwin) suffix=dylib ;; Linux) suffix=so ;; esac
python3 databases/duckdb/tests/package-safety.py "$scratch/production/package/thinkthen_sqlite.$suffix"
python3 scripts/surface-example prepare sqlite "$scratch/guide" "$scratch/production/package/thinkthen_sqlite.$suffix"
(cd "$scratch/guide" && python3 "$root/scripts/surface-example" check sqlite python3 example.py)
THINKTHEN_SQL_TEST_ARCHIVE=$fixture_archive scripts/sqlite-package "$scratch/built"
mkdir "$scratch/installed"
tar -xzf "$scratch/built"/*.tar.gz -C "$scratch/installed"
case "$(uname -s)" in Darwin) extension=thinkthen_sqlite.dylib ;; Linux) extension=thinkthen_sqlite.so ;; esac
tools="$HOME/.local/share/thinkthen-build-tools"
jansson="$tools/jansson"
if [ "$(uname -s)" = Linux ]; then jansson=$THINKTHEN_JANSSON_ROOT; fi
if [ -z "${THINKTHEN_LOOPBACK:-}" ]; then cargo build --offline --locked -p loopback --bin loopback; fi
target=${CARGO_TARGET_DIR:-target}
case "$target" in /*) ;; *) target="$root/$target" ;; esac
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
    # Attribute static SQL host counters to the installed database consumer.
    LLVM_PROFILE_FILE="$target/sqlite-%p-%m.profraw"
    export LLVM_PROFILE_FILE
fi
status=0
for version in 3.41.0 3.54.1; do
    cc -std=c11 -Wall -Wextra -Werror -pthread \
        -I "$THINKTHEN_SQLITE_ROOT/sqlite-$version" -I "$jansson/include" \
        extensions/sqlite/tests/consumer.c "$THINKTHEN_SQLITE_ROOT/sqlite-$version/libsqlite3.a" \
        "$jansson/lib/libjansson.a" -ldl -lm -o "$scratch/consumer"
    cc -std=c11 -Wall -Wextra -Werror -fPIC -shared \
        -I "$THINKTHEN_SQLITE_ROOT/sqlite-$version" extensions/sqlite/tests/failing-loader.c \
        -ldl -o "$scratch/failing-loader.$suffix"
    THINKTHEN_FAILURE_EXTENSION="$scratch/installed/$extension" \
        "$scratch/consumer" "$scratch/failing-loader.$suffix" fail
    THINKTHEN_FAILURE_EXTENSION="$scratch/installed/$extension" THINKTHEN_FAIL_FUNCTION=1 \
        "$scratch/consumer" "$scratch/failing-loader.$suffix" fail
    python3 extensions/sqlite/tests/run.py "$scratch/consumer" "$scratch/installed/$extension" "${THINKTHEN_LOOPBACK:-$target/debug/loopback}" "$root" || status=1
    python3 extensions/sqlite/tests/live.py "$scratch/consumer" "$scratch/installed/$extension" extensions/sqlite/examples/all-ten.sql --stub
    THINKTHEN_LOOPBACK="${THINKTHEN_LOOPBACK:-$target/debug/loopback}" \
        python3 scripts/stress-adapters.py --surface sqlite -- python3 extensions/sqlite/tests/stress.py "$scratch/consumer" "$scratch/installed/$extension" || status=1
done
python3 scripts/sql-stress-lifetime-test "$root" sqlite "${THINKTHEN_LOOPBACK:-$target/debug/loopback}" "$scratch/consumer" "$scratch/installed/$extension" || status=1
# Exercise the installed loader with a newer generated consumer requirement.
python3 - "$root" "$scratch/stale-contract.h" <<'PYTHON'
import json
from pathlib import Path
import sys
root, output = map(Path, sys.argv[1:])
version = json.loads((root / 'schemas/abi.json').read_text())['abi_version']
output.write_text('#include "' + str(root / 'crates/thinkthen-ffi/include/thinkthen.h') +
    '"\n#undef THINKTHEN_ABI_VERSION\n#define THINKTHEN_ABI_VERSION ' + str(version + (1 << 16)) + 'u\n')
PYTHON
THINKTHEN_SQLITE_CFLAGS="${THINKTHEN_SQLITE_CFLAGS:--O2} -include $scratch/stale-contract.h" \
    THINKTHEN_SQL_TEST_ARCHIVE=$fixture_archive scripts/sqlite-package "$scratch/incompatible"
python3 - "$scratch/consumer" "$scratch/incompatible/package/$extension" <<'PYTHON'
import subprocess
import sys
result = subprocess.run(sys.argv[1:], input='', text=True, capture_output=True)
assert result.returncode != 0 and 'usage.abi' in result.stderr, result
PYTHON
printf '%s\n' '#include "thinkthen.h"' '#define thinkthen_code_name(value) ((const char *)0)' > "$scratch/unknown-code.h"
THINKTHEN_SQLITE_CFLAGS="${THINKTHEN_SQLITE_CFLAGS:--O2} -include $scratch/unknown-code.h" \
    THINKTHEN_SQL_TEST_ARCHIVE=$fixture_archive scripts/sqlite-package "$scratch/unknown-code"
python3 databases/unknown-code-check.py sqlite "$scratch/consumer" "$scratch/unknown-code/package/$extension"
[ "$status" = 0 ] || exit "$status"
if [ -n "${LLVM_PROFILE_FILE:-}" ]; then
    # Retain the actual static consumer for cargo-llvm-cov object discovery.
    cp "$scratch/installed/$extension" "$target/debug/thinkthen-ffi.so"
fi
if [ -n "${THINKTHEN_SQLITE_ARTIFACT_DIR:-}" ]; then
    mkdir -p "$THINKTHEN_SQLITE_ARTIFACT_DIR"
    cp "$scratch/production"/*.tar.gz "$scratch/consumer" "$THINKTHEN_SQLITE_ARTIFACT_DIR/"
    cp -R "$scratch/built/build" "$THINKTHEN_SQLITE_ARTIFACT_DIR/"
fi
