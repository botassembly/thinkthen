#!/usr/bin/env python3
"""Check the limits and upgrade notes delivered in the release note."""
import os
from pathlib import Path
import re
import tempfile
from unittest.mock import patch

from release_workflow import collect

ROOT = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix='thinkthen-release-documentation-') as temporary:
    source = Path(temporary)
    destination = source / 'release'
    # The release-body generator needs no native artifacts for these text contracts.
    with patch.dict(os.environ, THINKTHEN_RELEASE_REUSE=''):
        collect(source, destination, '0' * 40, [])
    note = (destination / 'INSTALL.md').read_text()
install = note.split('## Install', 1)[1].split('## For 0.1 users', 1)[0]
readme = (ROOT / 'README.md').read_text()
for command, source in (
        ('curl -fsSL https://thinkthen.dev/install.sh | sh', 'install.sh'),
        ('irm https://thinkthen.dev/install.ps1 | iex', 'install.ps1')):
    assert command in (ROOT / source).read_text(), source
    assert command in install, command
    assert command in readme, command
for text in (install, readme):
    assert 'brew install botassembly/thinkthen/thinkthen' in text
    assert 'botassembly/homebrew-thinkthen' not in text
for name in ('PyPI', 'npm', 'RubyGems', 'NuGet', 'Maven Central', 'r-universe',
             'github.com/botassembly/thinkthen/sdk/go/thinkthen', 'Swift Package Manager'):
    assert name in install, name
# Installation facts live in the release instructions; the README hands SDK
# readers to their canonical guides rather than repeating those instructions.
readme_links = set(re.findall(r'\]\((https://thinkthen\.dev/sdks/[^)]+)\)', readme))
for sdk in ('python', 'typescript', 'go', 'java', 'kotlin', 'csharp', 'r', 'ruby',
            'rust', 'swift', 'zig', 'c', 'cpp', 'duckdb', 'sqlite', 'postgresql'):
    assert f'https://thinkthen.dev/sdks/{sdk}/' in readme_links, sdk
    assert (ROOT / f'site/src/content/docs/sdks/{sdk}.mdx').is_file(), sdk
for text in (install, (ROOT / 'docs/surfaces/postgresql.md').read_text(),
             (ROOT / 'extensions/postgres/README.md').read_text()):
    # Preserve every supported-platform fact without prescribing prose order.
    for fact in ('Linux', 'x86-64', 'arm64', 'PostgreSQL 18', 'glibc 2.28 or later'):
        assert fact in text, fact
for surface in ('PostgreSQL LIMIT', 'DuckDB LIMIT', 'SQLite joins', 'DuckDB version', 'Unsigned macOS', 'Unsigned Windows',
                'Cancelling a database query', 'Swift 6.3.2', 'Toolbox shell steps'):
    assert '| ' + surface in note, surface
assert '](/' not in note.split('## Known limits', 1)[1]
assert note.index('## Install') < note.index('## For 0.1 users') < note.index('## Known limits')
limits = (ROOT / 'docs/resource-observations.md').read_text()
assert 'docs/resource-observations.md' in note
for surface, rates in (
        ('C# memory', ('0.2392926316', '0.0883873684')),
        ('SQLite memory', ('0.0366484211', '0.1358147368')),
        ('PostgreSQL memory and descriptors',
         ('0.012934736842105263', '0.023713684210526315'))):
    row = next(line for line in limits.splitlines()
               if line.startswith(f'| {surface} (System One and OpenAI client paths, local stub) |'))
    for fact in (*rates, 'System One', 'OpenAI', 'Linux x86_64',
                 '41 to 60', 'bytes per verified record', 'PASS'):
        assert fact in row, (surface, fact)
    assert 'remain FAIL' not in row, surface
assert '1,900,000 subsequent verified records' in limits
for surface, backend, rate in (('TypeScript', 'OpenAI', '0.3578610526'),
                               ('Java', 'OpenAI', '0.4764294737'),
                               ('R', 'System One', '0.5346357895')):
    row = next(line for line in limits.splitlines()
               if line.startswith(f'| {surface} memory ({backend} client path, local stub) |'))
    assert rate in row, surface
assert 'Earlier short-run memory failures' not in limits
# 0406 dropped "attributed" where the storage owner is unproven. Only the Ruby row names its owner.
ruby = next(line for line in limits.splitlines()
            if line.startswith('| Ruby memory (System One and OpenAI client paths, local stub) |'))
for fact in ('0.065', '1.261', 'System One', 'OpenAI', 'Linux x86_64', 'glibc 2.28', '41 to 60',
             'bytes per verified record', 'attributed to glibc allocator retention', "glibc's bytes in use"):
    assert fact in ruby, fact
assert 'Both observations are PASS' not in ruby
# 0674 j35711: the tunable a user may set, which the library never sets.
assert 'glibc.malloc.mmap_threshold=65536' in ruby and 'the library does not set it' in ruby
assert [line for line in limits.splitlines() if 'attributed' in line.replace('One attributed allocator-retention observation', '')] == [ruby]
assert 'Seven PASS observations cover C#, SQLite and PostgreSQL on both the System One and OpenAI client paths and Ruby on the System One client path.' in limits
assert 'One attributed allocator-retention observation covers Ruby on the OpenAI client path.' in limits
assert 'Three separate retention observations cover TypeScript and Java on the OpenAI client path and R on the System One client path.' in limits
assert 'Six new installed-package observations' in limits
assert 'one saved historical PostgreSQL/OpenAI observation' in limits
assert 'not a qualification of the new release' in limits
assert '8 known failures' not in limits
assert 'future growth and absence of leaks remain unproven' in limits
upgrade = note.split('## For 0.1 users', 1)[1].split('## Platforms and requirements', 1)[0]
# Released v0.1.2 (08328c9c04574719b9e93900dd8fa46ad3b645b4) CLI args,
# audit and diff supply this migration inventory, including their nested commands.
for command in ('status', 'check', 'cache', 'transform', 'cache prune', 'cache unused', 'cache convert'):
    assert f'`{command}`' in upgrade, command
for option in ('details', 'json', 'jsonl', 'on-error', 'plan', 'dry-run', 'timeout',
               'seed', 'profile', 'max-requests-total', 'max-estimated-input-tokens-total',
               'facts', 'input', 'lines', 'csv', 'tsv', 'field', 'context', 'jobs',
               'max-retries', 'max-request-bytes', 'max-text-bytes', 'raw',
               'option', 'options', 'label', 'kind', 'relation', 'relation-threshold',
               'kind-field', 'none', 'record', 'replay', 'cache', 'no-cache', 'refresh-cache',
               'max-size', 'older-than', 'answered-by-other-than', 'used', 'quote',
               'by', 'id', 'target', 'optimize', 'write', 'write-to', 'match', 'curve',
               'pooled', 'table', 'cases', 'compare-threshold'):
    assert f'`--{option}`' in upgrade, option
for feature in ('polars', 'bundled-sqlite', 'host-sqlite'):
    assert f'`{feature}`' in upgrade, feature
for fact in ('Intel macOS', 'static musl Linux', 'glibc 2.28',
             'Current `--details` adds status', 'no compatibility shims'):
    assert fact in upgrade, fact
assert 'cargo add thinkthen --no-default-features' in note
assert 'R source packages require R >=4.2.0' in note
assert '`--threshold LOW:HIGH` becomes `--low LOW --high HIGH`' in upgrade
assert '`--batch max`' in upgrade and '`--batch` now takes a record count' in upgrade
assert 'Botassembly.ThinkThen' in note
assert 'github.com/botassembly/thinkthen/sdk/go/thinkthen' in note
assert '0.1.2' in note
assert '`--true TEXT` and `--false TEXT` describe what yes and no mean' in upgrade
assert '`--quiet` suppresses answers, JSON rows, notices and progress' in upgrade
assert 'failure diagnostics still reach standard error' in upgrade
assert '`--check --quiet`' in upgrade and 'false/none (1), unsure (3)' in upgrade
assert 'For choose and tag, add `--describe LABEL=TEXT`' in upgrade
assert '--choice billing --choice shipping --describe "billing=About charges"' in upgrade
assert '0.1 selected a candidate record from the whole input; 0.2 selects a line within each record' in upgrade
assert 'Unicode-scalar span-to-ID map' in upgrade
assert 'Multiline or blank candidates need an explicit single-line encoding' in upgrade
assert 'An answered null means none; unsure and failed do not' in upgrade
assert 'Old thresholds and model-quality results do not establish parity' in upgrade
assert 'Audit and diff are available as offline tools with new 0.2 formats and syntax' in upgrade
assert 'thinkthen audit ROWS --manifest RUN.json --key GOLD.jsonl' in upgrade
assert 'thinkthen diff LEFT --left-manifest L.json --right RIGHT --right-manifest R.json' in upgrade
assert 'recommend no threshold and change no settings' in upgrade
assert '`--usage` for observed request/token accounting on stderr' in upgrade
assert '`--max-requests N` to cap actual send attempts for one command invocation' in upgrade
assert 'Recovery is not automatic resume' in upgrade
assert '--response-store DIR --response-mode cache|record|replay --response-namespace NAME --model-generation NAME' in upgrade
for option in ('response-max-bytes', 'response-max-entries', 'response-max-age'):
    assert f'`--{option}`' in upgrade, option
assert 'No environment variable enables retention' in upgrade
assert 'Strict replay needs no provider key and never falls back to a live call' in upgrade
assert 'new store does not import old cache folders' in upgrade
assert '`THINKTHEN_URL` sets only the System One address' in upgrade
assert 'OpenAI reads `OPENAI_BASE_URL`' in upgrade
assert '`THINKTHEN_MODEL` applies only to commands' in upgrade
assert 'TypeSafe service' not in note
assert '`--details` becomes `--json`' not in upgrade
assert r'Unblock-File .\thinkthen-0.2.0-windows-x86_64.zip' in note
# Each database README output is the real capture of the program above it.
for name, surface in (('extensions/sqlite/README.md', 'sqlite'),
                      ('extensions/postgres/README.md', 'postgresql'),
                      ('databases/duckdb/README.md', 'duckdb')):
    text = (ROOT / name).read_text()
    assert re.search(r'^Output:\n\n(?!```)', text, re.M) is None, name
    captures = {path.read_text().strip(): path.parent
                for path in (ROOT / 'site/examples/sdks' / surface).glob('*/show.sql')}
    for program, output in re.findall(r'```sql\n(.*?)\n```\n\nOutput:\n\n```text\n(.*?)\n```', text, re.S):
        capture = captures[program.strip()]
        assert output == (capture / 'output.txt').read_text().rstrip('\n'), (name, capture.name)
print('Release limits and upgrade notes: PASS')
