#!/usr/bin/env python3
"""Run the engine under valgrind memcheck and fail on memory that grows with calls.

Usage: scripts/leak-check REPORT.json [--reachable-allowance BYTES] [--fixture leak]

One client makes 100 calls over HTTP to the loopback server and closes, then the same with
1000 calls (crates/thinkthen/tests/leak.rs). The check passes only when both runs lose no
memory, definitely or indirectly, their possibly-lost bytes are equal, and their
still-reachable bytes differ by at most the allowance, which covers one-time runtime setup. This replaced the release memory soak (0730). On Linux
it runs inside the prepared floor image, which carries valgrind. --fixture leak makes the
test leak one block per call, only to prove the check fails.
"""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
CALLS = (100, 1000)
# Measured once on the real engine over the loopback in the floor image (0730, j38201,
# valgrind 3.22.0): both runs kept 554 bytes still reachable, in two blocks of one-time setup,
# so they differed by 0. The allowance is that setup's whole size; a per-call leak of 1 byte
# exceeds it by 900 calls.
REACHABLE_ALLOWANCE_BYTES = 554
KINDS = ('definitely lost', 'indirectly lost', 'possibly lost', 'still reachable')


def summary(log):
    """Read valgrind's leak summary as bytes per kind; a run that freed everything has none."""
    if 'All heap blocks were freed' in log and 'LEAK SUMMARY' not in log:
        return {kind.replace(' ', '_'): 0 for kind in KINDS}
    if 'LEAK SUMMARY' not in log:
        raise ValueError('valgrind wrote no leak summary')
    found = {}
    for kind in KINDS:
        # Every kind must parse, so a change in valgrind's wording fails rather than reads as zero.
        match = re.search(r'==\d+==\s+' + kind + r': ([\d,]+) bytes in ([\d,]+) blocks', log)
        if not match:
            raise ValueError('valgrind leak summary lacks ' + kind)
        found[kind.replace(' ', '_')] = int(match.group(1).replace(',', ''))
    return found


def test_binary():
    result = subprocess.run(['cargo', 'test', '--locked', '-p', 'thinkthen', '--test', 'leak', '--no-run',
                             '--message-format=json'], cwd=ROOT, check=True, capture_output=True, text=True)
    for line in result.stdout.splitlines():
        message = json.loads(line)
        if message.get('reason') == 'compiler-artifact' and message['target']['name'] == 'leak' and message.get('executable'):
            return message['executable']
    raise ValueError('cargo built no leak test binary')


def run(binary, calls, fixture):
    with tempfile.NamedTemporaryFile('r', suffix='.valgrind') as log:
        started = time.monotonic()
        # This judges leaks only: without --error-exitcode, valgrind's invalid reads and writes
        # are printed in its log but never fail the check.
        result = subprocess.run(['valgrind', '--leak-check=full', '--show-leak-kinds=definite,indirect,possible',
                                 '--log-file=' + log.name, binary, 'calls_on_one_client_then_close',
                                 '--ignored', '--exact', '--test-threads=1'],
                                cwd=ROOT, env=dict(os.environ, THINKTHEN_LEAK_CALLS=str(calls), THINKTHEN_LEAK_FIXTURE=fixture),
                                capture_output=True, text=True)
        text = log.read()
    if result.returncode:
        raise ValueError(f'the {calls}-call run failed (exit {result.returncode}):\n{result.stdout}{result.stderr}{text[-4000:]}')
    # A renamed test or a filter that matches nothing runs no test and still exits 0.
    if 'test result: ok. 1 passed;' not in result.stdout:
        raise ValueError(f'the {calls}-call run did not run the leak test:\n{result.stdout}')
    seconds = round(time.monotonic() - started, 1)
    print(f'valgrind, {calls} calls, {seconds} s:\n' + '\n'.join(line for line in text.splitlines() if 'lost:' in line or 'reachable:' in line or 'ERROR SUMMARY' in line))
    return dict(calls=calls, seconds=seconds, **summary(text))


def judge(runs, allowance):
    small, large = runs
    reachable = large['still_reachable'] - small['still_reachable']
    possibly = large['possibly_lost'] - small['possibly_lost']
    problems = [f"{run['calls']} calls {kind.replace('_', ' ')} {run[kind]} bytes"
                for run in runs for kind in ('definitely_lost', 'indirectly_lost') if run[kind]]
    if possibly:
        problems.append(f'possibly lost differs by {possibly} bytes between {small["calls"]} and {large["calls"]} calls')
    if abs(reachable) > allowance:
        problems.append(f'still reachable differs by {reachable} bytes between {small["calls"]} and {large["calls"]} calls; allowance {allowance}')
    return dict(passed=not problems, problems=problems, possibly_lost_difference_bytes=possibly, reachable_difference_bytes=reachable,
                reachable_allowance_bytes=allowance, runs=runs)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('report', type=Path)
    parser.add_argument('--reachable-allowance', type=int, default=REACHABLE_ALLOWANCE_BYTES, metavar='BYTES')
    parser.add_argument('--fixture', choices=('none', 'leak'), default='none')
    options = parser.parse_args()
    if options.reachable_allowance < 0:
        parser.error('--reachable-allowance must not be negative')
    if sys.platform == 'linux' and os.environ.get('THINKTHEN_FLOOR_BUILD') != '1':
        # The floor mounts this checkout, not the caller's report folder.
        inside = ROOT / 'target/leak-check/report.json'
        inside.unlink(missing_ok=True)
        status = subprocess.run([sys.executable, str(ROOT / 'scripts/runtime-floor-build'), str(Path(__file__).resolve()),
                                 str(inside), '--reachable-allowance', str(options.reachable_allowance),
                                 '--fixture', options.fixture], cwd=ROOT).returncode
        if inside.exists():
            options.report.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(inside, options.report)
        return status
    binary = test_binary()
    verdict = judge([run(binary, calls, options.fixture) for calls in CALLS], options.reachable_allowance)
    verdict.update(fixture=options.fixture, tool=subprocess.check_output(['valgrind', '--version'], text=True).strip())
    options.report.parent.mkdir(parents=True, exist_ok=True)
    options.report.write_text(json.dumps(verdict, indent=2) + '\n')
    print(json.dumps(dict(passed=verdict['passed'], problems=verdict['problems'],
                          possibly_lost_difference_bytes=verdict['possibly_lost_difference_bytes'],
                          reachable_difference_bytes=verdict['reachable_difference_bytes'])))
    return 0 if verdict['passed'] else 1


if __name__ == '__main__':
    sys.exit(main())
