#!/bin/sh
# Check the Ruby interface with a genuine development engine and no credentials.
set -eu
cd "$(dirname "$0")/.."
. scripts/native-tools-env
if [ "${1:-}" = --types ]; then
  exec sdk/ruby/tests/type-gate --dev-gems "$HOME/.local/share/thinkthen-build-tools/ruby/dev"
fi
export CARGO_TARGET_DIR="$HOME/.local/share/thinkthen-build-tools/ruby-interface-debug"
cargo build --offline --locked -p thinkthen-ffi
if [ "${1:-}" = --full ]; then
  export THINKTHEN_RUBY_SOURCE_NATIVE=1
  export THINKTHEN_NATIVE_FIXTURES="$CARGO_TARGET_DIR/ruby-abi-fixtures"
  case "$(uname -s)" in
    Darwin) engine="$CARGO_TARGET_DIR/debug/libthinkthen_ffi.dylib" ;;
    Linux) engine="$CARGO_TARGET_DIR/debug/libthinkthen_ffi.so" ;;
    *) exit 1 ;;
  esac
  scripts/native-fixtures --engine "$engine" --output "$THINKTHEN_NATIVE_FIXTURES"
  exec scripts/ruby-gate
fi
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
cp -R sdk/ruby/lib "$scratch/lib"
case "$(uname -s)" in
 Darwin) library=libthinkthen_ffi.dylib ;;
 Linux) library=libthinkthen_ffi.so ;;
 *) exit 1 ;;
esac
cp "$CARGO_TARGET_DIR/debug/$library" "$scratch/lib/thinkthen/"
export GEM_PATH="$HOME/.local/share/thinkthen-build-tools/ruby/gems:$HOME/.local/share/thinkthen-build-tools/ruby/dev"
export RUBYLIB="$scratch/lib"
status=0
ruby -w sdk/ruby/tests/interface.rb 2>"$scratch/stderr" || status=$?
if [ -s "$scratch/stderr" ]; then
  cat "$scratch/stderr" >&2
  exit 1
fi
exit "$status"
