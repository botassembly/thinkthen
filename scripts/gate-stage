#!/usr/bin/env python3
"""Run one gate stage with a deadline and clean up its owned process group."""
import os
import signal
import subprocess
import sys

seconds, name, *command = sys.argv[1:]
process = subprocess.Popen(['sh', '-c', '"$@"', 'gate-stage', *command],
                           start_new_session=True)


def interrupted(number, _frame):
    raise SystemExit(128 + number)


for number in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(number, interrupted)
try:
    try:
        status = process.wait(timeout=int(seconds))
    except subprocess.TimeoutExpired:
        print(f'Timed out gate stage: {name} (limit {seconds} seconds)', flush=True)
        status = 124
finally:
    # Descendants can still hold the stage's output pipe after its parent exits.
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()
sys.exit(128 - status if status < 0 else status)
