#!/usr/bin/env python3
"""Protect ABI consumer routing without requiring host Ruby or Swift tools."""
import json
import os
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
import tomllib
import unittest
from unittest.mock import Mock, patch

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))


class AbiPlatformRouting(unittest.TestCase):
    def test_swift_sdk_routes_the_canonical_loopback_and_preserves_an_override(self):
        module = runpy.run_path(str(ROOT / 'scripts/linux-binding-gate'))
        state = module['swift'].__globals__
        with tempfile.TemporaryDirectory() as temporary:
            scratch = Path(temporary)
            canonical = str(scratch / 'canonical/loopback')
            override = str(scratch / 'swift/loopback')
            assets = {name: str(scratch / name) for name in (
                'THINKTHEN_CSHARP_NATIVE_ASSETS', 'THINKTHEN_JVM_NATIVE_ASSETS', 'THINKTHEN_NATIVE_FIXTURES')}
            for loopbacks, expected in (
                ({'THINKTHEN_LOOPBACK': canonical}, canonical),
                ({'THINKTHEN_LOOPBACK': canonical, 'THINKTHEN_SWIFT_LOOPBACK': override}, override),
                ({'THINKTHEN_SWIFT_LOOPBACK': override}, override),
            ):
                with self.subTest(loopbacks=loopbacks):
                    package, launch = Mock(), Mock()
                    with patch.dict(os.environ, {**assets, **loopbacks, 'THINKTHEN_GATE_STRICT': '1'}, clear=True), \
                            patch.dict(state, run=package, swift_command=launch):
                        module['swift']()
                    package.assert_called_once()
                    launch.assert_called_once()
                    package_command, stage = package.call_args.args
                    self.assertEqual(package_command, 'scripts/swift-package')
                    command, mounts, forwarded = launch.call_args.args
                    self.assertEqual(command, ['scripts/swift-gate'])
                    self.assertEqual(mounts, (stage.parent, Path(expected).parent))
                    self.assertEqual(forwarded, {**assets, 'THINKTHEN_LOOPBACK': expected,
                                                'THINKTHEN_SWIFT_PACKAGE': stage, 'THINKTHEN_GATE_STRICT': '1',
                                                'THINKTHEN_STRESS_FULL': ''})

    def test_abi_consumers_use_the_platform_runner_while_native_commands_stay_local(self):
        module = runpy.run_path(str(ROOT / 'scripts/abi-minor-check'))
        state = module['bindings'].__globals__
        calls = []
        with tempfile.TemporaryDirectory() as temporary:
            scratch = Path(temporary)
            engine = scratch / 'engine.so'
            engine.write_bytes(b'native engine')

            def fixture(engine, output, **kwargs):
                path = output / engine.name
                path.write_bytes(b'native fixture')
                return path

            def record(args, **kwargs):
                calls.append(args)
                if args[0].endswith('/zig') and args[1] == 'build':
                    (Path(kwargs['cwd']) / 'zig-out/bin').mkdir(parents=True)
            with patch.dict(os.environ, THINKTHEN_SDK_GATE_RUNNER='scripts/linux-binding-gate'), \
                    patch.dict(state, fixture=fixture), \
                    patch('subprocess.run', side_effect=record):
                module['bindings'](engine, scratch, ['cpp', 'ruby', 'swift', 'zig'])
        routed = [args for args in calls if args[0] == 'scripts/linux-binding-gate']
        self.assertEqual([args[2] for args in routed].count('ruby'), 3)
        self.assertEqual([args[2] for args in routed].count('swift'), 5)
        self.assertTrue(all(args[3:6] == ['--scratch', str(scratch), '--'] for args in routed))
        self.assertTrue(any(args[0] == 'c++' for args in calls))
        self.assertTrue(any(args[0].endswith('/zig') for args in calls))
        self.assertFalse(any(args[0] in ('ruby', 'swift') or args[0].endswith('/MinorError') for args in calls))

    def test_ruby_runner_selects_prepared_gems(self):
        with tempfile.TemporaryDirectory() as temporary:
            scratch = Path(temporary)
            env = dict(os.environ, THINKTHEN_RUBY_DEV_GEMS=str(scratch / 'dev'))
            command = [sys.executable, str(ROOT / 'scripts/linux-binding-gate'), '--abi-binding']
            result = subprocess.run(command + ['ruby', '--scratch', str(scratch), '--', sys.executable, '-c',
                                    'import json, os; print(json.dumps([os.environ["GEM_HOME"], os.environ["GEM_PATH"]]))'],
                                    env=env, check=True, capture_output=True, text=True)
            self.assertEqual(json.loads(result.stdout), [str(scratch / 'dev')] * 2)

    @unittest.skipUnless(sys.platform == 'linux', 'Linux loader preparation requires a Linux host')
    def test_linux_runner_selects_the_pinned_swift_container(self):
        from native_platform import current

        with tempfile.TemporaryDirectory() as temporary:
            scratch = Path(temporary)
            docker = scratch / 'docker'
            docker.write_text('#!' + sys.executable + '\nimport json, sys\nprint(json.dumps(sys.argv[1:]))\n')
            docker.chmod(0o755)
            # A pm job sets JOB_LABEL_FILE; without it the runner labels the container itself.
            env = {key: value for key, value in os.environ.items() if key != 'JOB_LABEL_FILE'}
            env.update(PATH=str(scratch) + os.pathsep + os.environ['PATH'], THINKTHEN_SWIFT_IMAGE='sha256:' + 'a' * 64)
            command = [sys.executable, str(ROOT / 'scripts/linux-binding-gate'), '--abi-binding']
            swift = command + ['swift', '--scratch', str(scratch), '--', 'swift', 'build', '--jobs', '2']
            labels = scratch / 'labels'
            labels.write_text('pm.repo=fixture\n')
            labelled = json.loads(subprocess.run(swift, env=dict(env, JOB_LABEL_FILE=str(labels)),
                                                 check=True, capture_output=True, text=True).stdout)
            self.assertEqual(labelled[labelled.index('--label-file') + 1], str(labels.resolve()))
            self.assertFalse(any(value.startswith('pm.ticket=') for value in labelled))
            result = subprocess.run(swift, env=env, check=True, capture_output=True, text=True)
            arguments = json.loads(result.stdout)
            self.assertIn('sha256:' + 'a' * 64, arguments)
            self.assertIn(str(scratch) + ':' + str(scratch), arguments)
            self.assertIn('none', arguments)
            self.assertTrue(any(value.startswith('pm.repo=') for value in arguments))
            self.assertTrue(any(value.startswith('pm.ticket=') for value in arguments))
            setup = arguments.index('swift-gate') + 1
            channel = tomllib.loads((ROOT / 'rust-toolchain.toml').read_text())['toolchain']['channel']
            rust = Path.home() / '.rustup/toolchains' / f'{channel}-{current()["rust"]}' / 'bin'
            self.assertEqual(arguments[setup:setup + 3], [
                str(Path.home() / '.local/share/thinkthen-build-tools/swift/6.3.2-ubuntu22.04'),
                str(rust),
                str(ROOT / 'target/source-tools/swift-git'),
            ])
            self.assertEqual(arguments[setup + 3:], ['swift', 'build', '--jobs', '2'])


if __name__ == '__main__':
    unittest.main()
