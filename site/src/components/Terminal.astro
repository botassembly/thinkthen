---
// One recorded run: what went in, the command, what came out, and the exit
// code in its outcome colour. Nothing here is typed by hand; the fields come
// from src/data/examples/.
//
// The word after the exit code comes from the function's own exits list.
// `fn` names the function; without it, the function is read from the last
// stage of the command. A pipeline that ends in another tool, such as jq,
// gets no word, because that tool set the code. `word={false}` hides it.
import { outcomeOf, exitWord } from '../data/catalog.mjs';

const { run, caption = null, fn = null, word = true } = Astro.props;

const lines = [];
for (const file of run.also || []) {
  lines.push({ cls: 'p', text: `$ cat ${file.name}` });
  for (const l of file.text.split('\n')) lines.push({ cls: 'in', text: l });
}
if (run.input && run.inputFile) {
  lines.push({ cls: 'p', text: `$ cat ${run.inputFile}` });
  for (const l of run.input.split('\n')) lines.push({ cls: 'in', text: l });
}
// A line starts a new command unless it continues one: after a trailing
// backslash or pipe, inside an open quote, indented, or closing a block.
let quote = null;
let more = false;
for (const l of run.command.split('\n')) {
  const cont = quote || more || /^\s/.test(l) || /^(esac|done|fi)\b/.test(l);
  lines.push({ cls: 'cmd', text: (cont ? '' : '$ ') + l });
  for (const c of l.replace(/\\./g, '')) {
    if (quote ? c === quote : c === '"' || c === "'") quote = quote ? null : c;
  }
  more = /(\\|\|)\s*$/.test(l);
}
if (run.input && !run.inputFile) {
  for (const l of run.input.split('\n')) lines.push({ cls: 'in', text: l });
}
if (run.output) for (const l of run.output.split('\n')) lines.push({ cls: 'out', text: l });

const outcome = outcomeOf(run.exit);
const said = word ? exitWord(run.command, run.exit, fn) : null;
const copy = run.command;
---
<div class="block">
  <div class="caption">
    <span class="grow">{caption && caption.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}</span>
    <button class="copy" type="button">Copy</button>
  </div>
  <pre data-copy={copy}>{lines.map((l, i) => (
    <Fragment><span class={l.cls}>{l.text}</span>{i < lines.length - 1 ? '\n' : ''}</Fragment>
  ))}</pre>
  {run.exit !== null && run.exit !== undefined && (
    <div class="caption"><span class={`exit ${outcome}`}>exit {run.exit}{said ? `: ${said}` : ''}</span></div>
  )}
</div>
