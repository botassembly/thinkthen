---
// A code sample with a copy button. Pass `file`, the file it came from, and
// the language follows the file's name. Pass `lang` for code with no file,
// or "output" for what a surface printed. src/lib/code.mjs draws it.
import { codeBlock } from '../lib/code.mjs';
const { code, lang = null, file = null, caption = null, copy = true } = Astro.props;
---
<Fragment set:html={codeBlock({ code, lang, file, caption, copy })} />
