---
// A drawn code sample. Its badge says "not run yet" wherever it appears,
// because no library ships yet. "drawn" stays in the data and the class.
const { code, status = 'drawn', caption = null, copy = true } = Astro.props;
const label = status === 'drawn' ? 'not run yet' : status;
const lines = code.split('\n');
const comment = /^\s*(#|\/\/|--|\/\*|\*)/;
---
<div class="block">
  <div class="caption">
    <span class={`status ${status}`}>{label}</span>
    <span class="grow">{caption}</span>
    {copy && <button class="copy" type="button">Copy</button>}
  </div>
  <pre data-copy={code}>{lines.map((l, i) => (
    <Fragment><span class={comment.test(l) ? 'cm' : 'cmd'}>{l}</span>{i < lines.length - 1 ? '\n' : ''}</Fragment>
  ))}</pre>
</div>
