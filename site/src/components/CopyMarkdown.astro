---
// Copies this page's Markdown twin. `icon` is the responsive top-bar control;
// `button` is the larger control at the foot of the page.
// The Clipboard API needs HTTPS; the private HTTP preview falls back to the browser's copy command.
import { markdownTwin } from '../lib/routes.mjs';
interface Props { variant: 'icon' | 'button' }
const { variant } = Astro.props;
const markdown = markdownTwin(Astro.url.pathname);
const label = variant === 'icon' ? 'Copy page' : 'Copy page as Markdown';
---
<div class:list={['copy-md', variant]} data-pagefind-ignore>
  <button type="button" data-copy-markdown={markdown} data-copy-label={label}>
    <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg>
    <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
    <span class="label" aria-live="polite">{label}</span>
  </button>
</div>
<script>
  import { copyText } from '../lib/clipboard.mjs';
  const resets = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();
  document.addEventListener('click', async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-markdown]');
      if (!button) return;
      const label = button.querySelector('.label')!;
      clearTimeout(resets.get(button));
      button.disabled = true;
      try {
        const response = await fetch(button.dataset.copyMarkdown!);
        if (!response.ok) throw new Error('Markdown unavailable');
        const markdown = await response.text();
        await copyText(markdown);
        button.dataset.state = 'copied';
        label.textContent = 'Copied';
      } catch {
        button.dataset.state = 'failed';
        label.textContent = 'Copy failed';
      } finally {
        button.disabled = false;
        button.focus();
        resets.set(button, setTimeout(() => {
          delete button.dataset.state;
          label.textContent = button.dataset.copyLabel!;
        }, 2000));
      }
  });
</script>
<style>
  .copy-md button { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; font: inherit; }
  .copy-md button:disabled { cursor: progress; }
  .copy-md button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .check-icon, button[data-state='copied'] .copy-icon { display: none; }
  button[data-state='copied'] .check-icon { display: block; color: var(--tt-yes); }

  /* The top bar keeps text above the mobile breakpoint. */
  .icon { position: relative; display: flex; }
  .icon button { inline-size: 44px; block-size: 44px; padding: 0; border: 0; border-radius: 999px; background: transparent; color: var(--sl-color-gray-1); }
  .icon button:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .icon .label {
    position: absolute; inset-block-start: calc(100% + 0.4rem); inset-inline-end: 0;
    padding: 0.25rem 0.5rem; border-radius: 0.375rem; white-space: nowrap;
    background: var(--sl-color-white); color: var(--sl-color-black);
    font-size: var(--sl-text-xs); font-weight: 600; line-height: 1.3;
    opacity: 0; pointer-events: none; transition: opacity 0.12s;
  }
  .icon button:hover .label,
  .icon button:focus-visible .label,
  .icon button[data-state] .label { opacity: 1; }

  @media (min-width: 50rem) {
    .icon button { inline-size: auto; gap: 0.5rem; padding-inline: 0.75rem; }
    .icon .label {
      position: static; padding: 0; background: transparent; color: inherit;
      font-size: var(--sl-text-sm); line-height: inherit; opacity: 1;
    }
  }

  /* The foot-of-page copy button. */
  .button { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-block-start: 3rem; padding-block-start: 1.5rem; border-block-start: 1px solid var(--sl-color-hairline); }
  .button button { gap: 0.5rem; padding: 0.6rem 1.1rem; border: 1px solid var(--sl-color-accent); border-radius: 0.5rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-weight: 600; font-size: var(--sl-text-sm); min-inline-size: 15rem; }
  .button button:hover { background: var(--sl-color-accent); color: var(--sl-color-black); }
</style>
