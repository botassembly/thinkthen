---
// One install line with a copy button. The "$ " prompt shows before the
// line and stays out of the copied text. src/lib/code.mjs draws it.
import { codeBlock } from '../lib/code.mjs';
const { line, note = null, caption = 'Install' } = Astro.props;
const code = note ? `${line}\n# ${note}` : line;
---
<Fragment set:html={codeBlock({ code, lang: 'bash', caption, prompt: true, label: 'Copy the install line', copyText: line })} />
