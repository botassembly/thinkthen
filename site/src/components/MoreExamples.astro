---
// One function's further Bash runs, under a heading at the level the page
// asks for, from src/data/fn-examples.mjs.
import Terminal from './Terminal.astro';
import Code from './Code.astro';
import { examplesOf } from '../data/fn-examples.mjs';

const { fn, level = 'h3' } = Astro.props;
const { extra, moreInputs } = examplesOf(fn);
const Heading = level;
// A file sits directly above the first further run that reads it.
const firstReader = new Map();
for (const run of extra) for (const file of moreInputs) if (run.command.includes(file.name) && !firstReader.has(file.name)) firstReader.set(file.name, run.name);
const above = (run) => moreInputs.filter((file) => firstReader.get(file.name) === run.name);
---
{extra.length > 0 && <Heading id="more-examples">More examples</Heading>}
{extra.map((run) => (
  <>
    {above(run).map((file) => <Code code={file.text} file={file.name} caption={`${file.name}, the file the next example reads`} />)}
    <Terminal run={run} caption={run.see} />
  </>
))}
