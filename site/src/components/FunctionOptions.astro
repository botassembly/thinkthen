---
import { functionOptions } from '../lib/function-options.mjs';
interface Props { name: string }
const { name } = Astro.props;
const options = functionOptions(name);
---
<table data-function-options={name}>
  <thead><tr><th>Option</th><th>What it does</th></tr></thead>
  <tbody>{options.map((row) => <tr><td><code>{row.option}</code></td><td>{row.description}</td></tr>)}</tbody>
</table>

<p><a href="/reference/options/">Shared options</a></p>
