---
// The same call on every surface, as tabs. A surface with no sample says so,
// and a function with a Beatles Bench page points there.
import Terminal from './Terminal.astro';
import Code from './Code.astro';
import { SURFACES } from '../data/catalog.mjs';
import { cell } from '../data/examples.mjs';
import { beatlesPageFor } from '../data/beatles.mjs';

const { fn, first = 1 } = Astro.props;
const bench = beatlesPageFor(fn);

const alias = (slug) => ({
  shell: 'Bash', python: 'Python', polars: 'Python', typescript: 'TypeScript',
  ruby: 'Ruby', r: 'R', rust: 'Rust', c: 'C',
  duckdb: 'SQL', sqlite: 'SQL', postgresql: 'SQL',
}[slug]);

const tabs = SURFACES.map((s) => ({
  slug: s.slug,
  label: s.name,
  alias: alias(s.slug),
  surface: s,
  data: cell(fn, s.slug),
}));
---
<div class="tabbed" data-fallback="Bash">
  <div class="tabs" role="tablist">
    {tabs.map((t) => (
      <button type="button" role="tab" data-lang={t.label} data-alias={t.alias} aria-selected={t.label === 'Bash'}>{t.label}</button>
    ))}
  </div>
  {tabs.map((t) => (
    <div class="cell" data-lang={t.label} hidden={t.label !== 'Bash'}>
      {t.data.status === 'run' && t.data.runs.slice(0, first).map((run) => (
        <Terminal run={run} />
      ))}
      {t.data.status === 'drawn' && <Code code={t.data.code} />}
      {t.data.status === 'drawn' && t.data.printed && (
        <Terminal run={{ command: t.data.printed.command, output: t.data.printed.output, exit: null }} caption={t.data.printed.see} word={false} />
      )}
      {t.data.status !== 'run' && t.data.status !== 'drawn' && (
        <p class="note">{bench && t.slug === 'shell'
          ? <>See <code>{fn}</code> run on <a href={bench.route}>Beatles Bench</a>.</>
          : <>No <code>{fn}</code> sample for {t.surface.name} yet.</>}</p>
      )}
    </div>
  ))}
</div>
