---
// The same plain call on every surface, as one strip of tabs in the groups
// TAB_GROUPS names, Bash first. Every function page and the home page show
// the same tabs in the same order. Bash shows the function page's first
// example with its output and exit code. Every other surface shows its
// library sample, with what it printed when it prints. A surface with no
// sample links the package-owned current API and installation guide.
import Terminal from './Terminal.astro';
import Code from './Code.astro';
import InstallLine from './InstallLine.astro';
import { SURFACES, FUNCTIONS, TAB_GROUPS } from '../data/catalog.mjs';
import { captioned, sample } from '../data/samples.mjs';
import { packageGuide } from '../data/repo.mjs';
import { beatlesPageFor } from '../data/beatles.mjs';

// `install` puts each surface's install line under its sample, as the home
// page does.
const { fn, install = false } = Astro.props;
const bench = beatlesPageFor(fn);
const entry = FUNCTIONS.find((f) => f.name === fn);
const shell = captioned(`functions/${fn}`, entry.see, true)[0] || null;

// A page with no tab for the chosen language falls back to its family.
const alias = (slug) => ({
  shell: 'Bash', python: 'Python', polars: 'Python', pandas: 'Python',
  typescript: 'TypeScript', ruby: 'Ruby', r: 'R', rust: 'Rust',
  c: 'C', cpp: 'C', 'objective-c': 'C',
  java: 'Java', kotlin: 'Java', scala: 'Java',
  duckdb: 'SQL', sqlite: 'SQL', postgresql: 'SQL',
}[slug]);

// A C or Rust sample is a fragment. Its note names the main around it.
const parts = (text) => text.split('`').map((part, i) => ({ code: i % 2 === 1, part }));

const tabOf = (s) => ({
  slug: s.slug,
  label: s.name,
  alias: alias(s.slug),
  surface: s,
  code: s.slug === 'shell' ? null : sample(fn, s.slug),
  cannot: entry.cannot?.[s.slug] ?? null,
});
const groups = TAB_GROUPS.map((g) => ({
  name: g.name,
  tabs: g.slugs.map((slug) => tabOf(SURFACES.find((s) => s.slug === slug))),
})).filter((g) => g.tabs.length);
const tabs = groups.flatMap((g) => g.tabs);
---
<div class="tabbed" data-fallback="Bash">
  <div class="tabs grouped">
    {groups.map((g) => (
      <div class="tab-group">
        <span class="group-name">{g.name}</span>
        <div class="group-tabs" role="tablist" aria-label={g.name}>
          {g.tabs.map((t) => (
            <button type="button" role="tab" data-lang={t.label} data-alias={t.alias} aria-selected={t.label === 'Bash'}>{t.label}</button>
          ))}
        </div>
      </div>
    ))}
  </div>
  {tabs.map((t) => (
    <div class="cell" data-lang={t.label} hidden={t.label !== 'Bash'}>
      {t.slug === 'shell' && shell && <Terminal run={shell} caption={shell.see} />}
      {t.slug === 'shell' && !shell && (
        <p class="note">{bench
          ? <>See <code>{fn}</code> run on <a href={bench.route}>Beatles Bench</a>.</>
          : <>No Bash example for <code>{fn}</code>.</>}</p>
      )}
      {t.code && <Code code={t.code.code} file={t.code.file} label={`Copy the ${t.surface.name} sample`} />}
      {t.code && t.surface.fragment && <p class="note">{parts(t.surface.fragment).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>}
      {t.code?.output && <Code code={t.code.output} lang="output" caption={`What ${t.surface.name} printed`} copy={false} />}
      {t.slug !== 'shell' && !t.code && <p class="note">Use the named <code>{fn}</code> call in the <a href={packageGuide(t.slug)}>{t.surface.name} package guide</a>. That guide owns current examples, installation prerequisites and observed platform limits. <a href={`/install/${t.slug}/`}>Install {t.surface.name}</a>.</p>}
      {install && t.slug === 'shell' && <InstallLine line={t.surface.install[0][0]} caption="Install the command" />}
      {install && t.slug === 'shell' && <InstallLine line={t.surface.install[1][0]} caption="Or with Homebrew, an option on a Mac" />}
      {install && t.slug !== 'shell' && <InstallLine line={t.surface.install[0][0]} caption={`Install it for ${t.surface.name}`} />}
    </div>
  ))}
</div>
