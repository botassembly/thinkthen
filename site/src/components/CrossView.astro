---
// The same call on every surface, as tabs. Bash shows the function page's
// first example. Every other surface shows its library sample, and a
// database sample shows what the database printed. A surface with no sample
// says so.
import Terminal from './Terminal.astro';
import Code from './Code.astro';
import { SURFACES, FUNCTIONS } from '../data/catalog.mjs';
import { captioned, sample } from '../data/samples.mjs';
import { beatlesPageFor } from '../data/beatles.mjs';

// `above` says the page already shows the Bash example, so the Bash tab
// points up to it and does not repeat it.
const { fn, above = false } = Astro.props;
const bench = beatlesPageFor(fn);
const entry = FUNCTIONS.find((f) => f.name === fn);
const shell = captioned(`functions/${fn}`, entry.see, true)[0] || null;

const alias = (slug) => ({
  shell: 'Bash', python: 'Python', polars: 'Python', typescript: 'TypeScript',
  ruby: 'Ruby', r: 'R', rust: 'Rust', c: 'C',
  duckdb: 'SQL', sqlite: 'SQL', postgresql: 'SQL',
}[slug]);

// A C or Rust sample is a fragment. Its note names the main around it.
const parts = (text) => text.split('`').map((part, i) => ({ code: i % 2 === 1, part }));

const tabs = SURFACES.map((s) => ({
  slug: s.slug,
  label: s.name,
  alias: alias(s.slug),
  surface: s,
  code: s.slug === 'shell' ? null : sample(fn, s.slug),
}));
---
<div class="tabbed" data-fallback="Bash">
  <div class="tabs" role="tablist">
    {tabs.map((t) => (
      <button type="button" role="tab" data-lang={t.label} data-alias={t.alias} aria-selected={t.label === 'Bash'}>{t.label}</button>
    ))}
  </div>
  {tabs.map((t) => (
    <div class="cell" data-lang={t.label} hidden={t.label !== 'Bash'}>
      {t.slug === 'shell' && shell && above && <p class="note">The Bash example opens this page.</p>}
      {t.slug === 'shell' && shell && !above && <Terminal run={shell} />}
      {t.slug === 'shell' && !shell && (
        <p class="note">{bench
          ? <>See <code>{fn}</code> run on <a href={bench.route}>Beatles Bench</a>.</>
          : <>No Bash example for <code>{fn}</code>.</>}</p>
      )}
      {t.code && <Code code={t.code.code} file={t.code.file} label={`Copy the ${t.surface.name} sample`} />}
      {t.code && t.surface.fragment && <p class="note">{parts(t.surface.fragment).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>}
      {t.code?.output && <Code code={t.code.output} lang="output" caption={`What ${t.surface.name} printed`} copy={false} />}
      {t.slug !== 'shell' && !t.code && <p class="note">No {t.surface.name} sample for <code>{fn}</code>.</p>}
    </div>
  ))}
</div>
