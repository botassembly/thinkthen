{
  "about": "Justified exceptions to the landing checks (scripts/check-landing.mjs). Each entry: rule, route (a route or a glob with *), optional match (a substring of the violation's text) and reason.",
  "allow": [
    {
      "rule": "L2",
      "route": "/how-tos/check-expenses-against-a-policy/",
      "reason": "expenses.jsonl is a JSON Lines input shown with ExampleFile; one record per line is the format the command reads, so the records cannot be pretty-printed."
    },
    {
      "rule": "L2",
      "route": "/how-tos/join-two-tables-by-meaning/",
      "reason": "pairs.jsonl is a JSON Lines input shown with ExampleFile; one record per line is the format the command reads."
    },
    {
      "rule": "L2",
      "route": "/how-tos/measure-answers-against-your-own-labels/",
      "reason": "labeled.jsonl is a JSON Lines input shown with ExampleFile; one record per line is the format the command reads."
    },
    {
      "rule": "L2",
      "route": "/how-tos/rank-the-inbound-leads/",
      "reason": "leads.jsonl is a JSON Lines input shown with ExampleFile; one record per line is the format the command reads."
    },
    {
      "rule": "L2",
      "route": "/how-tos/screen-studies-for-a-review/",
      "reason": "papers.jsonl is a JSON Lines input shown with ExampleFile; one record per line is the format the command reads."
    },
    {
      "rule": "L1",
      "route": "/toolboxes/shell-steps/",
      "match": "cat > /dev/null; for v in THINKTHEN_API_KEY",
      "reason": "The line is one JSON string, the sh -c script of a toolbox shell step. JSON strings cannot hold a line break, so the toolbox file cannot wrap it."
    },
    {
      "rule": "L6",
      "route": "/reference/commands/*",
      "reason": "Command reference pages for functions that share options and layout: decide, filter, choose and find take the same threshold, check, input and output options, so their generated option tables repeat by design. Each page is the complete reference for one command."
    },
    {
      "rule": "L5",
      "route": "/functions/*",
      "reason": "Each function page shows the function from the shell, as a JSON row, on a spreadsheet, in Python and in SQL, with the inputs those runs read. Each section is the answer for a reader in that tool, so the page keeps all of them."
    },
    {
      "rule": "L5",
      "route": "/install/go/functions/",
      "reason": "One runnable Go program that calls each of the ten functions, shown whole so a reader can copy and run it, with the call table above it."
    },
    {
      "rule": "L5",
      "route": "/install/java/functions/",
      "reason": "One runnable Java program that calls each of the ten functions, shown whole so a reader can copy and run it, with the call table above it."
    },
    {
      "rule": "L5",
      "route": "/install/csharp/functions/",
      "reason": "One runnable C# program that calls each of the ten functions, shown whole so a reader can copy and run it, with the call table above it."
    },
    {
      "rule": "L5",
      "route": "/install/typescript/functions/",
      "reason": "One runnable TypeScript program that calls each of the ten functions, shown whole so a reader can copy and run it, with the call table above it."
    },
    {
      "rule": "L5",
      "route": "/install/postgresql/functions/",
      "reason": "One SQL script that asks each of the ten functions about the same table, shown whole with each query's result, with the argument table above it."
    },
    {
      "rule": "L5",
      "route": "/install/zig/",
      "reason": "A Zig project needs build.zig and build.zig.zon to fetch the package and install the native library; both are shown whole beside the first program, because a reader cannot build without them."
    },
    {
      "rule": "L5",
      "route": "/install/sqlite/",
      "reason": "The SQLite page is the home of the ask-once-join-often pattern: a ThinkThen function inside a SQLite join can repeat paid backend calls, and the full script that saves answers in a temporary table first is the fix. It sits beside the first query and the function table that it builds on."
    }
  ],
