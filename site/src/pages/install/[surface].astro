---
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import Code from '../../components/Code.astro';
import { SURFACES, CODE_FUNCTIONS, FUNCTIONS, KEY_VARIABLE } from '../../data/catalog.mjs';
import { cell, SURFACE_SAMPLES } from '../../data/examples.mjs';
import { beatlesPageFor } from '../../data/beatles.mjs';

export function getStaticPaths() {
  return SURFACES.map((s) => ({ params: { surface: s.slug }, props: { surface: s } }));
}

const { surface } = Astro.props;
const sample = SURFACE_SAMPLES[surface.slug] || null;
const printed = sample?.printed || null;
const shell = surface.slug === 'shell';
const questionFile = FUNCTIONS.find((f) => f.notAFunction);
const sections = [...CODE_FUNCTIONS, questionFile].map((fn) => ({ fn, data: cell(fn.name, surface.slug) }));
// On the command line, a function with no business sample points to its
// Beatles Bench page.
for (const s of sections) {
  if (shell && s.data.status !== 'run' && beatlesPageFor(s.fn.name)) s.data = { status: 'bench' };
}
const carried = sections.filter((s) => ['run', 'drawn', 'bench'].includes(s.data.status));
const missing = sections.filter((s) => !carried.includes(s));
const headline = shell
  ? `A ${surface.name} command that answers questions about text`
  : `${surface.name} functions that answer questions about text`;
---
<Base title={surface.name} description={surface.blurb.replace(/`/g, '')}>
  <div class="eyebrow"><a href="/install/">Install</a></div>
  <h1>{headline}</h1>
  <p class="lede">{surface.blurb.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}</p>

  <h2>Install</h2>
  <table>
    <tr><th>Channel</th><th>Note</th></tr>
    {surface.install.map(([line, note]) => (
      <tr><td><code>{line}</code></td><td>{note || ''}</td></tr>
    ))}
  </table>
  <p>Set <code>{KEY_VARIABLE}</code> in the environment. ThinkThen never reads a key from a file or a flag.</p>

  <h2>A first call</h2>
  {sample ? (
    <>
      <Code code={sample.code} />
      {printed && <Terminal run={{ command: printed.command, output: printed.output, exit: null }} caption={printed.see} word={false} />}
    </>
  ) : (
    <Terminal run={cell('decide', 'shell').runs.find((r) => r.name === 'decide')} caption="decide prints true and exits 0." />
  )}
  <p>Not sure comes back as <code>{surface.unsureWord}</code>. Branch on it and send those cases to a person.</p>

  <h2>Each function in {surface.name}</h2>
  {carried.map(({ fn, data }) => (
    <section>
      <h3><a href={`/functions/${fn.name}/`}><code>{fn.title || fn.name}</code></a>: {fn.line.charAt(0).toLowerCase() + fn.line.slice(1)}</h3>
      {data.status === 'bench'
        ? <p>See it run on <a href={beatlesPageFor(fn.name).route}>Beatles Bench</a>.</p>
        : data.status === 'run'
        ? <Terminal run={data.runs[0]} caption={data.runs[0].see} />
        : data.printed
          ? <p>The first call above uses it.</p>
          : <Code code={data.code} caption={surface.captions?.[fn.name] || null} />}
    </section>
  ))}
  {missing.length > 0 && (
    <p>No {surface.name} sample yet for {missing.map(({ fn }, i) => (
      <>{i > 0 ? ', ' : ''}<a href={`/functions/${fn.name}/`}><code>{fn.title || fn.name}</code></a></>
    ))}.</p>
  )}

  <h2>What is different in {surface.name}</h2>
  <ul>{surface.particular.map((p) => <li>{p}</li>)}</ul>
</Base>
