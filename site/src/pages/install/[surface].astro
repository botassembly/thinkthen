---
// Goal: show one surface's install line and a first call, and say what is
// different there.
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import Code from '../../components/Code.astro';
import { SURFACES, FUNCTIONS, CODE_FUNCTIONS, KEY_VARIABLE, BACKEND_ROUTES, OPENAI_ANNOUNCED } from '../../data/catalog.mjs';
import { backendsName, captioned, files, firstCall, installSample, sample } from '../../data/samples.mjs';
import { buildLines } from '../../data/build-lines.mjs';
import postgresGrant from '../../../../databases/postgresql/fixtures/grant.sql?raw';

export function getStaticPaths() {
  return SURFACES.map((s) => ({ params: { surface: s.slug }, props: { surface: s } }));
}

const { surface } = Astro.props;
const shell = surface.slug === 'shell';
const notes = surface.install.some(([, note]) => note);
const first = shell ? null : firstCall(surface.slug);
const build = first ? buildLines(surface.slug, first.file) : null;
const buildText = build && [...build.lines, build.run].map((parts) => parts.join(' \\\n    ')).join('\n');
const inputs = shell ? [] : files(`install/${surface.slug}`);
const frames = surface.frames ? installSample(surface.slug, 'data-frames') : null;
const functional = ['python', 'r'].includes(surface.slug);
const onFunctionPages = !shell && CODE_FUNCTIONS.some((fn) => sample(fn.name, surface.slug));
const decideOne = shell ? captioned('functions/decide', FUNCTIONS[0].see).find((r) => r.name === '3-one') : null;
const headline = shell
  ? `A ${surface.name} command that answers questions about text`
  : `${surface.name} functions that answer questions about text`;
// The Backends section: how this page's language reaches each built-in
// backend. A page whose route is python links Python's section.
const route = surface.backends ?? null;
const named = route && route !== 'python';
const title = named ? `Jev and System One API from ${surface.name}` : surface.name;
const description = named
  ? `Call Jev and any System One API from ${surface.name} with ThinkThen. OpenAI has announced the OpenAI Decisions API. It is not released yet.`
  : surface.blurb.replace(/`/g, '');
if (description.length > 160) throw new Error(`/install/${surface.slug}/: the description runs ${description.length} characters, over 160`);
const backendSample = ['env', 'builder', 'code'].includes(route) ? installSample(surface.slug, backendsName(surface.slug)) : null;
const backendConstructor = {
  python: 'Engine(backend=)', typescript: 'new Engine({backend})', ruby: 'Engine.new(backend:)', r: 'tt_engine(backend =)',
  c: '"backend" in thinkthen_engine_new_with JSON', cpp: 'create(settings)', 'objective-c': 'createWithSettings',
  cobol: 'TT-ENGINE-NEW settings JSON', ada: 'Configure settings JSON', java: 'Door(settingsJson)',
  kotlin: 'Door(settingsJson)', scala: 'Door(settingsJson)', csharp: 'Engine.Open(settingsJson)',
  go: 'NewWith(settingsJSON)', swift: 'Engine(settingsJSON:)', zig: 'Engine.initWithSettings',
  php: 'ThinkThen(library, settingsJson)', dart: 'Door.create(settings)',
}[surface.slug] ?? 'EngineBuilder::backend';
const backendAddress = surface.slug === 'typescript' ? 'baseUrl' : 'base_url';
const backendInputs = backendSample?.folder ? files(`install/${surface.slug}/${backendSample.folder}`) : [];
const backendBuild = backendSample ? buildLines(surface.slug, backendSample.file) : null;
const backendBuildText = backendBuild && [...backendBuild.lines, backendBuild.run].map((p) => p.join(' \\\n    ')).join('\n');
const shellLines = (r) => [
  `export THINKTHEN_BACKEND=${r.name}`,
  ...(r.address ? [`export THINKTHEN_BASE_URL=${r.address}`] : [`export ${r.keys[0]}=...`]),
].join('\n');
const inputCaption = (name) => /\.csproj$|^Package\.swift$|^build\.zig(\.zon)?$|^pubspec\.yaml$|^Cargo\.toml$/.test(name)
  ? `${name}, a project file beside the sample`
  : `${name}, a file the sample reads`;
// Copy marks code with backticks.
const parts = (text) => text.split('`').map((part, i) => ({ code: i % 2 === 1, part }));
---
<Base title={title} description={description}>
  <div class="eyebrow"><a href="/install/">Install</a></div>
  <h1>{headline}</h1>
  <p class="lede">{parts(surface.blurb).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>

  <h2>Install</h2>
  <table class="install">
    <tr><th>Channel</th>{notes && <th>Note</th>}</tr>
    {surface.install.map(([line, note]) => (
      <tr><td><code>{line}</code></td>{notes && <td>{parts(note || '').map((x) => x.code ? <code>{x.part}</code> : x.part)}</td>}</tr>
    ))}
  </table>
  <p>Set <code>{KEY_VARIABLE}</code> in the environment.</p>
  {surface.slug === 'sqlite' && (
    <>
      <h3>Use reviewed views and ingestion triggers</h3>
      <p>On a fresh connection, load once with the explicit trusted entry point. A native host names <code>sqlite3_thinkthen_trusted_init</code> in <code>sqlite3_load_extension</code>. Switch modes with a fresh connection.</p>
      <Code code={'.load ./thinkthen sqlite3_thinkthen_trusted_init\nPRAGMA trusted_schema=ON;'} lang="sql" label="Copy the trusted initial load" />
      <p>This choice permits schema SQL to spend paid requests and read permitted question files. Trust covers main, temp, every attached schema and later attachments while <code>trusted_schema</code> is ON. Review every schema you open or attach. Keep downloaded or unreviewed databases on separate default-loaded connections. There is no per-view or per-file trust isolation.</p>
      <p>Judgment scalars, plans and judgment tables can run in views and triggers. SQLite may also evaluate judgments in CHECK and DEFAULT expressions. Configuration, usage, budget setters and removed spellings remain direct-only. Judgments remain non-deterministic and non-innocuous, so SQLite's generated-column and index restrictions still apply.</p>
      <p>Loading changes neither <code>trusted_schema</code> nor an existing host authorizer. With <code>trusted_schema=OFF</code>, schema calls refuse before reading question files or sending requests. Top-level calls remain available. Existing file permissions, budgets and cancellation still apply. The <a href="https://github.com/botassembly/thinkthen/blob/main/databases/sqlite/README.md#use-reviewed-views-and-ingestion-triggers">SQLite README</a> gives an ingestion-trigger recipe.</p>
      <h3>Pass recognition kinds</h3>
      <p>Pass one kind as <code>'person'</code>, or comma-separated names as <code>'person,organisation'</code>. Descriptions take a recognize JSON object such as <code>{`'{"kinds":{"person":"A human name."}}'`}</code>, a full versioned recognize spec, or an <code>@file</code> containing that spec. A bare JSON array string such as <code>{`'["person"]'`}</code> currently names one literal kind, <code>{`["person"]`}</code>. Use <code>'person'</code> to request the person kind.</p>
      <Code code={"SELECT text, kind FROM thinkthen_recognize('Maria Chen called.', 'person');"} lang="sql" label="Copy the SQLite recognition call" />
    </>
  )}
  {surface.uninstall && (
    <>
      <h3>Uninstall</h3>
      <p>{parts(surface.uninstall.text).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>
      <Code code={surface.uninstall.code} lang="bash" label="Copy the uninstall command" />
    </>
  )}

  {surface.slug === 'postgresql' && (
    <>
      <h3>Let an application role call ThinkThen</h3>
      <p>A server administrator copies the release files into PostgreSQL's library and extension directories before running <code>CREATE EXTENSION thinkthen</code>. These directories usually require administrator access. The released package targets PostgreSQL 16; other versions and managed hosts remain untested.</p>
      <p>The extension revokes public execution rights. After installation, an administrator runs this grant with the existing application role in place of <code>the_app_role</code>. It grants only the functions owned by ThinkThen. That role can then make paid requests using the server's configured backend.</p>
      <Code code={postgresGrant.trimEnd()} lang="sql" label="Copy the extension-only application grant" />
      <p>The <a href="https://github.com/botassembly/thinkthen/blob/main/databases/postgresql/README.md#authority-who-may-do-what">PostgreSQL README</a> explains execution rights and the separate permissions for named files.</p>
    </>
  )}
  {surface.slug === 'duckdb' && (
    <>
      <h3 id="use-the-release-from-dbt-v1">Use the release from dbt v1</h3>
      <p>Use <code>dbt-core==1.12.5</code>, <code>dbt-duckdb==1.11.0</code> and <code>duckdb==1.5.5</code>. Unpack the public extension archive and set <code>THINKTHEN_EXT_DIR</code> to its absolute root, containing <code>v1.5.5/</code>. The adapter installs from that local repository.</p>
      <Code code={`python3 -m venv dbt-env
. dbt-env/bin/activate
python -m pip install dbt-core==1.12.5 dbt-duckdb==1.11.0 duckdb==1.5.5`} lang="bash" label="Copy the dbt v1 package pins" />
      <p>Save this as <code>profiles.yml</code> beside your dbt project and set the project's profile to <code>thinkthen_dbt</code>. The backend key belongs in the process environment.</p>
      <Code code={`thinkthen_dbt:
  target: local
  outputs:
    local:
      type: duckdb
      path: warehouse.duckdb
      threads: 1
      config_options:
        allow_unsigned_extensions: true
      extensions:
        - name: thinkthen
          repo: "'{{ env_var('THINKTHEN_EXT_DIR') }}'"`} lang="yaml" file="profiles.yml" label="Copy the dbt v1 startup profile" />
      <p>Run <code>dbt run --profiles-dir .</code> from the project. The adapter supplies <code>config_options</code> when it opens DuckDB. A later SQL <code>SET allow_unsigned_extensions</code> cannot change the setting. Enable unsigned extensions only for a local artifact you trust.</p>
      <p>The public unsigned archive does not currently support dbt2. Its attempted initialization SQL runs after DuckDB opens and fails before loading the extension. Community signing is in progress; a future signed artifact must match the DuckDB version embedded in dbt2 and pass an actual load test.</p>
    </>
  )}

  <h2>A first call</h2>
  {first ? (
    <>
      {inputs.map((file) => <Code code={file.text} file={file.name} caption={inputCaption(file.name)} />)}
      <Code code={first.code} file={first.file} label={`Copy the ${surface.name} sample`} />
      {build && <Code code={buildText} lang="bash" caption={`${build.lines.length ? 'Build and run' : 'Run'} it beside ${build.beside ?? `the unpacked archives, thinkthen-c/ and ${build.archive}/`}`} label={`Copy the ${surface.name} ${build.lines.length ? "build" : "run"} lines`} />}
      {first.output && <Code code={first.output} lang="output" caption={`What ${surface.name} printed`} copy={false} />}
    </>
  ) : (
    <Terminal run={decideOne} caption={decideOne.see} />
  )}
  <p>Not sure comes back as {parts(surface.unsureWord).map((x) => x.code ? <code>{x.part}</code> : x.part)}. Branch on it and send those cases to a person.{onFunctionPages && <> Each <a href="/functions/">function page</a> shows its {surface.name} call.</>}</p>

  {functional && <p>To apply one question to a list or a stream, read <a href="/learn/functional/">Functional patterns</a>.</p>}

  {frames && (
    <>
      <h2>Data frames</h2>
      <p>{parts(surface.frames).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>
      <Code code={frames.code} file={frames.file} label={`Copy the ${surface.name} data frame sample`} />
      {frames.output && <Code code={frames.output} lang="output" caption={`What ${surface.name} printed`} copy={false} />}
    </>
  )}

  <h2>Run facts</h2>
  <p>{parts(surface.facts).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>

  {surface.errors && (
    <>
      <h2>Errors</h2>
      <p>{parts(surface.errors).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>
    </>
  )}

  {surface.settings && (
    <>
      <h2>Settings and recording</h2>
      <p>{parts(surface.settings).map((x) => x.code ? <code>{x.part}</code> : x.part)} The <a href="/install/settings/">Settings</a> page lists every setting.</p>
    </>
  )}

  {route === 'python' && (
    <>
      <h2 id="backends">Backends</h2>
      <p>{surface.name} runs on the Python engine, so it reaches each backend the same way. The <a href="/install/python/#backends">Python page</a> shows Jev, Liquid d1 and Ollama.</p>
    </>
  )}
  {named && (
    <>
      <h2 id="backends">Jev, Liquid d1 and Ollama from {surface.name}</h2>
      {route === 'cli' && (
        <>
          <p><code>--backend NAME</code> names the backend for one run. <code>THINKTHEN_BACKEND</code> names it for every run in the shell. Each backend page shows its runs.</p>
          <ul>{BACKEND_ROUTES.map((r) => <li><a href={r.route}>{r.title}</a>: <code>--backend {r.name}</code></li>)}</ul>
        </>
      )}
      {route === 'sql' && (
        <>
          <p>SQL names a built-in or configured backend. The selected backend supplies its address, model and key variable. SQL accepts no address or key.</p>
          <Code code={{ duckdb: "SET thinkthen_backend = 'typesafe';", postgresql: "SET thinkthen.backend = 'typesafe';", sqlite: `SELECT thinkthen_configure('{"backend":"typesafe"}');` }[surface.slug]} lang="sql" />
          {surface.slug === 'sqlite' ? <p>Configure before the first engine build or plan. SQLite keeps one engine for the whole process.</p> : <p>RESET restores captured environment selection. PostgreSQL requires an administrator to change the backend; DuckDB selects it for the calling session.</p>}
          <p>The names are <code>liquid</code>, <code>ollama</code>, <code>openrouter</code>, <code>perplexity</code> and <code>typesafe</code>.</p>
        </>
      )}
      {route !== 'cli' && route !== 'sql' && (
        <>
          {route === 'env'
            ? <p>{surface.name} reads its backend from the environment. Set <code>THINKTHEN_BACKEND</code> to the name below. Set the backend's key variable in the shell, and the same sample asks that backend.</p>
            : <p><code>{backendConstructor}</code> names the backend in code, and it outranks the environment. The sample selects a backend before it asks the question. Each constructor accepts the names below.</p>}
          <table class="backend-routes">
            <tr><th>Backend</th><th>Name</th><th>Key variable</th></tr>
            {BACKEND_ROUTES.map((r) => (
              <tr><td><a href={r.route}>{r.title}</a></td><td><code>{r.name}</code></td><td>{r.keys.map((k, i) => <>{i > 0 && ', then '}<code>{k}</code></>)}{r.address && '. A local address needs no key.'}</td></tr>
            ))}
          </table>
          {route === 'env' && BACKEND_ROUTES.map((r) => (
            <Code code={shellLines(r)} lang="bash" caption={r.address ? `Ask ${r.title}. This block names a second port, 11535, as the site's runs do. On the default port, leave THINKTHEN_BASE_URL out.` : `Ask ${r.title}.`} label={`Copy the ${r.title} settings`} />
          ))}
          {backendInputs.length > 0 && <p>The {surface.name} project file names its sample, so this sample has its own.</p>}
          {backendInputs.map((file) => <Code code={file.text} file={file.name} caption={inputCaption(file.name)} />)}
          <Code code={backendSample.code} file={backendSample.file} caption={['builder', 'code'].includes(route) && surface.slug !== 'r' ? `To use Ollama on a second port, supply ${backendAddress}. On the default port, leave it out.` : null} label={`Copy the ${surface.name} backends sample`} />
          {backendBuild && <Code code={backendBuildText} lang="bash" caption={`${backendBuild.lines.length ? 'Build and run' : 'Run'} it beside ${backendBuild.beside ?? `the unpacked archives, thinkthen-c/ and ${backendBuild.archive}/`}`} label={`Copy the ${surface.name} backends ${backendBuild.lines.length ? 'build' : 'run'} lines`} />}
          {backendSample.output && <Code code={backendSample.output} lang="output" caption={`What ${surface.name} printed on each backend`} copy={false} />}
          {route === 'builder' && <p><code>EngineBuilder::from_env</code> also reads <code>THINKTHEN_BACKEND</code> and <code>THINKTHEN_BASE_URL</code>.</p>}
          {route === 'code' && surface.slug === 'r' && <p>R keeps one engine per session. Choose its backend with the full <code>backend</code> keyword before asking. Changing the settings requires a new session.</p>}
          {route === 'code' && <p>An omitted backend reads <code>THINKTHEN_BACKEND</code> and <code>THINKTHEN_BASE_URL</code>. Each named backend reads its own key variable. These constructors accept no key.</p>}
        </>
      )}
      <p>The configuration file's <code>backend</code> names a default backend for every run. The <a href="/install/configuration/#configuration-file">Configuration</a> page shows the file.</p>
      <h3>OpenAI Decisions API from {surface.name}</h3>
      <p set:html={OPENAI_ANNOUNCED} />
    </>
  )}

  <h2>What is different in {surface.name}</h2>
  <ul>{surface.particular.map((p) => <li>{parts(p).map((x) => x.code ? <code>{x.part}</code> : x.part)}</li>)}</ul>
</Base>
