---
// Goal: show one surface's install line and a first call, and say what is
// different there.
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import Code from '../../components/Code.astro';
import { SURFACES, FUNCTIONS, KEY_VARIABLE } from '../../data/catalog.mjs';
import { captioned, firstCall } from '../../data/samples.mjs';

export function getStaticPaths() {
  return SURFACES.map((s) => ({ params: { surface: s.slug }, props: { surface: s } }));
}

const { surface } = Astro.props;
const shell = surface.slug === 'shell';
const notes = surface.install.some(([, note]) => note);
const first = shell ? null : firstCall(surface.slug);
const decideOne = shell ? captioned('functions/decide', FUNCTIONS[0].see).find((r) => r.name === '3-one') : null;
const headline = shell
  ? `A ${surface.name} command that answers questions about text`
  : `${surface.name} functions that answer questions about text`;
// Copy marks code with backticks.
const parts = (text) => text.split('`').map((part, i) => ({ code: i % 2 === 1, part }));
const runFacts = {
  shell: '`--facts` prints one line of run facts on standard error, after the answers.',
  python: '`Call.facts` counts this call; `Call.details` holds its question observations. `tt.details(question, text).value` gives the result schema for one text.',
  polars: '`Call.facts` counts this frame call outside its columns. `Call.details` holds the question observations.',
  typescript: '`Call.facts` counts this call; `Call.details` holds its question observations. `engine.details(question, text).value` gives the result schema for one text.',
  ruby: '`Call#facts` counts this call; `Call#details` holds its question observations. `engine.details(question, text).value` gives the result schema for one text.',
  r: '`$facts` counts this call; `$details` holds its question observations. `tt_details(question, text)$value` gives the result schema for one text.',
  rust: '`Call::facts()` counts this call. `engine.details(question, text).value()` gives the result schema for one text.',
  c: 'A JSON call returns `{"value":...,"facts":...}`. A detailed call puts the result schema under `value`.',
  duckdb: '`thinkthen_details(question, text)` returns the result schema as JSON text; `thinkthen_usage()` gives process totals.',
  sqlite: '`thinkthen_details(question, text)` returns the result schema; `thinkthen_usage()` gives process totals.',
  postgresql: '`thinkthen_details(question, evidence)` returns the result schema as jsonb; `thinkthen_usage()` gives process totals.',
};
---
<Base title={surface.name} description={surface.blurb.replace(/`/g, '')}>
  <div class="eyebrow"><a href="/install/">Install</a></div>
  <h1>{headline}</h1>
  <p class="lede">{parts(surface.blurb).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>

  <h2>Install</h2>
  <table>
    <tr><th>Channel</th>{notes && <th>Note</th>}</tr>
    {surface.install.map(([line, note]) => (
      <tr><td><code>{line}</code></td>{notes && <td>{note || ''}</td>}</tr>
    ))}
  </table>
  <p>Set <code>{KEY_VARIABLE}</code> in the environment.</p>

  <h2>A first call</h2>
  {first ? (
    <>
      <Code code={first.code} />
      {first.output && <Code code={first.output} caption={`What ${surface.name} printed`} copy={false} />}
    </>
  ) : (
    <Terminal run={decideOne} caption={decideOne.see} />
  )}
  <p>Not sure comes back as <code>{surface.unsureWord}</code>. Branch on it and send those cases to a person. Each <a href="/functions/">function page</a> shows its {surface.name} call.</p>

  <h2>Run facts</h2>
  <p>{parts(runFacts[surface.slug]).map((x) => x.code ? <code>{x.part}</code> : x.part)}</p>

  <h2>What is different in {surface.name}</h2>
  <ul>{surface.particular.map((p) => <li>{parts(p).map((x) => x.code ? <code>{x.part}</code> : x.part)}</li>)}</ul>
</Base>
