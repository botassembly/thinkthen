---
// Goal: show one database's install line and a first query, all ten
// functions in its SQL, and what is different there.
import SurfacePage from '../../components/SurfacePage.astro';
import { SURFACES, BINDINGS } from '../../data/catalog.mjs';

export function getStaticPaths() {
  return SURFACES
    .filter((s) => BINDINGS.some((b) => b.slug === s.slug && b.database))
    .map((s) => ({ params: { surface: s.slug }, props: { surface: s } }));
}

const { surface } = Astro.props;
---
<SurfacePage surface={surface} route={`/install/${surface.slug}/`} eyebrow={['/install/', 'Install']} />
