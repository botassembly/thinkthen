---
// Goal: give the command line's install line, and link every binding to its
// install page.
import Base from '../../layouts/Base.astro';
import InstallLine from '../../components/InstallLine.astro';
import LinkName from '../../components/LinkName.astro';
import { SURFACES, BINDINGS, KEY_VARIABLE } from '../../data/catalog.mjs';

const shell = SURFACES.find((s) => s.slug === 'shell');
const lists = [
  ['Languages', BINDINGS.filter((b) => !b.database)],
  ['Databases', BINDINGS.filter((b) => b.database)],
];
---
<Base title="Install" description="Install ThinkThen for the command line, each language, and each database, and point it at a backend.">
  <h1>Install</h1>
  <p class="lede">ThinkThen runs from the command line, from your language, and from your database.</p>

  <p>Public installation remains 0.1.2. The approved development 0.2 API has one typed function family per language under the <a href="https://github.com/botassembly/thinkthen/blob/main/libraries/BINDING-AUTHOR.md">binding guide</a>. The <a href="https://github.com/botassembly/thinkthen/blob/main/libraries/UPGRADING-0.2.md">upgrade guide</a> maps changed calls. Each package README gives its development API and installation evidence.</p>
  <p>The development JVM session requires stable JDK 22 or later without <code>--enable-preview</code>. The development Objective-C implementation uses Apple Foundation and ARC. Its <a href="https://github.com/botassembly/thinkthen/blob/main/libraries/objective-c/README.md">owning guide</a> distinguishes Apple SDK compile evidence from pending installed Apple Foundation execution and removed GNU support. The <a href="https://github.com/botassembly/thinkthen/blob/main/sdlc/decisions/2026-10-09-native-package-design.md">package design</a> gives intended platforms and runtime floors. Final installed and platform qualification remain required.</p>

  <h2><a href="/install/shell/">The command line</a></h2>
  <InstallLine line={shell.install[0][0]} caption="The download script" />
  <InstallLine line={shell.install[1][0]} caption="Homebrew, an option on a Mac" />
  <p>Set <code>{KEY_VARIABLE}</code> in the environment. <code>--plan</code> needs no key.</p>

  {lists.map(([heading, list]) => (
    <Fragment>
      <h2>{heading}</h2>
      <ul class="bindings">
        {list.map((b) => <li><a href={b.route}><LinkName name={b.name} /></a></li>)}
      </ul>
    </Fragment>
  ))}

  <h2><a href="/install/settings/">Settings</a></h2>
  <p>The <a href="/install/settings/">settings page</a> lists every setting, its default, and how to set it on each surface.</p>

  <h2><a href="/install/configuration/">Configuration</a></h2>
  <p>The <a href="/install/configuration/">configuration page</a> lists every environment variable and where each file lives.</p>

  <h2><a href="/install/backends/">Backends</a></h2>
  <p>ThinkThen asks Jev, a model from TypeSafe, by default. The <a href="/install/backends/">backends pages</a> cover Liquid d1, Ollama, and any server that speaks System One.</p>
</Base>
