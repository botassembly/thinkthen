---
// Goal: give the command line's install line, and link every binding to its
// install page.
import Base from '../../layouts/Base.astro';
import InstallLine from '../../components/InstallLine.astro';
import { SURFACES, BINDINGS, KEY_VARIABLE } from '../../data/catalog.mjs';

const shell = SURFACES.find((s) => s.slug === 'shell');
const lists = [
  ['Languages', BINDINGS.filter((b) => !b.database)],
  ['Databases', BINDINGS.filter((b) => b.database)],
];
---
<Base title="Install" description="Install ThinkThen for the command line, each language, and each database, and point it at a backend.">
  <h1>Install</h1>
  <p class="lede">ThinkThen runs from the command line, from your language, and from your database.</p>

  <h2><a href="/install/shell/">The command line</a></h2>
  <InstallLine line={shell.install[0][0]} caption="The download script" />
  <InstallLine line={shell.install[1][0]} caption="Homebrew, an option on a Mac" />
  <p>Set <code>{KEY_VARIABLE}</code> in the environment. <code>--dry-run</code> needs no key.</p>

  {lists.map(([heading, list]) => (
    <Fragment>
      <h2>{heading}</h2>
      <ul class="bindings">
        {list.map((b) => <li><a href={b.route}>{b.name}</a></li>)}
      </ul>
    </Fragment>
  ))}

  <h2><a href="/install/settings/">Settings</a></h2>
  <p>The <a href="/install/settings/">settings page</a> lists every setting, its default, and how to set it on each surface.</p>

  <h2><a href="/install/backends/">Backends</a></h2>
  <p>ThinkThen asks Jev, a model from TypeSafe. The <a href="/install/backends/">backends page</a> says how to point it at another server.</p>
</Base>
