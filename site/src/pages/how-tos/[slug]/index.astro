---
// Goal: show one business job done end to end with real runs a reader can
// copy. Each how-to's own goal sits in catalog.mjs.
import Base from '../../../layouts/Base.astro';
import Terminal from '../../../components/Terminal.astro';
import Code from '../../../components/Code.astro';
import { HOWTOS, FUNCTIONS } from '../../../data/catalog.mjs';
import { captioned, files } from '../../../data/samples.mjs';

export function getStaticPaths() {
  return HOWTOS.map((h) => ({ params: { slug: h.slug }, props: { howto: h } }));
}

const { howto } = Astro.props;
const page = `how-tos/${howto.slug}`;
const runs = captioned(page, howto.see);
// A how-to with `files` shows only the files it names, in that order, each
// with its own caption. The scripts still read every file in files/.
const all = files(page);
const named = (name) => {
  const file = all.find((f) => f.name === name);
  if (!file) throw new Error(`how-tos: ${howto.slug} names ${name}, and files/ has no such file`);
  return { ...file, caption: howto.files[name] };
};
const inputs = howto.files
  ? Object.keys(howto.files).map(named)
  : all.map((f) => ({ ...f, caption: `${f.name}, a file the commands read` }));

// Copy fields mark code with backticks. The page shows it as code; the
// meta description drops the marks.
const parts = (text) => text.split('`').map((p, i) => ({ code: i % 2 === 1, text: p }));
const plain = (text) => text.replaceAll('`', '');
if (!howto.goal) throw new Error(`how-tos: ${howto.slug} has no goal`);
---
<Base title={howto.title} description={plain(howto.said)}>
  <div class="eyebrow">{howto.reader}</div>
  <h1>{howto.title}</h1>
  <p class="lede">{parts(howto.said).map((p) => p.code ? <code>{p.text}</code> : p.text)}</p>

  {inputs.map((file) => <Code code={file.text} file={file.name} caption={file.caption} />)}
  {runs.map((run) => <Terminal run={run} caption={run.see} />)}

  <h2>The functions it uses</h2>
  <div class="grid">
    {howto.functions.map((name) => {
      const fn = FUNCTIONS.find((f) => f.name === name);
      return <a class="tile" href={`/functions/${fn.name}/`}><b>{fn.name}</b><span>{fn.line}</span></a>;
    })}
  </div>
</Base>
