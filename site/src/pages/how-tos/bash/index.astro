---
// Goal: list the shell jobs that put ThinkThen to work with the tools a
// shell already has.
import SidePage from '../../../layouts/SidePage.astro';
import { SHELL_JOB_PAGES, SHELL_JOBS_FIRST, SHELL_JOBS } from '../../../data/catalog.mjs';

const plain = (text) => text.replaceAll('`', '');
const first = (text) => `${plain(text).split('. ')[0].replace(/\.$/, '')}.`;
---
<SidePage pages={SHELL_JOB_PAGES} page={{ ...SHELL_JOBS_FIRST, description: 'Shell jobs with ThinkThen: label a file, review a diff, lint prose, fill a form.' }} name="Shell jobs">
  <div class="eyebrow">How-tos</div>
  <h1>Shell jobs</h1>
  <p class="lede">Each page does one job with ThinkThen and the tools a shell already has. The <a href="/languages/bash/#techniques">Bash techniques</a> teach the forms these jobs use.</p>

  <h2 id="shell-jobs">Shell jobs</h2>
  <ul>
    {SHELL_JOBS.map((r) => (
      <li><a href={`/how-tos/bash/${r.slug}/`}>{r.title}</a> — {first(r.said)}</li>
    ))}
  </ul>
</SidePage>
