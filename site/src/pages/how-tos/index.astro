---
import Base from '../../layouts/Base.astro';
import { HOWTOS, RECIPES } from '../../data/catalog.mjs';

const plain = (text) => text.replaceAll('`', '');
---
<Base title="How-tos" description="Business jobs done with ThinkThen, each shown with a recorded run.">
  <h1>How-tos</h1>
  <p class="lede">Pick your job. Each page shows what went in, the commands, and what came out.</p>

  <table>
    <tr><th>How-to</th><th>Who it is for</th><th>Functions</th></tr>
    {HOWTOS.map((h) => (
      <tr>
        <td><a href={`/how-tos/${h.slug}/`}>{h.title}</a></td>
        <td>{h.reader}</td>
        <td>{h.functions.map((f, i) => (<Fragment>{i > 0 ? ', ' : ''}<a href={`/functions/${f}/`}><code>{f}</code></a></Fragment>))}</td>
      </tr>
    ))}
  </table>

  <h2>Shell recipes</h2>
  <p>The tools you already have, piped into ThinkThen.</p>
  <div class="grid">
    {RECIPES.map((r) => (
      <a class="tile" href={`/how-tos/${r.slug}/`}><b>{r.title}</b><span>{plain(r.said).split('. ')[0]}.</span></a>
    ))}
  </div>
</Base>
