---
// Goal: let a reader find the job they have, or the shell form they want
// to learn.
import Base from '../../layouts/Base.astro';
import { HOWTOS, TECHNIQUES } from '../../data/catalog.mjs';
---
<Base title="How-tos" description="Business jobs done with ThinkThen, each shown with a real run.">
  <h1>How-tos</h1>
  <p class="lede">Pick your job. Each page shows the commands and what came out.</p>

  <table>
    <tr><th>How-to</th><th>Who it is for</th><th>Functions</th></tr>
    {HOWTOS.map((h) => (
      <tr>
        <td><a href={`/how-tos/${h.slug}/`}>{h.title}</a></td>
        <td>{h.reader}</td>
        <td>{h.functions.map((f, i) => (<Fragment>{i > 0 ? ', ' : ''}<a href={`/functions/${f}/`}><code>{f}</code></a></Fragment>))}</td>
      </tr>
    ))}
  </table>

  <h2><a href="/how-tos/bash/">Bash techniques</a></h2>
  <p>ThinkThen is a shell command. These pages teach it one shell form at a time, with recipes for small jobs.</p>
  <div class="grid">
    {TECHNIQUES.map((t) => (
      <a class="tile" href={`/how-tos/bash/${t.slug}/`}><b>{t.title}</b><span>{t.label}</span></a>
    ))}
  </div>
</Base>
