---
import Base from '../../../layouts/Base.astro';
import Terminal from '../../../components/Terminal.astro';
import Code from '../../../components/Code.astro';
import CrossView from '../../../components/CrossView.astro';
import { FUNCTIONS, HOWTOS } from '../../../data/catalog.mjs';
import { cell } from '../../../data/examples.mjs';

export function getStaticPaths() {
  return FUNCTIONS.map((fn) => ({ params: { name: fn.name }, props: { fn } }));
}

const { fn } = Astro.props;
const shell = cell(fn.name, 'shell');
const runs = shell.status === 'run' ? shell.runs : [];
const first = runs[0];
const rest = runs.slice(1);
const howtos = HOWTOS.filter((h) => fn.howtos.includes(h.slug));
const title = fn.title || fn.name;
---
<Base title={title} description={fn.line}>
  <div class="eyebrow">{fn.notAFunction ? 'a saved question' : fn.primitive}</div>
  <h1>{fn.line}</h1>
  <p class="lede">{fn.takes} {fn.gives}</p>
  {fn.status === 'planned' && (
    <div class="note"><span class="status planned">planned</span> The command has no <code>{fn.name}</code> yet. Every sample below is drawn from the design and has not run.</div>
  )}

  {first && (
    <>
      <h2>The simplest example</h2>
      <Terminal run={first} />
    </>
  )}

  <h2>On every surface</h2>
  <p>The same call, wherever you write it. The shell ships today. Every library is planned, and its sample is drawn from the design.</p>
  <CrossView fn={fn.name} />

  <h2>The options</h2>
  {fn.options.length === 0 ? (
    <p>The specification does not carry <code>{fn.name}</code> yet, so its options are not settled.</p>
  ) : (
    <>
      <p>It takes <code>{fn.args}</code>.</p>
      <table>
        <tr><th>Option</th><th>What it does</th></tr>
        {fn.options.map(([opt, what]) => (
          <tr><td><code>{opt}</code></td><td>{what}</td></tr>
        ))}
      </table>
    </>
  )}

  {rest.length > 0 && (
    <>
      <h3>Each option, taught once</h3>
      {rest.map((run) => <Terminal run={run} />)}
    </>
  )}

  <h2>Not sure, and broken</h2>
  <p>{fn.unsure}</p>
  {fn.exits.length > 0 && (
    <table>
      <tr><th>Exit code</th><th>What it means</th></tr>
      {fn.exits.map(([code, what]) => (
        <tr><td><span class={`exit ${code === 0 ? 'yes' : code === 1 ? 'no' : code === 3 ? 'unsure' : 'broken'}`}>{code}</span></td><td>{what}</td></tr>
      ))}
    </table>
  )}

  <h2>What it costs</h2>
  <p>{fn.requests}</p>
  <p>A short text runs about 290 input tokens, of which about 256 is the fixed part, at $0.042 per million. That is 1.2 cents for a thousand short texts, measured in the live probe on 2026-09-20.</p>

  <h2>The how-tos that use it</h2>
  {howtos.length === 0 ? (
    <p>No how-to uses <code>{fn.name}</code> yet.</p>
  ) : (
    <div class="grid">
      {howtos.map((h) => (
        <a class="tile" href={`/how-tos/${h.slug}/`}><b>{h.title}</b><span>{h.reader}</span></a>
      ))}
    </div>
  )}

  <p class="pagelinks"><a href="/functions/">Every function</a> · <a href="/shell/">The shell</a> · <a href="/trust/">Trust</a></p>
</Base>
