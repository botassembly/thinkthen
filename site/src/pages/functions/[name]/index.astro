---
import Base from '../../../layouts/Base.astro';
import Terminal from '../../../components/Terminal.astro';
import CrossView from '../../../components/CrossView.astro';
import { FACTS, FUNCTIONS, HOWTOS } from '../../../data/catalog.mjs';
import { cell } from '../../../data/examples.mjs';

export function getStaticPaths() {
  return FUNCTIONS.map((fn) => ({ params: { name: fn.name }, props: { fn } }));
}

const { fn } = Astro.props;
const shell = cell(fn.name, 'shell');
const runs = shell.status === 'run' ? shell.runs : [];
const first = runs[0];
const rest = runs.slice(1);
const howtos = HOWTOS.filter((h) => fn.howtos.includes(h.slug));
const title = fn.title || fn.name;
const preview = fn.status === 'preview';
const shipped = !preview && !fn.notAFunction;
const line = fn.line.charAt(0).toLowerCase() + fn.line.slice(1);
// The first cost row is the live probe's price for 1,000 short records.
const [probe] = FACTS.cost.rows[0];
---
<Base title={title} description={fn.line}>
  <div class="eyebrow">{fn.notAFunction ? 'a saved question' : fn.primitive}</div>
  <h1><code>{title}</code>: {line}</h1>
  {fn.lede ? (
    <p class="lede" set:html={fn.lede} />
  ) : (
    <p class="lede">You give it {fn.takes}. You get back {fn.gives}.{shipped && <> Every answer carries a probability, and <code>--details</code> prints it.</>}</p>
  )}
  {preview && (
    <div class="note"><span class="status preview">preview</span> The command has no <code>{fn.name}</code> yet. The samples below show the design. None has run.</div>
  )}

  {first && (
    <>
      <h2>The simplest example</h2>
      <Terminal run={first} caption={`Recorded from the real command. ${first.see}`} />
    </>
  )}

  <h2>When it is not sure, and when it fails</h2>
  <p>{fn.unsure}</p>
  {fn.exits.length > 0 && (
    <table>
      <tr><th>Exit code</th><th>What it means</th></tr>
      {fn.exits.map(([code, what]) => (
        <tr><td><span class={`exit ${code === 0 ? 'yes' : code === 1 ? 'no' : code === 3 ? 'unsure' : 'broken'}`}>{code}</span></td><td>{what}</td></tr>
      ))}
    </table>
  )}
  {fn.toPerson && <p>Send the not-sure answers to a person.</p>}

  <h2>Call it from your language</h2>
  <p>{!preview && 'The Bash command works today. '}The libraries come with 0.1. Their samples show how the calls will read.</p>
  <CrossView fn={fn.name} />

  <h2>The options</h2>
  {fn.options.length === 0 ? (
    <p>The specification does not carry <code>{fn.name}</code> yet, so its options are not settled.</p>
  ) : (
    <>
      <p>It takes <code>{fn.args}</code>{fn.args.endsWith('.') ? '' : '.'}</p>
      <table>
        <tr><th>Option</th><th>What it does</th></tr>
        {fn.options.map(([opt, what]) => (
          <tr><td><code>{opt}</code></td><td>{what}</td></tr>
        ))}
      </table>
    </>
  )}

  {rest.length > 0 && (
    <>
      <h3>Each option, taught once</h3>
      {rest.map((run) => <Terminal run={run} caption={`Recorded from the real command. ${run.see}`} />)}
    </>
  )}

  <h2>What it costs</h2>
  <p>About a penny buys a thousand answers on short records. The live probe on 2026-09-20 measured {probe}.</p>
  <p>{fn.requests}</p>

  <h2>Jobs that use <code>{title}</code></h2>
  {howtos.length === 0 ? (
    <p>No how-to uses <code>{title}</code> yet.</p>
  ) : (
    <div class="grid">
      {howtos.map((h) => (
        <a class="tile" href={`/how-tos/${h.slug}/`}><b>{h.title}</b><span>{h.reader}</span></a>
      ))}
    </div>
  )}

  <p class="pagelinks"><a href="/functions/">See every function</a> · <a href="/shell/">Use it from Bash</a> · <a href="/trust/">Test it before you trust it</a></p>
</Base>
