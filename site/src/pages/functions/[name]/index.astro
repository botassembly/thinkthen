---
// Goal: show one function's command, value, and exit code first.
import Base from '../../../layouts/Base.astro';
import Terminal from '../../../components/Terminal.astro';
import Code from '../../../components/Code.astro';
import CrossView from '../../../components/CrossView.astro';
import { FUNCTIONS, HOWTOS } from '../../../data/catalog.mjs';
import { captioned, files } from '../../../data/samples.mjs';
import { beatlesPageFor } from '../../../data/beatles.mjs';
import { slideCard } from '../../../data/cards.mjs';
import { REFERENCE_PAGES } from '../../../data/reference.mjs';

export function getStaticPaths() {
  return FUNCTIONS.map((fn) => ({ params: { name: fn.name }, props: { fn } }));
}

const { fn } = Astro.props;
// The Reference page that covers this function's edge cases, if one does.
const edges = REFERENCE_PAGES.find((p) => p.slug === fn.name);
if (!fn.goal) throw new Error(`functions: ${fn.name} has no goal`);
const page = `functions/${fn.name}`;
const all = captioned(page, fn.see, true);
const inputs = files(page);
const first = all[0];
const howtos = HOWTOS.filter((h) => fn.howtos.includes(h.slug));
const title = fn.title || fn.name;
const line = fn.line.charAt(0).toLowerCase() + fn.line.slice(1);
// The same function on Beatles Bench, where every answer is known.
const bench = beatlesPageFor(fn.name);
const card = slideCard(fn.name);
---
<Base title={title} description={fn.line} image={card?.image} imageAlt={card?.alt}>
  <div class="eyebrow">{fn.notAFunction ? 'a saved question' : fn.primitive}</div>
  <h1><code>{title}</code>: {line}</h1>
  {inputs.map((file) => <Code code={file.text} file={file.name} caption={`${file.name}, a file the examples read`} />)}
  {first && <Terminal run={first} caption={first.see} />}
  {fn.lede ? (
    <p class="lede" set:html={fn.lede} />
  ) : (
    <p class="lede">You give it {fn.takes}. You get back {fn.gives}.</p>
  )}
  {!first && bench && <p>See <code>{fn.name}</code> run on Beatles Bench: <a href={bench.route}>{bench.title}</a></p>}

  <h2>Read the answer</h2>
  <p>{fn.unsure}</p>
  {fn.exits.length > 0 && (
    <table>
      <tr><th>Exit code</th><th>What it means</th></tr>
      {fn.exits.map(([code, what]) => (
        <tr><td><span class={`exit ${code === 0 ? 'yes' : code === 1 ? 'no' : code === 3 ? 'unsure' : 'broken'}`}>{code}</span></td><td>{what}</td></tr>
      ))}
    </table>
  )}
  {fn.toPerson && <p>Send the not-sure answers to a person.</p>}

  <h2>Call it from your language</h2>
  <CrossView fn={fn.name} above={Boolean(first)} />

  <p class="pagelinks"><a href={`/reference/functions/${fn.name}/`}>Arguments, options, and more examples</a>{edges && <> · <a href={edges.route}>{edges.title}</a></>}</p>

  {howtos.length > 0 && (
    <>
      <h2>Jobs that use <code>{title}</code></h2>
      <div class="grid">
        {howtos.map((h) => (
          <a class="tile" href={`/how-tos/${h.slug}/`}><b>{h.title}</b><span>{h.reader}</span></a>
        ))}
      </div>
    </>
  )}

  {first && bench && <p>Watch <code>{fn.name}</code> answer questions about Beatles songs: <a href={bench.route}>{bench.title}</a></p>}
</Base>
