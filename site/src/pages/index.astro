---
// Goal: show in one screen what ThinkThen does, with one real call in the
// reader's language.
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Code from '../components/Code.astro';
import InstallLine from '../components/InstallLine.astro';
import { CODE_FUNCTIONS, SURFACES, HOWTOS, FUNCTIONS, COUNTS } from '../data/catalog.mjs';
import { captioned, firstCall } from '../data/samples.mjs';

const tabs = [
  { label: 'Bash', alias: 'Bash', surface: 'shell' },
  { label: 'Python', alias: 'Python', surface: 'python' },
  { label: 'TypeScript', alias: 'TypeScript', surface: 'typescript' },
  { label: 'Ruby', alias: 'Ruby', surface: 'ruby' },
  { label: 'R', alias: 'R', surface: 'r' },
  { label: 'Rust', alias: 'Rust', surface: 'rust' },
  { label: 'SQL', alias: 'SQL', surface: 'duckdb' },
];

const bash = captioned('functions/filter', FUNCTIONS.find((f) => f.name === 'filter').see)[0];
const surfaceOf = (slug) => SURFACES.find((s) => s.slug === slug);
const sixHowtos = HOWTOS.slice(0, 6);
---
<Base title="ThinkThen">
  <h1>Code that knows what you mean.</h1>
  <p class="lede">Simple functions that give your software judgment. Hand one a message, ask "Is this a complaint?", and get back yes, no, or not sure.</p>

  <div class="tabbed" data-fallback="Bash">
    <div class="tabs" role="tablist">
      {tabs.map((t) => (
        <button type="button" role="tab" data-lang={t.label} data-alias={t.alias} aria-selected={t.label === 'Bash'}>{t.label}</button>
      ))}
    </div>
    <div class="cell" data-lang="Bash">
      <Terminal run={bash} caption={bash.see} />
      <InstallLine line={surfaceOf('shell').install[0][0]} caption="Install the command" />
      <InstallLine line={surfaceOf('shell').install[1][0]} caption="Or with Homebrew, an option on a Mac" />
    </div>
    {tabs.slice(1).map((t) => (
      <div class="cell" data-lang={t.label} hidden>
        <Code code={firstCall(t.surface).code} />
        <InstallLine line={surfaceOf(t.surface).install[0][0]} caption={`Install it for ${surfaceOf(t.surface).name}`} />
      </div>
    ))}
  </div>
  <p class="pagelinks"><a href="/install/">Every language, database, and backend</a></p>

  <p><code>decide</code> is an if that understands. <code>filter</code> is a grep that understands. <code>rank</code> is a sort that understands. Every answer rests on the model's probabilities. On <code>decide</code>, a band sends anything between its two sides back as not sure. A person reads those.</p>

  <h2>The ten functions</h2>
  <p class="counts">{COUNTS.functions}, <a href="/install/shell/">{COUNTS.cli}</a>, <a href="/install/">{COUNTS.bindings}</a>.</p>
  <div class="grid">
    {CODE_FUNCTIONS.map((fn) => (
      <a class="tile" href={`/functions/${fn.name}/`}>
        <b>{fn.name}</b>
        <span>{fn.line}</span>
      </a>
    ))}
  </div>
  <p class="pagelinks"><a href="/functions/question-file/">Save a question as a file</a></p>

  <h2>Learn it on the Beatles</h2>
  <p><a href="/learn/beatles-bench/">Beatles Bench</a> asks questions about Beatles songs. A script set the right answer to each scored question ahead of time, from Wikipedia and Wikidata. New to ThinkThen? Start with the <a href="/learn/tutorial/">tutorial</a>.</p>

  <h2>Jobs your software can take on</h2>
  <div class="grid">
    {sixHowtos.map((h) => (
      <a class="tile" href={`/how-tos/${h.slug}/`}>
        <b>{h.title}</b>
        <span>{h.reader}</span>
      </a>
    ))}
  </div>
  <p class="pagelinks"><a href="/how-tos/">See every how-to</a></p>
</Base>
