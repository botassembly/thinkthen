---
// Goal: show the command line's install line and first call, how Bash reads
// an answer, and the shell techniques that teach it one form at a time.
import SurfacePage from '../../../components/SurfacePage.astro';
import { SURFACES, TECHNIQUES } from '../../../data/catalog.mjs';

const surface = SURFACES.find((s) => s.slug === 'shell');
const plain = (text) => text.replaceAll('`', '');
const first = (text) => `${plain(text).split('. ')[0].replace(/\.$/, '')}.`;
---
<SurfacePage surface={surface} route="/languages/bash/">
  <h2 id="techniques">Bash techniques</h2>
  <p>A ThinkThen function is a shell command. It reads standard input, prints an answer, and sets an exit code. Each technique teaches one shell form with one real run.</p>
  <ul>
    {TECHNIQUES.map((t) => (
      <li><a href={`/languages/bash/${t.slug}/`}>{t.title}</a>: {first(t.said)}</li>
    ))}
  </ul>
  <p class="pagelinks"><a href="/recipes/#shell-jobs">Shell jobs</a> put these forms to work.</p>
</SurfacePage>
