---
// Goal: help a reader find their language, install ThinkThen there, and
// paste a first call, with Bash and agents beside the languages.
import Base from '../../layouts/Base.astro';
import LinkName from '../../components/LinkName.astro';
import InstallLine from '../../components/InstallLine.astro';
import { SURFACES, BINDINGS, TAB_GROUPS, COUNTS, CODE_FUNCTIONS } from '../../data/catalog.mjs';
import { hasSamples } from '../../data/samples.mjs';

const shell = SURFACES.find((s) => s.slug === 'shell');
const plain = (text) => text.replaceAll('`', '');
const groups = TAB_GROUPS
  .filter((g) => g.name !== 'Command line' && g.name !== 'Databases')
  .map((g) => ({ name: g.name, list: g.slugs.map((slug) => ({ ...SURFACES.find((s) => s.slug === slug), route: BINDINGS.find((b) => b.slug === slug).route })) }));
const supported = [shell, { name: 'MCP', route: '/languages/agents/', versions: shell.versions }, ...groups.flatMap((g) => g.list)];
const databases = BINDINGS.filter((b) => b.database);
const names = [...CODE_FUNCTIONS.map((fn) => fn.name), 'question-file'];
const withSamples = groups.flatMap((g) => g.list).filter((s) => hasSamples(s.slug, names));
const listed = (list) => list.map((s, i) => `${i === 0 ? '' : i === list.length - 1 ? ' and ' : ', '}${s.name}`).join('');
---
<Base title="Languages" description="Find your language, install ThinkThen there, and paste a first call. The same ten functions run from Bash, every language binding and agents.">
  <h1>Languages</h1>
  <p class="lede">Find your language. Its page shows how to install ThinkThen and links the package guide. The {listed(withSamples)} pages also show a first call and all ten functions.</p>
  <p class="counts">{COUNTS.functions}, <a href="/languages/bash/">{COUNTS.cli}</a>, {COUNTS.bindings}.</p>

  <h2 id="supported-versions">Supported versions</h2>
  <table>
    <thead><tr><th scope="col">Language or command</th><th scope="col">Supported versions</th><th scope="col">Platforms</th></tr></thead>
    <tbody>{supported.map((s) => (
      <tr><th scope="row"><a href={s.route ?? '/languages/bash/'}>{s.name}</a></th><td>{s.versions?.runtime}</td><td>{s.versions?.platforms}</td></tr>
    ))}</tbody>
  </table>

  <h2><a href="/languages/bash/">Bash</a></h2>
  <p>{plain(shell.blurb)}</p>
  <InstallLine line={shell.install[0][0]} caption="The download script" />

  {groups.map((g) => (
    <Fragment>
      <h2>{g.name}</h2>
      <ul>
        {g.list.map((s) => <li><a href={s.route}><LinkName name={s.name} /></a>: {plain(s.blurb)}</li>)}
      </ul>
    </Fragment>
  ))}

  <h2><a href="/languages/agents/">Agents</a></h2>
  <p>An agent calls the ten functions as tools through the local MCP server, and the agent skill tells it which one to pick.</p>

  <h2>Databases</h2>
  <p>Ask from SQL in {databases.map((b, i) => <>{i > 0 && (i === databases.length - 1 ? ' and ' : ', ')}<a href={b.route}>{b.name}</a></>)}.</p>
</Base>
