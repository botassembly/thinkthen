---
// Goal: show that the ten functions run inside DuckDB, SQLite and
// PostgreSQL with the same answers, caching and replay, as one set of SQL in
// DuckDB syntax with the other two databases' differences inline.
import Base from '../../layouts/Base.astro';
import Code from '../../components/Code.astro';
import { CODE_FUNCTIONS, FUNCTIONS, SURFACES } from '../../data/catalog.mjs';
import { files, sample } from '../../data/samples.mjs';

const DBS = ['duckdb', 'sqlite', 'postgresql'].map((slug) => SURFACES.find((s) => s.slug === slug));
const [duckdb, ...others] = DBS;
// Each sample starts with its database's load line. The table above the
// functions shows that line once, so each query shows without it.
const LOAD = { duckdb: /^LOAD [^\n]*\n\n?/, sqlite: /^\.load [^\n]*\n\n?/, postgresql: /^/ };
const body = (slug, code) => code.replace(LOAD[slug], '');
const loadLine = (slug) => (slug === 'postgresql'
  ? DBS[2].install[1][0]
  : sample('decide', slug).code.match(LOAD[slug])[0].trim());
const parts = (text) => text.split('`').map((part, i) => ({ code: i % 2 === 1, part }));

const fns = [...CODE_FUNCTIONS, FUNCTIONS.find((f) => f.name === 'question-file')].map((fn) => {
  const runs = DBS.map((db) => {
    const found = sample(fn.name, db.slug);
    if (!found) throw new Error(`databases: examples/functions/${fn.name} has no ${db.slug} sample`);
    return { db, file: found.file, query: body(db.slug, found.code), output: found.output };
  });
  const read = runs.map((r) => r.query).join('\n');
  return {
    name: fn.name,
    title: fn.title || fn.name,
    inputs: files(`functions/${fn.name}`).filter((file) => read.includes(file.name)),
    first: runs[0],
    rest: runs.slice(1).map((r) => ({ ...r, same: r.query === runs[0].query })),
  };
});
---
<Base title="Databases" description="Ask the ten ThinkThen functions inside DuckDB, SQLite or PostgreSQL, with the same answers, answer cache and replay as every other binding.">
  <h1>Databases</h1>
  <p class="lede">Ask the ten functions inside the database you already use. The same engine answers them. They keep the same answer cache and replay saved answers the same way.</p>

  <h2 id="load">Load the extension</h2>
  <table>
    <tr><th>Database</th><th>Load line</th><th>Not sure</th></tr>
    {DBS.map((db) => (
      <tr><td><a href={`/databases/${db.slug}/`}>{db.name}</a></td><td><code>{loadLine(db.slug)}</code></td><td>{parts(db.unsureWord).map((x) => x.code ? <code>{x.part}</code> : x.part)}</td></tr>
    ))}
  </table>
  <p>Each database's page gives its install steps and a first query. Every query below runs after the load line, and each one replays a saved answer.</p>

  <h2 id="functions">The ten functions in SQL</h2>
  <p>Each query is in {duckdb.name} syntax. Where {others.map((db) => db.name).join(' or ')} asks it another way, its own query follows. Each heading links the function's page, which explains it in Bash.</p>
  {fns.map((f) => (
    <>
      <h3 id={`fn-${f.name}`}><a href={`/functions/${f.name}/`}><code>{f.title}</code></a></h3>
      {f.inputs.map((file) => <Code code={file.text} file={file.name} caption={`${file.name}, a file the query reads`} />)}
      <Code code={f.first.query} lang="sql" caption={duckdb.name} label={`Copy the ${duckdb.name} ${f.name} query`} />
      {f.first.output && <Code code={f.first.output} lang="output" caption={`What ${duckdb.name} printed`} copy={false} />}
      {f.rest.map((r) => (
        <>
          {r.same
            ? <p>{r.db.name} runs the same query.</p>
            : <Code code={r.query} lang="sql" caption={r.db.name} label={`Copy the ${r.db.name} ${f.name} query`} />}
          {r.output && <Code code={r.output} lang="output" caption={`What ${r.db.name} printed`} copy={false} />}
        </>
      ))}
    </>
  ))}

  <h2 id="caching-and-replay">Caching and replay</h2>
  <ul>
    {DBS.map((db) => <li><a href={`/databases/${db.slug}/`}>{db.name}</a>: {parts(db.settings).map((x) => x.code ? <code>{x.part}</code> : x.part)}</li>)}
  </ul>
  <p><a href="/start/replay/">Replay in tests</a> shows a replay from the command line. <a href="/start/pay-once/#the-key">Pay once</a> says what makes two questions the same.</p>
</Base>
