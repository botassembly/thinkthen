---
// Goal: show that the ten functions run inside DuckDB, SQLite and
// PostgreSQL with the same answers, caching and replay, as one set of SQL in
// DuckDB syntax with the other two databases' differences inline.
import Base from '../../layouts/Base.astro';
import Code from '../../components/Code.astro';
import { CODE_FUNCTIONS, FUNCTIONS, SURFACES } from '../../data/catalog.mjs';
import { files, sample } from '../../data/samples.mjs';

const DBS = ['duckdb', 'sqlite', 'postgresql'].map((slug) => SURFACES.find((s) => s.slug === slug));
const [duckdb, ...others] = DBS;
// Each sample starts with its database's load line. The table above the
// functions shows that line once, so each query shows without it.
const LOAD = { duckdb: /^LOAD [^\n]*\n\n?/, sqlite: /^\.load [^\n]*\n\n?/, postgresql: /^/ };
const body = (slug, code) => code.replace(LOAD[slug], '');
const loadLine = (slug) => (slug === 'postgresql'
  ? DBS[2].install.find(([line]) => line.startsWith('CREATE EXTENSION '))[0]
  : sample('decide', slug).code.match(LOAD[slug])[0].trim());
const parts = (text) => text.split('`').map((part, i) => ({ code: i % 2 === 1, part }));

const shown = (fn) => {
  const runs = DBS.map((db) => {
    const found = sample(fn.name, db.slug);
    if (!found) throw new Error(`databases: examples/functions/${fn.name} has no ${db.slug} sample`);
    return { db, file: found.file, query: body(db.slug, found.code), output: found.output };
  });
  const read = runs.map((r) => r.query).join('\n');
  return {
    name: fn.name,
    title: fn.title || fn.name,
    inputs: files(`functions/${fn.name}`).filter((file) => read.includes(file.name)),
    first: runs[0],
    rest: runs.slice(1).map((r) => ({ ...r, same: r.query === runs[0].query })),
  };
};
const fns = CODE_FUNCTIONS.map(shown);
const questionFile = shown(FUNCTIONS.find((f) => f.name === 'question-file'));

// Each row names a real difference, as the samples below show it.
const DIFFERS = [
  ['A newline in a string', '`chr(10)`', '`char(10)`', '`chr(10)`'],
  ['Labels and levels', "a list after the question: `['a', 'b']`", 'JSON question text that holds them', 'JSON question text that holds them, then `NULL`'],
  ['Kinds, rules and lines to search', "a list: `['a', 'b']`", "`'a,b'` for kinds and rules, `json_array('a', 'b')` for lines", "`ARRAY['a', 'b']`"],
  ['Rows as one JSON object', '`json_group_object(id, body)`', '`json_group_object(id, body)`', '`jsonb_object_agg(id, body)`'],
  ['What find returns', 'a struct: read `.value`', "JSON text: read `json_extract(x, '$.value')`", "`jsonb`: read `x ->> 'value'`"],
  ['What recognize returns', 'a list: `unnest` it', 'a table function', 'a table function'],
  ['How yes and no print', '`true`, `false`', '`1`, `0`', '`t`, `f`'],
];
---
<Base title="Databases" description="Ask the ten ThinkThen functions inside DuckDB, SQLite or PostgreSQL, with the same answers, answer cache and replay as every other binding.">
  <h1>Databases</h1>
  <p class="lede">Ask the ten functions inside the database you already use. The same engine answers them. They keep the same answer cache and replay saved answers the same way.</p>

  <h2 id="supported-versions">Supported versions</h2>
  <table>
    <thead><tr><th scope="col">Database</th><th scope="col">Supported versions</th><th scope="col">Platforms</th></tr></thead>
    <tbody>{DBS.map((db) => (
      <tr><td><a href={`/databases/${db.slug}/`}>{db.name}</a></td><td>{Array.isArray(db.versions.runtime) ? db.versions.runtime.join(' and ') : db.versions.runtime}</td><td>{db.versions.platforms}</td></tr>
    ))}</tbody>
  </table>

  <h2 id="load">Load the extension</h2>
  <table>
    <tr><th>Database</th><th>Load line</th></tr>
    {DBS.map((db) => (
      <tr><td><a href={`/databases/${db.slug}/`}>{db.name}</a></td><td><code>{loadLine(db.slug)}</code></td></tr>
    ))}
  </table>
  <p>Each database's page gives its install steps and a first query. Every query below runs after the load line, and each one was checked with a saved answer. The queries use your selected backend unless you configure replay. In all three databases, a not-sure answer comes back as <code>NULL</code>.</p>

  <h2 id="what-differs">What differs</h2>
  <table>
    <tr><th>What</th>{DBS.map((db) => <th>{db.name}</th>)}</tr>
    {DIFFERS.map(([what, ...cells]) => (
      <tr><td>{what}</td>{cells.map((c) => <td>{parts(c).map((x) => x.code ? <code>{x.part}</code> : x.part)}</td>)}</tr>
    ))}
  </table>

  <h2 id="functions">The ten functions in SQL</h2>
  <p>Each query is in {duckdb.name} syntax. Under it, {others.map((db) => db.name).join(' and ')} show what they printed, and their own query where it differs. Each heading links the function's page, which explains it in Bash.</p>
  {[...fns, null, questionFile].map((f) => f === null ? (
    <h2 id="question-file">A saved question file</h2>
  ) : (
    <>
      <h3 id={`fn-${f.name}`}><a href={`/functions/${f.name}/`}><code>{f.title}</code></a></h3>
      {f.inputs.map((file) => <Code code={file.text} file={file.name} caption={`${file.name}, a file the query reads`} />)}
      <Code code={f.first.query} lang="sql" caption={duckdb.name} label={`Copy the ${duckdb.name} ${f.name} query`} />
      {f.first.output && <Code code={f.first.output} lang="output" caption={`What ${duckdb.name} printed`} copy={false} />}
      <details>
        <summary>{others.map((db) => db.name).join(' and ')}</summary>
        {f.rest.map((r) => (
          <>
            {r.same
              ? <p>{r.db.name} runs the same query.</p>
              : <Code code={r.query} lang="sql" caption={r.db.name} label={`Copy the ${r.db.name} ${f.name} query`} />}
            {r.output && <Code code={r.output} lang="output" caption={`What ${r.db.name} printed`} copy={false} />}
          </>
        ))}
      </details>
    </>
  ))}

  <h2 id="caching-and-replay">Caching and replay</h2>
  <p>Each database records and replays saved answers with its own setting: {DBS.map((db, i) => <>{i > 0 && (i === DBS.length - 1 ? ' and ' : ', ')}<a href={`/databases/${db.slug}/#settings`}>{db.name}</a></>)}. <a href="/start/replay/">Replay in tests</a> shows a replay from the command line.</p>
</Base>
