---
// Goal: show how to load ThinkThen into one database and ask a first query,
// with what is different in that database.
import SurfacePage from '../../components/SurfacePage.astro';
import { SURFACES, BINDINGS } from '../../data/catalog.mjs';

export function getStaticPaths() {
  return SURFACES
    .filter((s) => BINDINGS.some((b) => b.slug === s.slug && b.database))
    .map((s) => ({ params: { surface: s.slug }, props: { surface: s } }));
}

const { surface } = Astro.props;
---
<SurfacePage surface={surface} route={`/databases/${surface.slug}/`} eyebrow={['/databases/', 'Databases']} functionsAt="/databases/" />
