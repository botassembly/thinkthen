---
import Base from '../layouts/Base.astro';
import { SURFACES, KEY_VARIABLE } from '../data/catalog.mjs';
const shell = SURFACES.find((s) => s.slug === 'shell');
const rest = SURFACES.filter((s) => s.slug !== 'shell');
// The rows are mapped, not written out one by one. An expression inside a
// <code> element written straight into a table makes the Astro compiler emit
// a stray <code> after the table, and the rest of the page turns monospace.
// sdlc/issues/2026-09-25-site-samples-and-pages-after-the-surfaces-land.md
const channels = [
  ['Homebrew', shell.install[0][0]],
  ['Download script', shell.install[1][0]],
];
---
<Base title="Install" description="One line installs ThinkThen for Bash, each language, and each database.">
  <h1>Install</h1>
  <p class="lede">One line installs ThinkThen, the command that answers questions about text. Bash ships first. Every library below lists the line it will ship under.</p>

  <div class="note">Ask for a key first. It can take a day to arrive. While you wait, <code>--dry-run</code> shows the plan with no key.</div>

  <h2>Bash</h2>
  <p>Both channels come with 0.1.</p>
  <table>
    <tr><th>Channel</th><th>Line</th><th>Status</th></tr>
    {channels.map(([channel, line]) => (
      <tr><td>{channel}</td><td><code>{line}</code></td><td><span class="status planned">comes with 0.1</span></td></tr>
    ))}
  </table>
  <p>The download script will be served from this site at <code>/install.sh</code>. It matches the repository's copy byte for byte.</p>

  <h2>Where the key goes</h2>
  <p>Set <code>{KEY_VARIABLE}</code> in the environment. No flag and no file carries a key.</p>

  <h2>Libraries and databases</h2>
  <p>Each page shows how the calls will read.</p>
  <table>
    <tr><th>Language or database</th><th>Channels</th><th>Status</th></tr>
    {rest.map((s) => (
      <tr>
        <td><a href={`/${s.slug}/`}>{s.name}</a></td>
        <td>{s.install.map(([line], i) => (<Fragment>{i > 0 ? ' · ' : ''}<code>{line}</code></Fragment>))}</td>
        <td><span class="status planned">{s.release ? `comes with ${s.release}` : 'planned'}</span></td>
      </tr>
    ))}
  </table>

  <p class="pagelinks"><a href="/shell/">Read the Bash page</a> · <a href="/surfaces/">See every language and database</a> · <a href="/functions/">See every function</a></p>
</Base>
