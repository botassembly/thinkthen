---
// Goal: say who makes ThinkThen and why, and where to find the author, his company, the code and the way to report a problem.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { REPO } from '../data/catalog.mjs';
import { AUTHOR, COMPANY, LICENSE, ISSUES, SECURITY, SITE_ORIGIN, ORGANIZATION_LD, PERSON_LD } from '../data/about.mjs';

const description = 'Ian Maurer, CTO of GenomOncology, makes ThinkThen. The code is open source under the MIT License.';
const structured = [{
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${SITE_ORIGIN}/about/`,
      url: `${SITE_ORIGIN}/about/`,
      name: 'About ThinkThen',
      description,
      mainEntity: { '@id': PERSON_LD['@id'] },
      publisher: { '@id': ORGANIZATION_LD['@id'] },
    },
    PERSON_LD,
    ORGANIZATION_LD,
  ],
}];
---
<Base title="About" description={description} structured={structured}>
  <h1>About ThinkThen</h1>
  <p class="lede">Ian Maurer makes ThinkThen. He is the CTO of <a href={COMPANY.url}>GenomOncology</a>.</p>

  <h2>Why it exists</h2>
  <p>Code sees strings. It cannot tell what a message means. ThinkThen asks a model a bounded question about a piece of text. It gives your code back a plain answer and an exit code. A script can branch on that answer, as it would on any other value. <a href="/blog/code-that-understands/">Code that knows what you mean</a> tells the longer story.</p>

  <h2>Ian Maurer</h2>
  <p>Ian is the CTO of GenomOncology. He writes about AI agents doing real biomedical work on his blog.</p>
  <ul class="about-links">
    {AUTHOR.links.map((l) => (
      <li><a href={l.href}><Icon name={l.icon} />{l.label}</a></li>
    ))}
  </ul>

  <h2>GenomOncology</h2>
  <a class="about-logo" href={COMPANY.url}>
    <img src={COMPANY.logoLight} alt={COMPANY.name} class="on-light" width={COMPANY.logoWidth / 2} height={COMPANY.logoHeight / 2}>
    <img src={COMPANY.logoDark} alt={COMPANY.name} class="on-dark" width={COMPANY.logoWidth / 2} height={COMPANY.logoHeight / 2}>
  </a>
  <p>GenomOncology builds software for precision oncology. Its software and data help the healthcare community improve cancer care. Read more at <a href={COMPANY.url}>genomoncology.com</a>.</p>

  <h2>The code</h2>
  <p>ThinkThen is open source under the <a href={LICENSE.href}>{LICENSE.name}</a>. One public repository holds the command, the bindings, the specification and this site: <a href={REPO}>{REPO.replace('https://', '')}</a>.</p>

  <h2>Report a problem</h2>
  <p>Open an <a href={ISSUES}>issue on GitHub</a> for a bug or an answer that looks wrong. Include the command, the version from <code>thinkthen --version</code>, and what you expected. Report a security problem privately through the repository's <a href={SECURITY}>Security tab</a>. Never include an API key.</p>
</Base>
