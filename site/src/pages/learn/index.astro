---
// Goal: point a new reader to the tutorial, Beatles Bench and the concept pages.
import Base from '../../layouts/Base.astro';
import { PAGES } from '../../data/beatles.mjs';

const talk = PAGES.slice(1);
---
<Base title="Learn" description="The tutorial, the Beatles Bench talk as pages, and how to test ThinkThen before you trust it.">
  <h1>Learn</h1>
  <p class="lede">Start with the tutorial. Then watch ThinkThen answer questions about Beatles songs.</p>

  <div class="grid">
    <a class="tile" href="/start/tutorial/"><b>Tutorial</b><span>From the install line to a pipeline that sorts a stream of messages.</span></a>
    <a class="tile" href="/learn/beatles-bench/"><b>Beatles Bench</b><span>The talk as {talk.length} short pages. Each shows one slide and one idea.</span></a>
    <a class="tile" href="/trust/"><b>Test it before you trust it</b><span>Outcomes, thresholds, saved answers, and checking a question against your own records.</span></a>
    <a class="tile" href="/start/replay/"><b>Replay in tests</b><span>Save the answers once. Replay them in every test with no key and no network.</span></a>
    <a class="tile" href="/start/speed/"><b>Speed</b><span>How much of a call ThinkThen and each binding spend, measured against Jev.</span></a>
    <a class="tile" href="/start/pay-once/"><b>Pay once</b><span>Many records share one request, and each question keeps its own saved answer.</span></a>
  </div>

  <h2>Beatles Bench</h2>
  <ol class="talk">
    {talk.map((p) => <li><a href={p.route}>{p.command ? <><code>{p.title.split(' ')[0]}</code>{'\u00a0'}{p.title.split(' ').slice(1).join(' ')}</> : p.title}</a></li>)}
  </ol>

  <h2>Questions and answers</h2>
  <ul>
    <li><a href="/start/files/">Files and folders</a></li>
    <li><a href="/learn/answers/">How answers work</a></li>
    <li><a href="/learn/question-sets/">Question sets</a></li>
  </ul>
  <p><a href="/functions/">Functions</a> lists each function's full reference. <a href="/refusals/">What it will not do</a> lists every line the tool will not cross.</p>
</Base>
