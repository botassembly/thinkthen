---
// Goal: teach one idea from the talk with one slide, and where the slide has
// a run, one real run on Beatles Bench and the same run at another bar. Each
// page's own goal sits in beatles.mjs.
import BeatlesPage from '../../../layouts/BeatlesPage.astro';
import SlideImage from '../../../components/SlideImage.astro';
import LinkName from '../../../components/LinkName.astro';
import Terminal from '../../../components/Terminal.astro';
import Code from '../../../components/Code.astro';
import { PAGES } from '../../../data/beatles.mjs';
import { captioned, benchFile, files } from '../../../data/samples.mjs';
import folders from '../../../../examples/beatles/folders.json';
import slides from '../../../data/slides.json';

export function getStaticPaths() {
  return PAGES.filter((p) => p.slug).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
for (const field of ['goal', 'takeaway']) {
  if (!page[field]) throw new Error(`beatles: ${page.slug} has no ${field}`);
}
const runs = captioned(`beatles/${page.slug}`, page.see, !page.see);
if (runs.length && !page.lesson) throw new Error(`beatles: ${page.slug} has examples and no lesson`);
// A page shows files from its bench folder, or from its own files/.
const own = files(`beatles/${page.slug}`);
const inputs = Object.entries(page.files || {}).map(([name, caption]) => {
  const file = folders[page.slug] ? benchFile(folders[page.slug], name) : own.find((f) => f.name === name);
  if (!file) throw new Error(`beatles: ${page.slug} shows ${name}, and its files/ has none`);
  return { ...file, caption };
});
// Prose marks code with backticks and a link as [text](/route/).
const parts = (text) => text.split(/(`[^`]+`|\[[^\]]+\]\([^)]+\))/).filter(Boolean).map((p) => {
  if (p.startsWith('`')) return { code: p.slice(1, -1) };
  const link = /^\[([^\]]+)\]\(([^)]+)\)$/.exec(p);
  return link ? { text: link[1], href: link[2] } : { text: p };
});
const [first, ...rest] = page.title.split(' ');
---
<BeatlesPage page={{ ...page, description: page.idea[0].replace(/`|\[|\]\([^)]*\)/g, '') }}>
  <div class="eyebrow">Beatles Bench · {page.group}</div>
  <h1>{page.command ? <><code>{first}</code> {rest.join(' ')}</> : page.title}</h1>
  <figure class="slide">
    <a href={page.slide}><SlideImage src={page.slide} alt={`The talk's slide: ${page.title}`} height={slides.slides[page.slug]?.height} /></a>
    <figcaption>{[page.slideNote, page.credit].filter(Boolean).join(' ')}{(page.slideNote || page.credit) && ' '}<a href={page.slide}>Open the slide at full size.</a></figcaption>
  </figure>
  {page.idea.map((para) => <p>{parts(para).map((p) => p.code !== undefined ? <code>{p.code}</code> : p.href ? <a href={p.href}><LinkName name={p.text} /></a> : p.text)}</p>)}
  {page.source && <p>The numbers come from {[page.source].flat().map((s, i, all) => <Fragment>{i > 0 && (i === all.length - 1 ? ' and ' : ', ')}<a href={s.href}>{s.text}</a></Fragment>)}.</p>}

  {(page.blocks || []).map((b) => <Code code={b.code} lang="bash" caption={b.caption} />)}
  {inputs.map((file) => <Code code={file.text} file={file.name} caption={file.caption} />)}
  {runs.map((run, i) => (
    <Fragment>
      {i === 0 && !page.headings?.[run.name] && <h2>Run it</h2>}
      {page.headings?.[run.name] && <h2>{page.headings[run.name]}</h2>}
      <Terminal run={run} caption={run.see} />
    </Fragment>
  ))}

  {page.lesson && <h2>The lesson</h2>}
  {page.lesson && <p>{parts(page.lesson).map((p) => p.code !== undefined ? <code>{p.code}</code> : p.href ? <a href={p.href}>{p.text}</a> : p.text)}</p>}
  <p class="refrain">{parts(page.takeaway).map((p) => p.code !== undefined ? <code>{p.code}</code> : p.href ? <a href={p.href}>{p.text}</a> : p.text)}</p>
</BeatlesPage>
