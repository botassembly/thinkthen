---
// Goal: list the articles, newest first.
import Base from '../../layouts/Base.astro';
import { POSTS } from '../../data/posts.mjs';

const posts = [...POSTS]
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((p) => ({ href: p.href, title: p.draft ? `${p.title} (draft)` : p.title, blurb: p.blurb }));
---
<Base title="Blog" description="Writing about code that knows what you mean.">
  <h1>Blog</h1>
  <p class="lede">Articles about software that answers questions about text. These articles are drafted with AI agents against a voice guide, reviewed and edited by Ian.</p>
  <div class="grid">
    {posts.map((p) => (
      <a class="tile" href={p.href}><b>{p.title}</b><span>{p.blurb}</span></a>
    ))}
  </div>
  <p class="pagelinks"><a href="/functions/">See every function</a> · <a href="/trust/">Test it before you trust it</a></p>
</Base>
