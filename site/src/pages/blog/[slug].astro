---
// Goal: carry one article.
import Video from '../../components/Video.astro';
import Base from '../../layouts/Base.astro';
import { POSTS } from '../../data/posts.mjs';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = post;
// A post's `youtube` front matter names a video id, which Video.astro embeds
// under the title. A draft with no id shows where the video goes. A post's
// `card` and `cardAlt` name its social card.
---
<Base title={post.title} description={post.blurb} image={post.card} imageAlt={post.cardAlt} reading>
  {post.draft && <div class="note" data-draft><span class="status preview">draft</span> A draft for Ian to review. A normal build leaves this post out.</div>}
  <div class="eyebrow">{post.author} · {post.date}</div>
  <article class="prose">
    <h1>{post.title}</h1>
    {post.youtube ? <Video id={post.youtube} title={post.title} /> : post.draft && <div class="video-slot">The video goes here.</div>}
    <Content />
  </article>
  <p class="pagelinks">{(post.links || []).map((l) => <><a href={l.href}>{l.text}</a> · </>)}<a href="/blog/">Read the blog</a> · <a href="/trust/">Test it before you trust it</a></p>
</Base>
