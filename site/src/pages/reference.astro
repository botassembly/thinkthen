---
// Goal: list everything the command takes and prints, for a reader or an agent
// writing a pipeline.
import Base from '../layouts/Base.astro';
import { CODE_FUNCTIONS } from '../data/catalog.mjs';
import { setting } from '../lib/settings-table.mjs';

// Every row on this page comes from specification/. Nothing
// here is an example. The runs live on the function pages and the tutorial.
// Every default, range and allowed value comes from
// specification/settings.md through setting(). The address stays typed:
// the table gives its default only as "the built-in address".
const lower = (s) => s.charAt(0).toLowerCase() + s.slice(1);
const takes = (name) => lower(setting(name).allowed);
const dflt = (name) => lower(setting(name).default);
const cutOn = (fn) => setting('Threshold').defaultOn(fn);
const noCut = (fn) => (cutOn(fn) === 'none' ? 'n/a' : cutOn(fn));
const count = (name, noun) => `${setting(name).range.min} to ${setting(name).range.max} ${noun}`;
const THROTTLE = setting('Throttle');
const PRUNE = setting('Prune target');
const pruneKey = PRUNE.surface('Configuration file');

const GLOBAL = [
  ['--details', 'none', 'Prints the whole result object in place of the bare value.', dflt('Details')],
  ['--dry-run', 'none', 'Prints the plan and sends nothing. It reads no key. In record mode it prints the plan for the first record and stops.', dflt('Dry run')],
  ['--url BASE', takes('Address'), 'The backend base address. The tool posts to BASE/systemone. It outranks THINKTHEN_BASE_URL.', 'https://api.typesafe.ai/v1'],
  ['--model NAME', takes('Model'), 'The model the request carries. This is how a run is pinned to one version.', setting('Model').default],
  ['--timeout SECONDS', takes('Timeout'), 'Covers one attempt, connect to last byte. 0 is a usage error.', setting('Timeout').number],
  ['--max-retries N', takes('Retries'), 'How many times a retried status is sent again. A transport failure is never sent again.', setting('Retries').default],
  ['--record DIR', takes('Recording'), 'Calls the backend and writes each exchange into DIR. The folder is created when absent.', dflt('Recording')],
  ['--replay DIR', takes('Recording'), 'Answers from DIR alone. No connection and no key. A missing entry is exit 5.', dflt('Recording')],
  ['--cache DIR', takes('Recording'), 'Exactly --record DIR --replay DIR. Beside either of those it is a usage error.', dflt('Recording')],
  ['--no-cache', 'none', 'Turns off the platform cache for one run, both lookup and writing. It never turns off usage counting.', dflt('Answer cache')],
  ['--profile FILE', takes('Backend profile'), 'Applies local byte and question limits before a request leaves, and names the profile in use. It selects neither address nor model.', dflt('Backend profile')],
  ['--input FILE', takes('Input file'), 'Reads the evidence from a file instead of standard input. It names a path. It never names a framing.', dflt('Input file')],
];

const FRAMING = [
  ['none', 'The whole input is one text document and one record.'],
  ['--lines', 'Each line is one text record. A trailing newline ends the last record.'],
  ['--jsonl', 'Each line is one JSON value and one record. No blank lines.'],
  ['--csv', 'The first logical row is a header. Each later row becomes one JSON object of string cells.'],
  ['--tsv', 'The CSV rules, with a tab delimiter.'],
];

const FRAMING_BY_FN = [
  ['decide, choose, tag, score, annotate', 'One document by default. All four framing flags are accepted.'],
  ['filter, rank', 'Lines by default, or JSON Lines when a pointer is given. All four framing flags are accepted. One document is not a stream.'],
  ['find', '--lines by default, or --jsonl. CSV and TSV are refused as unexpected arguments.'],
];

const EXITS = [
  [0, 'yes', 'The command finished. On a single piece of evidence, decide answers yes.'],
  [1, 'no', 'A single piece of evidence under decide answers no. No other function exits 1.'],
  [2, 'broken', 'A usage error or an input error. The failing record sent nothing.'],
  [3, 'unsure', 'A single piece of evidence under decide or choose is not sure. Under find --none, nothing fits.'],
  [4, 'broken', 'The backend failed, or sent a reply the adapter refused. Also a missing or empty key, and evidence past the token limit.'],
  [5, 'broken', 'A local failure: a file or a saved answer. Also an unreadable question file, a band in a question file for choose, tag, or filter, and a threshold in a rank question file.'],
  [6, 'broken', 'annotate or relate only. The run read all its input, and one or more questions failed. It prints no diagnostic. annotate marks each failed question in its result. relate prints only the edges that succeeded.'],
  [70, 'broken', 'A defect in the tool.'],
];

const ENVS = [
  ['THINKTHEN_API_KEY', 'The key. No option names another variable. Absent or empty is exit 4, and an empty variable counts as absent.', dflt('Key')],
  ['THINKTHEN_BASE_URL', 'The base address. --url outranks it. Empty counts as absent.', 'https://api.typesafe.ai/v1'],
  ['THINKTHEN_CACHE', 'Selects another folder for the platform cache. It never moves the usage folder.', dflt('Answer cache')],
  ['XDG_CACHE_HOME', 'The root for the cache and the usage folder. It counts only when absolute.', '$HOME/.cache on Linux'],
  ['XDG_CONFIG_HOME', 'The root for config.json. It counts only when absolute.', '$HOME/.config on Linux'],
  ['HOME', 'The fallback root for the cache, the usage totals, and the configuration. It counts only when absolute.', 'none'],
  ['ALL_PROXY, HTTPS_PROXY, HTTP_PROXY, NO_PROXY', 'Read in upper and in lower case. Under https:// the named proxy carries the request and sees only the host. Under http:// every one of them is cancelled.', 'none'],
];

const ANSWERS = [
  ['yes_no', 'decide, filter, rank', '{"kind":"yes_no","probability":FLOAT}', 'The probability of yes, and nothing else. There is no confidence field on this kind.'],
  ['choice', 'choose', '{"kind":"choice","pick":STRING,"probabilities":{LABEL:FLOAT},"confidence":FLOAT}', 'pick is the highest option before any threshold. probabilities holds one entry per option, in send order. confidence is the vendor’s number and shows only when the backend sends it.'],
  ['tag', 'tag', '{"kind":"tag","probabilities":{LABEL:FLOAT}}', 'One entry per label, in send order.'],
  ['score', 'score', '{"kind":"score","level":STRING,"probabilities":{LEVEL:FLOAT}}', 'level is the highest level. probabilities follows your level order, lowest first.'],
  ['find', 'find', '{"kind":"find","pick":STRING,"probabilities":{UNIT:FLOAT,"none":FLOAT}}', 'probabilities follows unit order and puts none last.'],
];

const META = [
  ['tool', 'The name and version of the binary.'],
  ['question_sha256', 'The digest of the exact question this row answers. On annotate it is questions_sha256.'],
  ['url', 'The address that answered.'],
  ['model', 'The model that answered, as the backend reported it.'],
  ['usage', '{"input_tokens":INT,"output_tokens":INT}. Absent when the backend reports none.'],
  ['requests_sent', 'The HTTP attempts behind this result. A saved answer reports zero. Each retry adds one.'],
  ['cached', 'true when a saved answer served the row, from the cache or from --replay.'],
  ['requests', 'The digests of the logical requests, in the order they were built.'],
  ['failed_questions', 'How many logical questions failed. Always present, including zero.'],
  ['profile_warning', '{"tuned_for":NAME,"running":NAME}. The first name is the profile saved in the question file with its threshold. The second is the profile this run named with --profile. Absent unless both exist and differ.'],
];

const BARE = [
  ['decide', 'true, false, or null.'],
  ['choose', 'A JSON string, or null. --raw prints the bare label.'],
  ['tag', 'A JSON array of every label that reaches the bar, including [].'],
  ['score', 'A JSON number.'],
  ['find', 'The selected line or JSONL record as it arrived. Nothing when --none wins or ties.'],
  ['filter', 'Each kept line or JSONL record as it arrived, in input order. A kept table row prints as compact JSON.'],
  ['rank', 'Every line or record again, most likely yes first.'],
  ['annotate', 'One JSON object per record.'],
];

const COUNTS = [
  ['decide', 'none', 'A cut or a band. decide is the one function that takes both.', cutOn('decide')],
  ['choose', count('Options', 'options'), 'A cut only. A band is a usage error.', `${cutOn('choose')}; the winning label comes back`],
  ['tag', count('Labels', 'labels'), 'A cut only, applied to each label on its own. A band is refused.', cutOn('tag')],
  ['score', `${count('Levels', 'levels')}, lowest first`, 'None. score has no threshold.', noCut('score')],
  ['filter', 'none', 'A cut only. A band is exit 2 from the command line and exit 5 from a question file.', cutOn('filter')],
  ['rank', 'none', 'None. A threshold is refused in both homes.', noCut('rank')],
  ['find', '2 to 255 units, or 2 to 254 with --none', 'None.', 'n/a'],
  ['annotate', 'a question set file', 'Each question carries its own. A top-level threshold applies to every decide question that names none.', 'per question'],
];
---
<Base title="Reference" description="Every function, every flag, the result shape, every exit code, the environment, the cache, and the configuration file.">
  <h1>Reference</h1>
  <p class="lede">Everything the <code>thinkthen</code> command takes and prints. Read this page before you write a pipeline, and hand it to an agent.</p>

  <h2>The ten functions</h2>
  <table>
    <tr><th>Function</th><th>What it does</th><th>Primitive</th><th>Requests</th></tr>
    {CODE_FUNCTIONS.map((fn) => (
      <tr>
        <td><a href={`/functions/${fn.name}/`}><code>{fn.name}</code></a></td>
        <td>{fn.line}</td>
        <td>{fn.primitive}</td>
        <td>{fn.requests}</td>
      </tr>
    ))}
  </table>

  <h2>Arguments and thresholds</h2>
  <p>A threshold is your bar on a probability. You set it. The tool never reports one, and a threshold never changes the probability. A cut is one number. A band is two, written <code>LOW:HIGH</code>.</p>
  <table>
    <tr><th>Function</th><th>Positional arguments</th><th>Threshold</th><th>Default</th></tr>
    {COUNTS.map(([fn, args, rule, dflt]) => (
      <tr><td><code>{fn}</code></td><td>{args}</td><td>{rule}</td><td><code>{dflt}</code></td></tr>
    ))}
  </table>
  <p>With p as the probability of yes:</p>
  <table>
    <tr><th>Form</th><th>Accepted</th><th>Yes</th><th>No</th><th>Not sure</th></tr>
    <tr><td>none given</td><td></td><td>p ≥ {cutOn('decide')}</td><td>p &lt; {cutOn('decide')}</td><td>never</td></tr>
    <tr><td><code>--threshold T</code></td><td>0 &lt; T ≤ 1</td><td>p ≥ T</td><td>p &lt; T</td><td>never</td></tr>
    <tr><td><code>--threshold LOW:HIGH</code></td><td>0 ≤ LOW &lt; HIGH ≤ 1</td><td>p ≥ HIGH</td><td>p &lt; LOW</td><td>LOW ≤ p &lt; HIGH</td></tr>
  </table>
  <p>The high side is inclusive. A probability exactly at <code>LOW</code> is not sure. A cut of 0 is refused. A band low of 0 is accepted. <code>--threshold {cutOn('decide')}</code> and no threshold name the same rule. A percent such as <code>90</code>, a reversed band, an empty side, and a number that is not finite are all usage errors before any request.</p>
  <p>The cut applies to the probability of yes on <code>decide</code> and on each record under <code>filter</code>, to the winning option's probability on <code>choose</code>, and to each label on its own under <code>tag</code>.</p>

  <h2>Global flags</h2>
  <p>Every function accepts all of these. The <a href="/install/settings/">settings page</a> lists every setting on every surface, with its default.</p>
  <table>
    <tr><th>Flag</th><th>Takes</th><th>What it does</th><th>Default</th></tr>
    {GLOBAL.map(([flag, takes, does, dflt]) => (
      <tr><td><code>{flag}</code></td><td>{takes}</td><td>{does}</td><td><code>{dflt}</code></td></tr>
    ))}
  </table>
  <p><code>--jobs N</code> sets the throttle. The throttle is the most requests in flight at once. The flag is not global. It runs from {THROTTLE.range.min} to {THROTTLE.range.max}, defaults to {THROTTLE.default}, and it belongs to record mode. <code>annotate</code> also accepts it on one document, and <code>relate</code> on its one set of names. Every other function refuses it outside record mode.</p>
  <p>The vendor documents a limit of 1,200 requests a minute. The <a href="https://github.com/botassembly/thinkthen/blob/main/specification/records.md">records specification</a> holds the measured rates. On short records, the default of {THROTTLE.default} can pass that limit. Set <code>--jobs 3</code> to stay under it.</p>
  <p>Function-only flags: <code>--threshold</code>, <code>--true TEXT</code> and <code>--false TEXT</code> (<code>decide</code>, <code>filter</code>, <code>rank</code>), <code>--quiet</code> (<code>decide</code> and <code>choose</code>, one document only, and a usage error beside <code>--details</code>), <code>--raw</code> (<code>choose</code> only, refused under CSV and TSV), <code>--option LABEL=DESCRIPTION</code>, <code>--label LABEL=DESCRIPTION</code>, <code>--options POINTER</code> (<code>choose</code>, and it needs <code>--jsonl</code>), <code>--top N</code> (<code>rank</code>, a whole number of 1 or more), <code>--none</code> (<code>find</code>).</p>

  <h2>Framing a stream</h2>
  <p>The four framing flags are mutually exclusive. The tool never guesses a framing from a filename.</p>
  <table>
    <tr><th>Flag</th><th>One record is</th></tr>
    {FRAMING.map(([flag, what]) => (<tr><td><code>{flag}</code></td><td>{what}</td></tr>))}
  </table>
  <table>
    <tr><th>Function</th><th>What it accepts</th></tr>
    {FRAMING_BY_FN.map(([fn, what]) => (<tr><td><code>{fn}</code></td><td>{what}</td></tr>))}
  </table>

  <h3><code>--field POINTER</code></h3>
  <p>A JSON Pointer, RFC 6901. It names the part of each record the model sees. Only the pointed value leaves the machine. Under <code>--details</code> the whole record still comes back in <code>input</code>.</p>
  <ul>
    <li>Under <code>--jsonl</code>, <code>--csv</code>, or <code>--tsv</code> it reads the pointer in each record.</li>
    <li>With no framing flag it reads the whole input as one JSON value and takes the pointer inside it. There is no separate JSON framing flag.</li>
    <li>On <code>filter</code> and <code>rank</code>, a pointer with no framing flag reads JSON Lines instead. A question file's <code>on</code> does the same.</li>
    <li>Under <code>--lines</code> it is a usage error. A text line has no members.</li>
    <li>It may repeat. Several pointers build an evidence object, each member keyed by the last part of its pointer. Two members that would share one key are a usage error.</li>
    <li>A pointer that finds nothing is an input error for that record, exit 2, before any request for it.</li>
    <li><code>$.body</code>, <code>#/id</code>, a wildcard, and a negative index are refused, and the message names RFC 6901.</li>
    <li>A pointed value that is not a string is serialized as compact JSON and sent as text. With no <code>--field</code>, a JSONL, CSV, or TSV record is serialized whole.</li>
  </ul>

  <h3>CSV and TSV</h3>
  <p>Both require a header. Every cell becomes a JSON string, including an empty cell and text that looks like a number, a boolean, a null, an array, or an object. Header order becomes key order. A header name may hold whitespace, but it may not be blank, hold a control character, or exactly duplicate another. One UTF-8 byte order mark is ignored at the start of the first header name and nowhere else. Every data row must carry the header's field count. A header with no data rows is a successful empty dataset and sends no request. Empty input is exit 2. Every output from CSV or TSV input is JSONL.</p>
  <p>A record is capped at 16 MiB of encoded bytes. <code>find</code> reads at most 16 MiB of input in all. Invalid UTF-8 in a record is exit 5. An empty document is a usage error. An empty line or JSONL stream exits 0 with no output and no request.</p>

  <h2>Limits</h2>
  <p>One whole request carries at most about 64,000 tokens, the questions included. The evidence in one request must fit in about 32,000 tokens. The vendor published both numbers on 2026-09-19 for its hosted service. The <a href="https://github.com/botassembly/thinkthen/blob/main/specification/records.md">records specification</a> lists them. They belong to the backend and not to the tool.</p>
  <p>Evidence past the token limit is refused and the command exits 4. Under <code>annotate</code> the questions and the evidence count together. A long question set can pass the limit on evidence that fits on its own. Fewer questions per file is the answer.</p>

  <h2>What one row looks like</h2>
  <h3>Without <code>--details</code></h3>
  <table>
    <tr><th>Function</th><th>Standard output</th></tr>
    {BARE.map(([fn, out]) => (<tr><td><code>{fn}</code></td><td>{out}</td></tr>))}
  </table>
  <p>In record mode, a <code>decide</code>, <code>choose</code>, <code>tag</code>, or <code>score</code> row is <code>{'{"input":RECORD,"value":ANSWER}'}</code>, in that key order. <code>filter</code>, <code>rank</code>, and <code>find</code> keep returning records. Every result is compact and sits on one line.</p>
  <p><code>annotate</code> in record mode adds one top-level field per question to an object record. A line, a JSON scalar, or a JSON array keeps its parsed record under <code>input</code> and its named answers under <code>value</code>. CSV and TSV rows are objects, and they stay flat.</p>

  <h3>With <code>--details</code></h3>
  <p>One JSON object per row, with its fields in this order.</p>
  <table>
    <tr><th>Field</th><th>Holds</th></tr>
    <tr><td><code>schema</code></td><td>Always <code>"thinkthen.result/1"</code>.</td></tr>
    <tr><td><code>value</code></td><td>The bare judgment. Under <code>filter</code> it is the cut's boolean. Under <code>rank</code> it is <code>null</code>.</td></tr>
    <tr><td><code>input</code></td><td>Record mode only, between <code>value</code> and <code>question</code>. The whole original record, including the parts never sent.</td></tr>
    <tr><td><code>question</code></td><td><code>verb</code> and <code>text</code>, then <code>options</code>, <code>labels</code>, <code>levels</code>, or <code>none</code>, by the kind. <code>filter</code> and <code>rank</code> ask a <code>decide</code> question. Their <code>question.verb</code> is <code>"decide"</code>.</td></tr>
    <tr><td><code>answer</code></td><td>One of the five answer kinds below. No vendor field name appears in it.</td></tr>
    <tr><td><code>threshold</code></td><td>A number for a cut, the string <code>"LOW:HIGH"</code> for a band, and <code>null</code> when none applies. <code>decide</code> never prints <code>null</code> here.</td></tr>
    <tr><td><code>meta</code></td><td>The run, below.</td></tr>
  </table>

  <h3>The five answer kinds</h3>
  <table>
    <tr><th>Kind</th><th>From</th><th>Shape</th><th>Notes</th></tr>
    {ANSWERS.map(([kind, from, shape, note]) => (
      <tr><td><code>{kind}</code></td><td><code>{from}</code></td><td><code>{shape}</code></td><td>{note}</td></tr>
    ))}
  </table>
  <p>Every number in <code>probabilities</code> is the model's own, passed through unchanged. The tool computes one number only: the position <code>score</code> prints. It is the average of the level probabilities.</p>

  <h3><code>meta</code></h3>
  <table>
    <tr><th>Field</th><th>Holds</th></tr>
    {META.map(([field, holds]) => (<tr><td><code>{field}</code></td><td>{holds}</td></tr>))}
  </table>

  <h3><code>annotate --details</code></h3>
  <p>The top level is <code>schema</code>, <code>input</code>, <code>value</code>, <code>answers</code>, <code>meta</code>. <code>value</code> holds the named answers. Each entry under <code>answers</code> that succeeded carries <code>value</code>, <code>question</code>, <code>answer</code>, <code>threshold</code>, and <code>request</code>.</p>
  <p>A failed question is never turned into <code>null</code>. Its bare value is <code>{'{"failed":{"kind":"backend","cause":CAUSE}}'}</code>, and its detailed entry carries <code>question</code>, <code>failure</code>, and <code>request</code> and leaves out <code>value</code>, <code>answer</code>, and <code>threshold</code>. The causes are a closed list: <code>missing_answer</code>, <code>wrong_kind</code>, <code>missing_probability</code>, <code>invalid_probability</code>, <code>invalid_distribution</code>, <code>unexpected_probability</code>. <code>meta.usage</code> is the sum over the record's requests.</p>

  <h2>Exit codes</h2>
  <table>
    <tr><th>Code</th><th>What it means</th></tr>
    {EXITS.map(([code, outcome, what]) => (
      <tr><td><span class={`exit ${outcome}`}>{code}</span></td><td>{what}</td></tr>
    ))}
  </table>
  <p>Codes 7 and 8 are reserved and unused. In record mode the exit code reports the run and never one record's answer. A completed run exits 0 unless <code>annotate</code> exits 6. A valid answer on standard output can sit beside exit 1, 3, or 6.</p>

  <h2>The environment</h2>
  <table>
    <tr><th>Variable</th><th>What it does</th><th>Default</th></tr>
    {ENVS.map(([name, what, dflt]) => (
      <tr><td><code>{name}</code></td><td>{what}</td><td><code>{dflt}</code></td></tr>
    ))}
  </table>

  <h2>The cache</h2>
  <p>The cache is on by default. Ask the same question of the same evidence again and the tool reads the saved answer instead of sending a request.</p>
  <ul>
    <li>One exchange per file, named <code>DIGEST.json</code>, schema <code>thinkthen.recording/1</code>, five fields in order: <code>schema</code>, <code>adapter</code>, <code>url</code>, <code>request</code>, <code>response</code>.</li>
    <li><code>DIGEST</code> is the SHA-256, in lowercase hex, of the adapter name, a newline, the address, a newline, and the request body exactly as the adapter encoded it. The same command finds the same entry.</li>
    <li>Bodies only, never headers. No key can reach an entry. Only an exchange that succeeded and decoded is saved. A failure is never saved.</li>
    <li>The folder is <code>$XDG_CACHE_HOME/thinkthen</code>, then <code>$HOME/.cache/thinkthen</code> on Linux and <code>$HOME/Library/Caches/thinkthen</code> on macOS. <code>THINKTHEN_CACHE</code> names another one.</li>
    <li>An entry holds the evidence. A folder the tool creates is mode 0700 and each entry is 0600, whatever the umask says.</li>
    <li>The first write binds a folder to one backend through a private marker. Reusing that folder against another address fails at exit 5, before the key is read and before any request. The message names the address this run asked for, and for the default cache it names <code>--no-cache</code> and <code>THINKTHEN_CACHE</code>.</li>
    <li>An explicit <code>--record</code> or <code>--replay</code> replaces the default cache for that run.</li>
    <li><code>thinkthen cache prune DIR</code> is the only way entries are removed, and <code>DIR</code> is always explicit. <code>--older-than</code> and <code>--answered-by-other-than MODEL</code> select a union, and <code>--max-size BYTES</code> sets a target for that run. <code>MODEL</code> is the version that answered, as a result's <code>meta.model</code> shows it. Prune refuses the alias passed to <code>--model</code> and deletes nothing.</li>
    <li>Nothing trims the cache on its own. It grows, and keeps the judged text, until you run <code>cache prune</code>.</li>
  </ul>
  <p>Count-only usage totals live beside the cache, in <code>thinkthen-usage</code>. One file per UTC month holds requests sent, input tokens, output tokens, and cache answers. The files hold no request, no response, no address, no model, no price, and no key. <code>THINKTHEN_CACHE</code> never moves them and <code>--no-cache</code> never turns them off. They count what this machine saw. Your provider’s bill is the real cost.</p>
  <p><code>thinkthen status</code> is read-only and opens no connection. It reports the version, the resolved configuration and where each value came from, whether a key is present, the cache entry count and allocated bytes, and the local usage for the current UTC month and in all. <code>status --json</code> prints the same facts as one <code>thinkthen.status/1</code> object.</p>

  <h2>The configuration file</h2>
  <p>Optional, and read-only to the command. <b>The tool never creates it and never edits it.</b> There is no command that sets a value in it.</p>
  <ul>
    <li>Path: <code>$XDG_CONFIG_HOME/thinkthen/config.json</code>, then <code>$HOME/.config/thinkthen/config.json</code> on Linux and <code>$HOME/Library/Application Support/thinkthen/config.json</code> on macOS.</li>
    <li>Format: one JSON object with <code>"schema": "thinkthen.config/1"</code>.</li>
    <li>It may set <code>url</code>, <code>model</code>, <code>cache</code>, and a positive <code>{pruneKey}</code>. Any other field is refused.</li>
    <li>The default is the cache on. <code>{pruneKey}</code> defaults to {PRUNE.number} allocated bytes. It is the size <code>cache prune</code> trims to. <code>status</code> shows it as <code>cache_prune_target_bytes</code>.</li>
  </ul>
  <p>A typed list replaces a question file's whole list and never merges. The <a href="/install/settings/">settings page</a> gives the order in which values win.</p>

  <h2>Question files</h2>
  <p>A question file holds one saved question. Write <code>@FILE</code> in place of the question words. A question set for <code>annotate</code> holds many questions. The <a href="/functions/question-file/">question file page</a> carries the keys and the exit codes.</p>

  <p class="pagelinks"><a href="/learn/tutorial/">Take the tutorial</a> · <a href="/functions/">See every function</a> · <a href="/trust/">Test it before you trust it</a></p>
</Base>
