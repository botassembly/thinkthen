---
// Goal: point a reader or an agent at the one reference page that covers the function, file or tool in hand.
import SidePage from '../layouts/SidePage.astro';
import { REFERENCE_PAGES } from '../data/reference.mjs';

// The cards come from the same list as the side list, so the two never differ.
const functions = REFERENCE_PAGES.filter((p) => p.fn && !p.fn.notAFunction);
const questionFile = REFERENCE_PAGES.find((p) => p.fn?.notAFunction);
const across = REFERENCE_PAGES.filter((p) => p.group === 'Across functions');
const tools = REFERENCE_PAGES.filter((p) => p.group === 'Tools');
const ABOUT = {
  answers: 'When an answer is yes, no, not sure, or a number, and every exit code.',
  'question-sets': 'The rules a question set for annotate follows.',
  recording: 'The answer cache, recording, replay and pruning.',
  audit: 'Grade saved answers against an answer key and suggest a bar.',
  diff: 'Show which saved answers changed between two runs or two cuts.',
  check: 'Check that a backend works with this tool, over four fixed requests.',
  transform: 'List or print the built-in jq transforms.',
};
---
<SidePage pages={REFERENCE_PAGES} page={{ ...REFERENCE_PAGES[0], description: 'One reference page for each function, the question file, the pages that cover every function, and the tools.' }} name="Reference">
  <h1>Reference</h1>
  <p class="lede">Each function has one reference page. It holds the function's arguments, its own flags, the global flags, its input and output, its exit codes and its limits. Read it top to bottom, or hand it to an agent.</p>

  <h2 id="functions">The ten functions</h2>
  <div class="grid">
    {functions.map((p) => (
      <a class="tile" href={p.route}><b>{p.label}</b><span>{p.fn.line}</span></a>
    ))}
  </div>

  <h2 id="question-files">Question files</h2>
  <p>A question file holds one saved question. Write <code>@FILE</code> in place of the question words. The <a href={questionFile.route}>question file reference</a> gives its keys and exit codes.</p>

  <h2 id="across-functions">Across functions</h2>
  <div class="grid">
    {across.map((p) => (
      <a class="tile" href={p.route}><b>{p.title}</b><span>{ABOUT[p.slug]}</span></a>
    ))}
  </div>

  <h2 id="tools">Tools</h2>
  <div class="grid">
    {tools.map((p) => (
      <a class="tile" href={p.route}><b>{p.title}</b><span>{ABOUT[p.slug]}</span></a>
    ))}
  </div>

  <p class="pagelinks"><a href="/learn/tutorial/">Take the tutorial</a> · <a href="/functions/">See every function</a> · <a href="/trust/">Test it before you trust it</a></p>
</SidePage>
