---
// Goal: give one function's whole command-line reference on one page, from its arguments to its exit codes, so a reader needs no other page.
//
// Every page reads the same shared data in the same order: catalog.mjs for
// the function, flags.mjs for its flags, reference.mjs for its tables, and
// specification/ for every default and range. A section that does not apply
// to a function is left out, heading and all.
import SidePage from '../../../../layouts/SidePage.astro';
import Terminal from '../../../../components/Terminal.astro';
import Code from '../../../../components/Code.astro';
import MoreExamples from '../../../../components/MoreExamples.astro';
import AnnotateEdges from '../../../../components/AnnotateEdges.astro';
import { FUNCTIONS, HOWTOS } from '../../../../data/catalog.mjs';
import { GLOBAL_FLAGS, flagsOf, namesOf } from '../../../../data/flags.mjs';
import {
  REFERENCE_PAGES, ARGUMENTS, THRESHOLDS, CUT, DEFAULT_CUT, FRAMING, FRAMING_DEFAULT,
  BARE, RECORD, LIMITS, SIGNALS, RUN_RULE,
} from '../../../../data/reference.mjs';
import { examplesOf } from '../../../../data/fn-examples.mjs';
import { inlineHtml, setting } from '../../../../lib/settings-table.mjs';
import { backends } from '../../../../lib/backends-table.mjs';

export function getStaticPaths() {
  return FUNCTIONS.map((fn) => ({ params: { name: fn.name }, props: { fn } }));
}

const { fn } = Astro.props;
const name = fn.name;
const title = fn.title || name;
const page = REFERENCE_PAGES.find((p) => p.fn === fn);
const isFn = !fn.notAFunction;
const { first, openingInputs } = examplesOf(fn);
const howtos = HOWTOS.filter((h) => fn.howtos.includes(h.slug));
const own = flagsOf(fn);
const names = new Set([...own, ...GLOBAL_FLAGS].flatMap((f) => namesOf(f.spec)));
const framings = Object.keys(FRAMING).filter((f) => names.has(f));
const cut = THRESHOLDS[name];
// A question set holds its thresholds as keys. The other functions take the flag.
const thr = name === 'annotate' ? '"threshold":' : '--threshold';
const oneDocument = isFn && !['filter', 'rank', 'find', 'relate'].includes(name);
const THROTTLE = setting('Throttle');
// A default shows as code when it is one value, and as prose when it is words.
const valueHtml = (text) => (/\s/.test(String(text)) ? inlineHtml(String(text)) : `<code>${inlineHtml(String(text))}</code>`);
// Each argument in the signature is code. The words between stay prose.
const signature = fn.args.split(/( or |, then )/).map((part, i) => ({ code: i % 2 === 0, part }));
// A function's own codes, then the signal codes every function shares.
const exits = isFn ? [...fn.exits, [SIGNALS.code, SIGNALS.what]] : fn.exits;
const exitClass = (code) => (code === 0 ? 'yes' : code === 1 ? 'no' : code === 3 ? 'unsure' : 'broken');
const jobsScope = name === 'annotate'
  ? 'It also acts on one document, where the questions can make several requests.'
  : name === 'relate'
    ? 'It acts on the one set of names, where each relation makes its own requests.'
    : 'It acts in record mode. On one document it is a usage error.';
const description = isFn
  ? `Every argument, flag, default, input rule, output shape and exit code of ${name}.`
  : 'Every key and exit code of a question file.';
---
<SidePage pages={REFERENCE_PAGES} page={{ ...page, description }} name="Reference">
  <h1><code>{title}</code> reference</h1>
  {fn.lede ? (
    <p class="lede" set:html={fn.lede} />
  ) : (
    <p class="lede">{fn.line} You give it {fn.takes}. You get back {fn.gives}.</p>
  )}
  {isFn && <p>{fn.requests}</p>}
  {openingInputs.map((file) => <Code code={file.text} file={file.name} caption={`${file.name}, a file the examples read`} />)}
  {first && <Terminal run={first} caption={first.see} />}

  <h2 id="arguments">Arguments</h2>
  <p>The command takes {signature.map((x) => x.code ? <code>{x.part}</code> : x.part)}.</p>
  {ARGUMENTS[name] ? <p set:html={inlineHtml(ARGUMENTS[name])} /> : fn.argsNote && <p set:html={inlineHtml(fn.argsNote)} />}
  {name === 'annotate' && <p>The <a href="/reference/question-sets/">question set rules</a> give every key.</p>}

  {own.length > 0 && (
    <>
      <h2 id="flags">{isFn ? 'Its own flags' : 'Its keys'}</h2>
      {isFn ? (
        <table class="flags">
          <tr><th>Flag</th><th>Takes</th><th>Default</th><th>What it does</th></tr>
          {own.map((f) => (
            <tr><td>{f.spec.split(', ').map((opt, i) => <>{i > 0 && ', '}<code>{opt}</code></>)}</td><td set:html={inlineHtml(f.takes)} /><td set:html={valueHtml(f.default)} /><td set:html={inlineHtml(f.what)} /></tr>
          ))}
        </table>
      ) : (
        <table>
          <tr><th>Key</th><th>What it holds</th></tr>
          {own.map((f) => (
            <tr><td>{f.spec.split(', ').map((opt, i) => <>{i > 0 && ', '}<code>{opt}</code></>)}</td><td set:html={inlineHtml(f.what)} /></tr>
          ))}
        </table>
      )}
      {names.has('--jobs') && (
        <p id="jobs"><code>--jobs N</code> runs from {THROTTLE.range.min} to {THROTTLE.range.max} and defaults to {THROTTLE.default}. {jobsScope} TypeSafe documents a limit of 1,200 requests a minute. The <a href="https://github.com/botassembly/thinkthen/blob/main/specification/records.md">records specification</a> holds the measured rates. <code>--jobs</code> caps the requests in flight. It sets no limit on requests a minute. The rate depends on how fast replies come back. On short records, the default of {THROTTLE.default} can pass that limit. In a <a href="https://github.com/botassembly/thinkthen/blob/main/sdlc/issues/closed/2026-09-26-architect-review-07-throughput-limits-cost.md">review</a>, the default sent 1,519 requests a minute to TypeSafe. Against a local test server with 100 ms replies, <code>--jobs 3</code> sent 1,285 a minute. Set <code>requests_per_minute</code> on the backend, or <code>THINKTHEN_REQUESTS_PER_MINUTE</code>, to stay under the limit.</p>
      )}
    </>
  )}

  {isFn && (
    <>
      <h2 id="global-flags">Global flags</h2>
      <p>Every function takes these flags. The <a href="/install/settings/">settings page</a> lists every setting on every surface, with the order in which values win.</p>
      <table class="flags">
        <tr><th>Flag</th><th>Takes</th><th>Default</th><th>What it does</th></tr>
        {GLOBAL_FLAGS.map((f) => (
          <tr><td><code>{f.spec}</code></td><td set:html={inlineHtml(f.takes)} /><td set:html={valueHtml(f.default)} /><td set:html={inlineHtml(f.what)} /></tr>
        ))}
      </table>
    </>
  )}

  {cut && (
    <>
      <h2 id="thresholds">Thresholds</h2>
      <p set:html={inlineHtml(cut.rule)} />
      <p>{cut.dflt === 'none' ? 'There is no default cut. ' : cut.dflt !== 'per question' && <>The default is <code>{cut.dflt}</code>. </>}<code>{thr} T</code> takes a number above {CUT.above} and at most {CUT.atMost}. A value at or above T passes, and a value under T fails.</p>
      {cut.band && (
        <>
          <p>A band, written <code>LOW:HIGH</code>, adds a middle answer. With p as the probability of yes:</p>
          <table>
            <tr><th>Form</th><th>Accepted</th><th>Yes</th><th>No</th><th>Not sure</th></tr>
            <tr><td>none given</td><td></td><td>p ≥ {DEFAULT_CUT}</td><td>p &lt; {DEFAULT_CUT}</td><td>never</td></tr>
            <tr><td><code>{thr} T</code></td><td>{CUT.above} &lt; T ≤ {CUT.atMost}</td><td>p ≥ T</td><td>p &lt; T</td><td>never</td></tr>
            <tr><td><code>{thr} LOW:HIGH</code></td><td>{CUT.above} ≤ LOW &lt; HIGH ≤ {CUT.atMost}</td><td>p ≥ HIGH</td><td>p &lt; LOW</td><td>LOW ≤ p &lt; HIGH</td></tr>
          </table>
          <p>The high side is inclusive. A probability exactly at <code>LOW</code> is not sure. A band low of 0 is accepted. <code>{thr} {DEFAULT_CUT}</code> and no threshold name the same rule.</p>
        </>
      )}
      <p>A cut of 0 is refused. {cut.band ? 'A percent such as 90, a reversed band, an empty side, and a number that is not finite are all usage errors before any request.' : 'A percent such as 90, a band, and a number that is not finite are all usage errors before any request.'}</p>
      <p>The cut applies to the probability of yes on <code>decide</code> and each record under <code>filter</code>, the winning option’s probability on <code>choose</code>, each label’s independent yes probability under <code>tag</code>, each name’s printed strength under <code>recognize</code>, and each relation edge’s yes probability under <code>recognize</code> or <code>relate</code>. The <a href="https://github.com/botassembly/thinkthen/blob/main/specification/threshold.md">threshold contract</a> defines every boundary.</p>
    </>
  )}

  {isFn && (
    <>
      <h2 id="input">Input</h2>
      <p set:html={inlineHtml(FRAMING_DEFAULT[name])} />
      <table>
        <tr><th>Flag</th><th>One record is</th></tr>
        {framings.map((f) => <tr><td><code>{f}</code></td><td>{FRAMING[f]}</td></tr>)}
      </table>
      <p>The framing flags are mutually exclusive. The tool never guesses a framing from a filename. <code>--input FILE</code> reads the same input from a file. An empty document is a usage error. An empty line or JSONL stream exits 0 with no output and no request. Invalid UTF-8 in a record is exit 5.</p>

      <h3 id="field"><code>--field POINTER</code></h3>
      {name === 'relate' ? (
        <p><code>--field</code> names the pointer to each entity's name, and <code>--kind-field</code> the pointer to its kind. They default to <code>/name</code> and <code>/kind</code>. Each value must be a string that is not blank. A name that <code>recognize</code> found carries <code>text</code> in place of <code>name</code>, and <code>relate</code> reads it. Under <code>--lines</code> neither pointer applies.</p>
      ) : (
        <>
          <p>A JSON Pointer, RFC 6901. It names the part of each record the model sees. Only the pointed value leaves the machine.</p>
          <ul>
            <li>Under {framings.filter((f) => f !== '--lines').map((f, i, all) => <>{i > 0 && (i === all.length - 1 ? ', or ' : ', ')}<code>{f}</code></>)} it reads the pointer in each record.</li>
            {oneDocument && <li>With no framing flag it reads the whole input as one JSON value and takes the pointer inside it. There is no separate JSON framing flag.</li>}
            {(name === 'filter' || name === 'rank') && <li>A pointer with no framing flag reads JSON Lines. A question file's <code>on</code> does the same.</li>}
            <li>Under <code>--lines</code> it is a usage error. A text line has no members.</li>
            <li>It may repeat. Several pointers build an evidence object, each member keyed by the last part of its pointer. Two members that would share one key are a usage error.</li>
            <li>A pointer that finds nothing is an input error for that record, exit 2, before any request for it.</li>
            <li><code>$.body</code>, <code>#/id</code>, a wildcard, and a negative index are refused, and the message names RFC 6901.</li>
            <li>A pointed value that is not a string is serialized as compact JSON and sent as text. With no <code>--field</code>, a JSON record is serialized whole.</li>
          </ul>
        </>
      )}

      {names.has('--csv') && (
        <>
          <h3 id="csv-and-tsv">CSV and TSV</h3>
          <p>Both require a header. Every cell becomes a JSON string, including an empty cell and text that looks like a number, a boolean, a null, an array, or an object. Header order becomes key order. A header name may hold whitespace, but it may not be blank, hold a control character, or exactly duplicate another. One UTF-8 byte order mark is ignored at the start of the first header name and nowhere else. Every data row must carry the header's field count. A header with no data rows is a successful empty dataset and sends no request. Empty input is exit 2. Every output from CSV or TSV input is JSON Lines.</p>
        </>
      )}
    </>
  )}

  {isFn && (
    <>
      <h2 id="output">Output</h2>
      <p set:html={inlineHtml(BARE[name])} />
      <p set:html={inlineHtml(RECORD[name])} />
      <p>Every result is compact and sits on one line. <code>--details</code> prints the full result object in place of the bare value. The <a href="https://github.com/botassembly/thinkthen/blob/main/specification/result.md">result specification</a> lists its fields.</p>
      <p>{fn.unsure}</p>
    </>
  )}

  {name === 'annotate' && <AnnotateEdges />}

  <h2 id="exit-codes">Exit codes</h2>
  <table>
    <tr><th>Code</th><th>What it means</th></tr>
    {exits.map(([code, what]) => (
      <tr><td><span class={`exit ${exitClass(code)}`}>{code}</span></td><td>{what}</td></tr>
    ))}
  </table>
  {isFn && <p>{RUN_RULE} A completed run exits 0 unless a code above says otherwise. A valid answer on standard output can sit beside a code other than 0. <a href="/reference/answers/#exit-codes">Every exit code</a> lists the codes of all the functions.</p>}

  {isFn && (
    <>
      <h2 id="backend">Backend and environment</h2>
      <p>With no backend named, the key comes from <code>THINKTHEN_API_KEY</code>. <code>--backend</code>, <code>THINKTHEN_BACKEND</code> or the configuration file's <code>backend</code> names a backend. A named backend reads only its own key variables, and the first one that is not blank wins:</p>
      <ul>
        {backends().map((b) => (
          <li><code>{b.name}</code> reads {b.keys.map((k, i) => <>{i > 0 && ', then '}<code>{k}</code></>)}.</li>
        ))}
      </ul>
      <p>The command line comes first, then the environment, then the configuration file. The first of these that names a backend or an address decides. So <code>THINKTHEN_BASE_URL</code> in the shell outranks the configuration file's <code>backend</code>, and the key then comes from <code>THINKTHEN_API_KEY</code>. With both <code>--backend</code> and <code>--url</code>, the backend's key variables apply at that address.</p>
      <p>With the key unset or blank, a request to <code>localhost</code>, <code>127.0.0.1</code> or <code>[::1]</code> goes out with no key and no <code>Authorization</code> header. At any other address, the command exits 4. The <a href="/install/configuration/#environment">Configuration page</a> lists every variable ThinkThen reads, and the <a href="/install/backends/">Backends page</a> gives the rest of the key rules.</p>
    </>
  )}

  {isFn && (
    <>
      <h2 id="limits">Limits</h2>
      <ul>
        {LIMITS[name].map((limit) => <li set:html={inlineHtml(limit)} />)}
      </ul>
      <p>One whole request carries at most about 64,000 tokens, the questions included. The evidence in one request must fit in about 32,000 tokens. TypeSafe published both numbers on 2026-09-19 for its hosted service. They belong to the backend and not to the tool. Evidence past the token limit is refused, and the command exits 4. The <a href="https://github.com/botassembly/thinkthen/blob/main/specification/records.md">records specification</a> lists them.</p>
    </>
  )}

  <h2 id="read-more">Read more</h2>
  <ul>
    <li>The <a href={`/functions/${name}/`}><code>{title}</code> page</a> opens with one plain call in every language.</li>
    {howtos.length > 0 && <li>These how-tos use <code>{title}</code> for a real job: {howtos.map((h, i) => <>{i > 0 && (i === howtos.length - 1 ? ' and ' : ', ')}<a href={`/how-tos/${h.slug}/`}>{h.title}</a></>)}.</li>}
    <li><a href="/reference/answers/">How answers work</a> says when an answer is yes, no, not sure, or a number.</li>
    <li>The <a href="/install/settings/">settings page</a> gives every setting on every surface, with its default.</li>
    <li><a href="/reference/recording/">Recording and the answer cache</a> covers the answer cache, recording, replay and pruning.</li>
    <li>The <a href="/install/configuration/#configuration-file">configuration file</a> names the default backend, address and model.</li>
    {isFn ? <li>A <a href="/reference/functions/question-file/">question file</a> saves one question with its threshold.</li> : <li><a href="/reference/question-sets/">Question sets</a> hold many questions for <code>annotate</code>.</li>}
    {name === 'annotate' && <li><a href="/reference/question-sets/">Question sets</a> give the rules a question set follows.</li>}
  </ul>

  <MoreExamples fn={fn} level="h2" />
</SidePage>
