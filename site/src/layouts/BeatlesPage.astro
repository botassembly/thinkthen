---
// One page of the Beatles Bench section under Learn, in talk order.
import SidePage from './SidePage.astro';
import { PAGES, REPO } from '../data/beatles.mjs';
import { slideCard } from '../data/cards.mjs';

const { page } = Astro.props;
const card = slideCard(page.slug || 'beatles-bench');
if (!card) throw new Error(`beatles: ${page.route} has no slide in slides.json`);
---
<SidePage pages={PAGES} page={page} name="Beatles Bench pages" repo={page.link || REPO} image={card.image} imageAlt={card.alt}><slot /></SidePage>
