---
import '../styles/site.css';
import { NOINDEX, REPO } from '../data/catalog.mjs';
import { DEFAULT_CARD, routeCard } from '../data/cards.mjs';
import { ORGANIZATION_LD, PERSON_LD } from '../data/about.mjs';
import SiteFooter from '../components/SiteFooter.astro';

// `repo` is the one GitHub link a page carries, at its bottom. `image` and
// `imageAlt` name the page's social card. A page without one takes the card
// cards.mjs gives its route, or the ThinkThen card. `noindex` marks a page
// that is never listed: the 404 and search pages. Such a page carries the
// robots tag, no canonical link, no Markdown twin and no search index mark.
// `structured` holds a page's own schema.org nodes, as the About page does.
// `reading` sets the page in the reading column: an article or a how-to.
const { title, description = 'Simple functions that give your software the judgment to handle whatever comes its way. Call them from your scripts, your programs, and your queries.', repo = REPO, image, imageAlt, noindex = false, structured, reading = false } = Astro.props;
const full = title === 'ThinkThen' ? 'ThinkThen: code that knows what you mean' : `${title} — ThinkThen`;
const here = Astro.url.pathname;
const mdHref = here === '/' ? '/index.md' : here.replace(/\/$/, '') + '.md';
const card = image ? { image, alt: imageAlt || title } : routeCard(here) || DEFAULT_CARD;
const cardImage = new URL(card.image, Astro.site).href;
const pageUrl = new URL(here, Astro.site).href;
const home = here === '/';
// The home page tells search engines what the site and the software are,
// and who makes it.
const jsonLd = structured ? JSON.stringify(structured) : home && JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ThinkThen',
    url: `${Astro.site.origin}/`,
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${Astro.site.origin}/search/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ThinkThen',
    description,
    url: `${Astro.site.origin}/`,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@id': PERSON_LD['@id'] },
    publisher: { '@id': ORGANIZATION_LD['@id'] },
  },
  { '@context': 'https://schema.org', ...ORGANIZATION_LD },
  { '@context': 'https://schema.org', ...PERSON_LD },
]);
const nav = [
  ['/install/', 'Install'],
  ['/functions/', 'Functions'],
  ['/how-tos/', 'How-tos'],
  ['/learn/', 'Learn'],
  ['/blog/', 'Blog'],
];
---
<!DOCTYPE html>
<html lang="en" data-unlisted={noindex ? '' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{full}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="ThinkThen">
<meta property="og:url" content={pageUrl}>
<meta property="og:title" content={full}>
<meta property="og:description" content={description}>
<meta property="og:image" content={cardImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={card.alt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={full}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={cardImage}>
<meta name="twitter:image:alt" content={card.alt}>
{(NOINDEX || noindex) && <meta name="robots" content="noindex">}
{!noindex && <link rel="canonical" href={pageUrl}>}
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/brand/thinkthen-mark-dark.svg" type="image/svg+xml">
<link rel="icon" href="/brand/thinkthen-mark-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/brand/thinkthen-mark-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#faf8f1" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1311" media="(prefers-color-scheme: dark)">
{!noindex && <link rel="alternate" type="text/markdown" href={mdHref}>}
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
<script is:inline>
  // The theme and the language choice are set before the page draws, so
  // nothing flashes.
  try {
    var t = localStorage.getItem('tt-theme');
    if (t) document.documentElement.setAttribute('data-theme', t);
    var l = localStorage.getItem('tt-lang');
    if (l) document.documentElement.setAttribute('data-lang', l);
  } catch (e) {}
</script>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a href="/" aria-label="ThinkThen home">
      <img src="/brand/thinkthen-wordmark-dark.svg" alt="ThinkThen" class="on-dark" width="5300" height="966">
      <img src="/brand/thinkthen-wordmark-light.svg" alt="" aria-hidden="true" class="on-light" width="5300" height="966">
    </a>
    <nav>
      {nav.map(([href, label]) => (
        <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <span class="spacer"></span>
    <form class="search" action="/search/" method="get" role="search">
      <label for="site-search" class="sr-only">Search the site</label>
      <input id="site-search" type="search" name="q" placeholder="Search" autocomplete="off" enterkeyhint="search">
      <button type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </form>
    <script is:inline>
      // "/" jumps to the search field, unless the reader is already typing.
      document.addEventListener('keydown', function (e) {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        var t = e.target;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        e.preventDefault();
        document.getElementById('site-search').focus();
      });
    </script>
    <button class="theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Switch between light and dark theme">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>

<p id="copy-said" class="sr-only" aria-live="polite"></p>
<main data-pagefind-body={noindex ? undefined : ''}><div class={reading ? 'wrap reading' : 'wrap'}><slot /><p class="repo-link">On GitHub: <a href={repo}>{repo.replace('https://', '')}</a></p></div></main>

<SiteFooter mdHref={noindex ? null : mdHref} />

<script is:inline>
(function () {
  var root = document.documentElement;

  function lightNow() {
    var forced = root.getAttribute('data-theme');
    if (forced) return forced === 'light';
    return window.matchMedia('(prefers-color-scheme: light)').matches;
  }
  document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
    b.addEventListener('click', function () {
      var next = lightNow() ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('tt-theme', next); } catch (e) {}
    });
  });

  // One language for the whole visit. Every tabbed block follows it.
  function tabsIn(group) {
    return Array.prototype.slice.call(group.querySelectorAll(':scope > .tabs button'));
  }
  // A group that has no tab for the chosen language falls back to the same
  // family: Polars answers for Python, DuckDB for SQL.
  function show(group, lang, family) {
    var buttons = tabsIn(group);
    var pick = null;
    buttons.forEach(function (b) { if (!pick && b.dataset.lang === lang) pick = b.dataset.lang; });
    if (!pick) buttons.forEach(function (b) { if (!pick && b.dataset.alias === family) pick = b.dataset.lang; });
    if (!pick) pick = group.dataset.fallback || (buttons[0] && buttons[0].dataset.lang);
    buttons.forEach(function (b) { b.setAttribute('aria-selected', String(b.dataset.lang === pick)); });
    group.querySelectorAll(':scope > .cell').forEach(function (c) { c.hidden = c.dataset.lang !== pick; });
  }
  function showAll(lang, family) {
    document.querySelectorAll('.tabbed').forEach(function (g) { show(g, lang, family); });
  }
  var current = 'Bash', family = 'Bash';
  try {
    current = localStorage.getItem('tt-lang') || 'Bash';
    family = localStorage.getItem('tt-lang-family') || current;
  } catch (e) {}
  showAll(current, family);
  document.querySelectorAll('.tabbed').forEach(function (group) {
    tabsIn(group).forEach(function (b) {
      b.addEventListener('click', function () {
        current = b.dataset.lang;
        family = b.dataset.alias || current;
        try {
          localStorage.setItem('tt-lang', current);
          localStorage.setItem('tt-lang-family', family);
        } catch (e) {}
        showAll(current, family);
      });
    });
  });

  // Copy the exact runnable text. When the browser cannot copy, say so and
  // select the same text, so the reader can copy it by hand. A screen
  // reader hears both outcomes through the one live region.
  var said = document.getElementById('copy-said');
  function tell(b, word, keep) {
    var was = b.dataset.was || b.textContent;
    b.dataset.was = was;
    b.textContent = word;
    said.textContent = '';
    setTimeout(function () { said.textContent = keep; }, 50);
    clearTimeout(b.timer);
    b.timer = setTimeout(function () { b.textContent = was; }, 2000);
  }
  function selectCopy(pre) {
    var range = document.createRange();
    range.selectNodeContents(pre.querySelector('[data-copy-range]') || pre.querySelector('code') || pre);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
  document.querySelectorAll('button.copy').forEach(function (b) {
    b.addEventListener('click', function () {
      var pre = b.closest('.block').querySelector('pre');
      var text = pre.dataset.copy;
      function failed() {
        selectCopy(pre);
        tell(b, 'Copy failed', 'Copy failed. The text is selected. Press Control C or Command C to copy it.');
      }
      if (!navigator.clipboard || !navigator.clipboard.writeText) { failed(); return; }
      navigator.clipboard.writeText(text).then(function () { tell(b, 'Copied', 'Copied'); }, failed);
    });
  });
})();
</script>
</body>
</html>
