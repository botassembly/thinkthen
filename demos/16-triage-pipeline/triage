#!/usr/bin/env bash
set -euo pipefail

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if (($# < 1)); then
	printf '%s\n' 'usage: triage OUTPUT_DIRECTORY [thinkthen backend options]' >&2
	exit 2
fi

output=$1
shift
parent=$(dirname -- "$output")
if [[ ! -d $parent ]]; then
	printf '%s\n' 'triage: the output parent is not a directory' >&2
	exit 2
fi
if ! mkdir -- "$output" 2>/dev/null; then
	printf '%s\n' 'triage: the output directory already exists' >&2
	exit 2
fi

cleanup() {
	status=$?
	trap - EXIT HUP INT TERM
	rm -rf -- "$output"
	exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
tmp=$(mktemp -d "$output/.staging.XXXXXX")

thinkthen annotate "$HERE/questions.json" --tsv --details --jobs 4 \
	--input "$HERE/tickets.tsv" --max-retries 0 "$@" \
	| jq -c -f "$HERE/../../transforms/triage/triage.jq" > "$tmp/all.jsonl"

for action in draft block review; do
	jq -c --arg action "$action" \
		'select(.policy.action == $action)' "$tmp/all.jsonl" \
		> "$tmp/$action.jsonl"
done
rm -- "$tmp/all.jsonl"
for action in draft block review; do
	mv -- "$tmp/$action.jsonl" "$output/$action.jsonl"
done
rmdir -- "$tmp"
trap - EXIT HUP INT TERM
