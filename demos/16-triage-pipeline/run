#!/bin/sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT HUP INT TERM

"$HERE/triage" "$work/output" "$@"
jq -s -r 'sort_by(.input.id)[]
  | [.input.id, .input.subject, .policy.action, .policy.reason]
  | @tsv' "$work/output"/*.jsonl
for action in draft block review; do
	printf '%s=' "$action"
	wc -l < "$work/output/$action.jsonl" | tr -d ' '
done
total=$(jq -s 'length' "$work/output"/*.jsonl)
agreement=$(jq -s '[.[] | select(.policy.action == .input.reviewed_action)] | length' \
	"$work/output"/*.jsonl)
printf 'agreement=%s/%s\n' "$agreement" "$total"
