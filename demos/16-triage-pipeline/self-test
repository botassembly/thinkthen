#!/usr/bin/env bash
set -euo pipefail

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REAL_JQ=$(command -v jq)
REAL_MV=$(command -v mv)
. "$HERE/../../sdlc/scripts/scratch.sh"
# A returned path is not proof that mktemp created it. Refuse even an empty PWD.
plant=$(mktemp -d)
plant=$(cd -- "$plant" && pwd -P)
set +e
(
	cd -- "$plant"
	mktemp() { printf '%s\n' "$PWD"; }
	scratch_dir refused
) 2> "$plant.err"
plant_status=$?
set -e
test "$plant_status" = 1
grep -F "scratch.sh: refusing $plant" "$plant.err" >/dev/null
test -d "$plant"
rm -- "$plant.err"
rmdir -- "$plant"
scratch_dir work
child=
cleanup() {
	if [[ -n $child ]] && kill -0 "$child" 2>/dev/null; then
		kill "$child" 2>/dev/null || :
		wait "$child" 2>/dev/null || :
	fi
	scratch_clean
}
trap cleanup EXIT HUP INT TERM
mkdir "$work/bin" "$work/out-parent"

cat > "$work/bin/thinkthen" <<'SH'
#!/bin/sh
set -eu
expected="annotate $TRIAGE_HERE/questions.json --tsv --details --jobs 4 --input $TRIAGE_HERE/tickets.tsv --max-retries 0 --replay fixture"
test "$*" = "$expected" || {
	printf 'fake thinkthen: unexpected arguments\nexpected: %s\nactual:   %s\n' "$expected" "$*" >&2
	exit 64
}
printf '%s\n' called >> "$TRIAGE_CALL_LOG"
case ${TRIAGE_FAKE_MODE:-answer} in
	fail) exit 67 ;;
	malformed)
		printf '%s\n' '{"value":{"credential_request":false,"queue":"billing","urgency":0,"surprise":true}}'
		exit 0
		;;
	wait)
		: > "$TRIAGE_ENTERED"
		while test ! -e "$TRIAGE_RELEASE"; do sleep 0.01; done
		;;
esac
cat "$TRIAGE_HERE/fake-rows.jsonl"
SH

cat > "$work/bin/jq" <<'SH'
#!/bin/sh
set -eu
case " $* " in
	*" -f $TRIAGE_HERE/../../transforms/triage/triage.jq "*)
		printf '%s\n' policy >> "$TRIAGE_POLICY_LOG"
		;;
esac
exec "$REAL_JQ" "$@"
SH

cat > "$work/bin/mv" <<'SH'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$TRIAGE_MOVE_LOG"
count=$(wc -l < "$TRIAGE_MOVE_LOG" | tr -d ' ')
if test "${TRIAGE_FAIL_MOVE:-}" = "$count"; then
	exit $((70 + count))
fi
exec "$REAL_MV" "$@"
SH
chmod +x "$work/bin/thinkthen" "$work/bin/jq" "$work/bin/mv"
export PATH="$work/bin:$PATH"
export TRIAGE_HERE="$HERE" REAL_JQ REAL_MV
export TRIAGE_CALL_LOG="$work/calls.log" TRIAGE_POLICY_LOG="$work/policy.log"
export TRIAGE_MOVE_LOG="$work/moves.log"
: > "$TRIAGE_CALL_LOG"
: > "$TRIAGE_POLICY_LOG"
: > "$TRIAGE_MOVE_LOG"

wait_for() {
	path=$1
	for _ in $(seq 1 3000); do
		test -e "$path" && return 0
		sleep 0.01
	done
	printf 'triage self-test: timed out waiting for %s\n' "$path" >&2
	return 1
}

output="$work/out-parent/result"
"$HERE/triage" "$output" --replay fixture

test "$(wc -l < "$TRIAGE_POLICY_LOG" | tr -d ' ')" = 1
test "$(wc -l < "$TRIAGE_MOVE_LOG" | tr -d ' ')" = 3
test "$(find "$output" -mindepth 1 -maxdepth 1 -exec basename {} \; | sort)" = "block.jsonl
draft.jsonl
review.jsonl"
test "$(wc -l < "$output/draft.jsonl" | tr -d ' ')" = 2
test "$(wc -l < "$output/block.jsonl" | tr -d ' ')" = 1
test "$(wc -l < "$output/review.jsonl" | tr -d ' ')" = 3
jq -e -s 'length == 6 and all(.[]; has("schema") and has("input") and has("value") and has("answers") and has("meta") and has("policy"))' \
	"$output"/*.jsonl >/dev/null
jq -e -s 'all(.[]; .policy.action == .input.reviewed_action)' "$output"/*.jsonl >/dev/null

real_thinkthen="$HERE/../../target/debug/thinkthen"
test -x "$real_thinkthen"
"$real_thinkthen" annotate "$HERE/questions.json" --tsv --details --jobs 4 \
	--input "$HERE/tickets.tsv" --max-retries 0 --plan > "$work/dry-run.jsonl"
test "$(wc -l < "$work/dry-run.jsonl" | tr -d ' ')" = 2
if grep -E 'reviewed_action|SUP-1042|Duplicate renewal' "$work/dry-run.jsonl" >/dev/null; then
	printf '%s\n' 'triage self-test: a local field entered the request' >&2
	exit 1
fi
test "$("$HERE/run" --replay fixture)" = "SUP-1042	Duplicate renewal charge	draft	routine
SUP-1043	Package needed for a flight	review	urgent
SUP-1044	Locked out after changing phones	block	credential_request
SUP-1045	Request for a product integration	review	out_of_scope
SUP-1046	Delivery address may be wrong	review	unsure
SUP-1047	Remove an old shipping address	draft	routine
draft=2
block=1
review=3
agreement=6/6"

calls=$(wc -l < "$TRIAGE_CALL_LOG" | tr -d ' ')
touch "$work/out-parent/existing-file"
mkdir "$work/out-parent/existing-directory"
ln -s nowhere "$work/out-parent/existing-symlink"
for existing in existing-file existing-directory existing-symlink; do
	if "$HERE/triage" "$work/out-parent/$existing" --replay fixture \
		> "$work/$existing.out" 2> "$work/$existing.err"; then
		printf 'triage self-test: %s destination succeeded\n' "$existing" >&2
		exit 1
	fi
	test ! -s "$work/$existing.out"
	grep -Fx 'triage: the output directory already exists' "$work/$existing.err" >/dev/null
done
test "$(wc -l < "$TRIAGE_CALL_LOG" | tr -d ' ')" = "$calls"

race="$work/out-parent/race"
export TRIAGE_FAKE_MODE=wait TRIAGE_ENTERED="$work/race-entered" TRIAGE_RELEASE="$work/race-release"
"$HERE/triage" "$race" --replay fixture > "$work/race-owner.out" 2> "$work/race-owner.err" &
child=$!
wait_for "$TRIAGE_ENTERED"
test -d "$race"
if "$HERE/triage" "$race" --replay fixture > "$work/race-loser.out" 2> "$work/race-loser.err"; then
	printf '%s\n' 'triage self-test: the reservation loser succeeded' >&2
	exit 1
fi
grep -Fx 'triage: the output directory already exists' "$work/race-loser.err" >/dev/null
test "$(wc -l < "$TRIAGE_CALL_LOG" | tr -d ' ')" = "$((calls + 1))"
touch "$TRIAGE_RELEASE"
wait "$child"
child=
unset TRIAGE_FAKE_MODE TRIAGE_ENTERED TRIAGE_RELEASE

expect_failure() {
	name=$1
	expected=$2
	failed="$work/out-parent/$name"
	set +e
	"$HERE/triage" "$failed" --replay fixture > "$work/$name.out" 2> "$work/$name.err"
	rc=$?
	set -e
	test "$rc" = "$expected"
	test ! -e "$failed"
}

export TRIAGE_FAKE_MODE=fail
expect_failure judgment 67
unset TRIAGE_FAKE_MODE

export TRIAGE_FAKE_MODE=malformed
expect_failure validation 5
unset TRIAGE_FAKE_MODE

for move in 1 2 3; do
	: > "$TRIAGE_MOVE_LOG"
	export TRIAGE_FAIL_MOVE=$move
	expect_failure "move-$move" "$((70 + move))"
done
unset TRIAGE_FAIL_MOVE

signal="$work/out-parent/signal"
export TRIAGE_FAKE_MODE=wait TRIAGE_ENTERED="$work/signal-entered" TRIAGE_RELEASE="$work/signal-release"
"$HERE/triage" "$signal" --replay fixture > "$work/signal.out" 2> "$work/signal.err" &
child=$!
wait_for "$TRIAGE_ENTERED"
kill -TERM "$child"
touch "$TRIAGE_RELEASE"
set +e
wait "$child"
rc=$?
set -e
child=
test "$rc" = 143
test ! -e "$signal"
unset TRIAGE_FAKE_MODE TRIAGE_ENTERED TRIAGE_RELEASE

mkdir "$work/review-bin"
cat > "$work/review-bin/thinkthen" <<'SH'
#!/bin/sh
set -eu
case ${REVIEW_MODE:-replay} in
	fail) exit 67 ;;
	wait)
		: > "$REVIEW_ENTERED"
		while test ! -e "$REVIEW_RELEASE"; do sleep 0.01; done
		;;
esac
exec "$REVIEW_REAL" "$@"
SH
chmod +x "$work/review-bin/thinkthen"
export PATH="$work/review-bin:$PATH" REVIEW_REAL="$real_thinkthen"
review="$work/out-parent/review-route"
"$HERE/review-jsonl" "$review"
test "$(find "$review" -mindepth 1 -maxdepth 1 -exec basename {} \; | sort)" = "decisions.jsonl
review.jsonl"
test "$(wc -l < "$review/decisions.jsonl" | tr -d ' ')" = 5
test "$(wc -l < "$review/review.jsonl" | tr -d ' ')" = 1
jq -e -s 'length == 5 and all(.[]; .schema == "thinkthen.result/1" and has("policy"))' \
	"$review/decisions.jsonl" >/dev/null
jq -e -s 'length == 1 and .[0].schema == "thinkthen.record-error/1" and
  .[0].policy == {action:"review",reason:"record_error"}' "$review/review.jsonl" >/dev/null
mkdir "$work/out-parent/with space"
"$HERE/review-jsonl" "$work/out-parent/with space/review result"
test "$(wc -l < "$work/out-parent/with space/review result/decisions.jsonl" | tr -d ' ')" = 5
test "$(wc -l < "$work/out-parent/with space/review result/review.jsonl" | tr -d ' ')" = 1

printf '%s' caller-data > "$work/out-parent/caller-file"
mkdir "$work/out-parent/caller-directory"
printf '%s' caller-data > "$work/out-parent/caller-directory/keep"
ln -s caller-directory "$work/out-parent/caller-symlink"
for existing in caller-file caller-directory caller-symlink; do
	set +e
	"$HERE/review-jsonl" "$work/out-parent/$existing" > "$work/$existing.review.out" 2> "$work/$existing.review.err"
	rc=$?
	set -e
	test "$rc" = 2
	grep -Fx 'review-jsonl: the output directory already exists' "$work/$existing.review.err" >/dev/null
done
test "$(cat "$work/out-parent/caller-file")" = caller-data
test "$(cat "$work/out-parent/caller-directory/keep")" = caller-data
test -L "$work/out-parent/caller-symlink"

export REVIEW_MODE=fail
set +e
"$HERE/review-jsonl" "$work/out-parent/review-failure" > "$work/review-failure.out" 2> "$work/review-failure.err"
rc=$?
set -e
test "$rc" = 1
grep -Fx 'review-jsonl: expected a completed run with a skipped record, got 67' "$work/review-failure.err" >/dev/null
test ! -e "$work/out-parent/review-failure"
set +e
"$HERE/review-jsonl" "$work/out-parent/with space/failed result" > "$work/space-failure.out" 2> "$work/space-failure.err"
rc=$?
set -e
test "$rc" = 1
test ! -e "$work/out-parent/with space/failed result"
unset REVIEW_MODE

export REVIEW_MODE=wait REVIEW_ENTERED="$work/review-entered" REVIEW_RELEASE="$work/review-release"
"$HERE/review-jsonl" "$work/out-parent/review-race" > "$work/review-race.out" 2> "$work/review-race.err" &
child=$!
wait_for "$REVIEW_ENTERED"
ln -s caller-directory "$work/out-parent/review-race"
touch "$REVIEW_RELEASE"
set +e
wait "$child"
rc=$?
set -e
child=
test "$rc" = 2
test -L "$work/out-parent/review-race"
test "$(cat "$work/out-parent/caller-directory/keep")" = caller-data
test -z "$(find "$work/out-parent" -maxdepth 1 -name '.review-jsonl.*' -print)"
unset REVIEW_MODE REVIEW_ENTERED REVIEW_RELEASE

printf '%s\n' 'triage pipeline: reservation, exact flow, three outputs, and failure cleanup pass'
