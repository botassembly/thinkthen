#!/usr/bin/env bash
set -euo pipefail

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REAL_JQ=$(command -v jq)
REAL_MV=$(command -v mv)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT HUP INT TERM
mkdir "$work/bin" "$work/out-parent"

cat > "$work/bin/thinkthen" <<'SH'
#!/bin/sh
set -eu
expected="annotate $TRIAGE_HERE/questions.json --tsv --details --jobs 4 --input $TRIAGE_HERE/tickets.tsv --max-retries 0 --replay fixture"
test "$*" = "$expected" || {
	printf 'fake thinkthen: unexpected arguments\nexpected: %s\nactual:   %s\n' "$expected" "$*" >&2
	exit 64
}
cat "$TRIAGE_HERE/fake-rows.jsonl"
SH

cat > "$work/bin/jq" <<'SH'
#!/bin/sh
set -eu
case " $* " in
	*" -f $TRIAGE_HERE/../../transforms/triage/triage.jq "*)
		printf '%s\n' policy >> "$TRIAGE_LOG"
		;;
esac
if test "${TRIAGE_FAIL_SPLIT:-}" = 1 && test "${1:-}" = -c && test "${2:-}" = --arg; then
	exit 71
fi
exec "$REAL_JQ" "$@"
SH

cat > "$work/bin/mv" <<'SH'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$TRIAGE_MV_LOG"
exec "$REAL_MV" "$@"
SH
chmod +x "$work/bin/thinkthen" "$work/bin/jq" "$work/bin/mv"
export PATH="$work/bin:$PATH"
export TRIAGE_HERE="$HERE" REAL_JQ REAL_MV
export TRIAGE_LOG="$work/policy.log" TRIAGE_MV_LOG="$work/mv.log"

output="$work/out-parent/result"
"$HERE/triage" "$output" --replay fixture
test "$(wc -l < "$TRIAGE_LOG" | tr -d ' ')" = 1
test "$(wc -l < "$TRIAGE_MV_LOG" | tr -d ' ')" = 1
test "$(find "$output" -maxdepth 1 -type f -printf '%f\n' | sort)" = "block.jsonl
draft.jsonl
review.jsonl"
test "$(wc -l < "$output/draft.jsonl" | tr -d ' ')" = 2
test "$(wc -l < "$output/block.jsonl" | tr -d ' ')" = 1
test "$(wc -l < "$output/review.jsonl" | tr -d ' ')" = 3
jq -e -s 'length == 6 and all(.[]; has("schema") and has("input") and has("value") and has("answers") and has("meta") and has("policy"))' \
	"$output"/*.jsonl >/dev/null
jq -e -s 'all(.[]; .policy.action == .input.reviewed_action)' "$output"/*.jsonl >/dev/null

real_thinkthen="$HERE/../../target/debug/thinkthen"
test -x "$real_thinkthen"
"$real_thinkthen" annotate "$HERE/questions.json" --tsv --details --jobs 4 \
	--input "$HERE/tickets.tsv" --max-retries 0 --dry-run > "$work/dry-run.jsonl"
test "$(wc -l < "$work/dry-run.jsonl" | tr -d ' ')" = 1
if grep -E 'reviewed_action|SUP-1042|Duplicate renewal' "$work/dry-run.jsonl" >/dev/null; then
	printf '%s\n' 'triage self-test: a local field entered the request' >&2
	exit 1
fi

if "$HERE/triage" "$output" --replay fixture > "$work/existing.out" 2> "$work/existing.err"; then
	printf '%s\n' 'triage self-test: existing destination succeeded' >&2
	exit 1
fi
test ! -s "$work/existing.out"
grep -Fx 'triage: the output directory already exists' "$work/existing.err" >/dev/null

failed="$work/out-parent/failed"
export TRIAGE_FAIL_SPLIT=1
if "$HERE/triage" "$failed" --replay fixture > "$work/failed.out" 2> "$work/failed.err"; then
	printf '%s\n' 'triage self-test: injected failure succeeded' >&2
	exit 1
fi
unset TRIAGE_FAIL_SPLIT
test ! -e "$failed"
if find "$work/out-parent" -maxdepth 1 -name '.failed.tmp.*' | grep . >/dev/null; then
	printf '%s\n' 'triage self-test: temporary directory remains' >&2
	exit 1
fi

printf '%s\n' 'triage pipeline: exact command, policy, outputs, and atomic failure pass'
