PG_MAJOR=${PG_MAJOR:-16}
case $PG_MAJOR in
16)
# Homebrew postgresql@16 16.15 bottle entries from the official formula API,
# read on 2026-10-15. Intel uses the pinned source because no bottle is supplied.
# A new formula revision must be reviewed before changing these pins.
PG_DARWIN_VERSION=16.15
PG_BOTTLE_ARM64_SEQUOIA=2232dd95f3ec239f5e919aba12d0b67bffd5aa06ce1ce36c352d1794d5d9f048
PG_BOTTLE_X86_64_SONOMA=
PG_SOURCE_URL=https://ftp.postgresql.org/pub/source/v16.15/postgresql-16.15.tar.bz2
PG_SOURCE_SHA256=c1575341fa7bd40f5274ea465b34390f4dc64cdd0770af327005caaeb9f6b7ed
;;
17)
PG_DARWIN_VERSION=17.11
PG_BOTTLE_ARM64_SEQUOIA=51bd57deaa30e5c529822f9fff8d171fbc5418fc7d08ede4d5d039b2fc4a8116
# Homebrew supplies no Intel Mac bottle for this patch. Build its pinned source.
PG_BOTTLE_X86_64_SONOMA=
PG_SOURCE_URL=https://ftp.postgresql.org/pub/source/v17.11/postgresql-17.11.tar.bz2
PG_SOURCE_SHA256=dd27f2b3c59e73ed14aa3324901242bf69a032a6347805f274e6260322d42979
;;
18)
PG_DARWIN_VERSION=18.6
PG_BOTTLE_ARM64_SEQUOIA=11a75fdf64bdef7786c9890fca9f194cde0961fc158648509f7e8c3ffaf75275
# Homebrew supplies no Intel Mac bottle for this patch. Build its pinned source.
PG_BOTTLE_X86_64_SONOMA=
PG_SOURCE_URL=https://ftp.postgresql.org/pub/source/v18.6/postgresql-18.6.tar.bz2
PG_SOURCE_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f
;;
esac
