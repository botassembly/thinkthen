           question := 'not JSON', input := NULL::STRUCT(text VARCHAR)[], reading := NULL, settings := 'bad')))),
       (SELECT count(*) FROM (SELECT UNNEST(thinkthen_choose_details(
           question := 'not JSON', input := NULL::STRUCT(text VARCHAR)[], reading := NULL, settings := 'bad')))),
       (SELECT count(*) FROM (SELECT UNNEST(thinkthen_tag_details(
