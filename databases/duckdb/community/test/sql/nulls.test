query I
SELECT count(*) FROM thinkthen_read_files(NULL::VARCHAR);
----
0

query I
SELECT count(*) FROM thinkthen_relate(NULL, '@missing-question.json');
----
0

query I
SELECT count(*) FROM thinkthen_usage() WHERE metric = 'requests_sent' AND value = 0;
----
1

