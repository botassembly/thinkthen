{
  "tools": {
    "sccache": {
      "commands": [
        "sccache"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "groups": [
        "common"
      ],
      "provider": "aqua:mozilla/sccache",
      "version": "0.10.0",
      "probe": {
        "argv": [
          "sccache",
          "--version"
        ],
        "contains": "sccache {version}"
      },
      "linux_provider": "cargo:sccache"
    }
  }
}
