{
  "tools": {
    "go": {
      "commands": [
        "go",
        "gofmt"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "groups": [
        "lint",
        "install",
        "go"
      ],
      "provider": "go",
      "version": "1.27.1",
      "probe": {
        "argv": [
          "go",
          "version"
        ],
        "contains": "go{version}"
      }
    }
  },
  "libraries": {
    "go": {
      "platforms": [
        "darwin-arm64",
        "darwin-x86_64",
        "linux-arm64",
        "linux-x86_64"
      ],
      "check_platforms": [
        "linux-x86_64"
      ]
    }
  }
}
