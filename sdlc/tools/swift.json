{
  "tools": {
    "swift": {
      "commands": [
        "swift",
        "swiftc"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "groups": [
        "lint",
        "install",
        "swift"
      ],
      "version": "6.4"
    }
  },
  "libraries": {
    "swift": {
      "platforms": [
        "darwin-arm64",
        "darwin-x86_64",
        "linux-arm64",
        "linux-x86_64"
      ],
      "check_platforms": [
        "darwin-arm64",
        "darwin-x86_64",
        "linux-arm64",
        "linux-x86_64"
      ]
    }
  }
}
