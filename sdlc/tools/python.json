{
  "libraries": {
    "python": {
      "platforms": [
        "darwin-arm64",
        "darwin-x86_64",
        "linux-arm64",
        "linux-x86_64",
        "windows-x86_64"
      ],
      "check_platforms": [
        "darwin-arm64",
        "darwin-x86_64",
        "linux-arm64",
        "linux-x86_64"
      ]
    }
  },
  "tools": {
    "python": {
      "commands": [
        "python3",
        "python",
        "python3.13"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "groups": [
        "common"
      ],
      "provider": "python",
      "version": "3.13.7",
      "probe": {
        "argv": [
          "python3",
          "--version"
        ],
        "contains": "Python {version}"
      }
    },
    "maturin": {
      "commands": [
        "maturin"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "groups": [
        "python",
        "polars"
      ],
      "provider": "python-package",
      "version": "1.9.4"
    }
  }
}
