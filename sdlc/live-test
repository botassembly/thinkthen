#!/bin/sh
# Linux-only proof for the paid-call ledger. It uses dummy keys and local jobs.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LIVE=$ROOT/sdlc/scripts/live
. "$ROOT/sdlc/scripts/scratch.sh"
scratch_dir TMP
trap 'chmod -R u+w "$TMP" 2>/dev/null || true; scratch_clean' EXIT

fail() {
	printf 'live-test: %s\n' "$*" >&2
	exit 1
}

repo() {
	name=$1
	dir=$TMP/$name
	mkdir -p "$dir/sdlc/scripts" "$dir/target/debug"
	cp "$LIVE" "$dir/sdlc/scripts/live"
	chmod 755 "$dir/sdlc/scripts/live"
	printf '%s\n' \
		'# Audit checkpoint for one-time live authority initialization.' \
		'checkpoint_limit_tokens 10' \
		'checkpoint_charged_tokens 0' >"$dir/sdlc/live-tokens"
	chmod 644 "$dir/sdlc/live-tokens"
	printf '#!/bin/sh\nexit 0\n' >"$dir/target/debug/thinkthen"
	chmod 755 "$dir/target/debug/thinkthen"
	git -C "$dir" init -q
	printf '%s\n' "$dir"
}

run_command() {
	dir=$1
	shift
	set +e
	output=$(cd "$dir" && "$@" 2>&1)
	status=$?
	set -e
}

run() {
	dir=$1
	shift
	run_command "$dir" "$dir/sdlc/scripts/live" "$@"
}

run_with_file_limit() {
	dir=$1
	shift
	ledger=$dir/.git/thinkthen-live/ledger
	limit=$(wc -c <"$ledger")
	limit=$((limit + ${append_bytes:-0}))
	run_command "$dir" /usr/bin/python3 -c '
import os, resource, signal, sys
size = int(sys.argv[1])
resource.setrlimit(resource.RLIMIT_FSIZE, (size, size))
signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
os.execv(sys.argv[2], sys.argv[2:])
' "$limit" "$dir/sdlc/scripts/live" "$@"
}

run_with_fault() {
	dir=$1
	fault=$2
	shift 2
	run_command "$dir" /usr/bin/python3 -IS -c '
import fcntl, os, runpy, sys
fault, script, *arguments = sys.argv[1:]
def blocked(*args, **kwargs):
    raise AssertionError("control command captured a key or launched a job")
os.execve = blocked
if fault == "sync":
    def failed_sync(descriptor):
        raise OSError("fixture sync failure")
    os.fsync = failed_sync
elif fault == "key":
    class NoKey(dict):
        get = blocked
    os.environb = NoKey()
elif fault == "owner":
    original = os.lstat
    def wrong_owner(path):
        details = list(original(path))
        details[4] += 1
        return os.stat_result(details)
    os.lstat = wrong_owner
elif fault == "lock":
    def failed_lock(*args):
        raise OSError("fixture lock failure")
    fcntl.flock = failed_lock
sys.argv = [script, *arguments]
runpy.run_path(script, run_name="__main__")
' "$fault" "$dir/sdlc/scripts/live" "$@"
}

assert_status() {
	[ "$status" -eq "$1" ] || fail "expected status $1, got $status: $output"
}

assert_has() {
	case $output in *"$1"*) ;; *) fail "missing '$1' in: $output";; esac
}

missing=$(repo missing)
run "$missing" --status
assert_status 1
assert_has 'run sdlc/scripts/live --init'
run_with_fault "$missing" key --add-tokens 1
assert_status 1
assert_has 'run sdlc/scripts/live --init'
[ ! -e "$missing/.git/thinkthen-live" ] || fail 'extension initialized missing authority'

init=$(repo init)
run "$init" --init
assert_status 0
run "$init" --init
assert_status 1
assert_has 'already initialized'
run "$init" --status
assert_status 0
[ "$output" = 'limit_tokens 10
charged_tokens 0
remaining_tokens 10' ] || fail "unexpected status: $output"
before=$(cksum "$init/.git/thinkthen-live/ledger")
run "$init" --status
[ "$(cksum "$init/.git/thinkthen-live/ledger")" = "$before" ] || fail 'status changed the ledger'

printf '#!/bin/sh\ngrep -qx "charge 10" .git/thinkthen-live/ledger || exit 90\nprintf "%%s\\n" "$*" >job.args\nprintf "%%s\\n" "$PWD" >job.cwd\nexit 23\n' >"$init/job.sh"
chmod 755 "$init/job.sh"
THINKTHEN_API_KEY=dummy run "$init" --max-tokens 10 job.sh 'two words' tail
assert_status 23
[ "$(cat "$init/job.args")" = 'two words tail' ] || fail 'relative job arguments changed'
[ "$(cat "$init/job.cwd")" = "$init" ] || fail 'job did not run in its checkout'
run "$init" --status
assert_has 'charged_tokens 10'
THINKTHEN_API_KEY=dummy run "$init" --max-tokens 1 job.sh
assert_status 1
assert_has 'exceeds the 0 tokens remaining'

extended=$(repo extended)
run "$extended" --init
printf '#!/bin/sh\nprintf x >>runs\n' >"$extended/job.sh"
THINKTHEN_API_KEY=dummy run "$extended" --max-tokens 4 job.sh
assert_status 0
cp "$extended/.git/thinkthen-live/ledger" "$extended/ledger.before"
run_command "$extended" env -u THINKTHEN_API_KEY "$extended/sdlc/scripts/live" --add-tokens 20
assert_status 0
[ -z "$output" ] || fail "successful extension printed output: $output"
rm "$extended/target/debug/thinkthen"
run_with_fault "$extended" key --add-tokens 3
assert_status 0
printf '#!/bin/sh\nexit 0\n' >"$extended/target/debug/thinkthen"
chmod 755 "$extended/target/debug/thinkthen"
THINKTHEN_API_KEY=dummy run "$extended" --max-tokens 5 job.sh
assert_status 0
run "$extended" --add-tokens 7
assert_status 0
run "$extended" --status
assert_status 0
[ "$output" = 'limit_tokens 40
charged_tokens 9
remaining_tokens 31' ] || fail "extension lost a charge: $output"
cat "$extended/ledger.before" >"$extended/ledger.expected"
printf 'extension 20\nextension 3\ncharge 5\nextension 7\n' >>"$extended/ledger.expected"
cmp -s "$extended/ledger.expected" "$extended/.git/thinkthen-live/ledger" || fail 'extension changed prior rows'
[ "$(wc -c <"$extended/runs" | tr -d ' ')" -eq 2 ] || fail 'extension launched a job'
before=$(cksum "$extended/.git/thinkthen-live/ledger")
for amount in 0 00 01 +1 -1 1.0 ' 1' '1 ' 1e3 9223372036854775808 999999999999999999999999999999; do
	run_with_fault "$extended" key --add-tokens "$amount"
	assert_status 2
	[ "$output" = 'live: usage: sdlc/scripts/live --add-tokens N' ] || fail "unexpected extension usage: $output"
done
for arguments in '--add-tokens' '--add-tokens 1 job.sh'; do
	run_with_fault "$extended" key $arguments
	assert_status 2
	[ "$output" = 'live: usage: sdlc/scripts/live --add-tokens N' ] || fail "unexpected extension usage: $output"
done
[ "$(cksum "$extended/.git/thinkthen-live/ledger")" = "$before" ] || fail 'invalid amount changed ledger'

maximum=$(repo maximum)
run "$maximum" --init
run "$maximum" --add-tokens 9223372036854775797
assert_status 0
printf '#!/bin/sh\nexit 0\n' >"$maximum/job.sh"
THINKTHEN_API_KEY=dummy run "$maximum" --max-tokens 9223372036854775807 job.sh
assert_status 0
run "$maximum" --status
assert_status 0
[ "$output" = 'limit_tokens 9223372036854775807
charged_tokens 9223372036854775807
remaining_tokens 0' ] || fail "signed-64-bit totals changed: $output"
before=$(cksum "$maximum/.git/thinkthen-live/ledger")
run "$maximum" --add-tokens 1
assert_status 1
[ "$output" = 'live: token admission would exceed 9223372036854775807' ] || fail "unexpected overflow refusal: $output"
[ "$(cksum "$maximum/.git/thinkthen-live/ledger")" = "$before" ] || fail 'overflow changed ledger'

concurrent=$(repo concurrent)
run "$concurrent" --init
printf '#!/bin/sh\nprintf x >>runs\n' >"$concurrent/job.sh"
chmod 755 "$concurrent/job.sh"
(cd "$concurrent" && THINKTHEN_API_KEY=seven sdlc/scripts/live --max-tokens 7 job.sh) &
first=$!
(cd "$concurrent" && THINKTHEN_API_KEY=three sdlc/scripts/live --max-tokens 3 job.sh) &
second=$!
wait "$first"
wait "$second"
[ "$(wc -c <"$concurrent/runs" | tr -d ' ')" -eq 2 ] || fail 'concurrent jobs did not each run once'
run "$concurrent" --status
assert_has 'charged_tokens 10'
THINKTHEN_API_KEY=dummy run "$concurrent" --max-tokens 1 job.sh
assert_status 1
run "$concurrent" --add-tokens 10
assert_status 0
(cd "$concurrent" && THINKTHEN_API_KEY=seven sdlc/scripts/live --max-tokens 7 job.sh) &
first=$!
(cd "$concurrent" && THINKTHEN_API_KEY=three sdlc/scripts/live --max-tokens 3 job.sh) &
second=$!
(cd "$concurrent" && env -u THINKTHEN_API_KEY sdlc/scripts/live --add-tokens 11) &
third=$!
(cd "$concurrent" && env -u THINKTHEN_API_KEY sdlc/scripts/live --add-tokens 13) &
fourth=$!
wait "$first"
wait "$second"
wait "$third"
wait "$fourth"
[ "$(wc -c <"$concurrent/runs" | tr -d ' ')" -eq 4 ] || fail 'concurrent admission launched or lost jobs'
run "$concurrent" --status
assert_status 0
[ "$output" = 'limit_tokens 44
charged_tokens 20
remaining_tokens 24' ] || fail "concurrent admission lost rows: $output"
[ "$(wc -l <"$concurrent/.git/thinkthen-live/ledger" | tr -d ' ')" -eq 10 ] || fail 'concurrent rows lost'

unsafe=$(repo unsafe)
run "$unsafe" --init
for entry in . lock ledger initialized; do
	path=$unsafe/.git/thinkthen-live/$entry
	if [ "$entry" = . ]; then mode=700; bad=770; else mode=600; bad=660; fi
	chmod "$bad" "$path"
	run_with_fault "$unsafe" key --add-tokens 1
	assert_status 1
	assert_has 'unsafe type, owner, or mode'
	chmod "$mode" "$path"
	if [ "$entry" != . ]; then
		mv "$path" "$path.real"
		ln -s "$entry.real" "$path"
		run "$unsafe" --add-tokens 1
		assert_status 1
		assert_has 'unsafe type, owner, or mode'
		rm "$path"
		mv "$path.real" "$path"
	fi
done
authority=$unsafe/.git/thinkthen-live
mv "$authority" "$authority.real"
ln -s thinkthen-live.real "$authority"
run "$unsafe" --add-tokens 1
assert_status 1
assert_has 'unsafe type, owner, or mode'
rm "$authority"
mv "$authority.real" "$authority"
run_with_fault "$unsafe" owner --add-tokens 1
assert_status 1
assert_has 'unsafe type, owner, or mode'
before=$(cksum "$unsafe/.git/thinkthen-live/ledger")
run_with_fault "$unsafe" lock --add-tokens 1
assert_status 1
[ "$output" = 'live: the live authority lock is unavailable' ] || fail "unexpected lock refusal: $output"
[ "$(cksum "$unsafe/.git/thinkthen-live/ledger")" = "$before" ] || fail 'failed lock changed ledger'

language=$(repo language)
run "$language" --init
printf '#!/usr/bin/python3\nopen("should-not-run", "w")\n' >"$language/job.py"
: >"$language/empty.sh"
chmod 755 "$language/job.py" "$language/empty.sh"
for job in job.py empty.sh; do
	THINKTHEN_API_KEY=dummy run "$language" --max-tokens 4 "$job"
	refusal=$output
	refused=$status
	run "$language" --status
	assert_has 'charged_tokens 0'
	[ "$refused" -eq 2 ] || fail "non-shell job $job exited $refused"
	[ "$refusal" = 'live: the named live job must start with the line #!/bin/sh, so no call goes out' ] ||
		fail "unexpected non-shell refusal: $refusal"
done
[ ! -e "$language/should-not-run" ] || fail 'non-shell job ran'

malformed=$(repo malformed)
run "$malformed" --init
printf 'charge ' >>"$malformed/.git/thinkthen-live/ledger"
run "$malformed" --status
assert_status 1
assert_has 'ledger is malformed'
before=$(cksum "$malformed/.git/thinkthen-live/ledger")
run "$malformed" --add-tokens 1
assert_status 1
assert_has 'ledger is malformed'
[ "$(cksum "$malformed/.git/thinkthen-live/ledger")" = "$before" ] || fail 'partial ledger extended'

invalid_rows=$(repo invalid-rows)
run "$invalid_rows" --init
cp "$invalid_rows/.git/thinkthen-live/ledger" "$invalid_rows/ledger.before"
for rows in 'extension 0' 'extension 01' 'extension -1' 'refund 1' 'extension 9223372036854775807' 'charge 11
extension 1' 'extension 9223372036854775797
charge 9223372036854775807
charge 1'; do
	cat "$invalid_rows/ledger.before" >"$invalid_rows/.git/thinkthen-live/ledger"
	printf '%s\n' "$rows" >>"$invalid_rows/.git/thinkthen-live/ledger"
	run "$invalid_rows" --status
	assert_status 1
	[ "$output" = 'live: the live ledger is malformed; live work is disabled' ] || fail "unexpected ledger refusal: $output"
	run "$invalid_rows" --add-tokens 1
	assert_status 1
	assert_has 'ledger is malformed'
done

unknown=$(repo unknown)
run "$unknown" --init
printf 'future 1\n' >>"$unknown/.git/thinkthen-live/ledger"
run "$unknown" --status
assert_status 1
assert_has 'ledger is malformed'

lost=$(repo lost)
run "$lost" --init
printf '#!/bin/sh\nexit 0\n' >"$lost/job.sh"
chmod 755 "$lost/job.sh"
THINKTHEN_API_KEY=dummy run "$lost" --max-tokens 2 job.sh
assert_status 0
rm "$lost/.git/thinkthen-live/ledger"
run "$lost" --init
assert_status 1
assert_has 'already initialized'
[ ! -e "$lost/.git/thinkthen-live/ledger" ] || fail 'lost ledger was recreated from the checkpoint'
run "$lost" --status
assert_status 1
assert_has 'ledger is missing; live work is disabled'
run "$lost" --add-tokens 1
assert_status 1
assert_has 'ledger is missing; live work is disabled'
[ ! -e "$lost/.git/thinkthen-live/ledger" ] || fail 'extension recreated lost ledger'

unterminated=$(repo unterminated)
run "$unterminated" --init
size=$(wc -c <"$unterminated/.git/thinkthen-live/ledger")
truncate -s "$((size - 1))" "$unterminated/.git/thinkthen-live/ledger"
run "$unterminated" --status
assert_status 1
assert_has 'ledger is malformed'

bad_checkpoint=$(repo bad-checkpoint)
printf 'checkpoint_limit_tokens 01\ncheckpoint_charged_tokens 0\n' >"$bad_checkpoint/sdlc/live-tokens"
run "$bad_checkpoint" --init
assert_status 1
assert_has 'checkpoint is malformed'

linked_checkpoint=$(repo linked-checkpoint)
mv "$linked_checkpoint/sdlc/live-tokens" "$linked_checkpoint/sdlc/real-tokens"
ln -s real-tokens "$linked_checkpoint/sdlc/live-tokens"
run "$linked_checkpoint" --init
assert_status 1
assert_has 'unsafe type'

storage=$(repo storage)
run "$storage" --init
printf '#!/bin/sh\ntouch should-not-run\n' >"$storage/job.sh"
chmod 755 "$storage/job.sh"
cp "$storage/.git/thinkthen-live/ledger" "$storage/ledger.before"
THINKTHEN_API_KEY=dummy run_with_file_limit "$storage" --max-tokens 1 job.sh
assert_status 1
[ "$output" = 'live: the charge may have been recorded; inspect --status before retry' ] ||
	fail "unexpected storage refusal: $output"
cmp -s "$storage/ledger.before" "$storage/.git/thinkthen-live/ledger" || fail 'failed append changed the ledger'
[ ! -e "$storage/should-not-run" ] || fail 'job ran after storage failure'
run_with_file_limit "$storage" --add-tokens 1
assert_status 1
[ "$output" = 'live: the extension may have been recorded; inspect --status before retry' ] || fail "unexpected append refusal: $output"
cmp -s "$storage/ledger.before" "$storage/.git/thinkthen-live/ledger" || fail 'failed extension changed ledger'
run_with_fault "$storage" sync --add-tokens 2
assert_status 1
[ "$output" = 'live: the extension may have been recorded; inspect --status before retry' ] || fail "unexpected sync refusal: $output"
run "$storage" --status
assert_status 0
[ "$output" = 'limit_tokens 12
charged_tokens 0
remaining_tokens 12' ] || fail "failed sync hid extension: $output"
append_bytes=5 run_with_file_limit "$storage" --add-tokens 3
assert_status 1
assert_has 'the extension may have been recorded; inspect --status before retry'
run "$storage" --status
assert_status 1
assert_has 'ledger is malformed'
[ ! -e "$storage/should-not-run" ] || fail 'extension ran a job after storage failure'

status_repo=$(repo statuses)
run "$status_repo" --init
printf '#!/bin/sh\nexit 19\n' >"$status_repo/fail.sh"
printf '#!/bin/sh\nkill -TERM $$\n' >"$status_repo/signal.sh"
chmod 755 "$status_repo/fail.sh" "$status_repo/signal.sh"
THINKTHEN_API_KEY=dummy run "$status_repo" --max-tokens 1 fail.sh
assert_status 19
THINKTHEN_API_KEY=dummy run "$status_repo" --max-tokens 1 signal.sh 2>/dev/null
assert_status 143

secret=$(repo secret)
marker='marker-key-29812'
printf '#!/bin/sh\ncase " $* " in *marker-key-29812*) exit 91;; esac\nfind .git -type f -exec grep -l marker-key-29812 {} + >key.files 2>/dev/null || :\n[ "$THINKTHEN_API_KEY" = marker-key-29812 ] || exit 92\nprintf delivered >key.delivered\n' >"$secret/key.sh"
chmod 755 "$secret/key.sh"
run "$secret" --init
THINKTHEN_API_KEY=$marker run "$secret" --max-tokens 1 key.sh plain
assert_status 0
[ -f "$secret/key.delivered" ] || fail 'job did not receive key'
[ ! -s "$secret/key.files" ] || fail 'key was written under Git authority'
! grep -R "$marker" "$secret/.git/thinkthen-live" >/dev/null 2>&1 || fail 'key entered authority files'

killed=$(repo killed)
run "$killed" --init
printf '#!/bin/sh\nprintf started >started\nwhile :; do sleep 1; done\n' >"$killed/wait.sh"
chmod 755 "$killed/wait.sh"
(cd "$killed" && THINKTHEN_API_KEY=dummy exec sdlc/scripts/live --max-tokens 2 wait.sh) 2>/dev/null &
pid=$!
count=0
while [ ! -e "$killed/started" ]; do
	count=$((count + 1))
	[ "$count" -lt 3000 ] || fail 'waiting job did not start'
	sleep 0.01
done
kill -KILL "$pid"
set +e
wait "$pid" 2>/dev/null
set -e
run "$killed" --status
assert_has 'charged_tokens 2'
[ ! -e "$killed/.git/thinkthen-live/pending" ] || fail 'recovery state exists'

migration=$(repo migration)
authority=$migration/.git/thinkthen-live
mkdir -m 700 "$authority"
: >"$authority/lock"
chmod 600 "$authority/lock"
printf '{"version":1,"status":"active","limit_tokens":476000000,"charged_tokens":429118,"pending":null}\n' >"$authority/state.json"
printf '%s\n' '# Audit checkpoint for one-time live authority initialization.' \
	'checkpoint_limit_tokens 476000000' 'checkpoint_charged_tokens 429118' >"$migration/sdlc/live-tokens"
run "$migration" --init
assert_status 1
mv "$authority/state.json" "$authority/state-v1-retired.json"
printf '#!/bin/sh\ntouch migrated-job-ran\n' >"$migration/job.sh"
chmod 755 "$migration/job.sh"
THINKTHEN_API_KEY=dummy run "$migration" --max-tokens 1 job.sh
assert_status 1
assert_has 'run sdlc/scripts/live --init'
run "$migration" --init
assert_status 0
run "$migration" --status
assert_has 'limit_tokens 476000000'
assert_has 'charged_tokens 429118'
THINKTHEN_API_KEY=dummy run "$migration" --max-tokens 1 job.sh
assert_status 0
[ -e "$migration/migrated-job-ran" ] || fail 'completed migration did not launch'
cp "$authority/state-v1-retired.json" "$authority/state.json"
run "$migration" --status
assert_status 1
assert_has 'legacy live state exists'
run "$migration" --add-tokens 1
assert_status 1
assert_has 'legacy live state exists'

printf 'live-test: all cases passed\n'
