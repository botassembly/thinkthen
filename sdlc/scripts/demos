#!/bin/sh
# Run every demo page marked green, from its own folder, against the binary on PATH.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
ROOT=${1:-demos}

# A demo replays a recording, so neither variable may reach one.
unset THINKTHEN_API_KEY THINKTHEN_BASE_URL

if ! command -v mustmatch >/dev/null 2>&1; then
	printf 'demos: mustmatch is not on PATH\n' >&2
	exit 1
fi

cd -- "$REPO/$ROOT"

green=0
red=0
for page in */README.md; do
	[ -f "$page" ] || continue
	folder=$(dirname -- "$page")
	if ! grep -q '^Status: green$' "$page"; then
		red=$((red + 1))
		continue
	fi
	# A green page is a how-to, as ADR 0011 rules. The form is the title, the
	# traps section, and a line in the index, and a red page is never checked.
	title=$(sed -n 's/^# //p' "$page" | head -1)
	case "$title" in
	'How to'*) ;;
	*)
		printf 'demos: %s is green, and its title does not start with "How to"\n' "$page" >&2
		exit 1
		;;
	esac
	if ! grep -q '^## What can go wrong$' "$page"; then
		printf 'demos: %s is green, and it has no "What can go wrong" section\n' "$page" >&2
		exit 1
	fi
	if ! grep -q -- "$folder/" README.md; then
		printf 'demos: %s is green, and README.md lists no %s\n' "$page" "$folder" >&2
		exit 1
	fi
	# A green page replays a recording. A folder it names and does not hold
	# would send the page to a backend, so the run stops here instead.
	# A page names the folder in its blocks and in its prose, where a backtick
	# closes the name, so a backtick ends the name here too.
	sed -n 's/.*--replay \([^ `]*\).*/\1/p' "$page" | sort -u | while IFS= read -r named; do
		if [ -z "$named" ]; then
			printf 'demos: %s writes --replay with no folder name after it\n' "$page" >&2
			exit 1
		fi
		if [ ! -d "$folder/$named" ]; then
			printf 'demos: %s is green, and it names no folder %s\n' "$page" "$named" >&2
			exit 1
		fi
	done || exit 1
	# mustmatch runs a block from the folder of the page it came from, so the
	# relative paths a demo reads its own input files by are the demo's own.
	printf 'demos: running %s\n' "$page"
	mustmatch test "$page"
	green=$((green + 1))
done
printf 'demos: %s green, %s red\n' "$green" "$red"
