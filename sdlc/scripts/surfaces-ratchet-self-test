#!/usr/bin/env bash
# The surfaces ratchet in a depth-1 clone names the shallow history
# instead of blaming the grafted commit's message (surfaces-review-5).
# The lint rung runs this before the real ratchet. The clone is local
# (file://) and lives in a temporary directory removed on exit.
set -euo pipefail
REPO=$(cd "$(dirname "$0")/../.." && pwd)
# A tree without git (an export) has no history to clone. The ratchet
# there must say so and still hold the count (surfaces-review-5: this test
# died with git's exit 128).
if ! git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
  status=0
  said=$(cd "$REPO" && node sdlc/scripts/surfaces-ratchet.mjs 2>&1) || status=$?
  case "$said" in
  "surfaces-ratchet: no git history here; the raise-body check cannot run"*) ;;
  *) echo "FAIL surfaces-ratchet in a tree without git: exit $status, said: $said"; exit 1 ;;
  esac
  echo "ok:      the surfaces ratchet names a tree without git history"
  exit "$status"
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/ratchet-shallow.XXXXXX")
trap 'rm -rf "$work"' EXIT
git -C "$work" init -q .
git -C "$work" fetch -q --depth 1 "file://$REPO" HEAD
git -C "$work" checkout -q FETCH_HEAD
cp "$REPO/sdlc/scripts/surfaces-ratchet.mjs" "$work/sdlc/scripts/surfaces-ratchet.mjs"
status=0
said=$(cd "$work" && node sdlc/scripts/surfaces-ratchet.mjs 2>&1) || status=$?
want="surfaces-ratchet: the history is too shallow to find the commit that moved sdlc/surfaces-ratchet.json; fetch the full history (git fetch --unshallow, or fetch-depth: 0 in the checkout step)"
if [ "$status" -ne 1 ] || [ "$said" != "$want" ]; then
  echo "FAIL surfaces-ratchet in a shallow clone: exit $status, said: $said"
  exit 1
fi
echo "ok:      the surfaces ratchet names a shallow history"

# Every mover since the base needs a real review (surfaces-review-7,
# R5-28 and R7-4). A small repository built here holds one Rust file
# and the ratchet's two JSON files, so the cases do not depend on this
# branch's own history.
tiny="$work/tiny"
mkdir -p "$tiny/sdlc/scripts" "$tiny/sdlc/records" "$tiny/src"
cp "$REPO/sdlc/scripts/surfaces-ratchet.mjs" "$tiny/sdlc/scripts/"
cd "$tiny"
git init -q .
git config user.name self-test
git config user.email self-test@example.invalid
lines=1
echo 'fn a() {}' > src/a.rs
ceiling() { printf '{"directories":["src"],"extension":".rs","exclude":[],"max":%s}\n' "$lines" > sdlc/surfaces-ratchet.json; }
reviews() { printf '{"base":"","grandfather_until":"%s","grandfathered":{%s}}\n' "$1" "$2" > sdlc/surfaces-ratchet-reviews.json; }
grow() {
  lines=$((lines + 1))
  echo "fn f$lines() {}" >> src/a.rs
  ceiling
  git add -A
  git commit -q -m "Grow the tree" -m "$1"
}
expect() {
  status=0
  said=$(node sdlc/scripts/surfaces-ratchet.mjs 2>&1) || status=$?
  case "$1:$status:$said" in
  pass:0:*) ;;
  fail:1:*"$2"*) ;;
  *) echo "FAIL surfaces-ratchet $3: exit $status, said: $said"; exit 1 ;;
  esac
  echo "ok:      the surfaces ratchet $3"
}
echo reviewed > sdlc/records/review.md
ceiling
reviews HEAD ''
git add -A
git commit -q -m "Start the ceiling" -m "Second-agent review: sdlc/records/review.md"
root=$(git rev-parse HEAD)
expect pass '' "accepts a review line that cites a record"

grow "No second agent reviewed this."
expect fail "review: $(git rev-parse --short=7 HEAD)." "refuses a body that denies a review"
git reset -q --hard HEAD~1; lines=1

grow "Second-agent review: pending, see sdlc/records/review.md"
expect fail "review: $(git rev-parse --short=7 HEAD)." "refuses a pending review"
git reset -q --hard HEAD~1; lines=1

grow "Nothing reviewed this one."
early=$(git rev-parse HEAD)
grow "Second-agent review: sdlc/records/review.md"
expect fail "review: ${early:0:7}." "refuses an unreviewed raise that a later reviewed raise hides"

echo "The review of ${early:0:7} approves it." > sdlc/records/REVIEW-early.md
expect pass '' "accepts a raise that a review record names"

lower() {
  lines=$((lines - 1))
  sed '$d' src/a.rs > src/a.rs.new && mv src/a.rs.new src/a.rs
  ceiling
  git add -A
  git commit -q -m "Shrink the tree" ${1:+-m "$1"}
}
lower "The tree shrank by one line."
expect pass '' "accepts a lower with a body and no review"
lower ""
expect fail "review: $(git rev-parse --short=7 HEAD)." "refuses a lower with no body"
git reset -q --hard HEAD~2; lines=$((lines + 2))

rm -f sdlc/records/REVIEW-early.md
reviews "$root" "\"${early:0:12}\": \"test\""
expect fail "grandfathers ${early:0:12}, which is not in the history up to $root" "refuses to grandfather a raise newer than the cutoff"
