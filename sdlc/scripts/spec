#!/bin/sh
# Rung 3: the compiled binary against the executable pages in spec/ and every green demo.
set -eu
tools_group=spec
. "$(dirname -- "$0")/resolved-tools"

# Sanitize the environment inherited by build tools.
. "$(dirname -- "$0")/allow-list"

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
. sdlc/scripts/compiler-isolation

# ADR 0113: the binary and every demo write a scratch usage folder, which the exit removes.
. sdlc/scripts/scratch.sh
usage_home
config_home

# The pages name the address they expect and the demos replay recordings, so a
# rung that read either variable would answer to the shell that called it.
unset THINKTHEN_API_KEY THINKTHEN_BASE_URL

if ! command -v mustmatch >/dev/null 2>&1; then
	printf '%s\n' 'spec: mustmatch is not on PATH' >&2
	exit 1
fi

# Packaging supplies its installed command; ordinary development uses the build.
# Both paths replay these same pages and demo runners.
case $# in
0)
    cargo build --locked --quiet --package thinkthen-cli
    command_dir="$REPO/target/debug"
    ;;
1)
    test -x "$1" || { printf 'spec: command is not executable: %s\n' "$1" >&2; exit 2; }
    command_dir=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)
    ;;
*)
    printf '%s\n' 'usage: spec [INSTALLED_THINKTHEN]' >&2
    exit 2
    ;;
esac
PATH="$command_dir:$PATH"
export PATH

# Ticket 0140: every flag in the help, product THINKTHEN_ variable, and
# question-file key has a row in specification/settings.md, and no row is stale.
python3 sdlc/scripts/settings --self-test
python3 sdlc/scripts/settings

mustmatch test spec

# The transform page proves the edges its `jq` files claim, and `compare.jq`
# answers with lists that are empty until something is wrong.
mustmatch test transforms/README.md

# Ticket 0164: audit grades the recognize keys, whole and filtered by kind.
mustmatch test specification/fixtures/recognize/README.md

# Ticket 0167: the public pair recording keeps the exact audited edge rows.
mustmatch test specification/fixtures/relate/README.md

# Ticket 0335: the harnesses of two finished paid probes, moved here from test.
sh probes/probability-total-0038/self-test
sh probes/find-0040/self-test

# The runner is proved against pages that break each of its rules before it
# judges the real ones.
sh -- "$REPO/sdlc/scripts/demos-self-test"

# A plain child, not exec, so the EXIT trap still removes the scratch usage folder. Under
# set -e a failing runner stops the rung with its own exit code.
sh -- "$REPO/sdlc/scripts/demos"
