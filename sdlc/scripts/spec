#!/bin/sh
# Rung 3: the compiled binary against the executable pages in spec/ and every green demo.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"

# The pages name the address they expect and the demos replay recordings, so a
# rung that read either variable would answer to the shell that called it.
unset THINKTHEN_API_KEY THINKTHEN_BASE_URL

if ! command -v mustmatch >/dev/null 2>&1; then
	printf '%s\n' 'spec: mustmatch is not on PATH' >&2
	exit 1
fi

cargo build --locked --quiet --package thinkthen
PATH="$REPO/target/debug:$PATH"
export PATH

mustmatch test spec
exec sh -- "$REPO/sdlc/scripts/demos"
