#!/bin/sh
# The full functional checkpoint: `test`, then required public parity and packaging.
set -eu
case ${1:-} in
--list)
    unset THINKTHEN_CONFORMANCE_IDS
    REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
    python3 "$REPO/conformance/parity.py" --validate
    echo 'THINKTHEN_CONFORMANCE_IDS is unset; no required cell may be skipped'
    echo 'sdlc/scripts/test (routine behavior tests, doctests, consumer, self-tests)'
    echo 'cargo test release_only_ -- --ignored (large-input boundaries and nested package builds in both workspaces)'
    echo 'surfaces --full-functional (required public parity, C safety and release smoke)'
    exit 0 ;;
--run) ;;
*) echo 'usage: sdlc/scripts/test-full-cases --list|--run' >&2; exit 2 ;;
esac
shift
artifact_dir=
if [ "$#" -gt 0 ]; then
    [ "$#" -eq 2 ] && [ "$1" = --artifacts ] && [ -d "$2" ] || { echo 'test-full-cases: expected --artifacts DIR' >&2; exit 2; }
    artifact_dir=$(CDPATH= cd -- "$2" && pwd)
fi
. "$(dirname -- "$0")/heavy-lock"
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
sh "$REPO/sdlc/scripts/test"
cd -- "$REPO"
# The name prefix selects release boundaries without running subprocess helpers
# or the independent ignored load and timing campaigns.
cargo test --locked --offline --workspace --all-targets release_only_ -- --ignored
cargo test --locked --offline --manifest-path conformance/consumer/Cargo.toml \
    --target-dir target/consumer --workspace release_only_ -- --ignored
THINKTHEN_TEST_PROFILE=full
export THINKTHEN_TEST_PROFILE
unset THINKTHEN_CONFORMANCE_IDS
if [ -n "$artifact_dir" ]; then
    sh sdlc/scripts/surfaces --full-functional --artifacts "$artifact_dir"
else
    sh sdlc/scripts/surfaces --full-functional
fi
