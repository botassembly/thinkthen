#!/usr/bin/python3 -IS
"""Coordinator-only retirement and activation for THINKTHEN_LIVE_V2."""

import fcntl
import json
import os
import subprocess
import sys
import uuid

SAFE_ENV = {b"PATH": b"/usr/bin:/bin", b"LC_ALL": b"C"}
MARKER = b"THINKTHEN_LIVE_V2"
CHECKPOINT_KEYS = {b"checkpoint_limit_tokens", b"checkpoint_charged_tokens", b"checkpoint_authority_id"}
FSYNC_CALLS = 0


def fail(message):
    sys.stderr.write(f"live-migrate: {message}\n")
    raise SystemExit(1)


def run(arguments):
    return subprocess.run(arguments, env=SAFE_ENV, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)


def checkout():
    return os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(os.fsencode(__file__))), b"../.."))


def common(tree):
    result = run([b"/usr/bin/git", b"-C", tree, b"rev-parse", b"--path-format=absolute", b"--git-common-dir"])
    if result.returncode or not result.stdout.endswith(b"\n"):
        fail("the checkout has no readable Git common directory")
    return os.path.realpath(result.stdout[:-1])


def worktrees(git_dir):
    result = run([b"/usr/bin/git", b"--git-dir", git_dir, b"worktree", b"list", b"--porcelain", b"-z"])
    if result.returncode:
        fail("registered worktrees could not be enumerated")
    records = []
    current = None
    for field in result.stdout.split(b"\0"):
        if field.startswith(b"worktree "):
            current = {"path": field[9:], "locked": False, "prunable": False}
            records.append(current)
        elif current is not None and field.startswith(b"locked"):
            current["locked"] = True
        elif current is not None and field.startswith(b"prunable"):
            current["prunable"] = True
    if not records:
        fail("Git reported no registered worktree")
    return records


def read(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        return os.read(descriptor, 1_000_000)
    finally:
        os.close(descriptor)


def guarded_checkpoint(path):
    try:
        rows = read(path).splitlines()
    except OSError:
        return False
    found = set()
    for row in rows:
        if not row or row.startswith(b"#"):
            continue
        fields = row.split()
        if len(fields) != 2 or fields[0] not in CHECKPOINT_KEYS or fields[0] in found:
            return False
        found.add(fields[0])
    return found == CHECKPOINT_KEYS


def guarded(tree):
    try:
        launcher = read(os.path.join(tree, b"sdlc/scripts/live"))
        state_module = read(os.path.join(tree, b"sdlc/scripts/live-state.py"))
    except OSError:
        return False
    return MARKER in launcher and MARKER in state_module and guarded_checkpoint(os.path.join(tree, b"sdlc/live-tokens"))


def refuse_running_legacy(records):
    launchers = {os.path.join(record["path"], b"sdlc/scripts/live") for record in records}
    trees = {os.path.realpath(record["path"]) for record in records}
    try:
        processes = os.listdir(b"/proc")
    except OSError:
        fail("running legacy workers cannot be inspected")
    for process in processes:
        if not process.isdigit():
            continue
        try:
            arguments = read(os.path.join(b"/proc", process, b"cmdline")).split(b"\0")
        except (FileNotFoundError, ProcessLookupError):
            continue
        except OSError:
            fail("running legacy workers cannot be inspected")
        if any(argument in launchers for argument in arguments):
            fail("a registered worktree has an active legacy live wrapper")
        try:
            cwd = os.path.realpath(os.readlink(os.path.join(b"/proc", process, b"cwd")))
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        except OSError:
            fail("running legacy workers cannot be inspected")
        resolved = {
            os.path.realpath(argument if argument.startswith(b"/") else os.path.join(cwd, argument))
            for argument in arguments
            if argument
        }
        if resolved & launchers:
            fail("a registered worktree has an active legacy live wrapper")
        if cwd in trees and b"--" in arguments:
            separator = arguments.index(b"--")
            if separator + 1 < len(arguments):
                job = arguments[separator + 1]
                job = job if job.startswith(b"/") else os.path.join(cwd, job)
                if os.path.isfile(job):
                    fail("a registered worktree has an active legacy live job")


def refuse_unsafe(records, git_dir):
    refuse_running_legacy(records)
    authority = os.path.join(git_dir, b"thinkthen-live")
    if os.path.lexists(os.path.join(authority, b"activation-fence")):
        fail("the shared live authority has an incomplete activation")
    authority_lock = os.path.join(authority, b"lock")
    if os.path.lexists(authority) and not os.path.lexists(authority_lock):
        fail("the shared live authority lock is missing")
    if os.path.lexists(authority_lock):
        try:
            descriptor = os.open(authority_lock, os.O_RDWR | os.O_NOFOLLOW)
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.close(descriptor)
        except OSError:
            fail("the shared live authority is active or locked")
    state_path = os.path.join(git_dir, b"thinkthen-live/state.json")
    if os.path.lexists(state_path):
        try:
            state = json.loads(read(state_path))
        except (OSError, ValueError, UnicodeError, json.JSONDecodeError):
            fail("the shared live authority state is malformed")
        if type(state) is not dict or "pending" not in state:
            fail("the shared live authority state is malformed")
        if state["pending"] is not None:
            fail("the shared live authority has an unsettled worker")
    for record in records:
        tree = record["path"]
        if record["locked"] or record["prunable"] or not os.path.isdir(tree):
            fail("a registered worktree is locked, prunable, or unreachable")
        status = run([b"/usr/bin/git", b"-C", tree, b"status", b"--porcelain=v1", b"-z"])
        if status.returncode or status.stdout:
            fail("a registered worktree is dirty")
        if os.path.lexists(os.path.join(tree, b"sdlc/live-tokens.lock")):
            fail("a registered worktree has a legacy live lock")


def verify(records):
    for record in records:
        if not guarded(record["path"]):
            fail("a registered worktree still has a legacy live launcher")


def retire(records, revision, current, primary):
    launcher = run([b"/usr/bin/git", b"-C", current, b"show", revision + b":sdlc/scripts/live"])
    state_module = run([b"/usr/bin/git", b"-C", current, b"show", revision + b":sdlc/scripts/live-state.py"])
    checkpoint = run([b"/usr/bin/git", b"-C", current, b"show", revision + b":sdlc/live-tokens"])
    rows = [row.split()[0] for row in checkpoint.stdout.splitlines() if row and not row.startswith(b"#")]
    if launcher.returncode or state_module.returncode or checkpoint.returncode or MARKER not in launcher.stdout or MARKER not in state_module.stdout or set(rows) != CHECKPOINT_KEYS:
        fail("the landed revision does not contain the guarded launcher and checkpoint")
    for record in records:
        tree = record["path"]
        if os.path.realpath(tree) != primary and not guarded(tree):
            result = run([b"/usr/bin/git", b"-C", tree, b"switch", b"--detach", revision])
            if result.returncode:
                fail("a legacy worktree could not be retired")


def canonical(text, positive=False):
    if not text.isascii() or not text.isdigit() or (text != "0" and text.startswith("0")):
        fail("the audited totals must be canonical decimals")
    value = int(text)
    if value > 999_999_999 or (positive and value == 0):
        fail("the audited totals are outside the supported range")
    return value


def activation_fsync(descriptor):
    global FSYNC_CALLS
    FSYNC_CALLS += 1
    fail_from = os.environ.get("THINKTHEN_LIVE_FAIL_FSYNC_FROM")
    if fail_from is not None and fail_from.isascii() and fail_from.isdigit() and FSYNC_CALLS >= int(fail_from):
        raise OSError("injected persistent sync failure")
    os.fsync(descriptor)


def replace_activation_state(authority, state, label):
    temporary = os.path.join(authority, f"state.{label}.{uuid.uuid4().hex}.tmp".encode())
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    os.write(descriptor, (json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii"))
    activation_fsync(descriptor)
    os.close(descriptor)
    os.replace(temporary, os.path.join(authority, b"state.json"))


def sync_activation_directories(authority, git_dir, inject=False):
    for directory in (authority, git_dir):
        descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            if inject and directory == authority and os.environ.get("THINKTHEN_LIVE_FAIL_FSYNC") == "authority":
                raise OSError("injected authority sync failure")
            activation_fsync(descriptor)
        finally:
            os.close(descriptor)


def activate(git_dir, limit_text, charged_text):
    limit = canonical(limit_text, True)
    charged = canonical(charged_text)
    if charged > limit:
        fail("the audited charge exceeds the allowance")
    authority = os.path.join(git_dir, b"thinkthen-live")
    try:
        os.mkdir(authority, 0o700)
    except FileExistsError:
        fail("the live authority already exists; activation is one-time")
    machine = read(b"/etc/machine-id").decode("ascii").strip()
    if len(machine) != 32 or any(char not in "0123456789abcdef" for char in machine):
        fail("the machine identity is invalid")
    state = {
        "version": 1, "authority_id": str(uuid.uuid4()), "status": "activation_failed",
        "limit_tokens": limit, "charged_tokens": charged, "machine_id": machine,
        "common_dir_hex": git_dir.hex(), "pending": None,
    }
    try:
        fence = os.path.join(authority, b"activation-fence")
        descriptor = os.open(fence, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.close(descriptor)
        replace_activation_state(authority, state, "disabled")
        descriptor = os.open(os.path.join(authority, b"lock"), os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        activation_fsync(descriptor)
        os.close(descriptor)
        sync_activation_directories(authority, git_dir, True)
        state["status"] = "active"
        replace_activation_state(authority, state, "active")
        sync_activation_directories(authority, git_dir, True)
        os.unlink(fence)
    except OSError:
        state["status"] = "activation_failed"
        try:
            replace_activation_state(authority, state, "failed")
            sync_activation_directories(authority, git_dir)
        except OSError:
            pass
        fail("activation durability failed; the authority remains disabled")
    sys.stdout.write(f"authority_id {state['authority_id']}\nlimit_tokens {limit}\ncharged_tokens {charged}\n")


def main():
    if sys.platform != "linux" or sys.version_info < (3, 12) or sys.executable != "/usr/bin/python3":
        fail("migration requires Linux and /usr/bin/python3 3.12 or newer")
    current = checkout()
    git_dir = common(current)
    records = worktrees(git_dir)
    primary = os.path.realpath(records[0]["path"])
    refuse_unsafe(records, git_dir)
    if len(sys.argv) == 2 and sys.argv[1] == "--verify":
        verify(records)
    elif len(sys.argv) == 3 and sys.argv[1] == "--retire":
        retire(records, os.fsencode(sys.argv[2]), current, primary)
        verify(worktrees(git_dir))
    elif len(sys.argv) == 4 and sys.argv[1] == "--activate":
        verify(records)
        activate(git_dir, sys.argv[2], sys.argv[3])
    else:
        fail("usage: live-migrate --verify | --retire LANDED_SHA | --activate AUDITED_LIMIT AUDITED_CHARGED")


main()
