		[ -f "$file" ] || continue
		(cd "${file%/*}" && sha256 -c "${file##*/}.sha256" >/dev/null) || fail "bad checksum for $file"
		entry=$(tar -tzf "$file" | sed -n '/^package\/thinkthen-.*\.node$/p')
		[ "$(printf '%s\n' "$entry" | wc -l | tr -d ' ')" = 1 ] || fail "wanted one addon in $file"
		tar -xOf "$file" "$entry" >"$work/${entry##*/}"
		count=$((count + 1))
	done
	[ "$count" = 4 ] || fail "wanted four platform npm builds, got $count"
	for platform in linux-x64 linux-arm64 darwin-x64 darwin-arm64; do
		[ -f "$work/thinkthen-$platform.node" ] || fail "the $platform addon is missing"
	done
	(cd "$work" && npm pack --silent --offline --pack-destination "$output" >/dev/null)
	(cd "$output" && sha256 "thinkthen-$version.tgz" >"thinkthen-$version.tgz.sha256")
	;;
smoke-bundle)
	[ "$#" = 4 ] || fail 'smoke-bundle PLATFORM_DIR NPM_DIR OUT'
	duckdb=$(find "$2" -maxdepth 1 -name "thinkthen-duckdb-$version-*.tar.gz" -print)
	[ -f "$duckdb" ] || fail 'this target has no DuckDB release archive'
	# One listing, so no tar writes into a pipe that grep -q closed (ticket 0369).
	members=$(tar -tzf "$duckdb") || fail "cannot list $duckdb"
	for needed in ./LICENSE.thinkthen ./LICENSE.duckdb ./NOTICE ./DEPENDENCIES.txt; do
		case "
$members
" in *"
$needed
"*) ;; *) fail "DuckDB archive lacks C++ package marker $needed" ;; esac
	done
	mkdir -p "$4"
	cp "$2"/* "$4/"
	rm -f -- "$4/thinkthen-$version.tgz" "$4/thinkthen-$version.tgz.sha256"
	cp "$3/thinkthen-$version.tgz" "$3/thinkthen-$version.tgz.sha256" "$4/"
