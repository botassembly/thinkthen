#!/bin/sh
# Small, local operations shared by the dispatch-only release jobs. They read
# files made from resolve's SHA. Only `draft`, `tap`, `publish`, `nuget-push`,
# `maven-upload` and `pub-publish` change a remote service, and the workflow
# gates those jobs separately.
set -eu
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo"
. "$repo/sdlc/scripts/scratch.sh"
sha256() { if command -v shasum >/dev/null; then shasum -a 256 "$@"; else sha256sum "$@"; fi; }
fail() { echo "release-workflow: $*" >&2; exit 1; }
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -n 1)
go_cpp_names() {
	dir=$1 target=$2
	for file in "$dir"/thinkthen-go* "$dir"/thinkthen-cpp*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		name=${file##*/}
		if [ "$target" = x86_64-unknown-linux-gnu ]; then
			case $name in
			"thinkthen-go-$version-$target.tar.gz" | "thinkthen-go-$version-$target.tar.gz.sha256" | \
			"thinkthen-cpp-$version-$target.tar.gz" | "thinkthen-cpp-$version-$target.tar.gz.sha256") ;;
			*) fail "unexpected Go/C++ family entry $name" ;;
			esac
		else
			fail "unsupported target has $name"
		fi
	done
}
swift_zig_names() {
	dir=$1 target=$2
	for file in "$dir"/thinkthen-swift* "$dir"/thinkthen-zig*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		name=${file##*/}
		if [ "$target" = x86_64-unknown-linux-gnu ]; then
			case $name in
			"thinkthen-swift-$version-$target.tar.gz" | "thinkthen-swift-$version-$target.tar.gz.sha256" | \
			"thinkthen-zig-$version-$target.tar.gz" | "thinkthen-zig-$version-$target.tar.gz.sha256") ;;
			*) fail "unexpected Swift/Zig family entry $name" ;;
			esac
		else
			fail "unsupported target has $name"
		fi
	done
}
php_dart_names() {
	dir=$1 target=$2
	for file in "$dir"/thinkthen-php* "$dir"/thinkthen-dart*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		name=${file##*/}
		if [ "$target" = x86_64-unknown-linux-gnu ]; then
			case $name in
			"thinkthen-php-$version-$target.tar.gz" | "thinkthen-php-$version-$target.tar.gz.sha256" | \
			"thinkthen-dart-$version-$target.tar.gz" | "thinkthen-dart-$version-$target.tar.gz.sha256") ;;
			*) fail "unexpected PHP/Dart family entry $name" ;;
			esac
		else
			fail "unsupported target has $name"
		fi
	done
}
ada_objc_cobol_names() {
	dir=$1 target=$2
	for file in "$dir"/thinkthen-ada* "$dir"/thinkthen-objective-c* "$dir"/thinkthen-cobol*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		name=${file##*/}
		if [ "$target" = x86_64-unknown-linux-gnu ]; then
			case $name in
			"thinkthen-ada-$version-$target.tar.gz" | "thinkthen-ada-$version-$target.tar.gz.sha256" | \
			"thinkthen-objective-c-$version-$target.tar.gz" | "thinkthen-objective-c-$version-$target.tar.gz.sha256" | \
			"thinkthen-cobol-$version-$target.tar.gz" | "thinkthen-cobol-$version-$target.tar.gz.sha256") ;;
			*) fail "unexpected Ada/Objective-C/COBOL family entry $name" ;;
			esac
		else
			fail "unsupported target has $name"
		fi
	done
}
managed_names() {
	dir=$1 target=$2
	for file in "$dir"/thinkthen-csharp* "$dir"/thinkthen-jvm*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		name=${file##*/}
		if [ "$target" = x86_64-unknown-linux-gnu ]; then
			case $name in
			"thinkthen-csharp-$version-$target.tar.gz" | "thinkthen-csharp-$version-$target.tar.gz.sha256" | \
			"thinkthen-jvm-$version-$target.tar.gz" | "thinkthen-jvm-$version-$target.tar.gz.sha256") ;;
			*) fail "unexpected managed family entry $name" ;;
			esac
		else
			fail "unsupported target has $name"
		fi
	done
}
install_dart() {
	dart_archive=$1/dartsdk-linux-x64-release.zip
	curl --proto '=https' --tlsv1.2 -fsSL -o "$dart_archive" \
		https://storage.googleapis.com/dart-archive/channels/stable/release/3.13.4/sdk/dartsdk-linux-x64-release.zip
	printf '%s  %s\n' 6487a10df5eab890d746d14a55f4c70bec3c1c0633f51804eb504cbc0fc395bb "$dart_archive" |
		sha256sum -c --quiet || fail 'Dart 3.13.4 SDK differs from official checksum'
	unzip -q "$dart_archive" -d "$1"
	dart_bin=$1/dart-sdk/bin/dart
	"$dart_bin" --version 2>&1 | grep -Eq '^Dart SDK version: 3\.13\.4 \(stable\)' || fail 'Dart SDK differs from pin'
	pub_cache=$1/pub-cache
	mkdir -p -- "$pub_cache"
	PUB_CACHE=$pub_cache "$dart_bin" pub cache add ffi --version 2.2.0 || fail 'pinned ffi cache fill failed'
	[ -d "$pub_cache/hosted/pub.dev/ffi-2.2.0" ] || fail 'pinned ffi cache is missing'
	[ "$(cat "$pub_cache/hosted-hashes/pub.dev/ffi-2.2.0.sha256")" = 6d7fd89431262d8f3125e81b50d3847a091d846eafcd4fdb88dd06f36d705a45 ] ||
		fail 'cached ffi 2.2.0 differs from official digest'
	[ "$(find "$pub_cache/hosted/pub.dev" -maxdepth 1 -name 'ffi-*' -type d | wc -l | tr -d ' ')" = 1 ] ||
		fail 'isolated pub cache has another ffi version'
}
case ${1:-} in
disk)
	# disk LABEL [PATH...] (ticket 0366): print the root disk's free space and the size of each
	# named path that exists, so a run log shows where the build job's disk goes.
	[ "$#" -ge 2 ] || fail 'disk LABEL [PATH...]'
	echo "disk: $2"
	shift 2
	df -h / || true
	for path in "$@"; do [ ! -e "$path" ] || du -sh -- "$path" || true; done
	;;
linux-work)
	# Rehearsal run 36812401623 left 95 MB free on the x86 build runner's root disk while the
	# container built. Hosted Linux runners carry a second disk at /mnt. This prints a folder there
	# for the container build when /mnt is writable and has more free space than the root disk.
	# Otherwise it prints FALLBACK. It deletes nothing (worktrees.md rule 11).
	[ "$#" = 2 ] || fail 'linux-work FALLBACK'
	df -h / /mnt >&2 || true
	root_free=$(df -Pk / | awk 'NR == 2 {print $4}')
	mnt_free=$(df -Pk /mnt 2>/dev/null | awk 'NR == 2 {print $4}')
	if [ "${mnt_free:-0}" -gt "${root_free:-0}" ] && sudo -n mkdir -p /mnt/thinkthen-container &&
		sudo -n chown "$(id -u):$(id -g)" /mnt/thinkthen-container; then
		printf '%s\n' /mnt/thinkthen-container
	else
		printf '%s\n' "$2"
	fi
	;;
source-capture)
	[ "$#" = 3 ] || fail 'source-capture PROVENANCE_DIR SHA'
	[ "$3" = "$(git rev-parse HEAD)" ] || fail 'checkout differs from resolved SHA'
	[ -d "$2" ] && [ ! -L "$2" ] && [ -z "$(find "$2" -mindepth 1 -print -quit)" ] || fail 'provenance must start empty'
	git archive --format=tar HEAD >"$2/source.tar"
	[ "$(git get-tar-commit-id <"$2/source.tar")" = "$3" ] || fail 'Git tar header differs from resolved SHA'
	python3 - "$2/source.tar" "$2/source.json" "$3" <<'PY'
import hashlib, json, pathlib, sys
source, output = map(pathlib.Path, sys.argv[1:3])
commit = sys.argv[3]
output.write_text(json.dumps({"commit": commit, "sha256": hashlib.sha256(source.read_bytes()).hexdigest()}) + "\n")
PY
	chmod 444 "$2/source.json"
	python3 sdlc/scripts/release-managed-pair.py source-check "$2/source.tar" "$2/source.json" "$3"
	;;
c-capture)
	[ "$#" = 4 ] || fail 'c-capture C_ARCHIVE PROVENANCE_DIR TARGET'
	[ "$4" = x86_64-unknown-linux-gnu ] || fail 'C receipt is x86 only'
	[ -d "$3" ] && [ ! -L "$3" ] && [ -f "$3/source.json" ] || fail 'source provenance is missing'
	[ ! -e "$3/c.json" ] && [ ! -L "$3/c.json" ] || fail 'C receipt already exists'
	name=thinkthen-c-$version-$4.tar.gz
	[ "${2##*/}" = "$name" ] && [ -f "$2" ] && [ ! -L "$2" ] || fail 'selected C archive is missing or linked'
	python3 - "$2" "$3/c.json" <<'PY'
import hashlib, json, pathlib, sys
source, output = map(pathlib.Path, sys.argv[1:])
output.write_text(json.dumps({"name": source.name, "sha256": hashlib.sha256(source.read_bytes()).hexdigest()}) + "\n")
PY
	chmod 444 "$3/c.json"
	python3 sdlc/scripts/release-managed-pair.py c-check "$2" "$3/c.json" "$4" "$version"
	;;
managed-tools)
	[ "$#" = 2 ] && [ "$2" = x86_64-unknown-linux-gnu ] || fail 'managed-tools requires Linux x86'
	[ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || fail 'managed tools need Linux x86'
	python3 - <<'PY'
import os, pathlib, re, shutil, subprocess

def selected(variable, name):
    value = os.environ.get(variable)
    if variable == "THINKTHEN_DOTNET":
        path = pathlib.Path(value or shutil.which(name) or "")
    else:
        if not value:
            raise SystemExit(f"managed-tools: set {variable} to a verified exact SDK")
        path = pathlib.Path(value) / "bin" / name
    if not path.is_absolute() or not path.is_file():
        raise SystemExit(f"managed-tools: {name} is missing at {path}")
    print(f"managed-tools: {name} {path.resolve()}")
    return str(path)

def version(command, expected):
    result = subprocess.run(command, text=True, capture_output=True, timeout=20)
    shown = (result.stdout + result.stderr).strip()
    print(f"managed-tools: {shown.splitlines()[0] if shown else command[0] + ' gave no version'}")
    if result.returncode or not re.search(expected, shown):
        raise SystemExit(f"managed-tools: version differs for {command[0]}")

dotnet = selected("THINKTHEN_DOTNET", "dotnet")
version([dotnet, "--version"], r"^8\.0\.131$")
jdk = "THINKTHEN_JDK_HOME"
for name, args, expected in (("javac", ["-version"], r"javac 21\.0\.12(?:\.1)?\b"),
                             ("jar", ["--version"], r"jar 21\.0\.12(?:\.1)?\b"),
                             ("java", ["-version"], r"(?:openjdk|java) version .21\.0\.12(?:\.1)?\b")):
    version([selected(jdk, name), *args], expected)
package = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "openjdk-21-jdk"],
                         text=True, capture_output=True, timeout=20)
if package.returncode or package.stdout != "21.0.12.1+1-1~24.04.4":
    raise SystemExit("managed-tools: selected Noble JDK package is unqualified")
print(f"managed-tools: openjdk-21-jdk {package.stdout}")
for variable, name, args, expected, runtime in (
    ("THINKTHEN_KOTLIN_HOME", "kotlinc", ["-version"], r"kotlinc-jvm 2\.4\.20\b", "lib/kotlin-stdlib.jar"),
    ("THINKTHEN_SCALA_HOME", "scalac", ["-version"], r"Scala compiler version 3\.9\.0\b", "lib/scala.jar")):
    root = os.environ.get(variable)
    if not root or not (pathlib.Path(root) / runtime).is_file():
        raise SystemExit(f"managed-tools: {variable} lacks {runtime}")
    version([selected(variable, name), *args], expected)
PY
	for tool in python3 nm tar flock; do command -v "$tool" >/dev/null || fail "missing $tool"; done
	# The build job packs managed outputs and runs no bwrap consumer. The smoke job pins and
	# probes /usr/bin/bwrap in its language tools step. Rehearsal run 36812401623 found this gap.
	;;
managed-build)
	[ "$#" = 5 ] && [ "$4" = x86_64-unknown-linux-gnu ] || fail 'managed-build PROVENANCE_DIR PLATFORM_DIR TARGET SHA'
	[ "$5" = "$(git rev-parse HEAD)" ] || fail 'checkout differs from resolved SHA'
	[ -d "$2" ] && [ ! -L "$2" ] && [ -d "$3" ] && [ ! -L "$3" ] || fail 'managed build paths are missing or linked'
	python3 sdlc/scripts/release-managed-pair.py source-check "$2/source.tar" "$2/source.json" "$5"
	c_archive=$3/thinkthen-c-$version-$4.tar.gz
	python3 sdlc/scripts/release-managed-pair.py c-check "$c_archive" "$2/c.json" "$4" "$version"
	JAVA_HOME=${THINKTHEN_JDK_HOME:-}
	[ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ] || fail 'managed build lacks selected JDK Java'
	JAVACMD=$JAVA_HOME/bin/java
	PATH=$JAVA_HOME/bin:$PATH
	export JAVA_HOME JAVACMD PATH
	sh sdlc/scripts/release-workflow managed-tools "$4"
	[ ! -e "$2/managed.json" ] && [ ! -L "$2/managed.json" ] || fail 'managed receipt already exists'
	scratch_dir managed_stage
	mkdir -p "$managed_stage/src" "$managed_stage/feed" "$managed_stage/csharp" "$managed_stage/jvm" \
		"$managed_stage/dotnet-home" "$managed_stage/nuget"
	# The second source verification precedes this independent managed extraction.
	python3 sdlc/scripts/release-managed-pair.py source-check "$2/source.tar" "$2/source.json" "$5"
	tar -xf "$2/source.tar" -C "$managed_stage/src"
	DOTNET_CLI_HOME="$managed_stage/dotnet-home" NUGET_PACKAGES="$managed_stage/nuget" \
	DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1 \
	"${THINKTHEN_DOTNET:-dotnet}" pack "$managed_stage/src/libraries/csharp/ThinkThen.csproj" -c Release \
		--source "$managed_stage/feed" -o "$managed_stage/csharp" -v quiet
	THINKTHEN_JVM_OUT="$managed_stage/jvm" sh "$managed_stage/src/libraries/jvm/build.sh"
	THINKTHEN_JVM_OUT="$managed_stage/jvm" python3 "$managed_stage/src/libraries/jvm/tests/package_check.py"
	nupkg=$managed_stage/csharp/Botassembly.ThinkThen.$version.nupkg
	[ -f "$nupkg" ] && [ ! -L "$nupkg" ] || fail 'fresh nupkg is missing'
	python3 - "$nupkg" "$managed_stage/jvm/jars" "$2/managed.json" <<'PY'
import hashlib, json, pathlib, sys
nupkg, jars, receipt = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), pathlib.Path(sys.argv[3])
def pin(path):
    if not path.is_file() or path.is_symlink():
        raise SystemExit(f"managed output is missing or linked: {path}")
    return hashlib.sha256(path.read_bytes()).hexdigest()
values = {"nupkg": pin(nupkg)}
values.update({kind: pin(jars / f"thinkthen-{kind}.jar") for kind in ("door", "kotlin", "scala")})
receipt.write_text(json.dumps(values) + "\n")
PY
	chmod 444 "$2/managed.json"
	python3 sdlc/scripts/release-managed-pair.py assemble \
		--source-tar "$2/source.tar" --source-receipt "$2/source.json" \
		--c-archive "$c_archive" --c-receipt "$2/c.json" --managed-receipt "$2/managed.json" \
		--nupkg "$nupkg" --jars "$managed_stage/jvm/jars" --output "$3" --target "$4" --version "$version"
	;;
host-setup)
	[ "$#" = 2 ] || fail 'host-setup TARGET'
	[ "$(rustc -vV | sed -n 's/^host: //p')" = "$2" ] || fail "runner does not have target $2"
	rustup toolchain install 1.95.0 --profile minimal --component clippy --component rustfmt
	[ "$(rustc --version)" = "rustc 1.95.0 (59807616e 2026-04-14)" ] || fail 'Rust 1.95.0 pin changed'
	case $(rustc --print sysroot) in "${RUSTUP_HOME:-$HOME/.rustup}"/toolchains/*) ;; *) fail 'Rust does not use the isolated official rustup sysroot' ;; esac
	# release-pack builds the static command for the host's musl target.
	case $2:${RELEASE_SMOKE:-0} in *-linux-gnu:0) rustup target add --toolchain 1.95.0 "${2%-gnu}-musl" ;; esac
	for manifest in Cargo.toml libraries/c/Cargo.toml databases/sqlite/Cargo.toml databases/duckdb/Cargo.toml \
		databases/duckdb/bridge/Cargo.toml databases/postgresql/Cargo.toml libraries/python/Cargo.toml \
		libraries/typescript/Cargo.toml libraries/ruby/Cargo.toml; do
		cargo fetch --locked --manifest-path "$manifest"
	done
	if [ "$(cargo deny --version 2>/dev/null || true)" != 'cargo-deny 0.19.4' ]; then
		cargo install --locked --version 0.19.4 cargo-deny
	fi
	cargo deny fetch db
	python3 -m pip install --disable-pip-version-check 'maturin==1.15.0'
	[ "$(maturin --version)" = 'maturin 1.15.0' ] || fail 'maturin version differs from pin'
	# DuckDB setup creates a Python 3.13 venv with uv on Mac and native Linux smoke.
	if [ "$(uname -s)" = Darwin ] || [ "${RELEASE_SMOKE:-0}" = 1 ]; then
		command -v python3.13 >/dev/null || fail 'the pinned DuckDB host needs Python 3.13'
		case $(python3.13 --version) in 'Python 3.13.'*) ;; *) fail 'the DuckDB Python 3.13 pin is unavailable' ;; esac
		python3 -m pip install --disable-pip-version-check 'uv==0.9.17'
		# Another uv may come first on the runner's path, so run the copy pip just installed.
		uv_bin=$(python3 -c 'import uv; print(uv.find_uv_bin())')
		uv_read=$("$uv_bin" --version)
		case $uv_read in 'uv 0.9.17' | 'uv 0.9.17 '*) ;; *) fail "uv version differs from pin: $uv_bin printed '$uv_read'" ;; esac
		PATH=${uv_bin%/*}:$PATH
		export PATH
		# Later steps, such as the installed Python check, run uv too.
		[ -z "${GITHUB_PATH:-}" ] || printf '%s\n' "${uv_bin%/*}" >>"$GITHUB_PATH"
	fi
	if [ "$(uname -s)" = Darwin ]; then
		. databases/postgresql/runtime-darwin.env
		MACOSX_DEPLOYMENT_TARGET=15.0
		SDKROOT=$(xcrun --sdk macosx --show-sdk-path)
		export MACOSX_DEPLOYMENT_TARGET SDKROOT
		case $(uname -m) in arm64) tag=arm64_sequoia; pin=$PG_BOTTLE_ARM64_SEQUOIA ;; x86_64) tag=sonoma; pin=$PG_BOTTLE_X86_64_SONOMA ;; *) fail 'unknown Mac chip' ;; esac
		brew fetch --bottle-tag="$tag" postgresql@16
		bottle=$(brew --cache --bottle-tag="$tag" postgresql@16)
		[ "$(shasum -a 256 "$bottle" | awk '{print $1}')" = "$pin" ] || fail 'Homebrew PostgreSQL bottle differs from pin'
		brew install --force-bottle postgresql@16
		brew install pkgconf jq openssl@3
		# python@3.14 comes before the OpenSSL check, since its install may upgrade openssl@3 (ticket 0369).
		[ "${RELEASE_SMOKE:-0}" != 1 ] || brew install coreutils python@3.14
		. libraries/ruby/toolchain.env
		case $("$(brew --prefix openssl@3)/bin/openssl" version) in "OpenSSL $RUBY_OPENSSL_SERIES."*) ;; *) fail 'OpenSSL host version differs from pin' ;; esac
		cargo install --locked --version 0.17.0 cargo-pgrx
		# cargo pgrx package needs PGRX_HOME. It defaults to ~/.pgrx. The Linux container writes the same file.
		# A host that already has one keeps it. package.sh passes --pg-config either way.
		if [ ! -e "$HOME/.pgrx/config.toml" ]; then
			mkdir -p "$HOME/.pgrx"
			printf '[configs]\npg16 = "%s"\n' "$(brew --prefix postgresql@16)/bin/pg_config" >"$HOME/.pgrx/config.toml"
		fi
		sh libraries/ruby/setup-ruby.sh
		sh databases/sqlite/setup.sh
		sh databases/duckdb/tools/setup.sh --fetch
		if [ "${RELEASE_SMOKE:-0}" = 1 ]; then
			# setup-python's macOS build cannot load SQLite extensions, and Homebrew's can.
			# Rehearsal run 36853575250 failed the SQLite examples on both Macs (ticket 0369).
			sqlite_python=$(brew --prefix python@3.14)/bin/python3.14
			"$sqlite_python" -c 'import sqlite3; sqlite3.connect(":memory:").enable_load_extension(True)' ||
				fail "the SQLite check's Python cannot load extensions: $sqlite_python"
			[ -z "${GITHUB_ENV:-}" ] || printf 'THINKTHEN_PYTHON=%s\n' "$sqlite_python" >>"$GITHUB_ENV"
		fi
	else
		# Linux builds use containers, which build their own Ruby; the native installed smoke needs
		# the pinned host. A host Ruby in the build job fills about 850 MB unused (ticket 0366).
		if [ "${RELEASE_SMOKE:-0}" = 1 ]; then
			sh libraries/ruby/setup-ruby.sh
			sh databases/duckdb/tools/setup.sh --fetch
			sh databases/sqlite/setup.sh
			sh databases/postgresql/setup.sh
		fi
	fi
	if [ "${RELEASE_SMOKE:-0}" = 1 ]; then
		command -v sha256sum >/dev/null || fail 'the installed Python check needs sha256sum'
		# Fill uv's cache for the Python the check will pick (ticket 0369).
		. libraries/python/host.sh
		python=$(python_host)
		[ -n "$python" ] || fail 'the installed Python smoke needs a stable Python 3.12 or later'
		scratch_dir seed
		uv venv --quiet --python "$python" "$seed/venv"
		uv pip install --quiet --require-hashes --python "$seed/venv/bin/python" -r libraries/python/requirements-dev.txt
	fi
	;;
resolve)
	[ "$#" = 3 ] || fail 'resolve MODE REF needs exactly two arguments'
	mode=$2 ref=$3
	case $mode in
	rehearse) [ "$ref" = refs/heads/main ] || fail "rehearse must run from main, got $ref" ;;
	release) case $ref in refs/tags/v*) ;; *) fail "release must run from a v* tag, got $ref" ;; esac ;;
	*) fail "unknown mode $mode" ;;
	esac
	[ "$(git rev-parse HEAD)" = "$GITHUB_SHA" ] || fail 'checkout differs from dispatch SHA'
	# The workflow appends standard output to GITHUB_OUTPUT, so only name=value lines go there.
	if [ "$mode" = release ]; then sdlc/scripts/versions --tag "${ref#refs/tags/}" >&2; else sdlc/scripts/versions >&2; fi
	printf 'sha=%s\nversion=%s\nname=%s\n' "$GITHUB_SHA" "$version" \
		"$(if [ "$mode" = release ]; then printf 'v%s' "$version"; else printf 'v%s-rehearsal-%.7s' "$version" "$GITHUB_SHA"; fi)"
	;;
verify-family)
	[ "$#" = 4 ] || fail 'verify-family ROOT PATTERN COUNT'
	count=0
	for file in "$2"/*/$3; do
		[ -f "$file" ] || continue
		(cd "${file%/*}" && sha256 -c "${file##*/}.sha256" >/dev/null) || fail "bad checksum for $file"
		count=$((count + 1))
	done
	[ "$count" = "$4" ] || fail "wanted $4 files matching $3, got $count"
	;;
go-cpp-gate)
	[ "$#" = 4 ] || fail 'go-cpp-gate DIR TARGET SHA'
	dir=$2 target=$3 selected=$4
	[ -d "$dir" ] || fail "platform directory is missing: $dir"
	printf '%s\n' "$selected" | grep -Eq '^[0-9a-f]{40}$' || fail 'resolved SHA is invalid'
	[ "$(git rev-parse HEAD)" = "$selected" ] || fail 'checkout differs from resolved SHA'
	case $target in
	x86_64-unknown-linux-gnu)
		[ "$(rustc -vV | sed -n 's/^host: //p')" = "$target" ] || fail 'Go/C++ gate requires its installed x86 host'
		go_cpp_names "$dir" "$target"
		sh "$repo/sdlc/scripts/release-go-cpp-pair" "$dir"
		for family in go cpp; do
			archive=$dir/thinkthen-$family-$version-$target.tar.gz
			tar -xOzf "$archive" ./THINKTHEN-PACKAGE-INPUTS |
				grep -Fxq "source_commit=$selected" || fail "$family source differs from resolved SHA"
		done
		;;
	aarch64-unknown-linux-gnu | aarch64-apple-darwin | x86_64-apple-darwin)
		go_cpp_names "$dir" "$target"
		;;
	*) fail "no Go/C++ release route for $target" ;;
	esac
