#!/usr/bin/env python3
"""Run Linux checks in the manifest's capped Ubuntu environment."""
import argparse
import hashlib
import os
from pathlib import Path
import platform
import runpy
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from sdlc.scripts.tools import load_manifest
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--docker', default='docker', help='host Docker executable captured before tool PATH isolation')
parser.add_argument('checks', nargs='+', choices=('lint', 'test', 'test-full-cases', 'package', 'test-stress', 'prepare'))
args = parser.parse_args()
if 'prepare' in args.checks and args.checks != ['prepare']:
    parser.error('prepare runs separately from checks')
job = os.environ.get('PM_JOB', '').split()
job_ticket = job[0] if job else None
ticket = job_ticket or os.environ.get('PM_TICKET', '0619')
if len(ticket) != 4 or not ticket.isdigit():
    parser.error('container label requires a four-digit ticket')
policy = runpy.run_path(str(ROOT / 'sdlc/scripts/dependency-check.py'))
try:
    advisory_mode = policy['context_mode'](args.checks, job_ticket,
                                           os.environ.get('THINKTHEN_ADVISORY_MODE'))
except ValueError as error:
    parser.error(str(error))
manifest = load_manifest()
pin = manifest['linux']
arch = {'aarch64': 'arm64', 'arm64': 'arm64', 'x86_64': 'x86_64'}[platform.machine()]
base = pin['images'][arch]
is_yellow = platform.node().split('.')[0] == 'yellow'
memory = pin['yellow_memory_gib'] if is_yellow else pin['memory_gib']
# The image identity includes all construction inputs and the pinned base.
digest = hashlib.sha256(base.encode())
inputs = ('rust-toolchain.toml', 'sdlc/tools.json', 'sdlc/linux/Dockerfile', 'sdlc/linux/install.py',
          *[str(path.relative_to(ROOT)) for path in sorted((ROOT / 'sdlc/tools').glob('*.json'))])
for path in inputs:
    digest.update((ROOT / path).read_bytes())
tag = 'thinkthen-check:' + arch + '-' + digest.hexdigest()[:20]
# The classic builder enforces these per-build cgroup limits. Docker's
# default integrated BuildKit driver ignores the legacy resource flags.
with tempfile.TemporaryDirectory(prefix='thinkthen-linux-image-') as temporary:
    context = Path(temporary)
    for relative in inputs:
        destination = context / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(ROOT / relative, destination)
    subprocess.run([args.docker, 'build', '--rm', '--force-rm', '--memory', str(memory) + 'g',
                    '--cpu-period', '100000', '--cpu-quota', str(pin['cpus'] * 100000), '--platform', 'linux/' + ('amd64' if arch == 'x86_64' else 'arm64'),
                    '--build-arg', 'BASE=' + base, '-f', str(context / 'sdlc/linux/Dockerfile'), '-t', tag, str(context)], cwd=ROOT, env=dict(os.environ, DOCKER_BUILDKIT='0'), check=True)
image = subprocess.check_output([args.docker, 'image', 'inspect', '--format', '{{.Id}}', tag], text=True).strip()
print('linux-check: image=' + image + ' base=' + base, flush=True)
# Runtime validation reads the checkout scripts without baking them into layers.
subprocess.run([args.docker, 'run', '--rm', '--label', 'pm.repo=thinkthen', '--label', 'pm.ticket=' + ticket,
                '--cpus', str(pin['cpus']), '--memory', str(memory) + 'g',
                '-v', str(ROOT) + ':/opt/thinkthen-checkout:ro', '-w', '/opt/thinkthen-checkout',
                image, 'python3', 'sdlc/scripts/tools.py', ','.join(pin['tool_groups'])], check=True)
if args.checks == ['prepare']:
    running = subprocess.check_output([args.docker, 'ps', '-q'], text=True).split()
    live = set()
    if running:
        live.update(subprocess.check_output([args.docker, 'inspect', '--format', '{{.Image}}', *running],
                                            text=True).splitlines())
    candidates = subprocess.check_output([args.docker, 'image', 'ls', '--format', '{{.Repository}}:{{.Tag}}',
                                          'thinkthen-check'], text=True).splitlines()
    for candidate in candidates:
        if candidate == tag or not candidate.startswith('thinkthen-check:' + arch + '-'):
            continue
        identity = subprocess.check_output([args.docker, 'image', 'inspect', '--format', '{{.Id}}', candidate],
                                           text=True).strip()
        if identity != image and identity not in live:
            # Docker refuses removal if a container starts using it in the meantime.
            # Keep untagged parent image metadata for the classic build cache.
            subprocess.run([args.docker, 'image', 'rm', '--no-prune', candidate], check=True)
    raise SystemExit(0)
owned = ROOT / ('.linux-' + arch)
(owned / 'home').mkdir(parents=True, exist_ok=True)
(owned / 'cargo').mkdir(exist_ok=True)
source = owned / 'src'
sha = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
if not source.is_dir():
    subprocess.run(['git', 'clone', '--no-hardlinks', str(ROOT), str(source)], check=True)
subprocess.run(['git', 'fetch', 'origin', sha], cwd=source, check=True)
# Local clones track the ticket branch. Carry the outer job's fetched main
# explicitly so detached candidates compare against the same merge base.
subprocess.run(['git', 'fetch', 'origin',
                '+refs/remotes/origin/main:refs/remotes/origin/main'], cwd=source, check=True)
# Each proof starts from committed source. Preserve only ignored build output.
subprocess.run(['git', 'checkout', '--force', '--detach', sha], cwd=source, check=True)
subprocess.run(['git', 'clean', '-fd'], cwd=source, check=True)
cache_mounts = []
for name in ('sccache', 'pip-cache', 'uv-cache', 'python', 'config', 'cache'):
    folder = owned / name
    folder.mkdir(exist_ok=True)
    cache_mounts += ['-v', str(folder) + ':' + manifest['linux_prefix'] + '/' + name]
command = [args.docker, 'run', '--rm', '--label', 'pm.repo=thinkthen', '--label', 'pm.ticket=' + ticket,
           '--cpus', str(pin['cpus']), '--memory', str(memory) + 'g',
           '--security-opt', 'seccomp=unconfined', '--security-opt', 'apparmor=unconfined',
           '--security-opt', 'systempaths=unconfined', '--user', str(os.getuid()) + ':' + str(os.getgid()),
           '-v', str(owned) + ':' + str(owned),
           '-w', str(source), '-e', 'HOME=' + str(owned / 'home'),
           '-e', 'CARGO_HOME=' + str(owned / 'cargo'),
           '-e', 'THINKTHEN_ADVISORY_MODE=' + advisory_mode,
           '-e', 'CARGO_BUILD_JOBS=2', '-e', 'RUSTUP_TOOLCHAIN=' + manifest['tools']['rust']['version']]
# Both scripts come from this checkout, including edits made without a new image.
for relative in ('sdlc/scripts/tools.py', 'conformance/children/children.py'):
    command += ['-v', str(ROOT / relative) + ':' + str(source / relative) + ':ro']
# Resolve dependency locations once, before a gate replaces HOME. The tool
# resolver uses this same mounted uv cache; no host package cache is imported.
home = owned / 'home'
toolchains = home / '.cache/thinkthen-toolchains'
for name, value in dict(THINKTHEN_TOOLCHAINS=toolchains,
                        UV_CACHE_DIR=Path(manifest['linux_prefix']) / 'uv-cache',
                        npm_config_cache=home / '.npm').items():
    command += ['-e', name + '=' + str(value)]
# Cargo embeds these fixture paths at compile time. Host-shared filesystems
# can bypass Unix permissions and locks and reject filename bytes, even for
# a nonroot container user. Keep fixtures on Linux while retaining builds,
# saved results and caches on their existing persistent mounts. tmpfs pages
# count toward the container's memory cap and disappear with the container.
# Fixtures also build and run programs, so override Docker's default noexec.
for relative in ('target/tmp', 'target/library-only/tmp'):
    (source / relative).mkdir(parents=True, exist_ok=True)
    command += ['--tmpfs', str(source / relative) + ':uid=' + str(os.getuid())
                + ',gid=' + str(os.getgid()) + ',mode=0700,exec']
# Fetch lockfile dependencies inside this environment once; checks stay offline.
script = 'set -eu\n'
locks = subprocess.check_output(['git', 'ls-files', '*Cargo.lock', 'Cargo.lock'], cwd=source, text=True)
for relative in locks.splitlines():
    cargo = source / Path(relative).with_name('Cargo.toml')
    if cargo.is_file():
        script += 'cargo fetch --locked --manifest-path ' + shlex.quote(str(cargo)) + '\n'
# Advisory data is a separate prerequisite from Cargo registry dependencies.
# Fetch it in this same mounted home before the offline checks consume it.
script += 'cargo deny fetch db\n'
# Validate the prepared core gate requirements before starting any check. Other
# language checks retain their own required groups and fail if tools are absent.
script += 'python3 sdlc/scripts/tools.py --check ' + shlex.quote(','.join(pin['tool_groups'])) + '\n'
for check in args.checks:
    script += 'sdlc/scripts/job sdlc/scripts/' + check + (' --run' if check in ('test-full-cases', 'test-stress') else '') + '\n'
raise SystemExit(subprocess.run([*command, *cache_mounts, image, 'sh', '-c', script]).returncode)
