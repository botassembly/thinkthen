         lambda t: t.replace('run: python3 sdlc/scripts/release-language-tools.py managed', 'run: echo skipped'),
         ["release.yml: x86 build must select pinned managed tools after host setup and before assembly"]),
        ("language-smoke-setup", "release.yml",
         lambda t: t.replace('run: python3 sdlc/scripts/release-language-tools.py smoke', 'run: echo skipped'),
         ["release.yml: x86 smoke must select pinned language tools before installed consumers"]),
    ]
    bad = 0
    for name, file, plant, expected in cases:
        if file is None:
            got = real
        else:
            with tempfile.TemporaryDirectory() as tmp:
                folder = pathlib.Path(tmp)
                for path in (REPO / ".github/workflows").glob("*.y*ml"):
                    (folder / path.name).write_text(path.read_text(encoding="utf-8"), encoding="utf-8")
                # Keep each planted rule independent after the real release.yml lands.
                source = ((REPO / ".github/workflows/release.yml").read_text()
                          if name.startswith(("go-cpp-", "swift-zig-", "php-dart-", "ada-objc-cobol-", "language-")) else RELEASE) if file == "release.yml" else (folder / file).read_text()
                (folder / file).write_text(plant(source), encoding="utf-8")
                got = check(folder)
        if got != expected:
            bad += 1
            print(f"workflows self-test {name}: expected {expected}, got {got}", file=sys.stderr)
    lint = (REPO / "sdlc/scripts/lint").read_text(encoding="utf-8")
    for name, plant in (("lint-package", "\nsh sdlc/scripts/package\n"),
                        ("lint-stale", "\nhead -c 4194304 /dev/urandom >target/package/stale.crate\n")):
        wanted = ["lint: routine rung must not plant a stale crate or run full package validation"]
        got = check(REPO / ".github/workflows", lint_text=lint + plant)
        if got != wanted:
            bad += 1
            print(f"workflows self-test {name}: expected {wanted}, got {got}", file=sys.stderr)
    setup = (REPO / "sdlc/scripts/release-workflow").read_text(encoding="utf-8")
    wanted = ["release-workflow: host-setup must fetch databases/duckdb/bridge/Cargo.toml "
              "or list databases/duckdb/bridge/Cargo.lock as unread"]
    got = fetch_gaps(setup.replace("databases/duckdb/bridge/Cargo.toml ", ""))
    if got != wanted:
        bad += 1
        print(f"workflows self-test fetch-list: expected {wanted}, got {got}", file=sys.stderr)
    result, calls = host_setup_calls("aarch64-apple-darwin", False, uv_line="uv 0.9.18")
    if (result.returncode != 1 or calls != ["py313-ready", "uv-install", "uv-check"]
            or not result.stderr.endswith("/pinned/uv printed 'uv 0.9.18'\n")):
        bad += 1
        print(f"workflows self-test uv-pin: exit {result.returncode}, calls {calls}, stderr {result.stderr}",
              file=sys.stderr)
    host_cases = [(target, smoke) for target in ("x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
                                                 "aarch64-apple-darwin", "x86_64-apple-darwin")
                  for smoke in (False, True)]
    for target, smoke in host_cases:
        result, calls = host_setup_calls(target, smoke)
        # Ticket 0369: the smoke seeds uv for the check's Python, Linux fetches the SQLite and
        # PostgreSQL pins, and macOS hands the SQLite check a Python that loads extensions.
        seed = ["seed $ROOT/bin/python3.13"] if smoke else []
        if "apple" in target:
            wanted = ["py313-ready", "uv-install", "uv-check", "libraries/ruby/setup-ruby.sh ",
                      "databases/sqlite/setup.sh ", "databases/duckdb/tools/setup.sh --fetch",
                      *(["sqlite-python-check"] if smoke else []), *seed,
                      'pgrx [configs] pg16 = "$ROOT/openssl3/bin/pg_config"', "path $ROOT/pinned",
                      *(["env THINKTHEN_PYTHON=$ROOT/openssl3/bin/python3.14"] if smoke else [])]
        elif smoke:
            wanted = ["py313-ready", "uv-install", "uv-check", "libraries/ruby/setup-ruby.sh ",
                      "databases/duckdb/tools/setup.sh --fetch", "databases/sqlite/setup.sh ",
                      "databases/postgresql/setup.sh ", *seed, "path $ROOT/pinned"]
        else:
            # Ticket 0366: the Linux build job builds Ruby in its container, not on the host.
            wanted = [f"rustup target add --toolchain 1.95.0 {target.replace('-gnu', '-musl')}"]
        if result.returncode != 0 or calls != wanted:
            bad += 1
            print(f"workflows self-test host-setup {target} smoke={smoke}: exit {result.returncode}, "
                  f"wanted {wanted}, got {calls}; stderr {result.stderr}", file=sys.stderr)
    with tempfile.TemporaryDirectory() as tmp:
        folder = pathlib.Path(tmp)
        for path in (REPO / ".github/workflows").glob("*.y*ml"):
            text = path.read_text(encoding="utf-8")
            if path.name == "release.yml":
                text = text.replace("with: {python-version: '3.13'}", "with: {python-version: '3.11'}")
            (folder / path.name).write_text(text, encoding="utf-8")
        wanted = ["release.yml: job build must set up Python 3.13 before retaining Python 3.10 for host-setup",
                  "release.yml: job smoke must set up Python 3.13 before retaining Python 3.12 for host-setup"]
        got = check(folder)
        if got != wanted:
            bad += 1
            print(f"workflows self-test host Python: wanted {wanted}, got {got}", file=sys.stderr)
    for name, sudo, mnt_free, wanted_dir in (
            ("roomy", "exit 0", 900, "/mnt/thinkthen-container"), ("no sudo", "exit 1", 900, "FALLBACK"),
            ("small", "exit 0", 50, "FALLBACK"), ("missing", "exit 0", None, "FALLBACK")):
        with tempfile.TemporaryDirectory(prefix="thinkthen-linux-work-") as tmp:
            root = pathlib.Path(tmp)
            log = root / "calls"
            mnt = "exit 1" if mnt_free is None else f"free={mnt_free}"
            df = ('echo "df $*" >> "$FAKE_LOG"; case $2 in /mnt) %s ;; *) free=100 ;; esac; '
                  'printf "Filesystem 1024-blocks Used Available Capacity Mounted\\nx 1 1 %%s 1%%%% %%s\\n" '
                  '"$free" "$2"' % mnt)
            for tool, body in (("df", df), ("sudo", f'echo "sudo $*" >> "$FAKE_LOG"; {sudo}')):
                (root / tool).write_text(f"#!/bin/sh\n{body}\n")
                (root / tool).chmod(0o755)
            result = subprocess.run(["/bin/sh", str(REPO / "sdlc/scripts/release-workflow"), "linux-work", "FALLBACK"],
                                    env={**os.environ, "PATH": f"{root}:/usr/bin:/bin", "FAKE_LOG": str(log)},
                                    capture_output=True, text=True, timeout=20, check=False)
            calls = log.read_text().splitlines() if log.exists() else []
            removed = [call for call in calls if " rm " in f" {call} "]
            sudo_calls = [call for call in calls if call.startswith("sudo ")]
            sudo_ok = bool(sudo_calls) if mnt_free and mnt_free > 100 else not sudo_calls
            if (result.returncode != 0 or result.stdout.strip() != wanted_dir or calls[:1] != ["df -h / /mnt"]
                    or removed or not sudo_ok):
                bad += 1
                print(f"workflows self-test linux-work {name}: exit {result.returncode}, wanted {wanted_dir}, "
                      f"got {result.stdout.strip()}; calls {calls}; stderr {result.stderr}", file=sys.stderr)
    archive = subprocess.run([sys.executable, str(REPO / "sdlc/scripts/release-archive-self-test.py")],
                             capture_output=True, text=True)
    if archive.returncode != 0:
        bad += 1
        print(f"workflows self-test archived release: {archive.stdout}{archive.stderr}", file=sys.stderr)
    language = subprocess.run([sys.executable, str(REPO / "sdlc/scripts/release-language-tools-self-test.py")],
                              capture_output=True, text=True)
    if language.returncode != 0:
        bad += 1
        print(f"workflows self-test language tools: {language.stdout}{language.stderr}", file=sys.stderr)
    registry = subprocess.run([sys.executable, str(REPO / "sdlc/scripts/release-registry-self-test.py")],
                              capture_output=True, text=True)
    if registry.returncode != 0:
        bad += 1
        print(f"workflows self-test registry operations: {registry.stdout}{registry.stderr}", file=sys.stderr)
    total = len(cases) + 4 + len(host_cases) + 8
    print(f"workflows self-test: {total - bad}/{total} cases hold")
    return 1 if bad else 0


def main(argv):
    if argv == ["--self-test"]:
        return self_test()
    out = check(REPO / ".github/workflows")
    out += fetch_gaps((REPO / "sdlc/scripts/release-workflow").read_text(encoding="utf-8"))
    if not out:
        managed = subprocess.run([sys.executable, str(REPO / "sdlc/scripts/release-managed-pair-self-test.py")],
                                 capture_output=True, text=True)
        if managed.returncode:
            out.append(f"managed workflow fixture failed: {managed.stdout}{managed.stderr}")
        language = subprocess.run([sys.executable, str(REPO / "sdlc/scripts/release-language-tools-self-test.py")],
                                  capture_output=True, text=True)
        if language.returncode:
            out.append(f"language tool fixture failed: {language.stdout}{language.stderr}")
    print("\n".join(out) if out else "workflows: every workflow runs by hand from pinned code", file=sys.stderr if out else sys.stdout)
    return 1 if out else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
