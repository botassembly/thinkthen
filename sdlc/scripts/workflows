        run: gh workflow run install-check.yml --ref "$NAME" -f version="$VERSION"
"""


def self_test():
    real = check(REPO / ".github/workflows")
    cases = [
        ("real", None, None, []),
        ("release-ok", "release.yml", lambda t: t, []),
        ("resolve-inherited-token", "release.yml", lambda t: yaml.safe_dump(yaml.safe_load(t) | {
            "env": {"GH_TOKEN": "${{ secrets.GITHUB_TOKEN }}"}}),
         ["release.yml: resolve must enforce the exact rehearsal guard with only contents/actions read and step GH_TOKEN"]),
        ("resolve-inherited-shell", "release.yml", lambda t: yaml.safe_dump(yaml.safe_load(t) | {
            "env": {"BASH_ENV": "/tmp/inherited-shell"}}),
         ["release.yml: resolve must enforce the exact rehearsal guard with only contents/actions read and step GH_TOKEN"]),
        ("resolve-output", "release.yml", lambda t: t.replace('steps.source.outputs.sha', 'github.sha', 1),
         ["release.yml: resolve must enforce the exact rehearsal guard with only contents/actions read and step GH_TOKEN"]),
        ("resolve-token-build", "release.yml", lambda t: t.replace('  build:\n', '  build:\n    env: {GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}"}\n', 1),
         ["release.yml: job build must not receive GH_TOKEN; only resolve, draft and publish may"]),
        ("resolve-actions", "release.yml", lambda t: t.replace('contents: read, actions: read', 'contents: read', 1),
         ["release.yml: resolve must enforce the exact rehearsal guard with only contents/actions read and step GH_TOKEN"]),
