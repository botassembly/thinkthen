         ["release.yml: smoke must gate the resolved Ada/Objective-C/COBOL family before installed consumers"]),
        ("ada-objc-cobol-tools", "release.yml",
         lambda t: t.replace('run: sdlc/scripts/release-workflow ada-objc-cobol-tools "$TARGET"',
                             'run: echo skipped'),
         ["release.yml: x86 smoke must probe Ada/Objective-C/COBOL tools before consumers"]),
        ("ada-objc-cobol-draft-gate", "release.yml",
         lambda t: t.replace('sdlc/scripts/release-workflow ada-objc-cobol-gate "platform/platform-$target" "$target" "$SHA"',
                             'echo skipped'),
         ["release.yml: draft must gate every target's Ada/Objective-C/COBOL family before collection"]),
