#!/usr/bin/env python3
"""Every workflow starts on workflow_dispatch and runs reviewed code (0128, 0398).

Only release.yml publish dispatches another workflow, install-check.yml.

Ian ruled that no push starts a workflow and that releases publish only through a
run he starts and approves. PyYAML's safe loader reads each workflow, and each
broken rule prints one line. The rules sit beside the code that checks them, and
ticket 0128's "The workflow check" table lists them.

A tag object's SHA and a commit's SHA are both 40 hex digits, and only GitHub knows
which one a pin names. The gate stays offline, so `--remote-pins` asks GitHub by hand
before a release dispatch (ticket 0391).
Usage: workflows [--self-test | --remote-pins]
"""

import os
import pathlib
import re
import subprocess
import sys
import runpy
import tempfile

import yaml

from install_check_workflow import install_workflow, other_dispatches, publish_dispatch

REPO = pathlib.Path(__file__).resolve().parents[2]
PINNED = re.compile(r"^[\w.-]+/[\w./-]+@[0-9a-f]{40}$")
DIGEST = re.compile(r"@sha256:[0-9a-f]{64}")
EXPANDED = re.compile(r"\$\{\{\s*(inputs\.|github\.event\.)")
UNPINNED = [
    (re.compile(r"pip3? install[^\n]*\btwine\b(?!==)"), "installs twine with no version"),
    (re.compile(r"pip3? install[^\n]*\bmaturin\b(?!==)"), "installs maturin with no version"),
    (re.compile(r"npm (?:install|i) (?:-g|--global) npm(?!@\d)"), "installs npm with no version"),
    (re.compile(r"gem update --system(?! \d)"), "updates gem with no version"),
    (re.compile(r"gem install[^\n]*\brubygems-update\b(?! -v)"), "installs gem with no version"),
]
RESOLVED = "${{ needs.resolve.outputs.sha }}"
NPM_PUBLISH = re.compile(r"\bnpm (?:stage )?publish\b([^\n]*)")
NPM_VALUE_FLAGS = {"--access", "--tag", "--registry", "--otp", "--workspace", "-w"}
# Release containers build offline from the crates host-setup fetches. Every tracked
# lock file joins that fetch list or this table, which says why no release build reads it.
UNFETCHED_LOCKS = {
    "conformance/consumer/Cargo.lock": "a test consumer no release job builds",
    "libraries/r/thinkthen/src/rust/Cargo.lock": "R-universe builds R against the published crate",
    "libraries/rust/Cargo.lock": "the Rust examples surface, which no release job builds",
    "libraries/rust/consumer/Cargo.lock": "an installed-package test consumer no release job builds",
    "probes/churn-0086/Cargo.lock": "an experiment probe",
}
# Each registry job publishes in release mode only; `publish` waits for all of them (ticket 0355).
OUTWARD_REGISTRIES = ("crates", "pypi", "npm", "rubygems", "tap", "nuget", "maven", "pub")
# These registries take the run's OIDC token in place of a stored key (ticket 0389).
TRUSTED_REGISTRIES = ("crates", "pypi", "npm", "rubygems", "nuget", "pub")
ARMED_STEP = {"env": {"RELEASE_ARMED": "${{ vars.RELEASE_ARMED }}"},
              "run": '[ "$RELEASE_ARMED" = true ]'}


def steps(doc):
    for name, job in (doc.get("jobs") or {}).items():
        for step in job.get("steps") or []:
            yield name, job, step


def images(node, key=None):
    """Every value under a key named `container` or `image`, at any depth."""
    if isinstance(node, dict):
        for k, v in node.items():
            yield from images(v, k)
    elif isinstance(node, list):
        for v in node:
            yield from images(v, key)
    elif key in ("container", "image") and isinstance(node, str):
        yield node


def npm_publish_specs(run):
    """Each direct or staged npm package argument that npm would not read as a file path."""
    for match in NPM_PUBLISH.finditer(run):
        words = re.split(r"&&|\|\||[;|]", match.group(1))[0].split()
        while words and words[0].startswith("-"):
            words = words[2:] if words[0] in NPM_VALUE_FLAGS else words[1:]
        spec = words[0].strip("\"'") if words else ""
        if spec and spec not in (".", "..") and not spec.startswith(("./", "../", "/")):
            yield spec


def remote_pins(folder):
    """Ask GitHub whether each pinned action SHA is a commit; a tag object's SHA fails at run time."""
    out = []
    pins = sorted({step["uses"] for path in sorted(folder.glob("*.y*ml"))
                   for _, _, step in steps(yaml.safe_load(path.read_text(encoding="utf-8")) or {})
                   if PINNED.match(step.get("uses") or "")})
    for uses in pins:
        action, sha = uses.split("@")
        repo = "/".join(action.split("/")[:2])
        commit = subprocess.run(["gh", "api", f"repos/{repo}/git/commits/{sha}", "--silent"], capture_output=True)
        if commit.returncode == 0:
            continue
        tag = subprocess.run(["gh", "api", f"repos/{repo}/git/tags/{sha}", "--jq", ".tag + \" points to \" + .object.sha"],
                             capture_output=True, text=True)
        out.append(f"{uses} is a tag object ({tag.stdout.strip()}); pin the commit" if tag.returncode == 0
                   else f"{uses} names no commit in {repo}")
    return out


def every(name, doc, text):
    out = []
    triggers = doc.get("on", doc.get(True))
    triggers = [triggers] if isinstance(triggers, str) else list(triggers or [])
    for trigger in triggers:
        if trigger != "workflow_dispatch":
            out.append(f"{name}: starts on `{trigger}`; only workflow_dispatch may start a workflow")
    for job, _, step in steps(doc):
        uses = step.get("uses")
        if uses and not uses.startswith("./") and not PINNED.match(uses):
            out.append(f"{name}: job {job} uses {uses}, which is not pinned to a commit")
        run = step.get("run") or ""
        if EXPANDED.search(run):
            out.append(f"{name}: job {job} expands an input or event value inside run; pass it through env")
        for spec in npm_publish_specs(run):
            out.append(f"{name}: job {job} publishes {spec}; npm reads a bare relative path as a GitHub repository, so start it with ./")
        for command in re.findall(r"docker run(?:[^\n]*\\\n)*[^\n]*", run):
            if not DIGEST.search(command) and "${{ matrix." not in command:
                out.append(f"{name}: job {job} runs an image with no digest")
    for image in images(doc.get("jobs") or {}):
        if not DIGEST.search(image) and not image.startswith("${{"):
            out.append(f"{name}: image {image} carries no digest")
    if name == "gate.yml":
        runs = "\n".join(step.get("run") or "" for _, _, step in steps(doc))
        for tool in ("cargo-public-api", "PUBLIC_API_TOOLCHAIN"):
            if tool not in runs or "sdlc/scripts/install" not in runs:
                out.append(f"{name}: no step installs {tool} from the pins in sdlc/scripts/install")
    out += other_dispatches(name, doc)
    return out


def release(name, doc):
    out = []
    if doc.get("permissions") != {}:
        out.append(f"{name}: top-level permissions must be {{}}")
    trigger = doc.get("on", doc.get(True)) or {}
    dispatch = trigger.get("workflow_dispatch", {}) if isinstance(trigger, dict) else {}
    inputs = dispatch.get("inputs", {}) if isinstance(dispatch, dict) else {}
    if set(inputs) != {"mode"} or inputs["mode"].get("options") != ["rehearse", "release"]:
        out.append(f"{name}: dispatch must have only mode with rehearse and release choices")
    jobs = doc.get("jobs") or {}
    resolve = jobs.get("resolve", {})
    expected_source = {"id": "source", "env": {"MODE": "${{ inputs.mode }}",
                       "REF": "${{ github.ref }}", "GH_TOKEN": "${{ secrets.GITHUB_TOKEN }}"},
                       "run": 'sdlc/scripts/release-workflow resolve "$MODE" "$REF" >> "$GITHUB_OUTPUT"'}
    expected_checkout = {"uses": "actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09",
                         "with": {"ref": "${{ github.sha }}", "persist-credentials": False}}
    expected_outputs = {key: "${{ steps.source.outputs." + key + " }}" for key in ("sha", "version", "name")}
    if (resolve.get("permissions") != {"contents": "read", "actions": "read"}
            or resolve.get("outputs") != expected_outputs
            or resolve.get("steps") != [expected_checkout, expected_source]
            or any(key in resolve for key in ("if", "continue-on-error", "env", "environment", "defaults"))
            or "env" in doc
            or (doc.get("defaults") or {}).get("run") is not None):
        out.append(f"{name}: resolve must enforce the exact rehearsal guard with only contents/actions read and step GH_TOKEN")
    for job, spec in jobs.items():
        if job not in ("resolve", "draft", "publish") and "GH_TOKEN" in yaml.safe_dump(spec):
            out.append(f"{name}: job {job} must not receive GH_TOKEN; only resolve, draft and publish may")
    out += windows_release_rules(name, jobs)
    out += runpy.run_path(str(REPO / 'sdlc/scripts/release-windows-c-workflow.py'))['rules'](name, jobs)
    out += publish_dispatch(name, doc)
    required = {"resolve", "build", "apple-packages", "wheels", "npm-pack", "gems", "crate", "registries", "smoke", "windows-sdks", "draft",
                "crates", "pypi", "npm", "rubygems", "tap", "nuget", "maven", "pub", "publish"}
    if set(jobs) != required:
        out.append(f"{name}: release job graph differs from the accepted jobs")
    dependencies = {"apple-packages": {"resolve", "build"}, "build": {"resolve"}, "wheels": {"resolve", "build"},
                    "npm-pack": {"resolve", "build"}, "gems": {"resolve", "build"},
                    "crate": {"resolve"}, "smoke": {"resolve", "build", "apple-packages", "wheels", "npm-pack", "gems", "crate"},
                    "registries": {"resolve", "build"}, "windows-sdks": {"resolve", "npm-pack", "registries"},
                    "draft": {"resolve", "smoke", "registries", "windows-sdks"},
                    "publish": {"resolve", "draft", *OUTWARD_REGISTRIES}}
    for job in OUTWARD_REGISTRIES:
        dependencies[job] = {"resolve", "draft"}
    for job, need in dependencies.items():
        value = jobs.get(job, {}).get("needs", [])
        if isinstance(value, str):
            value = [value]
        if set(value) != need:
            out.append(f"{name}: job {job} must need {', '.join(sorted(need))}")
    crate = jobs.get("crate", {})
    crate_steps = crate.get("steps") or []
    def crate_step(predicate):
        return next((i for i, step in enumerate(crate_steps)
                     if step.get("if") is None and step.get("continue-on-error") is None
                     and predicate(step)), None)
    route = [
        crate_step(lambda step: (step.get("uses") or "").startswith("actions/checkout@")
                   and (step.get("with") or {}).get("ref") == RESOLVED),
        *[crate_step(lambda step, command=command: step.get("run") == command)
          for command in ("rustup toolchain install 1.95.0 --profile minimal",
                          "cargo fetch --locked", "sh sdlc/scripts/package")],
        crate_step(lambda step: (step.get("uses") or "").startswith("actions/upload-artifact@")
                   and (step.get("with") or {}).get("name") == "crate-package"
                   and (step.get("with") or {}).get("path") == "target/package/*.crate"
                   and (step.get("with") or {}).get("if-no-files-found") == "error"),
    ]
    if (crate.get("if") is not None or crate.get("continue-on-error") is not None
            or any(i is None for i in route) or route != sorted(set(route))):
        out.append(f"{name}: job crate must run resolved checkout, exact unconditional setup, fetch, package, and upload in order")
    dry = crate_step(lambda step: step.get("run") == "cargo publish --dry-run --locked --package thinkthen")
    if all(i is not None for i in route) and (dry is None or not route[3] < dry < route[4]):
        out.append(f"{name}: job crate must dry-run cargo publish after package and before upload")
    wheel_job = jobs.get("wheels", {})
    wheel_steps = wheel_job.get("steps") or []
    wheel_runs = [(i, step.get("run")) for i, step in enumerate(wheel_steps)
                  if step.get("if") is None and step.get("continue-on-error") is None]
    verify = next((i for i, run in wheel_runs if run == "sdlc/scripts/release-workflow verify-family platform 'thinkthen-*.whl' 5"), None)
    twine_install = next((i for i, run in wheel_runs if run and re.fullmatch(r"python3 -m pip install ['\"]?twine(?:==[0-9.]+)?['\"]?", run)), None)
    twine_check = next((i for i, run in wheel_runs if run == "python3 -m twine check --strict platform/*/thinkthen-*.whl"), None)
    if (wheel_job.get("if") is not None or wheel_job.get("continue-on-error") is not None or
            any(i is None for i in (verify, twine_install, twine_check)) or
            not verify < twine_install < twine_check):
        out.append(f"{name}: job wheels must verify five wheels, install pinned twine, and check strictly in order")
    for job, active_version, condition in (("build", "3.10", "runner.os == 'macOS'"),
                                           ("smoke", "3.12", None)):
        job_steps = jobs.get(job, {}).get("steps") or []
        host = next((i for i, step in enumerate(job_steps)
                     if "release-workflow host-setup" in (step.get("run") or "")), None)
        if host is None:  # The minimal graph fixture has no host operation.
            continue
        configured = [(i, step) for i, step in enumerate(job_steps[:host])
                      if (step.get("uses") or "").startswith("actions/setup-python@")]
        py313 = next(((i, step) for i, step in configured
                      if (step.get("with") or {}).get("python-version") == "3.13"), None)
        active = next(((i, step) for i, step in configured
                       if (step.get("with") or {}).get("python-version") == active_version), None)
        if (py313 is None or active is None or py313[0] >= active[0]
                or py313[1].get("if") != condition or active[1].get("if") is not None
                or py313[1].get("uses") != active[1].get("uses")
                or (py313[1].get("with") or {}).get("update-environment") in (False, "false")):
            out.append(f"{name}: job {job} must set up Python 3.13 before retaining Python {active_version} for host-setup")
    build_steps = jobs.get("build", {}).get("steps") or []
    container = next((step for step in build_steps if "release-container" in (step.get("run") or "")), None)
    if container:
        language_setup = next((i for i, step in enumerate(build_steps)
                               if "release-language-tools.py managed" in (step.get("run") or "")
                               and step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"
                               and (step.get("env") or {}).get("SHA") == RESOLVED
                               and '"$SHA" --acquire' in (step.get("run") or "")), None)
        host_setup = next((i for i, step in enumerate(build_steps)
                           if "release-workflow host-setup" in (step.get("run") or "")), None)
        build_index = build_steps.index(container)
        if language_setup is None or host_setup is None or not host_setup < language_setup < build_index:
            out.append(f"{name}: x86 build must select pinned managed tools after host setup and before assembly")
    if container and (container.get("env") or {}).get("THINKTHEN_RELEASE_EXPECTED_SHA") != RESOLVED:
        out.append(f"{name}: build container must receive the resolved SHA")
    if container:
        build_run = container.get("run") or ""
        capture = "release-workflow source-capture"
        container_call = "sdlc/scripts/release-container"
        c_capture = "release-workflow c-capture"
        managed_build = "release-workflow managed-build"
        if not all(part in build_run for part in (capture, container_call, c_capture, managed_build)) or not (
                build_run.index(capture) < build_run.index(container_call) <
                build_run.index(c_capture) < build_run.index(managed_build)):
            out.append(f"{name}: x86 source, container C and managed receipt capture order differs")
        if "THINKTHEN_RELEASE_SOURCE_TAR" not in build_run or "THINKTHEN_RELEASE_SOURCE_RECEIPT" not in build_run:
            out.append(f"{name}: container lacks the captured source tar and receipt")
        upload = next((step for step in build_steps if (step.get("with") or {}).get("name") == "provenance-x86"), None)
        if not upload or upload.get("if") != "matrix.target == 'x86_64-unknown-linux-gnu'" or (
                (upload.get("with") or {}).get("path") != "${{ runner.temp }}/thinkthen-provenance-x86/"):
            out.append(f"{name}: internal x86 provenance upload is missing or public")
    smoke_steps = jobs.get("smoke", {}).get("steps") or []
    smoke_bundle = next((i for i, step in enumerate(smoke_steps)
                         if "release-workflow smoke-bundle" in (step.get("run") or "")), None)
    if smoke_bundle is not None:
        language_setup = next((i for i, step in enumerate(smoke_steps)
                               if "release-language-tools.py smoke" in (step.get("run") or "")
                               and step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"
                               and (step.get("env") or {}).get("SHA") == RESOLVED
                               and '"$SHA" --acquire' in (step.get("run") or "")), None)
        host_setup = next((i for i, step in enumerate(smoke_steps)
                           if "release-workflow host-setup" in (step.get("run") or "")), None)
        tool_indices = [i for i, step in enumerate(smoke_steps)
                        if any(f"release-workflow {tool}" in (step.get("run") or "") for tool in
                               ("go-cpp-tools", "swift-zig-tools", "php-dart-tools",
                                "ada-objc-cobol-tools", "managed-tools"))]
        if (language_setup is None or host_setup is None or not tool_indices
                or not host_setup < language_setup < min(tool_indices) < smoke_bundle):
            out.append(f"{name}: x86 smoke must select pinned language tools before installed consumers")
        gate = next((i for i, step in enumerate(smoke_steps)
                     if "release-workflow go-cpp-gate platform \"$TARGET\" \"$SHA\"" in (step.get("run") or "")
                     and (step.get("env") or {}).get("SHA") == RESOLVED), None)
        tools = next((i for i, step in enumerate(smoke_steps)
                      if "release-workflow go-cpp-tools" in (step.get("run") or "")
                      and step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"), None)
        if gate is None or gate >= smoke_bundle:
            out.append(f"{name}: smoke must gate the resolved Go/C++ family before installed consumers")
        if tools is None or tools >= smoke_bundle:
            out.append(f"{name}: x86 smoke must check pinned Go/C++ tools before consumers")
        swift_gate = next((i for i, step in enumerate(smoke_steps)
                           if 'release-workflow swift-zig-gate platform "$TARGET" "$SHA"' in (step.get("run") or "")
                           and (step.get("env") or {}).get("SHA") == RESOLVED), None)
        swift_tools = next((i for i, step in enumerate(smoke_steps)
                            if "release-workflow swift-zig-tools" in (step.get("run") or "")
                            and step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"), None)
        if swift_gate is None or swift_gate >= smoke_bundle:
            out.append(f"{name}: smoke must gate the resolved Swift/Zig family before installed consumers")
        if swift_tools is None or swift_tools >= smoke_bundle:
            out.append(f"{name}: x86 smoke must check pinned Swift/Zig tools before consumers")
        php_gate = next((i for i, step in enumerate(smoke_steps)
                         if 'release-workflow php-dart-gate platform "$TARGET" "$SHA"' in (step.get("run") or "")
                         and (step.get("env") or {}).get("SHA") == RESOLVED), None)
        php_tools = next((i for i, step in enumerate(smoke_steps)
                          if "release-workflow php-dart-tools" in (step.get("run") or "")
                          and step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"), None)
        if php_gate is None or php_gate >= smoke_bundle:
            out.append(f"{name}: smoke must gate the resolved PHP/Dart family before installed consumers")
        if php_tools is None or php_tools >= smoke_bundle:
            out.append(f"{name}: x86 smoke must check pinned PHP/Dart tools before consumers")
        language_gate = next((i for i, step in enumerate(smoke_steps)
                              if 'release-workflow ada-objc-cobol-gate platform "$TARGET" "$SHA"' in (step.get("run") or "")
                              and (step.get("env") or {}).get("SHA") == RESOLVED), None)
        language_tools = next((i for i, step in enumerate(smoke_steps)
                               if "release-workflow ada-objc-cobol-tools" in (step.get("run") or "")
                               and step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"), None)
        if language_gate is None or language_gate >= smoke_bundle:
            out.append(f"{name}: smoke must gate the resolved Ada/Objective-C/COBOL family before installed consumers")
        if language_tools is None or language_tools >= smoke_bundle:
            out.append(f"{name}: x86 smoke must probe Ada/Objective-C/COBOL tools before consumers")
        managed_gate = next((i for i, step in enumerate(smoke_steps)
                             if 'release-workflow managed-gate platform "$TARGET" "$SHA" provenance' in
                             (step.get("run") or "") and (step.get("env") or {}).get("SHA") == RESOLVED), None)
        provenance_download = next((i for i, step in enumerate(smoke_steps)
                                    if (step.get("with") or {}).get("name") == "provenance-x86" and
                                    (step.get("with") or {}).get("path") == "provenance" and
                                    step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"), None)
        if managed_gate is None or provenance_download is None or not (
                provenance_download < managed_gate < smoke_bundle):
            out.append(f"{name}: smoke must download internal provenance and gate managed packages before copy")
        managed_tools = next((i for i, step in enumerate(smoke_steps)
                              if "release-workflow managed-tools" in (step.get("run") or "") and
                              step.get("if") == "matrix.target == 'x86_64-unknown-linux-gnu'"), None)
        if managed_tools is None or managed_tools >= smoke_bundle:
            out.append(f"{name}: x86 smoke must probe exact managed tools before consumers")
    draft_steps = jobs.get("draft", {}).get("steps") or []
    collect_step = next((step for step in draft_steps
                    if "release-workflow collect" in (step.get("run") or "")), None)
    collect = (collect_step or {}).get("run")
    formula = 'sdlc/scripts/release-workflow tap-formula "$VERSION" platform thinkthen.rb'
    syntax = 'ruby -c thinkthen.rb'
    draft = jobs.get("draft", {})
    formula_step = next((i for i, step in enumerate(draft_steps)
                         if step == {"env": {"VERSION": "${{ needs.resolve.outputs.version }}"},
                                     "run": formula}), None)
    syntax_step = next((i for i, step in enumerate(draft_steps)
                        if step == {"run": syntax}), None)
    collection_step = next((i for i, step in enumerate(draft_steps) if step is collect_step), None)
    if (any(i is None for i in (formula_step, syntax_step, collection_step)) or
            not formula_step < syntax_step < collection_step or
            draft.get("if") is not None or draft.get("continue-on-error") is not None or
            (draft.get("defaults") or {}).get("run") is not None or
            (doc.get("defaults") or {}).get("run") is not None or
            (collect_step or {}).get("if") is not None or
            (collect_step or {}).get("continue-on-error") is not None):
        out.append(f"{name}: draft must render and syntax-check the resolved tap formula before collection")

    if collect is not None and ("release-workflow go-cpp-gate \"platform/platform-$target\" \"$target\" \"$SHA\"" not in collect
                            or collect.index("release-workflow go-cpp-gate") > collect.index("release-workflow collect")
                            or (collect_step.get("env") or {}).get("SHA") != RESOLVED):
        out.append(f"{name}: draft must gate every target's Go/C++ family before collection")
    if collect is not None and ('release-workflow swift-zig-gate "platform/platform-$target" "$target" "$SHA"' not in collect
                            or collect.index("release-workflow swift-zig-gate") > collect.index("release-workflow collect")
                            or (collect_step.get("env") or {}).get("SHA") != RESOLVED):
        out.append(f"{name}: draft must gate every target's Swift/Zig family before collection")
    if collect is not None and ('release-workflow php-dart-gate "platform/platform-$target" "$target" "$SHA"' not in collect
                            or collect.index("release-workflow php-dart-gate") > collect.index("release-workflow collect")
                            or (collect_step.get("env") or {}).get("SHA") != RESOLVED):
        out.append(f"{name}: draft must gate every target's PHP/Dart family before collection")
    if collect is not None and ('release-workflow ada-objc-cobol-gate "platform/platform-$target" "$target" "$SHA"' not in collect
                            or collect.index("release-workflow ada-objc-cobol-gate") > collect.index("release-workflow collect")
                            or (collect_step.get("env") or {}).get("SHA") != RESOLVED):
        out.append(f"{name}: draft must gate every target's Ada/Objective-C/COBOL family before collection")
    draft_provenance = next((i for i, step in enumerate(draft_steps)
                             if (step.get("with") or {}).get("name") == "provenance-x86" and
                             (step.get("with") or {}).get("path") == "provenance"), None)
    collect_index = next((i for i, step in enumerate(draft_steps) if "release-workflow collect" in
                          (step.get("run") or "")), None)
    if collect is not None and (draft_provenance is None or collect_index is None or
            draft_provenance >= collect_index or
            'release-workflow managed-gate "platform/platform-$target" "$target" "$SHA" provenance' not in collect or
            collect.index("release-workflow managed-gate") > collect.index("release-workflow collect") or
            (collect_step.get("env") or {}).get("SHA") != RESOLVED):
        out.append(f"{name}: draft must gate managed packages with internal provenance before collection")
    outward = (*OUTWARD_REGISTRIES, "publish")
    out += registry_rules(name, jobs)
    for job in outward:
        spec = jobs.get(job, {})
        if spec.get("if") != "inputs.mode == 'release'":
            out.append(f"{name}: job {job} must require release mode")
        first = (spec.get("steps") or [None])[0]
        if first != ARMED_STEP:
            out.append(f"{name}: job {job} must check environment RELEASE_ARMED before any outward step")
    for job, spec in (doc.get("jobs") or {}).items():
        permissions = spec.get("permissions") or {}
        text = yaml.safe_dump(spec)
        if permissions.get("contents") == "write" and job not in ("draft", "publish"):
            out.append(f"{name}: job {job} holds contents: write; only draft and publish may")
        secret = re.search(r"secrets\.(?!GITHUB_TOKEN\b)", text)
        environment = spec.get("environment")
        environment = environment.get("name") if isinstance(environment, dict) else environment
        if (permissions.get("id-token") == "write" or secret) and environment != "release":
            out.append(f"{name}: job {job} holds id-token or a secret outside environment release")
        if job in outward and environment != "release":
            out.append(f"{name}: job {job} must use environment release")
        if job in TRUSTED_REGISTRIES and (permissions.get("id-token") != "write" or "secrets." in text):
            out.append(f"{name}: job {job} must publish by trusted publishing: id-token write and no secret")
    for job, spec, step in steps(doc):
        uses = step.get("uses") or ""
        if "cache" in uses or "cache" in (step.get("with") or {}):
            out.append(f"{name}: job {job} uses a cache")
        if uses.startswith("actions/checkout@"):
            ref = (step.get("with") or {}).get("ref")
            if ref != RESOLVED and not (job == "resolve" and ref == "${{ github.sha }}"):
                out.append(f"{name}: job {job} checks out {ref}, not the resolved SHA")
        for pattern, why in UNPINNED:
            if pattern.search(step.get("run") or ""):
                out.append(f"{name}: job {job} {why}")
    return out


def windows_release_rules(name, jobs):
    """The fifth command target must build and smoke without claiming Unix bindings."""
    out = []
    target = "x86_64-pc-windows-msvc"
    unix = {"x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
            "aarch64-apple-darwin", "x86_64-apple-darwin"}
    for kind in ("build", "smoke"):
        job = jobs.get(kind, {})
        matrix = ((job.get("strategy") or {}).get("matrix") or {}).get("include")
        if matrix is None:  # The minimal release graph fixture has no matrix.
            continue
        windows = [entry for entry in matrix if entry.get("target") == target]
        if ({entry.get("target") for entry in matrix} != unix | {target}
                or len(matrix) != 5 or len(windows) != 1 or windows[0].get("runner") != "windows-2025"):
            out.append(f"{name}: {kind} must include exactly the four Unix targets and Windows x86-64 on windows-2025")
        if ((job.get("defaults") or {}).get("run") or {}).get("shell") != "bash":
            out.append(f"{name}: {kind} must select bash for the Windows target")
        active = [step for step in job.get("steps", []) if not step.get("continue-on-error")]
        text = "\n".join(step.get("run", "") for step in active)
        if "core.autocrlf false" not in text or "LOCALAPPDATA=" not in text or "APPDATA=" not in text:
            out.append(f"{name}: {kind} must preserve Windows fixture bytes and isolate default folders")
        if kind == "build":
            for command in ("cargo clippy --locked --offline --workspace --all-targets -- -D warnings",
                            "cargo test --locked --offline --no-fail-fast --workspace --all-targets",
                            'sdlc/scripts/release-pack "$TARGET" release-files command c python typescript first-run',
                            "release-windows-command.py platform release-files"):
                if command not in text:
                    out.append(f"{name}: build must check and pack the Windows command: {command}")
        else:
            smoke = [step for step in active if step.get("run") ==
                     "python3 sdlc/scripts/release-windows-smoke.py platform --crate-dir crate-dist"
                     and step.get("if") == f"matrix.target == '{target}'"]
            if len(smoke) != 1:
                out.append(f"{name}: smoke must run the Windows command and packed Rust crate")
            for step in active:
                run = step.get("run", "")
                if ("release-workflow smoke-bundle" in run or
                        re.search(r"release-workflow (?:go-cpp|swift-zig|php-dart|ada-objc-cobol|managed)-gate", run)):
                    if step.get("if") != f"matrix.target != '{target}'":
                        out.append(f"{name}: smoke must exclude Windows from Unix binding gates and consumers")
    draft = "\n".join(step.get("run", "") for step in jobs.get("draft", {}).get("steps", []))
    if target in draft and f'[ "$target" != {target} ] || continue' not in draft:
        out.append(f"{name}: draft must skip Windows binding families before collection")
    return out


def registry_rules(name, jobs):
    """The registry job packs and rehearses every package; maven signs before it uploads."""
    out = []
    runs = [step.get("run") or "" for step in (jobs.get("registries", {}).get("steps") or [])
            if step.get("if") is None and step.get("continue-on-error") is None]
    text = "\n".join(runs)
    order = ["release-workflow registry-pack platform registry", "release-workflow maven-sign registry/maven rehearse",
             "release-workflow pub-dry-run registry/pub/thinkthen_dart"]
    upload = any((step.get("with") or {}).get("name") == "registry-packages"
                 and (step.get("uses") or "").startswith("actions/upload-artifact@")
                 for step in (jobs.get("registries", {}).get("steps") or []))
    if (not all(part in text for part in order) or [text.find(part) for part in order] != sorted(text.find(part) for part in order)
            or "|| true" in text or not upload or jobs.get("registries", {}).get("environment")):
        out.append(f"{name}: job registries must pack, rehearse signing, dry-run pub and upload registry-packages, outside any environment")
    runs = "\n".join(step.get("run") or "" for step in (jobs.get("maven", {}).get("steps") or []))
    sign, upload_at = runs.find("maven-sign registry/maven release"), runs.find("release-workflow maven-upload")
    if sign < 0 or upload_at < 0 or sign > upload_at:
        out.append(f"{name}: job maven must sign with the release key before it uploads")
    return out


def fetch_gaps(setup_text):
    """Name each tracked lock file whose manifest host-setup does not fetch."""
    block = re.search(r"for manifest in (.*?); do", setup_text, re.S)
    fetched = set(block.group(1).replace("\\\n", " ").split()) if block else set()
    locks = subprocess.run(["git", "ls-files", "*Cargo.lock"], cwd=REPO, capture_output=True, text=True,
                           check=True).stdout.split()
    return [f"release-workflow: host-setup must fetch {lock[:-4]}toml or list {lock} as unread"
            for lock in locks if lock not in UNFETCHED_LOCKS and f"{lock[:-4]}toml" not in fetched]


def check(folder, lint_text=None):
    out = []
    for path in sorted(folder.glob("*.y*ml")):
        text = path.read_text(encoding="utf-8")
        doc = yaml.safe_load(text) or {}
        out += every(path.name, doc, text)
        if path.name == "release.yml":
            out += release(path.name, doc)
        if path.name == "windows.yml":
            out += runpy.run_path(str(REPO / 'sdlc/scripts/release-windows-c-workflow.py'))['standalone'](path.name, doc.get('jobs', {}))
        if path.name == "install-check.yml":
            out += install_workflow(path.name, doc)
    if lint_text is None:
        lint_text = (REPO / "sdlc/scripts/lint").read_text(encoding="utf-8")
    if (re.search(r"(?m)^[ \t]*(?:sh[ \t]+)?sdlc/scripts/package(?:[ \t]|$)", lint_text)
            or "head -c 4194304 /dev/urandom" in lint_text):
        out.append("lint: routine rung must not plant a stale crate or run full package validation")
    return out


def host_setup_calls(target, smoke, uv_line="uv 0.9.17 (0a1b2c3d4 2025-12-09)", old_bash=False):
    """Run the real setup branch while a temporary PATH records its host calls.

    A stray uv sits on PATH and fails if run, as on a runner image with its own uv.
    The pinned uv lives where pip put it and prints uv_line.
    """
    with tempfile.TemporaryDirectory(prefix="thinkthen-host-setup-") as tmp:
        root = pathlib.Path(tmp)
        bin_dir = root / "bin"
        bin_dir.mkdir()
        route = bin_dir / "route"
        route.write_text("""#!/bin/sh
case ${0##*/} in
rustc) case $1 in
  -vV) printf 'host: %s\\n' "$FAKE_TARGET" ;;
  --version) echo 'rustc 1.95.0 (59807616e 2026-04-14)' ;;
  --print) printf '%s/toolchains/1.95.0\\n' "$RUSTUP_HOME" ;;
  esac ;;
cargo) [ "$1 $2" != 'deny --version' ] || echo 'cargo-deny 0.19.4' ;;
rustup) [ "$1 $2" != 'target add' ] || echo "rustup $*" >> "$FAKE_LOG" ;;
maturin) echo 'maturin 1.15.0' ;;
npm) case $* in "ci --no-audit --no-fund --silent --prefix $FAKE_ROOT/"*) echo npm-seed >> "$FAKE_LOG" ;;
  *) echo "unexpected npm call: $*" >&2; exit 94 ;; esac ;;
python3) case " $* " in *' uv==0.9.17 '*) touch "$FAKE_UV_READY"; echo uv-install >> "$FAKE_LOG" ;; esac
  case $1 in -c) case $2 in *find_uv_bin*) echo "$FAKE_ROOT/pinned/uv" ;; esac ;; esac ;;
python3.14) exit 1 ;;
bash) echo bash-check >> "$FAKE_LOG"; [ -z "$FAKE_OLD_BASH" ] ;;
python3.13) [ "$1" != --version ] || {
  touch "$FAKE_PY313_READY"; echo py313-ready >> "$FAKE_LOG"; echo 'Python 3.13.0';
} ;;
uv) case $0 in "$FAKE_ROOT/pinned/uv") ;; *) echo 'a stray uv ran' >&2; exit 93 ;; esac
  [ -f "$FAKE_UV_READY" ] || { echo 'uv was not installed' >&2; exit 91; }
  [ "$1" != --version ] || { echo uv-check >> "$FAKE_LOG"; echo "$FAKE_UV_LINE"; }
  if [ "$1" = venv ]; then
    case $4 in */python3.14)
      echo sqlite-venv >> "$FAKE_LOG"
      mkdir -p "$5/bin"
      ln -s "$FAKE_ROOT/openssl3/bin/python3.14" "$5/bin/python" ;;
    *) echo "seed $4" >> "$FAKE_LOG" ;; esac
  fi
  case $* in "pip install --quiet --python $FAKE_ROOT/.cache/thinkthen-toolchains/sqlite-python-3.14/bin/python jsonschema==4.25.1")
    echo sqlite-jsonschema >> "$FAKE_LOG" ;; esac ;;
uname) case $1 in -s) case $FAKE_TARGET in *apple*) echo Darwin ;; *) echo Linux ;; esac ;;
  -m) case $FAKE_TARGET in aarch64*) echo arm64 ;; *) echo x86_64 ;; esac ;; esac ;;
xcrun) echo "$FAKE_ROOT/sdk" ;;
brew) case $1 in --cache) echo "$FAKE_ROOT/bottle" ;; --prefix) echo "$FAKE_ROOT/openssl3" ;; esac ;;
shasum) . databases/postgresql/runtime-darwin.env
  case $FAKE_TARGET in aarch64*) pin=$PG_BOTTLE_ARM64_SEQUOIA ;;
    *) pin=$PG_BOTTLE_X86_64_SONOMA ;; esac
  printf '%s  %s\\n' "$pin" "$3" ;;
sh) case $1 in databases/duckdb/tools/setup.sh)
      [ -f "$FAKE_UV_READY" ] && [ -f "$FAKE_PY313_READY" ] || {
        echo 'DuckDB setup preceded uv or Python 3.13 readiness' >&2; exit 92;
      } ;;
    esac
    printf '%s %s\\n' "$1" "$2" >> "$FAKE_LOG" ;;
esac
""")
        route.chmod(0o755)
        openssl = root / "openssl3/bin/openssl"
        openssl.parent.mkdir(parents=True)
        openssl.write_text("#!/bin/sh\necho 'OpenSSL 3.6.3 27 Jan 2026'\n")
        openssl.chmod(0o755)
        sqlite_python = root / "openssl3/bin/python3.14"
        sqlite_python.write_text('#!/bin/sh\necho sqlite-python-check >> "$FAKE_LOG"\n')
        sqlite_python.chmod(0o755)
        for name in ("rustc", "rustup", "cargo", "maturin", "npm", "uv", "uname", "sh", "xcrun", "brew", "shasum",
                     "python3", "python3.12", "python3.13", "python3.14", "bash"):
            (bin_dir / name).symlink_to(route.name)
        (root / "pinned").mkdir()
        (root / "pinned/uv").symlink_to(route)
        log = root / "calls"
        env = os.environ.copy()
        env.update(PATH=f"{bin_dir}:/usr/bin:/bin", HOME=str(root), RUSTUP_HOME=str(root / "rustup"),
                   TMPDIR=str(root), FAKE_TARGET=target, FAKE_LOG=str(log), FAKE_ROOT=str(root),
                   FAKE_UV_READY=str(root / "uv-ready"), FAKE_PY313_READY=str(root / "py313-ready"),
                   FAKE_UV_LINE=uv_line, FAKE_OLD_BASH="1" if old_bash else "", GITHUB_PATH=str(root / "github-path"),
                   GITHUB_ENV=str(root / "github-env"),
                   RELEASE_SMOKE="1" if smoke else "0")
        result = subprocess.run(["/bin/sh", str(REPO / "sdlc/scripts/release-workflow"), "host-setup", target],
                                env=env, capture_output=True, text=True, timeout=20, check=False)
        calls = [line.replace(str(root), "$ROOT") for line in log.read_text().splitlines()] if log.exists() else []
        pgrx = root / ".pgrx/config.toml"
        if pgrx.exists():
            calls.append("pgrx " + pgrx.read_text().replace(str(root), "$ROOT").replace("\n", " ").strip())
        handoff = root / "github-path"
        if handoff.exists():
            calls.append(f"path {handoff.read_text().strip().replace(str(root), '$ROOT')}")
        handoff = root / "github-env"
        if handoff.exists():
            calls.append(f"env {handoff.read_text().strip().replace(str(root), '$ROOT')}")
        return result, calls


# A release workflow that keeps every rule. Each self-test case breaks one.
RELEASE = """
