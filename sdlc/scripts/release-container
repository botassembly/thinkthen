#!/bin/sh
# release-container WORK OUT (ticket 0128): build the Linux loadable release files of this
# commit inside manylinux_2_28, so each needs glibc 2.28 at most, and copy them to OUT.
# The container runs as the calling user on its own copy of the commit in WORK, and never
# on this checkout. WORK/cache keeps the pinned downloads between runs. Each toolchain has
# one source: rustup-init and the channel rust-toolchain.toml names, the image's CPython
# 3.10 with maturin and PyPI's libclang wheel, the nodejs.org Node 22 tarball, the PGDG EL8
# PostgreSQL 16 RPMs unpacked as this user, cargo-pgrx 0.17.0, and the image's gcc.
# RELEASE_CARGO_REGISTRY names this user's crate registry to share, and the release files
# then build offline. cargo-pgrx, a tool outside every lock here, still fetches.
set -eu
[ $# -eq 2 ] || { echo 'usage: release-container WORK OUT' >&2; exit 2; }
IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:407f771c51a2c3e83ebe5a7970b4289ead3a6db21d9b9c089168775cad11d328
REPO=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
mkdir -p -- "$1/cache" "$2"
WORK=$(CDPATH='' cd -- "$1" && pwd) OUT=$(CDPATH='' cd -- "$2" && pwd)
rm -rf -- "$WORK/src" "$WORK/out" "$WORK/home"
mkdir -p "$WORK/src" "$WORK/out" "$WORK/home/.cargo/registry"
git -C "$REPO" archive HEAD | tar -x -C "$WORK/src"
set -- --rm --user "$(id -u):$(id -g)" -v "$WORK:/work" -e HOME=/work/home
if [ -n "${RELEASE_CARGO_REGISTRY:-}" ]; then
	set -- "$@" -v "$RELEASE_CARGO_REGISTRY:/work/home/.cargo/registry" -e CARGO_NET_OFFLINE=true
fi
docker run "$@" "$IMAGE" sh -euc '
	cache=/work/cache
	fetch() { [ -f "$cache/$1" ] || curl -fsSL -o "$cache/$1" "$2"; echo "$3  $cache/$1" | sha256sum -c --quiet; }
	fetch rustup-init https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
		20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
	maturin=maturin-1.15.0-py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.musllinux_1_1_x86_64.whl
	fetch "$maturin" "https://files.pythonhosted.org/packages/py3/m/maturin/$maturin" \
		653020a63525bb224e5ab0adf02e17a2e08bc86dbea7fc1399c9a56d7529b99e
	node=node-v22.22.3-linux-x64
	fetch "$node.tar.xz" "https://nodejs.org/dist/v22.22.3/$node.tar.xz" \
		"$(cut -d" " -f1 /work/src/libraries/typescript/node.sha256)"
	libclang=libclang-18.1.1-py2.py3-none-manylinux2010_x86_64.whl
	fetch "$libclang" "https://files.pythonhosted.org/packages/py2.py3/l/libclang/$libclang" \
		c533091d8a3bbf7460a00cb6c1a71da93bffe148f172c7d03b1c31fbf8aa2a0b
	mkdir -p /work/home/pg
	for rpm in 299c44fbae190bcf462bc98ceaca719771af2f03bf4822a188c9f39065712674:postgresql16 \
		85414ad9e7cf7dc50e6d7b1fefb706351166164de3bf6f102fae6796b973692b:postgresql16-libs \
		13df7b9f5373777bf7d0d30b7bcd8cdee2c50fe2a128be42a802a64fa7eeabf4:postgresql16-devel \
		6f68ccd50fdfe92e636bd45bd798b62750a633adfb1cc2a251d133573a67bafc:postgresql16-server; do
		file=${rpm#*:}-16.15-1PGDG.rhel8.10.x86_64.rpm
		fetch "$file" "https://download.postgresql.org/pub/repos/yum/16/redhat/rhel-8-x86_64/$file" "${rpm%%:*}"
		cp "$cache/$file" /work/home/ && (cd /work/home && rpm2archive "$file" && tar -xzf "$file.tgz" -C pg)
	done
	chmod +x "$cache/rustup-init"
	"$cache/rustup-init" -y --quiet --no-modify-path --profile minimal --default-toolchain none
	cd /work/src
	/work/home/.cargo/bin/rustup toolchain install --no-self-update --profile minimal \
		"$(sed -n "s/^channel = \"\(.*\)\"$/\1/p" rust-toolchain.toml)"
	/opt/python/cp310-cp310/bin/python -m venv /work/home/venv
	/work/home/venv/bin/pip install --quiet --no-index --no-deps "$cache/$maturin" "$cache/$libclang"
	tar -xJf "$cache/$node.tar.xz" -C /work/home
	PATH=/work/home/.cargo/bin:/work/home/venv/bin:/work/home/$node/bin:/work/home/pgrx/bin:$PATH
	CARGO_NET_OFFLINE=false cargo install --quiet --locked --root /work/home/pgrx cargo-pgrx --version 0.17.0
	# bindgen reads the image gcc's own headers beside the wheel's libclang.
	LIBCLANG_PATH=/work/home/venv/lib/python3.10/site-packages/clang/native
	BINDGEN_EXTRA_CLANG_ARGS="-I$(gcc -print-file-name=include)"
	PG_CONFIG=/work/home/pg/usr/pgsql-16/bin/pg_config
	export PATH LIBCLANG_PATH BINDGEN_EXTRA_CLANG_ARGS PG_CONFIG
	sh sdlc/scripts/release-pack x86_64-unknown-linux-gnu /work/out c sqlite duckdb postgresql python typescript
'
cp -- "$WORK"/out/* "$OUT/"
