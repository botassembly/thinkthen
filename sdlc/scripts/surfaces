#!/bin/sh
# Rung 4, after `spec`: each landed surface's check.sh, given the port of one
# loopback backend (ticket 0092). A check that exits 77 found no host
# toolchain, and the rung reports it as not run, never as a pass.
#
# `surfaces --registry` is the cheap check `lint` runs. Every landed
# surface has a check.sh and a ratchet that holds. Cargo surfaces also pass
# `cargo deny`; the named non-Cargo package manifests are checked separately.
set -eu

# `surfaces --release` counts a check that reports "not run" as a failure (ticket 0128).
. "$(dirname -- "$0")/verdict.sh"
mode=plain
profile=routine
registry_only=0
while [ "$#" -gt 0 ]; do
    case $1 in
    --release) mode=release ;;
    --full-functional) profile=full ;;
    --stress) profile=stress ;;
    --registry) registry_only=1 ;;
    *) echo "surfaces: unknown option $1" >&2; exit 2 ;;
    esac
    shift
done

if [ "$registry_only" -eq 0 ]; then
	# One heavy rung at a time on this machine. See heavy-lock.
	. "$(dirname -- "$0")/heavy-lock"
fi

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
THINKTHEN_TEST_PROFILE=$profile
export THINKTHEN_TEST_PROFILE
if [ "$profile" = routine ]; then
    THINKTHEN_CONFORMANCE_IDS="$REPO/conformance/routine-ids.txt"
    export THINKTHEN_CONFORMANCE_IDS
else
    unset THINKTHEN_CONFORMANCE_IDS
fi

landed() {
	awk '!/^#/ && $2 == "landed" { print $1 }' "$1"
}

# A `feature` line is a Cargo feature of `thinkthen` (ticket 0130). Its check
# runs with the landed ones, and the root ratchet and deny cover its code.
feature() {
	awk '!/^#/ && $2 == "feature" { print $1 }' "$1"
}

# A binding's manifest sits in its folder, or in the crate folder a third field names.
manifest() {
	case $2 in
		libraries/php) printf '%s\n' 'libraries/php/composer.json'; return ;;
		libraries/csharp) printf '%s\n' 'libraries/csharp/ThinkThen.csproj'; return ;;
		libraries/jvm) printf '%s\n' 'libraries/jvm/pom.xml'; return ;;
		libraries/dart) printf '%s\n' 'libraries/dart/pubspec.yaml'; return ;;
		libraries/swift) printf '%s\n' 'libraries/swift/Package.swift'; return ;;
		libraries/zig) printf '%s\n' 'libraries/zig/build.zig.zon'; return ;;
	esac
	awk -v at="$2" '!/^#/ && $1 == at { print $1 "/" (NF == 3 ? $3 "/" : "") "Cargo.toml" }' "$1"
}

noncargo() {
	case $1 in libraries/php|libraries/csharp|libraries/jvm|libraries/dart|libraries/swift|libraries/zig) return 0 ;; *) return 1 ;; esac
}

registry() {
	status=0
	if awk '!/^#/ && NF && (NF < 2 || NF > 3 || ($2 != "landed" && $2 != "planned" && $2 != "feature") || ($2 == "feature" && NF != 2) || $3 ~ /^\/|(^|\/)\.\.(\/|$)/) { bad = 1 } END { exit !bad }' "$1"; then
		printf 'surfaces: %s holds a line other than a folder, landed, planned, or feature, and a crate folder inside it\n' "$1" >&2
		status=1
	fi
	for surface in $(landed "$1"); do
		if noncargo "$surface" && [ "$(awk -v at="$surface" '$1 == at { print NF }' "$1")" -ne 2 ]; then
			printf 'surfaces: %s non-Cargo entry cannot name a crate folder\n' "$surface" >&2
			status=1
		fi
		if [ ! -f "$surface/check.sh" ]; then
			printf 'surfaces: %s is landed and has no check.sh\n' "$surface" >&2
			status=1
		fi
		if [ ! -f "$(manifest "$1" "$surface")" ]; then
			printf 'surfaces: %s is landed and has no named package manifest\n' "$surface" >&2
			status=1
		fi
	done
	for surface in $(feature "$1"); do
		if [ ! -f "$surface/check.sh" ] || [ -n "$(git ls-files -co --exclude-standard -- "$surface" | grep -v -e '/check\.sh$' -e '/README\.md$')" ]; then
			printf 'surfaces: %s is a feature and holds more than its check.sh and README.md\n' "$surface" >&2
			status=1
		fi
	done
	for folder in libraries/*/ databases/*/; do
		[ -d "$folder" ] || continue
		if ! { landed "$1"; feature "$1"; } | grep -qx "${folder%/}"; then
			printf 'surfaces: %s is not a landed surface in %s\n' "${folder%/}" "$1" >&2
			status=1
		fi
	done
	return "$status"
}

if [ "$registry_only" -eq 1 ]; then
	registry sdlc/surfaces.txt
	planted=$(mktemp)
	trap 'rm -f -- "$planted" "$planted.json" "$planted.pid" "$planted.term"' EXIT
	{ cat sdlc/surfaces.txt; echo 'libraries/planted landed'; } >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed a landed surface with no check.sh' >&2
		exit 1
	fi
	sed 's|^libraries/csharp  *landed$|libraries/csharp landed src|' sdlc/surfaces.txt >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed a non-Cargo surface with a crate-folder override' >&2
		exit 1
	fi
	sed 's|^libraries/php  *landed$|libraries/php landed src|' sdlc/surfaces.txt >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed PHP with a crate-folder override' >&2
		exit 1
	fi
	sed 's|^libraries/dart  *landed$|libraries/dart landed src|' sdlc/surfaces.txt >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed Dart with a crate-folder override' >&2
		exit 1
	fi
	for surface in swift zig; do
		sed "s|^libraries/$surface  *landed$|libraries/$surface landed src|" sdlc/surfaces.txt >"$planted"
		if registry "$planted" 2>/dev/null; then
			echo "surfaces: the registry check passed $surface with a crate-folder override" >&2
			exit 1
		fi
	done
	# R's crate sits inside its R package. A line without its crate folder fails.
	sed 's|^\(libraries/r  *landed\) .*|\1|' sdlc/surfaces.txt >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed a landed surface whose line names no Cargo.toml' >&2
		exit 1
	fi
	sed 's|^\(libraries/r  *landed\) .*|\1  ../rust|' sdlc/surfaces.txt >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed a crate folder outside its binding' >&2
		exit 1
	fi
	# A feature folder holds no code of its own. The Rust examples' folder does.
	sed 's|^libraries/rust  *landed$|libraries/rust feature|' sdlc/surfaces.txt >"$planted"
	if registry "$planted" 2>/dev/null; then
		echo 'surfaces: the registry check passed a feature folder that holds a Cargo.toml' >&2
		exit 1
	fi
	for surface in $(landed sdlc/surfaces.txt); do
		# One ratchet file per language: ratchet.json for Rust, ratchet.<ext>.json for each host.
		for config in "$surface"/ratchet*.json; do
			node sdlc/scripts/ratchet.mjs "$config"
			jq --arg at "$REPO/$surface/" '.max += 1 | .directory = ([.directory] | flatten | map($at + .))' \
				"$config" >"$planted.json"
			if node sdlc/scripts/ratchet.mjs "$planted.json" >/dev/null 2>&1; then
				echo "surfaces: the ratchet passed a ceiling one above $config's count" >&2
				exit 1
			fi
		done
		# A binding's own deny.toml, which policy.py checks, replaces the root file.
		deny=deny.toml
		if [ -f "$surface/deny.toml" ]; then deny="$surface/deny.toml"; fi
		if ! noncargo "$surface"; then
			cargo deny --offline --manifest-path "$(manifest sdlc/surfaces.txt "$surface")" check --config "$deny" \
				advisories bans licenses sources
		fi
	done
	# The release rule over 0, 77, and 1 in both modes, with the exact lines.
	got=$(for m in plain release; do for c in 0 77 1; do if verdict "$m" planted "$c"; then echo '-> 0'; else echo '-> 1'; fi; done; done)
	pass='surfaces: pass planted' fail='surfaces: FAIL planted (exit 1)'
	want=$(printf '%s\n' "$pass" '-> 0' 'surfaces: not run planted (no host toolchain)' '-> 0' "$fail" '-> 1' \
		"$pass" '-> 0' 'surfaces: FAIL planted (not run)' '-> 1' "$fail" '-> 1')
	if [ "$got" != "$want" ]; then
		printf 'surfaces: the release rule printed\n%s\n' "$got" >&2
		exit 1
	fi
	# time-limit returns the command's code, or 124 with nothing it started left alive.
	limit=$(dirname -- "$0")/time-limit
	fast=0 slow=0
	sh "$limit" 5 sh -c 'exit 3' || fast=$?
	sh "$limit" 1 sh -c 'sleep 30 & echo $! >"$0"; sleep 3' "$planted.pid" 2>/dev/null || slow=$?
	if [ "$fast" -ne 3 ] || [ "$slow" -ne 124 ] || kill -0 "$(cat "$planted.pid")" 2>/dev/null; then
		echo "surfaces: time-limit returned $fast and $slow, or left a process alive" >&2
		exit 1
	fi
	# A TERM to time-limit reaches the command's children, even one that ignores TERM, and exits 143.
	sh "$limit" 30 sh -c 'trap "" TERM; sleep 30 & echo $! >"$0"; wait' "$planted.term" &
	outer=$! term=0 i=0
	while [ ! -s "$planted.term" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
	if [ ! -s "$planted.term" ]; then
		echo "surfaces: the TERM row's command never wrote its grandchild's pid" >&2
		exit 1
	fi
	kill "$outer"
	i=0
	while kill -0 "$(cat "$planted.term")" 2>/dev/null && [ "$i" -lt 40 ]; do sleep 0.1; i=$((i + 1)); done
	if kill -0 "$(cat "$planted.term")" 2>/dev/null; then
		echo "surfaces: a TERM to time-limit left a process alive after 4 seconds" >&2
		exit 1
	fi
	wait "$outer" || term=$?
	if [ "$term" -ne 143 ]; then
		echo "surfaces: a TERM to time-limit returned $term" >&2
		exit 1
	fi
	echo 'surfaces: the registry holds every binding, and each landed one has its check, ratchet, and deny'
	exit 0
fi

registry sdlc/surfaces.txt
. "$(dirname -- "$0")/scratch.sh"
. "$(dirname -- "$0")/installed.sh"
backend_start

failed=0 skipped=
for surface in $(landed sdlc/surfaces.txt) $(feature sdlc/surfaces.txt); do
	set +e
	# A daemon a check starts must not hold the backend's input open.
	sh "$surface/check.sh" "$port" 3>&-
	code=$?
	set -e
	[ "$code" -ne 77 ] || skipped="$skipped $surface"
	verdict "$mode" "$surface" "$code" || failed=1
done
[ "$failed" -eq 0 ] || exit 1
# The host's release files, packed from the builds above and each smoked from its install
# (ticket 0128). A surface that did not run built nothing to pack. --release failed it above.
if [ -n "$skipped" ]; then
	echo "surfaces: not run release smoke (${skipped# } did not run)"
	exit 0
fi
scratch_dir packed
code=0
{ sh sdlc/scripts/release-pack --reuse "$(rustc -vV | sed -n 's/^host: //p')" "$packed" &&
	sh sdlc/scripts/release-smoke "$packed"; } 3>&- || code=$?
verdict "$mode" "release smoke" "$code"
