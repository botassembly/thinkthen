#!/usr/bin/env python3
"""The how-to lists and the folders under demos/ say the same thing.

ADR 0018 fixed the original list of 20, and ticket 0088 added page 45. Three places carry it: `demos/README.md`,
`sdlc/planning/documentation-plan.md`, and the folders themselves. This check
holds them together and refuses a link that goes nowhere.

Usage: pages [ROOT]. ROOT defaults to the repository, and the self-test hands
it a small tree built to break one rule at a time.
"""

import pathlib
import re
import sys

LIST_HEADER = re.compile(r"^\|\s*#\s*\|\s*How to\s*\|")
ROW = re.compile(r"^\|\s*(\d{2})\s*\|(.*)$")
LINK = re.compile(r"\[([^\]]*)\]\(([^)]+)\)")
NUMBER = re.compile(r"\b(\d{2})\b")
ADR_WINDOW = re.compile(r"^\|\s*#\s*\|\s*How to\s*\|\s*Shows\s*\|")
TOP_WINDOW = re.compile(r"^\|\s*How to\s*\|\s*The job\s*\|")
FENCE = re.compile(r"^\s*```")

INDEX = "demos/README.md"
PLAN = "sdlc/planning/documentation-plan.md"
ADR = "sdlc/planning/adr/0018-twenty-how-tos-and-three-themes.md"
TOP = "README.md"


def prose(text):
    """The lines outside every fenced block. A block may show a table."""
    out, fenced = [], False
    for line in text.splitlines():
        if FENCE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            out.append(line)
    return out


def rows(path):
    """Every row of every table whose header reads `| # | How to |`."""
    found, reading = {}, False
    for line in prose(path.read_text()):
        if LIST_HEADER.match(line):
            reading = True
            continue
        if reading and not line.startswith("|"):
            reading = False
        if not reading:
            continue
        hit = ROW.match(line)
        if not hit:
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 4:
            continue
        number, title, state = cells[0], cells[1], cells[3]
        link = LINK.match(title)
        found[number] = {
            "title": link.group(1) if link else title,
            "target": link.group(2) if link else None,
            "state": state,
            "word": state.split(",")[0].strip().lower(),
            "line": line,
        }
    return found


def three(path, header):
    """The three-cell rows of the one table under `header`, in order."""
    out, reading = [], False
    for line in prose(path.read_text()):
        if header.match(line):
            reading = True
            continue
        if reading and not line.startswith("|"):
            reading = False
        if not reading or line.startswith("| ---"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) == 3:
            out.append(cells)
    return out


def adr_window(root):
    """ADR 0018's front window: (number, title), in its order."""
    return [(cells[0], cells[1])
            for cells in three(root / ADR, ADR_WINDOW)]


def top_window(root):
    """The README's front window: (number, title, is a link), in its order."""
    out = []
    for title, _job, door in three(root / TOP, TOP_WINDOW):
        number = NUMBER.search(door)
        out.append((number.group(1) if number else "", title,
                    bool(LINK.search(door))))
    return out


def links(path):
    """Every relative link outside a fenced block, with its line."""
    for line in prose(path.read_text()):
        for text, target in LINK.findall(line):
            if target.startswith(("http:", "https:", "#", "mailto:")):
                continue
            yield text, target.split("#")[0]


def check(root):
    bad = []

    def fail(where, said):
        bad.append(f"pages: {where}: {said}")

    index, plan = root / INDEX, root / PLAN
    for path in (index, plan, root / ADR, root / TOP):
        if not path.is_file():
            fail(str(path.relative_to(root)), "is missing")
    if bad:
        return bad

    listed, planned = rows(index), rows(plan)
    # A renamed column heading would read no table at all, and every check
    # below would then pass on nothing. An empty list is the one state that
    # cannot be right.
    for where, found in ((INDEX, listed), (PLAN, planned)):
        if not found:
            fail(where, "holds no table headed `| # | How to |`, "
                 "so this check would read nothing")
    if bad:
        return bad

    for number in sorted(set(listed) | set(planned)):
        if number not in listed:
            fail(INDEX, f"lists no how-to {number}, and {PLAN} does")
            continue
        if number not in planned:
            fail(PLAN, f"lists no how-to {number}, and {INDEX} does")
            continue
        here, there = listed[number], planned[number]
        if here["title"] != there["title"]:
            fail(
                PLAN,
                f"how-to {number} is titled [{there['title']}], "
                f"and {INDEX} titles it [{here['title']}]",
            )
        if here["state"] != there["state"]:
            fail(
                PLAN,
                f"how-to {number} is {there['state']}, "
                f"and {INDEX} says {here['state']}",
            )

    demos = root / "demos"
    folders = sorted(p for p in demos.glob("[0-9]*") if p.is_dir())
    named = {row["target"].rstrip("/") for row in listed.values()
             if row["target"]}
    for folder in folders:
        if folder.name not in named:
            fail(INDEX, f"links no folder {folder.name}, and demos/ holds it")

    for number, row in sorted(listed.items()):
        if row["word"] not in ("green", "coming", "leaving"):
            fail(INDEX, f"how-to {number} is [{row['word']}], "
                 "and a state is green, coming, or leaving")
            continue
        folder = None
        if row["target"]:
            folder = demos / row["target"].rstrip("/")
            if not folder.is_dir():
                fail(INDEX, f"how-to {number} links {row['target']}, "
                     "and demos/ holds no such folder")
                continue
        else:
            matches = [p for p in folders if p.name.startswith(number + "-")]
            if matches:
                folder = matches[0]
        if folder is None:
            if row["word"] != "coming":
                fail(INDEX, f"how-to {number} is {row['word']} "
                     "and links no folder")
            continue
        page = folder / "README.md"
        if not page.is_file():
            fail(INDEX, f"{folder.name} holds no README.md")
            continue
        said = prose(page.read_text())
        # A page that is leaving says so on its own first lines, so a reader
        # who opens the folder learns it before the how-to.
        if row["word"] == "leaving":
            if not any(line.startswith("Absorbed by") for line in said):
                fail(f"demos/{folder.name}/README.md",
                     f"is leaving, and no line of it starts [Absorbed by]")
            continue
        status = [line for line in said if line.startswith("Status: ")]
        wanted = "Status: green" if row["word"] == "green" else "Status: red"
        if wanted not in status:
            fail(f"demos/{folder.name}/README.md",
                 f"says {status or ['no status line']}, "
                 f"and {INDEX} wants [{wanted}]")
        if row["word"] != "green":
            continue
        heads = [line for line in said if line.startswith("# ")]
        head = heads[0][2:] if heads else ""
        title = row["title"]
        wanted_head = "How to " + title[0].lower() + title[1:]
        if head != wanted_head:
            fail(f"demos/{folder.name}/README.md",
                 f"is titled [{head}], and {INDEX} wants [{wanted_head}]")

    # The README's front window is the seven pages ADR 0018 named, in its
    # order, under the list's own titles, and a page that is not green yet
    # says so where its link would be.
    wanted_window = adr_window(root)
    if not wanted_window:
        fail(ADR, "holds no table headed `| # | How to | Shows |`")
    else:
        shown = top_window(root)
        if [number for number, _t in wanted_window] != [n for n, _t, _l in shown]:
            fail(TOP, "features "
                 f"{[n for n, _t, _l in shown]}, and {ADR} names "
                 f"{[n for n, _t in wanted_window]}")
        else:
            for (number, _adr_title), (_n, title, is_link) in zip(
                    wanted_window, shown):
                row = listed.get(number)
                if row is None:
                    fail(TOP, f"features how-to {number}, "
                         f"and {INDEX} lists no such page")
                    continue
                if title != row["title"]:
                    fail(TOP, f"titles how-to {number} [{title}], "
                         f"and {INDEX} titles it [{row['title']}]")
                if is_link != (row["word"] == "green"):
                    fail(TOP, f"how-to {number} is {row['word']} and "
                         f"{'links a folder' if is_link else 'links nothing'}")

    pages = [index, plan, root / TOP] + [
        folder / "README.md" for folder in folders
    ]
    for path in pages:
        if not path.is_file():
            continue
        for text, target in links(path):
            if not (path.parent / target).exists():
                fail(str(path.relative_to(root)),
                     f"links [{text}] to {target}, and nothing is there")
    return bad


def main():
    root = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else
                        pathlib.Path(__file__).resolve().parents[2])
    bad = check(root)
    for line in bad:
        print(line, file=sys.stderr)
    if bad:
        return 1
    listed = rows(root / INDEX)
    tally = {}
    for row in listed.values():
        tally[row["word"]] = tally.get(row["word"], 0) + 1
    print("pages: " + ", ".join(f"{count} {word}"
                                for word, count in sorted(tally.items())))
    return 0


if __name__ == "__main__":
    sys.exit(main())
