#!/usr/bin/env python3
"""Every relative link on the README, the documentation plan, and the how-to pages goes somewhere.

Usage: pages [ROOT]. ROOT defaults to the repository. With --self-test, it
runs the check against a small tree with one good link and one dead link.
"""

import pathlib
import re
import sys
import tempfile

LINK = re.compile(r"\[([^\]]*)\]\(([^)]+)\)")
FENCE = re.compile(r"^\s*```")


def links(path):
    """Every relative link outside a fenced block."""
    fenced = False
    for line in path.read_text().splitlines():
        if FENCE.match(line):
            fenced = not fenced
            continue
        if fenced:
            continue
        for text, target in LINK.findall(line):
            if not target.startswith(("http:", "https:", "#", "mailto:")):
                yield text, target.split("#")[0]


def check(root):
    pages = [root / "README.md", root / "demos" / "README.md",
             root / "sdlc" / "planning" / "documentation-plan.md"]
    pages += sorted((root / "demos").glob("[0-9]*/README.md"))
    bad = []
    for path in pages:
        if not path.is_file():
            continue
        for text, target in links(path):
            if not (path.parent / target).exists():
                bad.append(f"pages: {path.relative_to(root)}: links [{text}] "
                           f"to {target}, and nothing is there")
    return bad, len(pages)


def self_test():
    with tempfile.TemporaryDirectory() as tmp:
        root = pathlib.Path(tmp)
        (root / "demos" / "01-gate").mkdir(parents=True)
        (root / "demos" / "README.md").write_text("[gate](01-gate/)\n")
        (root / "demos" / "01-gate" / "README.md").write_text("```\n[x](nowhere)\n```\n")
        (root / "README.md").write_text("[the list](demos/LIST.md) [web](https://x)\n")
        bad, _ = check(root)
    wanted = ["pages: README.md: links [the list] to demos/LIST.md, and nothing is there"]
    if bad != wanted:
        print(f"pages self-test: expected {wanted}, got {bad}", file=sys.stderr)
        return 1
    print("pages self-test: passed")
    return 0


def main(argv):
    if argv[1:] == ["--self-test"]:
        return self_test()
    root = pathlib.Path(argv[1]) if len(argv) > 1 else pathlib.Path(__file__).resolve().parents[2]
    bad, count = check(root)
    for line in bad:
        print(line, file=sys.stderr)
    if bad:
        return 1
    print(f"pages: every relative link on {count} pages resolves")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
