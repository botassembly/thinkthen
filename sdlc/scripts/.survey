#!/bin/sh
# Run every demo page marked green, from its own folder, against the binary on PATH.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
ROOT=${1:-demos}

# A demo replays a recording, so neither variable may reach one.
unset THINKTHEN_API_KEY THINKTHEN_BASE_URL

if ! command -v mustmatch >/dev/null 2>&1; then
	printf 'demos: mustmatch is not on PATH\n' >&2
	exit 1
fi

cd -- "$REPO/$ROOT"

# The status line and the form are read from the prose alone. A block on a page
# may show a heading or a status line as an example, and an example is not the
# form it shows.
prose() {
	awk '/^```/ { fenced = !fenced; next } !fenced' "$1"
}

green=0
red=0
for page in */README.md; do
	[ -f "$page" ] || continue
	folder=$(dirname -- "$page")
	if ! prose "$page" | grep -q '^Status: green$'; then
		red=$((red + 1))
		continue
	fi
	# A green page is a how-to, as ADR 0011 rules. The form is the title, the
	# traps section, and a line in the index, and a red page is never checked.
	# A title names the task the reader came for, so the two words alone fail.
	title=$(prose "$page" | sed -n 's/^# //p' | head -1)
	case "$title" in
	'How to '?*) ;;
	*)
		printf 'demos: %s is green, and its title does not start with "How to" and a task\n' "$page" >&2
		exit 1
		;;
	esac
	if ! prose "$page" | grep -q '^## What can go wrong$'; then
		printf 'demos: %s is green, and it has no "What can go wrong" section\n' "$page" >&2
		exit 1
	fi
	if ! grep -q -- "$folder/" README.md; then
		printf 'demos: %s is green, and README.md lists no %s\n' "$page" "$folder" >&2
		exit 1
	fi
	# A green page replays a recording. A folder it names and does not hold
	# would send the page to a backend, so the run stops here instead.
	# A page names the folder in its blocks and in its prose, where a backtick
	# closes the name, so a backtick ends the name here too.
	sed -n 's/.*--replay \([^ `]*\).*/\1/p' "$page" | sort -u | while IFS= read -r named; do
		if [ -z "$named" ]; then
			printf 'demos: %s writes --replay with no folder name after it\n' "$page" >&2
			exit 1
		fi
		if [ ! -d "$folder/$named" ]; then
			printf 'demos: %s is green, and it names no folder %s\n' "$page" "$named" >&2
			exit 1
		fi
	done || exit 1
	# ADR 0016 puts limits on top of the form, and these are the ones a
	# script can measure. A failure names the page, the rule, and the number.
	# The fenced blocks stay in, because rules 2 and 3 are about them.
	awk -v page="$page" '
		function fail(rule, detail) {
			printf "demos: %s breaks rule %s of ADR 0016: %s\n", page, rule, detail > "/dev/stderr"
			broken = 1
		}
		function heading(line,   text) {
			text = substr(line, 4)
			sub(/[ \t]+$/, "", text)
			return text
		}
		{ words += NF }
		/^```/ {
			if (fenced) {
				fenced = 0
				if (kind == "bash") {
					if (asserts) asserting++
					else if (!silent) silent = opened
				}
				next
			}
			fenced = 1
			asserts = 0
			opened = NR
			kind = substr($0, 4)
			sub(/[ \t]+$/, "", kind)
			if (!first) first = NR
			next
		}
		{
			rest = $0
			while (match(rest, /thinkthen (decide|choose|score|filter|rank|annotate|find)/)) {
				used[substr(rest, RSTART + 10, RLENGTH - 10)] = 1
				rest = substr(rest, RSTART + RLENGTH)
			}
		}
		fenced {
			if (index($0, "mustmatch")) asserts = 1
			if (opened == first) {
				if (!reached && $0 ~ /thinkthen [a-z]/) reached = NR - first
				if (!prepared && ($0 ~ /mktemp/ || $0 ~ /(^|[ \t;])trap[ \t]/ || index($0, "<<")))
					prepared = NR - first
			}
			next
		}
		/^# / && !title { title = substr($0, 3) }
		/^## / {
			text = heading($0)
			if (text == "What this demo decides") argued = NR
			else if (text == "Related how-tos") closing = NR
			else if (text != "Input" && text != "What can go wrong") steps++
		}
		closing && /^- / {
			links++
			if (match($0, /\]\([^)]*\)/)) {
				target = substr($0, RSTART + 2, RLENGTH - 3)
				if (target in seen && !repeated) repeated = target
				seen[target] = 1
			}
		}
		END {
			if (NR > 120) fail(1, NR " lines, and the limit is 120")
			if (words > 900) fail(1, words " words, and the limit is 900")
			if (!first) fail(2, "no fenced block at all, so a reader sees no result")
			else {
				if (first > 20) fail(2, "the first block starts on line " first ", and the limit is 20")
				if (reached > 5) fail(2, "the first thinkthen line is " reached " lines into the first block, and the limit is 5")
				if (prepared) fail(2, "the first block sets up on line " prepared ", and nothing is set up before the first result")
			}
			if (asserting > 6) fail(3, asserting " blocks that assert, and the limit is 6")
			if (silent) fail(3, "the bash block on line " silent " asserts nothing")
			commands = 0
			for (verb in used) { commands++; order[verb] = 1 }
			if (commands > 1) {
				named = 0
				list = ""
				n = 0
				for (verb in order) sorted[++n] = verb
				for (i = 1; i < n; i++)
					for (j = i + 1; j <= n; j++)
						if (sorted[j] < sorted[i]) { swap = sorted[i]; sorted[i] = sorted[j]; sorted[j] = swap }
				for (i = 1; i <= n; i++) {
					if (index(title, sorted[i])) named++
					list = list (i == 1 ? "" : (i == n ? " and " : ", ")) sorted[i]
				}
				if (named < commands)
					fail(4, commands " commands, " list ", and the title names " named)
			}
			if (steps > 4) fail(5, steps " steps, and the limit is 4")
			if (argued) fail(7, "a \"What this demo decides\" section on line " argued)
			if (links > 4) fail(8, links " closing links, and the limit is 4")
			if (repeated) fail(8, "two closing links go to " repeated)
			exit broken
		}
	' "$page" || true
	# mustmatch runs a block from the folder of the page it came from, so the
	# relative paths a demo reads its own input files by are the demo's own.
	printf 'demos: running %s\n' "$page"
	true
	green=$((green + 1))
done
printf 'demos: %s green, %s red\n' "$green" "$red"
