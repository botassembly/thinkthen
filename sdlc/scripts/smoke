#!/bin/sh
# One replay smoke per binding (ticket 0335), four at a time. `test` runs it beside nextest.
#
# For each surface, this script starts its own loopback backend and seeds a fresh cache folder
# with conformance case 01's recorded decide exchange, through the command. The binding's
# check.sh then runs with THINKTHEN_TEST_PROFILE=smoke and the loopback port as $1. It builds
# the installed shape, loads it from there, and asks the same question through the binding's
# default engine, which reads THINKTHEN_BASE_URL, THINKTHEN_CACHE and THINKTHEN_API_KEY. The
# question is THINKTHEN_SMOKE_QUESTION and the text THINKTHEN_SMOKE_TEXT. Its last line on
# standard output is `smoke: true`. The smoke passes when that line matches case 01's answer
# and the backend counted the seed's one request and no other. A check that exits 77 found no
# host toolchain and reports "not run".
#
# `smoke SURFACE...` runs the named surfaces alone.
set -eu
. "$(dirname -- "$0")/heavy-lock"
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
. sdlc/scripts/scratch.sh
case_id=01-decide-yes-captured
# The surfaces the rung smokes. PostgreSQL and Polars stay in the routine surfaces rung; see ticket 0335.
skipped='libraries/polars databases/postgresql'

one() {
	scratch_dir work
	mkdir "$work/cache" "$work/config" "$work/usage"
	mkfifo "$work/in"
	target/debug/conformance-backend <"$work/in" >"$work/out" 2>"$work/backend.err" &
	exec 3>"$work/in"
	tries=0
	until [ -s "$work/out" ]; do
		tries=$((tries + 1))
		[ "$tries" -le 100 ] || { echo "smoke: FAIL $1 (the loopback backend printed no port)"; return 1; }
		sleep 0.1
	done
	port=$(head -n 1 "$work/out")
	THINKTHEN_SMOKE_QUESTION=$(jq -r --arg id "$case_id" '.cases[] | select(.id == $id) | .question.decide' conformance/cases.json)
	# The mark keeps the text's last newline, which command substitution would drop.
	THINKTHEN_SMOKE_TEXT=$(jq -j --arg id "$case_id" '.cases[] | select(.id == $id) | .exchanges[0].evidence' conformance/cases.json; echo .)
	THINKTHEN_SMOKE_TEXT=${THINKTHEN_SMOKE_TEXT%.}
	want=$(jq -r --arg id "$case_id" '.cases[] | select(.id == $id) | .expect.success.answers[0].bare' conformance/cases.json)
	export THINKTHEN_SMOKE_QUESTION THINKTHEN_SMOKE_TEXT XDG_CONFIG_HOME="$work/config" THINKTHEN_CACHE="$work/cache" \
		THINKTHEN_API_KEY=sk-smoke-loopback THINKTHEN_BASE_URL="http://127.0.0.1:$port/case/$case_id/v1"
	seeded=$(printf '%s' "$THINKTHEN_SMOKE_TEXT" | XDG_CACHE_HOME="$work/usage" target/debug/thinkthen decide "$THINKTHEN_SMOKE_QUESTION") || {
		echo "smoke: FAIL $1 (the seed printed $seeded)"; return 1; }
	code=0
	THINKTHEN_TEST_PROFILE=smoke sh "$1/check.sh" "$port" 3>&- >"$work/log" 2>&1 || code=$?
	echo count >&3
	exec 3>&-
	wait
	got=$(tail -n 1 "$work/log")
	count=$(tail -n 1 "$work/out")
	case $code in
	0) if [ "$seeded" = "$want" ] && [ "$got" = "smoke: $want" ] && [ "$count" = 1 ]; then
		echo "smoke: pass $1"; return 0
	fi
		reason="printed '$got' with $count requests, not 'smoke: $want' with the seed's 1" ;;
	77) echo "smoke: not run $1 (no host toolchain)"; return 0 ;;
	*) reason="exit $code" ;;
	esac
	echo "smoke: FAIL $1 ($reason)"
	sed 's/^/    /' "$work/log" "$work/backend.err"
	return 1
}

if [ "${1:-}" = --one ]; then
	one "$2"
	exit
fi
# ADR 0113: a smoke that bypasses its check's scratch usage folder writes this decoy and fails.
usage_guard
cargo build --locked --offline --quiet --package conformance-backend --bin conformance-backend --package thinkthen --bin thinkthen
if [ "$#" -eq 0 ]; then
	set -- $(awk '!/^#/ && ($2 == "landed" || $2 == "feature") { print $1 }' sdlc/surfaces.txt)
	for surface in $skipped; do
		set -- $(printf '%s\n' "$@" | grep -vx "$surface")
	done
fi
printf '%s\n' "$@" | xargs -P 4 -n 1 sh "$0" --one
