#!/usr/bin/env python3
"""Collect release-only coverage from native and installed library tests."""
import argparse
import datetime
import ctypes
import json
import importlib
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'sdlc/scripts'))
from check_verdict import verdict
from coverage_report import report, UNIT_COLLECTIONS, join_platforms

NATIVE_COLLECTIONS = ('rust-integration', *UNIT_COLLECTIONS)


class MissingTool(Exception):
    pass


def reap_adopted(group, excluded):
    """Reap only adopted children from this command's Linux process group."""
    for task in Path('/proc/self/task').iterdir():
        children = task / 'children'
        try:
            values = children.read_text().split()
        except FileNotFoundError:
            continue
        for value in values:
            pid = int(value)
            if pid in excluded:
                continue
            try:
                if os.getpgid(pid) == group:
                    os.waitpid(pid, os.WNOHANG)
            except (ProcessLookupError, ChildProcessError):
                pass


def command(args, cwd, env, log, *, capture=False, timeout=None):
    """Own the harness group and reap its children, preserving exit and output."""
    if sys.platform == 'linux':
        # Adopt orphaned grandchildren so group cleanup can reap them too.
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.prctl(36, 1, 0, 0, 0):  # PR_SET_CHILD_SUBREAPER
            raise OSError(ctypes.get_errno(), 'cannot own coverage descendants')
    existing = set()
    if sys.platform == 'linux':
        for task in Path('/proc/self/task').iterdir():
            try:
                existing.update(map(int, (task / 'children').read_text().split()))
            except FileNotFoundError:
                continue
    started = time.monotonic()
    deadline = started + timeout if timeout is not None else None
    timed_out = False
    with log.open('wb') as output:
        child = subprocess.Popen(args, cwd=cwd, env=env, stdout=subprocess.PIPE if capture else output,
                                 stderr=output, start_new_session=True)
        try:
            try:
                if sys.platform != 'linux':
                    stdout, _ = child.communicate(timeout=timeout)
                else:
                    # A harness can check kill(pid, 0) before exiting itself.
                    # Reap its orphaned children while it is still running.
                    while True:
                        reap_adopted(child.pid, existing | {child.pid})
                        remaining = deadline - time.monotonic() if deadline is not None else None
                        if remaining is not None and remaining <= 0:
                            raise subprocess.TimeoutExpired(args, timeout)
                        try:
                            stdout, _ = child.communicate(timeout=min(0.05, remaining)
                                                          if remaining is not None else 0.05)
                            break
                        except subprocess.TimeoutExpired:
                            continue
            except subprocess.TimeoutExpired:
                timed_out = True
                os.killpg(child.pid, signal.SIGKILL)
                stdout, _ = child.communicate()
            if capture:
                output.write(stdout)
        finally:
            # Also clean up on interruption or a harness that leaves children.
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.wait()
            if sys.platform == 'linux':
                while True:
                    try:
                        os.waitpid(-child.pid, 0)
                    except ChildProcessError:
                        break
    print(f'{log.name}: exit {child.returncode}, elapsed {time.monotonic() - started:.1f}s', flush=True)
    if timed_out:
        raise RuntimeError(f'timed out (exit {child.returncode}): {shlex.join(args)}; see {log}')
    if child.returncode:
        if not verdict('coverage collection', child.returncode, 'coverage'):
            raise RuntimeError(f'exit {child.returncode}: {shlex.join(args)}; see {log}')
    return stdout if capture else None


def tools():
    for name in ('cargo', 'rustc', 'cc', 'git'):
        if not shutil.which(name):
            raise MissingTool(name)
    sysroot = subprocess.check_output(['rustc', '--print', 'sysroot'], cwd=ROOT, text=True).strip()
    version = subprocess.check_output(['rustc', '-vV'], cwd=ROOT, text=True)
    if not version.startswith('rustc 1.95.0 '):
        raise MissingTool('Rust 1.95.0 from rust-toolchain.toml')
    host = next(line.removeprefix('host: ') for line in version.splitlines() if line.startswith('host: '))
    llvm = Path(sysroot) / 'lib/rustlib' / host / 'bin'
    for name in ('llvm-profdata', 'llvm-cov'):
        if not (llvm / name).is_file():
            raise MissingTool(f'Rust 1.95.0 llvm-tools-preview: {name}')
    return llvm


def activate(run, name):
    folder = run / name
    folder.mkdir()
    active = run / 'active'
    if active.is_symlink():
        active.unlink()
    active.symlink_to(folder, target_is_directory=True)
    return folder


def test_artifacts(messages, package):
    launch = {'CARGO_PKG_NAME': package['name'],
              'CARGO_MANIFEST_DIR': str(Path(package['manifest_path']).parent)}
    artifacts = []
    for line in messages.splitlines():
        item = json.loads(line)
        if (item.get('reason') == 'compiler-artifact' and item.get('executable')
                and item.get('profile', {}).get('test')):
            artifacts.append((item['target']['kind'], item['target']['name'], item['executable'], launch))
    return artifacts


def build_c_units(run, env):
    c_env = {**env, 'CARGO_TARGET_DIR': str(run / 'target-c')}
    metadata = json.loads(command(['cargo', 'metadata', '--manifest-path', 'libraries/c/Cargo.toml',
                                  '--offline', '--no-deps', '--format-version', '1'],
                                  ROOT, c_env, run / 'metadata-c.log', capture=True))
    package = next(item for item in metadata['packages'] if item['name'] == 'thinkthen-c')
    messages = command(['cargo', 'test', '--manifest-path', 'libraries/c/Cargo.toml', '--offline',
                        '--locked', '--lib', '--no-run', '--message-format=json', '-j2'],
                       ROOT, c_env, run / 'build-c-units.log', capture=True)
    return test_artifacts(messages, package)


def build(run, env):
    metadata = json.loads(command(['cargo', 'metadata', '--offline', '--no-deps', '--format-version', '1'],
                                  ROOT, env, run / 'metadata.log', capture=True))
    artifacts = []
    excluded_targets = {}
    for name, unit_target in (('thinkthen', ['--lib']), ('thinkthen-cli', ['--bin', 'thinkthen'])):
        package = next(item for item in metadata['packages'] if item['name'] == name)
        features = set(package['features'].get('default', []))
        while True:
            expanded = features | {value for feature in features for value in package['features'].get(feature, [])}
            if expanded == features:
                break
            features = expanded
        tests = [item for item in package['targets'] if item['kind'] == ['test']]
        excluded = [item['name'] for item in tests if not set(item.get('required-features', [])).issubset(features)]
        excluded_targets[name] = excluded
        args = ['cargo', 'test', '--offline', '--locked', '-p', name, *unit_target, '--no-run',
                '--message-format=json', '-j2']
        for target in tests:
            if target['name'] not in excluded:
                args += ['--test', target['name']]
        messages = command(args, ROOT, env, run / f'build-tests-{name}.log', capture=True)
        artifacts += test_artifacts(messages, package)
    (run / 'excluded-targets.json').write_text(json.dumps(excluded_targets) + '\n')
    artifacts += build_c_units(run, env)
    command(['cargo', 'build', '--offline', '--locked', '-p', 'thinkthen-cli', '--bin', 'thinkthen', '-j2'],
            ROOT, env, run / 'build-production.log')
    # C is a separate workspace. Keep its native production mappings even before installed collection.
    command(['cargo', 'build', '--manifest-path', 'libraries/c/Cargo.toml', '--offline', '--locked', '--lib', '-j2'],
            ROOT, {**env, 'CARGO_TARGET_DIR': str(run / 'target-c')}, run / 'build-c.log')
    return artifacts


def collect_tests(run, env, artifacts, name):
    folder = activate(run, name)
    selected = [item for item in artifacts
                if ((item[0] == ['test'] and item[3]['CARGO_PKG_NAME'] in ('thinkthen', 'thinkthen-cli'))
                    if name == 'rust-integration' else
                    (item[0] != ['test'] and item[3]['CARGO_PKG_NAME'] ==
                     {'cli-source': 'thinkthen-cli', 'source-unit': 'thinkthen',
                      'c-source-unit': 'thinkthen-c'}[name]))]
    if not selected:
        raise RuntimeError(f'{name}: no test executables')
    for kind, target, path, launch in selected:
        args = [path, '--test-threads=2']
        log_name = f'{launch["CARGO_PKG_NAME"]}-{target}' if launch['CARGO_PKG_NAME'] == 'thinkthen-cli' else target
        command(args, Path(launch['CARGO_MANIFEST_DIR']), {**env, **launch},
                folder / f'{log_name}.log', timeout=1800)


def collect(run, env, artifacts, native_tests=True):
    executable = run / 'target/debug/thinkthen'
    folder = activate(run, 'inventory')
    command([str(executable), '--version'], ROOT, env, folder / 'version.log')
    for name in NATIVE_COLLECTIONS if native_tests else ():
        collect_tests(run, env, artifacts, name)
    return executable


def export(run, llvm, objects, name, env):
    folder = run / name
    valid = []
    rejected = []
    for index, raw in enumerate(sorted(folder.glob('*.profraw'))):
        probe = folder / 'validate.profdata'
        with (folder / f'profile-{index}.log').open('wb') as diagnostics:
            result = subprocess.run([str(llvm / 'llvm-profdata'), 'merge', '-sparse', str(raw), '-o', str(probe)],
                                    stdout=diagnostics, stderr=diagnostics, check=False)
        if result.returncode:
            rejected.append({'file': raw.name, 'exit': result.returncode, 'diagnostics': f'profile-{index}.log'})
        else:
            valid.append(str(raw))
    (folder / 'rejected.json').write_text(json.dumps(rejected, indent=2) + '\n')
    if not valid:
        raise RuntimeError(f'{name}: no valid profiles; rejected profiles remain in {folder}')
    profile = folder / 'merged.profdata'
    command([str(llvm / 'llvm-profdata'), 'merge', '-sparse', *valid, '-o', str(profile)],
            ROOT, env, folder / 'merge.log')
    args = [str(llvm / 'llvm-cov'), 'export', '-format=lcov', '-instr-profile', str(profile), str(objects[0])]
    for path in objects[1:]:
        args += ['-object', str(path)]
    payload = command(args, ROOT, env, folder / 'export.log', capture=True)
    (folder / 'coverage.lcov').write_bytes(payload)
    if rejected:
        raise RuntimeError(f'{name}: {len(rejected)} invalid profiles retained; see {folder / "rejected.json"}')
    return payload.decode()


def installed_helpers():
    helpers = []
    for path in sorted((ROOT / 'sdlc/scripts').glob('coverage_installed_*.py')):
        helpers.append(importlib.import_module(path.stem))
    expected = set()
    for line in (ROOT / 'sdlc/surfaces.txt').read_text().splitlines():
        fields = line.split()
        if len(fields) < 2 or not fields[0].startswith('libraries/') or fields[1] not in ('landed', 'feature'):
            continue
        language = fields[0].split('/')[1]
        names = {'python': ('python-shared', 'python', 'pandas', 'python-polars'),
                 'jvm': ('java', 'java-usage', 'kotlin', 'kotlin-usage', 'scala', 'scala-usage'),
                 'typescript': ('javascript', 'typescript'), 'dart': ('dart', 'flutter')}.get(language, (language,))
        expected.update('installed-' + name for name in names)
    declared = [name for helper in helpers for name in helper.COLLECTIONS]
    available = set(declared)
    if len(available) != len(declared):
        raise RuntimeError('installed helpers declare duplicate collections')
    missing = sorted(expected - available)
    if missing:
        raise MissingTool('unmeasured installed collections: ' + ', '.join(missing) +
                          '; Apple Swift/Objective-C need matching platform execution; --native measures a partial slice')
    return helpers


def prepare_installed(run, env, initializer, native, helpers, platform_slice=None):
    tool_env = {key: value for key, value in env.items()
                if key not in ('CARGO_ENCODED_RUSTFLAGS', 'RUSTFLAGS', 'LLVM_PROFILE_FILE')}
    tool_env['CARGO_TARGET_DIR'] = str(run / 'target-tools')
    command(['cargo', 'build', '--offline', '--locked', '-p', 'conformance-backend', '-j2'],
            ROOT, tool_env, run / 'build-backend.log')
    runtime_env = {**env, 'CARGO_TARGET_DIR': str(run / 'target-tools')}
    context = dict(root=ROOT, run=run, env=runtime_env, command=command, missing_tool=MissingTool,
                   initializer=initializer, c_target=run / 'target-c', c_shared=native)
    if platform_slice == 'apple':
        return importlib.import_module('coverage_installed_managed').prepare_apple(context)
    collections = [collection for helper in helpers for collection in helper.prepare(context)]
    names = [collection['name'] for collection in collections]
    declared = [name for helper in helpers for name in helper.COLLECTIONS]
    if len(set(names)) != len(names) or set(names) != set(declared):
        raise RuntimeError('installed helper collections differ from their declarations')
    return [row for row in collections if row['name'] != 'installed-objective-c'] if platform_slice == 'linux' else collections


def measured_export(*args):
    try:
        return export(*args)
    except MissingTool as error:
        raise RuntimeError(f'coverage export failed: {error}') from error


def measure(run, env, llvm, executable, native, artifacts, installed, revision, started, continuous, platform_slice=None):
    completed = []
    missing = {}
    # Each runner finishes and retains its loaded native objects before switching.
    for collection in installed:
        folder = activate(run, collection['name'])
        try:
            collection['runner'](folder)
        except MissingTool as error:
            missing[collection['name']] = str(error)
            (folder / 'unmeasured.txt').write_text(str(error) + '\n')
            continue
        if not collection['objects']:
            raise RuntimeError(f'{collection["name"]}: no retained native objects')
        for path in collection['objects']:
            if not Path(path).is_file():
                raise RuntimeError(f'{collection["name"]}: missing retained native object: {path}')
        completed.append(collection)
    production_objects = list(dict.fromkeys([executable, *native,
                         *[Path(path) for collection in completed for path in collection['objects']]]))
    production = measured_export(run, llvm, production_objects, 'inventory', env)
    objects = [executable, *native, *[Path(item[2]) for item in artifacts]]
    collections = {name: measured_export(run, llvm, objects, name, env)
                   for name in (() if platform_slice == 'apple' else NATIVE_COLLECTIONS)}
    for collection in completed:
        collections[collection['name']] = measured_export(run, llvm,
                list(dict.fromkeys([executable, *native, *collection['objects']])), collection['name'], env)
    report(ROOT, run, revision, production, collections, time.monotonic() - started, missing=missing, missing_reasons=missing, continuous=continuous, platform_slice=platform_slice)
    if missing:
        raise MissingTool('unmeasured installed collections: ' + ', '.join(missing) +
                          f'; completed measurements retained in {run}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--platform', choices=('linux', 'apple'), help='Measure required collections on their own host; join both before acceptance')
    parser.add_argument('--join', nargs=2, type=Path, metavar=('LINUX', 'APPLE'), help='Require successful same-commit Linux and Apple coverage reports')
    parser.add_argument('--native', action='store_true', help='Run only this slice: native tests; installed surfaces are unmeasured')
    parser.add_argument('--output', type=Path, help='New owned build directory (installed default: /tmp; native default: target/coverage/TIMESTAMP)')
    args = parser.parse_args()
    if args.join:
        if args.native or args.platform or args.output:
            raise RuntimeError('--join only reads the two required platform reports')
        join_platforms(*args.join, subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
                       set(NATIVE_COLLECTIONS) | {name for helper in installed_helpers() for name in helper.COLLECTIONS})
        return
    if args.native and args.platform:
        raise RuntimeError('--native cannot qualify a platform collection')
    if args.platform and sys.platform != ('darwin' if args.platform == 'apple' else 'linux'):
        raise RuntimeError('coverage platform collection requires its own host')
    helpers = [] if args.native else installed_helpers()
    llvm = tools()
    revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    if subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=no'], cwd=ROOT):
        raise RuntimeError('coverage needs committed source')
    started = time.monotonic()
    if args.output:
        run = args.output.resolve()
    elif args.native:
        run = ROOT / 'target/coverage' / datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S')
    else:
        run = Path('/tmp') / ('thinkthen-coverage-' + uuid.uuid4().hex)
    if not args.native and (run == Path('/home') or Path('/home') in run.parents):
        raise RuntimeError('installed coverage output must be outside /home to preserve package privacy')
    run.mkdir(parents=True, exist_ok=False)
    (run / 'OWNER').write_text(f'coverage collection\nsource {revision}\n')
    activate(run, 'build')
    initializer = run / 'profile.o'
    continuous = sys.platform == 'linux'
    pattern = '%p-%m%c.profraw' if continuous else '%m.profraw'
    home_destination = '/build/users' if Path.home().is_relative_to('/Users') else '/build/host'
    remaps = [(Path('/home'), '/build/host'), (Path('/Users'), '/build/users'),
              (Path.home(), home_destination), (ROOT, '/build/source'),
              (Path(os.environ.get('CARGO_HOME', str(Path.home() / '.cargo'))).resolve(), '/build/cargo')]
    flags = ['-C', 'instrument-coverage',
             *[f'--remap-path-prefix={source}={destination}' for source, destination in remaps],
             '-C', f'link-arg={initializer}']
    cflags = shlex.join([f'-ffile-prefix-map={source}={destination}' for source, destination in remaps])
    if continuous:
        flags += ['-C', 'llvm-args=-runtime-counter-relocation']
    subprocess.run(['cc', '-fPIC', '-c', str(ROOT / 'sdlc/scripts/coverage-profile.c'),
                    '-DPROFILE_PATH=' + json.dumps(str(run / 'active' / pattern)), '-DPROFILE_DIR=' + json.dumps(str(run / 'active')), '-o', str(initializer)], check=True)
    env = {name: value for name, value in os.environ.items() if not name.startswith('THINKTHEN_') and name != 'LLVM_PROFILE_FILE'}
    env.update(CFLAGS=' '.join(filter(None, (env.get('CFLAGS'), cflags))), LLVM_PROFILE_FILE=str(run / 'active' / pattern), CARGO_TARGET_DIR=str(run / 'target'), CARGO_NET_OFFLINE='true', RUSTC_WRAPPER='',
               CXXFLAGS=' '.join(filter(None, (env.get('CXXFLAGS'), cflags))),
               CARGO_ENCODED_RUSTFLAGS='\x1f'.join(flags),
               XDG_CONFIG_HOME=str(run / 'home/config'), XDG_CACHE_HOME=str(run / 'home/cache'),
               XDG_STATE_HOME=str(run / 'home/state'))
    if args.platform == 'apple':
        artifacts = []
        command(['cargo', 'build', '--offline', '--locked', '-p', 'thinkthen-cli', '--bin', 'thinkthen', '-j2'], ROOT, env, run / 'build-production.log')
        command(['cargo', 'build', '--manifest-path', 'libraries/c/Cargo.toml', '--offline', '--locked', '--lib', '-j2'], ROOT, {**env, 'CARGO_TARGET_DIR': str(run / 'target-c')}, run / 'build-c.log')
    else:
        artifacts = build(run, env)
    libraries = list((run / 'target-c/debug').glob('libthinkthen_c.*'))
    native = [path for path in libraries if path.suffix in ('.so', '.dylib', '.dll')]
    if len(native) != 1:
        raise RuntimeError('expected one instrumented C shared library')
    installed = prepare_installed(run, env, initializer, native[0], helpers, args.platform) if helpers else []
    executable = collect(run, env, artifacts, args.platform != 'apple')
    measure(run, env, llvm, executable, native, artifacts, installed, revision, started, continuous, args.platform)
    print(f'{args.platform} platform measurement: {run}; join both hosts before acceptance' if args.platform
          else f'Partial native measurement: {run}; installed surfaces remain unmeasured' if args.native
          else f'Native and installed library measurement: {run}')


def entry():
    try:
        main()
    except MissingTool as error:
        print(f'coverage: not run: {error}', file=sys.stderr)
        verdict('coverage prerequisites', 77, 'coverage')
        return 1
    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
        print(f'coverage: FAIL: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(entry())
