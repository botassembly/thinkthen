#!/usr/bin/env python3
"""The checks of `sdlc/scripts/pages`, against trees that each break one.

A check that runs from no rung rots, so the lint rung runs this before it runs
the real lists. Each case builds a small tree under target/, runs the real
script over it, and pins the exit code and the whole sentence.
"""

import pathlib
import shutil
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parents[2]
SCRIPT = REPO / "sdlc" / "scripts" / "pages"
ROOT = REPO / "target" / "pages-lists"

PAGE = """# How to {head}

Status: {status}

Verbs: `decide`

One paragraph about a fixture page.
"""

INDEX = """# How-tos

Folder {folder}/ holds the green page.

| # | How to | Verbs | Status |
| --- | --- | --- | --- |
| 01 | [{green}]({folder}/) | `decide` | {green_state} |
{extra}
"""

PLAN = """# Documentation plan

| # | How to | Slice | State |
| --- | --- | --- | --- |
| 01 | {green} | 4 | {green_state} |
{extra}
"""

TOP = "# thinkthen\n\nThe list is [demos/README.md](demos/README.md).\n"


def build(name, *, green="Gate a step", green_state="green",
          plan_green=None, plan_green_state=None, folder="01-gate",
          head="gate a step", status="green", index_extra=None,
          plan_extra=None, spare=None, top=TOP):
    """One tree: an index, a plan, a top page, and the folders they name."""
    root = ROOT / name
    shutil.rmtree(root, ignore_errors=True)
    (root / "sdlc" / "planning").mkdir(parents=True)
    (root / "demos" / folder).mkdir(parents=True)
    coming = "| 02 | Find the line | `find` | coming, slice 11 |"
    (root / "demos" / "README.md").write_text(INDEX.format(
        green=green, green_state=green_state, folder=folder,
        extra=coming if index_extra is None else index_extra))
    (root / PLANPATH).write_text(PLAN.format(
        green=green if plan_green is None else plan_green,
        green_state=(green_state if plan_green_state is None
                     else plan_green_state),
        extra=coming if plan_extra is None else plan_extra))
    (root / "README.md").write_text(top)
    (root / "demos" / folder / "README.md").write_text(
        PAGE.format(head=head, status=status))
    if spare:
        (root / "demos" / spare).mkdir()
        (root / "demos" / spare / "README.md").write_text(
            PAGE.format(head="spare", status="red"))
    return root


PLANPATH = "sdlc/planning/documentation-plan.md"

CASES = []


def case(name, code, sentence, **kwargs):
    CASES.append((name, code, sentence, kwargs))


case("ok", 0, "pages: 2 how-tos, 1 green, 1 coming")

case("missing-from-plan", 1,
     "pages: sdlc/planning/documentation-plan.md: lists no how-to 02, "
     "and demos/README.md does",
     plan_extra="")

case("missing-from-index", 1,
     "pages: demos/README.md: lists no how-to 02, "
     "and sdlc/planning/documentation-plan.md does",
     index_extra="")

case("title-drift", 1,
     "pages: sdlc/planning/documentation-plan.md: how-to 01 is titled "
     "[Gate a step twice], and demos/README.md titles it [Gate a step]",
     plan_green="Gate a step twice")

case("state-drift", 1,
     "pages: sdlc/planning/documentation-plan.md: how-to 01 is coming, "
     "and demos/README.md says green",
     plan_green_state="coming, slice 4")

case("folder-not-listed", 1,
     "pages: demos/README.md: names no folder 09-spare, and demos/ holds it",
     spare="09-spare")

case("folder-missing", 1,
     "pages: demos/README.md: how-to 02 links 01-gone/, "
     "and demos/ holds no such folder",
     folder="01-gate", index_extra="| 02 | [Find the line](01-gone/) "
     "| `find` | coming, slice 11 |",
     plan_extra="| 02 | Find the line | 11 | coming, slice 11 |")

case("status-drift", 1,
     "pages: demos/01-gate/README.md: says ['Status: red'], "
     "and demos/README.md wants [Status: green]",
     status="red")

case("head-drift", 1,
     "pages: demos/01-gate/README.md: is titled [How to gate a step twice], "
     "and demos/README.md wants [How to gate a step]",
     head="gate a step twice")

case("dead-link", 1,
     "pages: README.md: links [the list] to demos/LIST.md, "
     "and nothing is there",
     top="# thinkthen\n\nThe list is [the list](demos/LIST.md).\n")

case("unknown-state", 1,
     "pages: demos/README.md: how-to 01 is [soon], "
     "and a state is green or coming",
     green_state="soon", plan_green_state="soon")


def main():
    shutil.rmtree(ROOT, ignore_errors=True)
    failures = 0
    for name, code, sentence, kwargs in CASES:
        root = build(name, **kwargs)
        run = subprocess.run([sys.executable, str(SCRIPT), str(root)],
                             capture_output=True, text=True)
        said = run.stdout + run.stderr
        if run.returncode != code:
            print(f"pages-self-test: {name} exited {run.returncode} and "
                  f"{code} was wanted\n{said}", file=sys.stderr)
            failures += 1
            continue
        if sentence not in said:
            print(f"pages-self-test: {name} printed no [{sentence}]\n{said}",
                  file=sys.stderr)
            failures += 1
    if failures:
        print(f"pages-self-test: {failures} cases failed", file=sys.stderr)
        return 1
    print(f"pages-self-test: {len(CASES)} cases pass")
    return 0


if __name__ == "__main__":
    sys.exit(main())
