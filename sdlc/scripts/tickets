#!/usr/bin/env python3
"""Each ticket names its evidence; a landed ticket records what its build taught.

From ticket 0120, `## Evidence` holds five items with text: `- Starts from:`,
`- Keeps:`, `- Changes:`, `- Proof:`, `- Defers:`. A label may be bold. From
ticket 0333, a ticket also has `## Outcome`, and a ticket whose status starts
with `landed` has a non-empty `## What the build taught us`. Older tickets
are exempt by number. Fenced lines do not count.

Usage: tickets [ROOT]. ROOT defaults to the repository. --self-test runs planted cases.
"""

import pathlib
import re
import sys
import tempfile

EVIDENCE_FROM, SHORT_FROM = 120, 333
PARTS = ("Starts from", "Keeps", "Changes", "Proof", "Defers")
NAME = re.compile(r"^(\d{4})-.*\.md$")


def prose(text):
    """The text outside fenced blocks."""
    lines, fenced = [], False
    for line in text.splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
        elif not fenced:
            lines.append(line)
    return "\n".join(lines)


def section(text, title):
    """The lines under `## title` up to the next `## ` heading, or None."""
    lines = text.splitlines()
    if f"## {title}" not in lines:
        return None
    body = lines[lines.index(f"## {title}") + 1 :]
    ends = [i for i, line in enumerate(body) if line.startswith("## ")]
    return body[: ends[0]] if ends else body


def failures(path, number):
    text = prose(path.read_text(encoding="utf-8"))
    out = []
    body = section(text, "Evidence")
    if body is None:
        out.append(f"{path.name}: lacks a `## Evidence` section")
    else:
        for part in PARTS:
            item = re.compile(rf"^\s*[-*]\s+{part}:\s*\S")
            if not any(item.match(line.replace("**", "")) for line in body):
                out.append(f"{path.name}: Evidence lacks a `- {part}:` item with text")
    if number >= SHORT_FROM:
        if section(text, "Outcome") is None:
            out.append(f"{path.name}: lacks a `## Outcome` section")
        landed = re.search(r"^Status:\s*landed", text.replace("**", ""), re.M | re.I)
        if landed and not any(line.strip() for line in section(text, "What the build taught us") or []):
            out.append(f"{path.name}: landed without `## What the build taught us`")
    return out


def check(root):
    out = []
    for path in sorted((root / "sdlc" / "tickets").glob("*.md")):
        hit = NAME.match(path.name)
        if hit and int(hit.group(1)) >= EVIDENCE_FROM:
            out += failures(path, int(hit.group(1)))
    return out


GOOD = """# 0333: A fixture

Status: landed

## Outcome

One thing.

## Evidence

- Starts from: probes/one.
- **Keeps:** the answer shape.
- Changes: one flag.
- Proof: a test.
- Defers: nothing.

## What the build taught us

- Nothing new.
"""

CASES = [
    ("0333-good.md", GOOD, []),
    ("0119-old.md", "# 0119\n", []),
    ("0120-old-form.md", GOOD.replace("## Outcome", "## Aim").split("## What")[0], []),
    ("0333-none.md", GOOD.replace("## Evidence", "## Notes"), ["0333-none.md: lacks a `## Evidence` section"]),
    (
        "0333-part.md",
        GOOD.replace("- Defers: nothing.\n", ""),
        ["0333-part.md: Evidence lacks a `- Defers:` item with text"],
    ),
    (
        "0333-empty.md",
        GOOD.replace("- **Keeps:** the answer shape.", "- **Keeps:**"),
        ["0333-empty.md: Evidence lacks a `- Keeps:` item with text"],
    ),
    (
        "0333-elsewhere.md",
        GOOD.replace("- Proof: a test.\n", "").replace("- Nothing new.", "- Proof: late."),
        ["0333-elsewhere.md: Evidence lacks a `- Proof:` item with text"],
    ),
    ("0333-aim.md", GOOD.replace("## Outcome", "## Aim"), ["0333-aim.md: lacks a `## Outcome` section"]),
    (
        "0333-unlearned.md",
        GOOD.split("## What")[0],
        ["0333-unlearned.md: landed without `## What the build taught us`"],
    ),
    ("0333-fenced.md", "# 0333\n\n```\n" + GOOD + "```\n", [
        "0333-fenced.md: lacks a `## Evidence` section",
        "0333-fenced.md: lacks a `## Outcome` section",
    ]),
    (
        "0333-empty-lessons.md",
        GOOD.replace("Status: landed", "Status: **Landed**").replace("- Nothing new.", ""),
        ["0333-empty-lessons.md: landed without `## What the build taught us`"],
    ),
    ("0333-ready.md", GOOD.replace("Status: landed", "Status: ready").split("## What")[0], []),
]


def self_test():
    """Run each case alone in a fresh tree and pin its whole output."""
    bad = 0
    for name, text, expected in CASES:
        with tempfile.TemporaryDirectory() as tmp:
            root = pathlib.Path(tmp)
            (root / "sdlc" / "tickets").mkdir(parents=True)
            (root / "sdlc" / "tickets" / name).write_text(text, encoding="utf-8")
            actual = check(root)
        if actual != expected:
            bad += 1
            print(f"tickets self-test: {name}: expected {expected}, got {actual}", file=sys.stderr)
    print(f"tickets self-test: {len(CASES) - bad}/{len(CASES)} cases hold")
    return bad


def main(argv):
    if argv[1:] == ["--self-test"]:
        return 1 if self_test() else 0
    root = pathlib.Path(argv[1]) if len(argv) > 1 else pathlib.Path(__file__).resolve().parents[2]
    found = check(root)
    for line in found:
        print(line, file=sys.stderr)
    print(f"tickets: {len(found)} failures")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
