#!/bin/sh
# Validate one fixed managed pair against the C archive that built with it.
# The one-argument Go/C++ route stays unchanged; release-smoke also calls the
# csharp-jvm mode before either managed consumer.
set -eu
[ "$#" -ge 1 ] && [ "$#" -le 2 ] && [ -d "$1" ] || { echo 'release-go-cpp-pair: DIR [csharp-jvm] required' >&2; exit 2; }
mode=${2:-go-cpp}
case $mode in go-cpp | csharp-jvm) ;; *) echo "release-go-cpp-pair: unknown mode $mode" >&2; exit 2 ;; esac
dir=$(CDPATH='' cd -- "$1" && pwd)
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$repo"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -n 1)
target=$(rustc -vV | sed -n 's/^host: //p')
source_commit=
. "$repo/sdlc/scripts/scratch.sh"
scratch_dir work
c=thinkthen-c-$version-$target.tar.gz
case $mode in
go-cpp) first=thinkthen-go-$version-$target.tar.gz second=thinkthen-cpp-$version-$target.tar.gz ;;
csharp-jvm) first=thinkthen-csharp-$version-$target.tar.gz second=thinkthen-jvm-$version-$target.tar.gz ;;
esac
fail() { echo "release-go-cpp-pair: $*" >&2; exit 1; }
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }

# A different version/target is an extra member, not an alternative match.
for file in "$dir"/*; do
	[ -e "$file" ] || [ -L "$file" ] || continue
	name=${file##*/}
	selected=
	case $name in
	thinkthen-c-*.tar.gz | thinkthen-c-*.tar.gz.sha256) selected=1 ;;
	esac
	case $mode:$name in
	go-cpp:thinkthen-go-*.tar.gz | go-cpp:thinkthen-cpp-*.tar.gz | \
	go-cpp:thinkthen-go-*.tar.gz.sha256 | go-cpp:thinkthen-cpp-*.tar.gz.sha256 | \
	csharp-jvm:thinkthen-csharp-*.tar.gz | csharp-jvm:thinkthen-jvm-*.tar.gz | \
	csharp-jvm:thinkthen-csharp-*.tar.gz.sha256 | csharp-jvm:thinkthen-jvm-*.tar.gz.sha256) selected=1 ;;
	esac
	[ -n "$selected" ] || continue
	case $name in "$c" | "$first" | "$second" | "$c.sha256" | "$first.sha256" | "$second.sha256") ;; *) fail "extra family entry $name" ;; esac
done
for name in "$c" "$first" "$second"; do
	[ -f "$dir/$name" ] && [ ! -L "$dir/$name" ] || fail "missing or linked $name"
	[ -f "$dir/$name.sha256" ] && [ ! -L "$dir/$name.sha256" ] || fail "missing or linked $name.sha256"
	digest=$(sha256 "$dir/$name" | awk '{print $1}')
	[ "$(cat "$dir/$name.sha256")" = "$digest  $name" ] || fail "checksum differs for $name"
done
c_digest=$(sha256 "$dir/$c" | awk '{print $1}')
for name in "$first" "$second"; do
	members=$(tar -tzf "$dir/$name") || fail "cannot list $name"
	[ "$(printf '%s\n' "$members" | grep -xc './THINKTHEN-PACKAGE-INPUTS' || true)" = 1 ] || fail "manifest count differs for $name"
	tar -xOzf "$dir/$name" ./THINKTHEN-PACKAGE-INPUTS >"$work/actual" || fail "cannot read manifest in $name"
	manifest_commit=$(sed -n 's/^source_commit=//p' "$work/actual")
	if [ -z "$source_commit" ]; then
		printf '%s\n' "$manifest_commit" | grep -Eq '^[0-9a-f]{40}$' || fail "invalid source commit in $name"
		source_commit=$manifest_commit
	fi
	printf 'source_commit=%s\ntarget=%s\nversion=%s\nc_archive=%s\nc_sha256=%s\n' \
		"$source_commit" "$target" "$version" "$c" "$c_digest" >"$work/expected"
	cmp -s "$work/actual" "$work/expected" || fail "C identity or manifest differs for $name"
done
case $mode in go-cpp) echo 'release-go-cpp-pair: pass' ;; csharp-jvm) echo 'release-go-cpp-pair: csharp-jvm pass' ;; esac
