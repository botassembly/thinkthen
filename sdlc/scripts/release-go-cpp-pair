#!/bin/sh
# Validate one fixed managed pair against the C archive that built with it.
# The one-argument Go/C++ route stays unchanged; release-smoke also calls the
# csharp-jvm, swift-zig, php-dart, dart-flutter and ada-objective-c-cobol modes before consumers.
set -eu
[ "$#" -ge 1 ] && [ "$#" -le 2 ] && [ -d "$1" ] || { echo 'release-go-cpp-pair: DIR [csharp-jvm|swift-zig|php-dart|dart-flutter|ada-objective-c-cobol] required' >&2; exit 2; }
mode=${2:-go-cpp}
case $mode in go-cpp | csharp-jvm | swift-zig | php-dart | dart-flutter | ada-objective-c-cobol) ;; *) echo "release-go-cpp-pair: unknown mode $mode" >&2; exit 2 ;; esac
dir=$(CDPATH='' cd -- "$1" && pwd)
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$repo"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -n 1)
target=$(rustc -vV | sed -n 's/^host: //p')
source_commit=
. "$repo/sdlc/scripts/scratch.sh"
scratch_dir work
c=thinkthen-c-$version-$target.tar.gz
case $mode in
go-cpp) first=thinkthen-go-$version-$target.tar.gz second=thinkthen-cpp-$version-$target.tar.gz ;;
csharp-jvm) first=thinkthen-csharp-$version-$target.tar.gz second=thinkthen-jvm-$version-$target.tar.gz ;;
swift-zig) first=thinkthen-swift-$version-$target.tar.gz second=thinkthen-zig-$version-$target.tar.gz ;;
php-dart) first=thinkthen-php-$version-$target.tar.gz second=thinkthen-dart-$version-$target.tar.gz ;;
dart-flutter) first=thinkthen-dart-$version-$target.tar.gz second=thinkthen-flutter-$version-$target.tar.gz ;;
ada-objective-c-cobol) first=thinkthen-ada-$version-$target.tar.gz second=thinkthen-objective-c-$version-$target.tar.gz third=thinkthen-cobol-$version-$target.tar.gz ;;
esac
fail() { echo "release-go-cpp-pair: $*" >&2; exit 1; }
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }

# A different version/target is an extra member, not an alternative match.
for file in "$dir"/*; do
	[ -e "$file" ] || [ -L "$file" ] || continue
	name=${file##*/}
	selected=
	case $name in
	thinkthen-c-*.tar.gz | thinkthen-c-*.tar.gz.sha256) selected=1 ;;
	esac
	case $mode:$name in
	go-cpp:thinkthen-go-*.tar.gz | go-cpp:thinkthen-cpp-*.tar.gz | \
	go-cpp:thinkthen-go-*.tar.gz.sha256 | go-cpp:thinkthen-cpp-*.tar.gz.sha256 | \
	csharp-jvm:thinkthen-csharp-*.tar.gz | csharp-jvm:thinkthen-jvm-*.tar.gz | \
	csharp-jvm:thinkthen-csharp-*.tar.gz.sha256 | csharp-jvm:thinkthen-jvm-*.tar.gz.sha256 | \
	swift-zig:thinkthen-swift-*.tar.gz | swift-zig:thinkthen-zig-*.tar.gz | \
	swift-zig:thinkthen-swift-*.tar.gz.sha256 | swift-zig:thinkthen-zig-*.tar.gz.sha256 | \
	php-dart:thinkthen-php-*.tar.gz | php-dart:thinkthen-dart-*.tar.gz | \
	php-dart:thinkthen-php-*.tar.gz.sha256 | php-dart:thinkthen-dart-*.tar.gz.sha256 | \
	dart-flutter:thinkthen-dart-*.tar.gz | dart-flutter:thinkthen-flutter-*.tar.gz | \
	dart-flutter:thinkthen-dart-*.tar.gz.sha256 | dart-flutter:thinkthen-flutter-*.tar.gz.sha256 | \
	ada-objective-c-cobol:thinkthen-ada-*.tar.gz | ada-objective-c-cobol:thinkthen-objective-c-*.tar.gz | \
	ada-objective-c-cobol:thinkthen-cobol-*.tar.gz | ada-objective-c-cobol:thinkthen-ada-*.tar.gz.sha256 | \
	ada-objective-c-cobol:thinkthen-objective-c-*.tar.gz.sha256 | ada-objective-c-cobol:thinkthen-cobol-*.tar.gz.sha256) selected=1 ;;
	esac
	[ -n "$selected" ] || continue
	case $name in "$c" | "$first" | "$second" | "${third:-}" | "$c.sha256" | "$first.sha256" | "$second.sha256" | "${third:-}.sha256") ;; *) fail "extra family entry $name" ;; esac
done
for name in "$c" "$first" "$second" ${third:+"$third"}; do
	[ -f "$dir/$name" ] && [ ! -L "$dir/$name" ] || fail "missing or linked $name"
	[ -f "$dir/$name.sha256" ] && [ ! -L "$dir/$name.sha256" ] || fail "missing or linked $name.sha256"
	digest=$(sha256 "$dir/$name" | awk '{print $1}')
	[ "$(cat "$dir/$name.sha256")" = "$digest  $name" ] || fail "checksum differs for $name"
done
c_digest=$(sha256 "$dir/$c" | awk '{print $1}')
for name in "$first" "$second" ${third:+"$third"}; do
	members=$(tar -tzf "$dir/$name") || fail "cannot list $name"
	[ "$(printf '%s\n' "$members" | grep -xc './THINKTHEN-PACKAGE-INPUTS' || true)" = 1 ] || fail "manifest count differs for $name"
	tar -xOzf "$dir/$name" ./THINKTHEN-PACKAGE-INPUTS >"$work/actual" || fail "cannot read manifest in $name"
	manifest_commit=$(sed -n 's/^source_commit=//p' "$work/actual")
	if [ -z "$source_commit" ]; then
		printf '%s\n' "$manifest_commit" | grep -Eq '^[0-9a-f]{40}$' || fail "invalid source commit in $name"
		source_commit=$manifest_commit
	fi
	printf 'source_commit=%s\ntarget=%s\nversion=%s\nc_archive=%s\nc_sha256=%s\n' \
		"$source_commit" "$target" "$version" "$c" "$c_digest" >"$work/expected"
	if [ "$mode" = dart-flutter ] && [ "$name" = "$second" ]; then
		printf 'dart_archive=%s\ndart_sha256=%s\n' "$first" "$(sha256 "$dir/$first" | awk '{print $1}')" >>"$work/expected"
	fi
	cmp -s "$work/actual" "$work/expected" || fail "C identity or manifest differs for $name"
done
if [ "$mode" = go-cpp ]; then
	tar -tzf "$dir/$first" | LC_ALL=C sort >"$work/members" || fail "cannot list $first"
	# Go compiles every root .go file; compare against committed source, not the package.
	git ls-tree -r --name-only HEAD -- libraries/go >"$work/go-source" || fail 'cannot list committed Go source'
	{
		printf '%s\n' ./ ./LICENSE ./README.md ./go.mod ./examples/ ./examples/decide/ \
			./examples/decide/main.go ./THINKTHEN-PACKAGE-INPUTS
		sed -n 's|^libraries/go/\([^/]*\.go\)$|./\1|p' "$work/go-source"
	} | LC_ALL=C sort >"$work/expected-members"
	cmp -s "$work/members" "$work/expected-members" || fail 'Go source members differ'
fi
if [ "$mode" = swift-zig ]; then
	# An exact source inventory makes a source archive independently reviewable.
	for name in "$first" "$second"; do
		tar -tzf "$dir/$name" | LC_ALL=C sort >"$work/members" || fail "cannot list $name"
		case $name in
		"$first")
			printf '%s\n' ./ ./LICENSE ./README.md ./Package.swift ./Examples/ ./Examples/main.swift \
				./Sources/ ./Sources/CThinkThen/ ./Sources/CThinkThen/include/ \
				./Sources/CThinkThen/include/thinkthen.h ./Sources/CThinkThen/module.modulemap \
				./Sources/ThinkThen/ ./Sources/ThinkThen/ThinkThen.swift ./Sources/ThinkThen/Complete.swift \
				./Sources/ThinkThen/Native.swift ./Sources/ThinkThen/NativeResult.swift \
				./Sources/ThinkThen/NativeViews.swift ./Sources/ThinkThen/NativeQuestionViews.swift ./Tests/ ./Tests/TypeCase/ \
				./Tests/TypeCase/main.swift ./THINKTHEN-PACKAGE-INPUTS | LC_ALL=C sort >"$work/expected-members" ;;
		"$second")
			printf '%s\n' ./ ./LICENSE ./README.md ./build.zig ./build.zig.zon ./examples/ \
				./examples/decide.zig ./src/ ./src/thinkthen.zig ./src/complete.zig ./src/native.zig ./src/session.zig ./src/authored.zig \
				./src/request_generated.zig ./src/plan_generated.zig \
				./native/ "./native/$target/" "./native/$target/include/" "./native/$target/include/thinkthen.h" \
				"./native/$target/lib/" "./native/$target/lib/libthinkthen.a" \
				./THINKTHEN-PACKAGE-INPUTS \
				| LC_ALL=C sort >"$work/expected-members" ;;
		esac
		cmp -s "$work/members" "$work/expected-members" || fail "source members differ for $name"
	done
	zig_version=$(tar -xOzf "$dir/$second" ./build.zig.zon | sed -n 's/^[[:space:]]*\.version = "\([^"]*\)",$/\1/p')
	[ "$zig_version" = "$version" ] || fail 'Zig package version differs'
	python3 "$repo/libraries/zig/Tests/guard.py" "$dir/$second" || fail 'Zig archive contains private bytes'
fi
# Read recursively copied inputs independently from the committed source tree.
source_members() {
	prefix=$1
	shift
	for source do
		git ls-tree -r -t --format='%(objecttype) %(path)' HEAD -- "$source" >"$work/source-tree" || fail 'cannot list committed source'
		awk -v prefix="$prefix" -v source="$source" '$2 == source || index($2, source "/") == 1 { print "./" substr($2, length(prefix) + 1) ($1 == "tree" ? "/" : "") }' "$work/source-tree"
	done
}
check_dart_archive() {
	name=$1
	tar -tzf "$dir/$name" | LC_ALL=C sort >"$work/members" || fail "cannot list $name"
	source_members libraries/dart/ libraries/dart/lib libraries/dart/hook >"$work/dart-source"
	{
		printf '%s\n' ./ ./CHANGELOG.md ./LICENSE ./README.md ./pubspec.yaml \
			./pubspec.lock ./native-assets.json ./THINKTHEN-PACKAGE-INPUTS
		cat "$work/dart-source"
	} | LC_ALL=C sort >"$work/expected-members"
	cmp -s "$work/members" "$work/expected-members" || fail "source members differ for $name"
	tar -xOzf "$dir/$name" ./pubspec.yaml >"$work/package-metadata"
	grep -Fxq 'name: thinkthen_dart' "$work/package-metadata" || fail 'Dart pub identity differs'
	grep -Fxq "version: $version" "$work/package-metadata" || fail 'Dart pub version differs'
	grep -Fxq '  ffi: ^2.1.4' "$work/package-metadata" || fail 'Dart ffi dependency differs'
}
if [ "$mode" = php-dart ]; then
	for name in "$first" "$second"; do
		tar -tzf "$dir/$name" | LC_ALL=C sort >"$work/members" || fail "cannot list $name"
		case $name in
		"$first")
			{
				printf '%s\n' ./ ./LICENSE ./README.md ./composer.json ./autoload.php ./THINKTHEN-PACKAGE-INPUTS
				source_members libraries/php/ libraries/php/src libraries/php/examples
			} | LC_ALL=C sort >"$work/expected-members"
			tar -xOzf "$dir/$name" ./composer.json >"$work/package-metadata"
			python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); assert p["name"]=="botassembly/thinkthen" and p["require"]=={"php":">=8.3","ext-ffi":"*"} and p["autoload"]=={"files":["autoload.php"]}' "$work/package-metadata" || fail 'PHP Composer identity differs'
			;;
		"$second")
			check_dart_archive "$name"
			continue
			;;
		esac
		cmp -s "$work/members" "$work/expected-members" || fail "source members differ for $name"
	done
fi
if [ "$mode" = dart-flutter ]; then
	check_dart_archive "$first"
	tar -tzf "$dir/$second" | LC_ALL=C sort >"$work/members" || fail "cannot list $second"
	source_members libraries/dart/ libraries/dart/flutter/lib libraries/dart/flutter/linux >"$work/flutter-source"
	{
		printf '%s\n' ./ ./THINKTHEN-PACKAGE-INPUTS ./flutter/ \
			./flutter/README.md ./flutter/pubspec.yaml \
			./flutter/example/ ./flutter/example/.metadata ./flutter/example/README.md \
			./flutter/example/pubspec.yaml ./flutter/example/pubspec.lock \
			./flutter/example/analysis_options.yaml ./flutter/example/lib/ \
			./flutter/example/lib/main.dart ./flutter/example/linux/ \
			./flutter/example/linux/CMakeLists.txt ./flutter/example/linux/flutter/ \
			./flutter/example/linux/flutter/CMakeLists.txt \
			./flutter/example/linux/flutter/generated_plugin_registrant.h \
			./flutter/example/linux/flutter/generated_plugin_registrant.cc \
			./flutter/example/linux/flutter/generated_plugins.cmake \
			./flutter/example/linux/runner/ ./flutter/example/linux/runner/CMakeLists.txt \
			./flutter/example/linux/runner/main.cc ./flutter/example/linux/runner/my_application.cc \
			./flutter/example/linux/runner/my_application.h
		cat "$work/flutter-source"
	} | LC_ALL=C sort >"$work/expected-members"
	cmp -s "$work/members" "$work/expected-members" || fail "source members differ for $second"
	python3 - "$dir/$first" "$dir/$second" "$version" <<'PY' || fail 'private package metadata or archive member type differs'
import sys
import tarfile

dart_path, flutter_path, version = sys.argv[1:]
for path in (dart_path, flutter_path):
    with tarfile.open(path, "r:gz") as archive:
        for member in archive:
            assert member.isfile() or member.isdir(), (path, member.name)
with tarfile.open(flutter_path, "r:gz") as archive:
    def read(name):
        return archive.extractfile(name).read().decode("utf-8")
    wrapper = read("./flutter/pubspec.yaml")
    example = read("./flutter/example/pubspec.yaml")
    for data, package in ((wrapper, "thinkthen_flutter"), (example, "thinkthen_flutter_example")):
        assert f"name: {package}\n" in data
        assert f"version: {version}\n" in data
        assert "publish_to: none\n" in data
    assert f"  thinkthen_dart: {version}\n" in wrapper
    assert "  thinkthen_flutter:\n    path: ..\n" in example
    assert "  thinkthen_dart:\n    path: ../..\n" in example
PY
fi
if [ "$mode" = ada-objective-c-cobol ]; then
	tar -tzf "$dir/$c" | LC_ALL=C sort >"$work/members" || fail 'cannot list C members'
	printf '%s\n' ./ ./include/ ./include/thinkthen.h ./lib/ ./lib/pkgconfig/ \
		./lib/pkgconfig/thinkthen.pc ./lib/libthinkthen.a ./lib/libthinkthen.so \
		./lib/libthinkthen.so.0 | LC_ALL=C sort >"$work/expected-members"
	cmp -s "$work/members" "$work/expected-members" || fail 'C members differ'
	for name in "$first" "$second" "$third"; do
		tar -tzf "$dir/$name" | LC_ALL=C sort >"$work/members" || fail "cannot list $name"
		case $name in
		"$first")
			{
				printf '%s\n' ./ ./LICENSE ./README.md ./thinkthen.gpr \
					./native/ ./native/include/ ./native/include/thinkthen.h ./native/lib/ ./native/lib/libthinkthen.a \
					./examples/ ./examples/consumer.adb ./examples/native.adb ./examples/session_demo.adb ./THINKTHEN-PACKAGE-INPUTS
				source_members libraries/ada/ libraries/ada/src
			} | LC_ALL=C sort >"$work/expected-members" ;;
		"$second")
			printf '%s\n' ./ ./LICENSE ./README.md ./source-package.json ./Sources/ \
				./Sources/ThinkThen.h ./Sources/ThinkThen.m \
				./Sources/TTJSON.h ./Sources/TTJSON.c ./Examples/ ./Examples/consumer.m \
				./Sources/TTComplete.h ./Sources/TTComplete.c ./Sources/TTNative.h \
				./Sources/TTNativeAPI.h ./Sources/TTNativeAPI.m ./Sources/TTNativeViews.c \
				./THINKTHEN-PACKAGE-INPUTS | LC_ALL=C sort >"$work/expected-members" ;;
		"$third")
			source_members libraries/cobol/ libraries/cobol/copybooks >"$work/cobol-source"
			{
				printf '%s\n' ./ ./LICENSE ./README.md \
					./source-package.json ./copybooks/ \
					./src/ ./src/TTJSON.c ./src/TTJSON.h \
					./src/tt_call.cob ./src/tt_complete.c ./src/tt_native.h ./src/tt_counted.c \
					./src/tt_decide.cob ./src/tt_engine.cob ./src/tt_error.cob \
					./src/tt_files.cob ./src/tt_inputs.c ./src/tt_plan.cob \
					./src/tt_shape.c ./src/tt_validate.cob ./src/tt_session.h ./src/tt_session.c \
					./src/tt_requests_generated.h ./src/tt_requests_generated.c ./examples/ \
					./examples/direct.cob ./examples/settings.cob ./examples/types.cob \
					./examples/native.cob ./examples/session.cob ./THINKTHEN-PACKAGE-INPUTS
				sed -n '\|^\./copybooks/[^/]*\.cpy$|p' "$work/cobol-source"
			} | LC_ALL=C sort >"$work/expected-members" ;;
		esac
		cmp -s "$work/members" "$work/expected-members" || fail "source members differ for $name"
	done
	python3 - "$dir/$c" "$dir/$first" "$dir/$second" "$dir/$third" <<'PY' || fail 'unsafe archive member type'
import sys, tarfile
for index, filename in enumerate(sys.argv[1:]):
    with tarfile.open(filename, "r:gz") as archive:
        for member in archive:
            if index == 0 and member.name == "./lib/libthinkthen.so.0":
                assert member.issym() and member.linkname == "libthinkthen.so"
            else:
                assert member.isfile() or member.isdir(), (filename, member.name)
PY
	for name in "$second" "$third"; do
		tar -xOzf "$dir/$name" ./source-package.json >"$work/package-metadata"
		case $name in "$second") package_name=thinkthen-objective-c ;; "$third") package_name=thinkthen-cobol ;; esac
		python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); assert p=={"name":sys.argv[2],"version":sys.argv[3],"source_only":True,"native_dependency":"thinkthen-c","bundles_native":False}' \
			"$work/package-metadata" "$package_name" "$version" || fail "source package identity differs for $name"
	done
fi
case $mode in go-cpp) echo 'release-go-cpp-pair: pass' ;; csharp-jvm) echo 'release-go-cpp-pair: csharp-jvm pass' ;; swift-zig) echo 'release-go-cpp-pair: swift-zig pass' ;; php-dart) echo 'release-go-cpp-pair: php-dart pass' ;; dart-flutter) echo 'release-go-cpp-pair: dart-flutter pass' ;; ada-objective-c-cobol) echo 'release-go-cpp-pair: ada-objective-c-cobol pass' ;; esac
