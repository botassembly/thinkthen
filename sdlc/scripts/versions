#!/usr/bin/env python3
"""Every static product version matches `crates/thinkthen/Cargo.toml` (ticket 0128).

Binding metadata comes from `sdlc/surfaces.txt` and lock entries from every tracked
`Cargo.lock`. The site's `install.sh` must equal the root copy. Skipped on purpose:
`conformance/`, `site/package.json`, the Ruby and TypeScript checks' planted crates,
the sealed `probes/churn-0086/Cargo.lock`, and `libraries/c/DESIGN.md`'s history.
Version 0.0.1 is the unreleased placeholder (ticket 0376). At 0.0.1 the command crate and
the npm package keep their publish holds; at any other version both are gone, and `--set`
drops them.
Usage: versions [--tag vX.Y.Z | --set X.Y.Z | --self-test]
"""

import pathlib
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
import tomllib

REPO = pathlib.Path(__file__).resolve().parents[2]
CRATE = "crates/thinkthen/Cargo.toml"
SKIPPED_LOCKS = {"probes/churn-0086/Cargo.lock"}
PACKAGE = r'(?ms)^\[package\]\n(?:(?!^\[).)*?^version = "([^"]+)"'
WHOLE = lambda v: v  # noqa: E731
PART = [lambda v, i=i: v.split(".")[i] for i in range(3)]
CARGO = {
    "libraries/rust": "libraries/rust/Cargo.toml", "libraries/c": "libraries/c/Cargo.toml",
    "libraries/python": "libraries/python/Cargo.toml", "libraries/typescript": "libraries/typescript/Cargo.toml",
    "libraries/ruby": "libraries/ruby/Cargo.toml", "libraries/r": "libraries/r/thinkthen/src/rust/Cargo.toml",
    "databases/duckdb": "databases/duckdb/Cargo.toml", "databases/sqlite": "databases/sqlite/Cargo.toml",
    "databases/postgresql": "databases/postgresql/Cargo.toml",
}
# The four versionless formats take their release version from a tag or paired C
# artifact. Their required package identity is still checked before any --set write.
NONCARGO = {
    "libraries/php": ("composer.json", r'"name": "botassembly/thinkthen"'),
    "libraries/csharp": ("ThinkThen.csproj", r'<PackageId>Botassembly\.ThinkThen</PackageId>'),
    "libraries/jvm": ("pom.xml", r'<artifactId>thinkthen-jvm</artifactId>'),
    "libraries/dart": ("pubspec.yaml", r'(?m)^name: thinkthen_dart$'),
    "libraries/swift": ("Package.swift", r'(?m)^let package = Package\(\n    name: "ThinkThen",$'),
    "libraries/zig": ("build.zig.zon", r'\.name = \.thinkthen,'),
    "libraries/go": ("go.mod", r'(?m)^module github\.com/botassembly/thinkthen/libraries/go$'),
    "libraries/cpp": ("CMakeLists.txt", r'(?m)^project\(thinkthen_cpp VERSION '),
    "libraries/ada": ("thinkthen.gpr", r'for Library_Name use "thinkthen_ada";'),
    "libraries/objective-c": ("source-package.json", r'"name": "thinkthen-objective-c"'),
    "libraries/cobol": ("source-package.json", r'"name": "thinkthen-cobol"'),
}
# Each place: a file, a pattern whose one group holds the version or a part of it, and that part.
PLACES = [
    ("libraries/python/pyproject.toml", r'(?ms)^\[project\]\n(?:(?!^\[).)*?^version = "([^"]+)"', WHOLE),
    ("libraries/typescript/package.json", r'(?m)\A\{\s*"name": "thinkthen",\s*"version": "([^"]+)"', WHOLE),
    ("libraries/typescript/package-lock.json", r'(?m)\A\{\s*"name": "thinkthen",\s*"version": "([^"]+)"', WHOLE),
    ("libraries/typescript/package-lock.json", r'(?m)"": \{\s*"name": "thinkthen",\s*"version": "([^"]+)"', WHOLE),
    ("libraries/ruby/lib/thinkthen/version.rb", r'VERSION = "([^"]+)"', WHOLE),
    ("libraries/r/thinkthen/DESCRIPTION", r"(?m)^Version: (\S+)$", WHOLE),
    ("libraries/c/src/lib.rs", r"(?m)^/// thinkthen\.h .* version (\d+\.\d+\.\d+)\.$", WHOLE),
    ("libraries/c/src/ffi/values.rs", r"(?m)^/// Version (\d+\.\d+\.\d+), the version", WHOLE),
    *[("libraries/c/src/ffi/values.rs", rf"(?m)^pub const THINKTHEN_VERSION_{n}: i32 = (\d+);$", PART[i])
      for i, n in enumerate(["MAJOR", "MINOR", "PATCH"])],
    *[("libraries/c/include/thinkthen.h", rf"(?m)^#define THINKTHEN_VERSION_{n} (\d+)$", PART[i])
      for i, n in enumerate(["MAJOR", "MINOR", "PATCH"])],
    ("databases/postgresql/thinkthen.control", r"(?m)^default_version = '([^']+)'$", WHOLE),
    ("CITATION.cff", r'(?m)^version: "([^"]+)"$', WHOLE),
    ("libraries/csharp/ThinkThen.csproj", r'<Version>([^<]+)</Version>', WHOLE),
    ("libraries/csharp/Botassembly.ThinkThen.nuspec", r'<version>([^<]+)</version>', WHOLE),
    ("libraries/jvm/pom.xml", r'(?m)^  <version>([^<]+)</version>$', WHOLE),
    *[(p, r'(?m)^version: (\S+)$', WHOLE) for p in
      ("libraries/dart/pubspec.yaml", "libraries/dart/flutter/pubspec.yaml",
       "libraries/dart/flutter/example/pubspec.yaml")],
    ("libraries/zig/build.zig.zon", r'(?m)^    \.version = "([^"]+)",$', WHOLE),
    ("libraries/zig/build.zig", r'(?m)^    const expected = \[_\]u32\{ (\d+), \d+, \d+ \};$', PART[0]),
    ("libraries/zig/build.zig", r'(?m)^    const expected = \[_\]u32\{ \d+, (\d+), \d+ \};$', PART[1]),
    ("libraries/zig/build.zig", r'(?m)^    const expected = \[_\]u32\{ \d+, \d+, (\d+) \};$', PART[2]),
    ("libraries/zig/build.zig", r'(?m)^    if \(!headerVersionMatches\(bytes\)\) @panic\("thinkthen C header does not match package ABI (\d+\.\d+\.\d+)"\);$', WHOLE),
    ("libraries/zig/build.zig", r'(?m)^        if \(std\.mem\.indexOf\(u8, bytes, needle\) == null\) @panic\("thinkthen C header does not match package ABI (\d+\.\d+\.\d+)"\);$', WHOLE),
    ("libraries/cpp/CMakeLists.txt", r'(?m)^project\(thinkthen_cpp VERSION (\S+) LANGUAGES CXX\)$', WHOLE),
    *[(p, r'(?m)^  "version": "([^"]+)",$', WHOLE) for p in
      ("libraries/objective-c/source-package.json", "libraries/cobol/source-package.json")],
    # Ticket 0376: the copies the 0.1.0 dry run found outside this list.
    *[("libraries/go/thinkthen.go", rf"(?m)^#if {pattern}", PART[i]) for i, pattern in enumerate([
        r"THINKTHEN_VERSION_MAJOR != (\d+) \|\|", r"THINKTHEN_VERSION_MAJOR != \d+ \|\| THINKTHEN_VERSION_MINOR != (\d+) \|\|",
        r"THINKTHEN_VERSION_MAJOR != \d+ \|\| THINKTHEN_VERSION_MINOR != \d+ \|\| THINKTHEN_VERSION_PATCH != (\d+)$"])],
    ("libraries/go/thinkthen_test.go", r'm\["tool"\] != "thinkthen (\d+\.\d+\.\d+)"', WHOLE),
    *[(p, r'<PackageReference Include="Botassembly\.ThinkThen" Version="([^"]+)"', WHOLE) for p in
      ("libraries/csharp/tests/Installed.csproj", "libraries/csharp/tests/Smoke.csproj")],
    *[(p, rf'(?m)^  {name}:\n(?:    .*\n)*?    version: "([^"]+)"$', WHOLE) for p, name in (
        ("libraries/dart/flutter/pubspec.lock", "thinkthen_dart"),
        ("libraries/dart/flutter/example/pubspec.lock", "thinkthen_dart"),
        ("libraries/dart/flutter/example/pubspec.lock", "thinkthen_flutter"),
        ("libraries/dart/checks/consumers/alpha/pubspec.lock", "thinkthen_dart"),
        ("libraries/dart/checks/consumers/bravo/pubspec.lock", "thinkthen_dart"))],
]
PLACEHOLDER = "0.0.1"
# Each publish hold: a file and a pattern whose one group is the whole hold line.
HOLDS = [(CRATE, r'(?ms)^\[package\]\n(?:(?!^\[).)*?^(publish = false\n)'),
         ("libraries/typescript/package.json", r'(?m)^(  "private": true,\n)')]


def manifests(root):
    """Known Cargo manifests, required non-Cargo metadata, and registry errors."""
    cargo, metadata, errors = [CRATE], [], []
    try:
        lines = (root / "sdlc/surfaces.txt").read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return cargo, metadata, ["versions: missing or unreadable required metadata sdlc/surfaces.txt"]
    for line in lines:
        field = line.split()
        if not field or line.startswith("#") or len(field) < 2 or field[1] != "landed":
            continue
        surface = field[0]
        if surface in CARGO and (len(field) == 2 or surface == "libraries/r" and field[2:] == ["thinkthen/src/rust"]):
            cargo.append(CARGO[surface])
        elif surface in NONCARGO and len(field) == 2:
            filename, identity = NONCARGO[surface]
            metadata.append((f"{surface}/{filename}", identity))
        else:
            errors.append(f"versions: unknown landed surface {surface} or unsupported metadata path")
    return cargo, metadata, errors


def locks(root):
    """Every tracked lock file, or every lock file when the root is not a checkout."""
    listed = subprocess.run(["git", "-C", str(root), "ls-files", "*Cargo.lock"], capture_output=True, text=True)
    names = listed.stdout.split() if listed.returncode == 0 else [
        str(p.relative_to(root)) for p in root.rglob("Cargo.lock") if "target" not in p.parts]
    return sorted(set(names) - SKIPPED_LOCKS)


def places(cargo):
    """Every (file, pattern, part) the version reaches."""
    return [(m, PACKAGE, WHOLE) for m in cargo] + PLACES


def inspect(root):
    """Read and validate every input before checking or writing a version."""
    cargo, metadata, errors = manifests(root)
    texts, names, lock_data = {}, set(), {}
    required = set(cargo) | {path for path, _, _ in places(cargo)} | {path for path, _ in metadata}
    for path in sorted(required):
        try:
            texts[path] = (root / path).read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            errors.append(f"versions: missing or unreadable required metadata {path}")
    for path, identity in metadata:
        if path in texts and re.search(identity, texts[path]) is None:
            errors.append(f"versions: {path} has no package identity the check can read")
    for path in cargo:
        if path not in texts:
            continue
        hit = re.search(r'(?ms)^\[package\]\n(?:(?!^\[).)*?^name = "([^"]+)"', texts[path])
        if hit is None:
            errors.append(f"versions: {path} has no package name the check can read")
        else:
            names.add(hit.group(1))
    for path in locks(root):
        try:
            raw = (root / path).read_text(encoding="utf-8")
            data = tomllib.loads(raw)
            entries = {}
            for package in data["package"]:
                entries.setdefault(package["name"], set()).add(package["version"])
            texts[path] = raw
            lock_data[path] = entries
        except (OSError, UnicodeError, tomllib.TOMLDecodeError, KeyError, TypeError):
            errors.append(f"versions: missing or malformed required lock {path}")
    try:
        installer = (root / "install.sh").read_bytes()
        site_installer = (root / "site/public/install.sh").read_bytes()
    except OSError:
        errors.append("versions: missing or unreadable required installer copy")
    else:
        if installer != site_installer:
            errors.append("versions: site/public/install.sh differs from install.sh")
    try:
        windows_installer = (root / "install.ps1").read_bytes()
        site_windows_installer = (root / "site/public/install.ps1").read_bytes()
    except OSError:
        errors.append("versions: missing or unreadable Windows installer copy")
    else:
        if windows_installer != site_windows_installer:
            errors.append("versions: site/public/install.ps1 differs from install.ps1")
    version = None
    if CRATE in texts:
        hit = re.search(PACKAGE, texts[CRATE])
        if hit is not None:
            version = hit.group(1)
        else:
            errors.append(f"versions: {CRATE} has no version line the check can read")
    return version, texts, names, lock_data, errors


def check(root):
    """Every sentence naming a copy that differs, and the count of places read."""
    cargo, _, _ = manifests(root)
    version, texts, names, lock_data, errors = inspect(root)
    out, count = errors, 0
    for path, pattern, part in places(cargo):
        found = re.search(pattern, texts[path]) if path in texts else None
        count += 1
        if found is None and path in texts and not (path == CRATE and version is None):
            out.append(f"versions: {path} has no version line the check can read")
        elif found is not None and version is not None and found.group(1) != part(version):
            out.append(f"versions: {path} reads {found.group(1)}, and {CRATE} reads {part(version)}")
    for path, pattern in HOLDS:
        held = path in texts and re.search(pattern, texts[path]) is not None
        if version == PLACEHOLDER and path in texts and not held:
            out.append(f"versions: {path} lost its publish hold, and {CRATE} reads the placeholder {PLACEHOLDER}")
        elif version not in (None, PLACEHOLDER) and held:
            out.append(f"versions: {path} keeps its publish hold, and {CRATE} reads {version}")
    for lock, entries in lock_data.items():
        for name, found in sorted(entries.items()):
            if name in names:
                count += 1
                if version is not None and found != {version}:
                    out.append(f"versions: {lock} pins {name} {', '.join(sorted(found))}, and {CRATE} reads {version}")
    return version, count, out


def set_version(root, new):
    """Write NEW into every place and every lock entry of a checked package, or into none."""
    cargo, _, _ = manifests(root)
    _, originals, names, _, errors = inspect(root)
    if errors:
        return [f"{error}; nothing was written" for error in errors]
    texts = {}
    for path, pattern, part in places(cargo):
        if path == "libraries/c/include/thinkthen.h":
            continue  # Generated output is checked above and staged below.
        text = texts[path] if path in texts else originals[path]
        hit = re.search(pattern, text)
        if hit is None:
            return [f"versions: {path} has no version line the check can read; nothing was written"]
        texts[path] = text[:hit.start(1)] + part(new) + text[hit.end(1):]
    for path, pattern in HOLDS if new != PLACEHOLDER else []:
        hit = re.search(pattern, texts[path])
        if hit is not None:
            texts[path] = texts[path][:hit.start(1)] + texts[path][hit.end(1):]
    entry = re.compile(r'(?m)^(name = "([^"]+)"\nversion = ")([^"]+)(")')
    for lock in locks(root):
        changed = entry.sub(lambda m: m.group(1) + (new if m.group(2) in names else m.group(3)) + m.group(4),
                            originals[lock])
        parsed = tomllib.loads(changed)
        if any(package["version"] != new for package in parsed["package"] if package["name"] in names):
            return [f"versions: {lock} has a package entry the update cannot read; nothing was written"]
        texts[lock] = changed
    try:
        generator = runpy.run_path(str(REPO / "sdlc/scripts/generate-c-header.py"))
        texts["libraries/c/include/thinkthen.h"] = generator["generate"](root, texts).decode()
    except (RuntimeError, OSError, subprocess.CalledProcessError):
        return ["versions: C header generation failed; nothing was written"]
    for path, text in texts.items():
        (root / path).write_text(text, encoding="utf-8")
    return []


def run(root, argv):
    """The exit code and the lines one command prints."""
    if argv[:1] == ["--set"]:
        if len(argv) != 2 or not re.fullmatch(r"\d+\.\d+\.\d+", argv[1]):
            return 2, [f"versions: --set takes X.Y.Z in digits, not {argv[1]!r}; nothing was written"]
        refused = set_version(root, argv[1])
        if refused:
            return 1, refused
        argv = []
    version, count, out = check(root)
    if argv[:1] == ["--tag"] and version is not None and argv[1] != f"v{version}":
        out.append(f"versions: tag {argv[1]} does not match version {version}; the tag must read v{version}")
    return (1, out) if out else (0, [f"versions: {count} places read {version}"])


def self_test():
    """Each edge row against a copy of the real places, with the whole output pinned."""
    def fresh(tmp):
        root = pathlib.Path(tmp)
        shutil.copytree(REPO / "libraries/c/src", root / "libraries/c/src")
        shutil.copyfile(REPO / "libraries/c/cbindgen.toml", root / "libraries/c/cbindgen.toml")
        cargo, metadata, _ = manifests(REPO)
        planted = ["libraries/ruby/lib/thinkthen/version.rb", "libraries/r/thinkthen/DESCRIPTION",
                   "databases/postgresql/thinkthen.control", "sdlc/surfaces.txt", "install.sh", "site/public/install.sh", "install.ps1", "site/public/install.ps1"]
        for path in {p for p, _, _ in places(cargo)} | {p for p, _ in metadata} | set(locks(REPO)) | set(planted):
            (root / path).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(REPO / path, root / path)
        return root

    def edit(root, path, old, new):
        file = root / path
        file.write_text(file.read_text(encoding="utf-8").replace(old, new, 1), encoding="utf-8")

    version = re.search(PACKAGE, (REPO / CRATE).read_text(encoding="utf-8")).group(1)
    major, minor, patch = version.split(".")
    ok = run(REPO, [])[1][0]
    private = '  "private": true,\n'

    def placeholder_without_hold(root):
        # Whatever the version, set the placeholder, keep the npm hold, and drop the crate's.
        set_version(root, PLACEHOLDER)
        if private not in (root / "libraries/typescript/package.json").read_text(encoding="utf-8"):
            edit(root, "libraries/typescript/package.json", '  "main"', private + '  "main"')
        edit(root, CRATE, "publish = false\n", "")

    def release_with_hold(root):
        set_version(root, "9.8.7")
        edit(root, "libraries/typescript/package.json", '  "main"', private + '  "main"')

    def dart_lock(root):
        path = root / "libraries/dart/flutter/example/pubspec.lock"
        text = path.read_text(encoding="utf-8")
        at = text.index("  thinkthen_flutter:\n")
        path.write_text(text[:at] + text[at:].replace(f'version: "{version}"', 'version: "9.9.9"', 1), encoding="utf-8")
    cases = [
        ("agree", lambda r: None, [], (0, [ok])),
        ("r", lambda r: edit(r, "libraries/r/thinkthen/DESCRIPTION", f"Version: {version}", "Version: 9.9.9"), [],
         (1, [f"versions: libraries/r/thinkthen/DESCRIPTION reads 9.9.9, and {CRATE} reads {version}"])),
        ("ruby", lambda r: edit(r, "libraries/ruby/lib/thinkthen/version.rb", f'"{version}"', '"9.9.9"'), [],
         (1, [f"versions: libraries/ruby/lib/thinkthen/version.rb reads 9.9.9, and {CRATE} reads {version}"])),
        ("csharp", lambda r: edit(r, "libraries/csharp/Botassembly.ThinkThen.nuspec", f"<version>{version}</version>",
                                  "<version>9.9.9</version>"), [],
         (1, [f"versions: libraries/csharp/Botassembly.ThinkThen.nuspec reads 9.9.9, and {CRATE} reads {version}"])),
        ("dart", lambda r: edit(r, "libraries/dart/flutter/example/pubspec.yaml", f"version: {version}",
                                "version: 9.9.9"), [],
         (1, [f"versions: libraries/dart/flutter/example/pubspec.yaml reads 9.9.9, and {CRATE} reads {version}"])),
        ("zig-abi", lambda r: edit(r, "libraries/zig/build.zig", f"const expected = [_]u32{{ {major}, {minor}, {patch} }};",
                                   f"const expected = [_]u32{{ {major}, {minor}, {int(patch) + 1} }};"), [],
         (1, [f"versions: libraries/zig/build.zig reads {int(patch) + 1}, and {CRATE} reads {patch}"])),
        ("zig-diagnostic", lambda r: edit(r, "libraries/zig/build.zig",
                                          f'if (std.mem.indexOf(u8, bytes, needle) == null) @panic("thinkthen C header does not match package ABI {version}");',
                                          'if (std.mem.indexOf(u8, bytes, needle) == null) @panic("thinkthen C header does not match package ABI 9.9.9");'), [],
         (1, [f"versions: libraries/zig/build.zig reads 9.9.9, and {CRATE} reads {version}"])),
        ("swift-name", lambda r: edit(r, "libraries/swift/Package.swift", 'name: "ThinkThen",',
                                      'name: "Renamed",'), [],
         (1, ["versions: libraries/swift/Package.swift has no package identity the check can read"])),
        ("missing-metadata", lambda r: (r / "libraries/php/composer.json").unlink(), [],
         (1, ["versions: missing or unreadable required metadata libraries/php/composer.json"])),
        ("unknown-surface", lambda r: edit(r, "sdlc/surfaces.txt", "libraries/php         landed",
                                            "libraries/new         landed"), [],
         (1, ["versions: unknown landed surface libraries/new or unsupported metadata path"])),
        ("lost", lambda r: edit(r, "databases/postgresql/thinkthen.control", "default_version", "# version"), [],
         (1, ["versions: databases/postgresql/thinkthen.control has no version line the check can read"])),
        ("lock", lambda r: edit(r, "conformance/consumer/Cargo.lock", f'name = "thinkthen"\nversion = "{version}"',
                               'name = "thinkthen"\nversion = "9.9.9"'), [],
         (1, [f"versions: conformance/consumer/Cargo.lock pins thinkthen 9.9.9, and {CRATE} reads {version}"])),
        ("dart-lock", dart_lock, [],
         (1, [f"versions: libraries/dart/flutter/example/pubspec.lock reads 9.9.9, and {CRATE} reads {version}"])),
        ("placeholder-without-hold", placeholder_without_hold, [],
         (1, [f"versions: {CRATE} lost its publish hold, and {CRATE} reads the placeholder {PLACEHOLDER}"])),
        ("release-with-hold", release_with_hold, [],
         (1, [f"versions: libraries/typescript/package.json keeps its publish hold, and {CRATE} reads 9.8.7"])),
        ("install", lambda r: edit(r, "site/public/install.sh", "#!/bin/sh", "#!/bin/sh "), [],
         (1, ["versions: site/public/install.sh differs from install.sh"])),
        ("windows-install", lambda r: edit(r, "site/public/install.ps1", "# Windows", "# Changed Windows"), [],
         (1, ["versions: site/public/install.ps1 differs from install.ps1"])),
        ("tag", lambda r: None, ["--tag", f"v{version}"], (0, [ok])),
        ("bare-tag", lambda r: None, ["--tag", version],
         (1, [f"versions: tag {version} does not match version {version}; the tag must read v{version}"])),
        ("set", lambda r: None, ["--set", "9.8.7"], (0, [ok.replace(version, "9.8.7")])),
        ("bad-set", lambda r: None, ["--set", "1.2"], (2, ["versions: --set takes X.Y.Z in digits, not '1.2'; nothing was written"])),
        ("header-parse-set", lambda r: edit(r, "libraries/c/src/lib.rs", "pub mod ffi;", "pub mod ffi;\npub struct {"),
         ["--set", "9.8.7"], (1, ["versions: C header generation failed; nothing was written"])),
        ("lost-set", lambda r: edit(r, "databases/postgresql/thinkthen.control", "default_version", "# version"), ["--set", "9.8.7"],
         (1, ["versions: databases/postgresql/thinkthen.control has no version line the check can read; nothing was written"])),
        ("missing-set", lambda r: (r / "libraries/swift/Package.swift").unlink(), ["--set", "9.8.7"],
         (1, ["versions: missing or unreadable required metadata libraries/swift/Package.swift; nothing was written"])),
        ("swift-name-set", lambda r: edit(r, "libraries/swift/Package.swift", 'name: "ThinkThen",',
                                           'name: "Renamed",'), ["--set", "9.8.7"],
         (1, ["versions: libraries/swift/Package.swift has no package identity the check can read; nothing was written"])),
        ("cargo-name-set", lambda r: edit(r, "libraries/c/Cargo.toml", 'name = "thinkthen-c"',
                                         'no_name = "thinkthen-c"'), ["--set", "9.8.7"],
         (1, ["versions: libraries/c/Cargo.toml has no package name the check can read; nothing was written"])),
        ("lock-set", lambda r: edit(r, "conformance/consumer/Cargo.lock", '[[package]]', '[[package]'),
         ["--set", "9.8.7"],
         (1, ["versions: missing or malformed required lock conformance/consumer/Cargo.lock; nothing was written"])),
        ("lock-order-set", lambda r: edit(r, "conformance/consumer/Cargo.lock",
                                          f'name = "thinkthen"\nversion = "{version}"',
                                          f'version = "{version}"\nname = "thinkthen"'), ["--set", f"{int(major) + 1}.0.0"],
         (1, ["versions: conformance/consumer/Cargo.lock has a package entry the update cannot read; nothing was written"])),
        ("installer-set", lambda r: edit(r, "site/public/install.sh", "#!/bin/sh", "#!/bin/sh "),
         ["--set", "9.8.7"],
         (1, ["versions: site/public/install.sh differs from install.sh; nothing was written"])),
    ]
    bad = 0
    for name, plant, argv, expected in cases:
        with tempfile.TemporaryDirectory() as tmp:
            root = fresh(tmp)
            plant(root)
            before = {p: p.read_bytes() for p in root.rglob("*") if p.is_file()}
            got = run(root, argv)
            if name == "set" and got == expected:
                zig = (root / "libraries/zig/build.zig").read_text(encoding="utf-8")
                if "const expected = [_]u32{ 9, 8, 7 };" not in zig or zig.count("package ABI 9.8.7") != 2:
                    got = (got, "--set did not update Zig's numeric ABI and both diagnostics")
                if any(re.search(pattern, (root / path).read_text(encoding="utf-8")) for path, pattern in HOLDS):
                    got = (got, "--set past the placeholder kept a publish hold")
            if expected[0] and argv[:1] == ["--set"] and before != {p: p.read_bytes() for p in root.rglob("*") if p.is_file()}:
                got = (got, "a refused --set changed a file")
            if got != expected:
                bad += 1
                print(f"versions self-test {name}: expected {expected}, got {got}", file=sys.stderr)
    print(f"versions self-test: {len(cases) - bad}/{len(cases)} cases hold")
    return 1 if bad else 0


def main(argv):
    if argv == ["--self-test"]:
        return self_test()
    if len(argv) not in (0, 2) or (argv and argv[0] not in ("--tag", "--set")):
        print("usage: versions [--tag vX.Y.Z | --set X.Y.Z | --self-test]", file=sys.stderr)
        return 2
    code, lines = run(REPO, argv)
    print("\n".join(lines), file=sys.stderr if code else sys.stdout)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
