#!/bin/sh
# time-limit SECONDS COMMAND...: GNU `timeout`, which macOS lacks (ticket 0128). It exits with
# COMMAND's code, or 124 after it stops COMMAND and everything COMMAND started.
set -u
limit=$1
shift
. "$(dirname -- "$0")/scratch.sh"
scratch_dir mark
child= watcher=
# A signal to time-limit stops the command's whole group, as a timeout does: TERM, then
# KILL 2 seconds later for anything that ignored it. The traps come first, so no signal
# lands between the start and the trap.
stop() {
	[ -z "$watcher" ] || kill "$watcher" 2>/dev/null
	if [ -n "$child" ]; then
		perl -e 'kill "TERM", -$ARGV[0]; sleep 2; kill "KILL", -$ARGV[0]' "$child" </dev/null >/dev/null 2>&1 &
		wait "$child"
	fi
	exit "$1"
}
trap 'stop 129' HUP
trap 'stop 130' INT
trap 'stop 143' TERM
# perl gives the command its own process group and this shell's standard input. It
# restores the interrupt and quit signals, which a shell ignores in a background command.
exec 3<&0
perl -e '$SIG{INT} = $SIG{QUIT} = "DEFAULT"; setpgrp(0, 0); exec { $ARGV[0] } @ARGV or die "time-limit: cannot run $ARGV[0]: $!\n"' -- "$@" <&3 3<&- &
child=$!
exec 3<&-
# The watcher holds no output open, so a reader of the command's output never waits on it.
perl -e 'sleep $ARGV[1]; kill 0, $ARGV[0] or exit; open my $f, ">", $ARGV[2]; kill "TERM", -$ARGV[0]; sleep 2; kill "KILL", -$ARGV[0]' \
	"$child" "$limit" "$mark/timed-out" </dev/null >/dev/null 2>&1 &
watcher=$!
wait "$child"
code=$?
kill "$watcher" 2>/dev/null
[ ! -e "$mark/timed-out" ] || code=124
exit "$code"
