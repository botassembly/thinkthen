#!/bin/sh
# The demo runner's refusals, against fixture pages that each break one.
#
# A check that runs from no rung rots, so the spec rung runs this before it
# runs the real pages. Each case builds a page under target/, runs the real
# sdlc/scripts/demos over it, and pins the exit code and the sentence.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
RUNNER=$REPO/sdlc/scripts/demos
ROOT=target/demos-standard

rm -rf -- "$REPO/$ROOT"
failures=0
cases=0

# Build one fixture root holding one page, whose body arrives on standard input.
fixture() {
	mkdir -p "$REPO/$ROOT/$1/page"
	cat >"$REPO/$ROOT/$1/page/README.md"
}

# Run the runner over one fixture root and pin the code and the sentence.
expect() {
	name=$1
	code=$2
	sentence=$3
	cases=$((cases + 1))
	said=$(sh -- "$RUNNER" "$ROOT/$name" 2>&1) && ran=0 || ran=$?
	if [ "$ran" -ne "$code" ]; then
		printf 'demos-self-test: %s exited %s and %s was wanted\n%s\n' \
			"$name" "$ran" "$code" "$said" >&2
		failures=$((failures + 1))
		return 0
	fi
	case "$said" in
	*"$sentence"*) ;;
	*)
		printf 'demos-self-test: %s printed no [%s]\n%s\n' \
			"$name" "$sentence" "$said" >&2
		failures=$((failures + 1))
		;;
	esac
}

head_of_a_page() {
	printf '# How to %s\n\nStatus: green\n\n' "$1"
}

block() {
	printf '```bash\nset -euo pipefail\n\n%s\n```\n\n' "$1"
}

ok='jq -rn '\''"ok"'\'' | mustmatch "ok"'

# A green page that asserts once runs.
{
	head_of_a_page 'assert once'
	block "$ok"
} | fixture ok
expect ok 0 'demos: 1 green, 0 red'

# A block fenced for another language asserts nothing and is not a test,
# because a page may show a command nobody runs in a gate.
{
	head_of_a_page 'show a command nobody runs'
	printf '```sh\nthinkthen decide QUESTION --record recording/ <evidence.txt\n```\n\n'
	block "$ok"
} | fixture other-language
expect other-language 0 'demos: 1 green, 0 red'

# A green page proves something.
{
	head_of_a_page 'assert nothing'
	printf '```sh\nthinkthen decide QUESTION\n```\n\n'
} | fixture no-assert
expect no-assert 1 'demos: page/README.md is green, and no block asserts anything'

# Every bash block asserts.
{
	head_of_a_page 'show a block that proves nothing'
	block "$ok"
	printf '```bash\nset -euo pipefail\n\nprintf '\''nobody checks this\\n'\''\n```\n\n'
} | fixture silent
expect silent 1 'demos: page/README.md: the bash block on line 11 asserts nothing'

# Ticket 0103: `like ""` matches any output, so the runner refuses it on any
# page, red or green, before it runs one. An option before or after `like`
# changes nothing about what it matches.
for form in 'loose-empty mustmatch like ""' 'loose-ignore-case mustmatch -i like ""' 'loose-dashes mustmatch like -- ""'; do
	name=${form%% *}
	{
		head_of_a_page 'claim an empty stream'
		block "printf 'stray' | ${form#* }"
	} | fixture "$name"
	expect "$name" 1 'demos: page/README.md:8: `like ""` matches any output; use `test -z`'
done

# Issue 2026-09-25 item 7: a quoted folder name hides its space from the
# folder check, so any name that is not plain fails and is named.
{
	head_of_a_page 'replay a spaced folder'
	printf 'The page runs `thinkthen decide Q --replay "my recording/"`.\n\n'
	block "$ok"
} | fixture replay-spaced
expect replay-spaced 1 'demos: page/README.md writes --replay "my recording/", and a folder name holds only'

# A green page that names a missing recording folder would reach a backend.
{
	head_of_a_page 'replay a missing folder'
	printf 'The page runs `thinkthen decide Q --replay gone/`.\n\n'
	block "$ok"
} | fixture replay-missing
expect replay-missing 1 'demos: page/README.md is green, and it names no folder gone/'

# A page the index lists as green and that says red would be skipped unseen.
{
	printf '# How to be skipped\n\nStatus: red\n\n'
	block "$ok"
} | fixture listed-red
printf '| # | How to | Verbs | Status |\n| --- | --- | --- | --- |\n| 01 | [Be skipped](page/) | `decide` | green |\n' >"$REPO/$ROOT/listed-red/README.md"
expect listed-red 1 'demos: README.md lists page/ as green, and page/README.md does not say Status: green'

# Item 9: under set +e a command fails unseen before the pinned one.
{
	head_of_a_page 'hide a failure under set +e'
	printf '```bash\nset +e\nfalse\n%s\n```\n\n' "$ok"
} | fixture set-e-off
expect set-e-off 1 'demos: page/README.md turns set -e off on line 6; capture each code with `&& rc=0 || rc=$?`'

if [ "$failures" -ne 0 ]; then
	printf 'demos-self-test: %s cases failed\n' "$failures" >&2
	exit 1
fi
printf 'demos-self-test: %s cases pass\n' "$cases"
