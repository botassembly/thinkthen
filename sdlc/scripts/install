#!/bin/sh
# Rung 0: the tools the other rungs need, then the dependency closure.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

# A rung that fails on a missing tool fails deep inside a build. Name it here.
# cargo builds and tests, python3 reads the accepted policies, node measures the
# size ceiling, and mustmatch runs the spec pages, the demos, and the demo
# runner's own tests under rung 2.
for tool in cargo python3 node mustmatch; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'install: %s is not on PATH, and a later rung needs it\n' "$tool" >&2
		exit 1
	fi
done

exec cargo fetch --manifest-path "$REPO/Cargo.toml" --locked
