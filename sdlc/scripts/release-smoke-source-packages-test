#!/bin/sh
# A missing whole wrapper group must refuse before the release backend build.
set -eu
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
mkdir "$work/bin" "$work/bundle"
cat >"$work/bin/cargo" <<EOF
#!/bin/sh
touch "$work/backend-started"
exit 88
EOF
chmod +x "$work/bin/cargo"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$repo/crates/thinkthen/Cargo.toml" | head -n 1)
target=$(rustc -vV | sed -n 's/^host: //p')
[ "$(uname -s):$(uname -m):$target" = Linux:x86_64:x86_64-unknown-linux-gnu ] || exit 77
# C is present, but the Go/C++ pair and every later source family are absent.
# The old conditional pair route would proceed to backend_start here.
: >"$work/bundle/thinkthen-c-$version-$target.tar.gz"
: >"$work/bundle/thinkthen-c-$version-$target.tar.gz.sha256"
set +e
PATH="$work/bin:$PATH" sh "$repo/sdlc/scripts/release-smoke" --source-packages "$work/bundle" >"$work/out" 2>&1
code=$?
set -e
[ "$code" -eq 1 ] || { cat "$work/out" >&2; echo "wanted exit 1, got $code" >&2; exit 1; }
grep -Fqx "release-smoke: missing or linked thinkthen-go-$version-$target.tar.gz" "$work/out" || { cat "$work/out" >&2; exit 1; }
[ ! -e "$work/backend-started" ] || { echo 'release backend started for missing source packages' >&2; exit 1; }
echo 'release-smoke source packages: missing whole group refused before backend'
