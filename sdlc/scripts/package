#!/bin/sh
# Prove the library-only graph, package tree, doctests, panic strategies, and
# the transform catalog built from the unpacked source package.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
# ADR 0113: a test that bypasses its scratch usage folder writes this decoy and fails the run.
. sdlc/scripts/scratch.sh
usage_guard

cargo build --locked --offline --package thinkthen --lib --no-default-features --features bundled-sqlite
# Ticket 0086: the library graph carries no command-only crate, and on Unix it
# keeps `nix` with `signal` for the host signal owner (ticket 0078).
graph=$(cargo tree --locked --offline --package thinkthen --no-default-features --features bundled-sqlite -e normal,build --prefix none -f '{p} {f}')
if printf '%s\n' "$graph" | grep -Eq '^(clap|csv-core|signal-hook) '; then
    printf '%s\n' 'package: command dependency entered the library-only graph' >&2
    exit 1
fi
if [ "$(uname -s)" = Linux ] && ! printf '%s\n' "$graph" | grep -Eq '^nix v[^ ]+ .*signal'; then
    printf '%s\n' 'package: the library graph lost nix with feature signal' >&2
    exit 1
fi
# One library target, a command binary, and no procedural macro of its own.
targets=$(cargo metadata --locked --offline --no-deps --format-version 1 \
    | python3 -c 'import json,sys; print(" ".join(sorted(k for p in json.load(sys.stdin)["packages"] if p["name"]=="thinkthen" for t in p["targets"] for k in t["kind"] if k in ("lib","proc-macro","bin"))))')
test "$targets" = "bin lib" \
    || { printf 'package: thinkthen has targets %s, not one lib and one bin\n' "$targets" >&2; exit 1; }
# The library-only run. Without `cli` cargo builds no binary but still names
# its path, so every test that starts the command carries
# `#[cfg(feature = "cli")]` and compiles to nothing here. This run uses its
# own target folder, where no earlier build left a binary to hide a missing
# gate. The next command runs the public doctests.
CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}/library-only" \
    cargo test --locked --offline --package thinkthen --no-default-features --features bundled-sqlite --all-targets
cargo test --locked --offline --package thinkthen --doc --no-default-features --features bundled-sqlite

# Ticket 0104: `cargo package` rewrites a stale crate without truncating it, and
# `tar` then refuses the trailing bytes. Plant a longer one, then remove it.
# Cargo packs into the target folder the caller names.
packaged=${CARGO_TARGET_DIR:-target}/package
mkdir -p "$packaged"
head -c 4194304 /dev/urandom \
    >"$packaged/thinkthen-$(sed -n 's/^version = "\([^"]*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -1).crate"
rm -f -- "$packaged"/thinkthen-*.crate
# The conformance backend is a test-only member and never ships (ticket 0092).
cargo package --locked --offline --allow-dirty --package thinkthen
# The package holds the crate's source, tests, transforms, license, and README,
# and nothing from a sibling crate, a worktree, a build, or a release.
unexpected=$(cargo package --locked --offline --allow-dirty --package thinkthen --list \
    | grep -Ev '^(src/|tests/|transforms/|Cargo\.(toml|toml\.orig|lock)$|\.cargo_vcs_info\.json$|clippy\.toml$|LICENSE$|README\.md$)' || true)
test -z "$unexpected" \
    || { printf 'package: unexpected packaged file %s\n' $unexpected >&2; exit 1; }

# Ticket 0083: the source package carries the ten transforms byte for byte, and
# a binary built from the unpacked package alone prints them from an empty
# folder after the unpacked source is gone.
crate="$packaged/thinkthen-$(sed -n 's/^version = "\([^"]*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -1).crate"
python3 sdlc/scripts/catalog.py --crate "$crate"
scratch_dir isolated && scratch_dir source && scratch_dir built
mkdir "$isolated/empty" "$isolated/out"
tar -xzf "$crate" -C "$source" --strip-components=1
RUSTUP_TOOLCHAIN=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml) \
CARGO_TARGET_DIR="$built" \
    cargo build --quiet --locked --offline --manifest-path "$source/Cargo.toml" --lib --no-default-features --features bundled-sqlite
RUSTUP_TOOLCHAIN=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml) \
CARGO_TARGET_DIR="$built" \
    cargo build --quiet --locked --offline --manifest-path "$source/Cargo.toml" --bin thinkthen
# 0431: the actual complete Rust consumer also links the unpacked crate.
# Keep its caller framing and the ten concrete native APIs, then execute the
# unchanged shared matrix against that archive-built executable.
cp -R libraries/rust/consumer "$isolated/consumer"
python3 - "$source" "$isolated/consumer/Cargo.toml" <<'RUSTPACKAGE'
import sys
from pathlib import Path
source,manifest=map(Path,sys.argv[1:])
manifest.write_text(manifest.read_text().replace('../../../crates/thinkthen',str(source)))
RUSTPACKAGE
RUSTUP_TOOLCHAIN=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml) \
CARGO_TARGET_DIR="$built" \
    cargo build --quiet --locked --offline --manifest-path "$isolated/consumer/Cargo.toml"
# The shared native fixture starts the test backend from the repository target,
# while the unpacked consumer above stays in its separate build folder.
CARGO_TARGET_DIR="$REPO/target" cargo build --quiet --locked --offline --package conformance-backend
python3 - "$REPO" "$built/debug/thinkthen-rust-consumer" "$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml)" >"$isolated/native-source.log" <<'RUSTPACKAGE'
import sys
from pathlib import Path
root=Path(sys.argv[1]);sys.path.insert(0,str(root/'libraries/python/tests'))
from native_fixture import run
sys.exit(bool(run('rust',[sys.argv[2]],root,extra_env={'RUSTUP_TOOLCHAIN':sys.argv[3]})))
RUSTPACKAGE
cp "$built/debug/thinkthen" "$isolated/thinkthen"
scratch_remove "$source" && scratch_remove "$built"
names='band calibration compare cost counts monitor score sweep triage trials'
(
	cd -- "$isolated/empty"
	"$isolated/thinkthen" transform list >"$isolated/out/list" 2>"$isolated/out/stderr"
	for name in $names; do
		"$isolated/thinkthen" transform show "$name" >"$isolated/out/$name.jq" 2>>"$isolated/out/stderr"
	done
)
printf '%s\n' $names | cmp -s - "$isolated/out/list" \
	|| { printf '%s\n' 'package: the unpacked build lists another catalog' >&2; exit 1; }
test ! -s "$isolated/out/stderr" \
	|| { printf '%s\n' 'package: the unpacked build wrote to standard error' >&2; exit 1; }
for name in $names; do
	cmp -s "transforms/$name/$name.jq" "$isolated/out/$name.jq" \
		|| { printf 'package: the unpacked build shows other bytes for %s\n' "$name" >&2; exit 1; }
done
test -z "$(ls -A "$isolated/empty")" \
	|| { printf '%s\n' 'package: the unpacked build wrote into its folder' >&2; exit 1; }

cargo rustc --locked --offline --release --package thinkthen --lib --no-default-features --features bundled-sqlite \
    -- --print cfg | grep -Fx 'panic="unwind"' >/dev/null
RUSTFLAGS='-C panic=abort' cargo rustc --locked --offline --release --package thinkthen \
    --bin thinkthen -- --print cfg | grep -Fx 'panic="abort"' >/dev/null

printf '%s\n' 'package: library graph, package tree, doctests, panic strategies, and unpacked catalog pass'
