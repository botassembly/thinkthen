#!/bin/sh
# Prove the library-only graph, package tree, doctests, panic strategies, and
# the transform catalog built from the unpacked source package.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"

cargo build --locked --offline --package thinkthen --lib --no-default-features
if cargo tree --locked --offline --package thinkthen --no-default-features -e normal --prefix none \
    | grep -Eq '^(clap|csv-core) '; then
    printf '%s\n' 'package: command dependency entered the library-only graph' >&2
    exit 1
fi
RUSTFLAGS='--cfg thinkthen_internal_doctest' \
RUSTDOCFLAGS='--cfg thinkthen_internal_doctest' \
    cargo test --locked --offline --package thinkthen --doc --no-default-features

prove_private() {
    target=$1
    shift
    CARGO_TARGET_DIR="$target" cargo build --locked --offline --package thinkthen --lib "$@"
    library=$(find "$target/debug/deps" -name 'libthinkthen-*.rlib' -print -quit)
    if rustc --edition 2024 -L "dependency=$target/debug/deps" --extern "thinkthen=$library" \
        -o "$target/private-probe" - 2>"$target/private-probe.stderr" <<'RS'
fn main() {
    let _ = thinkthen::__internal_doctest::version_line("0.0.1");
}
RS
    then
        printf '%s\n' 'package: a normal library build exposes the doctest harness' >&2
        exit 1
    fi
    if ! grep -F 'could not find `__internal_doctest` in `thinkthen`' \
        "$target/private-probe.stderr" >/dev/null; then
        printf '%s\n' 'package: the private-surface probe failed for another reason' >&2
        cat "$target/private-probe.stderr" >&2
        exit 1
    fi
}
prove_private target/private-proof-default
prove_private target/private-proof-no-default --no-default-features
# The conformance backend is a test-only member and never ships (ticket 0092).
cargo package --locked --offline --allow-dirty --package thinkthen

# Ticket 0083: the source package carries the ten transforms byte for byte, and
# a binary built from the unpacked package alone prints them from an empty
# folder after the unpacked source is gone.
crate="target/package/thinkthen-$(sed -n 's/^version = "\([^"]*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -1).crate"
python3 sdlc/scripts/catalog.py --crate "$crate"
isolated=$(mktemp -d)
trap 'rm -rf -- "$isolated"' EXIT
mkdir "$isolated/source" "$isolated/empty" "$isolated/out"
tar -xzf "$crate" -C "$isolated/source" --strip-components=1
RUSTUP_TOOLCHAIN=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml) \
CARGO_TARGET_DIR="$isolated/target" \
    cargo build --quiet --locked --offline --manifest-path "$isolated/source/Cargo.toml" --bin thinkthen
cp "$isolated/target/debug/thinkthen" "$isolated/thinkthen"
rm -rf -- "$isolated/source" "$isolated/target"
names='band calibration compare cost counts monitor score sweep triage trials'
(
	cd -- "$isolated/empty"
	"$isolated/thinkthen" transform list >"$isolated/out/list" 2>"$isolated/out/stderr"
	for name in $names; do
		"$isolated/thinkthen" transform show "$name" >"$isolated/out/$name.jq" 2>>"$isolated/out/stderr"
	done
)
printf '%s\n' $names | cmp -s - "$isolated/out/list" \
	|| { printf '%s\n' 'package: the unpacked build lists another catalog' >&2; exit 1; }
test ! -s "$isolated/out/stderr" \
	|| { printf '%s\n' 'package: the unpacked build wrote to standard error' >&2; exit 1; }
for name in $names; do
	cmp -s "transforms/$name/$name.jq" "$isolated/out/$name.jq" \
		|| { printf 'package: the unpacked build shows other bytes for %s\n' "$name" >&2; exit 1; }
done
test -z "$(ls -A "$isolated/empty")" \
	|| { printf '%s\n' 'package: the unpacked build wrote into its folder' >&2; exit 1; }

cargo rustc --locked --offline --release --package thinkthen --lib --no-default-features \
    -- --print cfg | grep -Fx 'panic="unwind"' >/dev/null
RUSTFLAGS='-C panic=abort' cargo rustc --locked --offline --release --package thinkthen \
    --bin thinkthen -- --print cfg | grep -Fx 'panic="abort"' >/dev/null

printf '%s\n' 'package: library graph, package tree, doctests, panic strategies, and unpacked catalog pass'
