# Sourced by heavy-lock and lint (ticket 0133). The rung and every child it
# starts see only the names below. A developer's unrelated service key never
# reaches cargo, a build script, a test binary, or a surface check.
# CARGO_TARGET_DIR is left off, so every rung builds in the lane's own target
# folders, the only place spec and the surface checks look. The names are
# found without printing any value.
for name in $(awk 'BEGIN { for (name in ENVIRON) print name }'); do
	case $name in
	GITHUB_ACTIONS | RUNNER_ENVIRONMENT) ;;
	PATH | HOME | PWD | LANG | LC_ALL | TMPDIR | XDG_CONFIG_HOME | XDG_RUNTIME_DIR | XDG_CACHE_HOME | XDG_STATE_HOME) ;;
	CARGO_BUILD_JOBS | CARGO_HOME | RUSTUP_HOME | RUSTUP_TOOLCHAIN | RUSTC_WRAPPER | SCCACHE_CONF | R_LIBS_USER | PUB_CACHE | UV_CACHE_DIR | UV_PYTHON_INSTALL_DIR | npm_config_cache) ;;
	THINKTHEN_TOOLCHAINS | THINKTHEN_SESSION_JDK_HOME | THINKTHEN_DUCKDB_CLI | SQLITE_AMALGAMATION) ;;
	THINKTHEN_PRIVATE_NAMES | THINKTHEN_PUBLISH_ROOT | THINKTHEN_MACOS_APPLE_CHECKS) ;;
	*)
        # macOS sh cannot unset a name containing punctuation. Remove it before
        # restarting the entry script; ordinary names remain shell-local work.
        case $name in
        *[!A-Za-z0-9_]* | [0-9]*) exec env -u "$name" /bin/sh "$0" "$@" ;;
        *) unset "$name" ;;
        esac ;;
	esac
done
