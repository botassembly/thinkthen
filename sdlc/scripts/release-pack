#!/bin/sh
# release-pack [--reuse] TARGET OUT [PART...] (ticket 0128): pack the release files of one
# Rust target into OUT, each with a `.sha256` beside it. TARGET is this host's target, since
# each release target builds on its own runner. The parts are command, c, go, cpp, csharp,
# jvm, swift, zig, php, dart, flutter, ada, objective-c, cobol, sqlite, duckdb,
# postgresql, python, typescript, ruby, first-run, crate, and r; the default
# keeps its established parts and source wrappers are explicit pilot parts.
# Without --reuse it builds each file from this checkout. With --reuse it packs the files each
# surface check already built in its own build folder, which the `surfaces` rung does. It
# rebuilds only the C library's debug build, with the remaps below, so source wrappers packed
# with --reuse name that debug C archive (ticket 0362). Without --reuse or a CARGO_TARGET_DIR,
# each part builds in a scratch folder that goes once the part is packed (ticket 0366). Every
# cargo call is locked; fetch first where the network is off.
set -eu
reuse=
[ "${1:-}" != --reuse ] || { reuse=1; shift; }
[ $# -ge 2 ] || { echo 'usage: release-pack [--reuse] TARGET OUT [PART...]' >&2; exit 2; }
TARGET=$1 OUT=$2
shift 2
REPO=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
host=$(rustc -vV | sed -n 's/^host: //p')
[ "$TARGET" = "$host" ] || { echo "release-pack: $TARGET is not this host's target, $host" >&2; exit 2; }
V=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$REPO/crates/thinkthen/Cargo.toml" | head -n 1)
c_built=
dart_built=
case " $* " in
*' go '* | *' cpp '* | *' csharp '* | *' jvm '* | *' swift '* | *' zig '* | *' php '* | *' dart '* | *' flutter '* | *' ada '* | *' objective-c '* | *' cobol '*)
	if git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		[ -z "${THINKTHEN_ARCHIVED_SOURCE_TAR:-}${THINKTHEN_ARCHIVED_SOURCE_COMMIT:-}" ] || {
			echo 'release-pack: archive identity cannot override a repository checkout' >&2; exit 1;
		}
		source_commit=$(git -C "$REPO" rev-parse HEAD)
		[ -z "$(git -C "$REPO" status --porcelain)" ] || { echo 'release-pack: source wrappers need a clean committed tree' >&2; exit 1; }
	else
		[ -z "$reuse" ] || { echo 'release-pack: archived source does not permit --reuse' >&2; exit 1; }
		case " $* " in *' go '* | *' cpp '* | *' swift '* | *' zig '* | *' php '* | *' dart '* | *' ada '* | *' objective-c '* | *' cobol '*) ;; *) echo 'release-pack: archived source permits only selected source wrappers' >&2; exit 1 ;; esac
		for part in "$@"; do
			case $part in c | go | cpp | swift | zig | php | dart | ada | objective-c | cobol | sqlite | duckdb | postgresql | python | typescript | ruby) ;;
			*) echo "release-pack: archived source does not permit $part" >&2; exit 1 ;; esac
		done
		case ${THINKTHEN_ARCHIVED_SOURCE_TAR:-} in /*) ;; *) echo 'release-pack: archived source tar path must be absolute' >&2; exit 1 ;; esac
		[ -f "$THINKTHEN_ARCHIVED_SOURCE_TAR" ] && [ ! -L "$THINKTHEN_ARCHIVED_SOURCE_TAR" ] || {
			echo 'release-pack: archived source tar is missing or linked' >&2; exit 1;
		}
		source_commit=$(git get-tar-commit-id <"$THINKTHEN_ARCHIVED_SOURCE_TAR") || {
			echo 'release-pack: archived source tar has no Git commit' >&2; exit 1;
		}
		printf '%s\n' "$source_commit" | grep -Eq '^[0-9a-f]{40}$' || { echo 'release-pack: archived source commit is invalid' >&2; exit 1; }
		[ "$source_commit" = "${THINKTHEN_ARCHIVED_SOURCE_COMMIT:-}" ] || {
			echo 'release-pack: archived source commit differs from selected checkout' >&2; exit 1;
		}
		python3 "$REPO/sdlc/scripts/release-archive-tree.py" "$THINKTHEN_ARCHIVED_SOURCE_TAR" "$REPO" || {
			echo 'release-pack: extracted source differs from selected archive' >&2; exit 1;
		}
	fi
	case " $* " in *' c '*) ;; *) echo 'release-pack: source wrappers need c in this invocation' >&2; exit 1 ;; esac
	c_count=0
	for part in "$@"; do [ "$part" != c ] || c_count=$((c_count + 1)); done
	[ "$c_count" -eq 1 ] || { echo 'release-pack: source wrappers need exactly one c part' >&2; exit 1; }
	c_name=thinkthen-c-$V-$TARGET.tar.gz
	[ ! -e "$OUT/$c_name" ] && [ ! -L "$OUT/$c_name" ] &&
		[ ! -e "$OUT/$c_name.sha256" ] && [ ! -L "$OUT/$c_name.sha256" ] || {
		echo 'release-pack: source wrappers need an output without an existing C archive or sidecar' >&2; exit 1;
	}
	;;
esac
case " $* " in
*' flutter '*)
	dart_count=0 flutter_count=0
	for part in "$@"; do
		[ "$part" != dart ] || dart_count=$((dart_count + 1))
		[ "$part" != flutter ] || flutter_count=$((flutter_count + 1))
	done
	[ "$dart_count" -eq 1 ] && [ "$flutter_count" -eq 1 ] || {
		echo 'release-pack: Flutter needs exactly one dart and one flutter part' >&2; exit 1;
	}
	for name in "thinkthen-dart-$V-$TARGET.tar.gz" "thinkthen-flutter-$V-$TARGET.tar.gz"; do
		[ ! -e "$OUT/$name" ] && [ ! -L "$OUT/$name" ] &&
			[ ! -e "$OUT/$name.sha256" ] && [ ! -L "$OUT/$name.sha256" ] || {
			echo "release-pack: Flutter needs an output without an existing $name or sidecar" >&2; exit 1;
		}
	done
	;;
esac
mkdir -p -- "$OUT"
OUT=$(CDPATH='' cd -- "$OUT" && pwd)
cd -- "$REPO"
case $TARGET in
*-apple-darwin) dl=dylib command_target=$TARGET ;;
*-linux-gnu) dl=so command_target=${TARGET%-gnu}-musl ;;
x86_64-pc-windows-msvc) dl=dll command_target=$TARGET ;;
*) echo "release-pack: no release for $TARGET" >&2; exit 2 ;;
esac
# The source and Cargo cache can sit outside HOME in a release container.
# Remap all three origins before packaging a library's panic/debug locations.
cargo_home=${CARGO_HOME:-$HOME/.cargo}
source_remap=$REPO cargo_remap=$cargo_home home_remap=$HOME
if [ "$TARGET" = x86_64-pc-windows-msvc ]; then
	# Rust on Windows reports native paths; Git Bash paths cannot match them.
	source_remap=$(cygpath -m "$REPO") cargo_remap=$(cygpath -m "$cargo_home") home_remap=$(cygpath -m "$HOME")
	if [ -n "${CARGO_TARGET_DIR:-}" ]; then
		CARGO_TARGET_DIR=$(cygpath -m "$CARGO_TARGET_DIR")
		export CARGO_TARGET_DIR
	fi
fi
RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$source_remap=/build/source --remap-path-prefix=$cargo_remap=/build/cargo --remap-path-prefix=$home_remap=/build/home"
if [ "$TARGET" != x86_64-pc-windows-msvc ]; then
	CFLAGS="${CFLAGS:+$CFLAGS }-ffile-prefix-map=$REPO=/build/source -ffile-prefix-map=$cargo_home=/build/cargo -ffile-prefix-map=$HOME=/build/home"
else
	# MSVC does not accept the Unix compiler's file-prefix-map flags.
	CFLAGS=${CFLAGS:-}
fi
export RUSTFLAGS CFLAGS
. sdlc/scripts/scratch.sh
scratch_dir stage

# The build folder of the crate in $1, by the one rule every check reads.
built() { echo "${CARGO_TARGET_DIR:-$REPO/$1/target}"; }
sha256() {
	if [ "$TARGET" = x86_64-pc-windows-msvc ]; then
		# Windows sha256sum defaults to a binary '*' marker. Our sidecars use
		# two spaces and LF on every target. Avoid native stdout CRLF translation.
		python3 - "$@" <<'PYTHON'
import hashlib, pathlib, sys
for name in sys.argv[1:]:
    sys.stdout.buffer.write(f"{hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()}  {name}\n".encode("ascii"))
PYTHON
	elif command -v sha256sum >/dev/null; then sha256sum "$@"
	else shasum -a 256 "$@"
	fi
}
# pack NAME FOLDER: tar FOLDER's contents into OUT/NAME and write OUT/NAME.sha256.
pack() {
	tar -czf "$OUT/$1" -C "$2" .
	(cd -- "$OUT" && sha256 "$1" >"$1.sha256")
}
# keep FILE: copy a file a tool already packed into OUT, with its checksum.
keep() {
	[ -f "$1" ] || { echo "release-pack: $1 is missing; build it first" >&2; exit 1; }
	cp -- "$1" "$OUT/"
	(cd -- "$OUT" && sha256 "${1##*/}" >"${1##*/}.sha256")
}
# fresh NAME: a new folder in the stage, with the mode a plain mkdir gives, which each archive root carries.
fresh() { fresh=$(mktemp -d "$stage/$1.XXXXXX") && chmod 755 "$fresh" && echo "$fresh"; }

part_command() {
	suffix=
	[ "$TARGET" != x86_64-pc-windows-msvc ] || suffix=.exe
	if [ -n "$reuse" ]; then
		binary=${CARGO_TARGET_DIR:-$REPO/target}/debug/thinkthen$suffix
	else
		case $command_target in *-linux-musl)
			# Without a musl gcc, clang compiles the bundled SQLite against glibc's headers.
			# SQLite's large-file define then names open64 and stat64, which musl 1.2.4 and
			# later no longer export. On a 64-bit target off_t is 64 bits without that define.
			target_var=$(printf '%s' "$command_target" | tr - _)
			eval "cc=\${CC_$target_var:-}"
			if [ -z "$cc" ] && ! command -v "${command_target%%-*}-linux-musl-gcc" >/dev/null &&
				! { [ "$command_target" = x86_64-unknown-linux-musl ] && command -v musl-gcc >/dev/null; }; then
				command -v clang >/dev/null || { echo 'release-pack: the static command needs clang or a musl gcc' >&2; exit 1; }
				export "CC_$target_var=clang"
			fi
			eval "flags=\${CFLAGS_$target_var:-}"
			export "CFLAGS_$target_var=${flags:+$flags }-DSQLITE_DISABLE_LFS"
		;; esac
		cargo build --locked --quiet --release --package thinkthen --target "$command_target"
		binary=${CARGO_TARGET_DIR:-$REPO/target}/$command_target/release/thinkthen$suffix
	fi
	folder=$(fresh command)
	cp -- "$binary" "$folder/thinkthen$suffix"
	if [ -n "$suffix" ]; then
		name=thinkthen-$V-$command_target.zip
		python3 sdlc/scripts/release-windows-command.py pack "$folder/thinkthen.exe" "$OUT/$name"
		(cd -- "$OUT" && sha256 "$name" >"$name.sha256")
	else
		pack "thinkthen-$V-$command_target.tar.gz" "$folder"
	fi
}

# The header, both libraries under the soname layout build.rs sets, and a relocatable .pc.
part_c() {
	profile=debug
	[ -n "$reuse" ] || { profile=release; (cd libraries/c && cargo build --locked --quiet --release --lib); }
	# Later checks, such as COBOL's, rebuild the C library without remaps into the same folder, so
	# the copy there holds the builder's home. --reuse rebuilds it here with the remaps above.
	[ -z "$reuse" ] || (cd libraries/c && cargo build --locked --quiet --offline --lib)
	if [ "$TARGET" = x86_64-pc-windows-msvc ]; then
		from=$(built libraries/c)/$profile
		python3 sdlc/scripts/release-windows-c.py pack "$from/thinkthen_c.dll" libraries/c/include/thinkthen.h "$OUT/thinkthen-c-$V-$TARGET.zip"
		c_built=1
		return
	fi
	from=$(built libraries/c)/$profile
	folder=$(fresh c)
	mkdir -p "$folder/include" "$folder/lib/pkgconfig"
	cp libraries/c/include/thinkthen.h "$folder/include/"
	sh libraries/c/localize.sh "$from/libthinkthen_c.a" "$folder/lib/libthinkthen.a"
	if [ "$dl" = dylib ]; then
		cp -- "$from/libthinkthen_c.dylib" "$folder/lib/libthinkthen.dylib"
		ln -s libthinkthen.dylib "$folder/lib/libthinkthen.0.dylib"
		# The rehearsal on macOS measures its static link line (Phase 3).
		private=
	else
		cp -- "$from/libthinkthen_c.so" "$folder/lib/libthinkthen.so"
		ln -s libthinkthen.so "$folder/lib/libthinkthen.so.0"
		private='-lgcc_s -lutil -lrt -lpthread -lm -ldl -lc'
	fi
	cat >"$folder/lib/pkgconfig/thinkthen.pc" <<-EOF
		prefix=\${pcfiledir}/../..
		libdir=\${prefix}/lib
		includedir=\${prefix}/include

		Name: thinkthen
		Description: Semantic judgments over text, through the thinkthen engine
		Version: $V
		Libs: -L\${libdir} -lthinkthen
		Libs.private: $private
		Cflags: -I\${includedir}
	EOF
	pack "thinkthen-c-$V-$TARGET.tar.gz" "$folder"
	c_built=1
}

part_source_wrapper() {
	[ "$c_built" = 1 ] || { echo "release-pack: $1 needs c built earlier in this invocation" >&2; exit 1; }
	c_name=thinkthen-c-$V-$TARGET.tar.gz
	[ -f "$OUT/$c_name" ] || { echo 'release-pack: C archive is missing' >&2; exit 1; }
	c_digest=$(sha256 "$OUT/$c_name" | awk '{print $1}')
	folder=$(fresh "$1")
	case $1 in
	go)
		mkdir -p "$folder/examples/decide"
		cp libraries/go/LICENSE libraries/go/README.md libraries/go/go.mod \
			libraries/go/*.go "$folder/"
		cp libraries/go/examples/decide/main.go "$folder/examples/decide/"
		;;
cpp)
		mkdir -p "$folder/cmake" "$folder/include/thinkthen"
		cp libraries/cpp/LICENSE libraries/cpp/README.md libraries/cpp/CMakeLists.txt "$folder/"
		cp libraries/cpp/cmake/ThinkThenCppConfig.cmake.in "$folder/cmake/"
		cp libraries/cpp/include/thinkthen/*.hpp "$folder/include/thinkthen/"
		;;
csharp)
		mkdir -p "$folder/feed"
		scratch_dir csharp_native
		tar -xzf "$OUT/$c_name" -C "$csharp_native"
		native_properties=$(python3 sdlc/scripts/package-inventory.py csharp --target "$TARGET")
		native_rid=$(printf '%s' "$native_properties" | python3 -c 'import json,sys; print(json.load(sys.stdin)["native"][sys.argv[1]]["rid"])' "$TARGET")
		native_name=$(printf '%s' "$native_properties" | python3 -c 'import json,sys; print(json.load(sys.stdin)["native"][sys.argv[1]]["file"].split("/")[-1])' "$TARGET")
		DOTNET_CLI_HOME="$stage/dotnet-home" NUGET_PACKAGES="$stage/nuget" \
		DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1 \
		${THINKTHEN_DOTNET:-dotnet} pack libraries/csharp/ThinkThen.csproj -c Release \
			--source "$folder/feed" -o "$folder" -v quiet \
			-p:ThinkThenNativeAsset="$csharp_native/lib/$native_name" -p:ThinkThenNativeRid="$native_rid" -p:ThinkThenNativeName="$native_name"
		[ -f "$folder/Botassembly.ThinkThen.$V.nupkg" ] || { echo 'release-pack: C# nupkg missing' >&2; exit 1; }
		scratch_remove "$csharp_native"
		rmdir "$folder/feed"
		# The release workflow's managed pair packs the same four files (ticket 0375).
		cp libraries/csharp/LICENSE libraries/csharp/README.md "$folder/"
		;;
jvm)
		scratch_dir jvm_out
		mkdir -p "$jvm_out/native"
		tar -xzf "$OUT/$c_name" -C "$jvm_out/native"
		THINKTHEN_JVM_OUT=$jvm_out/product THINKTHEN_JVM_NATIVE="$jvm_out/native/lib/libthinkthen.$dl" THINKTHEN_JVM_TARGET="$TARGET" sh libraries/jvm/build.sh
		THINKTHEN_JVM_OUT=$jvm_out/product python3 libraries/jvm/tests/package_check.py --session
		for file in $(python3 sdlc/scripts/package-inventory.py jvm --target "$TARGET" --field files); do
			case $file in *.jar|product-inventory.json) cp "$jvm_out/product/jars/$file" "$folder/" ;; *) cp "libraries/jvm/$file" "$folder/" ;; esac
		done
		;;
swift)
		mkdir -p "$folder/Examples" "$folder/Sources/CThinkThen/include" \
			"$folder/Sources/ThinkThen" "$folder/Tests/TypeCase"
		cp libraries/swift/LICENSE libraries/swift/README.md libraries/swift/Package.swift "$folder/"
		cp libraries/swift/Examples/main.swift "$folder/Examples/"
		cp libraries/swift/Sources/CThinkThen/module.modulemap "$folder/Sources/CThinkThen/"
		cp libraries/swift/Sources/CThinkThen/bridge.c "$folder/Sources/CThinkThen/"
		cp libraries/c/include/thinkthen.h "$folder/Sources/CThinkThen/include/"
		cp libraries/swift/Sources/CThinkThen/include/loader.h "$folder/Sources/CThinkThen/include/"
		cp libraries/swift/Sources/ThinkThen/*.swift "$folder/Sources/ThinkThen/"
		case $TARGET in
		*-apple-darwin)
			[ -d libraries/swift/CThinkThen.xcframework ] || { echo 'release-pack: Swift needs the matching assembled universal CThinkThen.xcframework' >&2; exit 1; }
			cp -R libraries/swift/CThinkThen.xcframework "$folder/" ;;
		*-unknown-linux-gnu)
			mkdir -p "$folder/Sources/ThinkThen/Native/$TARGET"
			cp libraries/swift/Sources/ThinkThen/Native/README.txt "$folder/Sources/ThinkThen/Native/"
			tar -xOzf "$OUT/$c_name" ./lib/libthinkthen.so >"$folder/Sources/ThinkThen/Native/$TARGET/libthinkthen.so" ;;
		*) echo 'release-pack: unsupported Swift native target' >&2; exit 1 ;;
		esac
		cp libraries/swift/Tests/TypeCase/main.swift "$folder/Tests/TypeCase/"
		;;
zig)
		mkdir -p "$folder/examples" "$folder/src"
		cp libraries/zig/LICENSE libraries/zig/README.md libraries/zig/build.zig \
			libraries/zig/build.zig.zon "$folder/"
		cp libraries/zig/examples/decide.zig "$folder/examples/"
		cp libraries/zig/src/thinkthen.zig libraries/zig/src/complete.zig libraries/zig/src/native.zig libraries/zig/src/session.zig libraries/zig/src/authored.zig \
			libraries/zig/src/request_generated.zig libraries/zig/src/plan_generated.zig "$folder/src/"
		mkdir -p "$folder/native/$TARGET"
		tar -xzf "$OUT/$c_name" -C "$folder/native/$TARGET" ./include/thinkthen.h ./lib/libthinkthen.a
		;;
php)
		cp libraries/php/LICENSE libraries/php/README.md libraries/php/composer.json libraries/php/autoload.php "$folder/"
		cp -R libraries/php/src libraries/php/examples "$folder/"
        case $TARGET in
        *-unknown-linux-gnu)
            mkdir -p "$folder/native"
            tar -xOzf "$OUT/$c_name" ./lib/libthinkthen.so >"$folder/native/libthinkthen.so" ;;
        *) echo 'release-pack: PHP native package target is unsupported' >&2; exit 1 ;;
        esac
		;;
dart)
		mkdir -p "$folder"
		cp libraries/dart/CHANGELOG.md libraries/dart/LICENSE libraries/dart/README.md \
			libraries/dart/pubspec.yaml libraries/dart/pubspec.lock libraries/dart/native-assets.json "$folder/"
		cp -R libraries/dart/lib libraries/dart/hook "$folder/"
		;;
flutter)
		[ "$dart_built" = 1 ] || { echo 'release-pack: flutter needs dart built earlier in this invocation' >&2; exit 1; }
		dart_name=thinkthen-dart-$V-$TARGET.tar.gz
		[ -f "$OUT/$dart_name" ] || { echo 'release-pack: Dart archive is missing' >&2; exit 1; }
		dart_digest=$(sha256 "$OUT/$dart_name" | awk '{print $1}')
		mkdir -p "$folder/flutter/lib" "$folder/flutter/example/lib" \
			"$folder/flutter/example/linux/flutter" "$folder/flutter/example/linux/runner"
		cp libraries/dart/flutter/README.md libraries/dart/flutter/pubspec.yaml "$folder/flutter/"
		cp -R libraries/dart/flutter/lib/. "$folder/flutter/lib/"
		cp -R libraries/dart/flutter/linux "$folder/flutter/"
		cp libraries/dart/flutter/example/.metadata libraries/dart/flutter/example/README.md \
			libraries/dart/flutter/example/pubspec.yaml libraries/dart/flutter/example/pubspec.lock \
			libraries/dart/flutter/example/analysis_options.yaml "$folder/flutter/example/"
		cp libraries/dart/flutter/example/lib/main.dart "$folder/flutter/example/lib/"
		cp libraries/dart/flutter/example/linux/CMakeLists.txt "$folder/flutter/example/linux/"
		cp libraries/dart/flutter/example/linux/flutter/CMakeLists.txt \
			libraries/dart/flutter/example/linux/flutter/generated_plugin_registrant.h \
			libraries/dart/flutter/example/linux/flutter/generated_plugin_registrant.cc \
			libraries/dart/flutter/example/linux/flutter/generated_plugins.cmake \
			"$folder/flutter/example/linux/flutter/"
		cp libraries/dart/flutter/example/linux/runner/CMakeLists.txt \
			libraries/dart/flutter/example/linux/runner/main.cc \
			libraries/dart/flutter/example/linux/runner/my_application.cc \
			libraries/dart/flutter/example/linux/runner/my_application.h \
			"$folder/flutter/example/linux/runner/"
		;;
ada)
		mkdir -p "$folder/src" "$folder/examples" "$folder/native"
		tar -xzf "$OUT/$c_name" -C "$folder/native" ./include/thinkthen.h ./lib/libthinkthen.a
		cp libraries/ada/LICENSE libraries/ada/README.md libraries/ada/thinkthen.gpr "$folder/"
		cp libraries/ada/src/*.ads libraries/ada/src/*.adb "$folder/src/"
		cp libraries/ada/examples/consumer.adb libraries/ada/examples/native.adb \
			libraries/ada/examples/session_demo.adb "$folder/examples/"
		;;
objective-c)
		mkdir -p "$folder/Sources" "$folder/Examples"
		cp libraries/objective-c/LICENSE libraries/objective-c/README.md \
			libraries/objective-c/source-package.json "$folder/"
		cp libraries/objective-c/Sources/ThinkThen.h libraries/objective-c/Sources/ThinkThen.m \
			libraries/objective-c/Sources/TTJSON.h libraries/objective-c/Sources/TTJSON.c \
			libraries/objective-c/Sources/TTComplete.h libraries/objective-c/Sources/TTComplete.c \
			libraries/objective-c/Sources/TTNative.h libraries/objective-c/Sources/TTNativeAPI.h \
			libraries/objective-c/Sources/TTNativeAPI.m libraries/objective-c/Sources/TTNativeViews.c "$folder/Sources/"
		cp libraries/objective-c/Examples/consumer.m "$folder/Examples/"
		;;
cobol)
		mkdir -p "$folder/src" "$folder/copybooks" "$folder/examples" "$folder/native"
		cp libraries/cobol/LICENSE libraries/cobol/README.md libraries/cobol/source-package.json "$folder/"
		cp libraries/cobol/copybooks/tt-native-generated.cpy "$folder/copybooks/"
		cp libraries/cobol/src/tt_session.h libraries/cobol/src/tt_session.c \
			libraries/cobol/src/tt_requests_generated.h libraries/cobol/src/tt_requests_generated.c "$folder/src/"
		cp libraries/cobol/examples/session.cob "$folder/examples/"
		tar -xzf "$OUT/$c_name" -C "$folder/native" ./include ./lib
		;;
	esac
	# A case-blind volume, such as a default Mac one, keeps only one of two names that differ only in case.
	twins=$(cd -- "$folder" && find . | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sort | uniq -d)
	[ -z "$twins" ] || { echo "release-pack: $1 holds names that differ only in case: $twins" >&2; exit 1; }
	if [ -n "${THINKTHEN_ARCHIVED_SOURCE_TAR:-}" ]; then
		case $1 in go | cpp | swift | zig | php | dart | ada | objective-c | cobol) ;; *) echo "release-pack: archived source does not permit $1" >&2; exit 1 ;; esac
		find "$folder" -type f | while IFS= read -r copied; do
			relative=${copied#"$folder"/}
			member=libraries/$1/$relative
			if [ "$1" = swift ] && [ "$relative" = "Sources/ThinkThen/Native/$TARGET/libthinkthen.so" ]; then
				native_input=$(mktemp "$stage/swift-native.XXXXXX")
				tar -xOzf "$OUT/$c_name" ./lib/libthinkthen.so >"$native_input" || {
					echo 'release-pack: Swift native input extraction failed' >&2; exit 1;
				}
				cmp -s "$native_input" "$copied" || {
					echo 'release-pack: Swift native library differs from C archive' >&2; exit 1;
				}
				continue
			fi
			# The wrapper's C header is copied from the one C header.
			case $relative in native/*) continue ;; Sources/CThinkThen/include/thinkthen.h) member=libraries/c/include/thinkthen.h ;; esac
			tar -xOf "$THINKTHEN_ARCHIVED_SOURCE_TAR" "$member" | cmp -s - "$copied" || {
				echo "release-pack: $1 source differs from archived commit: $relative" >&2; exit 1;
			}
		done
	fi
	printf 'source_commit=%s\ntarget=%s\nversion=%s\nc_archive=%s\nc_sha256=%s\n' \
		"$source_commit" "$TARGET" "$V" "$c_name" "$c_digest" >"$folder/THINKTHEN-PACKAGE-INPUTS"
	if [ "$1" = flutter ]; then
		printf 'dart_archive=%s\ndart_sha256=%s\n' "$dart_name" "$dart_digest" >>"$folder/THINKTHEN-PACKAGE-INPUTS"
	fi
	if [ "$1" = php ]; then
		# Composer's Phar extractor refuses a root directory member named '.'.
		(cd -- "$folder" && tar -czf "$OUT/thinkthen-$1-$V-$TARGET.tar.gz" ./*)
		(cd -- "$OUT" && sha256 "thinkthen-$1-$V-$TARGET.tar.gz" >"thinkthen-$1-$V-$TARGET.tar.gz.sha256")
	else
		pack "thinkthen-$1-$V-$TARGET.tar.gz" "$folder"
	fi
}
part_go() { part_source_wrapper go; }
part_cpp() { part_source_wrapper cpp; }
part_csharp() { part_source_wrapper csharp; }
part_jvm() { part_source_wrapper jvm; }
part_swift() { part_source_wrapper swift; }
part_zig() { part_source_wrapper zig; }
part_php() { part_source_wrapper php; }
part_dart() { part_source_wrapper dart; dart_built=1; }
part_flutter() { part_source_wrapper flutter; }
part_ada() { part_source_wrapper ada; }
part_cobol() { part_source_wrapper cobol; }

part_sqlite() {
	[ -n "$reuse" ] || (cd databases/sqlite && cargo build --locked --quiet --release)
	folder=$(fresh sqlite)
	cp -- "$(built databases/sqlite)/release/libthinkthen0.$dl" "$folder/"
	pack "thinkthen-sqlite-$V-$TARGET.tar.gz" "$folder"
}

# DuckDB reads its footer: the platform, the DuckDB version, and the extension's version.
part_duckdb() {
	case $TARGET in
	x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu | aarch64-apple-darwin | x86_64-apple-darwin) ;;
	*) echo "release-pack: no pinned DuckDB C++ package for $TARGET" >&2; exit 77 ;;
	esac
	INPUTS_HERE=$REPO/databases/duckdb/tools
	. "$INPUTS_HERE/inputs.sh"
	DUCKDB_VERSIONS=$(input_versions)
	DEFAULT_VERSION=${DUCKDB_VERSIONS%% *}
	override_version=${THINKTHEN_DUCKDB_VERSION:-$DEFAULT_VERSION}
	input_select "$override_version" "$TARGET"
	override_source=${THINKTHEN_DUCKDB_CPP_SOURCE:-}
	override_static=${THINKTHEN_DUCKDB_CPP_STATIC_DIR:-}
	folder=$(fresh duckdb)
	cp LICENSE "$folder/LICENSE.thinkthen"
	set --
	for version in $DUCKDB_VERSIONS; do
	input_select "$version" "$TARGET"
	THINKTHEN_DUCKDB_VERSION=$version
	THINKTHEN_DUCKDB_CPP_SOURCE=$TOOLS/source
	THINKTHEN_DUCKDB_CPP_STATIC_DIR=$TOOLS/static-libs
	if [ "$version" = "$override_version" ]; then
		THINKTHEN_DUCKDB_CPP_SOURCE=${override_source:-$TOOLS/source}
		THINKTHEN_DUCKDB_CPP_STATIC_DIR=${override_static:-$TOOLS/static-libs}
	fi
	export THINKTHEN_DUCKDB_VERSION THINKTHEN_DUCKDB_CPP_SOURCE THINKTHEN_DUCKDB_CPP_STATIC_DIR
	if [ -z "$reuse" ]; then
		sh databases/duckdb/cpp/build.sh
	fi
	extension="databases/duckdb/build/artifacts/cpp/$DUCKDB_VERSION/$TARGET/thinkthen.duckdb_extension"
	[ -f "$extension" ] && [ ! -L "$extension" ] || { echo "release-pack: $extension is missing; build it first" >&2; exit 1; }
	elf_arch= mac_arch=
	case $TARGET in
	x86_64-unknown-linux-gnu) elf_arch='Advanced Micro Devices X86-64' ;;
	aarch64-unknown-linux-gnu) elf_arch=AArch64 ;;
	aarch64-apple-darwin) mac_arch=arm64 ;;
	x86_64-apple-darwin) mac_arch=x86_64 ;;
	esac
	if [ -n "${elf_arch:-}" ]; then
		machine=$(readelf -h "$extension" | sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p')
		[ "$machine" = "$elf_arch" ] || { echo "release-pack: DuckDB extension is $machine, not $elf_arch" >&2; exit 1; }
	fi
	if [ -n "${mac_arch:-}" ]; then
		[ "$(lipo -archs "$extension")" = "$mac_arch" ] || {
			echo "release-pack: $extension is not a single $mac_arch Mach-O" >&2
			exit 1
		}
	fi
	python3 databases/duckdb/cpp/verify_footer.py "$extension" "$TARGET" "$DUCKDB_VERSION" "$V"
	mkdir -p "$folder/$version/$platform"
	cp "$extension" "$folder/$version/$platform/"
	python3 "$INPUTS_HERE/validate_inputs.py" --source "$THINKTHEN_DUCKDB_CPP_SOURCE" --commit "$duckdb_source_commit" --static "$THINKTHEN_DUCKDB_CPP_STATIC_DIR" --manifest "$INPUTS_HERE/../cpp/$manifest"
	set -- "$@" "$version" "$THINKTHEN_DUCKDB_CPP_SOURCE" "$INPUTS_HERE/../cpp/$manifest"
	done
	python3 databases/duckdb/cpp/package_notices.py "$folder" "$V" "$@"
	python3 databases/duckdb/cpp/verify_repository.py "$folder" "$TARGET" "$V"
	find "$folder" -type f -exec chmod 644 {} +
	pack "thinkthen-duckdb-$V-$TARGET.tar.gz" "$folder"
}

part_postgresql() {
	folder=$(fresh postgresql)
	sh databases/postgresql/package.sh ${reuse:+--reuse} "$folder"
	pack "thinkthen-postgresql16-$V-$TARGET.tar.gz" "$folder"
}

part_python() {
	[ -n "$reuse" ] || sh libraries/python/build-wheel.sh
	for wheel in libraries/python/target/release-wheel/thinkthen-"$V"-*.whl; do keep "$wheel"; done
}

part_typescript() {
	if [ -z "$reuse" ]; then
		sh libraries/typescript/build-addon.sh
		mkdir -p libraries/typescript/target/pack
		(cd libraries/typescript && npm pack --silent --offline --pack-destination target/pack >/dev/null)
	fi
	keep "libraries/typescript/target/pack/thinkthen-$V.tgz"
}

part_ruby() {
	[ -n "$reuse" ] || sh libraries/ruby/build.sh
	for gem in libraries/ruby/thinkthen-"$V"-*.gem; do keep "$gem"; done
	# Ship the platform-independent diagnostic once, alongside Linux x86-64.
	if [ "$TARGET" = x86_64-unknown-linux-gnu ]; then keep "libraries/ruby/thinkthen-$V.gem"; fi
}

# The crate and the R package name the commit the manifest names, so they need a clean committed tree.
committed() {
	[ -z "$(git status --porcelain)" ] || { echo "release-pack: $1 needs a clean committed tree" >&2; exit 1; }
}

# The thinkthen crate as cargo publishes it. Rust Polars is its `polars` feature.
part_crate() {
	committed crate
	CARGO_TARGET_DIR="$stage/crate-target" cargo package --locked --offline --no-verify --quiet --package thinkthen
	keep "$stage/crate-target/package/thinkthen-$V.crate"
}

# The R source package with its crates vendored, built as the R check builds it: from a git archive tree.
part_r() {
	committed r
	tree=$(fresh r-tree)
	git archive HEAD | tar -x -C "$tree"
	keep "$(CARGO_NET_OFFLINE=true CARGO_TARGET_DIR="$stage/r-target" "$tree/libraries/r/tools/make-tarball.sh" "$(fresh r)")"
}

# The README's first run: demo 27's input and its one recorded answer. Every target builds this
# archive, and the release draft requires the four copies to match byte for byte. Each entry has a
# fixed name order, mode, owner and time. The gzip layer holds stored deflate blocks with a zero
# time and no name, since zlib builds compress the same input to different bytes.
part_first_run() {
	python3 - "$OUT/thinkthen-first-run.tar.gz" demos/27-test-with-no-network <<'EOF'
import io, os, struct, sys, tarfile, zlib

out, demo = sys.argv[1:]
buffer = io.BytesIO()
with tarfile.open(fileobj=buffer, mode="w", format=tarfile.USTAR_FORMAT) as archive:
    def add(relative):
        path = os.path.join(demo, relative)
        info = tarfile.TarInfo("thinkthen-first-run/" + relative)
        if os.path.isdir(path):
            info.type, info.mode = tarfile.DIRTYPE, 0o755
            archive.addfile(info)
            for name in sorted(os.listdir(path)):
                add(relative + "/" + name)
        else:
            with open(path, "rb") as file:
                data = file.read()
            # This sample holds data only. Windows X_OK does not mean Unix execute bits.
            info.size, info.mode = len(data), 0o644
            archive.addfile(info, io.BytesIO(data))
    info = tarfile.TarInfo("thinkthen-first-run")
    info.type, info.mode = tarfile.DIRTYPE, 0o755
    archive.addfile(info)
    add("recording")
    add("report.txt")
data = buffer.getvalue()
blocks = [data[start:start + 65535] for start in range(0, len(data), 65535)]
with open(out, "wb") as file:
    file.write(b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff")
    for index, block in enumerate(blocks):
        file.write(bytes([index == len(blocks) - 1]) + struct.pack("<HH", len(block), len(block) ^ 0xFFFF) + block)
    file.write(struct.pack("<II", zlib.crc32(data), len(data) & 0xFFFFFFFF))
EOF
	(cd -- "$OUT" && sha256 thinkthen-first-run.tar.gz >thinkthen-first-run.tar.gz.sha256)
}

if [ "$TARGET" = x86_64-pc-windows-msvc ]; then
	[ $# -gt 0 ] || set -- command c python typescript first-run
	for part in "$@"; do
		case $part in command | c | python | typescript | first-run | crate) ;;
		*) echo "release-pack: $part is not a Windows stage 1 command part" >&2; exit 2 ;; esac
	done
else
	[ $# -gt 0 ] || set -- command c sqlite duckdb postgresql python typescript ruby first-run
fi
# Ticket 0366: in build mode without a caller's CARGO_TARGET_DIR, each part builds in its own scratch
# folder, which goes once the part is packed. A run then holds one part's build at a time.
# The build folder's remap comes after release-pack's others, so it wins over them. A build script's
# own HOME remap comes later still, so a TMPDIR under HOME shows as /build/home/... with the scratch
# name. release-container sets TMPDIR to its run folder, outside HOME.
own_build=
[ -n "$reuse" ] || [ -n "${CARGO_TARGET_DIR:-}" ] || own_build=1
duckdb_build=${THINKTHEN_DUCKDB_CPP_BUILD:-} rust_flags=$RUSTFLAGS c_flags=$CFLAGS cxx_flags=${CXXFLAGS:-}
for part in "$@"; do
	if [ -n "$own_build" ]; then
		scratch_dir part_build
		CARGO_TARGET_DIR=$part_build THINKTHEN_DUCKDB_CPP_BUILD=${duckdb_build:-$part_build/cpp}
		build_remap=$part_build
		if [ "$TARGET" = x86_64-pc-windows-msvc ]; then
			build_remap=$(cygpath -m "$part_build")
			CARGO_TARGET_DIR=$build_remap
		fi
		RUSTFLAGS="$rust_flags --remap-path-prefix=$build_remap=/build/target"
		CFLAGS=$c_flags
		[ "$TARGET" = x86_64-pc-windows-msvc ] || CFLAGS="$c_flags -ffile-prefix-map=$part_build=/build/target"
		CXXFLAGS="${cxx_flags:+$cxx_flags }-ffile-prefix-map=$part_build=/build/target"
		export CARGO_TARGET_DIR THINKTHEN_DUCKDB_CPP_BUILD RUSTFLAGS CFLAGS CXXFLAGS
	fi
	case $part in
	objective-c) part_source_wrapper objective-c ;;
	command | c | go | cpp | csharp | jvm | swift | zig | php | dart | flutter | ada | cobol | sqlite | duckdb | postgresql | python | typescript | ruby | crate | r) "part_$part" ;;
	first-run) part_first_run ;;
	*) echo "release-pack: no part named $part" >&2; exit 2 ;;
	esac
	if [ -n "$own_build" ]; then
		echo "release-pack: $part built $(du -sh "$part_build" | cut -f1); $(df -Ph "$OUT" | awk 'NR == 2 {print $4}') free" >&2
		scratch_remove "$part_build"
	fi
done
