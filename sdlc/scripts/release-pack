#!/bin/sh
# release-pack [--reuse] TARGET OUT [PART...] (ticket 0128): pack the release files of one
# Rust target into OUT, each with a `.sha256` beside it. TARGET is this host's target, since
# each release target builds on its own runner. The parts are command, c, go, cpp, sqlite,
# duckdb, postgresql, python, typescript, ruby, and first-run; the default keeps its
# established parts and Go/C++ are explicit pilot parts.
# Without --reuse it builds each file from this checkout. With --reuse it builds nothing and
# packs the files each surface check already built in its own build folder, which the
# `surfaces` rung does. Every cargo call is locked; fetch first where the network is off.
set -eu
reuse=
[ "${1:-}" != --reuse ] || { reuse=1; shift; }
[ $# -ge 2 ] || { echo 'usage: release-pack [--reuse] TARGET OUT [PART...]' >&2; exit 2; }
TARGET=$1 OUT=$2
shift 2
REPO=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
mkdir -p -- "$OUT"
OUT=$(CDPATH='' cd -- "$OUT" && pwd)
cd -- "$REPO"
host=$(rustc -vV | sed -n 's/^host: //p')
[ "$TARGET" = "$host" ] || { echo "release-pack: $TARGET is not this host's target, $host" >&2; exit 2; }
V=$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -n 1)
source_commit=$(git rev-parse HEAD)
c_built=
case " $* " in
*' go '* | *' cpp '*)
	[ -z "$reuse" ] || { echo 'release-pack: Go/C++ need a fresh C build, not --reuse' >&2; exit 1; }
	[ -z "$(git status --porcelain)" ] || { echo 'release-pack: Go/C++ need a clean committed tree' >&2; exit 1; }
	case " $* " in *' c '*) ;; *) echo 'release-pack: Go/C++ need c in this invocation' >&2; exit 1 ;; esac
	;;
esac
case $TARGET in
*-apple-darwin) dl=dylib command_target=$TARGET ;;
*-linux-gnu) dl=so command_target=${TARGET%-gnu}-musl ;;
*) echo "release-pack: no release for $TARGET" >&2; exit 2 ;;
esac
# The source and Cargo cache can sit outside HOME in a release container.
# Remap all three origins before packaging a library's panic/debug locations.
cargo_home=${CARGO_HOME:-$HOME/.cargo}
RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$REPO=/build/source --remap-path-prefix=$cargo_home=/build/cargo --remap-path-prefix=$HOME=/build/home"
CFLAGS="${CFLAGS:+$CFLAGS }-ffile-prefix-map=$REPO=/build/source -ffile-prefix-map=$cargo_home=/build/cargo -ffile-prefix-map=$HOME=/build/home"
export RUSTFLAGS CFLAGS
. sdlc/scripts/scratch.sh
scratch_dir stage

# The build folder of the crate in $1, by the one rule every check reads.
built() { echo "${CARGO_TARGET_DIR:-$REPO/$1/target}"; }
sha256() { if command -v sha256sum >/dev/null; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }
# pack NAME FOLDER: tar FOLDER's contents into OUT/NAME and write OUT/NAME.sha256.
pack() {
	tar -czf "$OUT/$1" -C "$2" .
	(cd -- "$OUT" && sha256 "$1" >"$1.sha256")
}
# keep FILE: copy a file a tool already packed into OUT, with its checksum.
keep() {
	[ -f "$1" ] || { echo "release-pack: $1 is missing; build it first" >&2; exit 1; }
	cp -- "$1" "$OUT/"
	(cd -- "$OUT" && sha256 "${1##*/}" >"${1##*/}.sha256")
}
# fresh NAME: a new folder in the stage, with the mode a plain mkdir gives, which each archive root carries.
fresh() { fresh=$(mktemp -d "$stage/$1.XXXXXX") && chmod 755 "$fresh" && echo "$fresh"; }

part_command() {
	if [ -n "$reuse" ]; then
		binary=${CARGO_TARGET_DIR:-$REPO/target}/debug/thinkthen
	else
		cargo build --locked --quiet --release --package thinkthen --target "$command_target"
		binary=${CARGO_TARGET_DIR:-$REPO/target}/$command_target/release/thinkthen
	fi
	folder=$(fresh command)
	cp -- "$binary" "$folder/thinkthen"
	pack "thinkthen-$V-$command_target.tar.gz" "$folder"
}

# The header, both libraries under the soname layout build.rs sets, and a relocatable .pc.
part_c() {
	profile=debug
	[ -n "$reuse" ] || { profile=release; (cd libraries/c && cargo build --locked --quiet --release --lib); }
	from=$(built libraries/c)/$profile
	folder=$(fresh c)
	mkdir -p "$folder/include" "$folder/lib/pkgconfig"
	cp libraries/c/include/thinkthen.h "$folder/include/"
	cp -- "$from/libthinkthen_c.a" "$folder/lib/libthinkthen.a"
	if [ "$dl" = dylib ]; then
		cp -- "$from/libthinkthen_c.dylib" "$folder/lib/libthinkthen.dylib"
		ln -s libthinkthen.dylib "$folder/lib/libthinkthen.0.dylib"
		# The rehearsal on macOS measures its static link line (Phase 3).
		private=
	else
		cp -- "$from/libthinkthen_c.so" "$folder/lib/libthinkthen.so"
		ln -s libthinkthen.so "$folder/lib/libthinkthen.so.0"
		private='-lgcc_s -lutil -lrt -lpthread -lm -ldl -lc'
	fi
	cat >"$folder/lib/pkgconfig/thinkthen.pc" <<-EOF
		prefix=\${pcfiledir}/../..
		libdir=\${prefix}/lib
		includedir=\${prefix}/include

		Name: thinkthen
		Description: Semantic judgments over text, through the thinkthen engine
		Version: $V
		Libs: -L\${libdir} -lthinkthen
		Libs.private: $private
		Cflags: -I\${includedir}
	EOF
	pack "thinkthen-c-$V-$TARGET.tar.gz" "$folder"
	[ -n "$reuse" ] || c_built=1
}

part_source_wrapper() {
	[ "$c_built" = 1 ] || { echo "release-pack: $1 needs c built earlier in this invocation" >&2; exit 1; }
	c_name=thinkthen-c-$V-$TARGET.tar.gz
	[ -f "$OUT/$c_name" ] || { echo 'release-pack: C archive is missing' >&2; exit 1; }
	c_digest=$(sha256 "$OUT/$c_name" | awk '{print $1}')
	folder=$(fresh "$1")
	case $1 in
	go)
		mkdir -p "$folder/examples/decide"
		cp libraries/go/LICENSE libraries/go/README.md libraries/go/go.mod \
			libraries/go/thinkthen.go libraries/go/thinkthen_test.go libraries/go/recovery_test.go "$folder/"
		cp libraries/go/examples/decide/main.go "$folder/examples/decide/"
		;;
	cpp)
		mkdir -p "$folder/cmake" "$folder/include/thinkthen"
		cp libraries/cpp/LICENSE libraries/cpp/README.md libraries/cpp/CMakeLists.txt "$folder/"
		cp libraries/cpp/cmake/ThinkThenCppConfig.cmake.in "$folder/cmake/"
		cp libraries/cpp/include/thinkthen/door.hpp libraries/cpp/include/thinkthen/json.hpp "$folder/include/thinkthen/"
		;;
	esac
	printf 'source_commit=%s\ntarget=%s\nversion=%s\nc_archive=%s\nc_sha256=%s\n' \
		"$source_commit" "$TARGET" "$V" "$c_name" "$c_digest" >"$folder/THINKTHEN-PACKAGE-INPUTS"
	pack "thinkthen-$1-$V-$TARGET.tar.gz" "$folder"
}
part_go() { part_source_wrapper go; }
part_cpp() { part_source_wrapper cpp; }

part_sqlite() {
	[ -n "$reuse" ] || (cd databases/sqlite && cargo build --locked --quiet --release)
	folder=$(fresh sqlite)
	cp -- "$(built databases/sqlite)/release/libthinkthen0.$dl" "$folder/"
	pack "thinkthen-sqlite-$V-$TARGET.tar.gz" "$folder"
}

# DuckDB reads its footer: the platform, the DuckDB version, and the extension's version.
part_duckdb() {
	case $TARGET in
	x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu | aarch64-apple-darwin | x86_64-apple-darwin) ;;
	*) echo "release-pack: no pinned DuckDB C++ package for $TARGET" >&2; exit 77 ;;
	esac
	if [ -z "$reuse" ]; then
		sh databases/duckdb/cpp/build.sh
	fi
	extension="databases/duckdb/build/artifacts/cpp/$TARGET/thinkthen.duckdb_extension"
	[ -f "$extension" ] || { echo "release-pack: $extension is missing; build it first" >&2; exit 1; }
	elf_arch= mac_arch=
	case $TARGET in
	x86_64-unknown-linux-gnu) elf_arch='Advanced Micro Devices X86-64' ;;
	aarch64-unknown-linux-gnu) elf_arch=AArch64 ;;
	aarch64-apple-darwin) mac_arch=arm64 ;;
	x86_64-apple-darwin) mac_arch=x86_64 ;;
	esac
	if [ -n "${elf_arch:-}" ]; then
		machine=$(readelf -h "$extension" | sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p')
		[ "$machine" = "$elf_arch" ] || { echo "release-pack: DuckDB extension is $machine, not $elf_arch" >&2; exit 1; }
	fi
	if [ -n "${mac_arch:-}" ]; then
		[ "$(lipo -archs "$extension")" = "$mac_arch" ] || {
			echo "release-pack: $extension is not a single $mac_arch Mach-O" >&2
			exit 1
		}
	fi
	. databases/duckdb/tools/version.env
	python3 databases/duckdb/cpp/verify_footer.py "$extension" "$TARGET" "$DUCKDB_VERSION" "$V"
	folder=$(fresh duckdb)
	cp "$extension" "$folder/"
	cp LICENSE "$folder/LICENSE.thinkthen"
	tools=${THINKTHEN_TOOLCHAINS:-$HOME/.cache/thinkthen-toolchains}/duckdb/$DUCKDB_VERSION
	source=${THINKTHEN_DUCKDB_CPP_SOURCE:-$tools/source}
	cp "$source/LICENSE" "$folder/LICENSE.duckdb"
	python3 databases/duckdb/cpp/package_notices.py "$source" "$folder"
	printf 'ThinkThen %s: MIT (LICENSE.thinkthen)\nDuckDB %s source and static archives: MIT (LICENSE.duckdb)\n' \
		"$V" "$DUCKDB_VERSION" >"$folder/NOTICE"
	printf 'Third-party license texts and Rust dependency inventory: LICENSES/ and DEPENDENCIES.txt\n' >>"$folder/NOTICE"
	find "$folder" -type f -exec chmod 644 {} +
	pack "thinkthen-duckdb-$V-$TARGET.tar.gz" "$folder"
}

part_postgresql() {
	folder=$(fresh postgresql)
	sh databases/postgresql/package.sh ${reuse:+--reuse} "$folder"
	pack "thinkthen-postgresql16-$V-$TARGET.tar.gz" "$folder"
}

part_python() {
	[ -n "$reuse" ] || sh libraries/python/build-wheel.sh
	for wheel in libraries/python/target/wheels/thinkthen-"$V"-*.whl; do keep "$wheel"; done
}

part_typescript() {
	if [ -z "$reuse" ]; then
		sh libraries/typescript/build-addon.sh
		mkdir -p libraries/typescript/target/pack
		(cd libraries/typescript && npm pack --silent --offline --pack-destination target/pack >/dev/null)
	fi
	keep "libraries/typescript/target/pack/thinkthen-$V.tgz"
}

part_ruby() {
	[ -n "$reuse" ] || sh libraries/ruby/build.sh
	for gem in libraries/ruby/thinkthen-"$V"-*.gem; do keep "$gem"; done
}

# The README's first run: demo 27's input and its one recorded answer.
part_first_run() {
	folder=$(fresh first-run)/thinkthen-first-run
	mkdir -p "$folder"
	cp -R demos/27-test-with-no-network/report.txt demos/27-test-with-no-network/recording "$folder/"
	pack thinkthen-first-run.tar.gz "${folder%/*}"
}

[ $# -gt 0 ] || set -- command c sqlite duckdb postgresql python typescript ruby first-run
for part in "$@"; do
	case $part in
	command | c | go | cpp | sqlite | duckdb | postgresql | python | typescript | ruby) "part_$part" ;;
	first-run) part_first_run ;;
	*) echo "release-pack: no part named $part" >&2; exit 2 ;;
	esac
done
