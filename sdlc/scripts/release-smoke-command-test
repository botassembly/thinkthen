#!/bin/sh
# Ticket 0319: `release-smoke --command` against planted folders, each built around a fake
# `thinkthen` script. The good folder passes. Each other folder or README carries one fault and
# fails with its own exit code and message. The loopback backend and install server are real.
set -eu
case $(uname -s):$(uname -m) in
Linux:x86_64) target=x86_64-unknown-linux-musl ;; Linux:aarch64) target=aarch64-unknown-linux-musl ;;
Darwin:arm64) target=aarch64-apple-darwin ;; Darwin:x86_64) target=x86_64-apple-darwin ;;
*) echo 'release-smoke command: skipped on a host with no command release'; exit 0 ;;
esac
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
. "$repo/sdlc/scripts/scratch.sh"
scratch_dir work
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$repo/crates/thinkthen/Cargo.toml" | head -n 1)
archive=thinkthen-$version-$target.tar.gz
sha256() { if command -v shasum >/dev/null; then shasum -a 256 "$@"; else sha256sum "$@"; fi; }

# The fake's answer to the token cap variable: the command's refusal and exit 2 (ticket 0374).
cap="[ -z \"\${THINKTHEN_MAX_ESTIMATED_INPUT_TOKENS_TOTAL:-}\" ] || { echo \"thinkthen usage: max_estimated_input_tokens_total=10 (encoded-body-bytes-908-v1) would be exceeded before this call's first request\" >&2; exit 2; }"
# plant NAME ANSWER [EXTRA [CAP]]: a folder NAME whose fake prints ANSWER for a replay. EXTRA is one
# more shell line the fake runs first, which may reach the network or hold the builder's home. CAP
# replaces the fake's token cap line.
plant() {
	mkdir -p "$work/$1/bin" "$work/$1/sample/thinkthen-first-run/recording" "$work/$1/dir"
	cat >"$work/$1/bin/thinkthen" <<-EOF
		#!/bin/sh
		[ "\$1" != --version ] || { echo 'thinkthen $version'; exit 0; }
		[ "\$1" != status ] || { [ "\${THINKTHEN_COMMAND:-}" = "\$0" ] && echo '{"usage":{"total":{"requests_sent":17}}}'; exit; }
		if [ "\$1" = mcp ]; then
			exec python3 -c '
		import json, sys
		for line in sys.stdin:
		    message = json.loads(line)
		    if "id" not in message:
		        continue
		    method = message["method"]
		    if method == "initialize":
		        result = {"protocolVersion": "2025-11-25", "capabilities": {"tools": {}},
		                  "serverInfo": {"name": "fixture", "version": "1"}}
		    elif method == "ping":
		        result = {}
		    elif method == "tools/list":
		        result = {"tools": [{"name": name} for name in
		                  "decide choose tag score filter rank find annotate recognize relate".split()]}
		    elif method == "tools/call":
		        value = {"value": {"schema": "thinkthen.result/2", "value": True,
		                           "meta": {"origin": "replay"}}, "facts": {"requests_sent": 0}}
		        result = {"structuredContent": value, "isError": False,
		                  "content": [{"type": "text", "text": json.dumps(value)}]}
		    else:
		        sys.exit(4)
		    print(json.dumps({"jsonrpc": "2.0", "id": message["id"], "result": result}), flush=True)
		'
		fi
		${3:-:}
		${4-$cap}
		case " \$* " in *' --replay recording '*) [ -d recording ] && [ -f report.txt ] && echo $2 ;; *) exit 4 ;; esac
	EOF
	chmod +x "$work/$1/bin/thinkthen"
	: >"$work/$1/sample/thinkthen-first-run/report.txt"
	tar -czf "$work/$1/dir/$archive" -C "$work/$1/bin" thinkthen
	tar -czf "$work/$1/dir/thinkthen-first-run.tar.gz" -C "$work/$1/sample" thinkthen-first-run
	(cd -- "$work/$1/dir" && sha256 "$archive" >"$archive.sha256" &&
		sha256 thinkthen-first-run.tar.gz >thinkthen-first-run.tar.gz.sha256)
}

# readme NAME LINE...: a README whose no-key block holds LINE..., after a block without a replay.
readme() {
	name=$1
	shift
	{ printf '# Planted\n\n```sh\ncd demos/27-test-with-no-network\n```\n\n```sh\n'
		printf '%s\n' "$@"
		printf '```\n'; } >"$work/$name.md"
}
replay="thinkthen decide 'Question?' --replay recording < report.txt"
readme good 'cd demos/27-test-with-no-network' "$replay"
readme after-release 'curl -fsSLO https://example.invalid/thinkthen-first-run.tar.gz' "$replay"
readme no-sample "$replay"

# expect CODE MESSAGE FOLDER README: run the smoke and pin its exit code and one output line.
expect() {
	set +e
	THINKTHEN_README="$work/$4.md" sh "$repo/sdlc/scripts/release-smoke" --command "$work/$3/dir" >"$work/out" 2>&1
	code=$?
	set -e
	[ "$code" -eq "$1" ] || { cat "$work/out" >&2; echo "release-smoke command: $3/$4 wanted exit $1, got $code" >&2; exit 1; }
	grep -Fqx -- "$2" "$work/out" || { cat "$work/out" >&2; echo "release-smoke command: $3/$4 lacks: $2" >&2; exit 1; }
}

plant good true
expect 0 "release-smoke: pass $archive and thinkthen-first-run.tar.gz" good good
expect 0 "release-smoke: pass $archive and thinkthen-first-run.tar.gz" good after-release
plant missing true
mv "$work/missing/dir/thinkthen-first-run.tar.gz" "$work/missing/"
expect 1 'release-smoke: missing thinkthen-first-run.tar.gz' missing good
plant extra true
: >"$work/extra/dir/thinkthen-c-$version-$target.tar.gz"
expect 1 "release-smoke: extra or linked thinkthen-c-$version-$target.tar.gz" extra good
plant checksum true
printf 'x' >>"$work/checksum/dir/$archive"
expect 1 "release-smoke: FAIL $archive (its .sha256 is missing or does not match)" checksum good
expect 1 "release-smoke: the README's no-key block holds 0 sample lines, not one" good no-sample
plant false false
expect 1 "release-smoke: the no-key block printed 'false', not true" false good
plant home true "# $HOME"
expect 1 "release-smoke: FAIL $archive (the builder's home or the test probe is in thinkthen )" home good
# DuckDB's prebuilt archives name DuckDB's CI checkout, which a GitHub runner's home matches.
plant upstream true "# $HOME/work/duckdb/duckdb/src/storage"
expect 0 "release-smoke: pass $archive and thinkthen-first-run.tar.gz" upstream good
plant upstream-home true "# $HOME/work/duckdb/duckdb/src $HOME/.cargo"
expect 1 "release-smoke: FAIL $archive (the builder's home or the test probe is in thinkthen )" upstream-home good
plant sends true 'curl -s -o /dev/null --max-time 5 https://example.invalid/ || :'
expect 1 'release-smoke: the no-key block sent 1 requests to the loopback backend' sends good
plant cap-ignored true : :
expect 1 "release-smoke: the token cap exited 4 with ''" cap-ignored good

# Exercise ordinary release dispatch with a complete bundle and no development CLI.
# Keep the real checkout and driver; isolate unrelated consumer leaves only.
python3 - "$repo" "$work/repo" "$work/good/dir" "$version" "$target" <<'PYFIXTURE'
import io
from pathlib import Path
import sys
import tarfile
import zipfile
sys.path.insert(0, sys.argv[1])
from conformance.source_fixtures import stage_checkout, stub_other_surfaces
root, bundle = map(Path, sys.argv[2:4])
version, target = sys.argv[4:6]
root.mkdir()
stage_checkout(Path(sys.argv[1]), root)
stub_other_surfaces(root, {'databases/sqlite', 'databases/postgresql'})
payload = b'installed fixture'
def tar(path, members, mode='w:gz'):
    packed = tarfile.open(fileobj=path, mode=mode) if isinstance(path, io.BytesIO) else tarfile.open(path, mode)
    with packed as archive:
        for name, data in members.items():
            entry = tarfile.TarInfo(name)
            entry.size = len(data)
            archive.addfile(entry, io.BytesIO(data))
for family in ('c', 'sqlite', 'duckdb', 'postgresql16', 'postgresql17', 'postgresql18'):
    tar(bundle / f'thinkthen-{family}-{version}-{target}.tar.gz', {'payload': payload})
tar(bundle / f'thinkthen-{version}.tgz', {'payload': payload})
with zipfile.ZipFile(bundle / f'thinkthen-{version}.whl', 'w') as archive:
    archive.writestr('payload', payload)
data = io.BytesIO()
tar(data, {'payload': payload})
tar(bundle / f'thinkthen-{version}.gem', {'data.tar.gz': data.getvalue()}, mode='w')
PYFIXTURE
cat >"$work/repo/databases/sqlite/check.sh" <<-'EOF'
	#!/bin/sh
	set -eu
	[ -f "$THINKTHEN_ARTIFACT" ]
	[ -x "$THINKTHEN_COMMAND" ]
	[ "$("$THINKTHEN_COMMAND" status --json)" = '{"usage":{"total":{"requests_sent":17}}}' ]
	echo 'installed SQLite totals used the extracted command'
EOF
cat >"$work/repo/databases/postgresql/check.sh" <<-'EOF'
	#!/bin/sh
	set -eu
	[ -f "$THINKTHEN_ARTIFACT" ]
	COMMAND=${THINKTHEN_COMMAND:-${CARGO_TARGET_DIR:-target}/debug/thinkthen}
	[ -x "$COMMAND" ]
	[ "$("$COMMAND" status --json)" = '{"usage":{"total":{"requests_sent":17}}}' ]
	echo "installed PostgreSQL $1 totals used the extracted command"
EOF
(cd "$work/good/dir" && for file in *.tar.gz *.tgz *.whl *.gem; do
    sha256 "$file" >"$file.sha256"
done)
for family in all sqlite postgresql16 postgresql17 postgresql18; do
    set +e
    CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$repo/target}" THINKTHEN_RELEASE_SMOKE_FAMILY=$family \
        THINKTHEN_COMMAND="$work/no-development-cli" THINKTHEN_README="$work/good.md" \
        sh "$work/repo/sdlc/scripts/release-smoke" "$work/good/dir" >"$work/out" 2>&1
    code=$?
    set -e
    [ "$code" = 0 ] || { cat "$work/out" >&2; echo "release-smoke command: complete $family bundle wanted exit 0, got $code" >&2; exit 1; }
    case $family in
    all | sqlite)
        grep -Fqx 'installed SQLite totals used the extracted command' "$work/out" || { cat "$work/out" >&2; exit 1; }
        grep -Fqx "surfaces: pass databases/sqlite thinkthen-sqlite-$version-$target.tar.gz" "$work/out" || { cat "$work/out" >&2; exit 1; } ;;
    postgresql*)
        major=${family#postgresql}
        grep -Fqx "installed PostgreSQL $major totals used the extracted command" "$work/out" || { cat "$work/out" >&2; exit 1; }
        [ "$(grep -c 'installed PostgreSQL' "$work/out")" = 1 ] || { cat "$work/out" >&2; exit 1; } ;;
    esac
    if [ "$family" != all ]; then
        if grep -q -e 'surfaces: pass command' -e 'the no-key block printed' "$work/out"; then
            cat "$work/out" >&2
            echo "release-smoke command: $family ran command-family checks" >&2
            exit 1
        fi
    fi
done
echo 'release-smoke command: good, after-release, missing, extra, checksum, sample-line, answer, home, DuckDB upstream path, backend and token cap cases pinned'
