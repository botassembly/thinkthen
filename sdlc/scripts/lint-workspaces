#!/bin/sh
# The workspace lint pass: every standalone workspace in this repository
# (the contract, the stand-in, and each surface) builds through its own
# Cargo.toml, so the root workspace's `--workspace` Clippy never sees
# them. This script runs Clippy over each one with the rules its own
# manifest declares ([lints] tables), which is where the strict rules
# live for a tree that cannot share a workspace.
#
# One toolchain pin governs the repository: rust-toolchain.toml's 1.93.1,
# which CI installs and every manifest's rust-version names or undercuts.
# The single recorded exception is the Rust surface's Polars feature test
# (RUSTUP_TOOLCHAIN=1.95, sysinfo 0.39 refuses 1.93; libraries/rust/NOTES.md).
#
# Formatting is not checked here: the surface workspaces are not yet
# rustfmt-clean (a mechanical formatting wave is recorded as its own
# follow-up), and this pass covers the lint rules only. A workspace whose
# host toolchain is absent skips with its reason rather than failing a
# machine that cannot build it.
set -u

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"

# A rung never answers to the shell that called it: a stray key or address
# in the environment must not turn a check into a paid call.
unset THINKTHEN_API_KEY THINKTHEN_BASE_URL

if ! command -v cargo >/dev/null 2>&1; then
	printf '%s\n' 'lint-workspaces: cargo is not on PATH' >&2
	exit 1
fi

# Per-workspace cargo-deny: one generated config per run, derived from the
# root deny.toml so the allow-list stays single-sourced. Exactly two
# deviations are applied, each recorded:
#   1. unused-allowed-license is relaxed to warn — a surface's smaller tree
#      may not carry every license the whole tree allows.
#   2. the additions below widen the allow-list for licenses that surface's
#      tree carries and the root's does not, and ignore the two unmaintained
#      advisories whose replacement plans are recorded in the tree.
# Widening what a tree may carry is a recorded decision; nothing here can
# narrow a rule the root enforces.
workspace_deny() {
	workspace=$1
	root=$2
	case "$workspace" in
	# pyo3 (python) and polars (rust) pull target-lexicon and wasi under
	# pyo3-ffi's build tree; sqlite carries wasi and two Zlib crates beside
	# the wasm toolchain. Apache-2.0 WITH LLVM-exception is Apache-2.0 plus a
	# permissive exception; Zlib is permissive. Both are recorded widenings.
	# pyo3 and polars pull target-lexicon and wasi under pyo3-ffi's build
	# tree (LLVM-exception), polars' zlib crates (Zlib), and polars'
	# BSL-1.0 (the Boost Software License, permissive); postgresql's pgrx
	# tree carries wasi and zlib crates the same way.
	libraries/python)
		extra='s/^    "Unlicense",$/    "Unlicense",\n    "Apache-2.0 WITH LLVM-exception",/' ;;
	libraries/rust|databases/postgresql)
		extra='s/^    "Unlicense",$/    "Unlicense",\n    "Apache-2.0 WITH LLVM-exception",\n    "Zlib",\n    "BSL-1.0",/' ;;
	databases/sqlite)
		extra='s/^    "Unlicense",$/    "Unlicense",\n    "Apache-2.0 WITH LLVM-exception",\n    "Zlib",/' ;;
	# duckdb's own crate tree carries the same Zlib family plus the CMake
	# test fixtures' CC0-1.0 (duckdb's vendored test data); both recorded
	# widenings (surfaces-review-4: deny covered 12 of 13).
	databases/duckdb)
		extra='s/^    "Unlicense",$/    "Unlicense",\n    "Apache-2.0 WITH LLVM-exception",\n    "Zlib",\n    "CC0-1.0",/' ;;
	*) extra='' ;;
	esac
	cfg=$(mktemp)
	sed -e 's/^unused-allowed-license = "deny"$/unused-allowed-license = "warn"  # per-surface: a smaller tree need not carry every allowance/' ${extra:+-e "$extra"} "$root/deny.toml" > "$cfg"
	# The two unmaintained advisories with recorded replacement plans
	# (sdlc/records/2026-09-22-the-two-unmaintained-crates-in-the-surface-lockfiles.md): paste in R
	# (RUSTSEC-2024-0436), serde_cbor in PostgreSQL (RUSTSEC-2021-0127).
	# Ignored only where they appear; the recorded plans, not the ignores,
	# are the fix.
	case "$workspace" in
	libraries/r/thinkthen/src/rust)
		sed -i.bak 's/^ignore = \[\]$/ignore = ["RUSTSEC-2024-0436"]  # paste, plan recorded/' "$cfg" ;;
	databases/postgresql)
		sed -i.bak 's/^ignore = \[\]$/ignore = ["RUSTSEC-2021-0127"]  # serde_cbor, plan recorded/' "$cfg" ;;
	esac
	out=$(cd "$workspace" && cargo deny --offline check --config "$cfg" advisories bans licenses 2>&1)
	status=$?
	rm -f "$cfg"
	# A workspace whose lock names crates this machine never fetched (DuckDB
	# builds its Windows-side crates only on the machines that build Windows
	# artifacts) cannot answer cargo metadata offline; that is recorded as a
	# deferral with its reason, not a silent skip, until the DuckDB lane's
	# pinning work lands the fetch story.
	case $status in
	0) ;;
	*)
		case $(printf '%s\n' "$out" | grep -c "attempting to make an HTTP request") in
		0) ;;
		*)
			# surfaces-review-4: 12 of 13 lockfiles is not all of them. The
			# workspace build itself fetches from crates.io; the same fetch
			# warms cargo metadata's cache, once, and the check retries
			# offline. A fetch that fails fails the check.
			printf 'deny: %s: metadata cold, fetching once as the build does\n' "$workspace"
			(cd "$workspace" && cargo fetch --locked >/dev/null 2>&1) || return 1
			out=$(cd "$workspace" && cargo deny --offline check --config "$cfg" advisories bans licenses 2>&1)
			status=$?
			;;
		esac
		;;
	esac
	printf 'deny: %s: %s\n' "$workspace" "$(printf '%s\n' "$out" | tail -n 1)"
	return $status
}

fail=0
for entry in \
	'contract:' \
	'standin:' \
	'libraries/rust:' \
	'libraries/c:' \
	'libraries/python:python3' \
	'libraries/r/thinkthen/src/rust:R' \
	'libraries/typescript/addon:node' \
	'libraries/ruby:ruby' \
	'databases/duckdb:' \
	'databases/sqlite:' \
	'databases/postgresql:pg_config' \
	'tools/wire-stub:' \
; do
	workspace=${entry%%:*}
	needs=${entry#*:}
	if [ ! -f "$workspace/Cargo.toml" ]; then
		printf 'lint: %s skipped: not landed\n' "$workspace"
		continue
	fi
	if [ -n "$needs" ] && ! command -v "$needs" >/dev/null 2>&1; then
		# surfaces-review-4: a missing runtime must fail the lint, never
		# silently skip it — a skipped workspace is an unchecked one. The
		# one named fallback is the surface's own builder container, the
		# same image check.sh runs; if that cannot run either, the check
		# fails with its reason.
		case "$workspace:$needs" in
		libraries/ruby:ruby)
			if docker image inspect thinkthen-ruby-builder:local >/dev/null 2>&1; then
				printf 'lint: %s (host has no %s; the builder container answers)\n' "$workspace" "$needs"
				if docker run --rm -v "$REPO":/src -w "/src/$workspace" \
					thinkthen-ruby-builder:local \
					cargo clippy --locked --quiet --all-targets --all-features -- -D warnings; then
					deny_status=$(workspace_deny "$workspace" "$REPO") || fail=1
					printf '%s\n' "$deny_status"
					continue
				fi
				fail=1
				continue
			fi
			;;
		esac
		printf 'lint: %s FAILED: %s is not on PATH and no builder container answered; install the runtime or run the surface check (refs surfaces-review-4)\n' "$workspace" "$needs" >&2
		fail=1
		continue
	fi
	printf 'lint: %s\n' "$workspace"
	# -D warnings and --all-features (surfaces-review-4): without them the
	# pass counts as strict while ten of eleven workspaces still fail.
	if ! (cd "$workspace" && cargo clippy --locked --quiet --all-targets --all-features -- -D warnings); then
		fail=1
	fi

	# Every workspace also answers cargo deny from the same rules the root
	# rung uses, so advisories, bans, and licenses are checked on all thirteen
	# lockfiles and not only the root's. The root's exactness (unused
	# allowances refused) is a property of the whole tree; a single surface's
	# smaller tree cannot carry every allowed license, so the generated
	# per-run config relaxes exactly that one field and nothing else.
	deny_status=$(workspace_deny "$workspace" "$REPO") || fail=1
	printf '%s\n' "$deny_status"
done

if [ "$fail" -ne 0 ]; then
	printf '%s\n' 'lint-workspaces: a workspace failed its lint rules' >&2
	exit 1
fi
printf '%s\n' 'lint-workspaces: every landed workspace is clean'
