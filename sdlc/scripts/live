#!/usr/bin/python3 -IS
"""Guarded paid-call supervisor. THINKTHEN_LIVE_V2 marks retired launchers."""

import base64
import errno
import fcntl
import json
import os
import select
import signal
import socket
import stat
import subprocess
import sys
import time
import uuid

SAFE_ENV = {b"PATH": b"/usr/bin:/bin", b"LC_ALL": b"C"}
MAXIMUM = 999_999_999
GRACE = 5.0
STATE_KEYS = {"version", "authority_id", "status", "limit_tokens", "charged_tokens", "machine_id", "common_dir_hex", "pending"}
PENDING_KEYS = {"wrapper", "gate", "prior_charge", "reservation", "charged_total", "phase"}
IDENTITY_KEYS = {"boot_id", "pid", "start_ticks"}
GATE_KEYS = IDENTITY_KEYS | {"pgid", "sid"}


class Refusal(Exception):
    def __init__(self, message, status=1):
        super().__init__(message)
        self.status = status


def refuse(message, status=1):
    raise Refusal(f"live: {message}\n", status)


def clean_run(arguments):
    return subprocess.run(arguments, env=SAFE_ENV, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)


def prerequisites():
    if os.environ.get("THINKTHEN_LIVE_TEST_FAULT") == "prerequisite":
        refuse("a required live-supervisor prerequisite is unavailable")
    if sys.platform != "linux":
        refuse("the live supervisor requires Linux")
    if sys.version_info < (3, 12) or sys.executable != "/usr/bin/python3":
        refuse("the live supervisor requires /usr/bin/python3 version 3.12 or newer")
    for path in (b"/usr/bin/git", b"/proc/self/stat", b"/proc/sys/kernel/random/boot_id", b"/etc/machine-id"):
        if not os.path.exists(path):
            refuse("a required live-supervisor prerequisite is unavailable")
    if not hasattr(os, "waitid") or not hasattr(os, "WNOWAIT"):
        refuse("the live supervisor requires waitid with WNOWAIT")


def checkout_path():
    return os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(os.fsencode(__file__))), b"../.."))


def common_path(checkout):
    test_directory = os.environb.get(b"THINKTHEN_LIVE_TEST_GIT_DIR")
    if test_directory:
        helper = subprocess.Popen([b"/usr/bin/git", b"hash-object", b"--stdin"], env=SAFE_ENV, stdin=subprocess.PIPE)
        with open(os.path.join(test_directory, b"git-helper.pid"), "w", encoding="ascii") as stream:
            stream.write(str(helper.pid))
        while not os.path.exists(os.path.join(test_directory, b"git-helper.release")):
            time.sleep(0.01)
        helper.stdin.close()
        helper.wait()
    result = clean_run([b"/usr/bin/git", b"-C", checkout, b"rev-parse", b"--path-format=absolute", b"--git-common-dir"])
    if result.returncode or not result.stdout.endswith(b"\n"):
        refuse("the calling checkout has no readable Git common directory", 2)
    path = result.stdout[:-1]
    if not path.startswith(b"/") or b"\n" in path:
        refuse("Git returned an invalid common directory", 2)
    return os.path.realpath(path)


def registered_trees(common):
    result = clean_run([b"/usr/bin/git", b"--git-dir", common, b"worktree", b"list", b"--porcelain", b"-z"])
    if result.returncode:
        refuse("registered worktrees could not be inspected")
    trees = [field[9:] for field in result.stdout.split(b"\0") if field.startswith(b"worktree ")]
    if not trees:
        refuse("Git reported no registered worktree")
    return trees


def read_file(path, limit=1_000_000):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        contents = os.read(descriptor, limit)
        if os.read(descriptor, 1):
            raise ValueError("file too large")
        return contents
    finally:
        os.close(descriptor)


def checkpoint_is_guarded(path):
    expected = {b"checkpoint_limit_tokens", b"checkpoint_charged_tokens", b"checkpoint_authority_id"}
    try:
        rows = read_file(path, 65536).splitlines()
    except (OSError, ValueError):
        return False
    found = set()
    for row in rows:
        if not row or row.startswith(b"#"):
            continue
        fields = row.split()
        if len(fields) != 2 or fields[0] not in expected or fields[0] in found:
            return False
        found.add(fields[0])
    return found == expected


def check_registered_trees(common):
    for tree in registered_trees(common):
        if os.path.lexists(os.path.join(tree, b"sdlc/live-tokens.lock")):
            refuse("a registered worktree has a legacy live lock")
        try:
            launcher = read_file(os.path.join(tree, b"sdlc/scripts/live"))
            state_module = read_file(os.path.join(tree, b"sdlc/scripts/live-state.py"))
        except (OSError, ValueError):
            refuse("a registered worktree has no guarded live launcher")
        if b"THINKTHEN_LIVE_V2" not in launcher or b"THINKTHEN_LIVE_V2" not in state_module or not checkpoint_is_guarded(os.path.join(tree, b"sdlc/live-tokens")):
            refuse("a registered worktree still has a legacy live launcher")


def load_state_module():
    with open(os.path.join(os.path.dirname(__file__), "live-state.py"), "rb") as state_module:
        exec(compile(state_module.read(), "live-state.py", "exec"), globals())


def take_lock(authority):
    try:
        lock_path = os.path.join(authority, b"lock")
        descriptor = os.open(lock_path, os.O_RDWR | os.O_NOFOLLOW)
        require_private(lock_path)
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return descriptor
    except OSError:
        refuse("the live authority lock is held or unavailable")


def send_bytes(channel, payload, deadline, signals):
    sent = 0
    while sent < len(payload):
        if signals.status:
            raise InterruptedError
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError
        _, writable, _ = select.select([], [channel], [], min(0.05, remaining))
        if writable:
            written = channel.send(payload[sent:])
            if written == 0:
                raise EOFError
            sent += written


def send_packet(channel, payload, deadline, signals):
    send_bytes(channel, len(payload).to_bytes(8, "big") + payload, deadline, signals)


def receive_exact(channel, length, deadline=None, signals=None):
    result = bytearray()
    while len(result) < length:
        if signals is not None and signals.status:
            raise InterruptedError
        timeout = 0.05 if deadline is None else min(0.05, max(0, deadline - time.monotonic()))
        if deadline is not None and timeout == 0:
            raise TimeoutError
        readable, _, _ = select.select([channel], [], [], timeout)
        if not readable:
            continue
        piece = channel.recv(length - len(result))
        if not piece:
            raise EOFError
        result.extend(piece)
    return bytes(result)


def receive_packet(channel):
    length = int.from_bytes(receive_exact(channel, 8), "big")
    if length > 16_000_000:
        raise ValueError("packet too large")
    return receive_exact(channel, length)


def gate_main(descriptor, fault=None):
    try:
        channel = socket.socket(fileno=int(descriptor))
        if fault == "readiness":
            time.sleep(GRACE * 2)
            return 125
        channel.sendall(b"R")
        payload = json.loads(receive_packet(channel))
        key = base64.b64decode(payload["key"], validate=True)
        arguments = [base64.b64decode(item, validate=True) for item in payload["arguments"]]
        environment = {base64.b64decode(item[0], validate=True): base64.b64decode(item[1], validate=True) for item in payload["environment"]}
        environment[b"THINKTHEN_API_KEY"] = key
        channel.sendall(b"A")
        if receive_exact(channel, 1) != b"G":
            return 125
        channel.close()
        if payload.get("fault") == "exec":
            return 125
        os.execve(b"/bin/sh", [b"/bin/sh", b"--", *arguments], environment)
    except Exception:
        return 125


def unreaped(pid):
    try:
        return os.waitid(os.P_PID, pid, os.WEXITED | os.WNOHANG | os.WNOWAIT) is None
    except ChildProcessError:
        return False


def identity_matches(recorded):
    if recorded["boot_id"] != current_boot():
        return False
    fields = proc_fields(recorded["pid"])
    return fields is not None and fields["start_ticks"] == recorded["start_ticks"] and fields["state"] != "Z"


def session_members(gate):
    if gate["boot_id"] != current_boot():
        return []
    try:
        entries = os.listdir(b"/proc")
    except OSError:
        refuse("running process sessions cannot be inspected")
    members = []
    for entry in entries:
        if entry.isdigit():
            fields = proc_fields(int(entry))
            if fields is not None and fields["sid"] == gate["sid"] and fields["state"] != "Z":
                members.append(int(entry))
    return members


def status_or_recover(mode, authority, common):
    lock = take_lock(authority)
    try:
        state = read_state(authority, common)
        if mode == "status":
            pending = "none" if state["pending"] is None else state["pending"]["phase"]
            sys.stdout.write(
                f"authority_id {state['authority_id']}\nstatus {state['status']}\n"
                f"limit_tokens {state['limit_tokens']}\ncharged_tokens {state['charged_tokens']}\n"
                f"pending {pending}\n"
            )
            return 0
        if state["status"] != "active":
            refuse("the live authority is retired")
        pending = state["pending"]
        if pending is None:
            return 0
        old_boot = pending["gate"]["boot_id"] != current_boot()
        if not old_boot and identity_matches(pending["wrapper"]):
            refuse("the pending live wrapper still exists")
        gate = pending["gate"]
        if not old_boot:
            fields = proc_fields(gate["pid"])
            if fields is not None and fields["start_ticks"] == gate["start_ticks"] and fields["state"] != "Z":
                refuse("the pending live session still exists")
            if session_members(gate):
                refuse("the pending live session still exists")
        state["pending"] = None
        try:
            replace_state(authority, state)
        except OSError:
            refuse("the recovered authority could not be made durable")
        return 0
    finally:
        os.close(lock)


class Signals:
    def __init__(self):
        self.status = 0
        self.deadline = None
        self.group = None
        self.child = None

    def receive(self, number, _frame):
        if self.status == 0:
            self.status = {signal.SIGHUP: 129, signal.SIGINT: 130, signal.SIGTERM: 143}[number]
            self.deadline = time.monotonic() + GRACE
        if self.group is not None and self.child is not None and unreaped(self.child.pid):
            forwarded = signal.SIGTERM if number == signal.SIGINT else number
            try:
                os.killpg(self.group, forwarded)
            except ProcessLookupError:
                pass
        elif self.child is not None and unreaped(self.child.pid):
            try:
                self.child.send_signal(signal.SIGTERM if number == signal.SIGINT else number)
            except ProcessLookupError:
                pass


def stop_gate(gate, signals):
    if gate is None or not unreaped(gate.pid):
        return True
    try:
        if signals.group is None:
            gate.terminate()
        else:
            os.killpg(signals.group, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = signals.deadline or time.monotonic() + GRACE
    while time.monotonic() < deadline:
        if not unreaped(gate.pid):
            gate.wait()
            return True
        time.sleep(0.02)
    return False


def reservation_value(text):
    if not text or not text.isascii() or not text.isdigit() or text.startswith("0"):
        refuse("usage: sdlc/scripts/live --max-tokens N JOB [ARG...]", 2)
    value = int(text)
    if value > MAXIMUM:
        refuse("usage: sdlc/scripts/live --max-tokens N JOB [ARG...]", 2)
    return value


def payload_for(job, arguments, key, checkout):
    environment = dict(os.environb)
    environment.pop(b"THINKTHEN_API_KEY", None)
    environment[b"PATH"] = os.path.join(checkout, b"target/debug") + b":" + environment.get(b"PATH", b"/usr/bin:/bin")
    return json.dumps({
        "key": base64.b64encode(key).decode("ascii"),
        "arguments": [base64.b64encode(item).decode("ascii") for item in [job, *arguments]],
        "environment": [[base64.b64encode(name).decode("ascii"), base64.b64encode(value).decode("ascii")] for name, value in environment.items()],
        "fault": os.environ.get("THINKTHEN_LIVE_TEST_FAULT"),
    }, separators=(",", ":")).encode("ascii")


def capture_key():
    key = os.environb.get(b"THINKTHEN_API_KEY", b"")
    if not any(byte not in b" \t\r\n\v\f" for byte in key):
        refuse("THINKTHEN_API_KEY holds nothing, so no call goes out")
    if b"\n" in key:
        refuse("THINKTHEN_API_KEY contains a line break, so no call goes out")
    os.environb.pop(b"THINKTHEN_API_KEY", None)
    return key


def launch(arguments, checkout, common, authority, key):
    if len(arguments) < 3 or arguments[0] != "--max-tokens":
        refuse("usage: sdlc/scripts/live --max-tokens N JOB [ARG...]", 2)
    reservation = reservation_value(arguments[1])
    job_argument = os.fsencode(arguments[2])
    job = job_argument if job_argument.startswith(b"/") else os.path.join(checkout, job_argument)
    if not os.path.isfile(job):
        refuse("the named live job is not a file", 2)
    binary = os.path.join(checkout, b"target/debug/thinkthen")
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        refuse("target/debug/thinkthen must be built before a live job", 2)
    check_registered_trees(common)
    lock = take_lock(authority)
    gate = None
    channel = None
    signals = Signals()
    state = None
    charged = False
    for number in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(number, signals.receive)
    try:
        state = read_state(authority, common)
        if state["status"] != "active":
            refuse("the live authority is retired")
        if state["pending"] is not None:
            refuse("the live authority has a pending run")
        total = state["charged_tokens"] + reservation
        if total > state["limit_tokens"]:
            remaining = state["limit_tokens"] - state["charged_tokens"]
            refuse(f"reservation {reservation} exceeds the {remaining} tokens remaining, so no call goes out")
        fault = os.environ.get("THINKTHEN_LIVE_TEST_FAULT")
        if fault == "socket":
            refuse("the live gate could not be created")
        parent, child = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            if fault == "spawn":
                refuse("the live gate could not be started")
            gate = subprocess.Popen(
                [b"/usr/bin/python3", b"-I", b"-S", os.fsencode(__file__), b"--gate", str(child.fileno()).encode(), os.fsencode(fault or "none")],
                env=SAFE_ENV,
                pass_fds=(child.fileno(),),
                close_fds=True,
                start_new_session=fault != "setsid",
                cwd=checkout,
            )
        finally:
            child.close()
        channel = parent
        channel.setblocking(False)
        signals.child = gate
        test_hook("before-readiness")
        try:
            ready = receive_exact(channel, 1, time.monotonic() + GRACE, signals)
        except (EOFError, InterruptedError, TimeoutError, OSError):
            if signals.status:
                return signals.status
            refuse("the live gate did not become ready")
        if ready != b"R" or not unreaped(gate.pid):
            refuse("the live gate did not become ready")
        gate_identity = process_identity(gate.pid, True)
        if fault == "identity":
            refuse("the live gate has an invalid process identity")
        if gate_identity["pgid"] != gate.pid or gate_identity["sid"] != gate.pid:
            refuse("the live gate has an invalid process identity")
        signals.group = gate.pid
        test_hook("after-ready")
        if signals.status:
            return signals.status
        state["pending"] = {
            "wrapper": process_identity(os.getpid()),
            "gate": gate_identity,
            "prior_charge": state["charged_tokens"],
            "reservation": reservation,
            "charged_total": total,
            "phase": "pending",
        }
        state["charged_tokens"] = total
        try:
            replace_state(authority, state)
        except OSError:
            refuse("the live charge could not be made durable")
        charged = True
        test_hook("after-charge")
        if signals.status:
            return signals.status
        delivery_deadline = time.monotonic() + GRACE
        try:
            send_packet(
                channel,
                payload_for(job, [os.fsencode(item) for item in arguments[3:]], key, checkout),
                delivery_deadline,
                signals,
            )
        except (EOFError, InterruptedError, TimeoutError, OSError):
            if signals.status:
                return signals.status
            refuse("the live gate did not receive its job")
        try:
            receipt = receive_exact(channel, 1, time.monotonic() + GRACE, signals)
        except (EOFError, InterruptedError, TimeoutError, OSError):
            if signals.status:
                return signals.status
            refuse("the live gate did not receive its job")
        if receipt != b"A":
            refuse("the live gate did not receive its job")
        key = b""
        test_hook("after-key-receipt")
        if signals.status:
            return signals.status
        try:
            send_bytes(channel, b"G", time.monotonic() + GRACE, signals)
        except (EOFError, InterruptedError, TimeoutError, OSError):
            if signals.status:
                return signals.status
            refuse("the live gate could not be released")
        test_hook("after-release")
        channel.close()
        channel = None
        while True:
            leader_exited = not unreaped(gate.pid)
            remaining = [pid for pid in session_members(gate_identity) if pid != gate.pid]
            if leader_exited and not remaining:
                break
            if leader_exited and signals.deadline is None:
                signals.deadline = time.monotonic() + GRACE
                try:
                    os.killpg(gate.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            if signals.deadline is not None and time.monotonic() >= signals.deadline:
                state["pending"]["phase"] = "unresolved"
                test_hook("before-unresolved-sync")
                try:
                    replace_state(authority, state)
                except OSError:
                    pass
                return signals.status or 1
            time.sleep(0.02)
        test_hook("after-job-exit")
        status = gate.wait()
        state["pending"] = None
        try:
            replace_state(authority, state)
        except OSError:
            refuse("the live run ended but settlement could not be made durable")
        print(f"live: charged {reservation}; {state['charged_tokens']} of {state['limit_tokens']} tokens are charged now")
        return signals.status or (128 + -status if status < 0 else status)
    finally:
        if channel is not None:
            channel.close()
        if gate is not None and unreaped(gate.pid):
            stopped = stop_gate(gate, signals)
            if charged and not stopped and state is not None and state.get("pending") is not None:
                state["pending"]["phase"] = "unresolved"
                try:
                    replace_state(authority, state)
                except OSError:
                    pass
        os.close(lock)


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--gate":
        return gate_main(sys.argv[2], None if sys.argv[3] == "none" else sys.argv[3])
    action = sys.argv[1] if len(sys.argv) == 2 else None
    key = None if action in ("--status", "--recover") else capture_key()
    prerequisites()
    load_state_module()
    checkout = checkout_path()
    common = common_path(checkout)
    authority = os.path.join(common, b"thinkthen-live")
    if os.path.lexists(os.path.join(authority, b"activation-fence")):
        refuse("the live authority activation is incomplete")
    if action in ("--status", "--recover"):
        return status_or_recover(action[2:], authority, common)
    return launch(sys.argv[1:], checkout, common, authority, key)


try:
    raise SystemExit(main())
except Refusal as error:
    sys.stderr.write(str(error))
    raise SystemExit(error.status)
except (AttributeError, OSError, ValueError, UnicodeError, json.JSONDecodeError):
    sys.stderr.write("live: the live supervisor failed safely\n")
    raise SystemExit(1)
