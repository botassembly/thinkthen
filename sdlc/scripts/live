#!/usr/bin/python3 -IS
"""Serialize and durably precharge authorized paid development jobs."""

import fcntl
import os
import stat
import subprocess
import sys

MAXIMUM = 9_223_372_036_854_775_807
SAFE_ENV = {b"PATH": b"/usr/bin:/bin", b"LC_ALL": b"C"}


class Refusal(Exception):
    def __init__(self, message, status=1):
        super().__init__(f"live: {message}\n")
        self.status = status


def refuse(message, status=1):
    raise Refusal(message, status)


def checkout_path():
    return os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(os.fsencode(__file__))), b"../.."))


def common_path(checkout):
    result = subprocess.run(
        [b"/usr/bin/git", b"-C", checkout, b"rev-parse", b"--path-format=absolute", b"--git-common-dir"],
        env=SAFE_ENV, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False,
    )
    value = result.stdout.removesuffix(b"\n")
    if result.returncode or not value.startswith(b"/") or b"\n" in value:
        refuse("the calling checkout has no readable Git common directory", 2)
    return os.path.realpath(value)


def safe_regular(path, mode, description):
    try:
        details = os.lstat(path)
    except OSError:
        refuse(f"{description} is missing or unreadable")
    actual = stat.S_IMODE(details.st_mode)
    unsafe = actual & 0o077 if mode == 0o600 else actual & 0o022
    if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid() or unsafe or not actual & stat.S_IRUSR:
        refuse(f"{description} has an unsafe type, owner, or mode")


def safe_directory(path):
    try:
        details = os.lstat(path)
    except OSError:
        refuse("the live authority is missing; run sdlc/scripts/live --init")
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != 0o700:
        refuse("the live authority has an unsafe type, owner, or mode")


def canonical_number(value, positive=False):
    if not value or not value.isascii() or not value.isdigit() or (len(value) > 1 and value.startswith("0")):
        raise ValueError
    number = int(value)
    if number > MAXIMUM or (positive and number == 0):
        raise ValueError
    return number


def open_bytes(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        chunks = []
        total = 0
        while True:
            chunk = os.read(descriptor, 4096)
            if not chunk:
                return b"".join(chunks)
            total += len(chunk)
            if total > 1_000_000:
                raise ValueError
            chunks.append(chunk)
    finally:
        os.close(descriptor)


def checkpoint_values(checkout):
    path = os.path.join(checkout, b"sdlc/live-tokens")
    safe_regular(path, 0o644, "the live checkpoint")
    try:
        values = {}
        for row in open_bytes(path).decode("ascii").splitlines():
            if not row or row.startswith("#"):
                continue
            fields = row.split(" ")
            if len(fields) != 2 or fields[0] in values:
                raise ValueError
            values[fields[0]] = canonical_number(fields[1])
        if set(values) != {"checkpoint_limit_tokens", "checkpoint_charged_tokens"}:
            raise ValueError
        limit = values["checkpoint_limit_tokens"]
        charged = values["checkpoint_charged_tokens"]
        if limit == 0 or charged > limit:
            raise ValueError
        return limit, charged
    except (OSError, UnicodeError, ValueError):
        refuse("the live checkpoint is malformed")


def legacy_absent(authority):
    if os.path.lexists(os.path.join(authority, b"state.json")):
        refuse("legacy live state exists; live work is disabled")


def lock_authority(authority):
    safe_directory(authority)
    lock_path = os.path.join(authority, b"lock")
    safe_regular(lock_path, 0o600, "the live authority lock")
    try:
        descriptor = os.open(lock_path, os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        return descriptor
    except OSError:
        refuse("the live authority lock is unavailable")


def read_ledger(authority):
    path = os.path.join(authority, b"ledger")
    initialized = os.path.join(authority, b"initialized")
    has_ledger = os.path.lexists(path)
    has_initialized = os.path.lexists(initialized)
    if not has_ledger and not has_initialized:
        refuse("the live authority is missing; run sdlc/scripts/live --init")
    if not has_initialized:
        refuse("the live initialization marker is missing; live work is disabled")
    safe_regular(initialized, 0o600, "the live initialization marker")
    if open_bytes(initialized) != b"version 1\n":
        refuse("the live initialization marker is malformed; live work is disabled")
    if not has_ledger:
        refuse("the live ledger is missing; live work is disabled")
    safe_regular(path, 0o600, "the live ledger")
    try:
        contents = open_bytes(path)
        if not contents.endswith(b"\n"):
            raise ValueError
        rows = contents.decode("ascii").splitlines()
        if len(rows) < 3 or rows[0] != "version 1":
            raise ValueError
        limit_fields = rows[1].split(" ")
        charged_fields = rows[2].split(" ")
        if limit_fields[:1] != ["limit_tokens"] or len(limit_fields) != 2:
            raise ValueError
        if charged_fields[:1] != ["initial_charged_tokens"] or len(charged_fields) != 2:
            raise ValueError
        limit = canonical_number(limit_fields[1], True)
        charged = canonical_number(charged_fields[1])
        if charged > limit:
            raise ValueError
        for row in rows[3:]:
            fields = row.split(" ")
            if len(fields) != 2:
                raise ValueError
            amount = canonical_number(fields[1], True)
            if fields[0] == "charge":
                charged += amount
            elif fields[0] == "extension":
                limit += amount
            else:
                raise ValueError
            if charged > limit or limit > MAXIMUM:
                raise ValueError
        return path, limit, charged
    except (OSError, UnicodeError, ValueError):
        refuse("the live ledger is malformed; live work is disabled")


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def initialize(checkout, common):
    limit, charged = checkpoint_values(checkout)
    authority = os.path.join(common, b"thinkthen-live")
    if not os.path.exists(authority):
        os.mkdir(authority, 0o700)
        sync_directory(common)
    safe_directory(authority)
    legacy_absent(authority)
    lock_path = os.path.join(authority, b"lock")
    if not os.path.exists(lock_path):
        descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
        os.fsync(descriptor)
        os.close(descriptor)
        sync_directory(authority)
    lock = lock_authority(authority)
    try:
        legacy_absent(authority)
        ledger = os.path.join(authority, b"ledger")
        initialized = os.path.join(authority, b"initialized")
        if os.path.lexists(ledger) or os.path.lexists(initialized):
            refuse("the live authority is already initialized")
        marker = b"version 1\n"
        descriptor = os.open(initialized, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            if os.write(descriptor, marker) != len(marker):
                raise OSError("short initialization-marker write")
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        sync_directory(authority)
        body = f"version 1\nlimit_tokens {limit}\ninitial_charged_tokens {charged}\n".encode("ascii")
        descriptor = os.open(ledger, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            if os.write(descriptor, body) != len(body):
                raise OSError("short ledger write")
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        sync_directory(authority)
        return 0
    finally:
        os.close(lock)


def status(authority):
    lock = lock_authority(authority)
    try:
        legacy_absent(authority)
        _, limit, charged = read_ledger(authority)
        sys.stdout.write(f"limit_tokens {limit}\ncharged_tokens {charged}\nremaining_tokens {limit - charged}\n")
        return 0
    finally:
        os.close(lock)


def capture_key():
    key = os.environb.get(b"THINKTHEN_API_KEY", b"")
    if not any(byte not in b" \t\r\n\v\f" for byte in key):
        refuse("THINKTHEN_API_KEY holds nothing, so no call goes out")
    if b"\n" in key:
        refuse("THINKTHEN_API_KEY contains a line break, so no call goes out")
    os.environb.pop(b"THINKTHEN_API_KEY", None)
    return key


def append_row(ledger, kind, amount):
    row = f"{kind} {amount}\n".encode("ascii")
    try:
        descriptor = os.open(ledger, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            if os.write(descriptor, row) != len(row):
                raise OSError("short ledger write")
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    except OSError:
        refuse(f"the {kind} may have been recorded; inspect --status before retry")


def add_tokens(arguments, authority):
    try:
        if len(arguments) != 2:
            raise ValueError
        amount = canonical_number(arguments[1], True)
    except ValueError:
        refuse("usage: sdlc/scripts/live --add-tokens N", 2)
    lock = lock_authority(authority)
    try:
        legacy_absent(authority)
        ledger, limit, _ = read_ledger(authority)
        if amount > MAXIMUM - limit:
            refuse(f"token admission would exceed {MAXIMUM}")
        append_row(ledger, "extension", amount)
        return 0
    finally:
        os.close(lock)


def reservation_value(text):
    try:
        return canonical_number(text, True)
    except ValueError:
        refuse("usage: sdlc/scripts/live --max-tokens N JOB [ARG...]", 2)


def shell_job(job):
    line = b"#!/bin/sh\n"
    try:
        descriptor = os.open(job, os.O_RDONLY | os.O_CLOEXEC)
        try:
            start = b""
            while len(start) < len(line):
                chunk = os.read(descriptor, len(line) - len(start))
                if not chunk:
                    break
                start += chunk
        finally:
            os.close(descriptor)
    except OSError:
        return False
    return start == line


def launch(arguments, checkout, authority, key):
    if len(arguments) < 3 or arguments[0] != "--max-tokens":
        refuse("usage: sdlc/scripts/live --max-tokens N JOB [ARG...]", 2)
    reservation = reservation_value(arguments[1])
    job_argument = os.fsencode(arguments[2])
    job = job_argument if job_argument.startswith(b"/") else os.path.join(checkout, job_argument)
    if not os.path.isfile(job):
        refuse("the named live job is not a file", 2)
    if not shell_job(job):
        refuse("the named live job must start with the line #!/bin/sh, so no call goes out", 2)
    binary = os.path.join(checkout, b"target/debug/thinkthen")
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        refuse("target/debug/thinkthen must be built before a live job", 2)
    lock = lock_authority(authority)
    try:
        legacy_absent(authority)
        ledger, limit, charged = read_ledger(authority)
        remaining = limit - charged
        if reservation > remaining:
            refuse(f"reservation {reservation} exceeds the {remaining} tokens remaining, so no call goes out")
        append_row(ledger, "charge", reservation)
    finally:
        os.close(lock)
    environment = dict(os.environb)
    environment[b"THINKTHEN_API_KEY"] = key
    environment[b"PATH"] = os.path.join(checkout, b"target/debug") + b":" + environment.get(b"PATH", b"/usr/bin:/bin")
    os.chdir(checkout)
    try:
        os.execve(b"/bin/sh", [b"/bin/sh", b"--", job, *[os.fsencode(item) for item in arguments[3:]]], environment)
    except OSError:
        refuse("the charged live job could not be executed", 125)


def main():
    checkout = checkout_path()
    action = sys.argv[1] if len(sys.argv) == 2 else None
    extension = sys.argv[1:2] == ["--add-tokens"]
    key = None if action in ("--init", "--status") or extension else capture_key()
    common = common_path(checkout)
    authority = os.path.join(common, b"thinkthen-live")
    if action == "--init":
        return initialize(checkout, common)
    if action == "--status":
        return status(authority)
    if extension:
        return add_tokens(sys.argv[1:], authority)
    legacy_absent(authority)
    return launch(sys.argv[1:], checkout, authority, key)


try:
    raise SystemExit(main())
except Refusal as error:
    sys.stderr.write(str(error))
    raise SystemExit(error.status)
except (OSError, ValueError, UnicodeError):
    sys.stderr.write("live: the live ledger failed safely\n")
    raise SystemExit(1)
