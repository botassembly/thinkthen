#!/bin/sh
# The routine behavior suite: workspace tests, doctests, the external consumer,
# shell self-tests. Binding package builds and ignored release cases run
# through test-full-cases; stress checks have their own entry point.
# The finished probes' self-tests run in spec (ticket 0335).
set -eu
tools_group=test
. "$(dirname -- "$0")/resolved-tools"
# nextest enforces the routine timeout; cargo test cannot enforce it.
if ! cargo nextest --version >/dev/null 2>&1; then
    echo 'test: cargo-nextest is required to enforce the routine timeout' >&2
    exit 2
fi
if [ "$(uname -s)" = Linux ]; then
    if [ "$(id -ru)" -eq 0 ]; then
        echo 'test: RLIMIT_NPROC does not bind real UID 0; run it as a nonroot user' >&2
        exit 2
    fi
    if ! command -v prlimit >/dev/null 2>&1; then
        echo 'test: prlimit is required for the Linux RLIMIT_NPROC case' >&2
        exit 2
    fi
    caps=$(awk '$1 == "CapEff:" { print $2 }' /proc/self/status 2>/dev/null) || {
        echo 'test: cannot read Linux effective capabilities for RLIMIT_NPROC' >&2
        exit 2
    }
    case $caps in
    ????????????????)
        case $caps in *[!0123456789abcdefABCDEF]*) caps= ;; esac ;;
    *) caps= ;;
    esac
    if [ -z "$caps" ]; then
        echo 'test: cannot read Linux effective capabilities for RLIMIT_NPROC' >&2
        exit 2
    fi
    cap_low=${caps#????????}
    if [ "$((0x$cap_low & 0x01200000))" -ne 0 ]; then
        echo 'test: RLIMIT_NPROC does not bind CAP_SYS_ADMIN or CAP_SYS_RESOURCE; run it without these capabilities' >&2
        exit 2
    fi
fi
. "$(dirname -- "$0")/allow-list"
# An exported selector must not narrow the full run.
unset THINKTHEN_CONFORMANCE_IDS THINKTHEN_TEST_PROFILE

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
. sdlc/scripts/compiler-isolation
# ADR 0113: a test that bypasses its scratch usage folder writes this decoy and fails the run.
. sdlc/scripts/scratch.sh
usage_guard
config_home
temp_home

# Call unconditionally so shell functions retain errexit. The exit trap also times failures.
step() (
    printf 'test step: %s\n' "$*" >&2
    step_started=$(python3 -c 'import time; print(time.monotonic())')
    step_finished() {
        step_status=$?
        python3 -c 'import sys, time; print("test elapsed: {:.3f} seconds (exit {})".format(time.monotonic() - float(sys.argv[1]), sys.argv[2]))' "$step_started" "$step_status" >&2 || :
        exit "$step_status"
    }
    trap step_finished EXIT
    "$@"
)

if [ "$(uname -s)" = Darwin ]; then
    echo "test: skip four invalid UTF-8 filename cases because macOS refuses those filenames; Linux CI runs them"
fi
step cargo nextest run --profile default --locked --offline --workspace --all-targets
step cargo test --locked --offline --workspace --doc
step cargo nextest run --profile default --config-file "$REPO/.config/nextest.toml" \
    --locked --offline --manifest-path conformance/consumer/Cargo.toml \
    --target-dir target/consumer --workspace
step python3 sdlc/scripts/tools-self-test.py
step python3 sdlc/scripts/hosted-workflow-self-test.py
step python3 sdlc/scripts/release-archive-self-test.py
step python3 sdlc/scripts/release-managed-pair-self-test.py
step python3 sdlc/scripts/release-language-tools-self-test.py
step python3 sdlc/scripts/release-registry-self-test.py
step python3 sdlc/scripts/release-windows-command-self-test.py
step python3 sdlc/scripts/windows-installer-integration-self-test.py
step python3 sdlc/scripts/install-check-self-test.py
step python3 sdlc/scripts/install-check-postgresql-self-test.py
step python3 sdlc/scripts/install-check-r-binary-test.py
step python3 sdlc/scripts/release-windows-c-self-test.py
step python3 sdlc/scripts/release-python-self-test.py
step python3 conformance/parity.py --validate
step python3 -m unittest conformance.test_parity conformance.test_campaign_env conformance.test_candidate_campaign conformance.test_stress_selection
step python3 conformance/library-surface-test.py
step sh specification/fixtures/question-file/self-test
step sh specification/fixtures/types/self-test
step python3 -m unittest conformance.children.test_privacy
step sh conformance/children/test.sh
step sh transforms/band/test.sh
step sh transforms/compare/test.sh
step sh transforms/cost/test.sh
step sh transforms/monitor/test.sh
step sh transforms/sweep/test.sh
step sh transforms/trials/test.sh
step sh transforms/triage/test.sh
step demos/16-triage-pipeline/self-test

if [ "$(uname -s)" = Linux ]; then
    step sdlc/live-test
else
    echo "test: skip Linux-only RLIMIT_NPROC, XDG-without-HOME and /proc thread assertions on macOS; Linux CI runs them"
    echo "test: skip Linux live-ledger process checks on macOS; Linux CI runs sdlc/live-test"
fi
