#!/bin/sh
# Rung 2: the unit tests, the integration tests, and the documentation tests.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"

cargo test --locked --workspace --all-targets --all-features
RUSTFLAGS='--cfg thinkthen_internal_doctest' \
RUSTDOCFLAGS='--cfg thinkthen_internal_doctest' \
    cargo test --locked --workspace --doc --all-features
sh probes/probability-total-0038/self-test
sh probes/find-0040/self-test
sh transforms/compare/test.sh
sh transforms/cost/test.sh
sh transforms/monitor/test.sh
sh transforms/sweep/test.sh
sh transforms/trials/test.sh
sh transforms/triage/test.sh
demos/16-triage-pipeline/self-test

if [ "$(uname -s)" = Linux ]; then
	sdlc/live-test
fi
