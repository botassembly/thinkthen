#!/bin/sh
# Routine functional checks. Full functional and stress checks have separate entry points.
set -eu
. "$(dirname -- "$0")/heavy-lock"

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
export THINKTHEN_CONFORMANCE_IDS="$REPO/conformance/routine-ids.txt"

# An exact filter that matches nothing makes Cargo exit successfully. Refuse it.
exact() {
    package=$1 target=$2 filter=$3
    cargo test --locked --offline -p "$package" --test "$target" "$filter" -- --list |
        grep -Fqx "$filter: test" || {
            echo "test: $package/$target has no $filter" >&2
            exit 1
        }
    cargo test --locked --offline -p "$package" --test "$target" "$filter" -- --exact --nocapture
}

exact thinkthen backend loopback_cases::every_wire_case_passes_through_the_command_on_the_conformance_backend
exact thinkthen backend secrecy::no_command_on_any_backend_path_writes_the_key_or_quotes_the_evidence
exact thinkthen backend secrecy::the_key_reaches_the_authorization_header_and_nothing_else
exact thinkthen backend secrecy_find::find_crosses_every_shared_backend_and_recording_route_without_a_leak
exact thinkthen backend secrecy_recognize::the_guard_names_sizes_and_never_the_text
exact thinkthen backend secrecy_recognize::a_failed_step_two_request_quotes_neither_text_nor_description
exact thinkthen backend secrecy_recognize::a_second_model_a_step_two_reply_names_is_withheld
exact thinkthen backend secrecy_recognize::reserved_kinds_refuse_at_exit_2_on_the_command_line_and_5_from_a_file
exact thinkthen backend secrecy_relate::a_partial_relation_answer_prints_and_exits_six_without_quoting_evidence
exact conformance-backend binary four_rounds_on_one_backend_each_let_go_only_the_reply_held_then
cargo test --locked --offline -p conformance-backend --test listener
cargo test --locked --offline -p thinkthen --test settings_cases
cargo test --locked --offline -p thinkthen --test public_controls
cargo test --locked --offline -p thinkthen --test public_members

for filter in core::pointer::tests core::question_file::tests engine::recorder::identity::tests public::options::tests::a_panic_below_the_door_is_a_defect_and_the_next_call_runs; do
    cargo test --locked --offline -p thinkthen --lib "$filter" -- --list |
        grep -F "$filter" >/dev/null || {
            echo "test: the library has no $filter" >&2
            exit 1
        }
    cargo test --locked --offline -p thinkthen --lib "$filter"
done

cargo test --locked --offline --manifest-path conformance/consumer/Cargo.toml \
    -p consumer --test public --target-dir target/consumer -- --nocapture
RUSTFLAGS='--cfg thinkthen_internal_doctest' \
RUSTDOCFLAGS='--cfg thinkthen_internal_doctest' \
    cargo test --locked --offline --workspace --doc
sh specification/fixtures/question-file/self-test
sh specification/fixtures/types/self-test
sh probes/probability-total-0038/self-test
sh probes/find-0040/self-test
sh conformance/children/test.sh
sh transforms/compare/test.sh
sh transforms/cost/test.sh
sh transforms/monitor/test.sh
sh transforms/sweep/test.sh
sh transforms/trials/test.sh
sh transforms/triage/test.sh
demos/16-triage-pipeline/self-test

if [ "$(uname -s)" = Linux ]; then
    sdlc/live-test
fi
