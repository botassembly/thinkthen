#!/bin/sh
# The full functional suite: every workspace test, the doctests, the external
# consumer, the shell self-tests, and one replay smoke per binding. Stress
# checks have their own entry point.
# The finished probes' self-tests run in spec (ticket 0335).
set -eu
if [ "$(uname -s)" = Linux ]; then
    if [ "$(id -ru)" -eq 0 ]; then
        echo 'test: RLIMIT_NPROC does not bind real UID 0; run it as a nonroot user' >&2
        exit 2
    fi
    if ! command -v prlimit >/dev/null 2>&1; then
        echo 'test: prlimit is required for the Linux RLIMIT_NPROC case' >&2
        exit 2
    fi
    caps=$(awk '$1 == "CapEff:" { print $2 }' /proc/self/status 2>/dev/null) || {
        echo 'test: cannot read Linux effective capabilities for RLIMIT_NPROC' >&2
        exit 2
    }
    case $caps in
    ????????????????)
        case $caps in *[!0123456789abcdefABCDEF]*) caps= ;; esac ;;
    *) caps= ;;
    esac
    if [ -z "$caps" ]; then
        echo 'test: cannot read Linux effective capabilities for RLIMIT_NPROC' >&2
        exit 2
    fi
    cap_low=${caps#????????}
    if [ "$((0x$cap_low & 0x01200000))" -ne 0 ]; then
        echo 'test: RLIMIT_NPROC does not bind CAP_SYS_ADMIN or CAP_SYS_RESOURCE; run it without these capabilities' >&2
        exit 2
    fi
fi
. "$(dirname -- "$0")/heavy-lock"
# An exported selector must not narrow the full run.
unset THINKTHEN_CONFORMANCE_IDS THINKTHEN_TEST_PROFILE

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
# ADR 0113: a test that bypasses its scratch usage folder writes this decoy and fails the run.
. sdlc/scripts/scratch.sh
usage_guard
config_home

# One replay smoke per binding, four at a time beside the Rust tests (ticket 0335).
# It runs in its own process group, so a failed step here stops every smoke before the lock frees.
scratch_dir smoke_log
# macOS has no setsid, so perl makes the group there.
if command -v setsid >/dev/null 2>&1; then
    setsid sh sdlc/scripts/smoke >"$smoke_log/out" 2>&1 &
else
    perl -e 'setpgrp(0, 0); exec @ARGV' sh sdlc/scripts/smoke >"$smoke_log/out" 2>&1 &
fi
smoke=$!
trap 'code=$?; set +e; [ -z "$smoke" ] || { kill -TERM -"$smoke" 2>/dev/null; wait "$smoke" 2>/dev/null; }; scratch_clean; exit "$code"' EXIT

# nextest runs the same tests in about half the time; cargo test is the fallback.
if cargo nextest --version >/dev/null 2>&1; then
    runner='nextest run'
else
    runner=test
fi
cargo $runner --locked --offline --workspace --all-targets
cargo test --locked --offline --workspace --doc
# Debt 028: the library-only integration tests, in their own target folder, so
# a test that starts the command without `#[cfg(feature = "cli")]` fails here
# and not first in the release `crate` job. Only integration tests can start
# the command, so nextest skips the unit tests the run above already ran.
# `sdlc/scripts/package` runs every target in the same folder.
if [ "$runner" = test ]; then only=; else only='kind(test)'; fi
CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}/library-only" \
    cargo $runner --locked --offline --package thinkthen --no-default-features \
    --features bundled-sqlite --tests ${only:+-E "$only"}
cargo $runner --locked --offline --manifest-path conformance/consumer/Cargo.toml \
    --target-dir target/consumer --workspace
python3 conformance/parity.py --validate
python3 -m unittest conformance.test_parity
sh specification/fixtures/question-file/self-test
sh specification/fixtures/types/self-test
sh conformance/children/test.sh
sh transforms/band/test.sh
sh transforms/compare/test.sh
sh transforms/cost/test.sh
sh transforms/monitor/test.sh
sh transforms/sweep/test.sh
sh transforms/trials/test.sh
sh transforms/triage/test.sh
demos/16-triage-pipeline/self-test

if [ "$(uname -s)" = Linux ]; then
    sdlc/live-test
fi

smoke_code=0
wait "$smoke" || smoke_code=$?
smoke=
cat -- "$smoke_log/out"
[ "$smoke_code" -eq 0 ] || { echo "test: a binding smoke failed (exit $smoke_code)" >&2; exit 1; }
