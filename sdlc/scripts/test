#!/bin/sh
# The full functional suite: every workspace test, the doctests, the external
# consumer, and the shell self-tests. Stress checks have their own entry point.
set -eu
if [ "$(uname -s)" = Linux ]; then
    if [ "$(id -ru)" -eq 0 ]; then
        echo 'test: RLIMIT_NPROC does not bind real UID 0; run it as a nonroot user' >&2
        exit 2
    fi
    if ! command -v prlimit >/dev/null 2>&1; then
        echo 'test: prlimit is required for the Linux RLIMIT_NPROC case' >&2
        exit 2
    fi
    caps=$(awk '$1 == "CapEff:" { print $2 }' /proc/self/status 2>/dev/null) || {
        echo 'test: cannot read Linux effective capabilities for RLIMIT_NPROC' >&2
        exit 2
    }
    case $caps in
    ????????????????)
        case $caps in *[!0123456789abcdefABCDEF]*) caps= ;; esac ;;
    *) caps= ;;
    esac
    if [ -z "$caps" ]; then
        echo 'test: cannot read Linux effective capabilities for RLIMIT_NPROC' >&2
        exit 2
    fi
    cap_low=${caps#????????}
    if [ "$((0x$cap_low & 0x01200000))" -ne 0 ]; then
        echo 'test: RLIMIT_NPROC does not bind CAP_SYS_ADMIN or CAP_SYS_RESOURCE; run it without these capabilities' >&2
        exit 2
    fi
fi
. "$(dirname -- "$0")/heavy-lock"
# An exported selector must not narrow the full run.
unset THINKTHEN_CONFORMANCE_IDS THINKTHEN_TEST_PROFILE

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"

# nextest runs the same tests in about half the time; cargo test is the fallback.
if cargo nextest --version >/dev/null 2>&1; then
    cargo nextest run --locked --offline --workspace --all-targets
else
    cargo test --locked --offline --workspace --all-targets
fi
cargo test --locked --offline --workspace --doc
cargo test --locked --offline --manifest-path conformance/consumer/Cargo.toml \
    --target-dir target/consumer
sh specification/fixtures/question-file/self-test
sh specification/fixtures/types/self-test
sh probes/probability-total-0038/self-test
sh probes/find-0040/self-test
sh conformance/children/test.sh
sh transforms/compare/test.sh
sh transforms/cost/test.sh
sh transforms/monitor/test.sh
sh transforms/sweep/test.sh
sh transforms/trials/test.sh
sh transforms/triage/test.sh
demos/16-triage-pipeline/self-test

if [ "$(uname -s)" = Linux ]; then
    sdlc/live-test
fi
