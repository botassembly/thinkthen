#!/usr/bin/env python3
"""No test child inherits the whole environment (ticket 0127).

A test that starts a child builds the child's whole environment, and test
code reads the parent's environment one name at a time. This scans every
tracked Rust, Python, TypeScript, Ruby, and R file for the spawn forms and the
whole-environment forms in ticket 0127's tables. It catches those forms and
nothing else: a spawn through another library, a map reached through an alias,
and an inline `#[cfg(test)]` module pass it. C sources and shell scripts are
outside its scope.

Usage: children [ROOT]. ROOT defaults to the repository. With --self-test, it
runs each rule against a file built to break it and pins the whole output.
"""

import pathlib
import re
import subprocess
import sys
import tempfile

LANGUAGES = {".rs": "Rust", ".py": "Python", ".mjs": "TypeScript", ".js": "TypeScript",
             ".ts": "TypeScript", ".rb": "Ruby", ".R": "R"}
COMMENT = {"Rust": "//", "TypeScript": "//", "Python": "#", "Ruby": "#", "R": "#"}

# EXCLUDED names a path prefix whose files are not tests, and why. EXEMPT and
# PENDING name one file, one rule, one line's stripped text, and how many lines
# of the file hold that text, and why. A new finding in such a file still
# fails, and so does a copy of the pinned line. An edit elsewhere in the file
# moves nothing. An entry that allows nothing fails too, so no table can rot.
EXCLUDED = {
    "sdlc/scripts/": "the gate's own tools run cargo, git, and node in the developer's toolchain",
    "site/": "the site build is not a test",
    "libraries/r/thinkthen/tools/": "the R package's install-time tools are not tests",
    "databases/duckdb/community/build_rust.py": "the community compiler wrapper is a build tool, not a test",
    "databases/duckdb/community/prepare.py": "the community toolchain preparation is a build tool, not a test",
}
EXEMPT = {
    ("libraries/typescript/tests/fork.test.mjs", "inherits",
     "const forked = fork(${script('fork_child.mjs')}, { execArgv: [] });", 1):
        "the fork runs inside a child the helper already built",
    ("crates/thinkthen/src/cli/conformance_tests/command.rs", "reads", "let seen = std::env::vars_os()", 1):
        "its form child scans its own whole environment, and that reading is the probe's evidence",
    ("databases/duckdb/tools/databases_suite.py", "inherits",
     'freed = subprocess.run([sys.executable, "-c", f"import duckdb; duckdb.connect({path!r}).close()"]).returncode', 1):
        "it runs inside a script whose process the helper already built",
}
PENDING = {}
TABLES = {"excluded": EXCLUDED, "exempt": EXEMPT, "pending": PENDING}

# Ordinary product children migrated to the owned-home helpers. Configuration,
# default-path and secrecy fixtures outside this family deliberately set folders;
# toolchain/container runners also retain their own installation environments.
OWNED_HOME_CALLERS = {
    "libraries/mcp/conformance.py", "libraries/mcp/installed.py", "libraries/mcp/test_installed.py",
    "crates/thinkthen/tests/native_named_questions.rs", "crates/thinkthen/tests/native_cache_policy.rs",
    "crates/thinkthen/tests/public_controls/alone.rs",
    "libraries/python/tests/conftest.py", "libraries/python/tests/test_named_backends.py",
    "libraries/python/tests/test_backend_setups.py", "libraries/python/tests/examples.py",
    "libraries/ruby/tests/backend.rb", "libraries/ruby/tests/test_package.rb",
    "libraries/ruby/tests/test_public_names.rb",
    "libraries/typescript/tests/backend.mjs", "libraries/typescript/tests/named_backends.test.mjs",
    "libraries/typescript/tests/shapes.test.mjs", "libraries/typescript/tests/examples.test.mjs",
}
DIRECT_FOLDER = re.compile(
    r'''\.env\(\s*["'](?:XDG_\w+|APPDATA|LOCALAPPDATA)["']|'''
    r'''["'](?:XDG_\w+|APPDATA|LOCALAPPDATA)["']\s*(?:\]\s*=|:)|'''
    r'''\b(?:XDG_\w+|APPDATA|LOCALAPPDATA)\s*(?:=|:)''')
FOLDERS = "set product child folders through the shared owned-home helper"

SPAWNS = {
    "Rust": re.compile(r"Command::new\("),
    "Python": re.compile(r"\b(?:subprocess\.(?:run|Popen|call|check_call|check_output)|asyncio\.create_subprocess_exec)\s*\("),
    "TypeScript": re.compile(
        r"(?:(?<![\w.])|(?<=[\w$]\.))(?:spawn|spawnSync|exec|execSync|execFile|execFileSync|fork)\s*\("),
    "Ruby": re.compile(r"(?:\bOpen3\.\w+|\bProcess\.spawn|\bIO\.popen|(?<![\w.:])(?:spawn|system|exec))"
                       r"(?=[ \t]*[(\"']|[ \t]+[\w\[@$:])"),
    "R": re.compile(r"(?<![\w.])system2?\s*\("),
}
PASSES = {
    "Python": lambda call: re.search(r"\benv\s*=", call) and not re.search(r"\benv\s*=\s*None\b", call),
    "TypeScript": lambda call: re.search(r"\benv\s*:", call) and not re.search(r"\benv\s*:\s*undefined\b", call),
    "Ruby": lambda call: re.search(r"unsetenv_others:\s*true", call),
    "R": lambda call: "clean_env(" in call,
}
OUTRIGHT = {
    "Python": re.compile(r"\bos\.(?:system|popen|exec\w*|spawn\w*)\s*\("),
    "Ruby": re.compile(r"`[^`\n]*`|%x[({\[]"),
}
WHOLE = {
    "Rust": re.compile(r"env::vars(?:_os)?\s*\("),
    "Python": re.compile(r"\bos\.environ\b"),
    "TypeScript": re.compile(r"\bprocess\.env\b"),
    "Ruby": re.compile(r"\bENV\b"),
    "R": re.compile(r"\bSys\.getenv\("),
}
SINGLE = {
    "Rust": re.compile(r"$^"),
    "Python": re.compile(r"os\.environ(?:\.(?:get|pop|setdefault)\(|\[)"),
    "TypeScript": re.compile(r"process\.env(?:\.\w+|\[)"),
    "Ruby": re.compile(r"ENV(?:\[|\.fetch\(|\.key\?\()"),
    "R": re.compile(r"Sys\.getenv\((?!\s*\)|\s*c\()"),
}
INHERITS = "this child inherits the whole environment; build it with the {} child helper"
READS = "test code reads the whole environment; read one name at a time"


def is_test(path):
    parts = path.split("/")
    return (any(part == "tests" or part.endswith("_tests") for part in parts[:-1])
            or path.startswith(("conformance/", "databases/duckdb/tools/"))
            or (path.endswith(".rs") and (parts[-1] == "tests.rs" or parts[-1].endswith("_tests.rs"))))


def uncommented(text, language):
    """The text with each comment line blanked, so line numbers hold."""
    mark = COMMENT[language]
    return "\n".join("" if line.lstrip().startswith(mark) else line for line in text.split("\n"))


def extent(text, start, statement):
    """From START to its closing bracket, or for a statement to its `;` at depth 0."""
    depth, at = 0, start
    while at < len(text):
        char = text[at]
        if char in "([{":
            depth += 1
        elif char in ")]}":
            depth -= 1
            if depth < 0 or (depth == 0 and not statement):
                return at + 1
        elif char == ";" and depth == 0 and statement:
            return at + 1
        at += 1
    return at


def call_text(text, end):
    """A call's arguments: its brackets, or without them the rest of the line
    and each line after one that ends in a comma or a backslash."""
    at = end
    while at < len(text) and text[at] in " \t":
        at += 1
    if at < len(text) and text[at] == "(":
        return text[at:extent(text, at, False)]
    stop = text.find("\n", at)
    while stop != -1 and text[:stop].rstrip().endswith((",", "\\")):
        stop = text.find("\n", stop + 1)
    return text[at:len(text) if stop == -1 else stop]


def rust_window(text, start):
    """The spawn's statement, and the later statements on the name a `let` bound it to."""
    end = extent(text, start, True)
    before = text[max(text.rfind(";", 0, start), text.rfind("{", 0, start), text.rfind("}", 0, start)) + 1:start]
    bound = re.search(r"let\s+(?:mut\s+)?(\w+)\s*=", before)
    while bound:
        rest = re.match(rf"\s*{bound.group(1)}\s*\.", text[end:])
        if not rest:
            break
        end = extent(text, end + rest.start(0), True)
    return text[start:end]


def single_name(language, text, at):
    """Whether the mention at AT names one variable, as the passing forms do."""
    before = text[text.rfind("\n", 0, at) + 1:at]
    if language == "Python" and re.search(r"\bin\s+$", before):
        return not re.search(r"\bfor\b[^:]*\bin\s+$", before)
    return bool(SINGLE[language].match(text, at))


def findings(path, text):
    """Each (line, rule) at which one file breaks a rule."""
    language = LANGUAGES[pathlib.PurePath(path).suffix]
    text = uncommented(text, language)
    line = lambda at: text.count("\n", 0, at) + 1
    out = []
    if path in OWNED_HOME_CALLERS:
        out.extend((line(hit.start()), "folders") for hit in DIRECT_FOLDER.finditer(text))
    if language != "TypeScript" or "child_process" in text:
        for hit in SPAWNS[language].finditer(text):
            if language == "Rust":
                # `clear_environment()` is the child helper's `env_clear()` that keeps
                # what a Windows child needs to start (ticket 0373).
                window = rust_window(text, hit.start())
                passed = ".env_clear()" in window or ".clear_environment()" in window
            else:
                passed = PASSES[language](call_text(text, hit.end() - (text[hit.end() - 1] == "(")))
            if not passed:
                out.append((line(hit.start()), "inherits"))
    for hit in OUTRIGHT.get(language, re.compile(r"$^")).finditer(text):
        out.append((line(hit.start()), "inherits"))
    if is_test(path):
        for hit in WHOLE[language].finditer(text):
            if not single_name(language, text, hit.start()):
                out.append((line(hit.start()), "reads"))
    return sorted(set(out))


def said(path, number, rule):
    language = LANGUAGES[pathlib.PurePath(path).suffix]
    message = {"inherits": INHERITS.format(language), "reads": READS, "folders": FOLDERS}[rule]
    return f"children: {path}:{number}: {message}"


def tracked(root):
    listed = subprocess.run(["git", "-C", str(root), "ls-files", "-z"], capture_output=True,
                            env={"PATH": "/usr/bin:/bin"}, check=False)
    if listed.returncode == 0:
        return [name for name in listed.stdout.decode().split("\0") if name]
    return sorted(str(path.relative_to(root)) for path in root.rglob("*") if path.is_file())


def check(root, tables):
    out, used = [], set()
    for path in tracked(root):
        if pathlib.PurePath(path).suffix not in LANGUAGES or not (root / path).is_file():
            continue
        text = (root / path).read_text(encoding="utf-8", errors="replace")
        found = findings(path, text)
        lines = [line.strip() for line in text.split("\n")]
        prefix = next((prefix for prefix in tables.get("excluded", {}) if path.startswith(prefix)), None)
        if prefix is not None:
            used.update([prefix] if found else [])
            continue
        for number, rule in found:
            pinned = (path, rule, lines[number - 1], lines.count(lines[number - 1]))
            if any(pinned in tables.get(kind, {}) for kind in ("exempt", "pending")):
                used.add(pinned)
            else:
                out.append(said(path, number, rule))
    for kind, table in tables.items():
        for key in table:
            if kind == "excluded" and key not in used:
                out.append(f"children: {key} is excluded but holds no finding; remove the entry")
            elif kind != "excluded" and key not in used:
                out.append(f"children: {key[0]} is {kind} for {key[1]} at `{key[2]}` held {key[3]} "
                           "time(s), but no such finding matches; fix the entry")
    return out


def rust_msg(path, number):
    return f"children: {path}:{number}: {INHERITS.format('Rust')}"


CASES = [
    ("libraries/typescript/tests/backend.mjs", 'const env = { XDG_CONFIG_HOME: folder };\n',
     [f"children: libraries/typescript/tests/backend.mjs:1: {FOLDERS}"]),
    ("libraries/typescript/tests/named_backends.test.mjs", 'const env = childEnv({ home: folder });\n', []),
    ("libraries/typescript/tests/settings.test.mjs", 'const env = { XDG_STATE_HOME: folder };\n', []),
    ("libraries/ruby/tests/backend.rb", 'env = Children.env("XDG_CONFIG_HOME" => folder)\n',
     [f"children: libraries/ruby/tests/backend.rb:1: {FOLDERS}"]),
    ("libraries/mcp/installed.py", 'env = {"XDG_CONFIG_HOME": folder}\n',
     [f"children: libraries/mcp/installed.py:1: {FOLDERS}"]),
    ("libraries/mcp/test_installed.py", 'env["APPDATA"] = folder\nenv.update(XDG_STATE_HOME=folder)\n',
     [f"children: libraries/mcp/test_installed.py:{n}: {FOLDERS}" for n in (1, 2)]),
    ("crates/thinkthen/tests/native_cache_policy.rs", 'command.env("LOCALAPPDATA", folder);\n',
     [f"children: crates/thinkthen/tests/native_cache_policy.rs:1: {FOLDERS}"]),
    ("libraries/mcp/installed.py", 'env = child_env(home=folder)\n', []),
    ("crates/thinkthen/tests/backend/cache_configuration.rs", 'command.env("XDG_CONFIG_HOME", folder);\n', []),
    ("a.rs", 'fn f() { Command::new("sh").arg("-c").output(); }\n', [rust_msg("a.rs", 1)]),
    ("a.rs", 'fn f() { Command::new("sh").env_clear().arg("-c").output(); }\n', []),
    ("a.rs", "fn f() {\n    let mut c = Command::new(x);\n    c.env_clear();\n    c.spawn();\n}\n", []),
    ("a.rs", 'fn f() { Command::new("sh").clear_environment().arg("-c").output(); }\n', []),
    ("a.rs", "fn f() {\n    run::output(Command::new(x).arg(\"--version\"));\n}\n", [rust_msg("a.rs", 2)]),
    ("a.rs", "fn f() {\n    // Command::new(x) in a comment\n}\n", []),
    ("tests/a.rs", "fn f() { Command::new(x).env_clear().envs(std::env::vars()); }\n",
     [f"children: tests/a.rs:1: {READS}"]),
    ("tests/a.rs", 'fn f() { std::env::var_os("PATH"); }\n', []),
    ("a.py", 'subprocess.run(["x"], capture_output=True)\n', [f"children: a.py:1: {INHERITS.format('Python')}"]),
    ("a.py", 'subprocess.run(["x"], env=None)\n', [f"children: a.py:1: {INHERITS.format('Python')}"]),
    ("a.py", 'subprocess.run(["x"],\n               env=child_env())\n', []),
    ("a.py", 'os.system("ls")\n', [f"children: a.py:1: {INHERITS.format('Python')}"]),
    ("tests/a.py", "env = dict(os.environ)\n", [f"children: tests/a.py:1: {READS}"]),
    ("tests/a.py", "names = os.environ.items()\n", [f"children: tests/a.py:1: {READS}"]),
    ("tests/a.py", "for name in os.environ:\n    pass\n", [f"children: tests/a.py:1: {READS}"]),
    ("tests/a.py", 'a = os.environ.get("PATH")\nb = os.environ["X"]\nc = "X" in os.environ\n'
                   'os.environ.pop("K", None)\nos.environ.setdefault("U", "v")\n', []),
    ("a.py", "env = dict(os.environ)\n", []),
    ("a.mjs", "import { spawn } from 'node:child_process';\nspawn(bin, [], { stdio });\n",
     [f"children: a.mjs:2: {INHERITS.format('TypeScript')}"]),
    ("a.mjs", "import { spawn } from 'node:child_process';\nspawn(bin, [], { env: undefined });\n",
     [f"children: a.mjs:2: {INHERITS.format('TypeScript')}"]),
    ("a.mjs", "import { spawn } from 'node:child_process';\nspawn(bin, [], { env: childEnv() });\n", []),
    ("a.mjs", "const hit = /x/.exec(text);\n", []),
    ("a.mjs", "import cp from 'node:child_process';\ncp.spawn(bin, []);\nchild_process.execSync(cmd);\n",
     [f"children: a.mjs:2: {INHERITS.format('TypeScript')}", f"children: a.mjs:3: {INHERITS.format('TypeScript')}"]),
    ("a.mjs", "import cp from 'node:child_process';\ncp.spawn(bin, [], { env: childEnv() });\n", []),
    ("tests/a.mjs", "const env = { ...process.env, X: '1' };\n", [f"children: tests/a.mjs:1: {READS}"]),
    ("tests/a.mjs", "const bin = process.env.THINKTHEN_TEST_BACKEND;\nconst v = process.env[name];\n", []),
    ("a.rb", 'Open3.capture3(env, ruby, "-e", s)\n', [f"children: a.rb:1: {INHERITS.format('Ruby')}"]),
    ("a.rb", 'Open3.capture3(env, ruby, "-e", s,\n               unsetenv_others: true)\n', []),
    ("a.rb", 'system "ls"\nspawn(\'ls\')\nexec ruby, "-e", s\nOpen3.popen2 bin\n',
     [f"children: a.rb:{n}: {INHERITS.format('Ruby')}" for n in (1, 2, 3, 4)]),
    ("a.rb", 'system env, "ls",\n       unsetenv_others: true\nOpen3.popen2 env, bin, unsetenv_others: true\n', []),
    ("a.rb", "out = `ls`\nmore = %x(ls)\n",
     [f"children: a.rb:1: {INHERITS.format('Ruby')}", f"children: a.rb:2: {INHERITS.format('Ruby')}"]),
    ("tests/a.rb", "base = ENV.to_h\n", [f"children: tests/a.rb:1: {READS}"]),
    ("tests/a.rb", 'h = ENV.fetch("HOME")\nk = ENV["K"]\nt = ENV.key?("HOME")\n', []),
    ("a.R", 'system2("sha256sum", file, stdout = TRUE)\n', [f"children: a.R:1: {INHERITS.format('R')}"]),
    ("a.R", 'system2("env", c(clean_env(), shQuote("sha256sum"), shQuote(file)))\n', []),
    ("tests/a.R", "all <- Sys.getenv()\n", [f"children: tests/a.R:1: {READS}"]),
    ("tests/a.R", 'two <- Sys.getenv(c("A", "B"))\nn <- names(Sys.getenv())\n',
     [f"children: tests/a.R:1: {READS}", f"children: tests/a.R:2: {READS}"]),
    ("tests/a.R", 'a <- Sys.getenv("TT_TESTS")\nb <- Sys.getenv("TT_CASE", "")\nc <- Sys.getenv(name)\n', []),
    ("x_tests/a.py", "env = dict(os.environ)\n", [f"children: x_tests/a.py:1: {READS}"]),
]


def self_test():
    """Run each case alone in a fresh tree, then one stale table entry, and pin each output."""
    bad = 0
    for relative, text, expected in CASES:
        with tempfile.TemporaryDirectory() as tmp:
            root = pathlib.Path(tmp)
            (root / relative).parent.mkdir(parents=True, exist_ok=True)
            (root / relative).write_text(text, encoding="utf-8")
            actual = check(root, {})
        if actual != expected:
            bad += 1
            print(f"children self-test: {relative}: expected {expected}, got {actual}", file=sys.stderr)
    with tempfile.TemporaryDirectory() as tmp:
        root = pathlib.Path(tmp)
        (root / "held.py").write_text('x = 1\nsubprocess.run(["x"])\nsubprocess.run(["y"])\n', encoding="utf-8")
        actual = check(root, {"excluded": {"gone/": "a fixture"},
                              "pending": {("held.py", "inherits", 'subprocess.run(["x"])', 1): "a fixture",
                                          ("held.py", "inherits", 'subprocess.run(["z"])', 1): "a fixture"}})
    expected = ["children: held.py:3: this child inherits the whole environment; build it with the Python child helper",
                "children: gone/ is excluded but holds no finding; remove the entry",
                "children: held.py is pending for inherits at `subprocess.run([\"z\"])` held 1 time(s), "
                "but no such finding matches; fix the entry"]
    if actual != expected:
        bad += 1
        print(f"children self-test: tables: expected {expected}, got {actual}", file=sys.stderr)
    print(f"children self-test: {len(CASES) + 1 - bad}/{len(CASES) + 1} cases hold")
    return bad


def main(argv):
    if argv[1:] == ["--self-test"]:
        return 1 if self_test() else 0
    root = pathlib.Path(argv[1]) if len(argv) > 1 else pathlib.Path(__file__).resolve().parents[2]
    found = check(root, TABLES)
    for line in found:
        print(line, file=sys.stderr)
    print(f"children: {len(found)} findings")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
