#!/bin/sh
# Explicitly opt in to repeated load and timing campaigns.
set -eu
case ${1:-} in
--list)
    echo 'backend binary: fifty rounds; twenty concurrent ports; the 5 s wait bound'
    echo 'backend listener: 80-cycle descriptor and thread retirement; the 8 s read timeout'
    echo 'public batches: 20,000-record memory; engine churn'
    echo 'engine width: 50 repeated first-width races'
    echo 'Polars: 200-record throttle equality'
    echo 'ports: THINKTHEN_TEST_PROFILE=stress via surfaces --stress'
    exit 0 ;;
--check|--run) mode=$1 ;;
*) echo 'usage: sdlc/scripts/test-stress --list|--check|--run' >&2; exit 2 ;;
esac
. "$(dirname -- "$0")/heavy-lock"
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
# ADR 0113: a step that bypasses its scratch usage folder writes this decoy and fails the run.
. sdlc/scripts/scratch.sh
usage_guard

ignored_case() {
    package=$1 target=$2 filter=$3
    shift 3
    cargo test --locked --offline -p "$package" "$@" --test "$target" "$filter" -- --ignored --list |
        grep -Fqx "$filter: test" || {
            echo "test-stress: $package/$target has no ignored $filter" >&2
            exit 1
        }
    if [ "$mode" = --run ]; then
        cargo test --locked --offline -p "$package" "$@" --test "$target" "$filter" -- --ignored --exact
    fi
}

ignored_lib() {
    filter=$1
    cargo test --locked --offline -p thinkthen --lib "$filter" -- --ignored --list |
        grep -Fqx "$filter: test" || {
            echo "test-stress: the library has no ignored $filter" >&2
            exit 1
        }
    if [ "$mode" = --run ]; then
        cargo test --locked --offline -p thinkthen --lib "$filter" -- --ignored --exact
    fi
}

ignored_case conformance-backend loopback binary::fifty_rounds_back_to_back_each_let_go_the_reply_they_counted
ignored_case conformance-backend loopback binary::twenty_backends_start_at_once_on_twenty_ports
ignored_case conformance-backend loopback binary::a_wait_line_gives_up_at_5_s_and_holds_up_no_line_behind_it
ignored_case conformance-backend loopback listener::retired_listeners_release_descriptors_and_threads_before_drop_returns
ignored_case conformance-backend loopback listener::a_silent_connection_held_past_the_read_timeout_takes_no_reply
ignored_case thinkthen public_batches a_long_batch_keeps_memory_flat_as_its_input_grows
ignored_case thinkthen public_batches engines_built_and_dropped_across_threads_fail_fast_on_a_refused_port
ignored_lib engine::width_tests::fifty_racing_first_widths_select_exactly_one_and_the_loser_names_it
# The Polars cases build engines from the environment, so their sends go to a scratch usage
# folder of their own, as in libraries/polars/check.sh. The decoy above still guards the rest.
usage_home
THINKTHEN_API_KEY=sk-polars-loopback
THINKTHEN_BASE_URL=http://127.0.0.1:9/v1
export THINKTHEN_API_KEY THINKTHEN_BASE_URL
ignored_case thinkthen polars throttle_equality::two_hundred_series_records_match_the_slice --features polars
if [ "$mode" = --run ]; then
    sh sdlc/scripts/surfaces --stress
else
    cargo test --locked --offline -p thinkthen --features polars --test polars \
        throttle_equality::a_series_runs_at_the_throttle_as_a_slice_does -- --exact
    echo 'test-stress: all nine ignored Rust filters exist; port stress selections are checked by their own check.sh'
fi
