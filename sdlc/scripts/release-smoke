#!/bin/sh
# release-smoke DIR (ticket 0128): install each release file in DIR into a fresh prefix and
# run its surface's check against that file alone. `release-pack` writes DIR. The rule is
# the release rule of verdict.sh: 0 passes, and "not run" (77) or any other code fails.
# A surface check reads THINKTHEN_ARTIFACT, installs the file, and loads it from there.
# The command's check runs the unpacked binary by path and then the README's "First run"
# block with no key: every line but its one curl line, whose download DIR supplies.
set -eu
. "$(dirname -- "$0")/verdict.sh"
. "$(dirname -- "$0")/scratch.sh"
. "$(dirname -- "$0")/installed.sh"
source_packages=
if [ "${1:-}" = --source-packages ]; then source_packages=1; shift; fi
[ $# -eq 1 ] && [ -d "$1" ] || { echo 'usage: release-smoke [--source-packages] DIR' >&2; exit 2; }
DIR=$(CDPATH='' cd -- "$1" && pwd)
REPO=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd -- "$REPO"
unset THINKTHEN_API_KEY
V=$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/thinkthen/Cargo.toml | head -n 1)
sha256() { if command -v shasum >/dev/null; then shasum -a 256 "$@"; else sha256sum "$@"; fi; }

# The opt-in Linux bundle must name every installed family before a backend starts.
# Ordinary release smoke keeps its original nine-family requirement below.
if [ -n "$source_packages" ]; then
	[ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || { echo 'release-smoke: source packages require Linux x86_64' >&2; exit 77; }
	target=$(rustc -vV | sed -n 's/^host: //p')
	[ "$target" = x86_64-unknown-linux-gnu ] || { echo 'release-smoke: source package target differs from this host' >&2; exit 77; }
	require_file() {
		[ -f "$DIR/$1" ] && [ ! -L "$DIR/$1" ] || { echo "release-smoke: missing or linked $1" >&2; exit 1; }
		[ -f "$DIR/$1.sha256" ] && [ ! -L "$DIR/$1.sha256" ] || { echo "release-smoke: missing or linked $1.sha256" >&2; exit 1; }
	}
	for family in c go cpp csharp jvm swift zig php dart flutter ada objective-c cobol sqlite duckdb postgresql16; do
		name=thinkthen-$family-$V-$target.tar.gz
		for file in "$DIR"/thinkthen-"$family"-*.tar.gz*; do
			[ -e "$file" ] || [ -L "$file" ] || continue
			case ${file##*/} in "$name" | "$name.sha256") ;; *) echo "release-smoke: extra family entry ${file##*/}" >&2; exit 1 ;; esac
		done
		require_file "$name"
	done
	require_file "thinkthen-$V-x86_64-unknown-linux-musl.tar.gz"
	for file in "$DIR"/thinkthen-[0-9]*.tar.gz*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		case ${file##*/} in "thinkthen-$V-x86_64-unknown-linux-musl.tar.gz" | "thinkthen-$V-x86_64-unknown-linux-musl.tar.gz.sha256") ;;
		*) echo "release-smoke: extra command entry ${file##*/}" >&2; exit 1 ;;
		esac
	done
	require_file "thinkthen-$V.tgz"
	for file in "$DIR"/thinkthen-*.tgz*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		case ${file##*/} in "thinkthen-$V.tgz" | "thinkthen-$V.tgz.sha256") ;; *) echo "release-smoke: extra npm entry ${file##*/}" >&2; exit 1 ;; esac
	done
	require_file thinkthen-first-run.tar.gz
	for extension in whl gem; do
		count=0
		for file in "$DIR"/thinkthen-"$V"-*.$extension; do
			[ -e "$file" ] || [ -L "$file" ] || continue
			[ -f "$file" ] && [ ! -L "$file" ] || { echo "release-smoke: missing or linked ${file##*/}" >&2; exit 1; }
			require_file "${file##*/}"
			name=${file##*/}
			count=$((count + 1))
		done
		[ "$count" -eq 1 ] || { echo "release-smoke: expected one installed $extension, got $count" >&2; exit 1; }
		for file in "$DIR"/thinkthen-*.$extension*; do
			[ -e "$file" ] || [ -L "$file" ] || continue
			case ${file##*/} in "$name" | "$name.sha256") ;; *) echo "release-smoke: extra $extension entry ${file##*/}" >&2; exit 1 ;; esac
		done
	done
fi

# A focused three-file pilot can call this same preflight by itself. A full
# release-smoke still requires every established family below.
pair=
managed_pair=
swift_zig_pair=
php_seen= dart_seen= flutter_seen=
ada_objc_cobol_pair=
for file in "$DIR"/*; do
	case ${file##*/} in thinkthen-go-* | thinkthen-cpp-*) pair=1 ;; esac
	case ${file##*/} in thinkthen-csharp-* | thinkthen-jvm-*) managed_pair=1 ;; esac
	case ${file##*/} in thinkthen-swift-* | thinkthen-zig-*) swift_zig_pair=1 ;; esac
	case ${file##*/} in thinkthen-php-*) php_seen=1 ;; thinkthen-dart-*) dart_seen=1 ;; thinkthen-flutter-*) flutter_seen=1 ;; esac
	case ${file##*/} in thinkthen-ada-* | thinkthen-objective-c-* | thinkthen-cobol-*) ada_objc_cobol_pair=1 ;; esac
done
if [ -n "$pair" ]; then
	sh "$REPO/sdlc/scripts/release-go-cpp-pair" "$DIR"
fi
if [ -n "$managed_pair" ]; then
	sh "$REPO/sdlc/scripts/release-go-cpp-pair" "$DIR" csharp-jvm
fi
if [ -n "$swift_zig_pair" ]; then
	sh "$REPO/sdlc/scripts/release-go-cpp-pair" "$DIR" swift-zig
fi
if [ -n "$php_seen" ] || { [ -n "$dart_seen" ] && [ -z "$flutter_seen" ]; }; then
	sh "$REPO/sdlc/scripts/release-go-cpp-pair" "$DIR" php-dart
fi
if [ -n "$flutter_seen" ]; then
	sh "$REPO/sdlc/scripts/release-go-cpp-pair" "$DIR" dart-flutter
fi
if [ -n "$ada_objc_cobol_pair" ]; then
	sh "$REPO/sdlc/scripts/release-go-cpp-pair" "$DIR" ada-objective-c-cobol
fi

# The conformance loopback backend, as the surfaces rung starts it.
backend_start

# Every library file, unpacked, holds neither the builder's home nor the PostgreSQL test probe. The
# checks' own scans read their builds, and this one reads the files a user installs.
scan() {
	into=$(mktemp -d "$backend/scan.XXXXXX") || return 1
	case $1 in
	*.whl) python3 -m zipfile -e "$1" "$into" ;;
	*.gem) tar -xOf "$1" data.tar.gz | tar -xzf - -C "$into" ;;
	*) tar -xzf "$1" -C "$into" ;;
	esac
	found=$(grep -rlaF -e "$HOME" -e thinkthen_panic_probe "$into" | sed "s|^$into/||" | tr '\n' ' ')
	[ -z "$found" ] || { echo "release-smoke: FAIL ${1##*/} (the builder's home or the test probe is in $found)"; return 1; }
}

# The command: its version line by path, then the first-run block with it first on PATH.
command_check() {
	prefix=$(mktemp -d "$backend/command.XXXXXX") || return 1
	tar -xzf "$1" -C "$prefix"
	[ "$("$prefix/thinkthen" --version)" = "thinkthen $V" ] ||
		{ echo "release-smoke: $1 reports $("$prefix/thinkthen" --version)" >&2; return 1; }
	[ -f "$DIR/thinkthen-first-run.tar.gz" ] || { echo 'release-smoke: DIR holds no thinkthen-first-run.tar.gz' >&2; return 1; }
	awk '/^## First run$/ { held = 1; next } /^## / { held = 0 } held && /^```/ { if (inside) exit; inside = 1; next } inside' \
		README.md >"$backend/block"
	[ "$(grep -c '^curl ' "$backend/block")" = 1 ] ||
		{ echo "release-smoke: README.md's First run block holds no one curl line" >&2; return 1; }
	sed "s|^curl .*|cp '$DIR/thinkthen-first-run.tar.gz' .|" "$backend/block" >"$prefix/block.sh"
	mkdir "$prefix/home"
	before=$(backend_count)
	answer=$(cd -- "$prefix/home" && env -u THINKTHEN_API_KEY -u THINKTHEN_BASE_URL HOME="$prefix/home" \
		XDG_CACHE_HOME="$prefix/home/.cache" PATH="$prefix:$PATH" sh -eu ../block.sh)
	[ "$answer" = true ] || { echo "release-smoke: the first-run block printed '$answer', not true" >&2; return 1; }
	[ "$(backend_count)" = "$before" ] || { echo 'release-smoke: the first-run block reached the loopback backend' >&2; return 1; }
}

failed=0 seen=
for file in "$DIR"/*; do
	name=${file##*/}
	case $name in
	*.sha256) continue ;;
	esac
	if ! (cd -- "$DIR" && sha256 -c "$name.sha256" >/dev/null 2>&1); then
		echo "release-smoke: FAIL $name (its .sha256 is missing or does not match)"
		failed=1
		continue
	fi
	# The rung packs the command's debug build, so the scan reads the libraries alone.
	case $name in thinkthen-"$V"-*.tar.gz) ;; *) scan "$file" || { failed=1; continue; } ;; esac
	case $name in
		thinkthen-first-run.tar.gz) seen="$seen first-run"; continue ;;
		thinkthen-c-*.tar.gz) surface=libraries/c ;;
		thinkthen-go-*.tar.gz) surface=libraries/go ;;
		thinkthen-cpp-*.tar.gz) surface=libraries/cpp ;;
		thinkthen-csharp-*.tar.gz) surface=libraries/csharp ;;
		thinkthen-jvm-*.tar.gz) surface=libraries/jvm ;;
		thinkthen-swift-*.tar.gz) surface=libraries/swift ;;
		thinkthen-zig-*.tar.gz) surface=libraries/zig ;;
		thinkthen-php-*.tar.gz) surface=libraries/php ;;
		thinkthen-dart-*.tar.gz) surface=libraries/dart ;;
		thinkthen-flutter-*.tar.gz) surface=libraries/dart ;;
		thinkthen-ada-*.tar.gz) surface=libraries/ada ;;
		thinkthen-objective-c-*.tar.gz) surface=libraries/objective-c ;;
		thinkthen-cobol-*.tar.gz) surface=libraries/cobol ;;
	thinkthen-sqlite-*.tar.gz) surface=databases/sqlite ;;
	thinkthen-duckdb-*.tar.gz) surface=databases/duckdb ;;
	thinkthen-postgresql16-*.tar.gz) surface=databases/postgresql ;;
	thinkthen-*.whl) surface=libraries/python ;;
	thinkthen-*.tgz) surface=libraries/typescript ;;
	thinkthen-*.gem) surface=libraries/ruby ;;
	thinkthen-"$V"-*.tar.gz) surface=command ;;
	*) echo "release-smoke: FAIL $name (no surface packs this file)"; failed=1; continue ;;
	esac
	seen="$seen $surface"
	set +e
	if [ "$surface" = command ]; then
		command_check "$file"
		code=$?
	else
		# A daemon a check starts must not hold the backend's input open.
		if [ "$surface" = libraries/go ] || [ "$surface" = libraries/cpp ] ||
		   [ "$surface" = libraries/csharp ] || [ "$surface" = libraries/jvm ] ||
		   [ "$surface" = libraries/swift ] || [ "$surface" = libraries/zig ] ||
		   [ "$surface" = libraries/php ] || [ "$surface" = libraries/dart ] ||
		   [ "$surface" = libraries/ada ] || [ "$surface" = libraries/objective-c ] ||
		   [ "$surface" = libraries/cobol ]; then
			THINKTHEN_ARTIFACT=$file THINKTHEN_C_ARTIFACT="$DIR/thinkthen-c-$V-$(rustc -vV | sed -n 's/^host: //p').tar.gz" \
				THINKTHEN_DART_ARTIFACT="$DIR/thinkthen-dart-$V-$(rustc -vV | sed -n 's/^host: //p').tar.gz" \
				sh "$surface/check.sh" "$port" 3>&-
		else
			THINKTHEN_ARTIFACT=$file sh "$surface/check.sh" "$port" 3>&-
		fi
		code=$?
	fi
	set -e
	verdict release "$surface $name" "$code" || failed=1
done
# Every file the release holds for this target is here.
for want in command libraries/c databases/sqlite databases/duckdb databases/postgresql \
	libraries/python libraries/typescript libraries/ruby first-run; do
	case " $seen " in *" $want "*) ;; *) echo "release-smoke: FAIL $want (DIR holds no file for it)"; failed=1 ;; esac
done
exit "$failed"
