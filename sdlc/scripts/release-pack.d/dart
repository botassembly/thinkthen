wrapper_dart() {
	mkdir -p "$folder"
	cp libraries/dart/CHANGELOG.md libraries/dart/LICENSE libraries/dart/README.md \
		libraries/dart/pubspec.yaml libraries/dart/pubspec.lock libraries/dart/native-assets.json "$folder/"
	cp -R libraries/dart/lib libraries/dart/hook libraries/dart/example "$folder/"
	cp libraries/dart/README-PUBLIC.md "$folder/README.md"
	python3 - "$folder/native-assets.json" "$OUT/$c_name" "$TARGET" <<'DART_ASSET'
import hashlib, json, sys, tarfile
from pathlib import Path
definition = Path(sys.argv[1])
manifest = json.loads(definition.read_text())
assets = [asset for asset in manifest['assets'].values() if asset['target'] == sys.argv[3]]
if len(assets) != 1:
    raise SystemExit('release-pack: Dart native target is unsupported')
asset = assets[0]
with tarfile.open(sys.argv[2]) as archive:
    payload = archive.extractfile('./lib/' + asset['file']).read()
digest = hashlib.sha256(payload).hexdigest()
if manifest['distribution'] == 'development-only':
    asset.update(sha256=digest, url=None)
    definition.write_text(json.dumps(manifest, indent=2) + '\n')
elif asset['sha256'] != digest:
    raise SystemExit('release-pack: Dart native asset checksum mismatch')
DART_ASSET
}

part_dart() { part_source_wrapper dart; dart_built=1; }
