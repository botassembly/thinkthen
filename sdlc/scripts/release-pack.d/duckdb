# DuckDB reads its footer: the platform, the DuckDB version, and the extension's version.
part_duckdb() {
	case $TARGET in
	x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu | aarch64-apple-darwin | x86_64-apple-darwin) ;;
	*) echo "release-pack: no pinned DuckDB C++ package for $TARGET" >&2; exit 77 ;;
	esac
	INPUTS_HERE=$REPO/databases/duckdb/tools
	. "$INPUTS_HERE/inputs.sh"
	DUCKDB_VERSIONS=$(input_versions)
	DEFAULT_VERSION=${DUCKDB_VERSIONS%% *}
	override_version=${THINKTHEN_DUCKDB_VERSION:-$DEFAULT_VERSION}
	input_select "$override_version" "$TARGET"
	override_source=${THINKTHEN_DUCKDB_CPP_SOURCE:-}
	override_static=${THINKTHEN_DUCKDB_CPP_STATIC_DIR:-}
	folder=$(fresh duckdb)
	cp LICENSE "$folder/LICENSE.thinkthen"
	set --
	for version in $DUCKDB_VERSIONS; do
	input_select "$version" "$TARGET"
	THINKTHEN_DUCKDB_VERSION=$version
	THINKTHEN_DUCKDB_CPP_SOURCE=$TOOLS/source
	THINKTHEN_DUCKDB_CPP_STATIC_DIR=
	if [ "$version" = "$override_version" ]; then
		THINKTHEN_DUCKDB_CPP_SOURCE=${override_source:-$TOOLS/source}
		THINKTHEN_DUCKDB_CPP_STATIC_DIR=${override_static:-}
	fi
	export THINKTHEN_DUCKDB_VERSION THINKTHEN_DUCKDB_CPP_SOURCE THINKTHEN_DUCKDB_CPP_STATIC_DIR
	if [ -z "$reuse" ]; then
		sh databases/duckdb/cpp/build.sh
	fi
	extension="databases/duckdb/build/artifacts/cpp/$DUCKDB_VERSION/$TARGET/thinkthen.duckdb_extension"
	[ -f "$extension" ] && [ ! -L "$extension" ] || { echo "release-pack: $extension is missing; build it first" >&2; exit 1; }
	elf_arch= mac_arch=
	case $TARGET in
	x86_64-unknown-linux-gnu) elf_arch='Advanced Micro Devices X86-64' ;;
	aarch64-unknown-linux-gnu) elf_arch=AArch64 ;;
	aarch64-apple-darwin) mac_arch=arm64 ;;
	x86_64-apple-darwin) mac_arch=x86_64 ;;
	esac
	if [ -n "${elf_arch:-}" ]; then
		machine=$(readelf -h "$extension" | sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p')
		[ "$machine" = "$elf_arch" ] || { echo "release-pack: DuckDB extension is $machine, not $elf_arch" >&2; exit 1; }
	fi
	if [ -n "${mac_arch:-}" ]; then
		[ "$(lipo -archs "$extension")" = "$mac_arch" ] || {
			echo "release-pack: $extension is not a single $mac_arch Mach-O" >&2
			exit 1
		}
	fi
	python3 databases/duckdb/cpp/verify_footer.py "$extension" "$TARGET" "$duckdb_metadata_version" "$V"
	mkdir -p "$folder/$duckdb_metadata_version/$platform"
	cp "$extension" "$folder/$duckdb_metadata_version/$platform/"
	python3 "$INPUTS_HERE/validate_inputs.py" --source "$THINKTHEN_DUCKDB_CPP_SOURCE" --commit "$duckdb_source_commit"
	set -- "$@" "$version" "$THINKTHEN_DUCKDB_CPP_SOURCE"
	done
	python3 databases/duckdb/cpp/package_notices.py "$folder" "$V" "$@"
	python3 databases/duckdb/cpp/verify_repository.py "$folder" "$TARGET" "$V"
	cp databases/duckdb/README-PUBLIC.md "$folder/README.md"
	find "$folder" -type f -exec chmod 644 {} +
	pack "thinkthen-duckdb-$V-$TARGET.tar.gz" "$folder"
}
