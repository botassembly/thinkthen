part_command() {
	suffix=
	[ "$TARGET" != x86_64-pc-windows-msvc ] || suffix=.exe
	if [ -n "$reuse" ]; then
		binary=${CARGO_TARGET_DIR:-$REPO/target}/debug/thinkthen$suffix
	else
		case $command_target in *-linux-musl)
			# Without a musl gcc, clang compiles the bundled SQLite against glibc's headers.
			# SQLite's large-file define then names open64 and stat64, which musl 1.2.4 and
			# later no longer export. On a 64-bit target off_t is 64 bits without that define.
			target_var=$(printf '%s' "$command_target" | tr - _)
			eval "cc=\${CC_$target_var:-}"
			if [ -z "$cc" ] && ! command -v "${command_target%%-*}-linux-musl-gcc" >/dev/null &&
				! { [ "$command_target" = x86_64-unknown-linux-musl ] && command -v musl-gcc >/dev/null; }; then
				command -v clang >/dev/null || { echo 'release-pack: the static command needs clang or a musl gcc' >&2; exit 1; }
				export "CC_$target_var=clang"
			fi
			eval "flags=\${CFLAGS_$target_var:-}"
			export "CFLAGS_$target_var=${flags:+$flags }-DSQLITE_DISABLE_LFS"
		;; esac
		cargo build --locked --quiet --release --package thinkthen-cli --target "$command_target"
		binary=${CARGO_TARGET_DIR:-$REPO/target}/$command_target/release/thinkthen$suffix
	fi
	folder=$(fresh command)
	cp -- "$binary" "$folder/thinkthen$suffix"
	cp README.md "$folder/README.md"
	if [ -n "$suffix" ]; then
		name=thinkthen-$V-$command_target.zip
		python3 sdlc/scripts/release-windows-command.py pack "$folder/thinkthen.exe" "$OUT/$name"
		(cd -- "$OUT" && sha256 "$name" >"$name.sha256")
	else
		pack "thinkthen-$V-$command_target.tar.gz" "$folder"
	fi
}
