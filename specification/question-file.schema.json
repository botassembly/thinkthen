{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thinkthen:question-file",
  "title": "thinkthen question file",
  "description": "The structural grammar of a question file, shared by the parser and this schema. A question file is one object that names exactly one verb, so it validates under exactly one entry definition. Semantic checks the schema cannot express are listed in specification/question-file.md: blank-string and control-character rules beyond the name pattern, unique and unrepeated names, threshold ranges and band form, RFC 6901 pointers, and the duplicate-member rejection the parser performs before any member is read.",
  "anyOf": [
    {
      "$ref": "#/$defs/decide"
    },
    {
      "$ref": "#/$defs/choose"
    },
    {
      "$ref": "#/$defs/tag"
    },
    {
      "$ref": "#/$defs/score"
    },
    {
      "$ref": "#/$defs/relate"
    }
  ],
  "$defs": {
    "decide": {
      "description": "A `decide` entry: the question text, what a yes and a no each mean, and the cut or band the answer is read under. A question file's `batch` is the most records of a stream one request carries. An annotate question set's entries take no `batch`.",
      "type": "object",
      "required": [
        "decide"
      ],
      "additionalProperties": false,
      "properties": {
        "decide": {
          "$ref": "#/$defs/questionText"
        },
        "true": {
          "$ref": "#/$defs/criterion"
        },
        "false": {
          "$ref": "#/$defs/criterion"
        },
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "on": {
          "$ref": "#/$defs/pointers"
        },
        "model": {
          "$ref": "#/$defs/name"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "batch": {
          "description": "`max`, or a whole number of at least 1.",
          "anyOf": [
            {
              "const": "max"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    },
    "choose": {
      "description": "A `choose` entry: the question text and its options, read under a single cut.",
      "type": "object",
      "required": [
        "choose"
      ],
      "additionalProperties": false,
      "properties": {
        "choose": {
          "$ref": "#/$defs/questionText"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "threshold": {
          "$ref": "#/$defs/cut"
        },
        "on": {
          "$ref": "#/$defs/pointers"
        },
        "model": {
          "$ref": "#/$defs/name"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "batch": {
          "description": "`max`, or a whole number of at least 1.",
          "anyOf": [
            { "const": "max" },
            { "type": "integer", "minimum": 1 }
          ]
        }
      }
    },
    "tag": {
      "description": "A `tag` entry: the question text and its labels, each read under the same single cut. A top-level `batch` sizes a record stream.",
      "type": "object",
      "required": [
        "tag"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "$ref": "#/$defs/questionText"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "threshold": {
          "$ref": "#/$defs/cut"
        },
        "on": {
          "$ref": "#/$defs/pointers"
        },
        "model": {
          "$ref": "#/$defs/name"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "batch": {
          "description": "`max`, or a whole number of at least 1.",
          "anyOf": [
            { "const": "max" },
            { "type": "integer", "minimum": 1 }
          ]
        }
      }
    },
    "score": {
      "description": "A `score` entry: the question text and its levels, lowest first. A score takes no threshold; the answer is a number. A top-level `batch` sizes a record stream.",
      "type": "object",
      "required": [
        "score"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "$ref": "#/$defs/questionText"
        },
        "levels": {
          "$ref": "#/$defs/levels"
        },
        "on": {
          "$ref": "#/$defs/pointers"
        },
        "model": {
          "$ref": "#/$defs/name"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "batch": {
          "description": "`max`, or a whole number of at least 1.",
          "anyOf": [
            { "const": "max" },
            { "type": "integer", "minimum": 1 }
          ]
        }
      }
    },
    "relate": {
      "description": "A `relate` entry: one ordered set of relation rules and the pointers that identify each entity.",
      "type": "object",
      "required": [
        "version",
        "relate"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "relate": {
          "type": "object",
          "required": [
            "relations"
          ],
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "object",
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              }
            },
            "relations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/relation"
              }
            }
          }
        },
        "threshold": {
          "$ref": "#/$defs/cut"
        },
        "model": {
          "$ref": "#/$defs/name"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "relation": {
      "description": "One relation rule. A left-out source or target means any kind, as `*` and `ANY` do.",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "$ref": "#/$defs/name"
        },
        "target": {
          "$ref": "#/$defs/name"
        },
        "reads": {
          "$ref": "#/$defs/name"
        },
        "either": {
          "type": "boolean"
        }
      }
    },
    "questionText": {
      "description": "The question text: a nonblank string, an object, or a list. An object or a list may be empty; the value is the text.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "criterion": {
      "description": "What a side of a decide means, or what a score level means: nonblank text, an object, a list, or null.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "description": "A description an option or a label carries: text, an object, a list, or null. A blank string counts as a description in the grammar; the parser reads it as absent.",
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "name": {
      "description": "A label or level name: text holding a printable character and no control character.",
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "profile": {
      "description": "A calibration identity: lowercase letters, digits, hyphens, and underscores.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "options": {
      "description": "Two to 255 options, as a list of names or a map from each name to its description.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 2,
          "maxItems": 255
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/description"
          },
          "minProperties": 2,
          "maxProperties": 255
        }
      ]
    },
    "labels": {
      "description": "One to 20 tag labels, as a list of names or a map from each name to its description.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "maxItems": 20
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/description"
          },
          "minProperties": 1,
          "maxProperties": 20
        }
      ]
    },
    "levels": {
      "description": "Two to 10 levels, lowest first, as a list of names or a map from each name to what the level means.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 2,
          "maxItems": 10
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/criterion"
          },
          "minProperties": 2,
          "maxProperties": 10
        }
      ]
    },
    "threshold": {
      "description": "A cut as a number, or a cut or a band as text. The parser checks the range and the band form.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "cut": {
      "description": "A single cut as a number or as text. A band, written LOW:HIGH, is not a cut; the parser also checks the range.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^[^:]*$"
        }
      ]
    },
    "pointers": {
      "description": "One JSON Pointer, or a list of them. The parser checks RFC 6901.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "doorRequest": {
      "description": "The C JSON door request: one verb, its question members, and up to six envelope keys. Moved here from the result schema by ADR 0112, because it is input.",
      "type": "object", "minProperties": 1,
      "properties": {
        "evidence": {"type": "string"}, "records": {"type": "array"},
        "units": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "boolean"}, "usage": {"const": true},
        "call": {"type": "object", "additionalProperties": false,
          "properties": {"batch": {"anyOf": [{"const": "max"}, {"type": "integer", "minimum": 1}]}, "context": {"type": "string", "minLength": 1}}},
        "rank": {"type": "string"}, "find": {"type": "string"},
        "annotate": {"type": "object"}, "recognize": {"type": "object"},
        "relate": {"type": "object"}, "none": {"type": "boolean"},
        "decide": {"type": ["string", "object", "array"]},
        "choose": {"type": ["string", "object", "array"]},
        "tag": {"type": ["string", "object", "array"]},
        "score": {"type": ["string", "object", "array"]},
        "filter": {"type": ["string", "object", "array"]}
      },
      "oneOf": [
        {"required": ["usage"]},
        {"required": ["decide"]}, {"required": ["choose"]},
        {"required": ["tag"]}, {"required": ["score"]},
        {"required": ["filter"]}, {"required": ["rank"]},
        {"required": ["find"]}, {"required": ["annotate"]},
        {"required": ["recognize"]}, {"required": ["relate"]}
      ],
      "allOf": [
        {"if": {"required": ["usage"]}, "then": {"maxProperties": 1}},
        {"if": {"required": ["recognize"]}, "then": {"required": ["evidence"]}},
        {"if": {"anyOf": [{"required": ["decide"]}, {"required": ["choose"]},
          {"required": ["tag"]}, {"required": ["score"]}]},
          "then": {"oneOf": [{"required": ["evidence"]}, {"required": ["records"]}]}},
        {"if": {"anyOf": [{"required": ["filter"]}, {"required": ["rank"]},
          {"required": ["annotate"]}, {"required": ["relate"]}]},
          "then": {"required": ["records"]}},
        {"if": {"required": ["find"]}, "then": {"required": ["units"]}},
        {"if": {"required": ["none"]}, "then": {"required": ["find"]}},
        {"if": {"anyOf": [{"required": ["decide"]}, {"required": ["choose"]},
          {"required": ["tag"]}, {"required": ["score"]}, {"required": ["filter"]},
          {"required": ["rank"]}, {"required": ["annotate"]}]},
          "then": {"properties": {"records": {"items": {"type": "string"}}}}},
        {"if": {"required": ["relate"]},
          "then": {"properties": {"records": {"items": {"type": "object"}}}}},
        {"if": {"required": ["details"]}, "then": {"anyOf": [
          {"required": ["decide"]}, {"required": ["choose"]},
          {"required": ["tag"]}, {"required": ["score"]}
        ]}},
        {"if": {"required": ["recognize"]},
          "then": {"not": {"anyOf": [{"required": ["records"]}, {"required": ["units"]}]}}},
        {"if": {"required": ["call"]}, "then": {"required": ["records"],
          "not": {"anyOf": [{"required": ["find"]}, {"required": ["recognize"]}, {"required": ["relate"]}]}}},
        {"if": {"required": ["annotate"]},
          "then": {"properties": {"call": {"not": {"required": ["context"]}}}}},
        {"if": {"anyOf": [{"required": ["filter"]}, {"required": ["rank"]},
          {"required": ["annotate"]}, {"required": ["relate"]}]},
          "then": {"not": {"anyOf": [{"required": ["evidence"]}, {"required": ["units"]}]}}},
        {"if": {"required": ["find"]},
          "then": {"not": {"anyOf": [{"required": ["evidence"]}, {"required": ["records"]}]}}},
        {"not": {"anyOf": [
          {"required": ["evidence", "records"]}, {"required": ["evidence", "units"]},
          {"required": ["records", "units"]}
        ]}}
      ]
    }
  }
}
