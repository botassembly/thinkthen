            ]
          }
        },
        {
          "if": {
            "required": [
              "usage_status"
            ]
          },
          "then": {
            "maxProperties": 1
          }
        },
        {
          "if": {
            "required": [
              "finish_usage_status"
            ]
          },
          "then": {
