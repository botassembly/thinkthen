            ]
          },
          "then": {
            "properties": {
              "records": {
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "details"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "decide"
                ]
              },
              {
                "required": [
