#!/bin/sh
# Run the result schema and real C JSON door against the same type corpus.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HERE/../../../sdlc/scripts/allow-list"
# pm job isolates this fixture's Cargo output and admits its build resources.
# ADR 0113: the C door's engines write a scratch usage folder, never the real one.
. "$HERE/../../../sdlc/scripts/scratch.sh"
usage_home
# C from_env reads configuration even when the corpus supplies a loopback base.
scratch_dir config_home
export XDG_CONFIG_HOME="$config_home"
python3 "$HERE/check.py"
