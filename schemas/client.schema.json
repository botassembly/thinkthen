{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "description": "Immutable operational settings; serialization always omits the API key.",
  "type": "object",
  "properties": {
    "api_key": {
      "type": [
        "string",
        "null"
      ],
      "writeOnly": true
    },
    "backend": {
      "$ref": "#/$defs/BackendName",
      "default": "systemone"
    },
    "batch": {
      "anyOf": [
        {
          "$ref": "#/$defs/Batch"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry": {
      "$ref": "#/$defs/Retry",
      "default": {
        "attempt_timeout_ms": 120000,
        "initial_backoff_ms": 500,
        "max_retries": 3
      }
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BackendName": {
      "description": "The backend selected by a caller, independent of its wire representation.",
      "oneOf": [
        {
          "description": "systemone",
          "type": "string",
          "const": "systemone"
        },
        {
          "description": "openai",
          "type": "string",
          "const": "openai"
        },
        {
          "description": "stub",
          "type": "string",
          "const": "stub"
        }
      ]
    },
    "Batch": {
      "type": "integer",
      "format": "uint",
      "minimum": 1
    },
    "Retry": {
      "description": "The existing retry policy expressed in integer milliseconds at JSON boundaries.",
      "type": "object",
      "properties": {
        "attempt_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 120000,
          "minimum": 1
        },
        "initial_backoff_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 500,
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "format": "uint32",
          "default": 3,
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
