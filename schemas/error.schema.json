          "type": "string",
          "const": "usage.output"
        },
        {
          "description": "usage.table",
          "type": "string",
          "const": "usage.table"
        },
        {
          "description": "record.json",
          "type": "string",
          "const": "record.json"
        },
        {
          "description": "record.missing",
          "type": "string",
          "const": "record.missing"
        },
        {
          "description": "record.too-large",
          "type": "string",
          "const": "record.too-large"
