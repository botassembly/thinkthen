{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": "A canonical question and its initial input records.",
  "type": "object",
  "properties": {
    "name": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "question": {
      "$ref": "#/$defs/RawQuestion"
    },
    "records": {
      "type": "array",
      "default": [],
      "items": true
    }
  },
  "additionalProperties": false,
  "required": [
    "question"
  ],
  "$defs": {
    "Band": {
      "type": "object",
      "properties": {
        "high": {
          "$ref": "#/$defs/Cut"
        },
        "low": {
          "$ref": "#/$defs/Cut"
        }
      },
      "additionalProperties": false,
      "required": [
        "low",
        "high"
      ]
    },
    "Cut": {
      "description": "A finite probability from 0 to 1, inclusive.\n\nSerialization and [`Self::get`] retain full precision.",
      "type": "number",
      "format": "double",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "Pointer": {
      "type": "string",
      "format": "json-pointer"
    },
    "RawAnnotatableQuestion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "decide"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Threshold",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "choices": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "choose"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Threshold",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "choices"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "tag"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "labels"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "score"
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "question": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "levels"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "filter"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Threshold",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "find"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "recognize"
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "kinds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "relate"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RuleWire"
              },
              "minItems": 1
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "rules"
          ]
        }
      ]
    },
    "RawNamed": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RawAnnotatableQuestion"
      },
      "minProperties": 1
    },
    "RawQuestion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "decide"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Threshold",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "choices": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "choose"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Threshold",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "choices"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "tag"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "labels"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "score"
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "question": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "levels"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "filter"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Threshold",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "find"
            },
            "question": {
              "type": "string"
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "recognize"
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "kinds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "relate"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RuleWire"
              },
              "minItems": 1
            },
            "threshold": {
              "$ref": "#/$defs/Cut",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "rules"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "rank"
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "question": {
              "type": "string"
            },
            "top": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "maximum": 2147483647,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "question",
            "levels"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Pointer"
            },
            "function": {
              "type": "string",
              "const": "annotate"
            },
            "questions": {
              "$ref": "#/$defs/RawNamed"
            }
          },
          "additionalProperties": false,
          "required": [
            "function",
            "questions"
          ]
        }
      ]
    },
    "RuleWire": {
      "type": "object",
      "properties": {
        "either": {
          "type": "boolean",
          "default": false
        },
        "reads": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "relation",
        "source",
        "target"
      ]
    },
    "Threshold": {
      "oneOf": [
        {
          "$ref": "#/$defs/Cut"
        },
        {
          "$ref": "#/$defs/Band"
        }
      ]
    }
  }
}
