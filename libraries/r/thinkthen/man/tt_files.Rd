\name{tt_files}
\alias{tt_files}
\title{Select explicit native file input}
\usage{tt_files(paths, unit = "line", window = NULL, media = "text")}
\arguments{
\item{paths}{Ordered file paths.}
\item{unit}{Native physical reading unit.}
\item{window}{Optional native window size.}
\item{media}{Text or image media selection.}
}
\value{An input selector for any named judging call.}
\description{The native request owns reading admission and provenance. This helper only converts R values.}
