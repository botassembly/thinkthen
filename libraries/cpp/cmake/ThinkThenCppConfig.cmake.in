@PACKAGE_INIT@
add_library(thinkthen::native_shared SHARED IMPORTED)
set_target_properties(thinkthen::native_shared PROPERTIES
 IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libthinkthen.so.0"
 IMPORTED_SONAME "libthinkthen.so.0")
add_library(thinkthen::native_static STATIC IMPORTED)
set_target_properties(thinkthen::native_static PROPERTIES
 IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libthinkthen.a")
include("${CMAKE_CURRENT_LIST_DIR}/thinkthen-cpp-targets.cmake")
check_required_components(thinkthen_cpp)
