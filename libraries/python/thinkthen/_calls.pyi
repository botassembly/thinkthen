from typing_extensions import Unpack
from typing import Any, Generic, TypeVar
from ._native_results import _NativeResult, NativeFacts, NativeSessionPacketTerminal
from ._named_generated import DecideOptions, ChooseOptions, TagOptions, ScoreOptions, FilterOptions, RankOptions, FindOptions, AnnotateOptions, RecognizeOptions, RelateOptions
T = TypeVar('T', covariant=True)
class Result(Generic[T]):
    results: tuple[_NativeResult, ...]
    terminal: NativeSessionPacketTerminal
    function: str
    scalar: bool
    @property
    def value(self) -> T: ...
    @property
    def probability(self) -> float | None | list[float | None] | list[list[float]]: ...
    @property
    def facts(self) -> NativeFacts | None: ...
    def _to_dict(self) -> dict[str, Any]: ...
from . import _DecideResult, _ChooseResult, _TagResult, _ScoreResult, _FilterResult, _RankResult, _FindResult, _AnnotateResult, _RecognizeResult, _RelateResult
class AsyncCalls:
    async def decide(self, question: Any, value: Any, **controls: Unpack[DecideOptions]) -> _DecideResult: ...
    async def choose(self, question: Any, value: Any, **controls: Unpack[ChooseOptions]) -> _ChooseResult: ...
    async def tag(self, question: Any, value: Any, **controls: Unpack[TagOptions]) -> _TagResult: ...
    async def score(self, question: Any, value: Any, **controls: Unpack[ScoreOptions]) -> _ScoreResult: ...
    async def filter(self, question: Any, value: Any, **controls: Unpack[FilterOptions]) -> _FilterResult: ...
    async def rank(self, question: Any, value: Any, **controls: Unpack[RankOptions]) -> _RankResult: ...
    async def find(self, question: Any, value: Any, **controls: Unpack[FindOptions]) -> _FindResult: ...
    async def annotate(self, question: Any, value: Any, **controls: Unpack[AnnotateOptions]) -> _AnnotateResult: ...
    async def recognize(self, text: Any, ask: Any = ..., **controls: Unpack[RecognizeOptions]) -> _RecognizeResult: ...
    async def relate(self, entities: Any, ask: Any = ..., **controls: Unpack[RelateOptions]) -> _RelateResult: ...

class Session:
    @property
    def facts(self) -> NativeFacts | None: ...
    @property
    def terminal(self) -> NativeSessionPacketTerminal | None: ...
    def __iter__(self) -> Session: ...
    def __next__(self) -> _NativeResult: ...
    def close(self) -> None: ...
    def cancel(self) -> None: ...
    def __enter__(self) -> Session: ...
    def __exit__(self, *args: Any) -> None: ...
