from typing_extensions import Unpack
from typing import Any, Generic, TypeVar
from ._native_results import _NativeResult, NativeFacts, NativeSessionPacketTerminal
from ._named_generated import DecideOptions, ChooseOptions, TagOptions, ScoreOptions, FilterOptions, RankOptions, FindOptions, AnnotateOptions, RecognizeOptions, RelateOptions
T = TypeVar('T')
class Result(Generic[T]):
    results: tuple[_NativeResult, ...]
    terminal: NativeSessionPacketTerminal
    function: str
    scalar: bool
    detailed: bool
    @property
    def value(self) -> T: ...
    @property
    def probability(self) -> Any: ...
    @property
    def details(self) -> tuple[_NativeResult, ...]: ...
    @property
    def facts(self) -> NativeFacts | None: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def to_dict(self) -> dict[str, Any]: ...
class AsyncCalls:
    async def decide(self, question: Any, value: Any, **controls: Unpack[DecideOptions]) -> Result[Any]: ...
    async def choose(self, question: Any, value: Any, **controls: Unpack[ChooseOptions]) -> Result[Any]: ...
    async def tag(self, question: Any, value: Any, **controls: Unpack[TagOptions]) -> Result[Any]: ...
    async def score(self, question: Any, value: Any, **controls: Unpack[ScoreOptions]) -> Result[Any]: ...
    async def filter(self, question: Any, value: Any, **controls: Unpack[FilterOptions]) -> Result[Any]: ...
    async def rank(self, question: Any, value: Any, **controls: Unpack[RankOptions]) -> Result[Any]: ...
    async def find(self, question: Any, value: Any, **controls: Unpack[FindOptions]) -> Result[Any]: ...
    async def annotate(self, question: Any, value: Any, **controls: Unpack[AnnotateOptions]) -> Result[Any]: ...
    async def recognize(self, text: Any, ask: Any = ..., **controls: Unpack[RecognizeOptions]) -> Result[Any]: ...
    async def relate(self, entities: Any, ask: Any = ..., **controls: Unpack[RelateOptions]) -> Result[Any]: ...

class Session:
    @property
    def facts(self) -> NativeFacts | None: ...
    @property
    def terminal(self) -> NativeSessionPacketTerminal | None: ...
    def __iter__(self) -> Session: ...
    def __next__(self) -> _NativeResult: ...
    def close(self) -> None: ...
    def cancel(self) -> None: ...
    def __enter__(self) -> Session: ...
    def __exit__(self, *args: Any) -> None: ...
