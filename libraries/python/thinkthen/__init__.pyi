"""The typed face of ``thinkthen``. It matches ``thinkthen/__init__.py``."""

import os
from typing import Any, Iterable, Mapping, Optional, Sequence, Union

__all__ = [
    "BackendError", "Cancelled", "CancelToken", "DeadlineError", "DefectError",
    "Edge", "Engine", "Entity", "LocalError", "Question", "Recognized",
    "ThinkThenError", "UsageError", "annotate", "choose", "decide",
    "decide_many", "details", "filter", "find", "question", "rank",
    "recognize", "relate", "score", "tag", "usage",
]

Path = Union[str, os.PathLike[str]]
Deadline = Optional[float]
Spec = Union[Path, Mapping[str, Any]]
Asked = Union[str, "Question"]
Pair = Union[tuple[str, str], Mapping[str, str], "Entity"]

class ThinkThenError(Exception):
    kind: str
    retryable: bool

class UsageError(ThinkThenError): ...
class BackendError(ThinkThenError): ...
class LocalError(ThinkThenError): ...
class DeadlineError(ThinkThenError): ...
class DefectError(ThinkThenError): ...
class Cancelled(KeyboardInterrupt, ThinkThenError): ...

class CancelToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...

class Question:
    @property
    def kind(self) -> str: ...

class Entity:
    def __init__(self, name: str, kind: str) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def start(self) -> Optional[int]: ...
    @property
    def end(self) -> Optional[int]: ...
    @property
    def strength(self) -> Optional[float]: ...

class Edge:
    @property
    def relation(self) -> str: ...
    @property
    def source(self) -> Entity: ...
    @property
    def target(self) -> Entity: ...
    @property
    def probability(self) -> float: ...

class Recognized:
    @property
    def entities(self) -> list[Entity]: ...
    @property
    def relations(self) -> Optional[list[Edge]]: ...

def question(
    *,
    decide: Optional[str] = ...,
    choose: Optional[str] = ...,
    score: Optional[str] = ...,
    tag: Optional[str] = ...,
    threshold: Union[float, str, tuple[float, float], None] = ...,
    options: Union[Sequence[str], Mapping[str, Any], None] = ...,
    labels: Union[Sequence[str], Mapping[str, Any], None] = ...,
    levels: Union[Sequence[str], Mapping[str, Any], None] = ...,
    true_: Optional[str] = ...,
    false_: Optional[str] = ...,
    model: Optional[str] = ...,
    file: Optional[Path] = ...,
) -> Question: ...

class Engine:
    def __init__(
        self,
        *,
        base_url: Optional[str] = ...,
        model: Optional[str] = ...,
        throttle: Optional[int] = ...,
        max_requests: Optional[int] = ...,
        cache: Union[Path, bool, None] = ...,
        cache_bytes: Optional[int] = ...,
    ) -> None: ...
    def decide(self, question: Asked, text: str, *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Optional[bool]: ...
    def decide_many(self, question: Asked, records: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[Optional[bool]]: ...
    def choose(self, question: Asked, text: str, *, options: Union[Sequence[str], Mapping[str, Any], None] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Optional[str]: ...
    def score(self, question: Asked, text: str, *, levels: Union[Sequence[str], Mapping[str, Any], None] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> float: ...
    def tag(self, question: Asked, text: str, *, labels: Union[Sequence[str], Mapping[str, Any], None] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[str]: ...
    def details(self, question: Asked, text: str, *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> dict[str, Any]: ...
    def filter(self, question: Asked, records: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[str]: ...
    def rank(self, question: Asked, records: Iterable[str], *, top: Optional[int] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[dict[str, Any]]: ...
    def find(self, question: Asked, units: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Optional[dict[str, Any]]: ...
    def annotate(self, questions: Spec, records: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[dict[str, Any]]: ...
    def recognize(self, text: str, ask: Optional[Spec] = ..., *, kinds: Union[Sequence[str], Mapping[str, str], None] = ..., relations: Optional[Mapping[str, tuple[str, str]]] = ..., either: Optional[Iterable[str]] = ..., threshold: Optional[float] = ..., relation_threshold: Optional[float] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Recognized: ...
    def relate(self, entities: Iterable[Pair], ask: Optional[Spec] = ..., *, relations: Optional[Mapping[str, tuple[str, str]]] = ..., either: Optional[Iterable[str]] = ..., threshold: Optional[float] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[Edge]: ...
    def usage(self) -> dict[str, int]: ...

def decide(question: Asked, text: str, *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Optional[bool]: ...
def decide_many(question: Asked, records: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[Optional[bool]]: ...
def choose(question: Asked, text: str, *, options: Union[Sequence[str], Mapping[str, Any], None] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Optional[str]: ...
def score(question: Asked, text: str, *, levels: Union[Sequence[str], Mapping[str, Any], None] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> float: ...
def tag(question: Asked, text: str, *, labels: Union[Sequence[str], Mapping[str, Any], None] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[str]: ...
def details(question: Asked, text: str, *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> dict[str, Any]: ...
def filter(question: Asked, records: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[str]: ...
def rank(question: Asked, records: Iterable[str], *, top: Optional[int] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[dict[str, Any]]: ...
def find(question: Asked, units: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Optional[dict[str, Any]]: ...
def annotate(questions: Spec, records: Iterable[str], *, deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[dict[str, Any]]: ...
def recognize(text: str, ask: Optional[Spec] = ..., *, kinds: Union[Sequence[str], Mapping[str, str], None] = ..., relations: Optional[Mapping[str, tuple[str, str]]] = ..., either: Optional[Iterable[str]] = ..., threshold: Optional[float] = ..., relation_threshold: Optional[float] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Recognized: ...
def relate(entities: Iterable[Pair], ask: Optional[Spec] = ..., *, relations: Optional[Mapping[str, tuple[str, str]]] = ..., either: Optional[Iterable[str]] = ..., threshold: Optional[float] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> list[Edge]: ...
def usage() -> dict[str, int]: ...
