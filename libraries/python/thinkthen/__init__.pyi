def recognize(text: Union[str, Frame], ask: Optional[Spec] = ..., *, kinds: Union[LabelSet, None] = ..., relations: Optional[Mapping[str, tuple[str, str]]] = ..., either: Optional[Iterable[str]] = ..., threshold: Optional[float] = ..., relation_threshold: Optional[float] = ..., on: Optional[str] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ..., descriptions: Optional[Mapping[str, Any]] = ...) -> Call[Union[Recognized, Frame]]: ...
def relate(entities: Iterable[Pair], ask: Optional[Spec] = ..., *, relations: Optional[Mapping[str, tuple[str, str]]] = ..., either: Optional[Iterable[str]] = ..., threshold: Optional[float] = ..., deadline: Deadline = ..., token: Optional[CancelToken] = ...) -> Call[list[Edge]]: ...
