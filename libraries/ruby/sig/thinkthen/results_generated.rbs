  type request_recognition_example = String | request_recognition_example_text
  type request_recognition_example_entity = { end: Integer, kind: String, start: Integer }
  type request_recognition_example_text = { entities: Array[request_recognition_example_entity], ?kinds: Array[String], text: String }
  type request_recognition_mode = String
  type request_recognition_seed_span = { end: Integer, ?kind: String, start: Integer }
  type request_recognition_stage_context = { ?boundary: String, ?kind_edge: String, ?relation: String }
  type request_request_batch = Integer | String
  type request_request_framing = String
  type request_request_image = { kind: String, ?media: request_image_media, path: String } | { bytes: String, kind: String, media: request_image_media }
  type request_request_threshold = Integer | Float | String
  type request_source_unit = String
end
