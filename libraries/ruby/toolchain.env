# The pinned Ruby toolchain (ticket 0112). setup-ruby.sh and check.sh read it.
RUBY_MINORS="3.4 4.0"
RUBY_34_VERSION=3.4.11
RUBY_34_SHA256=f79c6e789ce4f30f77c88a40b23b93e2547c512a843dc17db27ab1f5cc66f4e4
# https://www.ruby-lang.org/en/news/2026/09/15/ruby-4-0-7-released/
RUBY_40_VERSION=4.0.7
RUBY_40_SHA256=47ef59413f7a4587ba6a6b78b14036eb5e36eec2ec0b90964801e88d56a3d375
case ${THINKTHEN_RUBY_MINOR:-4.0} in
  3.4) RUBY_VERSION=$RUBY_34_VERSION; RUBY_SHA256=$RUBY_34_SHA256 ;;
  4.0) RUBY_VERSION=$RUBY_40_VERSION; RUBY_SHA256=$RUBY_40_SHA256 ;;
  *) echo "unsupported Ruby minor: $THINKTHEN_RUBY_MINOR" >&2; exit 2 ;;
esac
RUBY_URL=https://cache.ruby-lang.org/pub/ruby/${RUBY_VERSION%.*}/ruby-$RUBY_VERSION.tar.xz
YAML_URL=https://pyyaml.org/download/libyaml/yaml-0.2.5.tar.gz
YAML_SHA256=c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4
YAML_SHA512=dadd7d8e0d88b5ebab005e5d521d56d541580198aa497370966b98c904586e642a1cd4f3881094eb57624f218d50db77417bbfd0ffdce50340f011e35e8c4c02
# The same pinned Ruby and libyaml sources build for both macOS 15 chips.
RUBY_MACOS_DEPLOYMENT_TARGET=15.0
# Homebrew offers only its newest patch, and OpenSSL 3 keeps one ABI within a series.
RUBY_OPENSSL_SERIES=3.6
