# The pinned Ruby toolchain (ticket 0112). setup-ruby.sh and check.sh read it.
RUBY_VERSION=3.4.11
RUBY_URL=https://cache.ruby-lang.org/pub/ruby/3.4/ruby-3.4.11.tar.xz
RUBY_SHA256=f79c6e789ce4f30f77c88a40b23b93e2547c512a843dc17db27ab1f5cc66f4e4
YAML_URL=https://pyyaml.org/download/libyaml/yaml-0.2.5.tar.gz
YAML_SHA256=c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4
YAML_SHA512=dadd7d8e0d88b5ebab005e5d521d56d541580198aa497370966b98c904586e642a1cd4f3881094eb57624f218d50db77417bbfd0ffdce50340f011e35e8c4c02
# The same pinned Ruby and libyaml sources build for both macOS 15 chips.
RUBY_MACOS_DEPLOYMENT_TARGET=15.0
# Homebrew offers only its newest patch, and OpenSSL 3 keeps one ABI within a series.
RUBY_OPENSSL_SERIES=3.6
