# The pinned Ruby toolchain (ticket 0112). setup-ruby.sh and check.sh read it.
eval "$(python3 - <<'PINS'
import json
from pathlib import Path
root = next(path for path in (Path.cwd(), *Path.cwd().parents)
            if (path / 'sdlc/tools.json').is_file())
manifest = json.loads((root / 'sdlc/tools.json').read_text())
ruby = manifest['tools']['ruby']
ruby34 = manifest['tools']['ruby34']
print('RUBY_MINORS="3.4 4.0"')
print('RUBY_34_VERSION=' + ruby34['version'])
print('RUBY_40_VERSION=' + ruby['version'])
print('RUBY_OPENSSL_VERSION=' + ruby['openssl_version'])
print('RUBY_34_RBS_VERSION=' + manifest['tools']['rbs34']['version'])
print('RUBY_40_RBS_VERSION=' + manifest['tools']['rbs']['version'])
PINS
)"
case ${THINKTHEN_RUBY_MINOR:-4.0} in
  3.4) RUBY_VERSION=$RUBY_34_VERSION; RUBY_RBS_VERSION=$RUBY_34_RBS_VERSION ;;
  4.0) RUBY_VERSION=$RUBY_40_VERSION; RUBY_RBS_VERSION=$RUBY_40_RBS_VERSION ;;
  *) echo "unsupported Ruby minor: $THINKTHEN_RUBY_MINOR" >&2; exit 2 ;;
esac
RUBY_MACOS_DEPLOYMENT_TARGET=15.0

# Routine source checks need Ripper's keyword API and modern collection helpers.
# Select the prepared runtime before callers replace HOME, then retain it on PATH.
ruby_source_host() {
  source_ruby=$(command -v ruby) || { echo 'Ruby source lexer: resolve the ruby tool group' >&2; return 1; }
  "$source_ruby" --disable-gems -rripper -rjson -e \
    'Ripper.lex("class Probe; end", raise_errors: true); [].filter_map { |value| value }; JSON.generate({})' >/dev/null || {
      echo 'Ruby source lexer: prepare libraries/ruby/setup-ruby.sh; the selected Ruby lacks Ripper/JSON support' >&2
      return 1
    }
  printf '%s\n' "$source_ruby"
}
