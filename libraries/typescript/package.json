{
  "name": "thinkthen",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Semantic judgments over text for Node, through the thinkthen engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botassembly/thinkthen.git",
    "directory": "libraries/typescript"
  },
  "homepage": "https://thinkthen.dev",
  "bugs": "https://github.com/botassembly/thinkthen/issues",
  "keywords": ["classification", "llm", "text", "judgment"],
  "os": ["linux", "darwin"],
  "cpu": ["x64", "arm64"],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "loader.js",
    "LICENSE",
    "thinkthen-linux-x64.node",
    "thinkthen-linux-arm64.node",
    "thinkthen-darwin-x64.node",
    "thinkthen-darwin-arm64.node"
  ],
  "scripts": {
    "build": "./build-addon.sh",
    "test": "node --test --test-timeout=30000 tests/"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
