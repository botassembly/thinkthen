{
  "name": "thinkthen",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Semantic judgments over text for Node, through the thinkthen engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botassembly/thinkthen.git",
    "directory": "libraries/typescript"
  },
  "homepage": "https://thinkthen.dev",
  "bugs": "https://github.com/botassembly/thinkthen/issues",
  "keywords": [
    "classification",
    "llm",
    "text",
    "judgment"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "loader.js",
    "complete.js",
    "complete.d.ts",
    "_complete.js",
    "_complete.d.ts",
    "LICENSE",
    "native-platforms.json",
    "thinkthen-*.node",
    "native.js",
    "native.d.ts",
    "results_generated.js",
    "results_generated.d.ts"
  ],
  "scripts": {
    "build": "./build-addon.sh",
    "test": "node --test --test-timeout=30000 tests/"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "thinkthen": {
    "nativeTargets": "release",
    "nativeFile": "thinkthen-{platform}-{arch}.node"
  }
}
