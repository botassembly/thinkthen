<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.botassembly</groupId>
  <artifactId>thinkthen-jvm</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>
  <properties>
    <thinkthen.session.jdk>22</thinkthen.session.jdk>
    <thinkthen.kotlin.coroutines.version>1.8.0</thinkthen.kotlin.coroutines.version>
    <thinkthen.packages>door kotlin scala</thinkthen.packages>
    <thinkthen.package.files>pom.xml LICENSE README.md product-inventory.json</thinkthen.package.files>
    <thinkthen.package.exclude>*Caller*.class *Caller*.tasty</thinkthen.package.exclude>
    <thinkthen.native.targets>release</thinkthen.native.targets>
    <thinkthen.native.classifier>natives-{platform}-{arch}</thinkthen.native.classifier>
    <thinkthen.native.resource>META-INF/thinkthen/native/{target}/</thinkthen.native.resource>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId>
      <version>${thinkthen.kotlin.coroutines.version}</version><optional>true</optional>
    </dependency>
  </dependencies>
  <name>ThinkThen JVM binding</name>
  <description>Java binding for ThinkThen, with Kotlin and Scala callers as the kotlin and scala classifier JARs; install the matching native library separately</description>
  <url>https://thinkthen.dev</url>
  <licenses><license><name>MIT</name><url>https://opensource.org/license/mit</url></license></licenses>
  <developers><developer><name>Ian Maurer</name><organization>botassembly</organization><organizationUrl>https://github.com/botassembly</organizationUrl></developer></developers>
  <scm><url>https://github.com/botassembly/thinkthen</url><connection>scm:git:https://github.com/botassembly/thinkthen.git</connection></scm>
</project>
