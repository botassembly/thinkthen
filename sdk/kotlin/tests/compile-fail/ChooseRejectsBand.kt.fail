package consumer.rejected

import dev.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: ChooseRejectsBand. This expression must fail after the positive consumer compiles.
suspend fun rejectedChooseRejectsBand(client: ThinkThen) {
    client.choose("Which team?", "record", listOf("billing", "shipping"), threshold = Threshold.band(0.2, 0.8))
}
