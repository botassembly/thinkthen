package consumer.rejected

import dev.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: SingleRejectsArray. A one-record call refuses many records when the code is compiled.
suspend fun rejectedSingleRejectsArray(client: ThinkThen) {
// Expect: pass many records to chooseStream
    client.choose("Which team?", arrayOf("alpha", "beta"), listOf("billing", "support"))
}
