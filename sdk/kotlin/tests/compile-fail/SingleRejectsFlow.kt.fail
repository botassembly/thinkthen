package consumer.rejected

import dev.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: SingleRejectsFlow. A one-record call refuses many records when the code is compiled.
suspend fun rejectedSingleRejectsFlow(client: ThinkThen) {
// Expect: pass many records to findStream
    client.find("Which line?", flowOf("alpha", "beta"))
}
