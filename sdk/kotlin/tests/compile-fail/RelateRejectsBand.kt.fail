package consumer.rejected

import dev.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: RelateRejectsBand. This expression must fail after the positive consumer compiles.
suspend fun rejectedRelateRejectsBand(client: ThinkThen) {
    client.relate("record", listOf(RelationRule("PERSON", "ORG", "works_at")), threshold = Threshold.band(0.2, 0.8))
}
