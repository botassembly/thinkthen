package consumer.rejected

import io.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: RankRejectsSingleAsk. This expression must fail after the positive consumer compiles.
suspend fun rejectedRankRejectsSingleAsk(client: ThinkThen) {
    client.ask(Rank("Priority?", listOf("low", "high")), "record")
}
