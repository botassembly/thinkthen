package consumer.rejected

import io.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: FindRejectsBand. This expression must fail after the positive consumer compiles.
suspend fun rejectedFindRejectsBand(client: ThinkThen) {
    client.find("Which line?", "record", threshold = Threshold.band(0.2, 0.8))
}
