package consumer.rejected

import dev.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: SingleRejectsList. A one-record call refuses many records when the code is compiled.
suspend fun rejectedSingleRejectsList(client: ThinkThen) {
// Expect: pass many records to decideStream
    client.decide("Ready?", listOf("alpha", "beta"))
}
