package consumer.rejected

import io.thinkthen.kotlin.*
import kotlinx.coroutines.flow.flowOf

// Feature: RecognizeRejectsBand. This expression must fail after the positive consumer compiles.
suspend fun rejectedRecognizeRejectsBand(client: ThinkThen) {
    client.recognize("record", listOf("PERSON"), threshold = Threshold.band(0.2, 0.8))
}
