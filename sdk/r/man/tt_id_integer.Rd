\name{tt_id_integer}
\alias{tt_id_integer}
\title{Represent exact integer IDs}
\description{Admit decimal character spellings as exact signed or unsigned integer IDs without conversion through a floating point number.}
\usage{
tt_id_integer(x)
}
\arguments{
\item{x}{Decimal character spellings of integer IDs.}
}
\value{A \code{tt_id_integer} record vector. \code{format()} returns exact decimal text.}
\seealso{\code{\link{thinkthen-package}}}
