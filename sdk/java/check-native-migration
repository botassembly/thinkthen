#!/bin/sh
# Check the installed Java client and Kotlin wrapper with prepared native assets.
set -eu
cd "$(dirname "$0")/../.."
root=$PWD
. scripts/native-tools-env
native_assets=${1:?usage: sdk/java/check-native-migration PREPARED_JVM_NATIVE_DIRECTORY PREPARED_LOOPBACK}
export THINKTHEN_LOOPBACK=${2:?usage: sdk/java/check-native-migration PREPARED_JVM_NATIVE_DIRECTORY PREPARED_LOOPBACK}
unset THINKTHEN_API_KEY OPENAI_API_KEY THINKTHEN_BASE_URL THINKTHEN_BATCH CLASSPATH JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS
native_input="$native_assets/$jvm_platform/$jvm_library"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
python3 scripts/jvm_repository.py seed "$cache/m2" "$scratch/m2"
mkdir -p "$scratch/consumer" "$scratch/home"
export XDG_CACHE_HOME="$scratch/home/.cache"
resource="sdk/java/library/target/classes/io/thinkthen/native/$jvm_platform"
rm -rf sdk/java/library/target/classes sdk/kotlin/target/classes
mkdir -p "$resource"
cp "$native_input" "$resource/"
python3 scripts/jvm-generated
mvn -o -B -q -f sdk/java/pom.xml -Dmaven.repo.local="$scratch/m2" install -DskipTests
version=$(python3 scripts/release_metadata.py --version)
java_jar="$scratch/m2/io/github/botassembly/thinkthen-java/$version/thinkthen-java-$version.jar"
kotlin_jar="$scratch/m2/io/github/botassembly/thinkthen-kotlin/$version/thinkthen-kotlin-$version.jar"
classpath="$java_jar:$kotlin_jar"
for dependency in $(rg --files "$scratch/m2" | rg '/(jackson-[^/]+|jspecify|kotlin-stdlib|kotlinx-coroutines-core-jvm|annotations)/[^/]+/[^/]+\.jar$'); do classpath="$classpath:$dependency"; done
printf '%s' "$classpath" > "$scratch/classpath"
python3 scripts/jvm_repository.py verify "$root" "$scratch/classpath" sdk/java/library/target/classes/io/thinkthen/native "$jvm_platform" "$native_input"
python3 scripts/jvm_repository.py consumer "$root" "$scratch/consumer-project"
cd "$scratch/consumer-project"
mvn -o -B -q -Dmaven.repo.local="$scratch/m2" package dependency:build-classpath -Dmdep.outputFile="$scratch/consumer-classpath"
classpath="target/classes:$(cat "$scratch/consumer-classpath")"
java() { command "$JAVA_HOME/bin/java" --enable-native-access=ALL-UNNAMED "-Duser.home=$scratch/home" -cp "$classpath" "$@"; }
if [ "${3:-}" = --entry-forms ]; then
    set +e
    java ConformanceCases "$root/conformance/typed" --entry-forms
    java_status=$?
    java consumer.ConformanceCasesKt "$root/conformance/typed" --entry-forms
    kotlin_status=$?
    test "$java_status" -eq 0 && test "$kotlin_status" -eq 0
    exit $?
fi
if [ "${3:-}" = --malformed-only ] || [ "${3:-}" = --with-abi ]; then
    python3 "$root/sdk/kotlin/tests/abi.py" "$THINKTHEN_NATIVE_FIXTURES/manifest.json" "$classpath" "$JAVA_HOME/bin/java" "$jvm_platform" "$jvm_library" "$scratch"
    if [ "${3:-}" = --malformed-only ]; then exit 0; fi
fi
java JavaCacheCases
java JavaConcurrencyCases
java consumer.SdkConventionCasesKt
"$root/sdk/java/check-packaging"
if [ "${3:-}" = --conventions-only ]; then
    java JavaSettingsCases "$root/schemas/contract.json"
    java consumer.FlowCasesKt "$root/conformance/typed"
    java consumer.AbiAndCodesKt registry "$root/schemas/contract.json"
    printf '%s\n' 'Installed JVM convention checks passed'
    exit 0
fi
java JavaApiCases
java ConsumerCases "$root/construction/stub.json"
java OptionCases "$root/construction/options.json"
java JavaSettingsCases "$root/schemas/contract.json"
java JavaOwnershipCases "$root/conformance"
java ConformanceCases "$root/conformance/typed"
java KotlinCasesKt "$root/construction/stub.json"
java consumer.ConformanceCasesKt "$root/conformance/typed"
java consumer.SurfaceCasesKt "$root/conformance"
java consumer.FlowCasesKt "$root/conformance/typed"
java consumer.AbiAndCodesKt registry "$root/schemas/contract.json"
printf '%s\n' 'Installed Java and Kotlin consumers passed with prepared native assets'
