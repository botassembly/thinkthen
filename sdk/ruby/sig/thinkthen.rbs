module ThinkThen
  VERSION: String
  type backend = :systemone | :openai | :stub
  type function = :decide | :choose | :tag | :score | :filter | :rank | :find | :recognize | :relate | :annotate
  type piece_tag = "BEGIN" | "END" | "INSIDE" | "OUT" | "SINGLE"
  type status = :answered | :unsure | :failed
  type json = nil | bool | Integer | Float | String | Symbol | Array[json] | Hash[String | Symbol, json]
  type field = String | Array[String | Symbol | Integer]
  type threshold = Float | Range[Float]
  type annotation_question = DecideQuestion | ChooseQuestion | TagQuestion | ScoreQuestion | FindQuestion | RecognizeQuestion | RelateQuestion
  type toolbox_question = annotation_question | FilterQuestion | RankQuestion
  module Error
    attr_reader code: error_code
    attr_reader http_status: Integer?
    def initialize: (?String?, code: error_code, ?http_status: Integer?) -> void
  end
  module NoAnswerError
  end
  class LibraryError < StandardError
    include Error
  end
  class UnknownCodeError < LibraryError
    attr_reader raw_code: Integer
    attr_reader raw_name: String?
    def initialize: (?String?, raw_code: Integer, ?raw_name: String?, ?http_status: Integer?) -> void
  end
  class UsageError < ArgumentError
    include Error
  end
  class SetupError < LibraryError
  end
  class CancelledError < LibraryError
  end
  class InternalError < LibraryError
  end
  class UnsureError < StandardError
    include NoAnswerError
    attr_reader row: Result
    attr_reader probability: Float?
    def initialize: (Result) -> void
  end
  class FailedError < LibraryError
    include NoAnswerError
    attr_reader rows: Array[Result]
    def initialize: (?String?, code: error_code, ?http_status: Integer?, ?rows: Array[Result]) -> void
  end
  class Result
    attr_reader function: function
    attr_reader status: status
    attr_reader probability: Float?
    attr_reader error: RowError?
    attr_reader position: Integer
    attr_reader id: String | Integer | nil
    attr_reader source: Source
    attr_reader detail: untyped
    attr_reader item: untyped
    def answered?: () -> bool
    def unsure?: () -> bool
    def failed?: () -> bool
    def id_present?: () -> bool
    def answer: () -> untyped
    def raise_if_failed: () -> self
    def ==: (untyped) -> bool
    def eql?: (untyped) -> bool
    def hash: () -> Integer
    def to_s: () -> String
    def inspect: () -> String
    def to_h: () -> Hash[String, json]
    def to_json: (*untyped) -> String
  end
  class DecideRow < Result
    def answer: () -> (bool)
    def yes?: () -> bool
  end
  class ChooseRow < Result
    def answer: () -> (String | Symbol)
  end
  class TagRow < Result
    def answer: () -> (Array[String | Symbol])
  end
  class ScoreRow < Result
    def answer: () -> (Float)
  end
  class RankRow < Result
    def answer: () -> (Integer)
  end
  class FindRow < Result
    def answer: () -> (Span?)
  end
  class RecognizeRow < Result
    def answer: () -> (Array[Name])
  end
  class RelateRow < Result
    def answer: () -> (Array[Relation])
  end
  class AnnotateRow < Result
    def answer: () -> (AnnotationAnswers)
  end
  class Source < Data
    include WireValue
    attr_reader question_identity: String
    attr_reader backend: backend
    attr_reader model: String
    attr_reader name: String?
    def to_h: () -> Hash[String, json]
    def self.new: (question_identity: String, backend: backend, model: String, ?name: String?) -> Source
  end
  class RowError < FailedError
    def to_json: (*untyped) -> String
    attr_reader code: error_code
    attr_reader message: String
    attr_reader http_status: Integer?
    attr_reader raw_code: Integer?
    attr_reader raw_name: String?
    def self.new: (code: error_code, message: String, ?http_status: Integer?, ?raw_code: Integer?, ?raw_name: String?) -> RowError
    def to_h: () -> Hash[String, json]
  end
  class RelationRule < Data
    include WireValue
    attr_reader source: String
    attr_reader target: String
    attr_reader relation: String
    attr_reader reads: String?
    attr_reader either: bool
    def self.new: (source: String, target: String, relation: String, ?reads: String?, ?either: bool) -> RelationRule
    def to_h: () -> Hash[String, json]
  end
  class RetryPolicy < Data
    include WireValue
    attr_reader max_retries: Integer?
    attr_reader initial_backoff: Float?
    attr_reader attempt_timeout: Float?
    def self.new: (?max_retries: Integer?, ?initial_backoff: Float?, ?attempt_timeout: Float?) -> RetryPolicy
    def to_h: () -> Hash[String, json]
  end
  class LabelDetail < Data
    include WireValue
    attr_reader labels: Hash[String, Float]
    def to_h: () -> Hash[String, json]
    def self.new: (labels: Hash[String, Float]) -> LabelDetail
  end
  class LevelDetail < Data
    include WireValue
    attr_reader levels: Array[Float]
    def to_h: () -> Hash[String, json]
    def self.new: (levels: Array[Float]) -> LevelDetail
  end
  class Span < Data
    include WireValue
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer) -> Span
  end
  class Name < Data
    include WireValue
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader kind: String
    attr_reader probability: Float?
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, kind: String, ?probability: Float?) -> Name
  end
  class RelationName < Data
    include WireValue
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader kind: String
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, kind: String) -> RelationName
  end
  class Relation < Data
    include WireValue
    attr_reader source: RelationName
    attr_reader target: RelationName
    attr_reader relation: String
    attr_reader probability: Float?
    attr_reader either: bool?
    def to_h: () -> Hash[String, json]
    def self.new: (source: RelationName, target: RelationName, relation: String, ?probability: Float?, ?either: bool?) -> Relation
  end
  class RelationDetail < Data
    include WireValue
    attr_reader names: Array[Name]
    attr_reader pairs: Array[Relation]
    def to_h: () -> Hash[String, json]
    def self.new: (names: Array[Name], pairs: Array[Relation]) -> RelationDetail
  end
  class PieceDetail < Data
    include WireValue
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader tags: Hash[piece_tag, Float]
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, tags: Hash[piece_tag, Float]) -> PieceDetail
  end
  class KindDetail < Data
    include WireValue
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader kinds: Hash[String, Float]
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, kinds: Hash[String, Float]) -> KindDetail
  end
  class RecognizeDetail < Data
    include WireValue
    attr_reader pieces: Array[PieceDetail]
    attr_reader names: Array[KindDetail]
    def to_h: () -> Hash[String, json]
    def self.new: (pieces: Array[PieceDetail], names: Array[KindDetail]) -> RecognizeDetail
  end
  class Cancel
    def initialize: () -> void
    def cancel: () -> nil
    def cancelled?: () -> bool
  end
  class Rows[R] < Enumerator[R, void]
    def close: () -> nil
    def closed?: () -> bool
    def cancel: () -> nil
    def initialize: (untyped, String, untyped, Cancel?, Question) -> void
    private
    def produce: (Enumerator::Yielder) -> void
    def pull: () -> untyped
    def release: () -> void
    def drive: () -> untyped
    def blocking_next: (untyped) -> untyped
    def supply_input: () -> untyped
  end
  class AnnotationAnswers < Hash[String, Result]
    def []: (String | Symbol) -> untyped
    def fetch: (String | Symbol) -> untyped
  end
  class Question
  end
  class Toolbox
    attr_reader questions: Hash[String, toolbox_question]
    def self.load_file: (String) -> Toolbox
    def self.from_json: (String) -> Toolbox
    def to_json: (*untyped) -> String
    def initialize: (questions: Hash[String | Symbol, toolbox_question]) -> void
    def decide: (String | Symbol) -> DecideQuestion
    def choose: (String | Symbol) -> ChooseQuestion
    def tag: (String | Symbol) -> TagQuestion
    def score: (String | Symbol) -> ScoreQuestion
    def rank: (String | Symbol) -> RankQuestion
    def find: (String | Symbol) -> FindQuestion
    def recognize: (String | Symbol) -> RecognizeQuestion
    def relate: (String | Symbol) -> RelateQuestion
    def filter: (String | Symbol) -> FilterQuestion
  end
  class AnnotationQuestions < Toolbox
    def initialize: (**annotation_question) -> void
  end
  class RedactedKey
  end
  class Configuration
    attr_accessor backend: backend?
    attr_accessor model: String?
    attr_accessor url: String?
    attr_accessor batch: Integer?
    attr_accessor max_requests: Integer?
    attr_accessor retry: RetryPolicy?
    attr_reader api_key: RedactedKey?
    def api_key=: (String | RedactedKey | nil) -> (String | RedactedKey | nil)
  end
  def self.configure: () { (Configuration) -> void } -> nil
  def self.client: () -> Client
  def self.close: () -> nil
  type decide_result = DecideRow
  class DecideQuestion < Question
    def initialize: (String, ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?) -> void
  end
  type choose_result = ChooseRow
  class ChooseQuestion < Question
    def initialize: (String, choices: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?) -> void
  end
  type tag_result = TagRow
  class TagQuestion < Question
    def initialize: (String, labels: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?) -> void
  end
  type score_result = ScoreRow
  class ScoreQuestion < Question
    def initialize: (String, levels: Array[String | Symbol], ?field: field?, ?descriptions: Hash[String | Symbol, String]?) -> void
  end
  class FilterQuestion < Question
    def initialize: (String, ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?) -> void
  end
  type rank_result = RankRow
  class RankQuestion < Question
    def initialize: (String, levels: Array[String | Symbol], ?top: Integer?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?) -> void
  end
  type find_result = FindRow
  class FindQuestion < Question
    def initialize: (String, ?threshold: Float?, ?field: field?) -> void
  end
  type recognize_result = RecognizeRow
  class RecognizeQuestion < Question
    def initialize: (kinds: Array[String | Symbol], ?threshold: Float?, ?field: field?) -> void
  end
  type relate_result = RelateRow
  class RelateQuestion < Question
    def initialize: (rules: Array[RelationRule], ?threshold: Float?, ?field: field?) -> void
  end
  type annotate_result = AnnotateRow
  class AnnotateQuestion < Question
    def initialize: (AnnotationQuestions | Toolbox | Hash[String | Symbol, annotation_question], ?field: field?) -> void
  end
  class TokenUsage < Data
    attr_reader reported: Integer?
    attr_reader unknown_attempts: Integer
    def self.new: (reported: Integer?, unknown_attempts: Integer) -> TokenUsage
  end
  class Usage < Data
    attr_reader attempts: Integer
    attr_reader responses: Integer
    attr_reader status_retries: Integer
    attr_reader connection_retries: Integer
    attr_reader request_body_bytes: Integer
    attr_reader active_attempts: Integer
    attr_reader active_calls: Integer
    attr_reader input_tokens: TokenUsage
    attr_reader output_tokens: TokenUsage
    def self.new: (attempts: Integer, responses: Integer, status_retries: Integer, connection_retries: Integer, request_body_bytes: Integer, active_attempts: Integer, active_calls: Integer, input_tokens: TokenUsage, output_tokens: TokenUsage) -> Usage
  end
  class Client
    def usage: () -> Usage
    def initialize: (?backend: backend?, ?model: String?, ?url: String?, ?api_key: String | RedactedKey | nil, ?batch: Integer?, ?max_requests: Integer?, ?retry: RetryPolicy?) -> void
    def self.open: (**untyped) -> Client
                       | [R] (?backend: backend?, ?model: String?, ?url: String?, ?api_key: String | RedactedKey | nil, ?batch: Integer?, ?max_requests: Integer?, ?retry: RetryPolicy?) { (Client) -> R } -> R
    def close: () -> nil
    def closed?: () -> bool
    attr_reader api_key: RedactedKey?
    def decide: (String, untyped, ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?, ?name: String?, ?cancel: Cancel?) -> decide_result
      | (DecideQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> decide_result
    def decide_each: (String, Enumerable[untyped], ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?, ?name: String?, ?cancel: Cancel?) -> Rows[decide_result]
      | (DecideQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[decide_result]
      | (String, Enumerable[untyped], ?threshold: threshold?, ?field: field?, ?name: String?, ?cancel: Cancel?) { (decide_result) -> void } -> nil
      | (DecideQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (decide_result) -> void } -> nil
    def choose: (String, untyped, choices: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> choose_result
      | (ChooseQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> choose_result
    def choose_each: (String, Enumerable[untyped], choices: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> Rows[choose_result]
      | (ChooseQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[choose_result]
      | (String, Enumerable[untyped], choices: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) { (choose_result) -> void } -> nil
      | (ChooseQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (choose_result) -> void } -> nil
    def tag: (String, untyped, labels: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> tag_result
      | (TagQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> tag_result
    def tag_each: (String, Enumerable[untyped], labels: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> Rows[tag_result]
      | (TagQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[tag_result]
      | (String, Enumerable[untyped], labels: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) { (tag_result) -> void } -> nil
      | (TagQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (tag_result) -> void } -> nil
    def score: (String, untyped, levels: Array[String | Symbol], ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> score_result
      | (ScoreQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> score_result
    def score_each: (String, Enumerable[untyped], levels: Array[String | Symbol], ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> Rows[score_result]
      | (ScoreQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[score_result]
      | (String, Enumerable[untyped], levels: Array[String | Symbol], ?field: field?, ?name: String?, ?cancel: Cancel?) { (score_result) -> void } -> nil
      | (ScoreQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (score_result) -> void } -> nil
    def filter: (String, Enumerable[untyped], ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?, ?name: String?, ?cancel: Cancel?) -> Enumerator[untyped, void]
      | (FilterQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Enumerator[untyped, void]
      | (String, Enumerable[untyped], ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?, ?name: String?, ?cancel: Cancel?) { (untyped) -> void } -> nil
      | (FilterQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (untyped) -> void } -> nil
    def rank: (String, Enumerable[untyped], levels: Array[String | Symbol], ?top: Integer?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> Rows[RankRow]
      | (RankQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[RankRow]
      | (String, Enumerable[untyped], levels: Array[String | Symbol], ?top: Integer?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) { (RankRow) -> void } -> nil
      | (RankQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (RankRow) -> void } -> nil
    def find: (String, untyped, ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) -> find_result
      | (FindQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> find_result
    def find_each: (String, Enumerable[untyped], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) -> Rows[find_result]
      | (FindQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[find_result]
      | (String, Enumerable[untyped], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) { (find_result) -> void } -> nil
      | (FindQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (find_result) -> void } -> nil
    def recognize: (untyped, kinds: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) -> recognize_result
    def recognize_each: (Enumerable[untyped], kinds: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) -> Rows[recognize_result]
      | (Enumerable[untyped], kinds: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) { (recognize_result) -> void } -> nil
    def relate: (untyped, rules: Array[RelationRule], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) -> relate_result
    def relate_each: (Enumerable[untyped], rules: Array[RelationRule], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) -> Rows[relate_result]
      | (Enumerable[untyped], rules: Array[RelationRule], ?threshold: Float?, ?field: field?, ?name: String?, ?cancel: Cancel?) { (relate_result) -> void } -> nil
    def annotate: (AnnotationQuestions | Toolbox | Hash[String | Symbol, annotation_question], untyped, ?field: field?, ?name: String?, ?cancel: Cancel?) -> annotate_result
      | (AnnotateQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> annotate_result
    def annotate_each: (AnnotationQuestions | Toolbox | Hash[String | Symbol, annotation_question], Enumerable[untyped], ?field: field?, ?name: String?, ?cancel: Cancel?) -> Rows[annotate_result]
      | (AnnotateQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[annotate_result]
      | (AnnotationQuestions | Toolbox | Hash[String | Symbol, annotation_question], Enumerable[untyped], ?field: field?, ?name: String?, ?cancel: Cancel?) { (annotate_result) -> void } -> nil
      | (AnnotateQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) { (annotate_result) -> void } -> nil
  end
  def self.decide: (String, untyped, ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?, ?name: String?, ?cancel: Cancel?) -> decide_result
      | (DecideQuestion, untyped, ?name: String?, ?cancel: Cancel?) -> decide_result
  def self.decide_each: (String, Enumerable[untyped], ?threshold: threshold?, ?field: field?, ?yes_means: String?, ?no_means: String?, ?name: String?, ?cancel: Cancel?) -> Rows[decide_result]
