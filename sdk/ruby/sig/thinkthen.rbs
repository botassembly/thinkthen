module ThinkThen
  VERSION: String
  type backend = :systemone | :openai | :stub
  type function = :decide | :choose | :tag | :score | :filter | :rank | :find | :recognize | :relate | :annotate
  type piece_tag = "BEGIN" | "END" | "INSIDE" | "OUT" | "SINGLE"
  type status = :answered | :unsure | :failed
  type json = nil | bool | Integer | Float | String | Array[json] | Hash[String, json]
  type evidence = String | Array[String | Symbol | Integer]
  type threshold = Float | Range[Float]
  type annotation_question = DecideQuestion | ChooseQuestion | TagQuestion | ScoreQuestion | FilterQuestion | FindQuestion | RecognizeQuestion | RelateQuestion
  type toolbox_question = annotation_question | RankQuestion
  type annotation_entry = AnnotationAnswered[:decide, bool, nil]
    | AnnotationUnsure[:decide, nil]
    | AnnotationFailed[:decide]
    | AnnotationAnswered[:choose, String, LabelDetail]
    | AnnotationUnsure[:choose, LabelDetail]
    | AnnotationFailed[:choose]
    | AnnotationAnswered[:tag, Array[String], LabelDetail]
    | AnnotationUnsure[:tag, LabelDetail]
    | AnnotationFailed[:tag]
    | AnnotationAnswered[:score, Float, LevelDetail]
    | AnnotationUnsure[:score, LevelDetail]
    | AnnotationFailed[:score]
    | AnnotationAnswered[:filter, bool, nil]
    | AnnotationUnsure[:filter, nil]
    | AnnotationFailed[:filter]
    | AnnotationAnswered[:find, Found?, nil]
    | AnnotationUnsure[:find, nil]
    | AnnotationFailed[:find]
    | AnnotationAnswered[:recognize, Array[Name], RecognizeDetail]
    | AnnotationUnsure[:recognize, RecognizeDetail]
    | AnnotationFailed[:recognize]
    | AnnotationAnswered[:relate, Array[Relation], RelationDetail]
    | AnnotationUnsure[:relate, RelationDetail]
    | AnnotationFailed[:relate]
  class Error < StandardError
    attr_reader code: error_code
    attr_reader http_status: Integer?
    def initialize: (?String?, code: error_code, ?http_status: Integer?) -> void
  end
  class UnknownCodeError < Error
    attr_reader raw_code: Integer
    attr_reader raw_name: String?
    def initialize: (?String?, raw_code: Integer, ?raw_name: String?, ?http_status: Integer?) -> void
  end
  class UsageError < Error
  end
  class BackendError < Error
  end
  class Cancelled < Error
  end
  class LocalError < Error
  end
  class InternalError < Error
  end
  interface _HasStatus
    def status: () -> status
  end
  module RowPredicates : _HasStatus
    def answered?: () -> bool
    def unsure?: () -> bool
    def failed?: () -> bool
  end
  class Answered[A, D] < Data
    include RowPredicates
    attr_reader function: function
    attr_reader status: status
    def to_h: () -> Hash[String, json]
    attr_reader position: Integer
    attr_reader id: String | Integer | nil
    attr_reader id_present: bool
    def id_present?: () -> bool
    attr_reader source: Source
    attr_reader answer: A
    attr_reader probability: Float?
    attr_reader detail: D?
  end
  class AnnotationAnswered[F, A, D] < Data
    include RowPredicates
    attr_reader function: F
    attr_reader status: status
    def to_h: () -> Hash[String, json]
    attr_reader answer: A
    attr_reader probability: Float?
    attr_reader detail: D?
  end
  class Unsure[D] < Data
    include RowPredicates
    attr_reader function: function
    attr_reader status: status
    def to_h: () -> Hash[String, json]
    attr_reader position: Integer
    attr_reader id: String | Integer | nil
    attr_reader id_present: bool
    def id_present?: () -> bool
    attr_reader source: Source
    attr_reader probability: Float?
    attr_reader detail: D?
  end
  class AnnotationUnsure[F, D] < Data
    include RowPredicates
    attr_reader function: F
    attr_reader status: status
    def to_h: () -> Hash[String, json]
    attr_reader probability: Float?
    attr_reader detail: D?
  end
  class Failed < Data
    include RowPredicates
    attr_reader function: function
    attr_reader status: status
    def to_h: () -> Hash[String, json]
    attr_reader position: Integer
    attr_reader id: String | Integer | nil
    attr_reader id_present: bool
    def id_present?: () -> bool
    attr_reader source: Source
    attr_reader error: RowError
  end
  class AnnotationFailed[F] < Data
    include RowPredicates
    attr_reader function: F
    attr_reader status: status
    def to_h: () -> Hash[String, json]
    attr_reader error: RowError
  end
  class Source < Data
    attr_reader question_identity: String
    attr_reader backend: backend
    attr_reader model: String
    attr_reader name: String?
    def to_h: () -> Hash[String, json]
    def self.new: (question_identity: String, backend: backend, model: String, ?name: String?) -> Source
  end
  class RowError < Data
    attr_reader code: error_code
    attr_reader message: String
    attr_reader http_status: Integer?
    attr_reader raw_code: Integer?
    attr_reader raw_name: String?
    def self.new: (code: error_code, message: String, ?http_status: Integer?, ?raw_code: Integer?, ?raw_name: String?) -> RowError
    def to_h: () -> Hash[String, json]
  end
  class RelationRule < Data
    attr_reader source: String
    attr_reader target: String
    attr_reader relation: String
    attr_reader phrase: String?
    attr_reader symmetric: bool
    def self.new: (source: String, target: String, relation: String, ?phrase: String?, ?symmetric: bool) -> RelationRule
    def to_h: () -> Hash[String, json]
  end
  class Retry < Data
    attr_reader max_retries: Integer?
    attr_reader initial_backoff_ms: Integer?
    attr_reader attempt_timeout_ms: Integer?
    def self.new: (?max_retries: Integer?, ?initial_backoff_ms: Integer?, ?attempt_timeout_ms: Integer?) -> Retry
    def to_h: () -> Hash[String, json]
  end
  class LabelDetail < Data
    attr_reader labels: Hash[String, Float]
    def to_h: () -> Hash[String, json]
    def self.new: (labels: Hash[String, Float]) -> LabelDetail
  end
  class LevelDetail < Data
    attr_reader levels: Array[Float]
    def to_h: () -> Hash[String, json]
    def self.new: (levels: Array[Float]) -> LevelDetail
  end
  class Found < Data
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer) -> Found
  end
  class Name < Data
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader kind: String
    attr_reader probability: Float?
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, kind: String, ?probability: Float?) -> Name
  end
  class RelationName < Data
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader kind: String
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, kind: String) -> RelationName
  end
  class Relation < Data
    include WireValue
    attr_reader source: RelationName
    attr_reader target: RelationName
    attr_reader relation: String
    attr_reader probability: Float?
    attr_reader symmetric: bool?
    def to_h: () -> Hash[String, json]
    def self.new: (source: RelationName, target: RelationName, relation: String, ?probability: Float?, ?symmetric: bool?) -> Relation
  end
  class RelationDetail < Data
    attr_reader names: Array[Name]
    attr_reader pairs: Array[Relation]
    def to_h: () -> Hash[String, json]
    def self.new: (names: Array[Name], pairs: Array[Relation]) -> RelationDetail
  end
  class PieceDetail < Data
    attr_reader text: String
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader tags: Hash[piece_tag, Float]
    def to_h: () -> Hash[String, json]
    def self.new: (text: String, start: Integer, end: Integer, tags: Hash[piece_tag, Float]) -> PieceDetail
  end
  class KindDetail < Data
    attr_reader start: Integer
    attr_reader end: Integer
    attr_reader kinds: Hash[String, Float]
    def to_h: () -> Hash[String, json]
    def self.new: (start: Integer, end: Integer, kinds: Hash[String, Float]) -> KindDetail
  end
  class RecognizeDetail < Data
    attr_reader pieces: Array[PieceDetail]
    attr_reader names: Array[KindDetail]
    def to_h: () -> Hash[String, json]
    def self.new: (pieces: Array[PieceDetail], names: Array[KindDetail]) -> RecognizeDetail
  end
  class FilterRow < Data
    include RowPredicates
    attr_reader item: json
    attr_reader row: filter_result
    def kept?: () -> bool
    def position: () -> Integer
    def id: () -> (String | Integer | nil)
    def id_present?: () -> bool
    def function: () -> function
    def status: () -> status
    def source: () -> Source
    def self.new: (item: json, row: filter_result) -> FilterRow
  end
  class CancelToken
    def initialize: () -> void
    def cancel: () -> nil
    def cancelled?: () -> bool
  end
  class Rows[R] < Enumerator[R, void]
    def close: () -> nil
    def closed?: () -> bool
    def cancel: () -> nil
    def initialize: (untyped, String, untyped, CancelToken?, bool) -> void
    private
    def produce: (Enumerator::Yielder) -> void
    def pull: () -> untyped
    def drive: () -> untyped
    def blocking_next: (untyped) -> untyped
    def supply_input: () -> untyped
  end
  class Question
  end
  class Toolbox
    def self.from_json: (String) -> Toolbox
    def to_json: (*untyped) -> String
    def initialize: (questions: Hash[String, toolbox_question]) -> void
    def []: (String) -> toolbox_question
  end
  class AnnotationQuestions < Toolbox
    def initialize: (questions: Hash[String, annotation_question]) -> void
  end
  class RedactedKey
  end
  class Configuration
    attr_accessor backend: backend?
    attr_accessor model: String?
    attr_accessor url: String?
    attr_accessor batch: Integer?
    attr_accessor retry: Retry?
    attr_reader api_key: RedactedKey?
    def api_key=: (String | RedactedKey | nil) -> (String | RedactedKey | nil)
  end
  def self.configure: () { (Configuration) -> void } -> nil
  def self.client: () -> Client
  def self.close: () -> nil
  type decide_result = Answered[bool, nil] | Unsure[nil] | Failed
  class DecideQuestion < Question
    def initialize: (String, ?threshold: threshold?, ?evidence: evidence?) -> void
  end
  type choose_result = Answered[String, LabelDetail] | Unsure[LabelDetail] | Failed
  class ChooseQuestion < Question
    def initialize: (String, choices: Array[String], ?threshold: threshold?, ?evidence: evidence?) -> void
  end
  type tag_result = Answered[Array[String], LabelDetail] | Unsure[LabelDetail] | Failed
  class TagQuestion < Question
    def initialize: (String, labels: Array[String], ?threshold: Float?, ?evidence: evidence?) -> void
  end
  type score_result = Answered[Float, LevelDetail] | Unsure[LevelDetail] | Failed
  class ScoreQuestion < Question
    def initialize: (String, levels: Array[String], ?evidence: evidence?) -> void
  end
  type filter_result = Answered[bool, nil] | Unsure[nil] | Failed
  class FilterQuestion < Question
    def initialize: (String, ?threshold: threshold?, ?evidence: evidence?) -> void
  end
  type rank_result = Answered[Integer, LevelDetail] | Unsure[LevelDetail] | Failed
  class RankQuestion < Question
    def initialize: (String, levels: Array[String], ?top: Integer?, ?evidence: evidence?) -> void
  end
  type find_result = Answered[Found?, nil] | Unsure[nil] | Failed
  class FindQuestion < Question
    def initialize: (String, ?threshold: Float?, ?evidence: evidence?) -> void
  end
  type recognize_result = Answered[Array[Name], RecognizeDetail] | Unsure[RecognizeDetail] | Failed
  class RecognizeQuestion < Question
    def initialize: (kinds: Array[String], ?threshold: Float?, ?evidence: evidence?) -> void
  end
  type relate_result = Answered[Array[Relation], RelationDetail] | Unsure[RelationDetail] | Failed
  class RelateQuestion < Question
    def initialize: (rules: Array[RelationRule], ?threshold: Float?, ?evidence: evidence?) -> void
  end
  type annotate_result = Answered[Hash[String, annotation_entry], nil] | Unsure[nil] | Failed
  class AnnotateQuestion < Question
    def initialize: (AnnotationQuestions, ?evidence: evidence?) -> void
  end
  class Client
    def initialize: (?backend: backend?, ?model: String?, ?url: String?, ?api_key: String | RedactedKey | nil, ?batch: Integer?, ?retry: Retry?) -> void
    def self.open: [R] (?backend: backend?, ?model: String?, ?url: String?, ?api_key: String | RedactedKey | nil, ?batch: Integer?, ?retry: Retry?) { (Client) -> R } -> R
    def close: () -> nil
    def closed?: () -> bool
    attr_reader api_key: RedactedKey?
    def decide: (String, json, ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> decide_result
      | (DecideQuestion, json, ?name: String?, ?cancel: CancelToken?) -> decide_result
    def decide_each: (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[decide_result]
      | (DecideQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[decide_result]
      | (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (decide_result) -> void } -> nil
      | (DecideQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (decide_result) -> void } -> nil
    def choose: (String, json, choices: Array[String], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> choose_result
      | (ChooseQuestion, json, ?name: String?, ?cancel: CancelToken?) -> choose_result
    def choose_each: (String, Enumerable[json], choices: Array[String], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[choose_result]
      | (ChooseQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[choose_result]
      | (String, Enumerable[json], choices: Array[String], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (choose_result) -> void } -> nil
      | (ChooseQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (choose_result) -> void } -> nil
    def tag: (String, json, labels: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> tag_result
      | (TagQuestion, json, ?name: String?, ?cancel: CancelToken?) -> tag_result
    def tag_each: (String, Enumerable[json], labels: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[tag_result]
      | (TagQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[tag_result]
      | (String, Enumerable[json], labels: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (tag_result) -> void } -> nil
      | (TagQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (tag_result) -> void } -> nil
    def score: (String, json, levels: Array[String], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> score_result
      | (ScoreQuestion, json, ?name: String?, ?cancel: CancelToken?) -> score_result
    def score_each: (String, Enumerable[json], levels: Array[String], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[score_result]
      | (ScoreQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[score_result]
      | (String, Enumerable[json], levels: Array[String], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (score_result) -> void } -> nil
      | (ScoreQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (score_result) -> void } -> nil
    def filter: (String, json, ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> FilterRow
      | (FilterQuestion, json, ?name: String?, ?cancel: CancelToken?) -> FilterRow
    def filter_each: (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[FilterRow]
      | (FilterQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[FilterRow]
      | (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (FilterRow) -> void } -> nil
      | (FilterQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (FilterRow) -> void } -> nil
    def rank: (String, json, levels: Array[String], ?top: Integer?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> rank_result
      | (RankQuestion, json, ?name: String?, ?cancel: CancelToken?) -> rank_result
    def rank_each: (String, Enumerable[json], levels: Array[String], ?top: Integer?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[rank_result]
      | (RankQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[rank_result]
      | (String, Enumerable[json], levels: Array[String], ?top: Integer?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (rank_result) -> void } -> nil
      | (RankQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (rank_result) -> void } -> nil
    def find: (String, json, ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> find_result
      | (FindQuestion, json, ?name: String?, ?cancel: CancelToken?) -> find_result
    def find_each: (String, Enumerable[json], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[find_result]
      | (FindQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[find_result]
      | (String, Enumerable[json], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (find_result) -> void } -> nil
      | (FindQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (find_result) -> void } -> nil
    def recognize: (json, kinds: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> recognize_result
      | (RecognizeQuestion, json, ?name: String?, ?cancel: CancelToken?) -> recognize_result
    def recognize_each: (Enumerable[json], kinds: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[recognize_result]
      | (RecognizeQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[recognize_result]
      | (Enumerable[json], kinds: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (recognize_result) -> void } -> nil
      | (RecognizeQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (recognize_result) -> void } -> nil
    def relate: (json, rules: Array[RelationRule], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> relate_result
      | (RelateQuestion, json, ?name: String?, ?cancel: CancelToken?) -> relate_result
    def relate_each: (Enumerable[json], rules: Array[RelationRule], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[relate_result]
      | (RelateQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[relate_result]
      | (Enumerable[json], rules: Array[RelationRule], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (relate_result) -> void } -> nil
      | (RelateQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (relate_result) -> void } -> nil
    def annotate: (AnnotationQuestions, json, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> annotate_result
      | (AnnotateQuestion, json, ?name: String?, ?cancel: CancelToken?) -> annotate_result
    def annotate_each: (AnnotationQuestions, Enumerable[json], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[annotate_result]
      | (AnnotateQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[annotate_result]
      | (AnnotationQuestions, Enumerable[json], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (annotate_result) -> void } -> nil
      | (AnnotateQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (annotate_result) -> void } -> nil
  end
  def self.decide: (String, json, ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> decide_result
      | (DecideQuestion, json, ?name: String?, ?cancel: CancelToken?) -> decide_result
  def self.decide_each: (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[decide_result]
      | (DecideQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[decide_result]
      | (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (decide_result) -> void } -> nil
      | (DecideQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (decide_result) -> void } -> nil
  def self.choose: (String, json, choices: Array[String], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> choose_result
      | (ChooseQuestion, json, ?name: String?, ?cancel: CancelToken?) -> choose_result
  def self.choose_each: (String, Enumerable[json], choices: Array[String], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[choose_result]
      | (ChooseQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[choose_result]
      | (String, Enumerable[json], choices: Array[String], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (choose_result) -> void } -> nil
      | (ChooseQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (choose_result) -> void } -> nil
  def self.tag: (String, json, labels: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> tag_result
      | (TagQuestion, json, ?name: String?, ?cancel: CancelToken?) -> tag_result
  def self.tag_each: (String, Enumerable[json], labels: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[tag_result]
      | (TagQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[tag_result]
      | (String, Enumerable[json], labels: Array[String], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (tag_result) -> void } -> nil
      | (TagQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (tag_result) -> void } -> nil
  def self.score: (String, json, levels: Array[String], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> score_result
      | (ScoreQuestion, json, ?name: String?, ?cancel: CancelToken?) -> score_result
  def self.score_each: (String, Enumerable[json], levels: Array[String], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[score_result]
      | (ScoreQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[score_result]
      | (String, Enumerable[json], levels: Array[String], ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (score_result) -> void } -> nil
      | (ScoreQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (score_result) -> void } -> nil
  def self.filter: (String, json, ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> FilterRow
      | (FilterQuestion, json, ?name: String?, ?cancel: CancelToken?) -> FilterRow
  def self.filter_each: (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[FilterRow]
      | (FilterQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[FilterRow]
      | (String, Enumerable[json], ?threshold: threshold?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (FilterRow) -> void } -> nil
      | (FilterQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (FilterRow) -> void } -> nil
  def self.rank: (String, json, levels: Array[String], ?top: Integer?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> rank_result
      | (RankQuestion, json, ?name: String?, ?cancel: CancelToken?) -> rank_result
  def self.rank_each: (String, Enumerable[json], levels: Array[String], ?top: Integer?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[rank_result]
      | (RankQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[rank_result]
      | (String, Enumerable[json], levels: Array[String], ?top: Integer?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (rank_result) -> void } -> nil
      | (RankQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (rank_result) -> void } -> nil
  def self.find: (String, json, ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> find_result
      | (FindQuestion, json, ?name: String?, ?cancel: CancelToken?) -> find_result
  def self.find_each: (String, Enumerable[json], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) -> Rows[find_result]
      | (FindQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) -> Rows[find_result]
      | (String, Enumerable[json], ?threshold: Float?, ?evidence: evidence?, ?name: String?, ?cancel: CancelToken?) { (find_result) -> void } -> nil
      | (FindQuestion, Enumerable[json], ?name: String?, ?cancel: CancelToken?) { (find_result) -> void } -> nil
