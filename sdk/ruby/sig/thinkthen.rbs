  def self.choose_each: (String, Enumerable[untyped], choices: Array[String | Symbol], ?threshold: Float?, ?field: field?, ?descriptions: Hash[String | Symbol, String]?, ?name: String?, ?cancel: Cancel?) -> Rows[choose_result]
      | (ChooseQuestion, Enumerable[untyped], ?name: String?, ?cancel: Cancel?) -> Rows[choose_result]
