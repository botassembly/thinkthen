#!/usr/bin/env python3
"""Test one installed host gem with prepared DEBUG native assets; compile no engine."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import tomllib
from abi_fixtures import prepare

root = Path(__file__).resolve().parents[3]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--engine', required=True, type=Path)
parser.add_argument('--loopback', required=True, type=Path)
parser.add_argument('--fixtures', required=True, type=Path)
parser.add_argument('--dev-gems', required=True, type=Path)
parser.add_argument('--readme-only', action='store_true')
args = parser.parse_args()
engine = args.engine.resolve(strict=True)
loopback = args.loopback.resolve(strict=True)
fixtures = args.fixtures.resolve(strict=True)
manifest = json.loads(fixtures.read_text())
for case in manifest['cases']:
    Path(case['library']).resolve(strict=True)
for source in sorted((root / 'sdk/ruby').rglob('*.rb')):
    subprocess.run(['ruby', '-wc', str(source)], check=True)
platform = subprocess.check_output(['ruby', '-e', 'platform = Gem::Platform.local; print [platform.cpu, platform.os].join("-")'], text=True)
version = tomllib.loads((root / 'Cargo.toml').read_text())['workspace']['package']['version']
dependencies = list((Path.home() / '.local/share/thinkthen-build-tools/ruby/packages').glob(f'ffi-*-{platform}*.gem'))
if len(dependencies) != 1:
    raise SystemExit(f'expected one prepared ffi gem for {platform}, found {len(dependencies)}')
with tempfile.TemporaryDirectory(prefix='ruby-migration-') as temporary:
    work = Path(temporary)
    prepare(root, engine, fixtures, work / 'fixtures')
    stage = work / 'package'
    stage.mkdir()
    shutil.copytree(root / 'sdk/ruby/lib', stage / 'lib')
    shutil.copy2(engine, stage / 'lib/thinkthen' / engine.name)
    shutil.copytree(root / 'sdk/ruby/sig', stage / 'sig')
    subprocess.run([str(root / 'scripts/ruby-code-types'), str(stage / 'sig')], check=True)
    for source in (root / 'sdk/ruby/API.md', root / 'sdk/ruby/README.md', root / 'sdk/ruby/thinkthen.gemspec', root / 'LICENSE'):
        shutil.copy2(source, stage / source.name)
    (stage / 'VERSION').write_text(version + '\n')
    (stage / 'PLATFORM').write_text(platform + '\n')
    subprocess.run(['gem', 'build', '--strict', 'thinkthen.gemspec'], cwd=stage, check=True)
    for name in ('home', 'tmp', 'gems'):
        (work / name).mkdir()
    keep = ('PATH', 'SystemRoot', 'SYSTEMROOT', 'WINDIR', 'COMSPEC', 'PATHEXT')
    env = {key: value for key, value in os.environ.items() if key in keep}
    env.update(HOME=str(work / 'home'), TMPDIR=str(work / 'tmp'),
               GEM_HOME=str(work / 'gems'), GEM_PATH=os.pathsep.join((str(work / 'gems'), str(args.dev_gems.resolve(strict=True)))),
               THINKTHEN_LOOPBACK=str(loopback), THINKTHEN_CASES=str(root / 'conformance'),
               THINKTHEN_NATIVE_FIXTURES=str(work / 'fixtures'), THINKTHEN_STUB_CASES=str(root / 'construction/stub.json'))
    subprocess.run(['gem', 'install', '--local', '--no-document', str(dependencies[0]),
                    *map(str, stage.glob('*.gem'))], env=env, cwd=work, check=True)
    test = 'readme.rb' if args.readme_only else 'run.rb'
    subprocess.run(['ruby', '-w', str(root / 'sdk/ruby/tests' / test)], env=env, cwd=work, check=True)
print('Ruby installed DEBUG consumer passed; no release artifact was tested')
