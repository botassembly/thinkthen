#!/usr/bin/env python3
"""Run every complete authored Go program against the staged consumer module."""
from pathlib import Path
import os
import re
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parents[2]
consumer = Path.cwd()
guide = (root / 'docs/surfaces/go.md').read_text()
environment = dict(os.environ, THINKTHEN_BACKEND='stub')
for name in ('THINKTHEN_API_KEY', 'OPENAI_API_KEY', 'THINKTHEN_BASE_URL', 'THINKTHEN_BATCH', 'THINKTHEN_LIBRARY'):
    environment.pop(name, None)
count = 0
with tempfile.TemporaryDirectory(prefix='go-examples-', dir=consumer) as scratch:
    for source in (root / 'sdk/go/README.md', root / 'docs/surfaces/go.md'):
        for number, program in enumerate(re.findall(r'```go\n(.*?)```', source.read_text(), re.S), 1):
            # scripts/surface-example runs the collection example and checks its rows.
            if not program.startswith('package main\n') or 'records.jsonl' in program:
                continue
            count += 1
            folder = Path(scratch) / str(count)
            folder.mkdir()
            (folder / 'main.go').write_text(program)
            result = subprocess.run([str(root / 'scripts/go-build'), 'run', '.'], cwd=folder, env=environment, capture_output=True, text=True)
            print(f'Go example {source.relative_to(root)} #{number}:', flush=True)
            print(result.stdout, end='', flush=True)
            if result.returncode:
                print(result.stderr, end='', file=sys.stderr)
                raise SystemExit(result.returncode)
if count == 0:
    raise SystemExit('Found no complete authored Go program')
print(f'All {count} authored Go programs ran as written', flush=True)
