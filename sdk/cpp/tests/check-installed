#!/bin/sh
# Compile every public C++ consumer against one relocated installed prefix.
set -eu
prefix=$1
loopback=$2
engine=$3
root=$PWD
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
check_malformed_rows() {
if [ -z "${THINKTHEN_MALFORMED_ROW_FIXTURES:-}" ]; then
    THINKTHEN_MALFORMED_ROW_FIXTURES="$scratch/malformed"
    export THINKTHEN_MALFORMED_ROW_FIXTURES
    for kind in unknown-function unanswered-answer invalid-json; do
        scripts/abi-minor-check --native "$engine" --malformed-row "$kind" --output "$THINKTHEN_MALFORMED_ROW_FIXTURES/$kind"
    done
fi
python3 - "$prefix" <<'PYTHON'
import os, subprocess, sys, tempfile
from pathlib import Path
prefix = Path(sys.argv[1])
fixtures = Path(os.environ['THINKTHEN_MALFORMED_ROW_FIXTURES'])
engines = [p for p in (prefix / 'lib').glob('libthinkthen.*') if not p.is_symlink()]
assert len(engines) == 1, engines
with tempfile.TemporaryDirectory(prefix='thinkthen-cpp-row-') as temporary:
    for kind in ('unknown-function', 'unanswered-answer', 'invalid-json'):
        library, = (fixtures / kind).glob('libthinkthen*')
        assert library.is_file(), library
        consumer = Path(temporary) / kind
        subprocess.run(['c++', '-std=c++17', '-Wall', '-Wextra', '-Werror', '-UNDEBUG',
            '-I' + str(prefix / 'include'), 'sdk/cpp/tests/malformed_rows.cpp', str(library),
            '-Wl,-rpath,' + str(library.parent), '-o', str(consumer)], check=True)
        subprocess.run([consumer, kind], check=True, timeout=30)
PYTHON
}
if [ "${THINKTHEN_CPP_INTERFACE_ONLY:-0}" != 1 ]; then
# Docs examples name no backend, so the environment picks the offline one.
offline="env -u THINKTHEN_API_KEY -u OPENAI_API_KEY -u THINKTHEN_BASE_URL THINKTHEN_BACKEND=stub"
python3 - "$prefix/share/thinkthen-cpp/README.md" "$root/docs/surfaces/c-cpp.md" "$scratch" <<'PYTHON'
from pathlib import Path
import re, sys
*docs, root = map(Path, sys.argv[1:])
programs = []
guide_fragments = []
standalone_fragments = []
guide_preamble = None
collection = None
for doc in docs:
    for block in re.findall(r"```cpp\n(.*?)\n```", doc.read_text(), re.S):
        assert "backend::stub" not in block, (doc, block)
        for number, line in enumerate(block.splitlines(), 1):
            assert len(line) <= 80, (doc, number, line)
        if "int main" in block:
            if doc == docs[1] and guide_preamble is None:
                guide_preamble = block.split("int main", 1)[0]
            if "records.jsonl" in block:
                collection = block
            else:
                programs.append(block)
        elif doc == docs[0]:
            raise AssertionError("README examples must be complete programs")
        elif '"toolbox.json"' in block:
            guide_fragments.append(block)
        else:
            standalone_fragments.append(block)
assert len(programs) >= 4, len(programs)
assert guide_fragments and collection and guide_preamble
for fragment in standalone_fragments:
    programs.append(guide_preamble
                    + "int main() {\n" + fragment + "\n}\n")
# The guide places the saved-file fragment inside the collection try.
body, handler = collection.rsplit("    } catch (const std::exception& error)", 1)
context = ("#include <iterator>\n" + body + "\n"
           + "\n".join(guide_fragments)
           + "\n    } catch (const std::exception& error)" + handler)
(root / "guide-context.cpp").write_text(context + "\n")
json_blocks = re.findall(r"```json\n(.*?)\n```", docs[1].read_text(), re.S)
assert len(json_blocks) == 1
(root / "toolbox.json").write_text(json_blocks[0] + "\n")
(root / "example.cpp").write_text(programs[0] + "\n")
(root / "docs").mkdir()
for index, program in enumerate(programs):
    (root / "docs" / f"program{index}.cpp").write_text(program + "\n")
(root / "CMakeLists.txt").write_text(
    'cmake_minimum_required(VERSION 3.20)\nproject(example LANGUAGES CXX)\n'
    'find_package(ThinkThenCpp CONFIG REQUIRED)\nadd_executable(example example.cpp)\n'
    'target_compile_options(example PRIVATE -Wall -Wextra -Werror)\n'
    'target_link_libraries(example PRIVATE ThinkThen::Cpp)\n')
PYTHON
cmake -S "$scratch" -B "$scratch/readme-build" -DCMAKE_PREFIX_PATH="$prefix"
cmake --build "$scratch/readme-build" --parallel 2
$offline "$scratch/readme-build/example"
for program in "$scratch"/docs/program*.cpp; do
    c++ -std=c++17 -Wall -Wextra -Werror -I"$prefix/include" "$program" -L"$prefix/lib" -lthinkthen -Wl,-rpath,"$prefix/lib" -o "${program%.cpp}"
    $offline "${program%.cpp}"
done
python3 "$root/scripts/surface-example" prepare c-cpp "$scratch/guide"
c++ -std=c++17 -Wall -Wextra -Werror -I"$prefix/include" "$scratch/guide/example.cpp" -L"$prefix/lib" -lthinkthen -Wl,-rpath,"$prefix/lib" -o "$scratch/guide/example"
(cd "$scratch/guide" && python3 "$root/scripts/surface-example" check c-cpp ./example)
cp "$scratch/toolbox.json" "$scratch/guide/toolbox.json"
c++ -std=c++17 -Wall -Wextra -Werror -I"$prefix/include" "$scratch/guide-context.cpp" -L"$prefix/lib" -lthinkthen -Wl,-rpath,"$prefix/lib" -o "$scratch/guide-context"
(cd "$scratch/guide" && $offline "$scratch/guide-context")
fi
if [ "${THINKTHEN_CPP_CORRECTIONS_ONLY:-0}" = 1 ]; then
    check_malformed_rows
    exit 0
fi
python3 sdk/cpp/tests/process_diagnostics_check.py
python3 - "$prefix" <<'PYTHON'
import json, platform, subprocess, sys
from pathlib import Path
prefix = Path(sys.argv[1])
engines = [p for p in (prefix / "lib").glob("libthinkthen.*") if not p.is_symlink()]
assert len(engines) == 1, engines
registry = json.loads(Path("schemas/abi.json").read_text())
expected = {item["name"] for section in ("exports", "sql_exports") for item in registry[section]}
command = ["nm", "-gU"] if platform.system() == "Darwin" else ["nm", "-D", "--defined-only"]
lines = subprocess.check_output([*command, str(engines[0])], text=True).splitlines()
actual = {line.split()[-1].removeprefix("_") for line in lines if line.split()}
assert actual == expected, (actual - expected, expected - actual)
if platform.system() == "Darwin":
    subprocess.run(["codesign", "--verify", "--strict", str(engines[0])], check=True)
    identity = subprocess.check_output(["otool", "-D", str(engines[0])], text=True)
    assert "@rpath/" + engines[0].name in identity, identity
else:
    identity = subprocess.check_output(["readelf", "-d", str(engines[0])], text=True)
    assert "(SONAME)" in identity and "[" + engines[0].name + "]" in identity, identity
PYTHON
mkdir "$scratch/source"
cp sdk/cpp/tests/stress.hpp sdk/cpp/tests/consumer.cpp sdk/cpp/tests/typed_consumer.cpp sdk/cpp/tests/interface.cpp sdk/cpp/tests/typed_network_consumer.cpp sdk/cpp/tests/unknown_code_consumer.cpp sdk/cpp/tests/CMakeLists.txt "$scratch/source/"
cmake -S "$scratch/source" -B "$scratch/build" -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_PREFIX_PATH="$prefix;$HOME/.local/share/thinkthen-build-tools/nlohmann-json/3.11.3" \
    -DCMAKE_INSTALL_PREFIX="$scratch/application"
cmake --build "$scratch/build" --parallel 2
cmake --install "$scratch/build"
rm -rf "$scratch/source" "$scratch/build"
"$scratch/application/bin/typed_consumer"
"$scratch/application/bin/interface_consumer"
python3 - "$scratch/application/bin/typed_consumer" <<'PYTHON'
import json, subprocess, sys
from pathlib import Path
codes = json.loads(Path('schemas/contract.json').read_text())['codes']
for value in codes + [{'value':0, 'family':''}, {'value':2147483647, 'family':''}]:
    actual = subprocess.check_output([sys.argv[1], 'family', str(value['value'])], text=True).strip()
    assert actual == value['family'], (value, actual)
PYTHON
python3 sdk/c/tests/toolbox.py "$scratch/application/bin/typed_consumer" "$root"
"$scratch/application/bin/ranges_consumer"
"$scratch/application/bin/unknown_code_consumer"
mkdir "$scratch/home"
HOME="$scratch/home" python3 sdk/cpp/tests/run.py "$scratch/application/bin/consumer" "$loopback" \
    "$scratch/application/bin/consumer" "$root/conformance/typed/manifest.json"
HOME="$scratch/home" python3 sdk/cpp/tests/network.py "$scratch/application/bin/network_consumer" "$loopback"
THINKTHEN_LOOPBACK="$loopback" python3 scripts/stress-adapters.py --surface cpp ${THINKTHEN_STRESS_FULL:+--full} -- python3 sdk/c/tests/stress.py cpp "$scratch/application/bin/consumer"
if [ -n "${THINKTHEN_SOAK_FOLDER:-}" ]; then
    soak_status=0
    for backend in systemone openai; do
        THINKTHEN_LOOPBACK="$loopback" python3 scripts/stress-adapters.py --surface cpp --rounds 60 --backend "$backend" \
            --evidence-path "$THINKTHEN_SOAK_FOLDER/cpp-$backend.jsonl" -- python3 sdk/c/tests/stress.py cpp "$scratch/application/bin/consumer" || soak_status=1
    done
    [ "$soak_status" = 0 ]
fi
# Warning contracts protect immutable modifiers and one-record calls.
for expression in 'thinkthen::decide{"Ready?"}.field("/body");' 'thinkthen::decide{"Ready?"}.threshold(0.7);' 'thinkthen::client{}.decide(thinkthen::decide{"Ready?"}, "evidence");' '(void)thinkthen::client{}.decide(thinkthen::decide{"Ready?"}, std::vector<std::string>{"a", "b"});' 'thinkthen::cancel_handle{}.cancel();'; do
    printf '#include <thinkthen/thinkthen.hpp>\nint main() { %s }\n' "$expression" > "$scratch/negative.cpp"
    if c++ -std=c++17 -Wall -Wextra -Werror -fsyntax-only -I"$prefix/include" "$scratch/negative.cpp" > "$scratch/negative.log" 2>&1; then
        echo "C++ accepted an unsafe discarded value, collection or removed cancel alias: $expression" >&2
        exit 1
    fi
done
if [ "${THINKTHEN_CPP_INTERFACE_ONLY:-0}" = 1 ]; then exit 0; fi

# Negative type contracts exclude rank and general toolboxes from annotations.
for expression in 'thinkthen::annotation_question q = thinkthen::rank{"Rank?", {"low", "high"}};' 'thinkthen::annotate q{thinkthen::toolbox{{{"ready", thinkthen::decide{"Ready?"}}}}};'; do
    printf '#include <thinkthen/thinkthen.hpp>\nint main() { %s }\n' "$expression" > "$scratch/negative.cpp"
    if c++ -std=c++17 -fsyntax-only -I"$prefix/include" "$scratch/negative.cpp" > "$scratch/negative.log" 2>&1; then
        echo 'annotation accepted an excluded question type' >&2
        exit 1
    fi
done
if [ -n "${THINKTHEN_NATIVE_FIXTURES:-}" ]; then
    test -f "$THINKTHEN_NATIVE_FIXTURES/manifest.json"
else
    scripts/native-fixtures --engine "$engine" --output "$scratch/fixtures"
    THINKTHEN_NATIVE_FIXTURES="$scratch/fixtures"
fi
HOME="$scratch/home" python3 sdk/cpp/tests/abi.py "$prefix" "$THINKTHEN_NATIVE_FIXTURES/manifest.json"
check_malformed_rows
