from collections.abc import Iterator
from typing import Any, NoReturn

ABI_VERSION: int

class Error(Exception): ...

def reject_settings_conversion() -> NoReturn: ...
def reject_question_conversion() -> NoReturn: ...

class NativeCancel:
    def child(self) -> NativeCancel: ...
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...

class NativeQuestion:
    def __init__(self, definition: str) -> None: ...
    @property
    def function(self) -> str: ...
    @property
    def definition(self) -> str: ...

class NativeToolbox:
    @staticmethod
    def from_json(text: str) -> NativeToolbox: ...
    def to_json(self) -> str: ...
    def __init__(self, definition: str) -> None: ...
    def question(self, name: str | None) -> NativeQuestion: ...
    @property
    def definition(self) -> str: ...

class NativeStream:
    def cancel(self) -> None: ...
    def receive(self) -> tuple[str, str | None, bool, Any, int] | None: ...
    def close(self) -> None: ...

class NativeEngine:
    @property
    def settings(self) -> str: ...
    def __init__(self, settings_json: str) -> None: ...
    def start(
        self,
        request_json: str,
        source: Iterator[tuple[bool, str | None, Any]],
        cancel: NativeCancel,
        keep_originals: bool,
        question: NativeQuestion | None = None,
    ) -> NativeStream: ...
    def start_finite(
        self,
        request_json: str,
        source: Iterator[tuple[bool, str | None, Any]],
        cancel: NativeCancel,
        keep_originals: bool,
        question: NativeQuestion | None = None,
    ) -> NativeStream: ...

def seconds_to_millis(value: float) -> int: ...
def reject_cancelled() -> NoReturn: ...

ERROR_CODES: list[tuple[int, str]]

def reject_closed_client() -> NoReturn: ...
