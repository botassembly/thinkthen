#!/bin/sh
# Prepare pinned public wheels, then prove a cold Python 3.10 install without an index or cache.
set -eu
cd "$(dirname "$0")/../.."
. scripts/native-tools-env
THINKTHEN_OFFLINE_CONTROLLER=$(command -v python3)
export THINKTHEN_OFFLINE_CONTROLLER
python3 - <<'PREPARE'
import sys
sys.path.insert(0, 'scripts')
from release_workflow_prepare import python_frames
python_frames()
PREPARE
exec uv run --offline --no-project --python 3.10 --with 'maturin>=1.5,<2' -- sh -eu <<'CHECK'
scratch=$(mktemp -d)
trap 'status=$?; trap - EXIT; rm -rf "$scratch"; exit "$status"' EXIT
mkdir "$scratch/wheels"
(cd sdk/python && python -c 'import build_backend, sys; build_backend.build_wheel(sys.argv[1], {"build-args": "--locked --profile dev"})' "$scratch/wheels")
"$THINKTHEN_OFFLINE_CONTROLLER" scripts/python-offline-test "$scratch"/wheels/*.whl "$HOME/.local/share/thinkthen-build-tools/python-frames/cp310/wheels" "$(command -v python)"
CHECK
