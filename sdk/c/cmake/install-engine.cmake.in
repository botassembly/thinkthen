# Change only the installed package copy; shared build assets stay untouched.
set(destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@")
set(engine "${destination}/@THINKTHEN_FFI_NAME@")
if(APPLE)
    string(ASCII 64 at)
    execute_process(COMMAND "@THINKTHEN_INSTALL_NAME_TOOL@" -id "${at}rpath/@THINKTHEN_FFI_NAME@" "${engine}" COMMAND_ERROR_IS_FATAL ANY)
elseif(UNIX)
    execute_process(COMMAND "@THINKTHEN_PATCHELF@" --set-soname "@THINKTHEN_FFI_NAME@" "${engine}" COMMAND_ERROR_IS_FATAL ANY)
endif()
if(UNIX)
    file(CREATE_LINK "@THINKTHEN_FFI_NAME@" "${destination}/@THINKTHEN_LINK_NAME@" SYMBOLIC)
endif()
