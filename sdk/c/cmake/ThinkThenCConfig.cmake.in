@PACKAGE_INIT@
if(NOT TARGET ThinkThen::C)
    add_library(ThinkThen::C SHARED IMPORTED)
    set_target_properties(ThinkThen::C PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@THINKTHEN_FFI_NAME@"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
endif()
